<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (contract v21). Xcode re-signs this as
	     production for TestFlight and the store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Attest (contract v32): the server proves a document submission
	     came from the genuine app on a real Apple device. The value is the
	     APP_ATTEST_ENVIRONMENT build setting (project.yml): `development` in
	     Debug, `production` in Release. TestFlight and the App Store use
	     production whatever it says. The App ID needs the App Attest
	     capability for a profile to carry this key. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>$(APP_ATTEST_ENVIRONMENT)</string>
	<!--
	  Password AutoFill keys a saved password to a *website*. Without this,
	  iOS has no way to know that the Sila app is sila.gmai.sa, so a password
	  saved from the web client is never offered here and one saved from the
	  app is never offered on the web. The other half of the handshake is
	  https://sila.gmai.sa/.well-known/apple-app-site-association, which must
	  answer application/json and name this app.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:sila.gmai.sa</string>
		<!-- The site's apple-app-site-association hands these to the app:
		     /posts/*, /u/*, /events/* (not /events/new), /rooms/* (not
		     /rooms/series/*), /vouch/*, /vouch and /vouching — exactly what
		     DeepLink.parse reads (AssociatedDomainsTests keeps the two in
		     step). A room link opens on the room's card, never in the room
		     (round-2 CA-1). -->
		<string>applinks:sila.gmai.sa</string>
	</array>
</dict>
</plist>
