    "vouch.explainer.body": {
      "comment": "%1$@ is the voucher's handle, %2$@ the vouched member's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦@%1$@⁩ عضو موثّق ويزكّي %2$@ بأنه يعرفه شخصيًا. %2$@ لم يوثّق هويته بعد، لذلك لا يحمل ختمًا ولا علم دولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ একজন ভেরিফায়েড সদস্য এবং তিনি ভাউচ করছেন যে তিনি %2$@-কে ব্যক্তিগতভাবে চেনেন। %2$@ এখনও নিজের পরিচয় ভেরিফাই করেননি, তাই কোনো সিল বা দেশের পতাকা নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ és un membre verificat i avala que coneix %2$@ en persona. %2$@ encara no ha verificat la seva pròpia identitat, així que no hi ha segell ni bandera de país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ je ověřený člen a ručí za to, že osobně zná uživatele %2$@. Uživatel %2$@ zatím neověřil vlastní totožnost, proto nemá pečeť ani vlajku země."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ er et verificeret medlem og garanterer, at vedkommende kender %2$@ personligt. %2$@ har endnu ikke verificeret sin egen identitet, så der er intet segl og intet landeflag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ist ein verifiziertes Mitglied und bürgt dafür, dass er oder sie %2$@ persönlich kennt. %2$@ hat die eigene Identität noch nicht verifiziert, daher gibt es kein Siegel und keine Landesflagge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%1$@ είναι επαληθευμένο μέλος και εγγυάται ότι γνωρίζει προσωπικά τον/την %2$@. Ο/Η %2$@ δεν έχει επαληθεύσει ακόμα την ταυτότητά του/της, οπότε δεν υπάρχει σφραγίδα ούτε σημαία χώρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ is a verified member and vouches that they know %2$@ in person. %2$@ hasn't verified their own identity yet, so there's no seal and no country flag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ es un miembro verificado y avala que conoce en persona a %2$@. %2$@ aún no ha verificado su propia identidad, así que no hay sello ni bandera de país."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ on vahvistettu jäsen ja takaa tuntevansa käyttäjän %2$@ henkilökohtaisesti. %2$@ ei ole vielä vahvistanut omaa henkilöllisyyttään, joten sinettiä ja maan lippua ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ est un membre vérifié et garantit connaître %2$@ en personne. %2$@ n’a pas encore vérifié sa propre identité : il n’y a donc ni sceau ni drapeau de pays."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ הוא חבר מאומת וערב שהוא מכיר את %2$@ באופן אישי. %2$@ עדיין לא אימת את זהותו, ולכן אין חותם ואין דגל מדינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ एक सत्यापित सदस्य हैं और वाउच करते हैं कि वे %2$@ को व्यक्तिगत रूप से जानते हैं। %2$@ ने अभी अपनी पहचान खुद सत्यापित नहीं की है, इसलिए कोई सील और देश का झंडा नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ je potvrđen član i jamči da osobno poznaje: %2$@. %2$@ još nije potvrdio/la svoj identitet pa nema pečata ni zastave zemlje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ hitelesített tag, és kezeskedik érte, hogy személyesen ismeri őt: %2$@. %2$@ még nem hitelesítette a saját személyazonosságát, ezért nincs pecsét és országzászló."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ adalah anggota terverifikasi dan menjamin bahwa ia mengenal %2$@ secara langsung. %2$@ belum memverifikasi identitasnya sendiri, jadi tidak ada segel dan bendera negara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ è un membro verificato e garantisce di conoscere %2$@ di persona. %2$@ non ha ancora verificato la propria identità, quindi non ci sono né sigillo né bandiera del paese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@は認証済みのメンバーで、%2$@と直接の知り合いであることを保証しています。%2$@はまだ自分で本人確認をしていないため、認証マークも国旗もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@님은 인증된 멤버이며 %2$@님을 직접 알고 있다고 보증해요. %2$@님은 아직 직접 신원을 인증하지 않았으므로 인증 마크와 국가 깃발이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ഒരു വെരിഫൈ ചെയ്ത അംഗമാണ്, %2$@ നെ നേരിട്ട് അറിയാമെന്ന് വൗച്ച് ചെയ്യുന്നു. %2$@ ഇതുവരെ സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്തിട്ടില്ല, അതിനാൽ സീലോ രാജ്യത്തിന്റെ പതാകയോ ഇല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ialah ahli yang disahkan dan menjamin bahawa dia mengenali %2$@ secara peribadi. %2$@ belum mengesahkan identitinya sendiri, jadi tiada meterai dan tiada bendera negara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ er et verifisert medlem og garanterer for at vedkommende kjenner %2$@ personlig. %2$@ har ikke verifisert sin egen identitet ennå, så det er ikke noe segl og ikke noe landsflagg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ is een geverifieerd lid en garandeert dat diegene %2$@ persoonlijk kent. %2$@ heeft de eigen identiteit nog niet geverifieerd, dus er is geen zegel en geen landvlag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ jest zweryfikowanym członkiem i ręczy, że zna osobiście: %2$@. Osoba %2$@ nie zweryfikowała jeszcze własnej tożsamości, więc nie ma pieczęci ani flagi kraju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ é um membro verificado e garante que conhece %2$@ pessoalmente. %2$@ ainda não verificou a própria identidade, então não há selo nem bandeira de país."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ é um membro verificado e garante que conhece %2$@ pessoalmente. %2$@ ainda não verificou a própria identidade, por isso não há selo nem bandeira de país."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ este un membru verificat și garantează că îl cunoaște personal pe %2$@. %2$@ nu și-a verificat încă propria identitate, deci nu există sigiliu și nici steagul țării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ — проверенный участник и ручается, что лично знает %2$@. %2$@ ещё не прошёл(ла) собственную проверку личности, поэтому нет ни печати, ни флага страны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ je overený člen a ručí, že %2$@ pozná osobne. %2$@ si zatiaľ neoveril vlastnú totožnosť, takže nemá pečať ani vlajku krajiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ är en verifierad medlem och intygar att hen känner %2$@ personligen. %2$@ har inte verifierat sin egen identitet än, så det finns inget märke och ingen landsflagga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ சரிபார்க்கப்பட்ட உறுப்பினர்; அவர் %2$@ ஐ நேரில் அறிவார் என உறுதியளிக்கிறார். %2$@ இன்னும் தன் அடையாளத்தைச் சரிபார்க்கவில்லை, எனவே முத்திரையும் நாட்டுக் கொடியும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ధృవీకరించబడిన సభ్యులు, వారు %2$@ ను వ్యక్తిగతంగా తెలుసని హామీ ఇస్తున్నారు. %2$@ ఇంకా తమ గుర్తింపును ధృవీకరించుకోలేదు, కాబట్టి సీల్ లేదా దేశం జెండా లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ เป็นสมาชิกที่ยืนยันแล้ว และรับรองว่ารู้จัก %2$@ ตัวต่อตัว %2$@ ยังไม่ได้ยืนยันตัวตนของตัวเอง จึงยังไม่มีตราและธงประเทศ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ doğrulanmış bir üye ve %2$@ kişisini şahsen tanıdığına kefil oluyor. %2$@ henüz kendi kimliğini doğrulamadı, bu yüzden mühür ve ülke bayrağı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ — верифікований учасник і ручається, що особисто знає: %2$@. %2$@ ще не верифікував(ла) власну особу, тому печатки й прапора країни немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ایک تصدیق شدہ رکن ہیں اور ضمانت دیتے ہیں کہ وہ %2$@ کو ذاتی طور پر جانتے ہیں۔ %2$@ نے ابھی اپنی شناخت کی تصدیق نہیں کی، اس لیے کوئی مہر اور ملک کا جھنڈا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ là một thành viên đã xác minh và bảo chứng rằng họ quen biết %2$@ ngoài đời. %2$@ chưa tự xác minh danh tính, nên không có dấu chứng nhận và cờ quốc gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 是已验证的成员，并担保自己当面认识%2$@。%2$@ 尚未验证自己的身份，所以没有认证印章，也没有国家旗帜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 是已驗證的成員，並擔保自己親自認識 %2$@。%2$@ 尚未驗證自己的身分，所以沒有認證標章和國家旗幟。"
          }
        }
      }
    },
