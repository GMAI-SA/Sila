    "safety.tab.blocked.hint": {
      "comment": "VoiceOver hint for the blocked tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الحسابات التي حظرتها، ومع كل منها زر لإلغاء الحظر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্লক করা অ্যাকাউন্ট দেখায়, প্রতিটির সাথে আনব্লক বোতাম"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els comptes que has bloquejat, cadascun amb un botó per desbloquejar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, které jsi zablokoval, každý s tlačítkem odblokování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser konti, du har blokeret, hver med en knap til at fjerne blokeringen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Konten, die du blockiert hast, jeweils mit einer Entblocken-Taste"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τους λογαριασμούς που έχεις αποκλείσει, καθένας με κουμπί άρσης αποκλεισμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows accounts you have blocked, each with an unblock button"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las cuentas que has bloqueado, cada una con un botón para desbloquear"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää estämäsi tilit, kullakin eston poistopainike"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les comptes que vous avez bloqués, chacun avec un bouton pour débloquer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג חשבונות שחסמת, לכל אחד כפתור לביטול חסימה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन अकाउंट को दिखाता है जिन्हें आपने ब्लॉक किया, हर एक के साथ अनब्लॉक बटन"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje račune koje si blokirao/la, svaki s gumbom za odblokiranje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letiltott fiókjaidat mutatja, mindegyikhez feloldás gombbal"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan akun yang kamu blokir, masing-masing dengan tombol buka blokir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli account che hai bloccato, ciascuno con un pulsante per sbloccare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしたアカウントを、それぞれの解除ボタン付きで表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 계정을 보여주며, 각 계정에 차단 해제 버튼이 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ബ്ലോക്ക് ചെയ്ത അക്കൗണ്ടുകൾ, ഓരോന്നിനും അൺബ്ലോക്ക് ബട്ടണോടെ കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan akaun yang anda sekat, masing-masing dengan butang nyahsekat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kontoer du har blokkert, hver med en knapp for å oppheve blokkeringen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont accounts die je hebt geblokkeerd, elk met een deblokkeerknop"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zablokowane konta, każde z przyciskiem odblokowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as contas que você bloqueou, cada uma com um botão para desbloquear"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as contas que bloqueou, cada uma com um botão de desbloquear"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată conturile blocate de tine, fiecare cu un buton de deblocare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает заблокированные вами аккаунты, у каждого есть кнопка разблокировки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, ktoré si zablokoval, každý s tlačidlom odblokovať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar konton du har blockerat, var och en med en knapp för att avblockera"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தடுத்த கணக்குகளை, ஒவ்வொன்றுக்கும் தடை நீக்கு பொத்தானுடன் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు బ్లాక్ చేసిన ఖాతాలను, ప్రతిదానికి అన్‌బ్లాక్ బటన్‌తో చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบัญชีที่คุณบล็อก แต่ละบัญชีมีปุ่มเลิกบล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellediğiniz hesapları, her biri engeli kaldır düğmesiyle gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує облікові записи, які ви заблокували, кожен із кнопкою розблокування"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بلاک کیے ہوئے اکاؤنٹس دکھاتا ہے، ہر ایک کے ساتھ ان بلاک کا بٹن"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các tài khoản bạn đã chặn, mỗi tài khoản có nút bỏ chặn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你已屏蔽的账户，每个都带有取消屏蔽按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你封鎖的帳號，每個都有解除封鎖按鈕"
          }
        }
      }
    },
