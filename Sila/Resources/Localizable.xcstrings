    "push.community_accepted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضممت — قبلك مجتمع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ভেতরে — একটি কমিউনিটি আপনাকে গ্রহণ করেছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja hi ets: una comunitat t'ha acceptat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsi uvnitř – komunita tě přijala"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er med – et fællesskab har accepteret dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dabei – eine Community hat dich aufgenommen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπήκες — μια κοινότητα σε δέχτηκε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in — a community accepted you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya estás dentro: una comunidad te aceptó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet sisällä – yhteisö hyväksyi sinut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous y êtes — une communauté vous a accepté"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה בפנים — קהילה קיבלה אותך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अंदर हैं — एक कम्युनिटी ने आपको स्वीकार किया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unutra si — zajednica te primila"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent vagy – egy közösség elfogadott"
          }
