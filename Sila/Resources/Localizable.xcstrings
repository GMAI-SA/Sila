    "error.validation": {
      "extractionState": "manual",
      "comment": "A form field the server refused, when the field cannot be named.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض ما أدخلته لم يُقبل. راجعه وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেওয়া কিছু তথ্য গ্রহণ করা হয়নি। দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Part del que has introduït no s'ha acceptat. Revisa-ho i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část toho, co jsi zadal, nebyla přijata. Zkontroluj to a zkus znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget af det, du indtastede, blev ikke accepteret. Tjek det, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige deiner Eingaben wurden nicht akzeptiert. Prüfe sie und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποια από όσα εισήγαγες δεν έγιναν δεκτά. Έλεγξέ τα και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of what you entered wasn't accepted. Check it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de lo que introdujiste no se aceptó. Revísalo e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaa antamistasi tiedoista ei hyväksytty. Tarkista ne ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de ce que vous avez saisi n’a pas été acceptée. Vérifiez et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק ממה שהזנת לא התקבל. בדוק ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दर्ज किए कुछ विवरण स्वीकार नहीं हुए। उन्हें जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dio onoga što si unio/unijela nije prihvaćen. Provjeri i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott adatok egy részét nem fogadtuk el. Ellenőrizd, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian isianmu tidak diterima. Periksa lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte di ciò che hai inserito non è stata accettata. Controlla e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容の一部が受け付けられませんでした。確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 내용 중 일부가 받아들여지지 않았어요. 확인하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നൽകിയതിൽ ചിലത് സ്വീകരിച്ചില്ല. പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian daripada yang anda masukkan tidak diterima. Semak dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe av det du skrev inn, ble ikke godtatt. Sjekk det og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van wat je hebt ingevoerd is niet geaccepteerd. Controleer het en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część wpisanych danych nie została przyjęta. Sprawdź je i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do que você digitou não foi aceita. Confira e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do que introduziu não foi aceite. Verifique e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele dintre datele introduse nu au fost acceptate. Verifică-le și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть введённых данных не принята. Проверьте их и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo z toho, čo si zadal, nebolo prijaté. Skontroluj to a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av det du angav godtogs inte. Kontrollera och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்ளிட்டவற்றில் சில ஏற்கப்படவில்லை. சரிபார்த்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
