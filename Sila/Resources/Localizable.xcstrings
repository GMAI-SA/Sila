    "notifications.kind.communityJoinRequest.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين يطلب أحد الانضمام إلى مجتمع تديره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চালানো কোনো কমিউনিটিতে কেউ যোগ দিতে চাইলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú demana unir-se a una comunitat que gestiones."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někdo žádá o vstup do komunity, kterou spravuješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen beder om at komme med i et fællesskab, du driver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand fragt, ob er einer Community beitreten darf, die du leitest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος ζητά να συμμετάσχει σε κοινότητα που διαχειρίζεσαι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When somebody asks to join a community you run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien pide unirse a una comunidad que gestionas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku pyytää liittyä ylläpitämääsi yhteisöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un demande à rejoindre une communauté que vous gérez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו מבקש להצטרף לקהילה שאתה מנהל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपकी चलाई कम्युनिटी से जुड़ने को कहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad netko zatraži pridruživanje zajednici koju vodiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor valaki csatlakozni kér egy általad vezetett közösségbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat seseorang meminta bergabung ke komunitas yang kamu kelola."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno chiede di unirsi a una community che gestisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運営しているコミュニティに誰かが参加を申請したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내가 운영하는 커뮤니티에 가입을 요청했을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നടത്തുന്ന ഒരു കമ്മ്യൂണിറ്റിയിൽ ചേരാൻ ആരെങ്കിലും അഭ്യർഥിക്കുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seseorang memohon menyertai komuniti yang anda uruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen ber om å bli med i et fellesskap du driver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer iemand lid wil worden van een community die je beheert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś prosi o dołączenie do społeczności, którą prowadzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém pede para entrar em uma comunidade que você administra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém pede para entrar numa comunidade que gere."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când cineva cere să se alăture unei comunități pe care o administrezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кто-то просится в сообщество, которое вы ведёте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekto požiada o vstup do komunity, ktorú spravuješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon ansöker om att gå med i en community du driver."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் நடத்தும் சமூகத்தில் யாராவது சேரக் கேட்கும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నడుపుతున్న కమ్యూనిటీలో చేరడానికి ఎవరైనా అడిగినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนขอเข้าร่วมชุมชนที่คุณดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri yönettiğiniz bir topluluğa katılmak istediğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли хтось просить приєднатися до спільноти, якою ви керуєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی آپ کی چلائی ہوئی کمیونٹی میں شامل ہونے کی درخواست کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó xin tham gia cộng đồng bạn quản lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人申请加入你管理的社区时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人申請加入你管理的社群時。"
          }
        }
      }
    },
