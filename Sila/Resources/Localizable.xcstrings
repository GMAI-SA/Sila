    "rooms.invites.revoked": {
      "comment": "Toast after withdrawing. %@ is a handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بإمكان ⁦@%@⁩ الانضمام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ আর যোগ দিতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ja no s'hi pot unir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ se už nemůže připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan ikke længere komme med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kann nicht mehr beitreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ δεν μπορεί πια να μπει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ can no longer join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ya no puede unirse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ei voi enää liittyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ne peut plus rejoindre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ לא יכול עוד להצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ अब जुड़ नहीं सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ se više ne može pridružiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ már nem csatlakozhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak bisa lagi bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ non può più unirsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@はもう参加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님은 더 이상 참여할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ഇനി ചേരാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak lagi boleh menyertai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan ikke lenger bli med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan niet meer meedoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nie może już dołączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não pode mais entrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ já não pode entrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nu se mai poate alătura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ больше не может присоединиться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sa už nemôže pripojiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan inte längre gå med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ இனி சேர முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ఇక చేరలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ เข้าร่วมไม่ได้อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ artık katılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ більше не може приєднатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ اب شامل نہیں ہو سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ không thể tham gia nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 无法再加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 無法再加入。"
          }
        }
      }
    },
