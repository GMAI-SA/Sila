    "events.create.roomHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح غرفة وقت البدء، بنفس باب الفعالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর সময়ে একটি রুম খোলে, ইভেন্টের মতো একই প্রবেশদ্বারসহ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'obre una sala a l'hora d'inici, amb el mateix accés que l'esdeveniment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost se otevře v čase začátku, se stejným vstupem jako událost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rum åbner ved starttidspunktet med samme adgang som begivenheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Startzeit öffnet sich ein Raum mit demselben Zugang wie das Event."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αίθουσα ανοίγει την ώρα έναρξης, με την ίδια πρόσβαση με την εκδήλωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room opens at the start time, with the same door as the event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sala se abre a la hora de inicio, con el mismo acceso que el evento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huone avautuu alkamisaikana, samalla ovella kuin tapahtuma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salon s’ouvre à l’heure de début, avec le même accès que l’événement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר נפתח בשעת ההתחלה, עם אותה דלת כמו האירוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने के समय पर एक रूम खुलता है, इवेंट जैसे ही दरवाज़े के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba se otvara u vrijeme početka, s istim ulazom kao i događaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szoba a kezdéskor nyílik meg, ugyanazzal a bejárattal, mint az esemény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah room dibuka pada waktu mulai, dengan pintu yang sama seperti acaranya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stanza si apre all'orario di inizio, con lo stesso accesso dell'evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻にルームが開きます。入口はイベントと同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시간에 이벤트와 같은 공개 범위로 룸이 열려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടങ്ങുന്ന സമയത്ത്, ഇവന്റിന്റെ അതേ പ്രവേശന നിയമത്തോടെ ഒരു റൂം തുറക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah bilik dibuka pada masa mula, dengan pintu yang sama seperti acara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rom åpnes ved starttidspunktet, med samme dør som arrangementet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een room opent op het starttijdstip, met dezelfde toegang als het evenement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój otwiera się o czasie rozpoczęcia, z takim samym wejściem jak wydarzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala abre no horário de início, com o mesmo acesso do evento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala abre à hora de início, com a mesma porta do evento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cameră se deschide la ora de început, cu aceeași intrare ca evenimentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комната открывается в момент начала, с тем же доступом, что и у события."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť sa otvorí v čase začiatku, s rovnakými dverami ako udalosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rum öppnas vid starttiden, med samma dörr som evenemanget."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்க நேரத்தில் ஓர் அறை திறக்கும், நிகழ்வின் அதே நுழைவு விதியுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభ సమయానికి ఒక రూమ్ తెరుచుకుంటుంది, ఈవెంట్‌కు ఉన్న ద్వారమే దానికీ ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องจะเปิดตอนเวลาเริ่ม โดยมีประตูแบบเดียวกับกิจกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç saatinde, etkinlikle aynı kapıya sahip bir oda açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімната відкривається в час початку, з тим самим входом, що й подія."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع ہونے کے وقت ایک روم کھلتا ہے، ایونٹ جیسے ہی دروازے کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phòng mở vào giờ bắt đầu, với cùng kiểu cửa như sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间会在开始时间开启，准入方式与活动相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室會在開始時間開啟，入口與活動相同。"
          }
        }
      }
    },
