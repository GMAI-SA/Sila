    "auth.otp.spamHint": {
      "comment": "Reassurance under the resend button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من مجلد الرسائل غير المرغوب فيها إن لم يصلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "না এলে স্প্যাম ফোল্ডার দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la carpeta de correu brossa si no arriba."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud nepřijde, zkontroluj složku nevyžádané pošty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek din spammappe, hvis den ikke dukker op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh in deinem Spam-Ordner nach, falls er nicht ankommt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε τον φάκελο ανεπιθύμητων αν δεν φτάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your spam folder if it doesn't arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la carpeta de spam si no llega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista roskapostikansio, jos koodi ei saavu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez vos courriers indésirables s’il n’arrive pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם הוא לא מגיע, בדוק בתיקיית הספאם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न आए तो अपना स्पैम फ़ोल्डर देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ne stigne, provjeri mapu neželjene pošte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nem érkezik meg, nézd meg a spam mappát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa folder spam jika tidak kunjung tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non arriva, controlla la cartella dello spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "届かない場合は、迷惑メールフォルダを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착하지 않으면 스팸 폴더를 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എത്തിയില്ലെങ്കിൽ സ്പാം ഫോൾഡർ പരിശോധിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak folder spam anda jika ia tidak tiba."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk søppelpostmappen hvis den ikke kommer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk in je spammap als de code niet aankomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie nadejdzie, sprawdź folder ze spamem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua pasta de spam se ele não chegar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a pasta de spam se não chegar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică dosarul de spam dacă nu ajunge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если письма нет, загляните в папку «Спам»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak nepríde, pozri si priečinok so spamom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolla skräpposten om den inte kommer fram."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரவில்லை என்றால் உங்கள் ஸ்பேம் கோப்புறையைப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
