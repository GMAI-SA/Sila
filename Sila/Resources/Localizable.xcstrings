    "messages.delete.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستختفي من المحادثة. تُحفظ نسخة كي تبقى أي شكوى بشأنها قابلة للمراجعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কথোপকথন থেকে মিলিয়ে যায়। এর বিষয়ে কোনো রিপোর্ট পর্যালোচনা করা যাতে যায়, সে জন্য একটি কপি রাখা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desapareix de la conversa. Se'n conserva una còpia perquè es pugui revisar una denúncia sobre ell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizí z konverzace. Kopie se uchová, aby bylo možné posoudit případné nahlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forsvinder fra samtalen. En kopi gemmes, så en anmeldelse af den stadig kan gennemgås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verschwindet aus der Unterhaltung. Eine Kopie wird aufbewahrt, damit eine Meldung dazu weiterhin geprüft werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαφανίζεται από τη συνομιλία. Κρατιέται ένα αντίγραφο ώστε μια αναφορά για αυτό να μπορεί ακόμα να εξεταστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It disappears from the conversation. A copy is kept so a report about it can still be reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de la conversación. Se conserva una copia para que una denuncia sobre él aún pueda revisarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se katoaa keskustelusta. Kopio säilytetään, jotta siitä tehty ilmianto voidaan yhä tarkastaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disparaît de la conversation. Une copie est conservée pour qu’un signalement le concernant puisse encore être examiné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא נעלמת מהשיחה. עותק נשמר כדי שאפשר יהיה עדיין לבדוק דיווח עליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बातचीत से गायब हो जाता है। इसकी एक कॉपी रखी जाती है ताकि इस बारे में रिपोर्ट की समीक्षा हो सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestaje iz razgovora. Kopija se čuva kako bi se prijava o njoj mogla pregledati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltűnik a beszélgetésből. Egy másolatot megőrzünk, hogy az üzenetről szóló jelentést még el lehessen bírálni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan menghilang dari percakapan. Salinannya disimpan agar laporan tentangnya tetap bisa ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparisce dalla conversazione. Ne viene conservata una copia così una segnalazione al riguardo può ancora essere esaminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話から消えます。報告があった場合に審査できるよう、コピーは保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 사라져요. 신고가 접수되었을 때 검토할 수 있도록 사본은 보관돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് സംഭാഷണത്തിൽ നിന്ന് അപ്രത്യക്ഷമാകും. ഇതിനെക്കുറിച്ചുള്ള റിപ്പോർട്ട് പരിശോധിക്കാനായി ഒരു പകർപ്പ് സൂക്ഷിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia hilang daripada perbualan. Satu salinan disimpan supaya laporan tentangnya masih boleh disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forsvinner fra samtalen. En kopi beholdes slik at en rapport om den fortsatt kan vurderes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verdwijnt uit het gesprek. Er blijft een kopie bewaard zodat een melding erover nog kan worden beoordeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z rozmowy. Kopia jest zachowywana, aby zgłoszenie jej dotyczące można było nadal rozpatrzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela some da conversa. Uma cópia é mantida para que uma denúncia sobre ela ainda possa ser analisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece da conversa. É guardada uma cópia para que uma denúncia sobre ela ainda possa ser revista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispare din conversație. O copie este păstrată ca o raportare despre el să poată fi analizată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно исчезнет из переписки. Копия сохраняется, чтобы жалобу на него всё ещё можно было рассмотреть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizne z konverzácie. Kópia sa uchová, aby sa dalo posúdiť nahlásenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det försvinner från konversationen. En kopia sparas så att en rapport om det fortfarande kan granskas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடலிலிருந்து மறைந்துவிடும். இது பற்றிய புகாரை இன்னும் மறுஆய்வு செய்ய ஒரு நகல் வைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది సంభాషణ నుండి మాయమవుతుంది. దీని గురించిన రిపోర్ట్‌ను ఇంకా సమీక్షించడానికి వీలుగా ఒక కాపీ ఉంచబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความจะหายไปจากการสนทนา แต่จะเก็บสำเนาไว้เพื่อให้ยังตรวจสอบรายงานเกี่ยวกับข้อความนั้นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj sohbetten kaybolur. Hakkındaki bir şikayet yine incelenebilsin diye bir kopyası saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Воно зникає з розмови. Копія зберігається, щоб скаргу на нього все ж можна було розглянути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ گفتگو سے غائب ہو جاتا ہے۔ ایک کاپی رکھی جاتی ہے تاکہ اس کے بارے میں رپورٹ کا پھر بھی جائزہ لیا جا سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn biến mất khỏi cuộc trò chuyện. Một bản sao được giữ lại để báo cáo về nó vẫn có thể được xem xét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从对话中消失。系统会保留一份副本，以便仍可审核针对它的举报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從對話中消失。系統會保留一份副本，以便仍能審查針對它的檢舉。"
          }
        }
      }
    },
    "messages.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة هذه الرسالة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মেসেজ সরাবেন?"
