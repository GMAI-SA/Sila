    "rooms.create.explanation": {
      "comment": "What creating a room means. Listening is open to everyone; the audience governs the microphone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لكل من في «معروف» الاستماع إلى غرفتك. والجمهور الذي تختاره يحدد من يمكنه أخذ المايك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এর সবাই আপনার রুম শুনতে পারে। আপনার বেছে নেওয়া শ্রোতা ঠিক করে কে মাইক্রোফোন নিতে পারবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom a Known pot escoltar la teva sala. L'audiència que triïs decideix qui pot agafar el micròfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvou místnost může poslouchat každý v aplikaci Known. Publikum, které vybereš, určuje, kdo smí vzít mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle på Known kan lytte til dit rum. Den målgruppe, du vælger, afgør, hvem der må tage mikrofonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle auf Known können deinem Raum zuhören. Die gewählte Zielgruppe entscheidet, wer das Mikrofon nehmen darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλοι στο Known μπορούν να ακούσουν την αίθουσά σου. Το κοινό που επιλέγεις καθορίζει ποιος μπορεί να πάρει το μικρόφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone on Known can listen to your room. The audience you pick decides who may take the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos en Known pueden escuchar tu sala. La audiencia que elijas decide quién puede tomar el micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki Knownissa voivat kuunnella huonettasi. Valitsemasi yleisö päättää, kuka saa ottaa mikrofonin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde sur Known peut écouter votre salon. L’audience que vous choisissez décide qui peut prendre le micro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד ב-Known יכול להאזין לחדר שלך. הקהל שתבחר קובע מי רשאי לקחת את המיקרופון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known पर हर कोई आपका रूम सुन सकता है। आपकी चुनी ऑडियंस तय करती है कि माइक्रोफ़ोन कौन ले सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko u aplikaciji Known može slušati tvoju sobu. Publika koju odabereš određuje tko smije uzeti mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Knownon mindenki hallgathatja a szobádat. A választott közönség dönti el, ki kaphatja meg a mikrofont."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang di Known bisa mendengarkan room-mu. Audiens yang kamu pilih menentukan siapa yang boleh memegang mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque su Known può ascoltare la tua stanza. Il pubblico che scegli decide chi può prendere il microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownの誰でもあなたのルームを聴けます。選んだ範囲によって、マイクを使える人が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known의 모든 사람이 내 룸을 들을 수 있어요. 선택한 대상이 마이크를 잡을 수 있는 사람을 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ലെ എല്ലാവർക്കും നിങ്ങളുടെ റൂം കേൾക്കാം. ആർക്ക് മൈക്രോഫോൺ എടുക്കാമെന്ന് നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന പ്രേക്ഷകർ തീരുമാനിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang di Known boleh mendengar bilik anda. Khalayak yang anda pilih menentukan siapa boleh mengambil mikrofon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle på Known kan lytte til rommet ditt. Målgruppen du velger, avgjør hvem som kan ta mikrofonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen op Known kan naar je room luisteren. Het publiek dat je kiest bepaalt wie de microfoon mag nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy w Known może słuchać Twojego pokoju. Wybrana grupa odbiorców decyduje, kto może zabrać mikrofon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos no Known podem ouvir sua sala. O público que você escolher define quem pode usar o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas na Known podem ouvir a sua sala. O público que escolher decide quem pode usar o microfone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine de pe Known poate asculta camera ta. Publicul ales decide cine poate lua microfonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой в Known может слушать вашу комнату. Выбранная аудитория определяет, кто может взять микрофон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoju miestnosť môže počúvať každý na Known. Publikum, ktoré vyberieš, rozhoduje, kto môže dostať mikrofón."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla på Known kan lyssna på ditt rum. Målgruppen du väljer avgör vem som får ta mikrofonen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இல் உள்ள அனைவரும் உங்கள் அறையைக் கேட்கலாம். நீங்கள் தேர்ந்தெடுக்கும் பார்வையாளர்கள் யார் மைக்ரோஃபோனை எடுக்கலாம் என்பதைத் தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownలో అందరూ మీ రూమ్‌ను వినవచ్చు. మీరు ఎంచుకున్న ప్రేక్షకులు ఎవరు మైక్రోఫోన్ తీసుకోవచ్చో నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนบน Known ฟังห้องของคุณได้ กลุ่มผู้ชมที่คุณเลือกกำหนดว่าใครรับไมโครโฟนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'daki herkes odanızı dinleyebilir. Seçtiğiniz kitle, mikrofonu kimin alabileceğine karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухати вашу кімнату може кожен у Known. Аудиторія, яку ви виберете, визначає, хто може взяти мікрофон."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known پر ہر کوئی آپ کا روم سن سکتا ہے۔ آپ جو ناظرین چنیں وہ طے کرتے ہیں کہ مائیکروفون کون لے سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người trên Known đều có thể nghe phòng của bạn. Đối tượng bạn chọn quyết định ai được cầm micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 上的所有人都可以收听你的房间。你选择的受众决定谁可以拿麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 上的每個人都能收聽你的聊天室。你選擇的對象範圍決定誰可以使用麥克風。"
          }
        }
      }
    },
