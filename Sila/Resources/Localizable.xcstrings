        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekto zdieľa miestnosť, ktorú si viedol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon delar ett rum du var värd för."
