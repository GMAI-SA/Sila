          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică mâna"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднять руку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihnúť ruku"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räck upp handen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கை உயர்த்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేయి ఎత్తు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El kaldır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підняти руку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہاتھ اٹھائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giơ tay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舉手"
          }
        }
      }
    },
    "rooms.hand.raise.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب من المضيف الميكروفون. تواصل الاستماع حتى يقرر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোস্টের কাছে মাইক্রোফোন চায়। তিনি সিদ্ধান্ত না নেওয়া পর্যন্ত আপনি শুনতে থাকেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demana el micròfon a l'amfitrió. Continues escoltant fins que ell decideixi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá hostitele o mikrofon. Poslouchíš dál, dokud nerozhodne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beder værten om mikrofonen. Du bliver ved med at lytte, indtil værten beslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet den Host um das Mikrofon. Du hörst weiter zu, bis er entscheidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητά το μικρόφωνο από τον οικοδεσπότη. Συνεχίζεις να ακούς μέχρι να αποφασίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the host for the microphone. You keep listening until they decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide el micrófono al anfitrión. Sigues escuchando hasta que decida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyytää isännältä mikrofonia. Jatkat kuuntelua, kunnes hän päättää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande le micro à l’animateur. Vous continuez d’écouter jusqu’à sa décision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבקש מהמארח את המיקרופון. אתה ממשיך להאזין עד שיחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्ट से माइक्रोफ़ोन माँगता है। उनके फ़ैसले तक आप सुनते रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traži od domaćina mikrofon. Slušaš dok oni ne odluče."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elkéri a mikrofont a házigazdától. Addig hallgatsz, amíg döntenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta mikrofon kepada host. Kamu tetap mendengarkan sampai mereka memutuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede il microfono all'host. Continui ad ascoltare finché non decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストにマイクを求めます。ホストが決めるまでは聴き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에게 마이크를 요청해요. 호스트가 결정할 때까지 계속 들을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹോസ്റ്റിനോട് മൈക്രോഫോൺ ചോദിക്കുന്നു. അവർ തീരുമാനിക്കുന്നതുവരെ നിങ്ങൾ കേൾക്കുന്നത് തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta mikrofon daripada hos. Anda terus mendengar sehingga mereka memutuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber verten om mikrofonen. Du fortsetter å lytte til verten bestemmer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt de host om de microfoon. Je blijft luisteren tot de host beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosi gospodarza o mikrofon. Słuchasz dalej, dopóki nie zdecyduje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede o microfone ao anfitrião. Você continua ouvindo até ele decidir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede o microfone ao anfitrião. Continua a ouvir até ele decidir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cere microfonul de la gazdă. Continui să asculți până decide ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просит у ведущего микрофон. Вы продолжаете слушать, пока он не решит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiada hostiteľa o mikrofón. Počúvaš ďalej, kým sa nerozhodne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber värden om mikrofonen. Du fortsätter lyssna tills de beslutar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடத்துநரிடம் மைக்ரோஃபோன் கேட்கும். அவர் முடிவு செய்யும் வரை நீங்கள் கேட்டுக்கொண்டிருப்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మైక్రోఫోన్ కోసం హోస్ట్‌ను అడుగుతుంది. వారు నిర్ణయించే వరకు మీరు వింటూనే ఉంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอไมโครโฟนจากเจ้าของห้อง คุณฟังต่อไปจนกว่าเขาจะตัดสิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudan mikrofon ister. O karar verene kadar dinlemeye devam edersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить у ведучого мікрофон. Ви й далі слухаєте, доки він не вирішить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میزبان سے مائیکروفون مانگتا ہے۔ جب تک وہ فیصلہ نہ کریں آپ سنتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chủ phòng cho dùng micro. Bạn tiếp tục nghe cho đến khi họ quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向主持人申请麦克风。在对方决定之前，你可以继续收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向主持人要求麥克風。在對方決定前，你仍可繼續收聽。"
          }
        }
      }
    },
    "rooms.hand.raised": {
      "comment": "Listener state after raising a hand.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدك مرفوعة. المضيف يقرر من يتحدث؛ وما زلت تستمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হাত তোলা আছে। কে কথা বলবে তা হোস্ট ঠিক করেন; আপনি এখনও শুনছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens la mà aixecada. L'amfitrió decideix qui parla; tu continues escoltant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvá ruka je zvednutá. Hostitel rozhoduje, kdo mluví; ty zatím posloucháš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din hånd er oppe. Værten bestemmer, hvem der taler; du lytter stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand ist oben. Der Host entscheidet, wer spricht; du hörst weiterhin zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χέρι σου είναι σηκωμένο. Ο οικοδεσπότης αποφασίζει ποιος μιλά· εσύ συνεχίζεις να ακούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hand is up. The host decides who speaks; you're still listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la mano levantada. El anfitrión decide quién habla; sigues escuchando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kätesi on ylhäällä. Isäntä päättää, kuka puhuu; kuuntelet yhä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est levée. L’animateur décide qui parle ; vous continuez d’écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היד שלך מורמת. המארח מחליט מי מדבר; אתה עדיין מאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हाथ उठा है। कौन बोलेगा, यह होस्ट तय करता है; आप अभी सुन रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja ruka je podignuta. Domaćin odlučuje tko govori; ti i dalje slušaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkeztél. A házigazda dönti el, ki szólal meg; te továbbra is hallgatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu terangkat. Host yang memutuskan siapa berbicara; kamu masih mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua mano è alzata. L'host decide chi parla; per ora stai ascoltando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手を挙げました。誰が話すかはホストが決めます。それまでは聴いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 들었어요. 호스트가 말할 사람을 결정해요. 계속 듣고 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കൈ ഉയർന്നു. ആര് സംസാരിക്കണമെന്ന് ഹോസ്റ്റ് തീരുമാനിക്കും; നിങ്ങൾ ഇപ്പോഴും കേൾക്കുകയാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan anda diangkat. Hos menentukan siapa bercakap; anda masih mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hånden din er oppe. Verten bestemmer hvem som snakker. Du lytter fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hand is omhoog. De host beslist wie spreekt; je luistert nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ręka jest podniesiona. Gospodarz decyduje, kto mówi; nadal słuchasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mão está levantada. O anfitrião decide quem fala; você continua ouvindo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua mão está levantada. O anfitrião decide quem fala; continua a ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ți-ai ridicat mâna. Gazda decide cine vorbește; încă asculți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша рука поднята. Ведущий решает, кто говорит; вы пока слушаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja ruka je hore. O slove rozhoduje hostiteľ; zatiaľ počúvaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din hand är uppe. Värden avgör vem som talar; du lyssnar fortfarande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கை உயர்ந்துள்ளது. யார் பேசுவது என்பதை நடத்துநர் முடிவு செய்வார்; நீங்கள் இன்னும் கேட்கிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చేయి పైకి ఉంది. ఎవరు మాట్లాడాలో హోస్ట్ నిర్ణయిస్తారు; మీరు ఇంకా వింటున్నారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยกมือแล้ว เจ้าของห้องเป็นผู้ตัดสินว่าใครพูด คุณยังฟังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliniz havada. Kimin konuşacağına sunucu karar verir; siz hâlâ dinliyorsunuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу руку піднято. Ведучий вирішує, хто говорить; ви й далі слухаєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ہاتھ اٹھا ہوا ہے۔ کون بولے یہ میزبان طے کرتا ہے؛ آپ ابھی سن رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay bạn đã giơ. Chủ phòng quyết định ai phát biểu; bạn vẫn đang nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已举手。由主持人决定谁发言；你仍在收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已舉手。由主持人決定誰發言；你仍在收聽。"
          }
        }
      }
    },
