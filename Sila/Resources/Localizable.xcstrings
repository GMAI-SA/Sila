    "notifications.kind.vouch.moderation.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤال مشرف لك عن تزكية، وما قرّره. مفعّل دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো সুপারিশ নিয়ে মডারেটর আপনাকে জিজ্ঞেস করলে, এবং তাঁর সিদ্ধান্ত। সবসময় চালু।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderador que et pregunta sobre un aval, i què ha decidit. Sempre activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderátor se tě ptá na ručení a co rozhodl. Vždy zapnuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator, der spørger dig om en garanti, og hvad de besluttede. Altid slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Moderator fragt dich zu einer Bürgschaft, und was er entschieden hat. Immer an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας συντονιστής σε ρωτά για μια εγγύηση και τι αποφάσισε. Πάντα ενεργό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moderator asking you about a vouch, and what they decided. Always on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderador que te consulta sobre un aval y lo que decidió. Siempre activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderaattori kysyy sinulta takuusta ja kertoo päätöksensä. Aina päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modérateur qui vous interroge sur une caution, et ce qu’il a décidé. Toujours activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהל תוכן ששואל אותך על ערבות, ומה הוחלט. תמיד פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मॉडरेटर आपसे वाउच के बारे में पूछे, और उन्होंने क्या तय किया। हमेशा चालू।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator te pita o jamstvu i što je odlučio. Uvijek uključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy moderátor kérdez egy kezességről, és hogy mit döntött. Mindig be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator menanyakan tentang sebuah jaminan, dan apa yang diputuskan. Selalu aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderatore che ti chiede di una garanzia, e cosa ha deciso. Sempre attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデレーターから保証について問い合わせがあったとき、およびその判断。常にオンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모더레이터가 보증에 대해 문의하거나 결정을 알릴 때. 항상 켜져 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഉറപ്പിനെക്കുറിച്ച് മോഡറേറ്റർ നിങ്ങളോട് ചോദിക്കുന്നതും അവർ തീരുമാനിച്ചതും. എപ്പോഴും ഓൺ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator bertanya kepada anda tentang jaminan, dan apa yang mereka putuskan. Sentiasa aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator som spør deg om en garanti, og hva de bestemte. Alltid på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een moderator die je iets vraagt over een garantie, en wat ze hebben besloten. Altijd aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator pyta Cię o poręczenie i informuje o decyzji. Zawsze włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um moderador perguntando sobre um aval e o que ele decidiu. Sempre ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um moderador a perguntar-lhe sobre um aval, e o que decidiu. Sempre ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderator te întreabă despre o garanție și ce a decis. Mereu activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модератор спрашивает вас о поручительстве и сообщает своё решение. Всегда включено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderátor sa ťa pýta na ručenie a čo rozhodol. Vždy zapnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator som frågar dig om ett intygande, och vad de beslutade. Alltid på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உத்தரவாதம் பற்றி ஒரு மதிப்பீட்டாளர் உங்களிடம் கேட்பது, அவர் எடுத்த முடிவு. எப்போதும் இயக்கத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడరేటర్ ఒక హామీ గురించి మిమ్మల్ని అడగడం, వారు ఏం నిర్ణయించారు. ఎప్పుడూ ఆన్‌లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ดูแลสอบถามคุณเรื่องการยืนยันให้ และสิ่งที่พวกเขาตัดสิน เปิดตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir moderatörün kefillik hakkında size sorması ve verdiği karar. Her zaman açık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модератор запитує вас про поручительство і що він вирішив. Завжди ввімкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ماڈریٹر آپ سے ضمانت کے بارے میں پوچھے، اور اس کا فیصلہ۔ ہمیشہ آن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người kiểm duyệt hỏi bạn về một lời bảo chứng, và điều họ quyết định. Luôn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版主就某个担保向你询问，以及他们作出的决定。始终开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版主就擔保詢問你，以及他們的決定。永遠開啟。"
          }
        }
      }
    },
    "notifications.kind.vouch.person.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن التزكية التي تقف خلف اسمك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নামের পেছনে থাকা সুপারিশ নিয়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre l'aval que hi ha darrere del teu nom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O ručení, které stojí za tvým jménem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om den garanti, der står bag dit navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Bürgschaft, die hinter deinem Namen steht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την εγγύηση που στηρίζει το όνομά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About the vouch that stands behind your name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre el aval que respalda tu nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi takana olevasta takuusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de la caution qui se tient derrière votre nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על הערבות שעומדת מאחורי שמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस वाउच के बारे में जो आपके नाम के पीछे खड़ा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "O jamstvu koje stoji iza tvog imena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A neved mögött álló kezességről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentang jaminan yang berdiri di belakang namamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla garanzia che sta dietro il tuo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの名前を支えている保証について。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 이름을 뒷받침하는 보증에 관한 알림."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പേരിന് പിന്നിൽ നിൽക്കുന്ന ഉറപ്പിനെക്കുറിച്ച്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentang jaminan yang menyokong nama anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om garantien som står bak navnet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Over de garantie die achter je naam staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O poręczeniu, które stoi za Twoim imieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o aval que sustenta o seu nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o aval que sustenta o seu nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Despre garanția care stă în spatele numelui tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О поручительстве, которое стоит за вашим именем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O ručení, ktoré stojí za tvojím menom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om intygandet som står bakom ditt namn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயருக்குப் பின்னால் நிற்கும் உத்தரவாதம் பற்றி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పేరు వెనుక ఉన్న హామీ గురించి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกี่ยวกับการยืนยันให้ที่อยู่เบื้องหลังชื่อของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınızın arkasındaki kefillik hakkında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про поручительство, що стоїть за вашим іменем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ضمانت کے بارے میں جو آپ کے نام کے پیچھے کھڑی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
