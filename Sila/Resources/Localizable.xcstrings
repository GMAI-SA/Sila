    "ds.tabBar.unreadCount": {
      "comment": "VoiceOver value on a tab-bar slot carrying an unread badge.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إشعارات غير مقروءة"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إشعارًا غير مقروء"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إشعار واحد غير مقروء"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld إشعار غير مقروء"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إشعاران غير مقروءين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا إشعارات غير مقروءة"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unread"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unread"
                }
              }
            }
          }
        }
      }
    },
    "ds.textField.defaultHint": {
