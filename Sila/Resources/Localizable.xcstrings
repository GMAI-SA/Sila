        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected. Tap again to clear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado. Toca de nuevo para quitarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittu. Napauta uudelleen tyhjentääksesi."
