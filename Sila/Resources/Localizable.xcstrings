          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir topluluk sizi içeri aldığında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли спільнота вас приймає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی کمیونٹی آپ کو اندر آنے دے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một cộng đồng cho bạn vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区接纳你时。"
