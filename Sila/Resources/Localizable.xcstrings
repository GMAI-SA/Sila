        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاهل تغييراتك غير المحفوظة ويستعيد إعداداتك المخزّنة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অসংরক্ষিত পরিবর্তন ফেলে দিয়ে সংরক্ষিত সেটিংস ফিরিয়ে আনে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta els canvis sense desar i restaura els ajustos desats"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodí neuložené změny a obnoví uložená nastavení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasserer dine ugemte ændringer og gendanner dine gemte indstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwirft deine nicht gesicherten Änderungen und stellt deine gespeicherten Einstellungen wieder her"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απορρίπτει τις μη αποθηκευμένες αλλαγές και επαναφέρει τις αποθηκευμένες ρυθμίσεις σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throws away your unsaved changes and restores your stored settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta tus cambios sin guardar y restaura tus ajustes guardados"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hylkää tallentamattomat muutoksesi ja palauttaa tallennetut asetuksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonne vos modifications non enregistrées et rétablit vos réglages enregistrés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זורק את השינויים שלא נשמרו ומשחזר את ההגדרות השמורות שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बिना सेव किए बदलाव हटाता है और सेव की हुई सेटिंग्स वापस लाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbacuje tvoje nespremljene promjene i vraća spremljene postavke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldobja a mentetlen módosításaidat, és visszaállítja a tárolt beállításokat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang perubahan yang belum disimpan dan memulihkan pengaturan tersimpanmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta le modifiche non salvate e ripristina le impostazioni salvate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の変更を破棄し、保存済みの設定に戻します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 변경 사항을 버리고 저장된 설정으로 복원해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്യാത്ത മാറ്റങ്ങൾ ഉപേക്ഷിച്ച് സൂക്ഷിച്ചിരിക്കുന്ന ക്രമീകരണങ്ങൾ പുനഃസ്ഥാപിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang perubahan anda yang belum disimpan dan memulihkan tetapan tersimpan anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaster de ulagrede endringene dine og gjenoppretter de lagrede innstillingene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooit je niet-opgeslagen wijzigingen weg en herstelt je opgeslagen instellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzuca niezapisane zmiany i przywraca zapisane ustawienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta as alterações não salvas e restaura seus ajustes guardados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeita as alterações não guardadas e repõe as definições guardadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aruncă modificările nesalvate și restabilește setările salvate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбрасывает несохранённые изменения и восстанавливает сохранённые настройки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodí neuložené zmeny a obnoví uložené nastavenia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastar dina osparade ändringar och återställer dina sparade inställningar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிக்காத மாற்றங்களை நீக்கி சேமித்த அமைப்புகளை மீட்டெடுக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేయని మార్పులను తొలగించి, నిల్వ చేసిన సెట్టింగ్‌లను పునరుద్ధరిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งการเปลี่ยนแปลงที่ยังไม่ได้บันทึกและคืนค่าการตั้งค่าที่เก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş değişikliklerinizi atar ve kayıtlı ayarlarınızı geri yükler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкидає ваші незбережені зміни й відновлює збережені налаштування"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی غیر محفوظ تبدیلیاں ختم کرتا ہے اور محفوظ سیٹنگز بحال کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ các thay đổi chưa lưu và khôi phục cài đặt đã lưu của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃未保存的更改，并恢复已保存的设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄未儲存的變更並還原已儲存的設定"
          }
        }
      }
    },
    "preferences.disclosure.body": {
      "comment": "The plain-language statement of what the tagging is: automatic, sometimes wrong, never shown on the post, and used only for these settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُصنَّف كل منشور تلقائيًا حسب الموضوع بواسطة برنامج يعمل على خوادم «معروف»، وهذا البرنامج يخطئ أحيانًا. ولا تظهر هذه التصنيفات على المنشور نفسه أبدًا — وهذه الإعدادات هي الاستخدام الوحيد لها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এর সার্ভারে চলা সফটওয়্যার প্রতিটি পোস্টে স্বয়ংক্রিয়ভাবে বিষয়ের লেবেল দেয়, আর সেই সফটওয়্যার মাঝে মাঝে ভুল করে। লেবেলগুলো কখনও পোস্টে দেখানো হয় না — এই সেটিংস ছাড়া আর কোনো কাজে এগুলো ব্যবহার করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicació s'etiqueta automàticament per tema amb programari que s'executa als servidors de Known, i de vegades aquest programari s'equivoca. Les etiquetes no es mostren mai a la publicació: aquests ajustos són l'únic ús que en fem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý příspěvek automaticky označuje tématem software běžící na serverech aplikace Known a ten se občas mýlí. Štítky se nikdy nezobrazují u příspěvku samotného – tato nastavení jsou jediné, k čemu se používají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert opslag får automatisk et emnemærke af software, der kører på Knowns servere, og den software tager indimellem fejl. Mærkerne vises aldrig på selve opslaget – disse indstillinger er det eneste, de bruges til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Beitrag wird automatisch von Software auf den Servern von Known nach Thema gelabelt, und diese Software irrt sich manchmal. Die Labels werden nie am Beitrag selbst angezeigt – diese Einstellungen sind das Einzige, wofür sie verwendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ανάρτηση επισημαίνεται αυτόματα με θέμα από λογισμικό που τρέχει στους διακομιστές του Known και αυτό το λογισμικό μερικές φορές κάνει λάθος. Οι ετικέτες δεν εμφανίζονται ποτέ στην ίδια την ανάρτηση — αυτές οι ρυθμίσεις είναι το μόνο για το οποίο χρησιμοποιούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every post is automatically labelled by topic by software running on Known's servers, and that software is sometimes wrong. The labels are never shown on the post itself — these settings are the only thing they are used for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicación se etiqueta por tema automáticamente mediante software que se ejecuta en los servidores de Known, y ese software a veces se equivoca. Las etiquetas nunca se muestran en la propia publicación: estos ajustes son lo único para lo que se usan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen julkaisu luokitellaan automaattisesti aiheen mukaan Knownin palvelimilla toimivalla ohjelmistolla, ja se erehtyy joskus. Luokkia ei koskaan näytetä itse julkaisussa – näitä asetuksia varten ne ovat ainoa käyttötarkoitus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque post est automatiquement étiqueté par sujet par un logiciel qui tourne sur les serveurs de Known, et ce logiciel se trompe parfois. Les étiquettes ne sont jamais affichées sur le post lui-même — ces réglages sont leur seul usage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל פוסט מתויג אוטומטית לפי נושא על ידי תוכנה שרצה בשרתי Known, והתוכנה הזו טועה לפעמים. התוויות אף פעם לא מוצגות על הפוסט עצמו — ההגדרות האלה הן הדבר היחיד שבו משתמשים בהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पोस्ट पर Known के सर्वर पर चलने वाला सॉफ़्टवेयर अपने-आप टॉपिक का लेबल लगाता है, और वह सॉफ़्टवेयर कभी-कभी ग़लत होता है। लेबल पोस्ट पर कभी नहीं दिखाए जाते — ये सेटिंग्स ही उनका एकमात्र उपयोग हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka objava automatski se označava temom softverom koji radi na poslužiteljima aplikacije Known, a taj softver ponekad griješi. Oznake se nikada ne prikazuju na samoj objavi — ove postavke jedino su za što se koriste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bejegyzést automatikusan témacímkével lát el a Known szervereken futó szoftver, amely néha téved. A címkék soha nem jelennek meg magán a bejegyzésen – ezeken a beállításokon kívül semmire nem használjuk őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap postingan diberi label topik secara otomatis oleh perangkat lunak di server Known, dan perangkat lunak itu kadang keliru. Label tidak pernah ditampilkan pada postingan itu sendiri — pengaturan ini satu-satunya kegunaannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni post viene etichettato automaticamente per argomento da un software che gira sui server di Known, e a volte quel software sbaglia. Le etichette non vengono mai mostrate sul post: queste impostazioni sono l'unico uso che se ne fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての投稿には、Knownのサーバー上で動くソフトウェアによって、トピックのラベルが自動的に付けられます。このソフトウェアは間違えることもあります。ラベルは投稿自体には表示されず、これらの設定にのみ使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 게시물은 Known 서버에서 실행되는 소프트웨어가 자동으로 주제 라벨을 붙이며, 이 소프트웨어는 가끔 틀려요. 라벨은 게시물 자체에는 절대 표시되지 않고, 이 설정에만 사용돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ പോസ്റ്റിനും Known-ന്റെ സെർവറുകളിൽ പ്രവർത്തിക്കുന്ന സോഫ്റ്റ്‌വെയർ സ്വയമേവ വിഷയ ലേബൽ നൽകുന്നു, ആ സോഫ്റ്റ്‌വെയറിന് ചിലപ്പോൾ തെറ്റാം. ലേബലുകൾ പോസ്റ്റിൽ ഒരിക്കലും കാണിക്കില്ല — ഈ ക്രമീകരണങ്ങൾക്ക് വേണ്ടി മാത്രമാണ് അവ ഉപയോഗിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap siaran dilabelkan mengikut topik secara automatik oleh perisian yang berjalan pada pelayan Known, dan perisian itu kadangkala silap. Label tidak pernah dipaparkan pada siaran itu sendiri — tetapan ini satu-satunya tujuan ia digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert innlegg merkes automatisk med emne av programvare som kjører på Knowns servere, og den tar av og til feil. Merkene vises aldri på selve innlegget. Disse innstillingene er det eneste de brukes til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bericht krijgt automatisch een onderwerplabel van software op de servers van Known, en die software zit er soms naast. De labels worden nooit op het bericht zelf getoond: deze instellingen zijn het enige waarvoor ze worden gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wpis jest automatycznie oznaczany tematem przez oprogramowanie działające na serwerach Known, które czasem się myli. Etykiety nigdy nie są pokazywane na samym wpisie — te ustawienia to jedyne miejsce, w którym są używane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada post recebe automaticamente um rótulo de tópico, atribuído por um software que roda nos servidores do Known, e esse software às vezes erra. Os rótulos nunca aparecem no próprio post; estes ajustes são a única coisa para a qual eles servem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicação é etiquetada automaticamente por tópico por software que corre nos servidores da Known, e esse software por vezes erra. As etiquetas nunca são mostradas na própria publicação — estas definições são a única coisa para que são usadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare postare este etichetată automat pe subiect de un software care rulează pe serverele Known, iar acel software greșește uneori. Etichetele nu sunt afișate niciodată pe postare — aceste setări sunt singurul lucru pentru care sunt folosite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый пост автоматически помечается темой программой на серверах Known, и эта программа иногда ошибается. Сами метки на посте не показываются — они используются только для этих настроек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý príspevok automaticky označuje témou softvér bežiaci na serveroch Known a ten sa niekedy mýli. Označenia sa nikdy nezobrazujú na samotnom príspevku — tieto nastavenia sú jediné, na čo sa používajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje inlägg får automatiskt en ämnesetikett av programvara som körs på Knowns servrar, och den programvaran har ibland fel. Etiketterna visas aldrig på själva inlägget – de här inställningarna är det enda de används till."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு இடுகையும் Known-இன் சேவையகங்களில் இயங்கும் மென்பொருளால் தானாகத் தலைப்பு வாரியாக லேபிளிடப்படுகிறது, அந்த மென்பொருள் சில நேரம் தவறாகலாம். லேபிள்கள் இடுகையிலேயே ஒருபோதும் காட்டப்படுவதில்லை — இந்த அமைப்புகளுக்கு மட்டுமே அவை பயன்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి పోస్ట్‌కు Known సర్వర్‌లలో నడిచే సాఫ్ట్‌వేర్ ఆటోమేటిక్‌గా అంశం లేబుల్ వేస్తుంది, ఆ సాఫ్ట్‌వేర్ కొన్నిసార్లు తప్పు చేస్తుంది. లేబుల్‌లు పోస్ట్‌పై ఎప్పుడూ చూపబడవు — ఈ సెట్టింగ్‌ల కోసం మాత్రమే అవి ఉపయోగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกโพสต์ถูกติดป้ายหัวข้อโดยอัตโนมัติด้วยซอฟต์แวร์ที่ทำงานบนเซิร์ฟเวอร์ของ Known และซอฟต์แวร์นั้นบางครั้งก็ผิดพลาด ป้ายจะไม่แสดงบนตัวโพสต์ การตั้งค่าเหล่านี้คือสิ่งเดียวที่ใช้ป้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gönderi, Known'un sunucularında çalışan yazılım tarafından otomatik olarak konuya göre etiketlenir ve bu yazılım bazen yanılır. Etiketler gönderinin üzerinde asla gösterilmez; yalnızca bu ayarlar için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен допис автоматично позначається темою програмою на серверах Known, і ця програма іноді помиляється. Позначки ніколи не показуються на самому дописі — ці налаштування єдине, для чого їх використовують."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر پوسٹ پر موضوع کا لیبل Known کے سرورز پر چلنے والا سافٹ ویئر خود بخود لگاتا ہے، اور وہ سافٹ ویئر کبھی کبھی غلط ہوتا ہے۔ لیبل پوسٹ پر خود کبھی نہیں دکھائے جاتے — یہ سیٹنگز ہی ان کا واحد استعمال ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bài đăng được phần mềm chạy trên máy chủ của Known tự động gắn nhãn chủ đề, và phần mềm đó đôi khi sai. Nhãn không bao giờ hiển thị trên chính bài đăng — các cài đặt này là thứ duy nhất dùng đến chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条帖子都会由运行在 Known 服务器上的软件自动按话题打上标签，而该软件有时会出错。这些标签绝不会显示在帖子本身上，它们只用于这些设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每則貼文都會由 Known 伺服器上執行的軟體自動標上主題，而該軟體有時會出錯。標籤絕不會顯示在貼文上，這些設定是它們唯一的用途。"
          }
        }
      }
    },
