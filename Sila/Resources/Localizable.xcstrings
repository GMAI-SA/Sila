    "search.field.a11yHint": {
      "comment": "VoiceOver hint for the search field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث في المنشورات والأشخاص. اكتب حرفين على الأقل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্ট ও মানুষ খোঁজে। কমপক্ষে দুটি অক্ষর লিখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca publicacions i persones. Escriu almenys dos caràcters"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledá příspěvky a lidi. Napiš alespoň dva znaky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søger i opslag og personer. Skriv mindst to tegn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht Beiträge und Personen. Gib mindestens zwei Zeichen ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητά αναρτήσεις και άτομα. Πληκτρολόγησε τουλάχιστον δύο χαρακτήρες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches posts and people. Type at least two characters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca publicaciones y personas. Escribe al menos dos caracteres"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakee julkaisuja ja ihmisiä. Kirjoita vähintään kaksi merkkiä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des posts et des personnes. Saisissez au moins deux caractères"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחפש פוסטים ואנשים. הקלד לפחות שני תווים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट और लोग खोजता है। कम से कम दो अक्षर टाइप करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretražuje objave i ljude. Upiši najmanje dva znaka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejegyzések és emberek keresése. Írj be legalább két karaktert"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari postingan dan orang. Ketik minimal dua karakter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca post e persone. Scrivi almeno due caratteri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿とユーザーを検索します。2文字以上入力してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물과 사람을 검색해요. 두 글자 이상 입력하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റുകളും ആളുകളെയും തിരയുന്നു. കുറഞ്ഞത് രണ്ട് അക്ഷരങ്ങൾ ടൈപ്പ് ചെയ്യുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari siaran dan orang. Taip sekurang-kurangnya dua aksara"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker etter innlegg og folk. Skriv minst to tegn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt berichten en mensen. Typ minimaal twee tekens"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuje wpisy i osoby. Wpisz co najmniej dwa znaki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca posts e pessoas. Digite pelo menos dois caracteres"
          }
