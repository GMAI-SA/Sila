          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke identitetsverifisert · garantert for av @%1$@ siden %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
