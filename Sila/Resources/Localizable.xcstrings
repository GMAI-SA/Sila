                  "state": "translated",
                  "value": "اكتب %lld حرف على الأقل للبحث في الغرف."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب حرفين على الأقل للبحث في الغرف."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب أحرفًا للبحث في الغرف."
                }
              }
