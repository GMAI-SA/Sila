    "post.scope.region.thread.unknownAccessibility": {
      "comment": "VoiceOver reading of a regional thread whose region is unnamed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلة إقليمية. لا يمكن الرد إلا للحسابات الموثّقة في تلك المنطقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আঞ্চলিক থ্রেড। শুধু ওই অঞ্চলের ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fil regional. Només hi poden respondre els comptes verificats en aquesta regió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionální vlákno. Odpovídat mohou jen ověřené účty v dané oblasti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional tråd. Kun verificerede konti i den region kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionaler Thread. Nur verifizierte Konten in dieser Region können antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιφερειακό νήμα. Μόνο επαληθευμένοι λογαριασμοί σε αυτή την περιοχή μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional thread. Only verified accounts in that region can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilo regional. Solo pueden responder las cuentas verificadas en esa región."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alueketju. Vain kyseisellä alueella vahvistetut tilit voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion régionale. Seuls les comptes vérifiés dans cette région peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרשור אזורי. רק חשבונות מאומתים באותו אזור יכולים להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्रीय थ्रेड। केवल उस क्षेत्र के सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalna nit. Odgovarati mogu samo potvrđeni računi u toj regiji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionális szál. Csak az adott térségben hitelesített fiókok válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas regional. Hanya akun terverifikasi di kawasan itu yang bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussione regionale. Solo gli account verificati in quella regione possono rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域のスレッド。その地域で認証されたアカウントだけが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 스레드. 해당 지역에서 인증된 계정만 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മേഖലാ ത്രെഡ്. ആ മേഖലയിൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas serantau. Hanya akaun yang disahkan di rantau itu boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional tråd. Bare verifiserte kontoer i den regionen kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale thread. Alleen geverifieerde accounts in die regio kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątek regionalny. Odpowiadać mogą tylko zweryfikowane konta z tego regionu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fio regional. Só contas verificadas nessa região podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversa regional. Só contas verificadas nessa região podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversație regională. Doar conturile verificate în acea regiune pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Региональная ветка. Отвечать могут только проверенные аккаунты из этого региона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionálne vlákno. Odpovedať môžu iba overené účty z tohto regiónu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional tråd. Bara verifierade konton i den regionen kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிராந்திய உரையாடல். அந்தப் பிராந்தியத்தில் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంతీయ థ్రెడ్. ఆ ప్రాంతంలో ధృవీకరించబడిన ఖాతాలు మాత్రమే రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เธรดระดับภูมิภาค เฉพาะบัญชีที่ยืนยันตัวตนแล้วในภูมิภาคนั้นเท่านั้นที่ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgesel konuşma. Yalnızca o bölgede doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регіональне обговорення. Відповідати можуть лише верифіковані облікові записи в цьому регіоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "علاقائی تھریڈ۔ صرف اس خطے کے تصدیق شدہ اکاؤنٹ جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi khu vực. Chỉ tài khoản đã xác minh ở khu vực đó mới trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区对话串。只有在该地区验证的账户可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地區串文。只有在該地區通過驗證的帳號能回覆。"
          }
        }
      }
    },
    "post.sensitive.covered": {
      "comment": "Under the cover title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطّاه الكاتب. افتحه لتقرأ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেখক ঢেকে রেখেছেন। পড়তে খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberta per l'autor. Obre-la per llegir-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakryto autorem. Otevři a přečti si to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult af forfatteren. Åbn det for at læse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Autor verdeckt. Öffne ihn zum Lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλύπτεται από τον συντάκτη. Άνοιξέ το για να διαβάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covered by the author. Open it to read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierta por el autor. Ábrela para leerla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittajan peittämä. Avaa lukeaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqué par l’auteur. Ouvrez-le pour le lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכוסה על ידי הכותב. פתח כדי לקרוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक ने छिपाया है। पढ़ने के लिए खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autor ju je prekrio. Otvori je da je pročitaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerző letakarta. Nyisd meg az olvasáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditutup oleh penulis. Buka untuk membaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coperto dall'autore. Aprilo per leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿者が隠しています。開くと読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성자가 가렸어요. 읽으려면 열어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രചയിതാവ് മറച്ചത്. വായിക്കാൻ തുറക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditutup oleh penulis. Buka untuk membaca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildekket av forfatteren. Åpne det for å lese."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgedekt door de auteur. Open het om te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasłonięte przez autora. Otwórz, aby przeczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberto pelo autor. Abra para ler."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapada pelo autor. Abra para ler."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoperit de autor. Deschide pentru a citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыто автором. Откройте, чтобы прочитать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakryté autorom. Otvor ho a prečítaj si ho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolt av skribenten. Öppna för att läsa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆசிரியரால் மறைக்கப்பட்டது. படிக்கத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రచయిత కప్పి ఉంచారు. చదవడానికి తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เขียนปิดไว้ เปิดเพื่ออ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazar tarafından gizlendi. Okumak için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрито автором. Відкрийте, щоб прочитати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مصنف نے چھپایا ہے۔ پڑھنے کے لیے کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tác giả che lại. Mở ra để đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被作者遮盖。打开即可阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被作者遮蓋。開啟即可閱讀。"
          }
        }
      }
    },
