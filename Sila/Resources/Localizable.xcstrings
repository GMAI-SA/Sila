        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před každou dostaneš připomenutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bliver mindet om hvert enkelt."
          }
        },
        "de": {
