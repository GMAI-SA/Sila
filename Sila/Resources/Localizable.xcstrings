        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतरराष्ट्रीय फ़ॉर्मैट इस्तेमाल करें, जो प्लस और देश कोड से शुरू हो — जैसे %@।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi međunarodni format, koji počinje plusom i pozivnim brojem zemlje — na primjer %@."
