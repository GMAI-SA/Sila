        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodiť príspevok a video"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förkasta inlägg och video"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகையையும் வீடியோவையும் நிராகரி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్ మరియు వీడియోను విస్మరించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละทิ้งโพสต์และวิดีโอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderiyi ve videoyu sil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати допис і відео"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسٹ اور ویڈیو رد کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bài đăng và video"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃帖子和视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄貼文和影片"
          }
        }
      }
    },
    "video.pending.discard.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تجاهل هذا المنشور؟ سيتوقف رفع الفيديو ويُحذف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোস্ট বাতিল করবেন? এর ভিডিও আপলোড বন্ধ হবে এবং মুছে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar aquesta publicació? El seu vídeo deixa de pujar-se i s'elimina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit tento příspěvek? Nahrávání jeho videa se zastaví a video se smaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kassér dette opslag? Dets video holder op med at blive uploadet og slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Beitrag verwerfen? Das Hochladen seines Videos stoppt und es wird gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να απορριφθεί αυτή η ανάρτηση; Η μεταφόρτωση του βίντεό της σταματά και το βίντεο διαγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this post? Its video stops uploading and is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar esta publicación? Su vídeo deja de subirse y se elimina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hylätäänkö tämä julkaisu? Sen videon lataus pysähtyy ja video poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner ce post ? L’envoi de sa vidéo s’arrête et elle est supprimée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את הפוסט הזה? הווידאו שלו מפסיק להיות מועלה ונמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पोस्ट हटाएँ? इसके वीडियो का अपलोड रुक जाएगा और वह डिलीट हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbaciti ovu objavu? Prijenos njezina videa staje i video se briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elveted ezt a bejegyzést? A videó feltöltése leáll, és törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang postingan ini? Videonya berhenti diunggah dan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartare questo post? Il suo video smette di caricarsi e viene eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投稿を破棄しますか? 動画のアップロードは止まり、削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시물을 버릴까요? 동영상 업로드가 중단되고 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പോസ്റ്റ് ഉപേക്ഷിക്കണോ? അതിന്റെ വീഡിയോ അപ്‌ലോഡ് നിർത്തി ഇല്ലാതാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang siaran ini? Muat naik videonya dihentikan dan dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forkaste dette innlegget? Videoen slutter å lastes opp og slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bericht weggooien? Het uploaden van de video stopt en de video wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić ten wpis? Przesyłanie wideo zostanie przerwane, a ono usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar este post? O envio do vídeo para e ele é excluído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar esta publicação? O envio do vídeo para e o vídeo é eliminado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Renunți la această postare? Încărcarea videoului se oprește, iar videoul este șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбросить этот пост? Загрузка видео прекратится, а само видео будет удалено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodiť tento príspevok? Nahrávanie jeho videa sa zastaví a video sa odstráni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förkasta det här inlägget? Dess video slutar laddas upp och raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இடுகையை நிராகரிக்கவா? அதன் வீடியோ பதிவேறுவது நின்று நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పోస్ట్‌ను విస్మరించాలా? దాని వీడియో అప్‌లోడ్ ఆగిపోయి తొలగించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละทิ้งโพสต์นี้? วิดีโอจะหยุดอัปโหลดและถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gönderi silinsin mi? Videosunun yüklenmesi durur ve video silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати цей допис? Завантаження його відео зупиниться, а відео буде видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پوسٹ رد کریں؟ اس کی ویڈیو کا اپ لوڈ رک جاتا ہے اور وہ حذف ہو جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bài đăng này? Video của nó sẽ ngừng tải lên và bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃这条帖子？其视频将停止上传并被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要捨棄這則貼文嗎？其影片將停止上傳並被刪除。"
          }
        }
      }
    },
