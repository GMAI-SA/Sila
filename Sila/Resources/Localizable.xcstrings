          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók nem fogadhatja el a kezességet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini tidak bisa menerima jaminan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non può accettare la garanzia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは保証を受け入れられません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 보증을 수락할 수 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിന് വൗച്ച് സ്വീകരിക്കാനാകില്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini tidak boleh menerima jaminan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen kan ikke godta garantien"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account kan de garantie niet accepteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie może przyjąć poręczenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não pode aceitar o aval"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não pode aceitar o aval"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont nu poate accepta garanția"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт не может принять поручительство"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemôže prijať ručenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot kan inte godta intygandet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கால் உறுதிமொழியை ஏற்க முடியாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతా హామీని అంగీకరించలేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้รับการยืนยันให้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap kefilliği kabul edemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис не може прийняти поручительство"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اکاؤنٹ ضمانت قبول نہیں کر سکتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này không thể chấp nhận lời bảo chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户无法接受该担保"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號無法接受擔保"
          }
        }
      }
    },
    "vouch.claim.title": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏⁦@%@⁩ يزكّيك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ আপনাকে সুপারিশ করছেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ t'avala"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ za tebe ručí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ går i god for dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bürgt für dich"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ εγγυάται για εσένα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ is vouching for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ te está avalando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ takaa sinut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ se porte garant de vous"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ערב לך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ आपके लिए वाउच कर रहे हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ jamči za tebe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kezeskedik érted"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ menjaminmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ garantisce per te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@があなたを保証しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님이 나를 보증해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ നിങ്ങൾക്ക് വൗച്ച് ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ menjamin anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ garanterer for deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ staat voor je in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ za Ciebie poręcza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ está avalizando você"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ está a avalizá-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ garantează pentru tine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ поручается за вас"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ za teba ručí"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ intygar för dig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ உங்களுக்காக உறுதியளிக்கிறார்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ మీకు హామీ ఇస్తున్నారు"
          }
        },
        "th": {
