        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está pedindo para falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está a pedir para falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni nu cere să vorbească."
          }
        },
        "ru": {
