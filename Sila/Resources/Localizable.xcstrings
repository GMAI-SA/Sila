        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُطلب من ⁦@%@⁩ تأكيد أنك أنت. يمكنك توثيق هويتك في الأثناء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@-কে নিশ্চিত করতে বলা হবে যে এটি আপনি। ইতিমধ্যে আপনি নিজের পরিচয় ভেরিফাই করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es demanarà a @%@ que confirmi que ets tu. Mentrestant pots verificar la teva pròpia identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bude požádán o potvrzení, že jsi to ty. Mezitím můžeš ověřit vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bliver bedt om at bekræfte, at det er dig. Du kan i mellemtiden verificere din egen identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ wird gebeten zu bestätigen, dass du es bist. Du kannst in der Zwischenzeit deine eigene Identität verifizieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ θα κληθεί να επιβεβαιώσει ότι είσαι εσύ. Στο μεταξύ μπορείς να επαληθεύσεις την ταυτότητά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ will be asked to confirm it's you. You can verify your own identity meanwhile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le pedirá a @%@ que confirme que eres tú. Mientras tanto, puedes verificar tu propia identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjää @%@ pyydetään vahvistamaan, että se olet sinä. Voit sillä välin vahvistaa oman henkilöllisyytesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sera invité à confirmer que c’est vous. Vous pouvez vérifier votre propre identité en attendant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ יתבקש לאשר שזה אתה. בינתיים אפשר לאמת את זהותך בעצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ से पुष्टि करने को कहा जाएगा कि यह आप हैं। इस बीच आप अपनी पहचान खुद सत्यापित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od @%@ će se tražiti da potvrdi da si to ti. U međuvremenu možeš potvrditi vlastiti identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ meg fogja erősíteni, hogy te vagy az. Közben hitelesítheted a saját személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ akan diminta mengonfirmasi bahwa itu kamu. Sementara itu kamu bisa memverifikasi identitasmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A @%@ verrà chiesto di confermare che sei tu. Nel frattempo puoi verificare la tua identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@に、あなた本人であることの確認が依頼されます。その間にご自身で本人確認をすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님에게 본인이 맞는지 확인을 요청해요. 그동안 직접 신원을 인증할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് നിങ്ങളാണെന്ന് സ്ഥിരീകരിക്കാൻ @%@ നോട് ആവശ്യപ്പെടും. അതിനിടെ നിങ്ങൾക്ക് സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ akan diminta mengesahkan itu anda. Anda boleh mengesahkan identiti anda sendiri sementara itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ blir bedt om å bekrefte at det er deg. Du kan verifisere din egen identitet i mellomtiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ wordt gevraagd te bevestigen dat jij het bent. Intussen kun je je eigen identiteit verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ zostanie poproszony(-a) o potwierdzenie, że to Ty. W międzyczasie możesz zweryfikować własną tożsamość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ será solicitado a confirmar que é você. Enquanto isso, você pode verificar sua própria identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai ser pedido a @%@ que confirme que é você. Entretanto, pode verificar a sua própria identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui @%@ i se va cere să confirme că ești tu. Între timp îți poți verifica propria identitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ попросят подтвердить, что это вы. Тем временем вы можете пройти собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bude požiadaný o potvrdenie, že si to ty. Medzitým si môžeš overiť vlastnú totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ombeds bekräfta att det är du. Du kan verifiera din egen identitet under tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது நீங்கள்தான் என உறுதிப்படுத்த @%@ இடம் கேட்கப்படும். அதற்குள் நீங்கள் உங்கள் அடையாளத்தைச் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది మీరేనని నిర్ధారించమని @%@ ను అడుగుతారు. ఈలోగా మీరు మీ స్వంత గుర్తింపును ధృవీకరించుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ จะถูกขอให้ยืนยันว่าเป็นคุณ ระหว่างนี้คุณยืนยันตัวตนของตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kişisinden sizin olduğunuzu onaylaması istenecek. Bu arada kendi kimliğinizi doğrulayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ попросять підтвердити, що це ви. Тим часом ви можете верифікувати власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ سے تصدیق کرنے کو کہا جائے گا کہ یہ آپ ہیں۔ اس دوران آپ اپنی شناخت کی تصدیق کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sẽ được yêu cầu xác nhận đó là bạn. Trong lúc đó bạn có thể tự xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将请 @%@ 确认是你本人。在此期间你也可以验证自己的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 將被請求確認是你本人。在此期間你也可以驗證自己的身分。"
          }
        }
      }
    },
