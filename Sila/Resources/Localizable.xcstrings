    "auth.rejected.reason.dateOfBirthMismatch": {
      "comment": "Rejection reason `date_of_birth_mismatch`, as the decision email words it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تاريخ الميلاد في الهوية التي قدّمتها لا يطابق تاريخ الميلاد الذي أدخلته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে পরিচয়পত্র দেখিয়েছেন তার জন্মতারিখ আপনার দেওয়া জন্মতারিখের সাথে মেলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La data de naixement de la identitat que has presentat no coincideix amb la que has introduït."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum narození na předloženém dokladu se neshoduje s datem narození, které jsi zadal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdatoen på det id, du viste, svarer ikke til den fødselsdato, du angav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geburtsdatum im vorgelegten Ausweis stimmt nicht mit dem von dir eingegebenen Geburtsdatum überein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία γέννησης στην ταυτότητα που υπέβαλες δεν ταιριάζει με την ημερομηνία γέννησης που εισήγαγες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date of birth on the identity you presented does not match the date of birth you entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de nacimiento de la identidad que presentaste no coincide con la que introdujiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittämäsi henkilöllisyyden syntymäaika ei vastaa antamaasi syntymäaikaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de naissance figurant sur l’identité présentée ne correspond pas à celle que vous avez saisie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך הלידה בזהות שהצגת אינו תואם לתאריך הלידה שהזנת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दिखाए गए पहचान दस्तावेज़ पर जन्म तिथि आपकी दर्ज की गई जन्म तिथि से मेल नहीं खाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum rođenja na predočenoj ispravi ne podudara se s datumom rođenja koji si unio/unijela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemutatott okmányon szereplő születési dátum nem egyezik a megadott születési dátummal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal lahir pada identitas yang kamu tunjukkan tidak cocok dengan tanggal lahir yang kamu masukkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di nascita sul documento presentato non corrisponde a quella che hai inserito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提示された身分証明書の生年月日が、入力された生年月日と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출한 신분증의 생년월일이 입력한 생년월일과 일치하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സമർപ്പിച്ച തിരിച്ചറിയൽ രേഖയിലെ ജനനത്തീയതി നിങ്ങൾ നൽകിയ ജനനത്തീയതിയുമായി ഒത്തുപോകുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh lahir pada identiti yang anda kemukakan tidak sepadan dengan tarikh lahir yang anda masukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdatoen på legitimasjonen du la fram, stemmer ikke med fødselsdatoen du oppga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geboortedatum op het identiteitsbewijs dat je hebt getoond komt niet overeen met de geboortedatum die je hebt ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data urodzenia z okazanego dokumentu tożsamości nie zgadza się z wpisaną przez Ciebie datą urodzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de nascimento na identidade apresentada não corresponde à data de nascimento que você informou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de nascimento na identidade que apresentou não corresponde à data de nascimento que introduziu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data nașterii de pe actul prezentat nu coincide cu data nașterii introduse de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата рождения в предъявленном документе не совпадает с введённой вами датой рождения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum narodenia na predloženom doklade sa nezhoduje s dátumom narodenia, ktorý si zadal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Födelsedatumet på identiteten du visade stämmer inte med födelsedatumet du angav."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காட்டிய அடையாளத்தில் உள்ள பிறந்த தேதி, நீங்கள் உள்ளிட்ட பிறந்த தேதியுடன் பொருந்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమర్పించిన గుర్తింపులోని పుట్టిన తేదీ, మీరు నమోదు చేసిన పుట్టిన తేదీతో సరిపోలడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเกิดบนเอกสารยืนยันตัวตนที่คุณแสดงไม่ตรงกับวันเกิดที่คุณกรอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunduğunuz kimlikteki doğum tarihi, girdiğiniz doğum tarihiyle eşleşmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата народження в наданому документі не збігається з датою народження, яку ви ввели."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پیش کردہ شناخت پر تاریخ پیدائش آپ کی درج کردہ تاریخ پیدائش سے نہیں ملتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày sinh trên giấy tờ bạn xuất trình không khớp với ngày sinh bạn đã nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身份证件上的出生日期与你填写的出生日期不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身分證件上的出生日期，與你輸入的出生日期不符。"
          }
        }
      }
    },
