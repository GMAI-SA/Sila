    "rooms.live.audience.empty": {
      "comment": "Shown when nobody is listening.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يستمع بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কেউ শুনছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha ningú escoltant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nikdo neposlouchá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lytter endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch hört niemand zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν ακούει ακόμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is listening yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no escucha nadie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei vielä kuuntele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’écoute encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד עדיין לא מאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई सुन नहीं रहा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nitko ne sluša."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még senki nem hallgat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno in ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰も聴いていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 듣는 사람이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരും ഇതുവരെ കേൾക്കുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lytter ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er luistert nog niemand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt jeszcze nie słucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está ouvindo ainda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda ninguém está a ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ascultă nimeni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока никто не слушает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nikto nepočúva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lyssnar än."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் யாரும் கேட்கவில்லை."
