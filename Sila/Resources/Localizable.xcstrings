    "error.scopeNotAllowed": {
      "comment": "The room's audience excludes this account from speaking. Listening is never refused.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاستماع إلى هذه الغرفة، لكن جمهورها يعني أنك لا تستطيع التحدث فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই রুমে শুনতে পারবেন, কিন্তু এর শ্রোতাসীমার কারণে এখানে কথা বলতে পারবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots escoltar aquesta sala, però per la seva audiència no hi pots parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto místnost můžeš poslouchat, ale vzhledem k jejímu publiku v ní nemůžeš mluvit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lytte til dette rum, men dets målgruppe betyder, at du ikke kan tale i det."
