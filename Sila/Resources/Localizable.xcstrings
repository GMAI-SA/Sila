      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُخرج %@ من هذه الغرفة. وما زال بإمكانه الانضمام إلى غرف أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
