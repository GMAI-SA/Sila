    "post.reply.blocked.unverified": {
      "comment": "Why an unverified viewer cannot reply. Reading is open to everyone; speaking is not.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق هويتك لتتمكن من الرد. القراءة متاحة للجميع في «معروف»، والنشر للموثّقين فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর দিতে আপনার পরিচয় যাচাই করুন। Known সবাই পড়তে পারে; শুধু ভেরিফায়েড মানুষ পোস্ট করতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la teva identitat per respondre. Tothom pot llegir Known; només les persones verificades poden publicar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro odpovídání ověř svou totožnost. Known je čitelná pro všechny; psát mohou jen ověření lidé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificér din identitet for at svare. Alle kan læse Known; kun verificerede mennesker kan slå op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiziere deine Identität, um zu antworten. Alle können Known lesen; nur verifizierte Menschen können posten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαλήθευσε την ταυτότητά σου για να απαντήσεις. Όλοι μπορούν να διαβάζουν το Known· μόνο επαληθευμένοι άνθρωποι μπορούν να δημοσιεύουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to reply. Everyone can read Known; only verified humans can post."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu identidad para responder. Todo el mundo puede leer Known; solo las personas verificadas pueden publicar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista henkilöllisyytesi vastataksesi. Kaikki voivat lukea Knownia; vain vahvistetut ihmiset voivat julkaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité pour répondre. Tout le monde peut lire Known ; seuls les humains vérifiés peuvent publier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמת את זהותך כדי להגיב. כולם יכולים לקרוא את Known; רק בני אדם מאומתים יכולים לפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब देने के लिए अपनी पहचान सत्यापित करें। Known सब पढ़ सकते हैं; पोस्ट सिर्फ़ सत्यापित इंसान कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi svoj identitet da odgovaraš. Svatko može čitati objave u aplikaciji Known; objavljivati mogu samo potvrđeni ljudi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszoláshoz hitelesítsd a személyazonosságodat. A Knownt mindenki olvashatja; írni csak hitelesített emberek írhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi identitasmu untuk membalas. Semua orang bisa membaca Known; hanya manusia terverifikasi yang bisa memposting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la tua identità per rispondere. Tutti possono leggere Known; solo le persone verificate possono pubblicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信するには本人確認をしてください。Knownは誰でも読めますが、投稿できるのは認証済みの人だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글을 달려면 신원을 인증하세요. 누구나 Known을 읽을 수 있지만 인증된 사람만 게시할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറുപടി നൽകാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി പരിശോധിക്കുക. Known എല്ലാവർക്കും വായിക്കാം; പരിശോധിച്ച മനുഷ്യർക്ക് മാത്രമേ പോസ്റ്റ് ചെയ്യാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan identiti anda untuk membalas. Sesiapa boleh membaca Known; hanya manusia yang disahkan boleh menyiar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiser identiteten din for å svare. Alle kan lese Known, men bare verifiserte mennesker kan publisere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer je identiteit om te reageren. Iedereen kan Known lezen; alleen geverifieerde mensen kunnen posten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikuj tożsamość, aby odpowiadać. Każdy może czytać Known; publikować mogą tylko zweryfikowani ludzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade para responder. Todos podem ler o Known; só pessoas verificadas podem postar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a sua identidade para responder. Todos podem ler a Known; só pessoas verificadas podem publicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică-ți identitatea ca să răspunzi. Oricine poate citi Known; doar oamenii verificați pot posta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите личность, чтобы отвечать. Читать Known может каждый; публиковать — только проверенные люди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Over svoju identitu, aby si mohol odpovedať. Known môže čítať každý; písať môžu len overení ľudia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiera din identitet för att svara. Alla kan läsa Known; bara verifierade människor kan publicera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிலளிக்க உங்கள் அடையாளத்தைச் சரிபாருங்கள். Known-ஐ எல்லோரும் படிக்கலாம்; சரிபார்க்கப்பட்ட மனிதர்கள் மட்டுமே இடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిప్లై ఇవ్వడానికి మీ గుర్తింపును ధృవీకరించండి. Knownను ఎవరైనా చదవవచ్చు; ధృవీకరించబడిన మనుషులు మాత్రమే పోస్ట్ చేయగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันตัวตนของคุณเพื่อตอบกลับ ทุกคนอ่าน Known ได้ แต่เฉพาะคนจริงที่ยืนยันตัวตนแล้วเท่านั้นที่โพสต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlamak için kimliğinizi doğrulayın. Known'u herkes okuyabilir; yalnızca doğrulanmış insanlar gönderi paylaşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верифікуйте особу, щоб відповідати. Читати Known може кожен; публікувати — лише верифіковані люди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جواب دینے کے لیے اپنی شناخت کی تصدیق کریں۔ Known ہر کوئی پڑھ سکتا ہے؛ صرف تصدیق شدہ انسان پوسٹ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh danh tính để trả lời. Ai cũng đọc được Known; chỉ người thật đã xác minh mới đăng bài được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证你的身份后才能回复。每个人都能阅读 Known，但只有已验证的真人才能发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證你的身分才能回覆。任何人都能閱讀 Known，只有已驗證的真人能發文。"
          }
        }
      }
    },
