    "feed.fab.room.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لفتح غرفة، أو اضغط مطولًا للمزيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম খুলতে ট্যাপ করুন। আরও দেখতে চেপে ধরুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per obrir una sala. Mantén premut per veure'n més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím otevřeš místnost. Podržením zobrazíš další možnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at åbne et rum. Hold nede for mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um einen Raum zu öffnen. Halten für mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε για να ανοίξεις αίθουσα. Κράτησε πατημένο για περισσότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open a room. Hold for more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para abrir una sala. Mantén pulsado para ver más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta avataksesi huoneen. Pidä painettuna nähdäksesi lisää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour ouvrir un salon. Maintenez pour plus d’options."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי לפתוח חדר. החזק לעוד אפשרויות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम खोलने के लिए टैप करें। और विकल्पों के लिए दबाए रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za otvaranje sobe. Drži za više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy szoba megnyitásához. Tartsd lenyomva a továbbiakhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk membuka room. Tahan untuk opsi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per aprire una stanza. Tieni premuto per altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてルームを開きます。長押しでその他の操作。"
