        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimlerden biri eklenemedi. Kaldırıp yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне із зображень не вдалося прикріпити. Видаліть його й додайте знову."
