    "vouch.own.body": {
      "comment": "%1$@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن اسمك يحمل كلمة ⁦@%1$@⁩. وثّق هويتك ليحمل اسمك كلمتك أنت — مع علم دولتك — ولا يعود ⁦@%1$@⁩ مسؤولًا عنك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন আপনার নাম @%1$@-এর কথায় চলছে। পরিচয় ভেরিফাই করলে সেটি আপনার নিজের কথায় চলবে — আপনার দেশের পতাকাসহ — আর @%1$@ আপনার জন্য আর দায়ী থাকবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix el teu nom es sosté amb la paraula de @%1$@. Verifica la teva identitat i es sostindrà amb la teva, amb la bandera del teu país, i @%1$@ ja no en serà responsable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď tvé jméno nese slovo uživatele @%1$@. Ověř svou totožnost a ponese tvé vlastní – s vlajkou tvé země – a @%1$@ už za tebe neodpovídá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige nu bærer dit navn @%1$@s ord. Verificér din identitet, så bærer det dit eget – med dit lands flag – og @%1$@ hæfter ikke længere for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment trägt dein Name das Wort von @%1$@. Verifiziere deine Identität, und er trägt dein eigenes – mit der Flagge deines Landes – und @%1$@ ist nicht mehr für dich verantwortlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή τη στιγμή το όνομά σου φέρει τον λόγο του/της @%1$@. Επαλήθευσε την ταυτότητά σου και φέρει τον δικό σου — με τη σημαία της χώρας σου — και ο/η @%1$@ δεν είναι πια υπεύθυνος/η για εσένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now your name carries @%1$@'s word. Verify your identity and it carries your own — with your country's flag — and @%1$@ is no longer answerable for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo tu nombre cuenta con la palabra de @%1$@. Verifica tu identidad y contará con la tuya, con la bandera de tu país, y @%1$@ deja de responder por ti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Juuri nyt nimesi takana on käyttäjän @%1$@ sana. Vahvista henkilöllisyytesi, niin takana on oma sanasi – maasi lipun kanssa – eikä @%1$@ ole enää vastuussa sinusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’instant, votre nom repose sur la parole de @%1$@. Vérifiez votre identité et il reposera sur la vôtre — avec le drapeau de votre pays — et @%1$@ ne sera plus responsable de vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע השם שלך נושא את המילה של @%1$@. אמת את זהותך והוא יישא את המילה שלך — עם דגל המדינה שלך — ו-@%1$@ כבר לא אחראי לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपका नाम @%1$@ के वचन पर टिका है। अपनी पहचान सत्यापित करें और वह आपके अपने वचन पर टिकेगा — आपके देश के झंडे के साथ — और @%1$@ आपके लिए जवाबदेह नहीं रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno tvoje ime nosi riječ korisnika @%1$@. Potvrdi svoj identitet i nosit će tvoju vlastitu — sa zastavom tvoje zemlje — a @%1$@ više ne odgovara za tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg a neved @%1$@ szavát hordozza. Hitelesítsd a személyazonosságodat, és a saját szavadat hordozza – az országod zászlajával –, @%1$@ pedig már nem felel érted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini namamu dibawa oleh kata-kata @%1$@. Verifikasi identitasmu dan nama itu dibawa oleh kata-katamu sendiri — dengan bendera negaramu — dan @%1$@ tidak lagi bertanggung jawab atasmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora il tuo nome si regge sulla parola di @%1$@. Verifica la tua identità e si regge sulla tua, con la bandiera del tuo paese, e @%1$@ non risponde più per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、あなたの名前は@%1$@の言葉で裏付けられています。本人確認をすると、あなた自身の言葉(と国旗)で裏付けられ、@%1$@はあなたについて責任を負わなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 내 이름이 @%1$@님의 보증으로 뒷받침돼요. 신원을 인증하면 내 자신의 말로 뒷받침되고 내 국가의 깃발도 표시되며, @%1$@님은 더 이상 나에 대한 책임이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ പേര് @%1$@ ന്റെ വാക്ക് വഹിക്കുന്നു. ഐഡന്റിറ്റി വെരിഫൈ ചെയ്താൽ അത് നിങ്ങളുടെ സ്വന്തം വാക്ക് വഹിക്കും — നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാകയോടെ — @%1$@ ഇനി നിങ്ങൾക്ക് ഉത്തരവാദിയായിരിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang nama anda bergantung pada kata-kata @%1$@. Sahkan identiti anda dan ia bergantung pada kata-kata anda sendiri — dengan bendera negara anda — dan @%1$@ tidak lagi bertanggungjawab ke atas anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkurat nå står navnet ditt på ordet til @%1$@. Verifiser identiteten din, så står det på ditt eget, med landsflagget ditt, og @%1$@ er ikke lenger ansvarlig for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit moment draagt je naam het woord van @%1$@. Verifieer je identiteit en hij draagt je eigen woord, met de vlag van je land, en @%1$@ staat niet meer voor je in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz Twoje imię opiera się na słowie @%1$@. Zweryfikuj tożsamość, a będzie się opierać na Twoim własnym — z flagą Twojego kraju — i @%1$@ nie będzie już za Ciebie odpowiadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento seu nome vale pela palavra de @%1$@. Verifique sua identidade e ele passa a valer pela sua própria, com a bandeira do seu país, e @%1$@ deixa de responder por você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento o seu nome vale pela palavra de @%1$@. Verifique a sua identidade e passa a valer pela sua — com a bandeira do seu país — e @%1$@ deixa de responder por si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum numele tău poartă cuvântul lui @%1$@. Verifică-ți identitatea și va purta propriul tău cuvânt — cu steagul țării tale — iar @%1$@ nu mai răspunde pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас ваше имя подкреплено словом @%1$@. Пройдите проверку личности, и оно будет подкреплено вашим собственным словом — с флагом вашей страны, — а @%1$@ больше не будет отвечать за вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve teraz tvoje meno nesie slovo @%1$@. Over svoju totožnosť a bude niesť tvoje vlastné — s vlajkou tvojej krajiny — a @%1$@ už za teba nebude zodpovedať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu bär ditt namn @%1$@s ord. Verifiera din identitet så bär det ditt eget – med ditt lands flagga – och @%1$@ svarar inte längre för dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்கள் பெயர் @%1$@ இன் வாக்கைத் தாங்குகிறது. அடையாளத்தைச் சரிபார்த்தால் அது உங்கள் சொந்த வாக்கைத் தாங்கும் — உங்கள் நாட்டின் கொடியுடன் — மேலும் உங்களுக்காக @%1$@ பொறுப்பாளியாக இருக்க மாட்டார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం మీ పేరు @%1$@ మాటను మోస్తోంది. మీ గుర్తింపును ధృవీకరిస్తే అది మీ స్వంత మాటను — మీ దేశం జెండాతో — మోస్తుంది, @%1$@ ఇక మీకు బాధ్యులు కారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ชื่อของคุณมีคำรับรองของ @%1$@ ยืนยันตัวตนแล้วชื่อจะมีคำรับรองของคุณเอง พร้อมธงประเทศของคุณ และ @%1$@ จะไม่ต้องรับผิดชอบแทนคุณอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda adınız @%1$@ kişisinin sözünü taşıyor. Kimliğinizi doğrularsanız kendi sözünüzü taşır, ülkenizin bayrağıyla birlikte; @%1$@ da artık sizden sorumlu olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз ваше ім’я тримається на слові @%1$@. Верифікуйте особу, і воно триматиметься на вашому власному — з прапором вашої країни — а @%1$@ більше не відповідатиме за вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی آپ کے نام کے پیچھے @%1$@ کی بات ہے۔ اپنی شناخت کی تصدیق کریں تو اس کے پیچھے آپ کی اپنی بات ہوگی — آپ کے ملک کے جھنڈے کے ساتھ — اور @%1$@ آپ کے ذمہ دار نہیں رہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại tên của bạn mang lời của @%1$@. Hãy xác minh danh tính và nó sẽ mang lời của chính bạn — kèm cờ quốc gia của bạn — và @%1$@ không còn chịu trách nhiệm về bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前你的名字由 @%1$@ 担保。验证身份后，它将由你自己担保，并带上你所在国家的旗帜，@%1$@ 也不再需要为你负责。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前你的名字以 @%1$@ 的信用為憑。驗證你的身分後，就會以你自己的信用為憑，並附上你國家的旗幟，而 @%1$@ 也不再需要為你負責。"
          }
        }
      }
    },
