    "rooms.notLiveYet.scheduled": {
      "comment": "Refusal for a room that has not started. %@ is when it is due.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ هذه الغرفة بعد. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুম শুরু হয়নি। %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta sala encara no ha començat. %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato místnost ještě nezačala. %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rum er ikke startet. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Raum hat noch nicht begonnen. %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η αίθουσα δεν έχει ξεκινήσει. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This room hasn't started. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sala no ha empezado. %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä huone ei ole alkanut. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce salon n’a pas commencé. %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החדר הזה לא התחיל. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रूम शुरू नहीं हुआ है। %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova soba nije počela. %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szoba még nem kezdődött el. %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room ini belum dimulai. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa stanza non è ancora iniziata. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルームはまだ始まっていません。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 룸은 아직 시작되지 않았어요. %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റൂം ആരംഭിച്ചിട്ടില്ല. %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik ini belum bermula. %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rommet har ikke startet. %@"
          }
        },
        "nl": {
