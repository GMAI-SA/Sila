        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ റൂം കേൾക്കുകയാണ്, അതിനാൽ ഓണാക്കാൻ മൈക്രോഫോൺ ഇല്ല."
