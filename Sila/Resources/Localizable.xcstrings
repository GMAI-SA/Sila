        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use international format, starting with a plus and a country code — for example %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el formato internacional, con un signo más y el prefijo del país; por ejemplo, %@."
