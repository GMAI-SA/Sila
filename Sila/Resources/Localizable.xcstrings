        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This room hasn't started. %@"
          }
        }
      }
    },
    "rooms.removed.body": {
      "comment": "What a removal means. Deliberately never the word 'block' — it applies to this room only, changes nothing about the account, and does not travel to the next room.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخرجك المضيف من هذه الغرفة. وهذا يخص هذه الغرفة وحدها — ليس حظرًا، ولم يتغير أي شيء في حسابك، وما زال بإمكانك فتح أي غرفة أخرى أو الانضمام إليها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host removed you from this room. That applies to this room only — it isn't a block, nothing about your account has changed, and you can still open or join any other room."
          }
        }
      }
    },
    "rooms.removed.title": {
      "comment": "Heading when a host removed the viewer.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخرجك المضيف من هذه الغرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were removed from this room"
          }
        }
      }
    },
    "rooms.removed.toast": {
