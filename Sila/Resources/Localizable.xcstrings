    "people.picker.search.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصفّي من تعرفهم ويبحث عن الآخرين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চেনা মানুষদের ফিল্টার করে এবং বাকি সবার মধ্যে খোঁজে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra les persones que coneixes i cerca entre tota la resta"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruje lidi, které znáš, a hledá mezi všemi ostatními"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrerer de folk, du kender, og søger blandt alle andre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtert die Personen, die du kennst, und durchsucht alle anderen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φιλτράρει τα άτομα που γνωρίζεις και αναζητά όλους τους άλλους"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters the people you know and searches everyone else"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra las personas que conoces y busca entre todos los demás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suodattaa tuntemasi ihmiset ja hakee kaikkien muiden joukosta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre les personnes que vous connaissez et cherche parmi toutes les autres"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנן את האנשים שאתה מכיר ומחפש בין כל השאר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जानने वालों को फ़िल्टर करता है और बाकी सबको खोजता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrira ljude koje znaš i pretražuje sve ostale"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szűri az ismerőseidet, és mindenki másban keres"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyaring orang yang kamu kenal dan mencari semua orang lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra le persone che conosci e cerca tra tutte le altre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っている人を絞り込み、それ以外の全員を検索します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 사람을 걸러내고 나머지 모든 사람을 검색해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കറിയാവുന്നവരെ ഫിൽട്ടർ ചെയ്യുകയും മറ്റെല്ലാവരെയും തിരയുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menapis orang yang anda kenal dan mencari orang lain"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrerer folk du kjenner og søker blant alle andre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtert de mensen die je kent en zoekt onder alle anderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruje znane Ci osoby i przeszukuje wszystkich pozostałych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra as pessoas que você conhece e busca entre todas as outras"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra as pessoas que conhece e pesquisa todas as outras"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrează oamenii pe care îi cunoști și caută printre toți ceilalți"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтрует знакомых и ищет среди остальных"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruje ľudí, ktorých poznáš, a hľadá medzi všetkými ostatnými"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrerar personerna du känner och söker bland alla andra"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தெரிந்தவர்களை வடிகட்டி மற்ற அனைவரிலும் தேடும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు తెలిసిన వ్యక్తులను ఫిల్టర్ చేసి, మిగతా అందరిలో వెతుకుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรองคนที่คุณรู้จักและค้นหาคนอื่นทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıdığınız kişileri filtreler ve diğer herkesi arar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтрує знайомих і шукає серед усіх інших"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جاننے والوں کو فلٹر کرتا ہے اور باقی سب میں تلاش کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọc những người bạn biết và tìm tất cả những người khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选你认识的人，并搜索其他所有人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "篩選你認識的人，並搜尋其他所有人"
          }
        }
      }
    },
