        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из изображений не удалось прикрепить. Удалите его и добавьте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden z obrázkov sa nepodarilo pripojiť. Odstráň ho a pridaj znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En av bilderna kunde inte bifogas. Ta bort den och lägg till den igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படங்களில் ஒன்றை இணைக்க முடியவில்லை. அதை அகற்றி மீண்டும் சேருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక చిత్రాన్ని జత చేయలేకపోయాం. దాన్ని తొలగించి మళ్లీ జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบรูปหนึ่งรูปไม่ได้ ลบแล้วเพิ่มใหม่"
