    "auth.resetPassword.done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعيين كلمة المرور. سجّل الدخول بها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসওয়ার্ড সেট হয়েছে। এটি দিয়ে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La contrasenya està establerta. Inicia la sessió amb ella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo je nastaveno. Přihlas se s ním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din adgangskode er indstillet. Log ind med den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort ist festgelegt. Melde dich damit an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σου ορίστηκε. Συνδέσου με αυτόν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is set. Sign in with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña está establecida. Inicia sesión con ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanasi on asetettu. Kirjaudu sillä sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe est défini. Connectez-vous avec."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה שלך נקבעה. התחבר איתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड सेट हो गया। उसी से साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lozinka je postavljena. Prijavi se s njom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszavad beállítva. Jelentkezz be vele."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandimu sudah diatur. Masuk dengan kata sandi itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua password è impostata. Accedi con quella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを設定しました。新しいパスワードでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 설정되었어요. 새 비밀번호로 로그인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാസ്‌വേഡ് സജ്ജമാക്കി. അതുപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan anda telah ditetapkan. Log masuk dengannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet ditt er satt. Logg inn med det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord is ingesteld. Log ermee in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło zostało ustawione. Zaloguj się nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha foi definida. Entre com ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua palavra-passe está definida. Inicie sessão com ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola ta este setată. Autentifică-te cu ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль установлен. Войдите с ним."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje heslo je nastavené. Prihlás sa ním."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt lösenord är angett. Logga in med det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல் அமைக்கப்பட்டது. அதைக் கொண்டு உள்நுழையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాస్‌వర్డ్ సెట్ అయింది. దానితో సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งรหัสผ่านของคุณแล้ว ลงชื่อเข้าใช้ด้วยรหัสผ่านนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz belirlendi. Onunla giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль встановлено. Увійдіть з ним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پاس ورڈ سیٹ ہو گیا۔ اسی سے سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu của bạn đã được đặt. Hãy đăng nhập bằng mật khẩu đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码已设置。请用它登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密碼已設定，請用它登入。"
          }
        }
      }
    },
