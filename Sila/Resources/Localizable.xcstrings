            "value": "@%@が期限内に確認しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님이 제때 확인하지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ സമയത്തിനുള്ളിൽ സ്ഥിരീകരിച്ചില്ല."
          }
        },
        "ms": {
