    "video.error.prepareInterrupted": {
      "comment": "Compressing a picked video on the phone was stopped by the phone itself (media services restarted) more than twice in a row, with the app on screen. Retry is offered beside it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال تجهيز هذا الفيديو. حاول مرة أخرى."
