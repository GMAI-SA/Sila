        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ ప్రారంభించిన రూమ్ ఈ కమ్యూనిటీకి మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
