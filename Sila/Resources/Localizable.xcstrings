        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อไปหันศีรษะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi başınızı çevirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер поверніть голову"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب اپنا سر گھمائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ hãy xoay đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
