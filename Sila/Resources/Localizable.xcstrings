        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഐഡന്റിറ്റി പരിശോധിച്ചു — ഇനി നിങ്ങളുടെ പേര് നിങ്ങളുടെ സ്വന്തം വാക്കിൽ നിൽക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mengesahkan identiti anda — nama anda kini bergantung pada kata-kata anda sendiri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifiserte identiteten din. Navnet ditt står nå på ditt eget ord"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je identiteit geverifieerd: je naam draagt nu je eigen woord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowałeś tożsamość — Twoje imię opiera się teraz na Twoim własnym słowie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você verificou sua identidade: agora seu nome vale pela sua própria palavra"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificou a sua identidade — o seu nome passa a valer pela sua própria palavra"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ți-ai verificat identitatea — numele tău poartă acum propria ta vorbă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прошли проверку личности — теперь ваше имя подкреплено вашим собственным словом"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overil si svoju identitu — tvoje meno teraz stojí na tvojom vlastnom slove"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifierade din identitet – ditt namn bär nu ditt eget ord"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் அடையாளத்தைச் சரிபார்த்தீர்கள் — இப்போது உங்கள் பெயர் உங்கள் சொந்த வாக்கைக் கொண்டுள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ గుర్తింపును ధృవీకరించుకున్నారు — ఇప్పుడు మీ పేరు మీ స్వంత మాటను కలిగి ఉంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันตัวตนแล้ว ตอนนี้ชื่อของคุณมีคำรับรองของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi doğruladınız; adınız artık kendi sözünüzü taşıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви верифікували особу — тепер ваше ім’я тримається на вашому власному слові"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اپنی شناخت کی تصدیق کر لی — اب آپ کے نام کے پیچھے آپ کی اپنی بات ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xác minh danh tính — tên của bạn giờ tự mang lời của chính bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
