    "rooms.copy.neverRecorded": {
      "comment": "The promise every room screen carries, placed where somebody reads it before they speak.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف لا تُسجَّل أبدًا. لا إعادة ولا نص مكتوب ولا ملف — وعندما تنتهي هذه الغرفة يذهب ما قيل فيها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms are never recorded. There is no replay, no transcript and no file — when this room ends, what was said in it is gone."
          }
        }
      }
    },
    "rooms.copy.neverRecordedShort": {
      "comment": "The short form of the never-recorded promise, for a chip.",
      "extractionState": "manual",
      "localizations": {
