    "rooms.host.mutedToast": {
      "comment": "Toast.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم كتم %@. يحتفظون بمقعدهم على المنصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ মিউট হয়েছেন। মঞ্চে তার আসন থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ està silenciat. Conserva el seu lloc a l'escenari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ je ztlumen. Zůstává na pódiu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er gjort lydløs. Vedkommende beholder sin plads på scenen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist stummgeschaltet. Der Platz auf der Bühne bleibt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ είναι σε σίγαση. Κρατά τη θέση του/της στη σκηνή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is muted. They keep their seat on the stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está silenciado. Conserva su sitio en el escenario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on mykistetty. Hän säilyttää paikkansa lavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro de %@ est coupé. Il garde sa place sur la scène."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מושתק. הוא שומר על מקומו על הבמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ म्यूट हैं। स्टेज पर उनकी सीट बनी रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je utišan/a. Zadržava mjesto na pozornici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ némítva. A helye megmarad a színpadon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dibisukan. Mereka tetap di panggung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è silenziato. Mantiene il suo posto sul palco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をミュートしました。ステージの席はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 뮤트했어요. 무대 자리는 유지돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മ്യൂട്ട് ചെയ്തു. അവർ സ്റ്റേജിലെ സീറ്റ് നിലനിർത്തുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disenyapkan. Mereka kekal di tempat mereka di pentas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er dempet. Vedkommende beholder plassen sin på scenen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gedempt. Diegene behoudt de plek op het podium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest wyciszony(-a). Zachowuje miejsce na scenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está silenciado. Continua com o lugar no palco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi silenciado. Mantém o seu lugar no palco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are microfonul dezactivat. Își păstrează locul pe scenă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заглушён(а). Место на сцене сохраняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je stlmený(á). Zostáva na pódiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är tystad. De behåller sin plats på scenen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஒலியடக்கப்பட்டார். மேடையில் அவர் இருக்கை அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మ్యూట్ చేయబడ్డారు. వేదికపై వారి సీటు అలాగే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเสียง %@ แล้ว พวกเขายังอยู่ที่นั่งบนเวที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin sesi kapatıldı. Sahnedeki yerini korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон %@ вимкнено. Місце на сцені зберігається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ میوٹ ہیں۔ اسٹیج پر ان کی نشست برقرار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bị tắt tiếng. Họ vẫn giữ chỗ trên sân khấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已静音，仍保留在发言台上的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已靜音，仍保留在舞台上的位置。"
          }
        }
      }
    },
