        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അന്താരാഷ്ട്ര ഫോർമാറ്റ് ഉപയോഗിക്കുക: പ്ലസ് ചിഹ്നവും രാജ്യ കോഡും ഉപയോഗിച്ച് തുടങ്ങണം — ഉദാഹരണത്തിന് %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan format antarabangsa, bermula dengan tanda tambah dan kod negara — contohnya %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
