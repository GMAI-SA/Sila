          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই হারায়নি — আপনার ছবিগুলো এখনও এখানে আছে। সংযোগ পেলে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha perdut res: les teves fotos continuen aquí. Torna-ho a provar quan tinguis connexió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se neztratilo – fotografie tu stále jsou. Zkus to znovu, až budeš připojen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet gik tabt – dine fotos er her stadig. Prøv igen, når du har forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ging verloren – deine Fotos sind noch da. Versuche es erneut, wenn du verbunden bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χάθηκε τίποτα — οι φωτογραφίες σου είναι ακόμα εδώ. Δοκίμασε ξανά όταν έχεις σύνδεση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was lost — your photos are still here. Try again when you're connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se perdió nada: tus fotos siguen aquí. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei menetetty – kuvasi ovat yhä tässä. Yritä uudelleen, kun yhteys on käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été perdu — vos photos sont toujours là. Réessayez une fois connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא אבד — התמונות שלך עדיין כאן. נסה שוב כשתהיה מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नहीं खोया — आपकी फ़ोटो अभी यहीं हैं। कनेक्ट होने पर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije izgubljeno — tvoje fotografije su još ovdje. Pokušaj ponovno kad se povežeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem veszett el – a fotóid még itt vannak. Próbáld újra, ha van kapcsolat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang hilang — fotomu masih di sini. Coba lagi saat kamu terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è andato perso nulla: le tue foto sono ancora qui. Riprova quando sei connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も失われていません。写真はここに残っています。接続できるようになったら、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 사라지지 않았어요. 사진은 그대로 있어요. 연결되면 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും നഷ്ടമായില്ല — നിങ്ങളുടെ ഫോട്ടോകൾ ഇവിടെത്തന്നെയുണ്ട്. കണക്ഷൻ ലഭിക്കുമ്പോൾ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa yang hilang — foto anda masih di sini. Cuba lagi apabila anda bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting gikk tapt. Bildene dine er fortsatt her. Prøv igjen når du er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verloren gegaan: je foto's staan hier nog. Probeer het opnieuw zodra je verbinding hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie przepadło — Twoje zdjęcia nadal tu są. Spróbuj ponownie, gdy będziesz online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi perdido: suas fotos ainda estão aqui. Tente de novo quando estiver conectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se perdeu — as suas fotos continuam aqui. Tente novamente quando tiver ligação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a pierdut nimic — fotografiile sunt încă aici. Încearcă din nou când ești conectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не потеряно — ваши фото на месте. Повторите, когда появится связь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa nestratilo — tvoje fotky tu stále sú. Skús to znova, keď budeš pripojený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget gick förlorat – dina foton finns kvar här. Försök igen när du är uppkopplad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் இழக்கப்படவில்லை — உங்கள் புகைப்படங்கள் இன்னும் இங்கே உள்ளன. இணைப்பு கிடைத்ததும் மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ కోల్పోలేదు — మీ ఫోటోలు ఇంకా ఇక్కడే ఉన్నాయి. కనెక్ట్ అయ్యాక మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรสูญหาย รูปของคุณยังอยู่ที่นี่ ลองอีกครั้งเมื่อเชื่อมต่อแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey kaybolmadı; fotoğraflarınız hâlâ burada. Bağlandığınızda tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не втрачено — ваші фото все ще тут. Спробуйте ще раз, коли з’явиться зв’язок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ ضائع نہیں ہوا — آپ کی تصاویر ابھی یہیں ہیں۔ انٹرنیٹ سے جڑنے پر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mất gì — ảnh của bạn vẫn ở đây. Hãy thử lại khi có kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有丢失任何内容，你的照片仍在这里。联网后请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何損失，你的照片仍在這裡。連上網路後再試一次。"
          }
        }
      }
    },
