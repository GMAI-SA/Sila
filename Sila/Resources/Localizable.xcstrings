    "guest.room.refusal.notFound.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما انتهت، أو لم يعد مضيفها على «معروف»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শেষ হয়ে যেতে পারে, অথবা এর হোস্ট আর Known-এ নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Potser ha acabat, o el seu amfitrió ja no és a Known."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možná skončila, nebo už její hostitel v aplikaci Known není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er måske slut, eller dets vært er ikke længere på Known."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist möglicherweise beendet, oder sein Host ist nicht mehr auf Known."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ίσως έχει τελειώσει ή ο οικοδεσπότης της δεν είναι πια στο Known."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have ended, or its host is no longer on Known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que haya terminado o que su anfitrión ya no esté en Known."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on ehkä päättynyt, tai sen isäntä ei ole enää Knownissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être terminé, ou son animateur n’est plus sur Known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהוא הסתיים, או שהמארח שלו כבר לא ב-Known."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद यह खत्म हो गया है, या इसका होस्ट अब Known पर नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možda je završila ili njezin domaćin više nije u aplikaciji Known."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy véget ért, vagy a házigazdája már nincs a Knownon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin sudah berakhir, atau hostnya sudah tidak di Known."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere finita, o il suo host non è più su Known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了したか、ホストがKnownにいなくなった可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 끝났거나 호스트가 더 이상 Known에 없을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് അവസാനിച്ചിരിക്കാം, അല്ലെങ്കിൽ ഇതിന്റെ ഹോസ്റ്റ് ഇപ്പോൾ Known-ൽ ഇല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia mungkin telah tamat, atau hosnya sudah tiada di Known."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ha tatt slutt, eller verten er ikke lenger på Known."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij is mogelijk afgelopen, of de host is niet meer op Known."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mógł się zakończyć albo jego gospodarza nie ma już w Known."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela pode ter terminado, ou o anfitrião não está mais no Known."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ter terminado, ou o anfitrião já não está na Known."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate s-a încheiat sau gazda ei nu mai este pe Known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, она завершилась или её ведущего больше нет в Known."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Možno skončila, alebo jej hostiteľ už nie je na Known."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ha avslutats, eller så finns dess värd inte längre på Known."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது முடிந்திருக்கலாம், அல்லது அதன் நடத்துநர் இனி Known-இல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ముగిసి ఉండవచ్చు, లేదా దాని హోస్ట్ ఇకపై Knownలో లేకపోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องอาจจบแล้ว หรือเจ้าของห้องไม่ได้อยู่บน Known แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sona ermiş olabilir veya sunucusu artık Known'da değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, її завершено або її ведучого вже немає в Known."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو سکتا ہے یہ ختم ہو چکا ہو، یا اس کا میزبان اب Known پر نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng có thể đã kết thúc, hoặc chủ phòng không còn trên Known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已经结束，或其主持人已不在 Known 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已結束，或其主持人已不在 Known。"
          }
        }
      }
    },
