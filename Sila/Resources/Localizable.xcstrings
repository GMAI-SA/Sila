    "account.password.error.mismatch": {
      "comment": "Validation when the two new passwords differ.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمتان غير متطابقتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি মিলছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dues no coincideixen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato dvě hesla se neshodují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to stemmer ikke overens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden stimmen nicht überein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δύο δεν ταιριάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
