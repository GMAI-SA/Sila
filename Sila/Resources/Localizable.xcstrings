        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu feed Internacional muestra solo publicaciones sobre %lld tema que elegiste; las que aún no se han etiquetado están ocultas."
                }
              },
              "other": {
                "stringUnit": {
