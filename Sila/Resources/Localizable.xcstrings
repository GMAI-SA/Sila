          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває форму контактного номера, для якої потрібен пароль"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رابطہ نمبر کا فارم کھولتا ہے، جس کے لیے آپ کا پاس ورڈ چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở biểu mẫu số liên hệ, cần mật khẩu của bạn"
          }
        },
        "zh-Hans": {
