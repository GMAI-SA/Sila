    "auth.forgotPassword.error.sendFailed": {
      "comment": "Toast when the reset code could not be sent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال رمز إعادة التعيين. أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিসেট কোড পাঠানো যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut enviar un codi de restabliment. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se odeslat kód pro obnovu. Zkus to prosím znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke sende en nulstillingskode. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten keinen Rücksetzcode senden. Bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να στείλουμε κωδικό επαναφοράς. Δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't send a reset code. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos enviar un código de restablecimiento. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautuskoodin lähettäminen epäonnistui. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu envoyer de code de réinitialisation. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לשלוח קוד איפוס. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम रीसेट कोड नहीं भेज सके। कृपया फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli poslati kod za poništavanje. Pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtunk visszaállítási kódot küldeni. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa mengirim kode reset. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare un codice di reimpostazione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットコードを送信できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설정 코드를 보내지 못했어요. 다시 시도해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റീസെറ്റ് കോഡ് അയയ്ക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menghantar kod tetapan semula. Known cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke sende en tilbakestillingskode. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden geen resetcode versturen. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać kodu resetującego. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar um código de redefinição. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar um código de reposição. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut trimite un cod de resetare. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить код сброса. Попробуйте ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa nám poslať kód na obnovenie. Skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte skicka en återställningskod. Försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்டமைப்புக் குறியீட்டை அனுப்ப முடியவில்லை. மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రీసెట్ కోడ్‌ను పంపలేకపోయాం. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราส่งรหัสรีเซ็ตไม่ได้ กรุณาลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırlama kodu gönderemedik. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося надіслати код скидання. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم ری سیٹ کوڈ نہیں بھیج سکے۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không gửi được mã đặt lại. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法发送重置验证码，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法寄出重設驗證碼，請再試一次。"
          }
        }
      }
