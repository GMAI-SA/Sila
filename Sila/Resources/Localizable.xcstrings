          "stringUnit": {
            "state": "translated",
            "value": "വേദി പരിശോധിക്കുക: ലിങ്ക് https ആയിരിക്കണം, സ്ഥലത്തിന് പേര് വേണം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak lokasi: pautan mesti https, tempat perlu nama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk stedet: en lenke må være https, et sted må ha et navn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de locatie: een link moet https zijn, een plek heeft een naam nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź miejsce: link musi zaczynać się od https, a miejsce potrzebuje nazwy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o local: um link precisa ser https, e um lugar precisa de nome"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o local: uma ligação tem de ser https, um lugar precisa de nome"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică locul: un link trebuie să fie https, un loc are nevoie de un nume"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте место: ссылка должна быть https, у места должно быть название"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontroluj miesto konania: odkaz musí byť https, miesto potrebuje názov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera platsen: en länk måste vara https, en plats behöver ett namn"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடத்தைச் சரிபாருங்கள்: இணைப்பு https ஆக இருக்க வேண்டும், இடத்துக்குப் பெயர் வேண்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేదికను తనిఖీ చేయండి: లింక్ https అయి ఉండాలి, స్థలానికి పేరు ఉండాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสถานที่: ลิงก์ต้องเป็น https สถานที่ต้องมีชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mekanı kontrol edin: bağlantı https olmalı, mekanın bir adı olmalı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте місце: посилання має бути https, а місце — мати назву"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام جانچیں: لنک https ہونا چاہیے، جگہ کا نام ہونا چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra địa điểm: liên kết phải là https, địa điểm cần có tên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查场地：链接必须是 https，地点需要名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查地點：連結必須是 https，地點需要名稱"
          }
        }
      }
