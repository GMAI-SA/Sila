    "guest.join.like.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعجابات هنا من أشخاص حقيقيين، لذلك لها معنى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানকার লাইক আসল মানুষের কাছ থেকে আসে, তাই এর অর্থ আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els m'agrada d'aquí vénen de persones reals, així que signifiquen alguna cosa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajky tu dávají skuteční lidé, takže něco znamenají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Likes her kommer fra rigtige mennesker, så de betyder noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Likes kommen hier von echten Menschen, daher bedeuten sie etwas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα «μου αρέσει» εδώ προέρχονται από πραγματικούς ανθρώπους, οπότε έχουν αξία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Likes here come from real people, so they mean something."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los me gusta de aquí vienen de personas reales, así que significan algo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tykkäykset täällä tulevat oikeilta ihmisiltä, joten ne merkitsevät jotain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mentions J’aime viennent ici de vraies personnes, elles ont donc du sens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לייקים כאן מגיעים מאנשים אמיתיים, ולכן יש להם משמעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ के लाइक असली लोगों से आते हैं, इसलिए उनका कुछ मतलब होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviđanja ovdje dolaze od stvarnih ljudi pa nešto znače."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az itteni kedvelések valódi emberektől jönnek, ezért számítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suka di sini datang dari orang sungguhan, jadi ada artinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mi piace qui vengono da persone reali, quindi contano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでのいいねは実在の人からのものなので、意味があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 좋아요는 실제 사람에게서 오기 때문에 의미가 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടത്തെ ലൈക്കുകൾ യഥാർഥ ആളുകളിൽ നിന്നാണ്, അതിനാൽ അവയ്ക്ക് അർഥമുണ്ട്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suka di sini datang daripada orang sebenar, jadi ia bermakna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Likerklikk her kommer fra ekte mennesker, så de betyr noe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Likes komen hier van echte mensen, dus ze betekenen iets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polubienia pochodzą tu od prawdziwych ludzi, więc coś znaczą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As curtidas aqui vêm de pessoas reais, então significam algo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gostos aqui vêm de pessoas reais, por isso significam algo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprecierile de aici vin de la oameni reali, deci contează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лайки здесь ставят реальные люди, поэтому они что-то значат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Páči sa mi tu pochádza od skutočných ľudí, takže to niečo znamená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gillningar här kommer från verkliga människor, så de betyder något."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்குள்ள விருப்பங்கள் உண்மையான மனிதர்களிடமிருந்து வருகின்றன, அதனால் அவை பொருள் கொண்டவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడి లైక్‌లు నిజమైన వ్యక్తుల నుండి వస్తాయి, కాబట్టి వాటికి విలువ ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดถูกใจที่นี่มาจากคนจริง จึงมีความหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki beğeniler gerçek insanlardan gelir, bu yüzden bir anlamı vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вподобання тут ставлять реальні люди, тому вони щось значать."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں کے لائکس حقیقی لوگوں کی طرف سے آتے ہیں، اس لیے ان کا کوئی مطلب ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt thích ở đây đến từ người thật, nên chúng có ý nghĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的点赞来自真实的人，因此有意义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的讚都來自真人，所以有意義。"
          }
        }
      }
    },
