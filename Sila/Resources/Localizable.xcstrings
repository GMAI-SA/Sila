    "account.delete.keepButton.hint": {
      "comment": "VoiceOver hint for the keep button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق هذا دون حذف أي شيء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু না মুছে এটি বন্ধ করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca això sense eliminar res"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavře toto okno bez mazání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukker dette uden at slette noget"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt dies, ohne etwas zu löschen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείνει αυτό χωρίς να διαγράψει τίποτα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this without deleting anything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra esto sin eliminar nada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
