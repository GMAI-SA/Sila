    "guest.room.refusal.rateLimited.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح اتصالك الغرف مرات كثيرة. انتظر قليلًا ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংযোগ থেকে অনেক বেশি বার রুম খোলা হয়েছে। একটু অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva connexió ha obert sales massa sovint. Espera una mica i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tvého připojení se otevíraly místnosti příliš často. Chvíli počkej a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din forbindelse har åbnet rum for mange gange. Vent lidt, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von deiner Verbindung wurden zu oft Räume geöffnet. Warte etwas und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεσή σου άνοιξε αίθουσες πολύ συχνά. Περίμενε λίγο και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your connection has opened rooms too often. Wait a little, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conexión ha abierto salas con demasiada frecuencia. Espera un poco y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteytesi on avannut huoneita liian usein. Odota hetki ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion a ouvert des salons trop souvent. Patientez un peu, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור שלך פתח חדרים לעיתים קרובות מדי. המתן מעט ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कनेक्शन से रूम बहुत बार खोले गए हैं। थोड़ा रुकें, फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja veza prečesto je otvarala sobe. Pričekaj malo, pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolatodról túl gyakran nyitottak szobákat. Várj egy kicsit, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksimu terlalu sering membuka room. Tunggu sebentar, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua connessione ha aperto stanze troppo spesso. Aspetta un po', poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続からルームを開く回数が多すぎます。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서 룸을 너무 자주 열었어요. 잠시 기다린 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കണക്ഷൻ വളരെ പതിവായി റൂമുകൾ തുറന്നു. അൽപനേരം കാത്തിരുന്ന് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan anda telah membuka bilik terlalu kerap. Tunggu sebentar, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen din har åpnet rom for ofte. Vent litt, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf je verbinding zijn te vaak rooms geopend. Wacht even en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Twojego połączenia otwarto pokoje zbyt wiele razy. Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conexão abriu salas vezes demais. Aguarde um pouco e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua ligação abriu salas com demasiada frequência. Aguarde um pouco e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea ta a deschis camere prea des. Așteaptă puțin, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С вашего подключения комнаты открывали слишком часто. Подождите немного и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tvojho pripojenia sa otvorilo príliš veľa miestností. Chvíľu počkaj a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din anslutning har öppnat rum för ofta. Vänta en stund och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இணைப்பிலிருந்து அறைகள் மிக அடிக்கடி திறக்கப்பட்டன. சிறிது காத்திருந்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కనెక్షన్ నుండి రూమ్‌లు చాలా తరచుగా తెరవబడ్డాయి. కాసేపు ఆగి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อของคุณเปิดห้องบ่อยเกินไป รอสักครู่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınız çok sık oda açtı. Biraz bekleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З вашого підключення кімнати відкривали надто часто. Трохи зачекайте й спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کنکشن نے بہت بار رومز کھولے ہیں۔ ذرا انتظار کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối của bạn đã mở phòng quá thường xuyên. Hãy chờ một lúc rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的网络开启房间过于频繁。请稍等片刻，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的連線開啟聊天室過於頻繁。請稍候再試。"
          }
        }
      }
    },
    "guest.room.refusal.rateLimited.title": {
      "comment": "Why a guest is not listening to a room (contract v31).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
