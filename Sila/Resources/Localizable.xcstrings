    "app.placeholder.subtitle": {
      "comment": "Explanation under the pre-feed headline.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفحة الرئيسية ستصل في المرحلة الثالثة. حسابك موثّق وجاهز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিড আসছে তৃতীয় পর্বে। আপনার অ্যাকাউন্ট ভেরিফায়েড ও প্রস্তুত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El canal arriba a la fase 3. El teu compte està verificat i a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanál přijde ve fázi 3. Tvůj účet je ověřený a připravený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedet kommer i fase 3. Din konto er verificeret og klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Feed kommt in Phase 3. Dein Konto ist verifiziert und bereit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ροή έρχεται στη Φάση 3. Ο λογαριασμός σου είναι επαληθευμένος και έτοιμος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feed arrives in Phase 3. Your account is verified and ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El feed llega en la Fase 3. Tu cuenta está verificada y lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syöte saapuu vaiheessa 3. Tilisi on vahvistettu ja valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fil arrive en phase 3. Votre compte est vérifié et prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפיד יגיע בשלב 3. החשבון שלך מאומת ומוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीड तीसरे चरण में आएगी। आपका अकाउंट सत्यापित और तैयार है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed stiže u 3. fazi. Tvoj račun je potvrđen i spreman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hírfolyam a 3. fázisban érkezik. A fiókod hitelesítve van és készen áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed hadir di Fase 3. Akunmu sudah terverifikasi dan siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feed arriva nella Fase 3. Il tuo account è verificato e pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードはフェーズ3で登場します。アカウントは認証済みで、準備できています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드는 3단계에서 제공돼요. 계정은 인증되었고 준비가 끝났어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫീഡ് ഫേസ് 3-ൽ എത്തും. നിങ്ങളുടെ അക്കൗണ്ട് പരിശോധിച്ച് തയ്യാറാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suapan akan tiba dalam Fasa 3. Akaun anda telah disahkan dan sedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeden kommer i fase 3. Kontoen din er verifisert og klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De feed komt in Fase 3. Je account is geverifieerd en klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanał pojawi się w fazie 3. Twoje konto jest zweryfikowane i gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feed chega na Fase 3. Sua conta está verificada e pronta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O feed chega na Fase 3. A sua conta está verificada e pronta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluxul sosește în Faza 3. Contul tău este verificat și gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лента появится на этапе 3. Ваш аккаунт проверен и готов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanál príde vo fáze 3. Tvoj účet je overený a pripravený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flödet kommer i fas 3. Ditt konto är verifierat och redo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊட்டம் கட்டம் 3-இல் வரும். உங்கள் கணக்கு சரிபார்க்கப்பட்டு தயாராக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫీడ్ మూడవ దశలో వస్తుంది. మీ ఖాతా ధృవీకరించబడింది, సిద్ధంగా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีดจะมาในเฟส 3 บัญชีของคุณยืนยันแล้วและพร้อมใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akış 3. Aşama'da geliyor. Hesabınız doğrulandı ve hazır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрічка з’явиться на етапі 3. Ваш обліковий запис верифіковано і він готовий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فیڈ تیسرے مرحلے میں آئے گی۔ آپ کا اکاؤنٹ تصدیق شدہ اور تیار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng tin sẽ có ở Giai đoạn 3. Tài khoản của bạn đã được xác minh và sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息流将在第 3 阶段推出。你的账户已验证，随时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態將在第 3 階段推出。你的帳號已通過驗證，準備就緒。"
          }
        }
      }
    },
