    "rooms.guests.allow.closed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستقبل الزوارَ إلا غرفةٌ مفتوحة. هذه الغرفة مقصورة على من اختارهم مضيفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু খোলা রুমে অতিথি থাকতে পারে। এই রুম হোস্টের বেছে নেওয়া মানুষদের মধ্যে সীমিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només una sala oberta pot tenir convidats. Aquesta sala està limitada a les persones que ha triat l'amfitrió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosty může mít jen otevřená místnost. Tato místnost je omezena na lidi, které vybral hostitel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et åbent rum kan have gæster. Dette rum er begrænset til de folk, dets vært valgte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein offener Raum kann Gäste haben. Dieser Raum ist auf die vom Host gewählten Personen beschränkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο μια ανοιχτή αίθουσα μπορεί να έχει επισκέπτες. Αυτή η αίθουσα περιορίζεται στα άτομα που επέλεξε ο οικοδεσπότης της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an open room can have guests. This room is limited to the people its host chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una sala abierta puede tener invitados. Esta sala está limitada a las personas que eligió su anfitrión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain avoimessa huoneessa voi olla vieraita. Tämä huone on rajattu isännän valitsemille ihmisille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un salon ouvert peut avoir des invités. Ce salon est limité aux personnes choisies par son animateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חדר פתוח יכול לכלול אורחים. החדר הזה מוגבל לאנשים שהמארח שלו בחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल खुले रूम में मेहमान हो सकते हैं। यह रूम केवल होस्ट के चुने लोगों तक सीमित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo otvorena soba može imati goste. Ova soba ograničena je na ljude koje je odabrao njezin domaćin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak nyitott szobának lehetnek vendégei. Ez a szoba a házigazda által választott emberekre korlátozódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya room terbuka yang bisa punya tamu. Room ini dibatasi untuk orang yang dipilih hostnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una stanza aperta può avere ospiti. Questa stanza è limitata alle persone scelte dal suo host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストを入れられるのは公開ルームだけです。このルームは、ホストが選んだ人に限定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 룸만 게스트를 받을 수 있어요. 이 룸은 호스트가 선택한 사람으로 제한돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുറന്ന റൂമിന് മാത്രമേ അതിഥികൾ ഉണ്ടാകൂ. ഈ റൂം ഹോസ്റ്റ് തിരഞ്ഞെടുത്തവരിലേക്ക് പരിമിതമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya bilik terbuka boleh mempunyai tetamu. Bilik ini terhad kepada orang yang dipilih hosnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et åpent rom kan ha gjester. Dette rommet er begrenset til folk verten valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een open room kan gasten hebben. Deze room is beperkt tot de mensen die de host heeft gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goście mogą być tylko w otwartym pokoju. Ten pokój jest ograniczony do osób wybranych przez gospodarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma sala aberta pode ter visitantes. Esta sala é limitada às pessoas que o anfitrião escolheu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma sala aberta pode ter convidados. Esta sala está limitada às pessoas escolhidas pelo anfitrião."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar o cameră deschisă poate avea invitați. Această cameră este limitată la oamenii aleși de gazdă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гости возможны только в открытой комнате. Эта комната ограничена людьми, выбранными ведущим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostí môže mať iba otvorená miestnosť. Táto miestnosť je obmedzená na ľudí, ktorých vybral jej hostiteľ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ett öppet rum kan ha gäster. Det här rummet är begränsat till de värden valt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திறந்த அறைக்கு மட்டுமே விருந்தினர்கள் இருக்கலாம். இந்த அறை நடத்துநர் தேர்ந்தெடுத்தவர்களுக்கு மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తెరిచి ఉన్న రూమ్‌కు మాత్రమే అతిథులు ఉండగలరు. ఈ రూమ్ హోస్ట్ ఎంచుకున్న వారికే పరిమితం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะห้องเปิดเท่านั้นที่มีผู้เยี่ยมชมได้ ห้องนี้จำกัดเฉพาะคนที่เจ้าของห้องเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca açık bir odada misafir olabilir. Bu oda, sunucusunun seçtiği kişilerle sınırlı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гості можуть бути лише у відкритій кімнаті. Ця кімната обмежена людьми, яких вибрав її ведучий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف کھلے روم میں مہمان ہو سکتے ہیں۔ یہ روم میزبان کے چنے ہوئے لوگوں تک محدود ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ phòng mở mới có thể có khách. Phòng này giới hạn cho những người chủ phòng đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开放的房间才能有访客。此房间仅限主持人选定的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有開放的聊天室才能有訪客。此聊天室僅限主持人選擇的人。"
          }
        }
      }
    },
    "rooms.guests.allow.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستطيع من ليس لديه حساب أن يستمع. لا يمكنه التحدث أو رفع اليد أو التفاعل أو الدردشة، ولا يراه أحد في الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট ছাড়া মানুষ শুনতে পারে। তারা কথা বলতে, হাত তুলতে, রিঅ্যাক্ট করতে বা চ্যাট করতে পারে না, আর রুমের কেউ তাদের দেখতে পায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les persones sense compte poden escoltar. No poden parlar, aixecar la mà, reaccionar ni xatejar, i ningú de la sala les veu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé bez účtu mohou poslouchat. Nemohou mluvit, hlásit se, reagovat ani chatovat a nikdo v místnosti je nevidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk uden en konto kan lytte. De kan ikke tale, række hånden op, reagere eller chatte, og ingen i rummet ser dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen ohne Konto können zuhören. Sie können weder sprechen, die Hand heben, reagieren noch chatten, und niemand im Raum sieht sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άτομα χωρίς λογαριασμό μπορούν να ακούν. Δεν μπορούν να μιλήσουν, να σηκώσουν χέρι, να αντιδράσουν ή να συνομιλήσουν και κανείς στην αίθουσα δεν τα βλέπει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People without an account can listen. They can't speak, raise a hand, react or chat, and nobody in the room sees them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas sin cuenta pueden escuchar. No pueden hablar, levantar la mano, reaccionar ni chatear, y nadie en la sala las ve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman tiliä olevat voivat kuunnella. He eivät voi puhua, nostaa kättä, reagoida tai keskustella, eikä kukaan huoneessa näe heitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes sans compte peuvent écouter. Elles ne peuvent ni parler, ni lever la main, ni réagir, ni discuter, et personne dans le salon ne les voit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנשים בלי חשבון יכולים להאזין. הם לא יכולים לדבר, להרים יד, להגיב או לשוחח, ואף אחד בחדר לא רואה אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना अकाउंट वाले लोग सुन सकते हैं। वे बोल नहीं सकते, हाथ नहीं उठा सकते, रिएक्ट या चैट नहीं कर सकते, और रूम में कोई उन्हें नहीं देखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudi bez računa mogu slušati. Ne mogu govoriti, dizati ruku, reagirati ni čavrljati, a nitko u sobi ih ne vidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók nélküli emberek hallgathatnak. Nem szólalhatnak meg, nem jelentkezhetnek, nem reagálhatnak és nem csevegnek, és a szobában senki nem látja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tanpa akun bisa mendengarkan. Mereka tidak bisa berbicara, mengangkat tangan, bereaksi, atau mengobrol, dan tidak ada yang di room melihat mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone senza un account possono ascoltare. Non possono parlare, alzare la mano, reagire o chattare, e nessuno nella stanza le vede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのない人も聴けます。発言、挙手、リアクション、チャットはできず、ルームの誰にも見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 없는 사람도 들을 수 있어요. 말하기, 손들기, 반응, 채팅은 할 수 없고 룸의 아무도 이들을 볼 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ട് ഇല്ലാത്തവർക്ക് കേൾക്കാം. അവർക്ക് സംസാരിക്കാനോ കൈ ഉയർത്താനോ പ്രതികരിക്കാനോ ചാറ്റ് ചെയ്യാനോ കഴിയില്ല, റൂമിലെ ആരും അവരെ കാണുകയുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tanpa akaun boleh mendengar. Mereka tidak boleh bercakap, mengangkat tangan, bereaksi atau berbual, dan tiada sesiapa dalam bilik melihat mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk uten konto kan lytte. De kan ikke snakke, rekke opp hånden, reagere eller chatte, og ingen i rommet ser dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen zonder account kunnen luisteren. Ze kunnen niet spreken, een hand opsteken, reageren of chatten, en niemand in de room ziet hen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby bez konta mogą słuchać. Nie mogą mówić, podnosić ręki, reagować ani czatować, a nikt w pokoju ich nie widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas sem conta podem ouvir. Elas não podem falar, levantar a mão, reagir nem conversar, e ninguém na sala as vê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas sem conta podem ouvir. Não podem falar, levantar a mão, reagir nem conversar, e ninguém na sala as vê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoanele fără cont pot asculta. Nu pot vorbi, ridica mâna, reacționa sau scrie în chat, iar nimeni din cameră nu le vede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди без аккаунта могут слушать. Они не могут говорить, поднимать руку, реагировать и писать в чат, и никто в комнате их не видит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ľudia bez účtu môžu počúvať. Nemôžu hovoriť, hlásiť sa, reagovať ani písať do četu a nikto v miestnosti ich nevidí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personer utan konto kan lyssna. De kan inte tala, räcka upp handen, reagera eller chatta, och ingen i rummet ser dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு இல்லாதவர்கள் கேட்கலாம். அவர்கள் பேச, கை உயர்த்த, எதிர்வினையாற்ற அல்லது அரட்டையடிக்க முடியாது, அறையில் யாருக்கும் அவர்கள் தெரியமாட்டார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా లేని వ్యక్తులు వినవచ్చు. వారు మాట్లాడలేరు, చేయి ఎత్తలేరు, రియాక్ట్ అవ్వలేరు, చాట్ చేయలేరు, రూమ్‌లో ఎవరికీ వారు కనిపించరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ไม่มีบัญชีฟังได้ แต่พูด ยกมือ แสดงรีแอกชัน หรือแชทไม่ได้ และไม่มีใครในห้องเห็นพวกเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı olmayanlar dinleyebilir. Konuşamaz, el kaldıramaz, tepki veremez veya sohbet edemezler ve odadaki kimse onları görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди без облікового запису можуть слухати. Вони не можуть говорити, піднімати руку, реагувати чи писати в чат, і ніхто в кімнаті їх не бачить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر اکاؤنٹ کے لوگ سن سکتے ہیں۔ وہ بول نہیں سکتے، ہاتھ نہیں اٹھا سکتے، ردعمل یا چیٹ نہیں کر سکتے، اور روم میں کوئی انہیں نہیں دیکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người không có tài khoản có thể nghe. Họ không thể phát biểu, giơ tay, bày tỏ cảm xúc hay trò chuyện, và không ai trong phòng thấy họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户的人也可以收听。他们不能发言、举手、回应或聊天，房间里也没有人能看到他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號的人也可以收聽。他們不能發言、舉手、回應或聊天，聊天室裡也沒有人看得到他們。"
          }
        }
      }
    },
    "rooms.guests.allow.notHost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغيّر هذا إلا المضيف والمضيفون المشاركون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু হোস্ট ও সহ-হোস্টরা এটি বদলাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només l'amfitrió i els coanfitrions ho poden canviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnit to mohou jen hostitel a spoluhostitelé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun værten og medværterne kan ændre dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das können nur der Host und die Co-Hosts ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο ο οικοδεσπότης και οι συνδιοργανωτές μπορούν να το αλλάξουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the host and co-hosts can change this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el anfitrión y los coanfitriones pueden cambiar esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain isäntä ja yhteisännät voivat muuttaa tätä."
