    "account.password.signOutNow.hint": {
      "comment": "VoiceOver hint for signing out after a password change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذه الجلسة لتتمكن من تسجيل الدخول بكلمة المرور الجديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সেশন শেষ করে যাতে নতুন পাসওয়ার্ডে সাইন ইন করতে পারেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalitza aquesta sessió perquè puguis iniciar-ne una amb la contrasenya nova"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí toto přihlášení, abys se mohl přihlásit novým heslem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslutter denne session, så du kan logge ind med den nye adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet diese Sitzung, damit du dich mit dem neuen Passwort anmelden kannst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τερματίζει αυτή τη συνεδρία ώστε να συνδεθείς με τον νέο κωδικό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends this session so you can sign in with the new password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina esta sesión para que puedas iniciar sesión con la nueva contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättää tämän istunnon, jotta voit kirjautua uudella salasanalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine cette session pour que vous puissiez vous connecter avec le nouveau mot de passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיים את ההתחברות הזו כדי שתוכל להתחבר עם הסיסמה החדשה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सेशन खत्म करता है ताकि आप नए पासवर्ड से साइन इन कर सकें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava ovu sesiju kako bi se mogao/la prijaviti novom lozinkom"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Befejezi ezt a munkamenetet, hogy az új jelszóval jelentkezhess be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakhiri sesi ini agar kamu bisa masuk dengan kata sandi baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina questa sessione così puoi accedere con la nuova password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションを終了し、新しいパスワードでサインインできるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션을 종료해 새 비밀번호로 로그인할 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ പാസ്‌വേഡ് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യാൻ ഈ സെഷൻ അവസാനിപ്പിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamatkan sesi ini supaya anda boleh log masuk dengan kata laluan baharu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutter denne økten slik at du kan logge inn med det nye passordet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindigt deze sessie zodat je met het nieuwe wachtwoord kunt inloggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy tę sesję, abyś mógł(-ogła) zalogować się nowym hasłem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra esta sessão para você entrar com a nova senha"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina esta sessão para poder iniciar sessão com a nova palavra-passe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie această sesiune ca să te poți autentifica cu noua parolă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает этот сеанс, чтобы вы могли войти с новым паролем"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí túto reláciu, aby si sa mohol prihlásiť s novým heslom"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutar den här sessionen så att du kan logga in med det nya lösenordet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அமர்வை முடிக்கும், புதிய கடவுச்சொல்லுடன் உள்நுழையலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సెషన్‌ను ముగిస్తుంది, తద్వారా కొత్త పాస్‌వర్డ్‌తో సైన్ ఇన్ చేయవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จบเซสชันนี้เพื่อให้คุณลงชื่อเข้าใช้ด้วยรหัสผ่านใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni şifreyle giriş yapabilmeniz için bu oturumu sonlandırır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершує цей сеанс, щоб ви могли увійти з новим паролем"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ سیشن ختم کرتا ہے تاکہ آپ نئے پاس ورڈ سے سائن اِن کر سکیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc phiên này để bạn đăng nhập bằng mật khẩu mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束此会话，以便用新密码登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束此工作階段，讓你以新密碼登入"
          }
        }
      }
