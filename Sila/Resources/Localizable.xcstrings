    "preferences.save.failed.a11yLabel": {
      "comment": "VoiceOver reading of the save error. %@ is the server's message. Says the edits survive.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الحفظ. %@ وتغييراتك ما زالت موجودة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ ব্যর্থ হয়েছে। %@ আপনার পরিবর্তনগুলো এখনও এখানে আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut desar. %@ Els canvis continuen aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložení selhalo. %@ Tvé změny tu stále jsou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gemme. %@ Dine ændringer er her stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern fehlgeschlagen. %@ Deine Änderungen sind noch da."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθήκευση απέτυχε. %@ Οι αλλαγές σου είναι ακόμα εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save failed. %@ Your changes are still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. %@ Tus cambios siguen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus epäonnistui. %@ Muutoksesi ovat yhä tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’enregistrement. %@ Vos modifications sont toujours là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמירה נכשלה. %@ השינויים שלך עדיין כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव नहीं हो सका। %@ आपके बदलाव अब भी यहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanje nije uspjelo. %@ Tvoje promjene su još ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentés nem sikerült. %@ A módosításaid még megvannak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menyimpan. %@ Perubahanmu masih ada di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio non riuscito. %@ Le tue modifiche sono ancora qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました。%@ 変更内容はここに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 못했어요. %@ 변경 사항은 그대로 남아 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് പരാജയപ്പെട്ടു. %@ നിങ്ങളുടെ മാറ്റങ്ങൾ ഇവിടെത്തന്നെയുണ്ട്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menyimpan. %@ Perubahan anda masih di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagring mislyktes. %@ Endringene dine er fortsatt her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan mislukt. %@ Je wijzigingen staan er nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis nie powiódł się. %@ Twoje zmiany nadal tu są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar. %@ Suas alterações continuam aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao guardar. %@ As suas alterações continuam aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea a eșuat. %@ Modificările tale sunt încă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить. %@ Ваши изменения остались на месте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženie zlyhalo. %@ Tvoje zmeny tu stále sú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara. %@ Dina ändringar finns kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிப்பு தோல்வியடைந்தது. %@ உங்கள் மாற்றங்கள் இன்னும் இங்கே உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ విఫలమైంది. %@ మీ మార్పులు ఇంకా ఇక్కడే ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไม่สำเร็จ %@ การเปลี่ยนแปลงของคุณยังอยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetme başarısız. %@ Değişiklikleriniz hâlâ burada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти. %@ Ваші зміни все ще тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنا ناکام ہوا۔ %@ آپ کی تبدیلیاں ابھی یہیں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thất bại. %@ Các thay đổi của bạn vẫn còn đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败。%@ 你的更改仍保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗。%@ 你的變更仍保留在這裡。"
          }
        }
      }
    },
    "preferences.save.hint": {
      "comment": "VoiceOver hint for the save button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل هذه الإعدادات إلى «معروف» ويطبّقها على صفحتك الدولية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সেটিংস Known-এ পাঠায় এবং আপনার আন্তর্জাতিক ফিডে প্রয়োগ করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia aquests ajustos a Known i els aplica al teu canal Internacional"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle tato nastavení aplikaci Known a použije je na tvůj Mezinárodní kanál"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender disse indstillinger til Known og anvender dem på dit internationale feed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet diese Einstellungen an Known und wendet sie auf deinen internationalen Feed an"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει αυτές τις ρυθμίσεις στο Known και τις εφαρμόζει στη Διεθνή ροή σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends these settings to Known and applies them to your International feed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía estos ajustes a Known y los aplica a tu feed Internacional"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää nämä asetukset Knownille ja ottaa ne käyttöön Kansainvälinen-syötteessäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ces réglages à Known et les applique à votre fil International"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את ההגדרות האלה ל-Known ומחיל אותן על הפיד הבינלאומי שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये सेटिंग्स Known को भेजता है और आपकी अंतरराष्ट्रीय फ़ीड पर लागू करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje ove postavke aplikaciji Known i primjenjuje ih na tvoj međunarodni feed"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi ezeket a beállításokat a Knownnak, és alkalmazza a Nemzetközi hírfolyamodra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim pengaturan ini ke Known dan menerapkannya pada feed Internasionalmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia queste impostazioni a Known e le applica al tuo feed Internazionale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定をKnownに送信し、国際フィードに反映します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 Known에 보내고 국제 피드에 적용해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ക്രമീകരണങ്ങൾ Known-ന് അയച്ച് നിങ്ങളുടെ അന്താരാഷ്ട്ര ഫീഡിൽ പ്രയോഗിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar tetapan ini kepada Known dan menerapkannya pada suapan Antarabangsa anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender disse innstillingene til Known og bruker dem på den internasjonale feeden din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt deze instellingen naar Known en past ze toe op je internationale feed"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła te ustawienia do Known i stosuje je w kanale międzynarodowym"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia estes ajustes ao Known e os aplica ao seu feed Internacional"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia estas definições para a Known e aplica-as ao seu feed Internacional"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite aceste setări la Known și le aplică fluxului tău Internațional"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет эти настройки в Known и применяет их к вашей международной ленте"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odošle tieto nastavenia do Known a použije ich na tvoj medzinárodný kanál"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar de här inställningarna till Known och tillämpar dem på ditt internationella flöde"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அமைப்புகளை Known-க்கு அனுப்பி உங்கள் சர்வதேச ஊட்டத்தில் செயல்படுத்தும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సెట్టింగ్‌లను Knownకు పంపి, మీ అంతర్జాతీయ ఫీడ్‌కు వర్తింపజేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งการตั้งค่านี้ไปที่ Known และใช้กับฟีดนานาชาติของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarları Known'a gönderir ve Uluslararası akışınıza uygular"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає ці налаштування до Known й застосовує їх до вашої стрічки «Світ»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ سیٹنگز Known کو بھیجتا ہے اور انہیں آپ کی بین الاقوامی فیڈ پر لاگو کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi các cài đặt này đến Known và áp dụng cho bảng tin Quốc tế của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些设置发送给 Known，并应用到你的国际信息流"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些設定傳送給 Known，並套用到你的「國際」動態"
          }
        }
      }
    },
