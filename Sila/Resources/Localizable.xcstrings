        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то принял ваше поручительство — подтвердите, что это он"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto prijal tvoje ručenie — potvrď, že je to on"
