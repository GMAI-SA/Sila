    "onboarding.interests.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ثلاثة أو أكثر. يمكنك تغييرها في أي وقت من الشريط فوق خلاصتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিনটি বা তার বেশি বেছে নিন। যেকোনো সময় আপনার ফিডের উপরের সারি থেকে বদলাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria'n tres o més. Ho pots canviar en qualsevol moment des de la fila que hi ha sobre el canal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber tři nebo více. Můžeš to kdykoli změnit v řadě nad svým kanálem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg tre eller flere. Du kan til enhver tid ændre det fra rækken over dit feed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle drei oder mehr. Du kannst das jederzeit in der Zeile über deinem Feed ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε τρία ή περισσότερα. Μπορείς να το αλλάξεις οποτεδήποτε από τη γραμμή πάνω από τη ροή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick three or more. You can change this any time from the row above your feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tres o más. Puedes cambiarlo cuando quieras desde la fila sobre tu feed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kolme tai useampi. Voit muuttaa tätä milloin tahansa syötteesi yläpuolella olevalta riviltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en trois ou plus. Vous pourrez changer cela à tout moment depuis la rangée au-dessus de votre fil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר שלושה או יותר. אפשר לשנות זאת בכל עת מהשורה שמעל הפיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन या ज़्यादा चुनें। आप इसे कभी भी अपनी फ़ीड के ऊपर की पंक्ति से बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi tri ili više. Možeš to promijeniti bilo kada iz retka iznad feeda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz hármat vagy többet. Bármikor módosíthatod a hírfolyamod feletti sorból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tiga atau lebih. Kamu bisa mengubahnya kapan saja dari deretan di atas feed-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline tre o più. Puoi cambiarli quando vuoi dalla riga sopra il feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つ以上選んでください。あとでフィードの上の列からいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 개 이상 선택하세요. 피드 위의 줄에서 언제든 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൂന്നോ അതിലധികമോ തിരഞ്ഞെടുക്കുക. നിങ്ങളുടെ ഫീഡിന് മുകളിലെ വരിയിൽ നിന്ന് എപ്പോൾ വേണമെങ്കിലും ഇത് മാറ്റാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tiga atau lebih. Anda boleh mengubahnya bila-bila masa daripada baris di atas suapan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg tre eller flere. Du kan endre dette når som helst fra raden over feeden din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er drie of meer. Je kunt dit altijd wijzigen via de rij boven je feed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz trzy lub więcej. Możesz to zmienić w każdej chwili w rzędzie nad kanałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha três ou mais. Você pode mudar isso a qualquer momento na linha acima do seu feed."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha três ou mais. Pode alterá-los em qualquer altura na linha acima do feed."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege trei sau mai multe. Le poți schimba oricând din rândul de deasupra fluxului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите три или больше. Изменить выбор можно в любой момент в ряду над лентой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber tri alebo viac. Kedykoľvek to môžeš zmeniť v riadku nad kanálom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj tre eller fler. Du kan ändra detta när som helst från raden ovanför ditt flöde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூன்று அல்லது அதற்கு மேல் தேர்ந்தெடுங்கள். உங்கள் ஊட்டத்துக்கு மேலுள்ள வரிசையிலிருந்து எப்போது வேண்டுமானாலும் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూడు లేదా అంతకంటే ఎక్కువ ఎంచుకోండి. మీ ఫీడ్ పై వరుస నుండి దీన్ని ఎప్పుడైనా మార్చుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสามเรื่องขึ้นไป คุณเปลี่ยนได้ทุกเมื่อจากแถวเหนือฟีดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç veya daha fazlasını seçin. Bunu istediğiniz zaman akışınızın üstündeki sıradan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть три або більше. Це можна змінити будь-коли в рядку над вашою стрічкою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین یا زیادہ چنیں۔ آپ اسے کسی بھی وقت اپنی فیڈ کے اوپر کی قطار سے بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ba chủ đề trở lên. Bạn có thể đổi bất cứ lúc nào từ hàng phía trên bảng tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择三个或更多。你随时可以在信息流上方的一行中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選三個或更多。之後隨時可在動態上方的列變更。"
          }
        }
      }
    },
    "onboarding.interests.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمّ تحب أن تقرأ؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কী নিয়ে পড়তে চান?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre què vols llegir?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O čem chceš číst?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du gerne læse om?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worüber möchtest du lesen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι θέλεις να διαβάζεις;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to read about?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sobre qué quieres leer?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistä haluat lukea?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur quoi voulez-vous lire ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על מה אתה רוצה לקרוא?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किस बारे में पढ़ना चाहते हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "O čemu želiš čitati?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miről szeretnél olvasni?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ingin kamu baca?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di cosa vuoi leggere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなことを読みたいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 글을 읽고 싶으세요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് എന്തിനെക്കുറിച്ച് വായിക്കണം?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang anda mahu baca?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva vil du lese om?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarover wil je lezen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O czym chcesz czytać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o que você quer ler?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o que quer ler?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Despre ce vrei să citești?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О чём вы хотите читать?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O čom chceš čítať?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du läsa om?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதைப் பற்றிப் படிக்க விரும்புகிறீர்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు దేని గురించి చదవాలనుకుంటున్నారు?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากอ่านเรื่องอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi konularda okumak istersiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про що ви хочете читати?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کیا پڑھنا چاہتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn đọc về điều gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想阅读哪些内容？"
          }
        },
        "zh-Hant": {
