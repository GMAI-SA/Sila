    "safety.reason.violence.detail": {
      "comment": "What the violence reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تهديد بالعنف، أو محتوى يمجّده أو يحرّض عليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহিংসতার হুমকি, বা যে কনটেন্ট তা উদযাপন বা উসকে দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amenaces de violència, o contingut que l'exalta o la incita."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výhrůžky násilím nebo obsah, který násilí oslavuje či podněcuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusler om vold eller indhold, der forherliger eller opfordrer til det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewaltandrohungen oder Inhalte, die Gewalt verherrlichen oder dazu aufrufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απειλές βίας ή περιεχόμενο που την εξυμνεί ή την υποκινεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threats of violence, or content that celebrates or incites it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amenazas de violencia, o contenido que la celebra o incita a ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väkivallan uhkaukset tai sitä ylistävä tai yllyttävä sisältö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaces de violence, ou contenu qui la glorifie ou l’incite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איומים באלימות, או תוכן שמהלל או מסית אליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिंसा की धमकियाँ, या ऐसा कंटेंट जो उसका जश्न मनाता या उकसाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijetnje nasiljem ili sadržaj koji ga veliča ili potiče."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erőszakkal való fenyegetés, vagy azt dicsőítő vagy arra uszító tartalom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancaman kekerasan, atau konten yang memuliakan atau menghasutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Minacce di violenza, o contenuti che la celebrano o la incitano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暴力の脅し、または暴力を称賛・扇動する内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭력 위협, 또는 폭력을 미화하거나 선동하는 콘텐츠."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്രമ ഭീഷണികൾ, അല്ലെങ്കിൽ അക്രമത്തെ മഹത്വവൽക്കരിക്കുന്നതോ പ്രേരിപ്പിക്കുന്നതോ ആയ ഉള്ളടക്കം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancaman keganasan, atau kandungan yang meraikan atau menghasutnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Voldstrusler, eller innhold som hyller eller oppfordrer til vold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreigen met geweld, of inhoud die geweld verheerlijkt of aanzet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groźby przemocy lub treści, które ją gloryfikują albo do niej podżegają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ameaças de violência, ou conteúdo que a celebra ou incita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ameaças de violência, ou conteúdo que a celebre ou incite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amenințări cu violență sau conținut care o glorifică ori o incită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угрозы насилием или содержимое, которое прославляет его или призывает к нему."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhrážky násilím alebo obsah, ktorý ho oslavuje alebo podnecuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hot om våld, eller innehåll som hyllar eller uppmanar till det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வன்முறை மிரட்டல்கள், அல்லது அதைக் கொண்டாடும் அல்லது தூண்டும் உள்ளடக்கம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హింస బెదిరింపులు, లేదా దాన్ని కీర్తించే లేదా రెచ్చగొట్టే కంటెంట్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การขู่ใช้ความรุนแรง หรือเนื้อหาที่ยกย่องหรือยุยงความรุนแรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şiddet tehdidi veya şiddeti öven ya da kışkırtan içerik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрози насильством або вміст, що прославляє чи підбурює до нього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تشدد کی دھمکیاں، یا ایسا مواد جو اس کی تعریف یا ترغیب کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đe dọa bạo lực, hoặc nội dung ca ngợi hay kích động bạo lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暴力威胁，或美化、煽动暴力的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暴力威脅，或美化、煽動暴力的內容。"
          }
        }
      }
    },
