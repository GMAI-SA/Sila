    "vouch.list.invite.burn.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يستطيع أحد استخدامه بعد ذلك، ولا يُعيد لك رابط اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর কেউ এটি ব্যবহার করতে পারবে না। আজকের লিংকটি ফেরত পাবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú el podrà fer servir després d'això. No et retorna l'enllaç d'avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté ho už nikdo nemůže použít. Dnešní odkaz se nevrátí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kan bruge det efter dette. Det giver ikke dagens link tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach kann ihn niemand mehr nutzen. Der heutige Link wird nicht zurückgegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν μπορεί να τον χρησιμοποιήσει μετά από αυτό. Δεν επιστρέφει τον σημερινό σύνδεσμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody can use it after this. It doesn't give back today's link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie podrá usarlo después. No te devuelve el enlace de hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei voi käyttää sitä tämän jälkeen. Se ei palauta tämän päivän linkkiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne pourra plus l’utiliser. Cela ne vous rend pas le lien du jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד לא יוכל להשתמש בו אחרי זה. זה לא מחזיר את הקישור של היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद कोई इसका इस्तेमाल नहीं कर सकता। यह आज का लिंक वापस नहीं देता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko je nakon ovoga ne može koristiti. Ne vraća današnju poveznicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután senki nem használhatja. A mai hivatkozásodat nem adja vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang bisa memakainya setelah ini. Jatah tautan hari ini tidak dikembalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno potrà più usarlo. Non ti restituisce il link di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあとは誰も使えなくなります。今日のリンクの発行回数は戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후에는 아무도 사용할 수 없어요. 오늘 사용한 링크는 돌려받지 못해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് ശേഷം ആർക്കും ഇത് ഉപയോഗിക്കാനാകില്ല. ഇന്നത്തെ ലിങ്ക് തിരികെ ലഭിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa boleh menggunakannya selepas ini. Ia tidak mengembalikan pautan hari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kan bruke den etter dette. Du får ikke tilbake dagens lenke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kan hem hierna nog gebruiken. De link van vandaag krijg je niet terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym nikt nie będzie mógł go użyć. Nie zwraca to dzisiejszego linku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém poderá usá-lo depois disso. Isso não devolve o link de hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém a poderá usar depois disto. Não devolve a ligação de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni nu îl va mai putea folosi după aceasta. Nu îți returnează linkul de azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого ей никто не сможет воспользоваться. Сегодняшняя ссылка не возвращается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom ho nikto nebude môcť použiť. Dnešný odkaz sa ti nevráti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kan använda den efter detta. Det ger inte tillbaka dagens länk."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்குப் பிறகு யாரும் இதைப் பயன்படுத்த முடியாது. இன்றைய இணைப்பு உங்களுக்குத் திரும்பக் கிடைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని తర్వాత ఎవరూ దీన్ని వాడలేరు. ఇది ఈ రోజు లింక్‌ను తిరిగి ఇవ్వదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากนี้ไม่มีใครใช้ได้ และจะไม่คืนลิงก์ของวันนี้ให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra kimse kullanamaz. Bugünkü bağlantı hakkınızı geri vermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після цього ніхто не зможе ним скористатися. Це не повертає сьогоднішнє посилання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بعد کوئی اسے استعمال نہیں کر سکتا۔ یہ آج کا لنک واپس نہیں دیتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó không ai dùng được nó. Nó không trả lại liên kết của hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后任何人都无法使用它。这不会归还今天的链接额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後沒有人能使用它，但不會退還今天的連結額度。"
          }
        }
      }
    },
