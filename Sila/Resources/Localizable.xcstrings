    "vouch.mine.countdown.detail": {
      "comment": "%@ is a date.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تزكيتك في %@. لا يمكن تجديدها — وثّق هويتك قبل ذلك لتواصل النشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভাউচ %@ তারিখে শেষ হবে। এটি নবায়ন করা যায় না — পোস্ট করা চালিয়ে যেতে তার আগে আপনার পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu aval acaba el %@. No es pot renovar: verifica la teva identitat abans per continuar publicant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé ručení končí %@. Nelze ho obnovit – do té doby ověř svou totožnost, abys mohl dál psát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din garanti ophører %@. Den kan ikke fornyes – verificér din identitet inden da for at kunne blive ved med at slå op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bürgschaft endet am %@. Sie kann nicht verlängert werden – verifiziere vorher deine Identität, um weiter zu posten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγύησή σου λήγει στις %@. Δεν ανανεώνεται — επαλήθευσε την ταυτότητά σου πριν από τότε για να συνεχίσεις να δημοσιεύεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vouch ends on %@. It can't be renewed — verify your identity before then to keep posting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu aval termina el %@. No se puede renovar: verifica tu identidad antes para seguir publicando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takuusi päättyy %@. Sitä ei voi uusia – vahvista henkilöllisyytesi ennen sitä jatkaaksesi julkaisemista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre caution se termine le %@. Elle ne peut pas être renouvelée — vérifiez votre identité avant cette date pour continuer à publier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערבות שלך מסתיימת ב-%@. אי אפשר לחדש אותה — אמת את זהותך לפני כן כדי להמשיך לפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वाउच %@ को खत्म होता है। इसे नवीनीकृत नहीं किया जा सकता — पोस्ट करते रहने के लिए उससे पहले अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje jamstvo završava: %@. Ne može se obnoviti — potvrdi svoj identitet prije toga da nastaviš objavljivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezességed ekkor ér véget: %@. Nem újítható meg – addig hitelesítsd a személyazonosságodat, hogy továbbra is írhass."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminanmu berakhir pada %@. Tidak bisa diperpanjang — verifikasi identitasmu sebelum itu agar tetap bisa memposting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua garanzia termina il %@. Non può essere rinnovata: verifica la tua identità prima per continuare a pubblicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証は%@に終了します。更新はできません。投稿を続けるには、それまでに本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증은 %@에 종료돼요. 갱신할 수 없으니 그 전에 신원을 인증해야 계속 게시할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വൗച്ച് %@ ന് അവസാനിക്കും. ഇത് പുതുക്കാനാകില്ല — പോസ്റ്റ് ചെയ്യുന്നത് തുടരാൻ അതിനുമുമ്പ് നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminan anda berakhir pada %@. Ia tidak boleh diperbaharui — sahkan identiti anda sebelum itu untuk terus menyiar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantien din slutter %@. Den kan ikke fornyes. Verifiser identiteten din før da for å fortsette å publisere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je garantie eindigt op %@. Ze kan niet worden verlengd: verifieer je identiteit voor die tijd om te kunnen blijven posten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje poręczenie kończy się %@. Nie można go odnowić — zweryfikuj tożsamość przed tym terminem, aby dalej publikować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu aval termina em %@. Ele não pode ser renovado: verifique sua identidade antes disso para continuar postando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu aval termina a %@. Não pode ser renovado — verifique a sua identidade antes disso para continuar a publicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanția ta se încheie pe %@. Nu poate fi reînnoită — verifică-ți identitatea până atunci ca să poți posta în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство заканчивается %@. Оно не продлевается — пройдите проверку личности до этого, чтобы продолжать писать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ručenie končí %@. Nedá sa obnoviť — over svoju totožnosť skôr, aby si mohol pokračovať v zverejňovaní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt intygande upphör den %@. Det kan inte förnyas – verifiera din identitet före dess för att fortsätta publicera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உறுதிமொழி %@ அன்று முடிகிறது. புதுப்பிக்க முடியாது — தொடர்ந்து இடுகையிட அதற்குள் உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హామీ %@ న ముగుస్తుంది. దీన్ని పునరుద్ధరించలేరు — పోస్ట్ చేస్తూ ఉండటానికి అంతకుముందే మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรับรองของคุณสิ้นสุดวันที่ %@ ต่ออายุไม่ได้ ยืนยันตัวตนก่อนถึงวันนั้นเพื่อโพสต์ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefilliğiniz %@ tarihinde sona erer. Yenilenemez; gönderi paylaşmaya devam etmek için o tarihten önce kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство закінчується %@. Його не можна поновити — верифікуйте особу до цього часу, щоб і далі публікувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ضمانت %@ کو ختم ہوتی ہے۔ اس کی تجدید نہیں ہو سکتی — پوسٹ کرتے رہنے کے لیے اس سے پہلے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bảo chứng của bạn kết thúc vào %@. Không thể gia hạn — hãy xác minh danh tính trước đó để tiếp tục đăng bài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的担保将于 %@ 结束，且不可续期。请在此之前验证身份，以继续发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的擔保將於 %@ 結束，且無法續期，請在那之前驗證你的身分以繼續發文。"
          }
        }
      }
    },
    "vouch.mine.intro": {
      "comment": "%1$@ is the voucher's handle, %2$@ a date.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زكّاك ⁦@%1$@⁩ في %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ আপনার জন্য %2$@ তারিখে ভাউচ করেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ et va avalar el %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ za tebe ručí od %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ gik i god for dig den %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ hat am %2$@ für dich gebürgt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%1$@ εγγυήθηκε για εσένα στις %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ vouched for you on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ te avaló el %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ takasi sinut %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ s’est porté garant de vous le %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ערב לך ב-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ने %2$@ को आपके लिए वाउच किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ je jamčio/la za tebe: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kezeskedett érted ekkor: %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ menjaminmu pada %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ha garantito per te il %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@が%2$@にあなたを保証しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@님이 %2$@에 나를 보증했어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ന് @%1$@ നിങ്ങൾക്ക് വൗച്ച് ചെയ്തു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ menjamin anda pada %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ garanterte for deg %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ stond voor je in op %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ poręczył(a) za Ciebie dnia %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ avalizou você em %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ deu-lhe aval em %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ a garantat pentru tine pe %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ поручился(-лась) за вас %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ za teba ručil %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ intygade för dig den %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ உங்களுக்காக %2$@ அன்று உறுதியளித்தார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ మీకు %2$@ న హామీ ఇచ్చారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ รับรองคุณเมื่อ %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ sizin için %2$@ tarihinde kefil oldu."
          }
        },
        "uk": {
