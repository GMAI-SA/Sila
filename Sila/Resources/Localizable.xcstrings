    "rooms.speak.refusalFallback": {
      "comment": "Shown when the server refused speaking but sent no sentence of its own.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاستماع إلى هذه الغرفة، لكن لا يمكنك التحدث فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই রুম শুনতে পারবেন, কিন্তু এতে কথা বলতে পারবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots escoltar aquesta sala, però no hi pots parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto místnost můžeš poslouchat, ale nemůžeš v ní mluvit."
