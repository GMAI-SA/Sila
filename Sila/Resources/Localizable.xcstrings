    "error.invalidNationalId": {
      "comment": "400 invalid_national_id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو هذا رقم هوية وطنية أو إقامة صالحًا — تحقق من الأرقام؛ الرقم الأخير رقم تحقق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সঠিক জাতীয় পরিচয় বা Iqama নম্বর বলে মনে হচ্ছে না — সংখ্যাগুলো দেখুন; শেষ সংখ্যাটি মিলতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això no sembla un número vàlid de document d'identitat nacional o d'Iqama: revisa els dígits; l'últim ha de quadrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevypadá to jako platné číslo National ID nebo Iqama – zkontroluj číslice; poslední musí souhlasit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke et gyldigt nationalt id- eller Iqama-nummer – tjek cifrene; det sidste skal passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer gültigen National-ID- oder Iqama-Nummer aus – prüfe die Ziffern; die letzte muss stimmig sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μοιάζει με έγκυρο αριθμό National ID ή Iqama — έλεγξε τα ψηφία· το τελευταίο πρέπει να βγαίνει σωστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a valid National ID or Iqama number — check the digits; the last one must add up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece un número válido de National ID o Iqama: revisa los dígitos; el último debe cuadrar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei näytä kelvolliselta henkilökortti- tai Iqama-numerolta – tarkista numerot; viimeisen on täsmättävä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un numéro valide de carte d’identité nationale ou d’Iqama — vérifiez les chiffres ; le dernier doit être cohérent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא נראה כמו מספר תעודת זהות לאומית או Iqama תקין — בדוק את הספרות; הספרה האחרונה חייבת להסתכם נכון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मान्य राष्ट्रीय ID या Iqama नंबर नहीं लगता — अंक जाँचें; आख़िरी अंक का मेल बैठना ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To ne izgleda kao valjan broj nacionalne osobne iskaznice ili Iqame — provjeri znamenke; zadnja mora odgovarati zbroju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem tűnik érvényes személyi azonosító vagy Iqama számnak – ellenőrizd a számjegyeket; az utolsónak ki kell jönnie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak tampak seperti nomor ID Nasional atau Iqama yang valid — periksa digitnya; digit terakhir harus sesuai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un numero valido di carta d'identità nazionale o Iqama: controlla le cifre, l'ultima deve quadrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な国民IDまたはIqamaの番号ではないようです。桁を確認してください。最後の桁は検算に合う必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 신분증 번호 또는 Iqama 번호가 아닌 것 같아요. 숫자를 확인하세요. 마지막 자리는 검증 숫자와 맞아야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് സാധുവായ ദേശീയ ഐഡി അല്ലെങ്കിൽ Iqama നമ്പർ പോലെ തോന്നുന്നില്ല — അക്കങ്ങൾ പരിശോധിക്കുക; അവസാനത്തെ അക്കം ശരിയായി ഒത്തുവരണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak kelihatan seperti nombor National ID atau Iqama yang sah — semak digitnya; digit terakhir mesti tepat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette ser ikke ut som et gyldig nasjonalt ID-nummer eller Iqama-nummer. Sjekk sifrene, for det siste må stemme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat lijkt geen geldig nationaal ID- of Iqama-nummer. Controleer de cijfers; het laatste cijfer moet kloppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie wygląda na prawidłowy numer dowodu osobistego ani Iqama — sprawdź cyfry; ostatnia musi się zgadzać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um número válido de Identidade Nacional ou Iqama. Confira os dígitos; o último precisa bater."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não parece um número de Documento Nacional ou Iqama válido — verifique os dígitos; o último tem de bater certo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu pare un număr valid de National ID sau Iqama — verifică cifrele; ultima trebuie să se potrivească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не похоже на действительный номер национального ID или Iqama — проверьте цифры; последняя должна сходиться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nevyzerá ako platné číslo občianskeho preukazu alebo Iqama — skontroluj číslice; posledná musí sedieť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser inte ut som ett giltigt nationellt id-nummer eller Iqama-nummer – kontrollera siffrorna; den sista måste stämma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது சரியான தேசிய அடையாள எண் அல்லது Iqama எண் போலத் தெரியவில்லை — இலக்கங்களைச் சரிபாருங்கள்; கடைசி இலக்கம் பொருந்த வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది చెల్లుబాటు అయ్యే జాతీయ ID లేదా Iqama నంబర్‌లా లేదు — అంకెలను తనిఖీ చేయండి; చివరి అంకె సరిపోవాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูไม่เหมือนเลขบัตรประชาชนหรือเลข Iqama ที่ถูกต้อง ตรวจสอบตัวเลข หลักสุดท้ายต้องรวมกันได้ตามเกณฑ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir Ulusal Kimlik veya Iqama numarasına benzemiyor; rakamları kontrol edin, son rakam tutmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не схоже на дійсний номер Національного ID або Iqama — перевірте цифри; остання має сходитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ درست قومی شناختی کارڈ یا Iqama نمبر نہیں لگتا — ہندسے جانچیں؛ آخری ہندسہ حساب میں پورا ہونا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không giống số căn cước quốc gia hoặc Iqama hợp lệ — hãy kiểm tra các chữ số; chữ số cuối phải khớp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不是有效的国民身份证或 Iqama 号码，请检查数字，最后一位必须能通过校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不是有效的身分證或 Iqama 號碼，請檢查數字；最後一位必須相符。"
          }
        }
      }
    },
    "error.invalidPhone": {
      "comment": "The submitted phone number is not E.164.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الصيغة الدولية، تبدأ بعلامة زائد ورمز الدولة — مثل +966501234567."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আন্তর্জাতিক ফরম্যাট ব্যবহার করুন, যা একটি প্লাস ও দেশের কোড দিয়ে শুরু হয় — যেমন +966501234567।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir el format internacional, començant amb un més i un prefix de país, per exemple +966501234567."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij mezinárodní formát, začínající plusem a předvolbou země – například +966501234567."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug internationalt format med et plustegn og en landekode først – for eksempel +966501234567."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende das internationale Format mit Pluszeichen und Landesvorwahl, zum Beispiel +966501234567."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε διεθνή μορφή, που ξεκινά με συν και κωδικό χώρας — για παράδειγμα +966501234567."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use international format, starting with a plus and a country code — for example +966501234567."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el formato internacional, con un signo más y el prefijo del país; por ejemplo, +966501234567."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kansainvälistä muotoa, joka alkaa plusmerkillä ja maatunnuksella – esimerkiksi +966501234567."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le format international, avec un plus et l’indicatif du pays — par exemple +966501234567."
