    "rooms.invites.empty.message": {
      "comment": "Empty state message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يدخل أحد سواك حتى تدعو شخصًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাউকে আমন্ত্রণ না জানানো পর্যন্ত শুধু আপনিই ঢুকতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només tu pots entrar fins que convidis algú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud nikoho nepozveš, můžeš vstoupit jen ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du kan komme ind, indtil du inviterer nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du kannst hinein, bis du jemanden einlädst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο εσύ μπορείς να μπεις μέχρι να προσκαλέσεις κάποιον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can enter until you invite somebody."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú puedes entrar hasta que invites a alguien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sinä pääset sisään, kunnes kutsut jonkun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul pouvez entrer tant que vous n’invitez personne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק אתה יכול להיכנס עד שתזמין מישהו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप किसी को आमंत्रित नहीं करते, केवल आप अंदर आ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ti možeš ući dok nekoga ne pozoveš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak te léphetsz be, amíg nem hívsz meg valakit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kamu yang bisa masuk sampai kamu mengundang seseorang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu puoi entrare finché non inviti qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かを招待するまでは、あなただけが入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가를 초대하기 전에는 나만 입장할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ആരെയെങ്കിലും ക്ഷണിക്കുന്നതുവരെ നിങ്ങൾക്ക് മാത്രമേ പ്രവേശിക്കാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anda boleh masuk sehingga anda menjemput seseorang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du kan gå inn til du inviterer noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen jij kunt binnenkomen totdat je iemand uitnodigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wejść możesz tylko Ty, dopóki kogoś nie zaprosisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você pode entrar até convidar alguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você pode entrar até convidar alguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar tu poți intra până invii pe cineva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти можете только вы, пока не пригласите кого-нибудь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým nikoho nepozveš, môžeš vstúpiť iba ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara du kan gå in tills du bjuder in någon."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் யாரையாவது அழைக்கும் வரை நீங்கள் மட்டுமே நுழைய முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎవరినైనా ఆహ్వానించే వరకు మీరు మాత్రమే ప్రవేశించగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงคุณที่เข้าได้จนกว่าคุณจะเชิญใคร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini davet edene kadar yalnızca siz girebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійти можете лише ви, доки не запросите когось."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ کسی کو مدعو نہ کریں صرف آپ داخل ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn vào được cho đến khi bạn mời ai đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你邀请别人之前，只有你自己能进入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你邀請別人之前，只有你能進入。"
          }
        }
      }
    },
    "rooms.invites.empty.title": {
      "comment": "Empty state title in the guest sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم دعوة أحد بعد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কাউকে আমন্ত্রণ জানানো হয়নি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha ningú convidat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nikdo pozván"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen inviteret endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand eingeladen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει προσκληθεί κανείς ακόμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody invited yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has invitado a nadie"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketään ei ole vielä kutsuttu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’est encore invité"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא הוזמן אף אחד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी किसी को आमंत्रित नहीं किया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nitko nije pozvan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még senkit nem hívtak meg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang diundang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun invitato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰も招待していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 초대한 사람이 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെയും ക്ഷണിച്ചിട്ടില്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dijemput"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen invitert ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niemand uitgenodigd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nikogo nie zaproszono"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém convidado ainda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda ninguém convidado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ai invitat pe nimeni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока никто не приглашён"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nikto nie je pozvaný"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen inbjuden än"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் யாரும் அழைக்கப்படவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఎవరినీ ఆహ్వానించలేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เชิญใคร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kimse davet edilmedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нікого не запрошено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کسی کو مدعو نہیں کیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa mời ai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有邀请任何人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有邀請任何人"
          }
        }
      }
    },
    "rooms.invites.explanation": {
      "comment": "Explanation at the top of the guest sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدخل سوى هؤلاء. سحب الدعوة يمنع الانضمام لاحقًا، ولا يُخرج من هو موجود الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই মানুষেরা ঢুকতে পারে। আমন্ত্রণ প্রত্যাহার করলে কেউ পরে যোগ দিতে পারে না — যে ইতিমধ্যে ভেতরে আছে তাকে সরায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només aquestes persones hi poden entrar. Retirar una invitació impedeix que algú s'hi uneixi més tard, però no expulsa ningú que ja hi sigui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstoupit mohou jen tito lidé. Odvoláním pozvánky zabráníš někomu připojit se později – neodebere to nikoho, kdo už je uvnitř."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun disse folk kan komme ind. Hvis du trækker en invitation tilbage, kan vedkommende ikke komme ind senere – men den fjerner ikke dem, der allerede er her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Personen können hinein. Das Zurückziehen einer Einladung verhindert späteren Beitritt – es entfernt niemanden, der schon hier ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αυτά τα άτομα μπορούν να μπουν. Η ανάκληση μιας πρόσκλησης εμποδίζει κάποιον να μπει αργότερα — δεν αφαιρεί όποιον είναι ήδη εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these people can enter. Withdrawing an invitation stops someone joining later — it does not remove anyone who is already here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo estas personas pueden entrar. Retirar una invitación impide que alguien se una más tarde; no expulsa a quien ya está dentro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain nämä ihmiset pääsevät sisään. Kutsun peruminen estää liittymisen myöhemmin – se ei poista ketään, joka on jo paikalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules ces personnes peuvent entrer. Retirer une invitation empêche quelqu’un de rejoindre plus tard — cela ne retire personne qui est déjà là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק האנשים האלה יכולים להיכנס. ביטול הזמנה מונע ממישהו להצטרף מאוחר יותר — הוא לא מסיר מי שכבר כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल यही लोग अंदर आ सकते हैं। आमंत्रण वापस लेने से कोई बाद में जुड़ नहीं पाएगा — जो पहले से यहाँ है उसे हटाया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ti ljudi mogu ući. Povlačenje pozivnice sprječava kasnije pridruživanje — ne uklanja nikoga tko je već ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ők léphetnek be. A meghívó visszavonása megakadályozza, hogy valaki később csatlakozzon – a már bent lévőket nem távolítja el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang-orang ini yang bisa masuk. Menarik undangan menghentikan seseorang bergabung nanti — tidak mengeluarkan siapa pun yang sudah ada di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo queste persone possono entrare. Ritirare un invito impedisce a qualcuno di unirsi più tardi, ma non rimuove chi è già dentro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れるのはこの人たちだけです。招待を取り消すと、あとから参加できなくなりますが、すでに入っている人は退室になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람들만 입장할 수 있어요. 초대를 철회하면 나중에 참여하지 못하지만, 이미 들어와 있는 사람은 내보내지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവർക്ക് മാത്രമേ പ്രവേശിക്കാനാകൂ. ക്ഷണം പിൻവലിച്ചാൽ പിന്നീട് ചേരുന്നത് തടയും — ഇപ്പോൾ അകത്തുള്ളവരെ അത് നീക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang ini boleh masuk. Menarik balik jemputan menghalang seseorang menyertai kemudian — ia tidak mengalih keluar sesiapa yang sudah berada di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare disse folkene kan komme inn. Å trekke tilbake en invitasjon hindrer noen i å bli med senere, men fjerner ikke dem som allerede er her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen deze mensen kunnen binnenkomen. Een uitnodiging intrekken voorkomt dat iemand later meedoet; het verwijdert niemand die er al is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wejść mogą tylko te osoby. Wycofanie zaproszenia uniemożliwia dołączenie w przyszłości — nie usuwa nikogo, kto już tu jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só estas pessoas podem entrar. Retirar um convite impede que alguém entre depois, mas não remove quem já está aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só estas pessoas podem entrar. Retirar um convite impede alguém de entrar mais tarde — não remove ninguém que já esteja aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar aceste persoane pot intra. Retragerea unei invitații oprește pe cineva să se alăture mai târziu — nu scoate pe nimeni care este deja aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти могут только эти люди. Отзыв приглашения не даст человеку присоединиться позже — но не удалит тех, кто уже здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstúpiť môžu iba títo ľudia. Odvolanie pozvánky zabráni niekomu pripojiť sa neskôr — neodstráni nikoho, kto už tu je."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara dessa personer kan gå in. Att dra tillbaka en inbjudan hindrar någon från att gå med senare – den tar inte bort någon som redan är här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவர்கள் மட்டுமே நுழையலாம். அழைப்பைத் திரும்பப் பெற்றால் பின்னர் ஒருவர் சேர்வது நிற்கும் — ஏற்கெனவே உள்ளே இருப்பவரை அது நீக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వ్యక్తులు మాత్రమే ప్రవేశించగలరు. ఆహ్వానాన్ని ఉపసంహరిస్తే తర్వాత ఎవరైనా చేరడం ఆగుతుంది — ఇప్పటికే ఇక్కడ ఉన్నవారు తొలగించబడరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนเหล่านี้เท่านั้นที่เข้าได้ การถอนคำเชิญจะหยุดคนที่จะเข้ามาภายหลัง แต่ไม่ได้นำคนที่อยู่ในห้องแล้วออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu kişiler girebilir. Daveti geri çekmek, birinin sonradan katılmasını engeller; zaten burada olanı çıkarmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійти можуть лише ці люди. Скасування запрошення не дає людині приєднатися пізніше — але не вилучає тих, хто вже тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف یہی لوگ داخل ہو سکتے ہیں۔ دعوت واپس لینے سے کوئی بعد میں شامل نہیں ہو سکتا — جو پہلے سے یہاں ہے اسے ہٹایا نہیں جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người này vào được. Rút lời mời sẽ ngăn ai đó tham gia sau — nhưng không xóa người đã ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这些人可以进入。撤回邀请可阻止对方之后加入，但不会移除已经在场的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這些人能進入。撤回邀請可阻止對方之後加入，但不會移除已在場的人。"
          }
        }
      }
    },
