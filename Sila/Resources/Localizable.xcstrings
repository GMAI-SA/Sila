          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz olyan közönséget, amelyhez szobát nyithatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih audiens yang bisa kamu bukakan room."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un pubblico per cui puoi aprire una stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームを開ける範囲を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸을 열 수 있는 대상을 선택하세요."
          }
        },
        "ml": {
