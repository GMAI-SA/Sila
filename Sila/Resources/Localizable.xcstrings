        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine o poate citi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать может любой"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítať ho môže každý"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kan läsa det"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லோரும் படிக்கலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా చదవగలరు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes okuyabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читати може кожен"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کوئی پڑھ سکتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng đọc được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人都能阅读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人都能閱讀"
          }
        }
      }
    },
    "composer.scope.international.a11yLabel": {
      "comment": "VoiceOver label for the international audience row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دولي. أي حساب موثّق في أي مكان يمكنه الرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আন্তর্জাতিক। যেকোনো জায়গার যেকোনো ভেরিফায়েড অ্যাকাউন্ট উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Internacional. Qualsevol compte verificat de qualsevol lloc hi pot respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezinárodní. Odpovídat může jakýkoli ověřený účet kdekoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "International. Enhver verificeret konto overalt kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "International. Jedes verifizierte Konto überall kann antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διεθνές. Οποιοσδήποτε επαληθευμένος λογαριασμός οπουδήποτε μπορεί να απαντήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "International. Any verified account anywhere can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Internacional. Cualquier cuenta verificada de cualquier lugar puede responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansainvälinen. Mikä tahansa vahvistettu tili missä tahansa voi vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "International. Tout compte vérifié, où qu’il soit, peut répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בינלאומי. כל חשבון מאומת בכל מקום יכול להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतरराष्ट्रीय। कहीं का भी कोई सत्यापित अकाउंट जवाब दे सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Međunarodno. Odgovoriti može bilo koji potvrđeni račun bilo gdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemzetközi. Bármely hitelesített fiók bárhonnan válaszolhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Internasional. Akun terverifikasi mana pun di mana pun bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Internazionale. Qualsiasi account verificato, ovunque, può rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国際。世界中のどの認証済みアカウントでも返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국제. 어디서든 인증된 계정이면 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അന്താരാഷ്ട്രം. എവിടെയുമുള്ള ഏതൊരു പരിശോധിച്ച അക്കൗണ്ടിനും മറുപടി നൽകാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Antarabangsa. Mana-mana akaun yang disahkan di mana-mana sahaja boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Internasjonalt. Alle verifiserte kontoer hvor som helst kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationaal. Elk geverifieerd account, waar ook ter wereld, kan reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Międzynarodowo. Odpowiedzieć może każde zweryfikowane konto na świecie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Internacional. Qualquer conta verificada em qualquer lugar pode responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Internacional. Qualquer conta verificada em qualquer lugar pode responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Internațional. Orice cont verificat de oriunde poate răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Международный. Отвечать может любой проверенный аккаунт в любой стране."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzinárodné. Odpovedať môže ktorýkoľvek overený účet kdekoľvek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationellt. Alla verifierade konton var som helst kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சர்வதேசம். உலகில் எங்குள்ள சரிபார்க்கப்பட்ட கணக்கும் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతర్జాతీయం. ఎక్కడి నుండైనా ధృవీకరించబడిన ఏ ఖాతా అయినా రిప్లై ఇవ్వగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับนานาชาติ บัญชีที่ยืนยันตัวตนแล้วจากที่ไหนก็ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uluslararası. Dünyanın her yerinden doğrulanmış her hesap yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міжнародний. Відповідати може будь-який верифікований обліковий запис будь-де."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بین الاقوامی۔ کہیں کا بھی کوئی تصدیق شدہ اکاؤنٹ جواب دے سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc tế. Mọi tài khoản đã xác minh ở bất cứ đâu đều trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际。世界各地任何已验证的账户都可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國際。世界各地任何已驗證的帳號都能回覆。"
          }
        }
      }
    },
