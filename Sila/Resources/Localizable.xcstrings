    "communities.empty.forYou.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أول واحد، وسينضم إليه الناس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমটি খুলুন, তাহলে মানুষ যোগ দিতে পারবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la primera i la gent s'hi podrà unir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři první a lidé se mohou připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn det første, så kan folk blive medlemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eröffne die erste, und andere können beitreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την πρώτη και οι άλλοι μπορούν να συμμετάσχουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the first one, and people can join it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la primera y la gente podrá unirse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perusta ensimmäinen, niin ihmiset voivat liittyä siihen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la première, et les gens pourront la rejoindre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את הראשונה, ואנשים יוכלו להצטרף אליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली कम्युनिटी शुरू करें, फिर लोग इससे जुड़ सकेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori prvu, pa joj se ljudi mogu pridružiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg az elsőt, és az emberek csatlakozhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka yang pertama, dan orang bisa bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprine una per prima e le persone potranno unirsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のコミュニティを開設すれば、人が参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 커뮤니티를 열면 사람들이 가입할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യത്തേത് തുടങ്ങുക, ആളുകൾക്ക് ചേരാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka yang pertama, dan orang boleh menyertainya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett det første, så kan folk bli med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de eerste, dan kunnen mensen lid worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz pierwszą, a ludzie będą mogli do niej dołączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a primeira, e as pessoas poderão entrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a primeira, e as pessoas poderão entrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide prima, ca oamenii să i se poată alătura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте первое, и люди смогут вступить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvor prvú a ľudia sa k nej budú môcť pripojiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna den första så kan folk gå med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலாவதைத் தொடங்குங்கள், மக்கள் சேரலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదటిదాన్ని ప్రారంభించండి, ప్రజలు చేరగలరు."
