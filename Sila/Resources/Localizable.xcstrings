    "video.error.notAvailable": {
      "comment": "403 video_not_allowed, reason not_available (contract v28 §10).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشر الفيديو غير متاح بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও পোস্ট এখনও পাওয়া যাচ্ছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions de vídeo encara no estan disponibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videopříspěvky zatím nejsou dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoopslag er ikke tilgængelige endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videobeiträge sind noch nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις βίντεο δεν είναι ακόμα διαθέσιμες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video posts aren't available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones con vídeo aún no están disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Videojulkaisut eivät ole vielä käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts vidéo ne sont pas encore disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטי וידאו עדיין לא זמינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो पोस्ट अभी उपलब्ध नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video objave još nisu dostupne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videós bejegyzések még nem érhetők el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan video belum tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post video non sono ancora disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の投稿はまだ利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 게시물은 아직 사용할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീഡിയോ പോസ്റ്റുകൾ ഇതുവരെ ലഭ്യമല്ല."
