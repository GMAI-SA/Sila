            "value": "Je to osoba, ktorú si mal na mysli?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är det här den du menade?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் குறிப்பிட்டது இவரையா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఉద్దేశించిన వ్యక్తి ఇతనేనా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช่คนที่คุณหมายถึงไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastettiğiniz kişi bu mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це та людина, яку ви мали на увазі?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا یہی وہ ہیں جو آپ کا مطلب تھا؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây có phải người bạn muốn nói không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你指的那个人吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你指的人嗎？"
          }
        }
      }
    },
