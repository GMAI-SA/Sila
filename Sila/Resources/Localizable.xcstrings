    "auth.rejected.reason.nationalityMismatch": {
      "comment": "Rejection reason: the document contradicted the declared nationality.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجنسية في الهوية التي قدّمتها لا تطابق الجنسية التي اخترتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে পরিচয়পত্র দেখিয়েছেন তার জাতীয়তা আপনার বেছে নেওয়া জাতীয়তার সাথে মেলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La nacionalitat de la identitat que has presentat no coincideix amb la que has seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Státní příslušnost na předloženém dokladu se neshoduje s tou, kterou jsi vybral."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nationaliteten på det id, du viste, svarer ikke til den nationalitet, du valgte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Staatsangehörigkeit im vorgelegten Ausweis stimmt nicht mit der von dir gewählten überein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηκοότητα στην ταυτότητα που υπέβαλες δεν ταιριάζει με την υπηκοότητα που επέλεξες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nationality on the identity you presented does not match the nationality you selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nacionalidad de la identidad que presentaste no coincide con la que seleccionaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittämäsi henkilöllisyyden kansalaisuus ei vastaa valitsemaasi kansalaisuutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nationalité figurant sur l’identité présentée ne correspond pas à celle que vous avez sélectionnée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזרחות בזהות שהצגת אינה תואמת לאזרחות שבחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दिखाए गए पहचान दस्तावेज़ पर राष्ट्रीयता आपकी चुनी हुई राष्ट्रीयता से मेल नहीं खाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Državljanstvo na predočenoj ispravi ne podudara se s državljanstvom koje si odabrao/odabrala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemutatott okmányon szereplő állampolgárság nem egyezik a kiválasztott állampolgársággal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan pada identitas yang kamu tunjukkan tidak cocok dengan kewarganegaraan yang kamu pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nazionalità sul documento presentato non corrisponde a quella che hai selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提示された身分証明書の国籍が、選択された国籍と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출한 신분증의 국적이 선택한 국적과 일치하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സമർപ്പിച്ച തിരിച്ചറിയൽ രേഖയിലെ പൗരത്വം നിങ്ങൾ തിരഞ്ഞെടുത്ത പൗരത്വവുമായി ഒത്തുപോകുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan pada identiti yang anda kemukakan tidak sepadan dengan kewarganegaraan yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasjonaliteten på legitimasjonen du la fram, stemmer ikke med nasjonaliteten du valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nationaliteit op het identiteitsbewijs dat je hebt getoond komt niet overeen met de nationaliteit die je hebt gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obywatelstwo z okazanego dokumentu tożsamości nie zgadza się z wybranym przez Ciebie obywatelstwem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nacionalidade na identidade apresentada não corresponde à nacionalidade que você selecionou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nacionalidade na identidade que apresentou não corresponde à nacionalidade que selecionou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetățenia de pe actul prezentat nu coincide cu cea selectată de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гражданство в предъявленном документе не совпадает с выбранным вами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štátna príslušnosť na predloženom doklade sa nezhoduje so štátnou príslušnosťou, ktorú si vybral."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nationaliteten på identiteten du visade stämmer inte med nationaliteten du valde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காட்டிய அடையாளத்தில் உள்ள குடியுரிமை, நீங்கள் தேர்ந்தெடுத்த குடியுரிமையுடன் பொருந்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమర్పించిన గుర్తింపులోని జాతీయత, మీరు ఎంచుకున్న జాతీయతతో సరిపోలడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญชาติบนเอกสารยืนยันตัวตนที่คุณแสดงไม่ตรงกับสัญชาติที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunduğunuz kimlikteki uyruk, seçtiğiniz uyrukla eşleşmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Громадянство в наданому документі не збігається з тим, яке ви вибрали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پیش کردہ شناخت پر قومیت آپ کی منتخب کردہ قومیت سے نہیں ملتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc tịch trên giấy tờ bạn xuất trình không khớp với quốc tịch bạn đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身份证件上的国籍与你选择的国籍不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身分證件上的國籍，與你選擇的國籍不符。"
          }
        }
      }
    },
    "auth.rejected.reason.noFace": {
      "comment": "Rejection reason `no_face` from the document pre-screen (contract v25). The server's decision-email sentence, word for word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورتك الذاتية لا تُظهر وجهاً. التقطها مرة أخرى وأنت تنظر إلى الكاميرا، وأرسلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেলফিতে কোনো মুখ দেখা যাচ্ছে না। ক্যামেরার দিকে তাকিয়ে আবার সেলফি তুলুন এবং আবার জমা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu selfie no mostra cap cara. Torna a fer el selfie mirant a la càmera i torna-ho a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvém selfie není vidět obličej. Pořiď selfie znovu, dívej se do fotoaparátu, a odešli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din selfie viser ikke et ansigt. Tag selfien igen med blikket mod kameraet, og send igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Selfie ist kein Gesicht zu sehen. Nimm das Selfie erneut auf, sieh dabei in die Kamera, und sende es noch einmal ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η selfie σου δεν δείχνει πρόσωπο. Τράβηξε ξανά selfie κοιτώντας την κάμερα και υπέβαλέ την ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selfie does not show a face. Take the selfie again, looking at the camera, and submit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selfie no muestra un rostro. Hazte el selfie de nuevo, mirando a la cámara, y envíalo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfiessäsi ei näy kasvoja. Ota selfie uudelleen katsoen kameraan ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre selfie ne montre pas de visage. Reprenez le selfie en regardant l’appareil photo, puis renvoyez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסלפי שלך לא מראה פנים. צלם את הסלפי שוב, כשאתה מביט למצלמה, ושלח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेल्फ़ी में चेहरा नहीं दिखता। कैमरे की ओर देखते हुए दोबारा सेल्फ़ी लें और फिर से सबमिट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvom selfieju nema lica. Ponovno se slikaj gledajući u kameru i pošalji ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szelfiden nem látszik arc. Készíts új szelfit a kamerába nézve, és küldd be újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie-mu tidak menampakkan wajah. Ambil selfie lagi sambil menatap kamera, lalu kirim ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo selfie non mostra un volto. Scatta di nuovo il selfie guardando la fotocamera e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自撮りに顔が写っていません。カメラを見て自撮りを撮り直し、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀카에 얼굴이 보이지 않아요. 카메라를 보고 셀카를 다시 찍어 제출해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സെൽഫിയിൽ മുഖം കാണുന്നില്ല. ക്യാമറയിലേക്ക് നോക്കി വീണ്ടും സെൽഫി എടുത്ത് വീണ്ടും സമർപ്പിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Swafoto anda tidak menunjukkan wajah. Ambil swafoto semula sambil memandang kamera, dan hantar semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfien din viser ikke et ansikt. Ta selfien på nytt mens du ser mot kameraet, og send inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je selfie is geen gezicht te zien. Maak de selfie opnieuw, kijk in de camera en verstuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Twoim selfie nie widać twarzy. Zrób selfie jeszcze raz, patrząc w aparat, i wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua selfie não mostra um rosto. Tire a selfie de novo, olhando para a câmera, e envie novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua selfie não mostra um rosto. Tire a selfie novamente, a olhar para a câmara, e submeta de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie-ul tău nu arată o față. Fă din nou selfie-ul, privind spre cameră, și trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем селфи не видно лица. Сделайте селфи снова, глядя в камеру, и отправьте заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvojom selfie nie je vidieť tvár. Odfoť selfie znova, pozeraj sa do fotoaparátu, a odošli ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt ansikte syns inte på selfien. Ta en ny selfie med blicken mot kameran och skicka in igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் செல்ஃபியில் முகம் தெரியவில்லை. கேமராவைப் பார்த்து மீண்டும் செல்ஃபி எடுத்து மறுபடி சமர்ப்பியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సెల్ఫీలో ముఖం కనిపించడం లేదు. కెమెరా వైపు చూస్తూ సెల్ఫీని మళ్లీ తీసి, మళ్లీ సమర్పించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซลฟีของคุณไม่เห็นใบหน้า ถ่ายเซลฟีอีกครั้งโดยมองที่กล้อง แล้วส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie'nizde yüz görünmüyor. Kameraya bakarak selfie'yi yeniden çekin ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому селфі не видно обличчя. Зробіть селфі ще раз, дивлячись у камеру, і надішліть знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی سیلفی میں چہرہ نظر نہیں آتا۔ کیمرے کی طرف دیکھتے ہوئے دوبارہ سیلفی لیں اور دوبارہ جمع کرائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh selfie của bạn không thấy khuôn mặt. Hãy chụp lại selfie, nhìn vào camera, rồi gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的自拍中没有出现人脸。请看着镜头重新自拍，然后再次提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的自拍中沒有出現人臉。請看著鏡頭重新自拍，然後再次送出。"
          }
        }
      }
    },
    "auth.rejected.reason.notADocument": {
      "comment": "Rejection reason `not_a_document` from the document pre-screen (contract v25). The server's decision-email sentence, word for word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة التي أرسلتها على أنها وثيقة الهوية لا تُظهر وثيقة هوية. صوّر الوثيقة نفسها — صفحة الصورة في جوازك أو بطاقة هويتك — وأرسلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয়পত্র হিসেবে আপনি যে ছবি পাঠিয়েছেন তাতে কোনো পরিচয়পত্র দেখা যাচ্ছে না। নথিটির নিজেরই ছবি তুলুন — আপনার পাসপোর্টের ছবিওয়ালা পাতা বা আইডি কার্ড — এবং আবার জমা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La imatge que has enviat com a document d'identitat no mostra cap document d'identitat. Fotografia el document en si (la pàgina de la foto del passaport o el DNI) i torna-ho a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek, který jsi poslal jako doklad, doklad nezobrazuje. Vyfotografuj přímo doklad – stranu s fotografií v pasu nebo občanský průkaz – a odešli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet, du sendte som dit id-dokument, viser ikke et id-dokument. Fotografér selve dokumentet – din pas-datoside eller dit id-kort – og send igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild, das du als Ausweisdokument gesendet hast, zeigt kein Ausweisdokument. Fotografiere das Dokument selbst – die Fotoseite deines Reisepasses oder deinen Personalausweis – und sende es erneut ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα που έστειλες ως έγγραφο ταυτότητας δεν δείχνει έγγραφο ταυτότητας. Φωτογράφισε το ίδιο το έγγραφο — τη σελίδα με τη φωτογραφία του διαβατηρίου σου ή την ταυτότητά σου — και υπέβαλέ το ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture you sent as your identity document does not show an identity document. Photograph the document itself — your passport's photo page or your ID card — and submit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen que enviaste como documento de identidad no muestra ningún documento de identidad. Fotografía el propio documento (la página de la foto de tu pasaporte o tu tarjeta de identidad) y envíalo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyysasiakirjaksi lähettämässäsi kuvassa ei näy henkilöllisyysasiakirjaa. Kuvaa itse asiakirja – passin kuvasivu tai henkilökorttisi – ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image envoyée comme document d’identité ne montre pas de document d’identité. Photographiez le document lui-même — la page photo de votre passeport ou votre carte d’identité — puis renvoyez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה ששלחת כמסמך זהות לא מראה מסמך זהות. צלם את המסמך עצמו — עמוד התמונה בדרכון או תעודת הזהות — ושלח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान दस्तावेज़ के रूप में आपकी भेजी तस्वीर में कोई पहचान दस्तावेज़ नहीं दिखता। दस्तावेज़ की ही फ़ोटो लें — आपके पासपोर्ट का फ़ोटो वाला पन्ना या आपका ID कार्ड — और फिर से सबमिट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika koju si poslao/poslala kao ispravu ne prikazuje ispravu. Fotografiraj samu ispravu — stranicu s fotografijom iz putovnice ili osobnu iskaznicu — i pošalji ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azonosító okmányként küldött képen nem azonosító okmány látható. Magát az okmányt fényképezd le – az útleveled fotóoldalát vagy a személyi igazolványodat –, és küldd be újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar yang kamu kirim sebagai dokumen identitas tidak menampakkan dokumen identitas. Fotolah dokumennya langsung — halaman foto paspor atau kartu identitasmu — lalu kirim ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine inviata come documento d'identità non mostra un documento d'identità. Fotografa il documento stesso, la pagina con la foto del passaporto o la carta d'identità, e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身分証明書として送られた画像に、身分証明書が写っていません。パスポートの写真ページやIDカードなど、書類そのものを撮影して、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증으로 보낸 사진에 신분증이 보이지 않아요. 여권의 사진 페이지나 신분증 카드 등 문서 자체를 촬영해서 다시 제출해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരിച്ചറിയൽ രേഖയായി നിങ്ങൾ അയച്ച ചിത്രത്തിൽ ഒരു തിരിച്ചറിയൽ രേഖ കാണുന്നില്ല. രേഖയുടെ തന്നെ ഫോട്ടോ എടുക്കുക — പാസ്‌പോർട്ടിന്റെ ഫോട്ടോ പേജ് അല്ലെങ്കിൽ ഐഡി കാർഡ് — എന്നിട്ട് വീണ്ടും സമർപ്പിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar yang anda hantar sebagai dokumen identiti tidak menunjukkan dokumen identiti. Potret dokumen itu sendiri — halaman foto pasport atau kad pengenalan anda — dan hantar semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet du sendte som legitimasjon, viser ikke et legitimasjonsdokument. Ta bilde av selve dokumentet, passsiden med bildet eller ID-kortet, og send inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto die je als identiteitsbewijs hebt gestuurd toont geen identiteitsbewijs. Fotografeer het document zelf, de fotopagina van je paspoort of je identiteitskaart, en verstuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie wysłane jako dokument tożsamości nie przedstawia dokumentu tożsamości. Sfotografuj sam dokument — stronę ze zdjęciem w paszporcie lub dowód osobisty — i wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem que você enviou como documento de identidade não mostra um documento de identidade. Fotografe o próprio documento (a página da foto do passaporte ou o seu RG) e envie novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem que enviou como documento de identificação não mostra um documento de identificação. Fotografe o próprio documento — a página da fotografia do passaporte ou o cartão de cidadão — e submeta de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea trimisă ca act de identitate nu arată un act de identitate. Fotografiază chiar documentul — pagina cu fotografia din pașaport sau cartea de identitate — și trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На фото, отправленном как документ, нет документа. Сфотографируйте сам документ — страницу паспорта с фото или ID-карту — и отправьте заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázok, ktorý si poslal ako doklad totožnosti, doklad totožnosti nezobrazuje. Odfoť samotný doklad — stranu s fotografiou v pase alebo občiansky preukaz — a odošli ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden du skickade som id-dokument visar inget id-dokument. Fotografera själva dokumentet – passets fotosida eller ditt id-kort – och skicka in igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடையாள ஆவணமாக நீங்கள் அனுப்பிய படத்தில் அடையாள ஆவணம் இல்லை. ஆவணத்தையே — உங்கள் பாஸ்போர்ட்டின் புகைப்பக்கம் அல்லது அடையாள அட்டையை — படம் எடுத்து மறுபடி சமர்ப்பியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపు పత్రంగా మీరు పంపిన చిత్రంలో గుర్తింపు పత్రం కనిపించడం లేదు. పత్రాన్నే ఫోటో తీయండి — మీ పాస్‌పోర్ట్‌లోని ఫోటో పేజీ లేదా మీ ID కార్డ్ — మళ్లీ సమర్పించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่คุณส่งเป็นเอกสารยืนยันตัวตนไม่ใช่เอกสารยืนยันตัวตน ถ่ายรูปตัวเอกสารเอง คือหน้ารูปของหนังสือเดินทางหรือบัตรประจำตัว แล้วส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik belgesi olarak gönderdiğiniz resimde bir kimlik belgesi görünmüyor. Belgenin kendisini (pasaportunuzun fotoğraf sayfasını veya kimlik kartınızı) fotoğraflayın ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення, яке ви надіслали як документ, не є документом, що посвідчує особу. Сфотографуйте сам документ — сторінку з фото в паспорті або ID-картку — і надішліть знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے شناختی دستاویز کے طور پر جو تصویر بھیجی اس میں کوئی شناختی دستاویز نظر نہیں آتا۔ خود دستاویز کی تصویر لیں — اپنے پاسپورٹ کا تصویر والا صفحہ یا شناختی کارڈ — اور دوبارہ جمع کرائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh bạn gửi làm giấy tờ tùy thân không phải là giấy tờ tùy thân. Hãy chụp chính giấy tờ — trang ảnh của hộ chiếu hoặc thẻ căn cước — rồi gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你作为身份证件发送的图片中没有身份证件。请拍摄证件本身，即护照的照片页或身份证，然后再次提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你作為身分證件送出的圖片並不是身分證件。請拍攝證件本身，例如護照的照片頁或身分證，然後再次送出。"
          }
        }
      }
    },
    "auth.rejected.reason.notGenuine": {
      "comment": "Rejection reason `not_genuine` from the document pre-screen (contract v25). The server's decision-email sentence, word for word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوثيقة التي أرسلتها ليست وثيقة هوية حقيقية — بل نموذج أو عيّنة أو لقطة شاشة أو رسم. صوّر وثيقتك أنت وأرسلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাঠানো নথিটি আসল পরিচয়পত্র নয় — এটি একটি নমুনা, স্ক্রিনশট বা আঁকা ছবি। নিজের নথির ছবি তুলে আবার জমা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El document que has enviat no és un document d'identitat autèntic: és un model, una mostra, una captura de pantalla o un dibuix. Fotografia el teu propi document i torna-ho a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslaný doklad není pravý doklad totožnosti – je to vzor, ukázka, snímek obrazovky nebo kresba. Vyfotografuj svůj vlastní doklad a odešli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet, du sendte, er ikke et ægte id-dokument – det er en prøve, et eksempel, et skærmbillede eller en tegning. Fotografér dit eget dokument, og send igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesendete Dokument ist kein echtes Ausweisdokument – es ist ein Muster, eine Vorlage, ein Screenshot oder eine Zeichnung. Fotografiere dein eigenes Dokument und sende es erneut ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το έγγραφο που έστειλες δεν είναι γνήσιο έγγραφο ταυτότητας — είναι δείγμα, υπόδειγμα, στιγμιότυπο οθόνης ή σχέδιο. Φωτογράφισε το δικό σου έγγραφο και υπέβαλέ το ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document you sent is not a genuine identity document — it is a specimen, a sample, a screenshot or a drawing. Photograph your own document and submit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento que enviaste no es un documento de identidad auténtico: es un espécimen, una muestra, una captura de pantalla o un dibujo. Fotografía tu propio documento y envíalo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettämäsi asiakirja ei ole aito henkilöllisyysasiakirja – se on näyte, malli, kuvakaappaus tai piirros. Kuvaa oma asiakirjasi ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document envoyé n’est pas un véritable document d’identité — c’est un spécimen, un exemple, une capture d’écran ou un dessin. Photographiez votre propre document puis renvoyez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמך ששלחת אינו מסמך זהות אמיתי — זו דוגמה, תצלום מסך או ציור. צלם את המסמך שלך ושלח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका भेजा दस्तावेज़ असली पहचान दस्तावेज़ नहीं है — वह नमूना, सैंपल, स्क्रीनशॉट या ड्रॉइंग है। अपने ही दस्तावेज़ की फ़ोटो लें और फिर से सबमिट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprava koju si poslao/poslala nije izvorna — riječ je o uzorku, primjerku, snimci zaslona ili crtežu. Fotografiraj svoju ispravu i pošalji ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beküldött okmány nem valódi azonosító okmány – mintapéldány, minta, képernyőkép vagy rajz. Fényképezd le a saját okmányodat, és küldd be újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen yang kamu kirim bukan dokumen identitas asli — melainkan spesimen, contoh, tangkapan layar, atau gambar. Fotolah dokumen milikmu sendiri lalu kirim ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento inviato non è un documento d'identità autentico: è uno specimen, un campione, uno screenshot o un disegno. Fotografa il tuo documento e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送られた書類は本物の身分証明書ではありません。見本、サンプル、スクリーンショット、または絵のようです。ご自身の書類を撮影して、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 문서는 실제 신분증이 아니에요. 견본, 샘플, 스크린샷 또는 그림이에요. 본인의 실제 문서를 촬영해서 다시 제출해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അയച്ച രേഖ യഥാർഥ തിരിച്ചറിയൽ രേഖയല്ല — അത് മാതൃക, സാമ്പിൾ, സ്ക്രീൻഷോട്ട് അല്ലെങ്കിൽ ചിത്രരചന ആണ്. നിങ്ങളുടെ സ്വന്തം രേഖയുടെ ഫോട്ടോ എടുത്ത് വീണ്ടും സമർപ്പിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen yang anda hantar bukan dokumen identiti tulen — ia spesimen, contoh, tangkapan skrin atau lukisan. Potret dokumen anda sendiri dan hantar semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet du sendte, er ikke ekte legitimasjon. Det er et eksemplar, en prøve, et skjermbilde eller en tegning. Ta bilde av ditt eget dokument og send inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het document dat je hebt gestuurd is geen echt identiteitsbewijs: het is een specimen, een voorbeeld, een screenshot of een tekening. Fotografeer je eigen document en verstuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłany dokument nie jest prawdziwym dokumentem tożsamości — to wzór, próbka, zrzut ekranu lub rysunek. Sfotografuj własny dokument i wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento enviado não é um documento de identidade genuíno: é um espécime, um modelo, uma captura de tela ou um desenho. Fotografe o seu próprio documento e envie novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento que enviou não é um documento de identificação genuíno — é um espécime, uma amostra, uma captura de ecrã ou um desenho. Fotografe o seu próprio documento e submeta de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentul trimis nu este un act de identitate autentic — este un specimen, un eșantion, o captură de ecran sau un desen. Fotografiază propriul act și trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленный документ не является подлинным: это образец, макет, скриншот или рисунок. Сфотографируйте свой настоящий документ и отправьте заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklad, ktorý si poslal, nie je pravý doklad totožnosti — je to vzorka, ukážka, snímka obrazovky alebo kresba. Odfoť svoj vlastný doklad a odošli ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet du skickade är inget äkta id-dokument – det är ett provexemplar, en skärmbild eller en teckning. Fotografera ditt eget dokument och skicka in igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனுப்பிய ஆவணம் உண்மையான அடையாள ஆவணம் அல்ல — அது மாதிரி, ஸ்கிரீன்ஷாட் அல்லது வரைபடம். உங்கள் சொந்த ஆவணத்தைப் படம் எடுத்து மறுபடி சமர்ப்பியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు పంపిన పత్రం నిజమైన గుర్తింపు పత్రం కాదు — అది నమూనా, స్క్రీన్‌షాట్ లేదా చిత్రం. మీ స్వంత పత్రాన్ని ఫోటో తీసి మళ్లీ సమర్పించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารที่คุณส่งไม่ใช่เอกสารยืนยันตัวตนของจริง แต่เป็นตัวอย่าง ภาพจำลอง ภาพหน้าจอ หรือภาพวาด ถ่ายรูปเอกสารของคุณเองแล้วส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğiniz belge gerçek bir kimlik belgesi değil; bir örnek, numune, ekran görüntüsü veya çizim. Kendi belgenizi fotoğraflayın ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надісланий документ не є справжнім документом, що посвідчує особу, — це зразок, макет, знімок екрана або малюнок. Сфотографуйте власний документ і надішліть знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا بھیجا ہوا دستاویز اصلی شناختی دستاویز نہیں ہے — یہ نمونہ، اسکرین شاٹ یا ڈرائنگ ہے۔ اپنے ہی دستاویز کی تصویر لیں اور دوبارہ جمع کرائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy tờ bạn gửi không phải giấy tờ tùy thân thật — đó là bản mẫu, bản minh họa, ảnh chụp màn hình hoặc hình vẽ. Hãy chụp giấy tờ của chính bạn rồi gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送的不是真实的身份证件，而是样本、示例、截图或绘图。请拍摄你自己的证件，然后再次提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你送出的證件不是真正的身分證件，而是樣本、範例、螢幕截圖或繪圖。請拍攝你自己的證件，然後再次送出。"
          }
        }
      }
    },
    "auth.rejected.reason.underMinimumAge": {
      "comment": "Rejection reason: under the minimum age.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهوية التي قدّمتها دون الحد الأدنى للعمر في «معروف»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে পরিচয় দেখিয়েছেন তা Known-এর ন্যূনতম বয়সের চেয়ে কম।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La identitat que has presentat és d'una persona menor de l'edat mínima per a Known."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předložená totožnost patří osobě mladší, než je minimální věk pro aplikaci Known."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den identitet, du viste, er under mindstealderen for Known."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorgelegte Identität liegt unter dem Mindestalter für Known."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτότητα που υπέβαλες ανήκει σε άτομο κάτω από την ελάχιστη ηλικία για το Known."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity you presented is under the minimum age for Known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad que presentaste no alcanza la edad mínima para usar Known."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittämäsi henkilöllisyyden haltija on alle Knownin ikärajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité présentée est en dessous de l’âge minimum requis pour Known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזהות שהצגת היא מתחת לגיל המינימום ב-Known."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दिखाए गए पहचान दस्तावेज़ के अनुसार आपकी उम्र Known की न्यूनतम आयु से कम है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba na predočenoj ispravi mlađa je od najmanje dobi za aplikaciju Known."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemutatott személy a Known minimális korhatára alatt van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas yang kamu tunjukkan berada di bawah usia minimum untuk Known."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identità presentata è sotto l'età minima per usare Known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提示された身分証明書の年齢が、Knownの最低年齢に達していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출한 신분증의 나이가 Known의 최소 연령보다 어려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സമർപ്പിച്ച ഐഡന്റിറ്റി Known-ന്റെ കുറഞ്ഞ പ്രായപരിധിയിൽ താഴെയാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiti yang anda kemukakan berada di bawah umur minimum untuk Known."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiteten du la fram, er under aldersgrensen for Known."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De identiteit die je hebt getoond is jonger dan de minimumleeftijd voor Known."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba z okazanego dokumentu nie osiągnęła minimalnego wieku wymaganego w Known."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade apresentada é de uma pessoa abaixo da idade mínima para usar o Known."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade que apresentou está abaixo da idade mínima para a Known."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitatea prezentată se află sub vârsta minimă pentru Known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возраст в предъявленном документе ниже минимального для Known."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predložená totožnosť patrí osobe pod minimálnym vekom pre Known."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiteten du visade är under Knowns minimiålder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காட்டிய அடையாளம் Known-இன் குறைந்தபட்ச வயதுக்குக் குறைவானது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమర్పించిన గుర్తింపు Known కనీస వయస్సు కంటే తక్కువ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวตนที่คุณแสดงมีอายุต่ำกว่าเกณฑ์ขั้นต่ำของ Known"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunduğunuz kimlik, Known için gereken asgari yaşın altında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Особа, зазначена в документі, молодша за мінімальний вік для Known."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پیش کردہ شناخت Known کی کم از کم عمر سے کم کی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính bạn xuất trình chưa đủ độ tuổi tối thiểu để dùng Known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身份证件显示的年龄低于 Known 的最低年龄要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你出示的身分未達 Known 的最低年齡。"
          }
        }
      }
    },
    "auth.rejected.reason.unreadableDocument": {
      "comment": "Rejection reason `unreadable_document` from the document pre-screen (contract v25). The server's decision-email sentence, word for word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة وثيقة هويتك: الصورة مشوشة أو مظلمة أو مقصوصة. صوّرها مرة أخرى في إضاءة جيدة، مسطّحة وكاملة، وأرسلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয়পত্র পড়া যায়নি: ছবিটি খুব ঝাপসা, অন্ধকার বা কাটা। ভালো আলোতে, সমতলভাবে ও পুরোটা দেখিয়ে আবার ছবি তুলে জমা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir el teu document d'identitat: la imatge és massa borrosa, fosca o retallada. Fotografia'l de nou amb bona llum, pla i sencer, i torna-ho a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklad totožnosti se nepodařilo přečíst: obrázek je příliš rozmazaný, tmavý nebo oříznutý. Vyfotografuj ho znovu při dobrém světle, rovně a celý, a odešli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit id-dokument kunne ikke læses: Billedet er for sløret, mørkt eller beskåret. Fotografér det igen i godt lys, fladt og i sin helhed, og send igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ausweisdokument konnte nicht gelesen werden: Das Bild ist zu unscharf, zu dunkel oder zu knapp zugeschnitten. Fotografiere es bei gutem Licht noch einmal, flach und vollständig, und sende es erneut ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το έγγραφο ταυτότητάς σου δεν μπόρεσε να διαβαστεί: η εικόνα είναι πολύ θολή, σκοτεινή ή κομμένη. Φωτογράφισέ το ξανά με καλό φως, ίσιο και ολόκληρο, και υπέβαλέ το ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your identity document could not be read: the picture is too blurred, dark or cropped. Photograph it again in good light, flat and whole, and submit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer tu documento de identidad: la imagen está demasiado borrosa, oscura o recortada. Vuelve a fotografiarlo con buena luz, plano y entero, y envíalo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyysasiakirjaasi ei voitu lukea: kuva on liian epätarkka, tumma tai rajattu. Kuvaa se uudelleen hyvässä valossa, tasaisena ja kokonaisena, ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre document d’identité n’a pas pu être lu : l’image est trop floue, sombre ou coupée. Photographiez-le à nouveau avec un bon éclairage, à plat et en entier, puis renvoyez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את מסמך הזהות שלך: התמונה מטושטשת, חשוכה או חתוכה מדי. צלם אותו שוב באור טוב, ישר ושלם, ושלח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पहचान दस्तावेज़ पढ़ा नहीं जा सका: तस्वीर बहुत धुंधली, अँधेरी या कटी हुई है। अच्छी रोशनी में, सीधा और पूरा रखकर दोबारा फ़ोटो लें और फिर से सबमिट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja isprava nije se mogla pročitati: slika je previše mutna, tamna ili izrezana. Ponovno je fotografiraj na dobrom svjetlu, ravno i cijelu, pa pošalji ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azonosító okmányodat nem sikerült beolvasni: a kép túl elmosódott, sötét vagy levágott. Fényképezd le újra jó fényben, laposan és teljes egészében, majd küldd be újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen identitasmu tidak bisa dibaca: gambarnya terlalu buram, gelap, atau terpotong. Fotolah lagi di tempat terang, rata dan utuh, lalu kirim ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il tuo documento: l'immagine è troppo sfocata, scura o tagliata. Fotografalo di nuovo con buona luce, piatto e intero, e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身分証明書を読み取れませんでした。画像がぼやけている、暗い、または切れています。明るい場所で、書類を平らにして全体を撮影し、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증을 읽을 수 없었어요. 사진이 너무 흐리거나 어둡거나 잘렸어요. 밝은 곳에서 문서 전체가 평평하게 보이도록 다시 촬영해서 제출해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തിരിച്ചറിയൽ രേഖ വായിക്കാനായില്ല: ചിത്രം മങ്ങിയതോ ഇരുണ്ടതോ ക്രോപ്പ് ചെയ്തതോ ആണ്. നല്ല വെളിച്ചത്തിൽ, പരന്ന നിലയിൽ, മുഴുവനായി വീണ്ടും ഫോട്ടോ എടുത്ത് വീണ്ടും സമർപ്പിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen identiti anda tidak dapat dibaca: gambar terlalu kabur, gelap atau terpangkas. Potret semula dalam cahaya yang baik, rata dan penuh, dan hantar semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legitimasjonen din kunne ikke leses: bildet er for uskarpt, mørkt eller beskåret. Ta nytt bilde i godt lys, flatt og hele dokumentet, og send inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je identiteitsbewijs kon niet worden gelezen: de foto is te vaag, te donker of te krap bijgesneden. Fotografeer het opnieuw bij goed licht, plat en in zijn geheel, en verstuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać dokumentu tożsamości: zdjęcie jest zbyt rozmazane, ciemne lub ucięte. Sfotografuj go ponownie przy dobrym świetle, płasko i w całości, a następnie wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler seu documento de identidade: a imagem está muito borrada, escura ou cortada. Fotografe-o novamente com boa luz, plano e inteiro, e envie de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o seu documento de identificação: a imagem está demasiado desfocada, escura ou cortada. Fotografe-o novamente com boa luz, plano e inteiro, e submeta de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actul tău nu a putut fi citit: imaginea este prea neclară, întunecată sau tăiată. Fotografiază-l din nou la lumină bună, drept și întreg, și trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ваш документ: снимок слишком размытый, тёмный или обрезан. Сфотографируйте его снова при хорошем освещении, ровно и целиком, и отправьте заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj doklad totožnosti sa nepodarilo prečítať: obrázok je príliš rozmazaný, tmavý alebo orezaný. Odfoť ho znova pri dobrom svetle, rovno a celý, a odošli ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt id-dokument gick inte att läsa: bilden är för suddig, mörk eller beskuren. Fotografera det igen i bra ljus, platt och helt, och skicka in igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடையாள ஆவணத்தைப் படிக்க முடியவில்லை: படம் மிகவும் மங்கலாக, இருட்டாக அல்லது வெட்டப்பட்டுள்ளது. நல்ல வெளிச்சத்தில், தட்டையாக, முழுமையாக மீண்டும் படம் எடுத்துச் சமர்ப்பியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపు పత్రాన్ని చదవలేకపోయాం: చిత్రం మసకగా, చీకటిగా లేదా కత్తిరించినట్లు ఉంది. మంచి వెలుతురులో, సమతలంగా, పూర్తిగా కనిపించేలా మళ్లీ ఫోటో తీసి, మళ్లీ సమర్పించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเอกสารยืนยันตัวตนของคุณไม่ได้ รูปเบลอ มืด หรือถูกตัดขอบ ถ่ายใหม่ในที่ที่มีแสงดี วางให้เรียบและเห็นครบทั้งใบ แล้วส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik belgeniz okunamadı: resim çok bulanık, karanlık veya kırpılmış. İyi ışıkta, düz ve tam olarak yeniden fotoğraflayın ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш документ не вдалося прочитати: зображення надто розмите, темне або обрізане. Сфотографуйте його ще раз при гарному освітленні, рівно і повністю, та надішліть знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا شناختی دستاویز پڑھا نہیں جا سکا: تصویر بہت دھندلی، تاریک یا کٹی ہوئی ہے۔ اچھی روشنی میں، سیدھا اور پورا رکھ کر دوبارہ تصویر لیں اور دوبارہ جمع کرائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được giấy tờ tùy thân của bạn: ảnh quá mờ, tối hoặc bị cắt. Hãy chụp lại ở nơi đủ sáng, đặt phẳng và đủ toàn bộ, rồi gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你的身份证件：图片太模糊、太暗或被裁掉了一部分。请在光线良好的地方将证件平放并完整拍下，然后再次提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取你的身分證件：圖片太模糊、太暗或被裁切。請在光線良好處平放並完整拍攝，然後再次送出。"
          }
        }
      }
    },
