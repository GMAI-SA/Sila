    "video.error.withMedia": {
      "comment": "400 video_with_media.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يتضمن منشور الفيديو صورًا أو صورة متحركة أو استطلاعًا أو تسجيلًا صوتيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও পোস্টে একই সাথে ছবি, GIF, পোল বা ভয়েস রেকর্ডিং থাকতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una publicació de vídeo no pot tenir també imatges, un GIF, una enquesta ni un enregistrament de veu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videopříspěvek nemůže mít také obrázky, GIF, anketu ani hlasový záznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et videoopslag kan ikke også have billeder, en GIF, en afstemning eller en lydoptagelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Videobeitrag kann nicht zusätzlich Bilder, ein GIF, eine Umfrage oder eine Sprachaufnahme enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ανάρτηση βίντεο δεν μπορεί να έχει επίσης εικόνες, GIF, δημοσκόπηση ή ηχογράφηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A video post can't also have pictures, a GIF, a poll or a voice recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una publicación con vídeo no puede llevar además imágenes, un GIF, una encuesta ni una grabación de voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Videojulkaisussa ei voi olla myös kuvia, GIF-kuvaa, kyselyä tai ääninauhoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un post vidéo ne peut pas contenir aussi des images, un GIF, un sondage ou un enregistrement vocal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסט וידאו לא יכול לכלול גם תמונות, GIF, סקר או הקלטה קולית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो पोस्ट में तस्वीरें, GIF, पोल या वॉइस रिकॉर्डिंग भी नहीं हो सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video objava ne može imati i slike, GIF, anketu ili glasovni zapis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Videós bejegyzéshez nem tartozhat kép, GIF, szavazás vagy hangfelvétel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan video tidak bisa juga memuat gambar, GIF, jajak pendapat, atau rekaman suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un post video non può avere anche immagini, una GIF, un sondaggio o una registrazione vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の投稿には、画像、GIF、投票、音声の録音を一緒に付けられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 게시물에는 사진, GIF, 투표, 음성 녹음을 함께 넣을 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീഡിയോ പോസ്റ്റിൽ ചിത്രങ്ങളോ GIF-ഓ പോളോ വോയ്‌സ് റെക്കോർഡിംഗോ ഉണ്ടാകാൻ പാടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran video tidak boleh turut mempunyai gambar, GIF, tinjauan atau rakaman suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et videoinnlegg kan ikke også ha bilder, en GIF, en avstemning eller et lydopptak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een videobericht kan niet ook afbeeldingen, een GIF, een peiling of een spraakopname bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis z wideo nie może mieć też zdjęć, GIF-a, ankiety ani nagrania głosowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um post de vídeo não pode ter também imagens, GIF, enquete ou gravação de voz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma publicação de vídeo não pode ter também imagens, um GIF, uma sondagem ou uma gravação de voz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O postare video nu poate avea și imagini, un GIF, un sondaj sau o înregistrare vocală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К видеопосту нельзя добавить фото, GIF, опрос или голосовую запись."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Video príspevok nemôže obsahovať aj obrázky, GIF, anketu či hlasovú nahrávku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett videoinlägg kan inte också ha bilder, en GIF, en omröstning eller en röstinspelning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோ இடுகையில் படங்கள், GIF, வாக்கெடுப்பு அல்லது குரல் பதிவையும் சேர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీడియో పోస్ట్‌లో చిత్రాలు, GIF, పోల్ లేదా వాయిస్ రికార్డింగ్ కూడా ఉండకూడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์วิดีโอมีรูปภาพ GIF โพล หรือเสียงอัดด้วยไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir video gönderisinde resim, GIF, anket veya ses kaydı da olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відеодопис не може мати також зображень, GIF, опитування чи голосового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویڈیو پوسٹ کے ساتھ تصاویر، GIF، پول یا آواز کی ریکارڈنگ نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng video không thể kèm ảnh, GIF, bình chọn hay bản ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频帖子不能同时附带图片、GIF、投票或语音录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片貼文不能同時附帶圖片、GIF、投票或語音錄音。"
          }
        }
      }
    },
