    "vouch.mine.none.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يزكّيك حاليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে কেউ আপনার জন্য ভাউচ করছেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix ningú no t'avala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď za tebe nikdo neručí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen går i god for dig lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment bürgt niemand für dich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν εγγυάται για εσένα αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is vouching for you right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie te está avalando ahora mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei takaa sinua juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne se porte garant de vous pour le moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד לא ערב לך כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई आपके लिए वाउच नहीं कर रहा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno nitko ne jamči za tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg senki nem kezeskedik érted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini tidak ada yang menjaminmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento nessuno garantisce per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、あなたを保証している人はいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 나를 보증하는 사람이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ ആരും നിങ്ങൾക്ക് വൗച്ച് ചെയ്യുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa menjamin anda sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen garanterer for deg akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit moment staat niemand voor je in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt teraz za Ciebie nie ręczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está avalizando você agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém lhe está a dar aval neste momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum nimeni nu garantează pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас за вас никто не поручается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve teraz za teba nikto neručí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen intygar för dig just nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது யாரும் உங்களுக்காக உறுதியளிக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం ఎవరూ మీకు హామీ ఇవ్వడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีใครรับรองคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kimse size kefil olmuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі за вас ніхто не ручається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی آپ کی ضمانت نہیں دے رہا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không ai đang bảo chứng cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有人为你担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
