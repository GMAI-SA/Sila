    "feed.profileOff.account.detail": {
      "comment": "What the account row contains.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك ومعرّفك وصورتك وبريدك وكلمة مرورك — وكيفية تنزيل كل بياناتك أو حذفها."
