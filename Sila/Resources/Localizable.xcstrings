        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ جانچتا ہے کہ جائزہ لینے والے نے فیصلہ کیا یا نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra lại xem người xét duyệt đã quyết định chưa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查审核员是否已作出决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新確認審核人員是否已作出決定"
          }
        }
      }
    },
    "auth.wall.error.statusCheckFailed": {
      "comment": "Toast when the status check fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من حالتك. اسحب للأسفل لإعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থা দেখা যায়নি। আবার চেষ্টা করতে নিচে টানুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut comprovar el teu estat. Llisca cap avall per tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav se nepodařilo zkontrolovat. Zkus to znovu stažením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke tjekke din status. Træk ned for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten deinen Status nicht prüfen. Zieh nach unten, um es erneut zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να ελέγξουμε την κατάστασή σου. Τράβηξε προς τα κάτω για να δοκιμάσεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check your status. Pull to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos comprobar tu estado. Desliza hacia abajo para reintentar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaasi ei voitu tarkistaa. Vedä alas ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier votre statut. Tirez pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לבדוק את הסטטוס שלך. משוך כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी स्थिति नहीं जाँच सके। फिर कोशिश करने के लिए खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli provjeriti tvoj status. Povuci za ponovni pokušaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtuk ellenőrizni az állapotodat. Húzd lefelé az újrapróbáláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa memeriksa statusmu. Tarik untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile controllare il tuo stato. Trascina verso il basso per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況を確認できませんでした。引っ張って再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태를 확인하지 못했어요. 당겨서 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നില പരിശോധിക്കാനായില്ല. വീണ്ടും ശ്രമിക്കാൻ താഴേക്ക് വലിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menyemak status anda. Tarik untuk cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke sjekke statusen din. Dra ned for å prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je status niet controleren. Trek omlaag om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić statusu. Pociągnij w dół, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar seu status. Puxe para tentar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o seu estado. Puxe para baixo para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut verifica starea. Trage în jos pentru a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить статус. Потяните вниз, чтобы повторить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav sa nepodarilo skontrolovať. Potiahnutím nadol to skús znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte kontrollera din status. Dra för att försöka igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நிலையைச் சரிபார்க்க முடியவில்லை. மீண்டும் முயல கீழே இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ స్థితిని తనిఖీ చేయలేకపోయాం. మళ్లీ ప్రయత్నించడానికి క్రిందికి లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราตรวจสอบสถานะของคุณไม่ได้ ดึงลงเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durumunuzu kontrol edemedik. Tekrar denemek için aşağı çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити ваш статус. Потягніть вниз, щоб спробувати ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کی صورتحال نہیں جانچ سکے۔ دوبارہ کوشش کے لیے نیچے کھینچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không kiểm tra được trạng thái của bạn. Kéo xuống để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法检查你的状态。下拉以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法查看你的狀態。請下拉重試。"
          }
        }
      }
    },
