    "composer.sensitive.hint": {
      "comment": "Explanation under the picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى القرّاء غطاءً بهذا التصنيف ويختارون فتحه. اذكر ما خلفه، لا الشيء نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠকেরা এই লেবেলসহ একটি আবরণ দেখে এবং নিজে খুলতে চাইলে খোলে। ভেতরে কী আছে তা বলুন, বিষয়টি নিজে নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els lectors veuen una coberta amb aquesta etiqueta i decideixen si l'obren. Digues què hi ha al darrere, no la cosa en si."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtenáři uvidí zakrytí s tímto označením a sami se rozhodnou, zda ho otevřou. Napiš, co je za ním, ne samotný obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læsere ser en afdækning med denne etiket og vælger selv at åbne den. Sig, hvad der gemmer sig bag den, ikke selve indholdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser sehen eine Abdeckung mit diesem Label und entscheiden selbst, ob sie sie öffnen. Sag, was dahintersteckt, nicht die Sache selbst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναγνώστες βλέπουν ένα κάλυμμα με αυτή την ετικέτα και επιλέγουν αν θα το ανοίξουν. Γράψε τι κρύβεται πίσω του, όχι το ίδιο το περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readers see a cover with this label and choose to open it. Say what is behind it, not the thing itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lectores ven una cubierta con esta etiqueta y deciden si la abren. Indica qué hay detrás, no el contenido en sí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukijat näkevät peitteen tällä tunnisteella ja päättävät avaavatko sen. Kerro mitä sen takana on, älä itse asiaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lecteurs voient un voile portant cette étiquette et choisissent de l’ouvrir. Dites ce qu’il y a derrière, pas la chose elle-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוראים רואים כיסוי עם התווית הזו ובוחרים אם לפתוח. כתוב מה מסתתר מאחוריו, לא את הדבר עצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठकों को इस लेबल वाला एक कवर दिखता है और वे उसे खोलना चुनते हैं। बताएँ कि उसके पीछे क्या है, वह चीज़ खुद नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitatelji vide prekrivač s ovom oznakom i sami odlučuju hoće li ga otvoriti. Reci što je iza njega, a ne samu stvar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az olvasók egy ilyen címkéjű takarást látnak, és maguk döntik el, megnyitják-e. Azt írd meg, mi van mögötte, ne magát a dolgot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaca melihat penutup dengan label ini dan memilih membukanya. Sebutkan apa yang ada di baliknya, bukan isinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I lettori vedono una copertura con questa etichetta e scelgono se aprirla. Di' cosa c'è dietro, non il contenuto stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読者にはこのラベル付きのカバーが表示され、開くかどうかを選べます。中身そのものではなく、何が隠れているかを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽는 사람에게는 이 라벨이 붙은 가림막이 보이고, 열지 여부는 직접 선택해요. 내용 자체가 아니라 그 안에 무엇이 있는지 알려 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വായനക്കാർ ഈ ലേബലുള്ള ഒരു മറ കാണുകയും തുറക്കണോ എന്ന് തീരുമാനിക്കുകയും ചെയ്യും. അതിനു പിന്നിൽ എന്താണെന്ന് പറയുക, അത് തന്നെ എഴുതരുത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaca melihat penutup dengan label ini dan memilih untuk membukanya. Nyatakan apa di sebaliknya, bukan perkara itu sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesere ser et deksel med denne merkelappen og velger selv å åpne det. Si hva som er bak, ikke selve innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezers zien een afdekking met dit label en kiezen zelf of ze die openen. Zeg wat erachter zit, niet het ding zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytelnicy zobaczą osłonę z tym opisem i sami zdecydują, czy ją otworzyć. Napisz, co jest pod spodem, a nie samą treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os leitores veem uma capa com este rótulo e escolhem abrir. Diga o que há por trás, não o conteúdo em si."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os leitores veem uma capa com esta etiqueta e escolhem se a abrem. Diga o que está por trás, não o conteúdo em si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cititorii văd o copertă cu această etichetă și aleg dacă o deschid. Spune ce se află în spatele ei, nu conținutul în sine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читатели увидят заглушку с этой пометкой и сами решат, открывать ли. Укажите, что за ней, а не само содержимое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitatelia uvidia kryt s týmto označením a sami sa rozhodnú, či ho otvoria. Napíš, čo je za ním, nie to samotné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läsare ser ett omslag med den här etiketten och väljer själva om de öppnar det. Säg vad som finns bakom, inte själva innehållet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாசகர்கள் இந்த லேபிளுடன் ஒரு மறைப்பைப் பார்த்து, திறக்க விரும்பினால் திறப்பார்கள். உள்ளே இருப்பதையே அல்ல, அது என்ன என்பதைச் சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాఠకులకు ఈ లేబుల్‌తో ఒక కవర్ కనిపిస్తుంది, దాన్ని తెరవాలా వద్దా అని వారే ఎంచుకుంటారు. అందులో ఏముందో చెప్పండి, అదే విషయాన్ని కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้อ่านจะเห็นฝาครอบพร้อมป้ายนี้และเลือกเปิดเอง บอกว่าข้างหลังมีอะไร ไม่ใช่ตัวเนื้อหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuyucular bu etiketli bir kapak görür ve açmayı kendileri seçer. Arkasındakinin kendisini değil, ne olduğunu yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читачі бачать обкладинку з цією позначкою й самі вирішують, чи відкривати. Скажіть, що за нею, а не саму суть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قارئین کو اس لیبل کے ساتھ ایک پردہ نظر آتا ہے اور وہ اسے کھولنے کا فیصلہ کرتے ہیں۔ بتائیں کہ اس کے پیچھے کیا ہے، خود وہ چیز نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người đọc thấy một lớp phủ có nhãn này và tự chọn mở ra. Hãy nói điều gì ở phía sau, đừng nói chính nội dung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读者会看到带此标签的遮罩，并自行选择是否打开。请说明遮罩后面是什么，而不是内容本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀者會看到帶有此標籤的遮罩，並自行選擇是否開啟。請說明遮罩後面是什麼，而不是內容本身。"
          }
        }
      }
    },
