          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işlemi bugün gerçekleşecek. Şimdi iptal etmek hâlâ mümkün, ama çok uzun sürmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення відбудеться сьогодні. Скасувати зараз ще можна, але ненадовго."
