    "guest.join.takePart.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزوار يستمعون فقط. التحدث ورفع اليد والتفاعل والدردشة وطرح الأسئلة والتصويت للأعضاء — وكلهم أشخاص حقيقيون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতিথিরা শুনতে পারেন। কথা বলা, হাত তোলা, রিঅ্যাক্ট করা, চ্যাট করা, প্রশ্ন করা ও ভোট দেওয়া সদস্যদের জন্য — তাদের প্রত্যেকেই আসল মানুষ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els convidats poden escoltar. Parlar, aixecar la mà, reaccionar, xatejar, fer preguntes i votar és per als membres, tots ells persones reals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosté mohou poslouchat. Mluvit, hlásit se, reagovat, chatovat, ptát se a hlasovat mohou členové – každý z nich skutečný člověk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gæster kan lytte. At tale, række hånden op, reagere, chatte, stille spørgsmål og stemme er for medlemmer – hver eneste et rigtigt menneske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäste können zuhören. Sprechen, Hand heben, reagieren, chatten, Fragen stellen und abstimmen sind Mitgliedern vorbehalten – jedes davon ein echter Mensch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επισκέπτες μπορούν να ακούν. Η ομιλία, το σήκωμα χεριού, οι αντιδράσεις, η συνομιλία, οι ερωτήσεις και η ψηφοφορία είναι για τα μέλη — καθένα από αυτά πραγματικός άνθρωπος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guests can listen. Speaking, raising a hand, reacting, chatting, asking questions and voting are for members — every one of them a real person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los invitados pueden escuchar. Hablar, levantar la mano, reaccionar, chatear, hacer preguntas y votar es cosa de miembros: cada uno, una persona real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieraat voivat kuunnella. Puhuminen, käden nostaminen, reagoiminen, keskustelu, kysyminen ja äänestäminen on jäsenille – jokainen heistä on oikea ihminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invités peuvent écouter. Parler, lever la main, réagir, discuter, poser des questions et voter sont réservés aux membres — chacun étant une vraie personne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורחים יכולים להאזין. דיבור, הרמת יד, תגובות, צ׳אט, שאלות והצבעה שמורים לחברים — כולם אנשים אמיתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेहमान सुन सकते हैं। बोलना, हाथ उठाना, रिएक्ट करना, चैट करना, सवाल पूछना और वोट देना सदस्यों के लिए है — और हर एक असली व्यक्ति है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gosti mogu slušati. Govorenje, podizanje ruke, reagiranje, čavrljanje, postavljanje pitanja i glasovanje rezervirani su za članove — svaki od njih je stvarna osoba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vendégek hallgathatnak. A megszólalás, jelentkezés, reagálás, csevegés, kérdezés és szavazás a tagoké – és mindegyikük valódi ember."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamu bisa mendengarkan. Berbicara, mengangkat tangan, bereaksi, mengobrol, bertanya, dan memberi suara khusus untuk anggota — masing-masing orang sungguhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ospiti possono ascoltare. Parlare, alzare la mano, reagire, chattare, fare domande e votare sono riservati ai membri, ognuno dei quali è una persona reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストは聴くことができます。発言、挙手、リアクション、チャット、質問、投票はメンバー専用で、どれも実在の人によるものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트는 들을 수 있어요. 말하기, 손들기, 반응, 채팅, 질문, 투표는 멤버만 할 수 있고, 모두 실제 사람이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതിഥികൾക്ക് കേൾക്കാം. സംസാരിക്കൽ, കൈ ഉയർത്തൽ, പ്രതികരിക്കൽ, ചാറ്റ് ചെയ്യൽ, ചോദ്യങ്ങൾ ചോദിക്കൽ, വോട്ട് ചെയ്യൽ എന്നിവ അംഗങ്ങൾക്കുള്ളതാണ് — ഓരോരുത്തരും ഒരു യഥാർഥ വ്യക്തി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetamu boleh mendengar. Bercakap, mengangkat tangan, bereaksi, berbual, bertanya soalan dan mengundi adalah untuk ahli — setiap seorang ialah orang sebenar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjester kan lytte. Å snakke, rekke opp hånden, reagere, chatte, stille spørsmål og stemme er for medlemmer, og alle er ekte mennesker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasten kunnen luisteren. Spreken, een hand opsteken, reageren, chatten, vragen stellen en stemmen is voor leden, stuk voor stuk echte mensen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goście mogą słuchać. Mówienie, podnoszenie ręki, reagowanie, czatowanie, zadawanie pytań i głosowanie są dla członków — każdy z nich to prawdziwa osoba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitantes podem ouvir. Falar, levantar a mão, reagir, conversar, fazer perguntas e votar são para membros, e cada um deles é uma pessoa real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os convidados podem ouvir. Falar, levantar a mão, reagir, conversar, fazer perguntas e votar é para membros — todos eles pessoas reais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitații pot asculta. Vorbitul, ridicarea mâinii, reacțiile, chatul, întrebările și votul sunt pentru membri — fiecare o persoană reală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гости могут слушать. Говорить, поднимать руку, реагировать, писать в чат, задавать вопросы и голосовать могут участники — и каждый из них реальный человек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostia môžu počúvať. Hovoriť, hlásiť sa, reagovať, písať do četu, pýtať sa a hlasovať môžu členovia — každý je skutočný človek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäster kan lyssna. Att tala, räcka upp handen, reagera, chatta, ställa frågor och rösta är för medlemmar – var och en en verklig person."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருந்தினர்கள் கேட்கலாம். பேசுதல், கை உயர்த்துதல், எதிர்வினை, அரட்டை, கேள்வி கேட்டல், வாக்களித்தல் ஆகியவை உறுப்பினர்களுக்கு — ஒவ்வொருவரும் உண்மையான மனிதர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అతిథులు వినవచ్చు. మాట్లాడటం, చేయి ఎత్తడం, రియాక్ట్ అవ్వడం, చాట్ చేయడం, ప్రశ్నలు అడగడం, ఓటు వేయడం సభ్యులకు మాత్రమే — వారిలో ప్రతి ఒక్కరూ నిజమైన వ్యక్తే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เยี่ยมชมฟังได้ การพูด ยกมือ แสดงรีแอกชัน แชท ถามคำถาม และโหวตสำหรับสมาชิก ซึ่งทุกคนเป็นคนจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misafirler dinleyebilir. Konuşmak, el kaldırmak, tepki vermek, sohbet etmek, soru sormak ve oy kullanmak üyelere özeldir; hepsi gerçek birer insan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гості можуть слухати. Говорити, піднімати руку, реагувати, спілкуватися в чаті, ставити запитання й голосувати можуть учасники — і кожен із них реальна людина."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہمان سن سکتے ہیں۔ بولنا، ہاتھ اٹھانا، ردعمل دینا، چیٹ کرنا، سوال پوچھنا اور ووٹ دینا ارکان کے لیے ہے — ان میں سے ہر ایک حقیقی شخص ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khách có thể nghe. Phát biểu, giơ tay, bày tỏ cảm xúc, trò chuyện, đặt câu hỏi và bình chọn là dành cho thành viên — mỗi người đều là người thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访客可以收听。发言、举手、回应、聊天、提问和投票是成员的权利，而每一位成员都是真人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訪客可以收聽。發言、舉手、回應、聊天、提問和投票僅限成員，而每位成員都是真人。"
          }
        }
      }
    },
