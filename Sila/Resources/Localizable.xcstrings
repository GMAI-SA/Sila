    "vouch.error.underAge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تجوز تزكية من هو دون 18 عامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ১৮ বা তার বেশি বয়সী কারও জন্য ভাউচ করা যায়।"
          }
