          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento in arrivo. Creane uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されているイベントはありません。作ってみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 이벤트가 없어요. 하나 시작해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വരാനിരിക്കുന്ന ഇവന്റുകളില്ല. ഒന്ന് തുടങ്ങുക."
          }
