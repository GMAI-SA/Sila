    "preferences.country.error.alreadyMuted": {
      "comment": "Validation when the country is already on the list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الدولة مكتومة بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দেশ ইতিমধ্যে মিউট করা আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest país ja està silenciat."
          }
