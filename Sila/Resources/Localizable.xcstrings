    "notifications.sentence.unknown": {
      "comment": "An event this build does not recognise. Says the app is out of date, never that the event was unimportant. %@ is who did it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قام %@ بشيء لا يستطيع هذا الإصدار من «معروف» وصفه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এমন কিছু করেছেন যা Known-এর এই সংস্করণ বর্ণনা করতে পারে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha fet una cosa que aquesta versió de Known no pot descriure"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ udělal(a) něco, co tato verze aplikace Known neumí popsat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gjorde noget, som denne version af Known ikke kan beskrive"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat etwas getan, das diese Version von Known nicht beschreiben kann"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ έκανε κάτι που αυτή η έκδοση του Known δεν μπορεί να περιγράψει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did something this version of Known can't describe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hizo algo que esta versión de Known no puede describir"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teki jotain, mitä tämä Knownin versio ei osaa kuvata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fait quelque chose que cette version de Known ne sait pas décrire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עשה משהו שהגרסה הזו של Known לא יכולה לתאר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने कुछ ऐसा किया जिसे Known का यह संस्करण बता नहीं सकता"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je učinio/la nešto što ova verzija aplikacije Known ne može opisati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ olyat tett, amit a Known ezen verziója nem tud leírni"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ melakukan sesuatu yang tidak bisa dijelaskan versi Known ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha fatto qualcosa che questa versione di Known non sa descrivere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が、このバージョンのKnownでは表示できない操作をしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 이 버전의 Known에서 설명할 수 없는 행동을 했어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ന്റെ ഈ പതിപ്പിന് വിവരിക്കാനാവാത്ത എന്തോ %@ ചെയ്തു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ melakukan sesuatu yang tidak dapat diterangkan oleh versi Known ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gjorde noe denne versjonen av Known ikke kan beskrive"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deed iets wat deze versie van Known niet kan beschrijven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zrobił(a) coś, czego ta wersja Known nie potrafi opisać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fez algo que esta versão do Known não consegue descrever"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fez algo que esta versão da Known não consegue descrever"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a făcut ceva ce această versiune Known nu poate descrie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сделал(а) то, что эта версия Known не может описать"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ urobil(a) niečo, čo táto verzia Known nevie opísať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gjorde något som den här versionen av Known inte kan beskriva"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இன் இந்தப் பதிப்பு விவரிக்க முடியாத ஒன்றை %@ செய்தார்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఈ Known వెర్షన్ వివరించలేని ఏదో చేశారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ทำบางอย่างที่ Known เวอร์ชันนี้อธิบายไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Known'un bu sürümünün tanımlayamadığı bir şey yaptı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зробив(ла) щось, що ця версія Known не може описати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نے کچھ ایسا کیا جو Known کا یہ ورژن بیان نہیں کر سکتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã làm điều mà phiên bản Known này không thể mô tả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 做了此版本 Known 无法描述的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 做了這個版本的 Known 無法描述的事"
          }
        }
      }
    },
    "notifications.sentence.vouchClaimed": {
      "comment": "%@ is the other person's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل %@ تزكيتك — أكّد أنه هو"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আপনার সুপারিশ গ্রহণ করেছেন — নিশ্চিত করুন যে এটি তিনিই"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha acceptat el teu aval: confirma que és ell"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ přijal(a) tvé ručení – potvrď, že je to ta osoba"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepterede din garanti – bekræft, at det er dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat deine Bürgschaft angenommen – bestätige, dass er oder sie es ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ αποδέχτηκε την εγγύησή σου — επιβεβαίωσε ότι είναι αυτός/ή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepted your vouch — confirm it's them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceptó tu aval: confirma que es esa persona"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hyväksyi takuusi – vahvista, että se on hän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a accepté votre caution — confirmez que c’est bien lui"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ קיבל את הערבות שלך — אשר שזה הוא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने आपका वाउच स्वीकार किया — पुष्टि करें कि वही हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je prihvatio/la tvoje jamstvo — potvrdi da je to ta osoba"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elfogadta a kezességedet – erősítsd meg, hogy ő az"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menerima jaminanmu — konfirmasi bahwa itu dia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha accettato la tua garanzia: conferma che è proprio lui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@があなたの保証を受け入れました。ご本人か確認してください"
