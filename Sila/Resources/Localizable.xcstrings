    "account.phone.remove.hint": {
      "comment": "VoiceOver hint for removing the number.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف رقم تواصلك. ويحتاج كلمة مرورك أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার যোগাযোগের নম্বর মুছে দেয়। এতেও পাসওয়ার্ড লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el teu número de contacte. També requereix la contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže tvé kontaktní číslo. Vyžaduje také heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dit kontaktnummer. Kræver også din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht deine Kontaktnummer. Erfordert ebenfalls dein Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει τον αριθμό επικοινωνίας σου. Απαιτεί επίσης τον κωδικό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes your contact number. Also needs your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu número de contacto. También requiere tu contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa yhteystietonumerosi. Vaatii myös salasanasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre numéro de contact. Demande aussi votre mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק את מספר הקשר שלך. דורש גם את הסיסמה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका संपर्क नंबर हटाता है। इसके लिए भी आपका पासवर्ड चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše tvoj kontakt broj. Također traži tvoju lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli a kapcsolattartási számodat. A jelszavad is kell hozzá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus nomor kontakmu. Juga butuh kata sandimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il tuo numero di contatto. Serve anche la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先の番号を削除します。パスワードも必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처 번호를 삭제해요. 비밀번호도 필요해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കോൺടാക്റ്റ് നമ്പർ ഇല്ലാതാക്കുന്നു. പാസ്‌വേഡും വേണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
