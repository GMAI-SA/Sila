        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlkini siz açın, insanlar katılabilsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте першу, і люди зможуть приєднатися."
