    "vouch.warning.person.one": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمك الحقيقي وجنسيتك وتاريخ ميلادك كما في هويتك تمامًا. يجب أن تطابق ما أدخله ⁦@%@⁩."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আসল নাম, জাতীয়তা ও জন্ম তারিখ ঠিক আইডিতে যেমন আছে তেমন দিন। @%@ যা দিয়েছেন তার সাথে এগুলো মিলতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el teu nom real, la nacionalitat i la data de naixement, exactament com al teu document. Han de coincidir amb el que va introduir @%@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej své skutečné jméno, státní příslušnost a datum narození přesně jako na dokladu. Musí se shodovat s tím, co zadal @%@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast dit rigtige navn, din nationalitet og din fødselsdato, præcis som på dit id. De skal passe med det, @%@ indtastede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen echten Namen, deine Staatsangehörigkeit und dein Geburtsdatum genau wie in deinem Ausweis ein. Sie müssen zu dem passen, was @%@ eingegeben hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε το πραγματικό σου όνομα, την υπηκοότητα και την ημερομηνία γέννησής σου, ακριβώς όπως στην ταυτότητά σου. Πρέπει να ταιριάζουν με όσα εισήγαγε ο/η @%@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your real name, nationality and date of birth, exactly as on your ID. They must match what @%@ entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu nombre real, nacionalidad y fecha de nacimiento, exactamente como en tu documento. Deben coincidir con lo que introdujo @%@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna oikea nimesi, kansalaisuutesi ja syntymäaikasi täsmälleen kuten henkilöllisyystodistuksessasi. Niiden on täsmättävä siihen, mitä @%@ antoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre vrai nom, votre nationalité et votre date de naissance, exactement comme sur votre pièce d’identité. Ils doivent correspondre à ce que @%@ a saisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את שמך האמיתי, האזרחות ותאריך הלידה, בדיוק כפי שהם בתעודת הזהות. הם חייבים להתאים למה ש-@%@ הזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना असली नाम, राष्ट्रीयता और जन्म तिथि ठीक वैसे ही डालें जैसे आपकी ID पर है। ये वही होने चाहिए जो @%@ ने दर्ज किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši svoje pravo ime, državljanstvo i datum rođenja, točno kao na ispravi. Moraju se podudarati s onim što je unio/unijela @%@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a valódi nevedet, állampolgárságodat és születési dátumodat, pontosan úgy, ahogy az azonosítódon áll. Egyezniük kell azzal, amit @%@ megadott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama asli, kewarganegaraan, dan tanggal lahirmu, persis seperti di ID. Harus cocok dengan yang dimasukkan @%@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo vero nome, nazionalità e data di nascita, esattamente come sul documento. Devono corrispondere a ciò che ha inserito @%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDに記載のとおりに、本名、国籍、生年月日を入力してください。@%@が入力した内容と一致する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증에 적힌 대로 실명, 국적, 생년월일을 정확히 입력하세요. @%@님이 입력한 내용과 일치해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ യഥാർഥ പേര്, ദേശീയത, ജനനത്തീയതി എന്നിവ ഐഡിയിലുള്ളതുപോലെ തന്നെ നൽകുക. അവ @%@ നൽകിയതുമായി ഒത്തുപോകണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama sebenar, kewarganegaraan dan tarikh lahir anda, tepat seperti pada ID anda. Ia mesti sepadan dengan apa yang @%@ masukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn ditt virkelige navn, din nasjonalitet og fødselsdato, nøyaktig som på ID-en din. De må stemme med det @%@ skrev inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je echte naam, nationaliteit en geboortedatum in, precies zoals op je identiteitsbewijs. Ze moeten overeenkomen met wat @%@ heeft ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz prawdziwe imię i nazwisko, obywatelstwo i datę urodzenia dokładnie jak w dokumencie. Muszą zgadzać się z tym, co wpisał @%@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe seu nome real, sua nacionalidade e sua data de nascimento, exatamente como no documento. Eles precisam coincidir com o que @%@ informou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o seu nome verdadeiro, nacionalidade e data de nascimento, exatamente como no documento. Têm de coincidir com o que @%@ introduziu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu numele real, cetățenia și data nașterii, exact ca pe act. Trebuie să coincidă cu ce a introdus @%@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите настоящее имя, гражданство и дату рождения точно как в вашем документе. Они должны совпадать с тем, что ввёл(а) @%@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj svoje skutočné meno, národnosť a dátum narodenia presne ako na preukaze. Musia sa zhodovať s tým, čo zadal @%@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ditt riktiga namn, din nationalitet och ditt födelsedatum, exakt som på ditt id. De måste stämma med det @%@ angav."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உண்மையான பெயர், நாட்டினம், பிறந்த தேதியை அடையாள அட்டையில் உள்ளபடியே உள்ளிடுங்கள். அவை @%@ உள்ளிட்டவற்றுடன் பொருந்த வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ID లో ఉన్నట్లే మీ నిజమైన పేరు, జాతీయత మరియు పుట్టిన తేదీని నమోదు చేయండి. అవి @%@ నమోదు చేసిన వాటితో సరిపోలాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกชื่อจริง สัญชาติ และวันเกิดของคุณให้ตรงกับบัตรประจำตัว และต้องตรงกับที่ @%@ กรอกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek adınızı, uyruğunuzu ve doğum tarihinizi kimliğinizde yazdığı gibi girin. @%@ kişisinin girdikleriyle eşleşmeleri gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть своє справжнє ім’я, громадянство та дату народження точно так, як у документі. Вони мають збігатися з тим, що ввів @%@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا اصل نام، قومیت اور تاریخ پیدائش بالکل ویسے ہی درج کریں جیسے آپ کے شناختی کارڈ پر ہیں۔ انہیں اس سے ملنا ہوگا جو @%@ نے درج کیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên thật, quốc tịch và ngày sinh của bạn, đúng như trên giấy tờ. Chúng phải khớp với những gì @%@ đã nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请完全按证件上的内容填写你的真实姓名、国籍和出生日期。它们必须与 @%@ 输入的一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入你的真實姓名、國籍和出生日期，須與證件上完全一致，並且必須與 @%@ 輸入的相符。"
          }
        }
      }
    },
