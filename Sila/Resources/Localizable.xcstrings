    "feed.preferencesBar.hint": {
      "comment": "VoiceOver hint for the feed preferences bar.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح إعدادات المواضيع والدول المكتومة التي تصفّي هذه الصفحة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিড ফিল্টার করা বিষয় ও মিউট করা দেশের সেটিংস খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre els ajustos de temes i països silenciats que filtren aquest canal"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře nastavení témat a ztlumených zemí, které tento kanál filtrují"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner indstillingerne for emner og skjulte lande, der filtrerer dette feed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Themen- und Stummschalt-Länder-Einstellungen, die diesen Feed filtern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τις ρυθμίσεις θεμάτων και χωρών σε σίγαση που φιλτράρουν αυτή τη ροή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the topic and muted-country settings that filter this feed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ajustes de temas y países silenciados que filtran este feed"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa aihe- ja mykistettyjen maiden asetukset, jotka suodattavat tätä syötettä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages des sujets et des pays masqués qui filtrent ce fil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את הגדרות הנושאים והמדינות המושתקות שמסננות את הפיד הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ीड को फ़िल्टर करने वाली टॉपिक और म्यूट किए देशों की सेटिंग्स खोलता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara postavke tema i utišanih zemalja koje filtriraju ovaj feed"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a hírfolyamot szűrő téma- és némított ország beállításokat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pengaturan topik dan negara yang dibisukan yang menyaring feed ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le impostazioni di argomenti e paesi silenziati che filtrano questo feed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィードを絞り込むトピックとミュートした国の設定を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피드를 걸러내는 주제 및 뮤트한 국가 설정을 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫീഡ് ഫിൽട്ടർ ചെയ്യുന്ന വിഷയ, മ്യൂട്ട് ചെയ്ത രാജ്യ ക്രമീകരണങ്ങൾ തുറക്കുന്നു"
