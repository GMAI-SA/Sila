    "error.identityAlreadyUsed": {
      "comment": "409 identity_already_used.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الهوية مرتبطة بحساب آخر في «معروف» بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পরিচয় ইতিমধ্যে অন্য একটি Known অ্যাকাউন্টের সাথে যুক্ত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta identitat ja està vinculada a un altre compte de Known."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato totožnost je už propojena s jiným účtem Known."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne identitet er allerede knyttet til en anden Known-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Identität ist bereits mit einem anderen Known-Konto verknüpft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ταυτότητα είναι ήδη συνδεδεμένη με άλλο λογαριασμό Known."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identity is already linked to another Known account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta identidad ya está vinculada a otra cuenta de Known."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä henkilöllisyys on jo liitetty toiseen Known-tiliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette identité est déjà liée à un autre compte Known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזהות הזו כבר מקושרת לחשבון Known אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पहचान पहले से किसी दूसरे Known अकाउंट से जुड़ी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj identitet već je povezan s drugim Known računom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a személyazonosság már egy másik Known-fiókhoz van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas ini sudah terhubung ke akun Known lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa identità è già collegata a un altro account Known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本人情報は、すでに別のKnownアカウントに紐づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 신원은 이미 다른 Known 계정에 연결되어 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഐഡന്റിറ്റി ഇതിനകം മറ്റൊരു Known അക്കൗണ്ടുമായി ബന്ധിപ്പിച്ചിരിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiti ini sudah dipautkan kepada akaun Known lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne identiteten er allerede knyttet til en annen Known-konto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze identiteit is al gekoppeld aan een ander Known-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta tożsamość jest już powiązana z innym kontem Known."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta identidade já está vinculada a outra conta do Known."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta identidade já está associada a outra conta Known."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această identitate este deja asociată cu alt cont Known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта личность уже привязана к другому аккаунту Known."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto totožnosť je už prepojená s iným účtom Known."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här identiteten är redan kopplad till ett annat Known-konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அடையாளம் ஏற்கெனவே வேறொரு Known கணக்குடன் இணைக்கப்பட்டுள்ளது."
          }
