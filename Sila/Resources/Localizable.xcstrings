        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על האזן כדי לראות אם הוא פתוח עבורך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखने के लिए \"सुनें\" टैप करें कि यह आपके लिए खुला है या नहीं"
