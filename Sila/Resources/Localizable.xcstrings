    "vouch.new.shareText": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزكّيك في «معروف». افتح هذا الرابط لقبول التزكية:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি Known-এ আপনার জন্য ভাউচ করছি। গ্রহণ করতে এই লিংক খুলুন:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'avalo a Known. Obre aquest enllaç per acceptar:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručím za tebe v aplikaci Known. Otevři tento odkaz a přijmi:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg går i god for dig på Known. Åbn dette link for at acceptere:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bürge auf Known für dich. Öffne diesen Link, um anzunehmen:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγυώμαι για εσένα στο Known. Άνοιξε αυτόν τον σύνδεσμο για να αποδεχτείς:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm vouching for you on Known. Open this link to accept:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te estoy avalando en Known. Abre este enlace para aceptar:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaan sinut Knownissa. Avaa tämä linkki hyväksyäksesi:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me porte garant de vous sur Known. Ouvrez ce lien pour accepter :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני ערב לך ב-Known. פתח את הקישור הזה כדי לקבל:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं Known पर आपके लिए वाउच कर रहा/रही हूँ। स्वीकार करने के लिए यह लिंक खोलें:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamčim za tebe u aplikaciji Known. Otvori ovu poveznicu za prihvaćanje:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeskedem érted a Knownon. Az elfogadáshoz nyisd meg ezt a hivatkozást:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku menjaminmu di Known. Buka tautan ini untuk menerima:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantisco per te su Known. Apri questo link per accettare:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownであなたを保証します。このリンクを開いて受け入れてください:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known에서 당신을 보증할게요. 이 링크를 열어 수락하세요:"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ Known-ൽ നിങ്ങൾക്ക് വൗച്ച് ചെയ്യുന്നു. സ്വീകരിക്കാൻ ഈ ലിങ്ക് തുറക്കുക:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya menjamin anda di Known. Buka pautan ini untuk menerima:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg garanterer for deg på Known. Åpne denne lenken for å godta:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta voor je in op Known. Open deze link om te accepteren:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poręczam za Ciebie w Known. Otwórz ten link, aby przyjąć:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou avalizando você no Known. Abra este link para aceitar:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou a dar-te aval na Known. Abre esta ligação para aceitar:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantez pentru tine pe Known. Deschide acest link pentru a accepta:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я ручаюсь за вас в Known. Откройте эту ссылку, чтобы принять:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručím za teba na Known. Otvor tento odkaz a prijmi:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag intygar för dig på Known. Öppna den här länken för att godta:"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இல் நான் உங்களுக்காக உறுதியளிக்கிறேன். ஏற்க இந்த இணைப்பைத் திறக்கவும்:"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను Known లో మీకు హామీ ఇస్తున్నాను. అంగీకరించడానికి ఈ లింక్ తెరవండి:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันรับรองคุณบน Known เปิดลิงก์นี้เพื่อยอมรับ:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'da sana kefil oluyorum. Kabul etmek için bu bağlantıyı aç:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я ручаюся за вас у Known. Відкрийте це посилання, щоб прийняти:"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں Known پر آپ کی ضمانت دے رہا ہوں۔ قبول کرنے کے لیے یہ لنک کھولیں:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đang bảo chứng cho bạn trên Known. Mở liên kết này để chấp nhận:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在 Known 上为你担保。打开此链接即可接受："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我在 Known 上為你擔保。開啟此連結即可接受："
          }
        }
      }
    },
