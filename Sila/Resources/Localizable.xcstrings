    "account.email.password.hint": {
      "comment": "VoiceOver hint for the password field on the email change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوبة: هاتف مفتوح وحده يجب ألا يكفي لنقل حساب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবশ্যক: শুধু আনলক করা ফোন থাকলেই অ্যাকাউন্ট সরানো যাবে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatori: un telèfon desbloquejat no ha de bastar per moure un compte"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povinné: odemčený telefon nesmí stačit k přesunu účtu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påkrævet: En oplåst telefon må ikke være nok til at flytte en konto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich: Ein entsperrtes Telefon darf nicht genügen, um ein Konto zu verschieben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται: ένα ξεκλείδωτο τηλέφωνο δεν πρέπει να αρκεί για να μεταφερθεί ένας λογαριασμός"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required: an unlocked phone must not be enough to move an account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoria: un teléfono desbloqueado no debe bastar para mover una cuenta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakollinen: avattu puhelin ei saa riittää tilin siirtämiseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoire : un téléphone déverrouillé ne doit pas suffire pour transférer un compte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש: טלפון פתוח לא אמור להספיק כדי להעביר חשבון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरी: सिर्फ़ अनलॉक फ़ोन से अकाउंट नहीं बदला जाना चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavezno: otključan telefon ne smije biti dovoljan za premještanje računa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötelező: egy feloldott telefon nem lehet elég egy fiók áthelyezéséhez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajib: ponsel yang tidak terkunci tidak boleh cukup untuk memindahkan akun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obbligatoria: un telefono sbloccato non deve bastare per spostare un account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必須です。ロックが解除された電話だけでアカウントを移せないようにするためです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수: 잠금 해제된 휴대폰만으로 계정을 옮길 수 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവശ്യമാണ്: അൺലോക്ക് ചെയ്ത ഫോൺ മാത്രം ഉപയോഗിച്ച് അക്കൗണ്ട് മാറ്റാൻ കഴിയരുത്"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan: telefon yang tidak berkunci tidak sepatutnya cukup untuk memindahkan akaun"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påkrevd: en opplåst telefon skal ikke være nok til å flytte en konto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist: een ontgrendelde telefoon mag niet genoeg zijn om een account te verplaatsen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane: odblokowany telefon nie może wystarczyć do przeniesienia konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigatória: um celular desbloqueado não deve bastar para mudar uma conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigatório: um telemóvel desbloqueado não deve ser suficiente para mudar uma conta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoriu: un telefon deblocat nu trebuie să fie de ajuns pentru a muta un cont"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательно: разблокированного телефона недостаточно, чтобы перенести аккаунт"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povinné: odomknutý telefón nesmie stačiť na presun účtu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krävs: en olåst telefon ska inte räcka för att flytta ett konto"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவை: திறக்கப்பட்ட தொலைபேசி மட்டுமே ஒரு கணக்கை மாற்றுவதற்குப் போதாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పనిసరి: అన్‌లాక్ చేసిన ఫోన్ ఉంటే చాలదు, ఖాతాను మార్చడానికి పాస్‌వర్డ్ కావాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็น: โทรศัพท์ที่ปลดล็อกอยู่ไม่ควรเพียงพอที่จะย้ายบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerekli: kilidi açık bir telefon, bir hesabı taşımak için yeterli olmamalı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обов’язково: розблокованого телефону недостатньо, щоб перенести обліковий запис"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ضروری: صرف کھلا ہوا فون اکاؤنٹ منتقل کرنے کے لیے کافی نہیں ہونا چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt buộc: một chiếc điện thoại đã mở khóa không đủ để chuyển tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必填：仅凭一部已解锁的手机不应足以迁移账户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必填：光是解鎖的手機不應足以更換帳號"
          }
        }
      }
    },
