    "account.phone.row.hint": {
      "comment": "VoiceOver hint for the phone row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح نموذج رقم التواصل، وهو يحتاج كلمة مرورك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগাযোগের নম্বরের ফর্ম খোলে, যেখানে পাসওয়ার্ড লাগে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el formulari del número de contacte, que requereix la contrasenya"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře formulář kontaktního čísla, který vyžaduje heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner formularen til kontaktnummer, som kræver din adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Formular für die Kontaktnummer, für das du dein Passwort brauchst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τη φόρμα αριθμού επικοινωνίας, που απαιτεί τον κωδικό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the contact number form, which needs your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el formulario del número de contacto, que requiere tu contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa yhteystietonumeron lomakkeen, joka vaatii salasanasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le formulaire du numéro de contact, qui demande votre mot de passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את טופס מספר הקשר, שדורש את הסיסמה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपर्क नंबर का फ़ॉर्म खोलता है, जिसके लिए आपका पासवर्ड चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara obrazac za kontakt broj, za koji je potrebna tvoja lozinka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a kapcsolattartási szám űrlapját, amelyhez a jelszavad kell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka formulir nomor kontak, yang butuh kata sandimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il modulo del numero di contatto, che richiede la password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが必要な連絡先番号のフォームを開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 필요한 연락처 번호 양식을 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌വേഡ് ആവശ്യമുള്ള കോൺടാക്റ്റ് നമ്പർ ഫോം തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka borang nombor hubungan yang memerlukan kata laluan anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner skjemaet for kontaktnummer, som krever passordet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent het formulier voor het contactnummer, dat je wachtwoord vereist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera formularz numeru kontaktowego, który wymaga hasła"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o formulário do número de contato, que exige sua senha"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o formulário do número de contacto, que exige a sua palavra-passe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide formularul numărului de contact, care cere parola"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает форму контактного номера, для которой нужен пароль"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí formulár kontaktného čísla, ktorý vyžaduje tvoje heslo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar formuläret för kontaktnummer, som kräver ditt lösenord"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுச்சொல் தேவைப்படும் தொடர்பு எண் படிவத்தைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌వర్డ్ అవసరమైన సంప్రదింపు నంబర్ ఫారమ్‌ను తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแบบฟอร์มหมายเลขติดต่อ ซึ่งต้องใช้รหัสผ่านของคุณ"
          }
        },
        "tr": {
