    "safety.report.submit.hint": {
      "comment": "VoiceOver hint for the submit button. %@ is the reported account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل هذا إلى مراجع في سِلة. ولا يُبلَّغ %@ بذلك."
          }
        },
        "en": {
