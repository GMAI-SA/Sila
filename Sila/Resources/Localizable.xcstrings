    "post.sensitive.show.hint": {
      "comment": "VoiceOver hint on Show. %@ is the cover title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المنشور خلف غطاء %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আবরণের নিচের পোস্টটি দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la publicació darrere de la coberta de %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příspěvek za zakrytím: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opslaget bag afdækningen %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Beitrag hinter der Abdeckung „%@“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει την ανάρτηση πίσω από το κάλυμμα «%@»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the post behind the %@ cover"
          }
