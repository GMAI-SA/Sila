    "feed.empty.following.subtitle": {
      "comment": "Empty Following feed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا منشورات الحسابات التي تتابعها، الأحدث أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যাদের ফলো করেন তাদের পোস্ট এখানে নতুনটি আগে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions dels comptes que segueixes apareixen aquí, les més noves primer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky z účtů, které sleduješ, se zobrazí zde, nejnovější první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag fra konti, du følger, vises her, de nyeste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge von Konten, denen du folgst, erscheinen hier, die neuesten zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις από λογαριασμούς που ακολουθείς εμφανίζονται εδώ, οι νεότερες πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts from accounts you follow appear here, newest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones de las cuentas que sigues aparecen aquí, las más recientes primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraamiesi tilien julkaisut näkyvät täällä, uusimmat ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts des comptes que vous suivez apparaissent ici, les plus récents d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים מחשבונות שאתה עוקב אחריהם מופיעים כאן, החדשים ראשונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिन अकाउंट को फ़ॉलो करते हैं उनकी पोस्ट यहाँ दिखती हैं, सबसे नई पहले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave računa koje pratiš pojavljuju se ovdje, najnovije prve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad követett fiókok bejegyzései itt jelennek meg, a legújabbak elöl."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan dari akun yang kamu ikuti muncul di sini, yang terbaru dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post degli account che segui compaiono qui, dal più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー中のアカウントの投稿が、新しい順にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우하는 계정의 게시물이 최신순으로 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഫോളോ ചെയ്യുന്ന അക്കൗണ്ടുകളുടെ പോസ്റ്റുകൾ ഇവിടെ പുതിയത് ആദ്യം എന്ന ക്രമത്തിൽ വരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran daripada akaun yang anda ikuti muncul di sini, terbaharu dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlegg fra kontoer du følger, vises her, de nyeste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten van accounts die je volgt verschijnen hier, nieuwste eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy z obserwowanych kont pojawiają się tutaj, od najnowszych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts das contas que você segue aparecem aqui, dos mais recentes aos mais antigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações das contas que segue aparecem aqui, das mais recentes para as mais antigas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările conturilor pe care le urmărești apar aici, cele mai noi primele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся посты аккаунтов, на которые вы подписаны, сначала новые."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky z účtov, ktoré sleduješ, sa zobrazia tu, najnovšie ako prvé."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlägg från konton du följer visas här, de nyaste först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பின்தொடரும் கணக்குகளின் இடுகைகள் புதியவை முதலில் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫాలో అయ్యే ఖాతాల పోస్ట్‌లు ఇక్కడ కనిపిస్తాయి, కొత్తవి ముందు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์จากบัญชีที่คุณติดตามจะแสดงที่นี่ โพสต์ใหม่สุดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip ettiğiniz hesapların gönderileri burada, en yeniden eskiye görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являтимуться дописи від облікових записів, на які ви підписані, — спершу найновіші."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جن اکاؤنٹس کو فالو کرتے ہیں ان کی پوسٹس یہاں نظر آتی ہیں، نئی سب سے پہلے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng từ các tài khoản bạn theo dõi xuất hiện ở đây, mới nhất trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你关注的账户发布的帖子会显示在这里，最新的在前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你追蹤的帳號的貼文會顯示在這裡，最新的在最前面。"
          }
        }
      }
    },
    "feed.empty.following.title": {
      "comment": "Empty Following feed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتابع أحدًا بعد"
