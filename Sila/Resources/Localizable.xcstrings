    "video.error.tooLarge": {
      "comment": "413 video_too_large (contract v28 §10).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم هذا الفيديو أكبر من 300 ميغابايت. اختر فيديو أقصر أو أصغر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিও ৩০০ MB-এর চেয়ে বড়। ছোট বা কম আকারের একটি ভিডিও বেছে নিন।"
          }
        },
        "ca": {
