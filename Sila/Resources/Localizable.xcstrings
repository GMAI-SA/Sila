    "document.mock.useSample.hint": {
      "comment": "Accessibility hint, simulator only.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمحاكي فقط: يتابع بصورة بديلة"
