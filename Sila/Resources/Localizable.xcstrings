    "profile.private.subtitle": {
      "comment": "Under the private wall. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى منشورات %@ إلا المتابعون الذين يوافق عليهم. أرسل طلب متابعة لتطلب ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ যাদের অনুমোদন করেন শুধু সেই ফলোয়াররাই তার পোস্ট দেখতে পায়। জানতে ফলো করার অনুরোধ পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els seguidors que %@ aprova poden veure les seves publicacions. Envia una sol·licitud de seguiment per demanar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho příspěvky vidí jen sledující, které %@ schválí. Pošli žádost o sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun følgere, som %@ godkender, kan se vedkommendes opslag. Send en følgeanmodning for at spørge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Follower, die %@ bestätigt, sehen die Beiträge. Sende eine Folgeanfrage, um zu fragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο οι ακόλουθοι που εγκρίνει ο/η %@ μπορούν να δουν τις αναρτήσεις του/της. Στείλε αίτημα ακολούθησης για να ζητήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only followers %@ approves can see their posts. Send a follow request to ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los seguidores que apruebe %@ pueden ver sus publicaciones. Envía una solicitud de seguimiento para pedirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain käyttäjän %@ hyväksymät seuraajat näkevät hänen julkaisunsa. Lähetä seurauspyyntö pyytääksesi lupaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les abonnés approuvés par %@ peuvent voir ses posts. Envoyez une demande d’abonnement pour demander."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק עוקבים ש-%@ מאשר יכולים לראות את הפוסטים שלו. שלח בקשת מעקב כדי לבקש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनकी पोस्ट सिर्फ़ वही फ़ॉलोअर देख सकते हैं जिन्हें %@ मंज़ूर करे। पूछने के लिए फ़ॉलो अनुरोध भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave može vidjeti samo pratitelj kojeg odobri korisnik %@. Pošalji zahtjev za praćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzéseit csak az általa jóváhagyott követők láthatják (%@). A kéréshez küldj követési kérést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengikut yang disetujui %@ yang bisa melihat postingannya. Kirim permintaan mengikuti untuk memintanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i follower approvati da %@ possono vedere i suoi post. Invia una richiesta di follow per chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿を見られるのは、%@が承認したフォロワーだけです。フォローリクエストを送って申請してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 승인한 팔로워만 게시물을 볼 수 있어요. 팔로우 요청을 보내 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അംഗീകരിക്കുന്ന ഫോളോവർമാർക്ക് മാത്രമേ അവരുടെ പോസ്റ്റുകൾ കാണാനാകൂ. ചോദിക്കാൻ ഒരു ഫോളോ അഭ്യർഥന അയയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengikut yang diluluskan %@ boleh melihat siarannya. Hantar permintaan ikut untuk memohon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare følgere som %@ godkjenner, kan se innleggene. Send en følgeforespørsel for å spørre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen volgers die %@ goedkeurt kunnen de berichten zien. Stuur een volgverzoek om erom te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej wpisy widzą tylko obserwujący zatwierdzeni przez: %@. Wyślij prośbę o obserwowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os seguidores que %@ aprovar podem ver os posts. Envie uma solicitação para seguir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os seguidores que %@ aprovar podem ver as suas publicações. Envie um pedido de seguimento para pedir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar urmăritorii aprobați de %@ îi pot vedea postările. Trimite o cerere de urmărire pentru a cere acces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты видят только подписчики, одобренные %@. Отправьте заявку на подписку, чтобы попросить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky môžu vidieť iba sledovatelia, ktorých schváli %@. Pošli žiadosť o sledovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara följare som %@ godkänner kan se deras inlägg. Skicka en följförfrågan för att fråga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஏற்கும் பின்தொடர்பவர்கள் மட்டுமே அவர்களின் இடுகைகளைப் பார்க்கலாம். கேட்க பின்தொடர்தல் கோரிக்கையை அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఆమోదించిన ఫాలోయర్లు మాత్రమే వారి పోస్ట్‌లను చూడగలరు. అడగడానికి ఫాలో అభ్యర్థన పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ติดตามที่ %@ อนุมัติเท่านั้นที่เห็นโพสต์ของพวกเขา ส่งคำขอติดตามเพื่อขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilerini yalnızca %@ kişisinin onayladığı takipçiler görebilir. Sormak için takip isteği gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бачити дописи можуть лише підписники, яких схвалює %@. Надішліть запит на підписку, щоб попросити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کی پوسٹس صرف وہ فالوورز دیکھ سکتے ہیں جنہیں %@ منظور کرے۔ پوچھنے کے لیے فالو کی درخواست بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người theo dõi mà %@ chấp thuận mới xem được bài đăng của họ. Hãy gửi yêu cầu theo dõi để xin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 %@ 批准的关注者才能看到其帖子。发送关注请求即可申请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
