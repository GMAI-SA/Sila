    "poll.editor.whoVotes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشورك هو السؤال. من يستطيع الرد يستطيع التصويت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পোস্টটিই প্রশ্ন। যিনি উত্তর দিতে পারেন তিনিই ভোট দিতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva publicació és la pregunta. Qui hi pugui respondre pot votar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj příspěvek je otázka. Hlasovat může každý, kdo smí odpovídat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit opslag er spørgsmålet. Alle, der må svare, må stemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beitrag ist die Frage. Wer antworten darf, darf abstimmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάρτησή σου είναι η ερώτηση. Όποιος μπορεί να απαντήσει, μπορεί να ψηφίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your post is the question. Whoever may reply may vote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu publicación es la pregunta. Quien pueda responder puede votar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaisusi on kysymys. Kuka tahansa, joka saa vastata, saa äänestää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre post est la question. Quiconque peut répondre peut voter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסט שלך הוא השאלה. מי שרשאי להגיב רשאי להצביע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट ही सवाल है। जो जवाब दे सकता है वह वोट दे सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja objava je pitanje. Glasovati može svatko tko smije odgovoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzésed a kérdés. Aki válaszolhat, az szavazhat is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postinganmu adalah pertanyaannya. Siapa pun yang boleh membalas boleh memilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo post è la domanda. Chi può rispondere può votare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの投稿が質問になります。返信できる人は投票できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 게시물이 질문이에요. 답글을 달 수 있는 사람이면 투표할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പോസ്റ്റാണ് ചോദ്യം. മറുപടി നൽകാവുന്നവർക്ക് വോട്ട് ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran anda ialah soalannya. Sesiapa yang boleh membalas boleh mengundi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlegget ditt er spørsmålet. Alle som kan svare, kan stemme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht is de vraag. Wie mag reageren, mag stemmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wpis jest pytaniem. Głosować może każdy, kto może odpowiadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu post é a pergunta. Quem puder responder pode votar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua publicação é a pergunta. Quem pode responder pode votar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postarea ta este întrebarea. Oricine poate răspunde poate vota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пост — это вопрос. Голосовать может тот, кто может отвечать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj príspevok je otázka. Hlasovať môže každý, kto môže odpovedať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt inlägg är frågan. Den som får svara får rösta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடுகையே கேள்வி. யார் பதிலளிக்கலாமோ அவர் வாக்களிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పోస్ట్ ప్రశ్న. రిప్లై ఇవ్వగలవారు ఎవరైనా ఓటు వేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ของคุณคือคำถาม ใครตอบกลับได้ก็โหวตได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderiniz sorudur. Yanıtlayabilen herkes oy verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш допис — це запитання. Голосувати може той, хто може відповідати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پوسٹ ہی سوال ہے۔ جو جواب دے سکتا ہے وہ ووٹ دے سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng của bạn là câu hỏi. Ai được trả lời thì được bình chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帖子就是问题。谁能回复，谁就能投票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貼文就是問題。誰能回覆，誰就能投票。"
          }
        }
      }
    },
    "poll.error.alreadyVoted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد صوّتّ مسبقًا. التصويت نهائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে ভোট দিয়েছেন। ভোট চূড়ান্ত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja has votat. Un vot és definitiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už jsi hlasoval. Hlas je konečný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede stemt. En stemme er endelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast bereits abgestimmt. Eine Stimme ist endgültig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ήδη ψηφίσει. Η ψήφος είναι οριστική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have already voted. A vote is final."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has votado. Un voto es definitivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo äänestänyt. Ääni on lopullinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà voté. Un vote est définitif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר הצבעת. הצבעה היא סופית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले वोट दे चुके हैं। वोट अंतिम होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već si glasao/la. Glas je konačan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már szavaztál. A szavazat végleges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah memilih. Pilihan bersifat final."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già votato. Un voto è definitivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに投票済みです。投票は変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 투표했어요. 투표는 변경할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം വോട്ട് ചെയ്തു. വോട്ട് അന്തിമമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengundi. Undi adalah muktamad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede stemt. En stemme er endelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al gestemd. Een stem is definitief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już zagłosowałeś. Głos jest ostateczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já votou. O voto é definitivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já votou. Um voto é definitivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai votat deja. Un vot este definitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже проголосовали. Голос окончательный."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už si hlasoval. Hlas je konečný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan röstat. En röst är slutgiltig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கெனவே வாக்களித்துவிட்டீர்கள். வாக்கு இறுதியானது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే ఓటు వేశారు. ఓటు అంతిమం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณโหวตแล้ว การโหวตเป็นที่สิ้นสุด"
          }
        },
        "tr": {
