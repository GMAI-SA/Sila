    "vouch.ended.reason.voucher": {
      "comment": "Why the vouch ended: the voucher lost the right. %@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بإمكان ⁦@%@⁩ أن يزكّي أحدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ আর কারও জন্য ভাউচ করতে পারেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ja no pot avalar ningú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ už nemůže za nikoho ručit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan ikke længere gå i god for nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kann für niemanden mehr bürgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ δεν μπορεί πια να εγγυάται για κανέναν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ can no longer vouch for anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ya no puede avalar a nadie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ei enää voi taata ketään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ne peut plus se porter garant de personne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ לא יכול עוד לערוב לאף אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ अब किसी के लिए वाउच नहीं कर सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ više ne može jamčiti ni za koga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ már nem kezeskedhet senkiért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak bisa lagi menjamin siapa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ non può più garantire per nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@はもう誰も保証できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님은 더 이상 누구도 보증할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ഇനി ആർക്കും വൗച്ച് ചെയ്യാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak lagi boleh menjamin sesiapa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan ikke lenger garantere for noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan voor niemand meer instaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nie może już za nikogo poręczać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não pode mais avalizar ninguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ já não pode avalizar ninguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nu mai poate garanta pentru nimeni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ больше не может ни за кого поручаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ už nemôže za nikoho ručiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kan inte längre intyga för någon."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ இனி யாருக்கும் உறுதியளிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ఇకపై ఎవరికీ హామీ ఇవ్వలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ไม่สามารถรับรองใครได้อีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ artık kimseye kefil olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ більше не може ні за кого ручатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ اب کسی کی ضمانت نہیں دے سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ không thể bảo chứng cho ai nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已无法再为任何人担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 已無法再為任何人擔保。"
          }
        }
      }
    },
