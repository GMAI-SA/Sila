          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ ইতিমধ্যে এই লিংক গ্রহণ করেছেন — এর বদলে ভাউচটি প্রত্যাখ্যান বা প্রত্যাহার করুন।"
