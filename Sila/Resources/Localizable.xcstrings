    "account.phone.unverifiedCaption": {
      "comment": "States exactly what the stored number is and is not — there is no SMS confirmation, so it is not part of the verified identity.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات تواصل فقط. لم تتحقق سِلة من أن هذا الرقم لك — لا يوجد تأكيد برسالة نصية، لذلك فهو ليس جزءًا من هويتك الموثّقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact detail only. Sila has not checked that this number is yours — there is no SMS confirmation, so it is not part of your verified identity."
          }
        }
      }
    },
    "account.picture.choose": {
      "comment": "Button when there is no picture yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photo"
          }
        }
      }
    },
    "account.picture.choose.a11yHint": {
      "comment": "VoiceOver hint for the picture picker. %lld is the size limit in megabytes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يفتح مكتبة صورك. الصور التي تتجاوز %lld ميغابايت تُرفض قبل الرفع."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يفتح مكتبة صورك. الصور التي تتجاوز %lld ميغابايت تُرفض قبل الرفع."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يفتح مكتبة صورك. الصور التي تتجاوز ميغابايت واحد تُرفض قبل الرفع."
                }
