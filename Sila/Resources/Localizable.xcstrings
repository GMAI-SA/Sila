          "stringUnit": {
            "state": "translated",
            "value": "Закрытое событие нельзя опубликовать в ленте"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzavretú udalosť nemožno dať na časovú os"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett slutet evenemang kan inte läggas i en tidslinje"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடப்பட்ட நிகழ்வைக் காலவரிசையில் இட முடியாது"
