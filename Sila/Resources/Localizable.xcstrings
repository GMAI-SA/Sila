    "search.trending.empty.subtitle": {
      "comment": "Says how trending is computed, so an empty list does not read as broken.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب الوسوم من أحدث المنشورات. وكلما بدأ الناس باستخدامها، ظهرت هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাম্প্রতিকতম পোস্ট জুড়ে ট্যাগ গোনা হয়। মানুষ হ্যাশট্যাগ ব্যবহার শুরু করলে এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les etiquetes es compten entre les publicacions més recents. A mesura que la gent comenci a fer servir etiquetes, apareixeran aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítky se počítají z nejnovějších příspěvků. Jakmile lidé začnou používat hashtagy, objeví se tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags tælles på tværs af de seneste opslag. Når folk begynder at bruge hashtags, vises de her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags werden über die neuesten Beiträge gezählt. Sobald Leute Hashtags nutzen, erscheinen sie hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ετικέτες μετρώνται στις πιο πρόσφατες αναρτήσεις. Καθώς οι άνθρωποι αρχίζουν να χρησιμοποιούν hashtag, θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags are counted across the most recent posts. As people start using hashtags, they show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas se cuentan entre las publicaciones más recientes. A medida que la gente use hashtags, aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnisteet lasketaan viimeisimmistä julkaisuista. Kun ihmiset alkavat käyttää aihetunnisteita, ne näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tags sont comptés sur les posts les plus récents. Quand les gens commenceront à utiliser des hashtags, ils apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התגיות נספרות בין הפוסטים האחרונים. כשאנשים יתחילו להשתמש בהאשטגים, הם יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग सबसे हाल की पोस्ट में गिने जाते हैं। जैसे-जैसे लोग हैशटैग इस्तेमाल करेंगे, वे यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznake se broje u najnovijim objavama. Kad ljudi počnu koristiti hashtagove, pojavit će se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címkéket a legfrissebb bejegyzések alapján számoljuk. Ahogy az emberek hashtageket kezdenek használni, itt megjelennek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag dihitung dari postingan terbaru. Saat orang mulai memakai hashtag, tag muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tag vengono contati sui post più recenti. Man mano che le persone usano gli hashtag, compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは直近の投稿から集計されます。ハッシュタグが使われ始めると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그는 가장 최근 게시물에서 집계돼요. 사람들이 해시태그를 쓰기 시작하면 여기에 나타나요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും പുതിയ പോസ്റ്റുകളിലാണ് ടാഗുകൾ എണ്ണുന്നത്. ആളുകൾ ഹാഷ്ടാഗുകൾ ഉപയോഗിച്ചു തുടങ്ങുമ്പോൾ അവ ഇവിടെ വരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg dikira merentas siaran terkini. Apabila orang mula menggunakan hashtag, ia muncul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emneknagger telles på tvers av de nyeste innleggene. Når folk begynner å bruke emneknagger, vises de her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags worden geteld over de meest recente berichten. Zodra mensen hashtags gaan gebruiken, verschijnen ze hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagi są liczone w najnowszych wpisach. Gdy ludzie zaczną używać hashtagów, pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tags são contadas entre os posts mais recentes. Conforme as pessoas começarem a usar hashtags, elas aparecerão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas são contadas nas publicações mais recentes. À medida que as pessoas começarem a usar hashtags, aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Etichetele sunt numărate din cele mai recente postări. Pe măsură ce oamenii folosesc hashtaguri, apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги подсчитываются по самым свежим постам. Когда люди начнут использовать хештеги, они появятся здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Značky sa počítajú z najnovších príspevkov. Keď ľudia začnú používať hashtagy, zobrazia sa tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggar räknas över de senaste inläggen. När folk börjar använda hashtaggar visas de här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய இடுகைகளில் உள்ள குறிச்சொற்கள் எண்ணப்படுகின்றன. மக்கள் ஹேஷ்டேக்குகளைப் பயன்படுத்தத் தொடங்கியதும் அவை இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్యాగ్‌లు ఇటీవలి పోస్ట్‌లలో లెక్కించబడతాయి. ప్రజలు హ్యాష్‌ట్యాగ్‌లు వాడటం మొదలుపెడితే అవి ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กถูกนับจากโพสต์ล่าสุด เมื่อผู้คนเริ่มใช้แฮชแท็ก แท็กจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketler en son gönderiler üzerinden sayılır. İnsanlar hashtag kullanmaya başladıkça burada görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги підраховуються за найновішими дописами. Коли люди почнуть користуватися хештегами, вони з’являться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگ تازہ ترین پوسٹس میں گنے جاتے ہیں۔ جیسے جیسے لوگ ہیش ٹیگ استعمال کرنا شروع کریں گے، وہ یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thẻ được đếm trong những bài đăng gần đây nhất. Khi mọi người bắt đầu dùng hashtag, chúng sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是在最近的帖子中统计的。随着人们开始使用话题标签，它们会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是根據最近的貼文統計的。隨著大家開始使用主題標籤，它們會出現在這裡。"
          }
        }
      }
    },
