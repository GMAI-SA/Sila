    "events.cancel.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء هذه الفعالية؟ سيُبلَّغ كل من سيحضر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইভেন্ট বাতিল করবেন? যারা যাচ্ছে সবাইকে জানানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel·lar aquest esdeveniment? S'avisarà tothom qui hi anava."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit tuto událost? Všichni, kdo jdou, budou informováni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aflys denne begivenhed? Alle, der kommer, får besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Event absagen? Alle Zusagen werden benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ακυρωθεί αυτή η εκδήλωση; Ενημερώνονται όλοι όσοι πάνε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this event? Everyone going is told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar este evento? Se avisará a todos los asistentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perutaanko tämä tapahtuma? Kaikille osallistujille ilmoitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler cet événement ? Tous les participants en seront informés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל את האירוע הזה? כל מי שמגיע יקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इवेंट रद्द करें? जो भी जा रहे हैं उन सबको बताया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkazati ovaj događaj? Svi koji dolaze bit će obaviješteni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemondod ezt az eseményt? Mindenkit értesítünk, aki ott lenne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan acara ini? Semua yang akan hadir diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare questo evento? Tutti i partecipanti verranno avvisati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このイベントを中止しますか? 参加予定の全員に通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이벤트를 취소할까요? 참석하는 모든 사람에게 알려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇവന്റ് റദ്ദാക്കണോ? പങ്കെടുക്കുന്ന എല്ലാവരെയും അറിയിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan acara ini? Semua yang akan hadir akan diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avlyse dette arrangementet? Alle som skal dit, får beskjed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit evenement annuleren? Iedereen die komt wordt op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować to wydarzenie? Wszyscy, którzy się wybierają, zostaną powiadomieni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar este evento? Todos os que vão participar serão avisados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar este evento? Todos os que vão são avisados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulezi acest eveniment? Toți cei care participă vor fi anunțați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить это событие? Все, кто идёт, получат уведомление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť túto udalosť? Všetci, ktorí sa zúčastnia, budú informovaní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställa in det här evenemanget? Alla som kommer får veta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நிகழ்வை ரத்து செய்யவா? வரவிருக்கும் அனைவருக்கும் தெரிவிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఈవెంట్‌ను రద్దు చేయాలా? వస్తున్న అందరికీ తెలియజేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกกิจกรรมนี้? ทุกคนที่จะไปจะได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etkinlik iptal edilsin mi? Katılan herkese haber verilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати цю подію? Усі, хто йде, отримають повідомлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایونٹ منسوخ کریں؟ جانے والے سب کو بتا دیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy sự kiện này? Mọi người tham dự sẽ được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消此活动？所有参加的人都会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消這個活動嗎？所有要參加的人都會收到通知。"
          }
        }
      }
    },
