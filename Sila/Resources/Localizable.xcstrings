    "events.guests.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد بعد — كن الأول"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কেউ নেই — প্রথম হোন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara ningú: sigues el primer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nikdo – buď první"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen endnu – vær den første"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand – sei die erste Person"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς ακόμα — γίνε ο πρώτος"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody yet — be the first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie aún: sé el primero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä ketään – ole ensimmäinen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne pour l’instant — soyez le premier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אף אחד — היה הראשון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई नहीं — पहले आप बनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nikoga — budi prvi/a"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még senki – légy te az első"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada — jadilah yang pertama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno: sii il primo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰もいません。最初の参加者になりましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없어요. 가장 먼저 참석해 보세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ആരുമില്ല — ആദ്യത്തെയാളാകൂ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada — jadilah yang pertama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ennå. Bli den første"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niemand: wees de eerste"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nikogo — bądź pierwszy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém ainda: seja o primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda ninguém — seja o primeiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nimeni — fii primul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока никого — будьте первым"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nikto — buď prvý"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen än – bli först"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் யாரும் இல்லை — முதலில் வாருங்கள்"
