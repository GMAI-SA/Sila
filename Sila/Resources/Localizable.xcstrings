    "verification.field.nationalId.error": {
      "comment": "Inline error under the ID field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرقم المكوّن من 10 أرقام الذي يبدأ بـ1 أو 2. إن كان صحيحًا على البطاقة فتحقق من رقم مكتوب خطأ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "১ বা ২ দিয়ে শুরু ১০ সংখ্যার নম্বরটি দিন। কার্ডে ঠিক থাকলে কোনো সংখ্যা ভুল লেখা হয়েছে কি না দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el número de 10 dígits que comença per 1 o 2. Si és correcte al document, comprova si hi ha un dígit mal escrit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej desetimístné číslo začínající 1 nebo 2. Pokud je na kartě správně, zkontroluj, zda ses nepřepsal v číslici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast det 10-cifrede nummer, der starter med 1 eller 2. Hvis det er rigtigt på kortet, så tjek for et forkert indtastet ciffer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die 10-stellige Nummer ein, die mit 1 oder 2 beginnt. Wenn sie auf der Karte stimmt, prüfe auf einen Zahlendreher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε τον 10ψήφιο αριθμό που ξεκινά με 1 ή 2. Αν είναι σωστός στην κάρτα, έλεγξε για λάθος ψηφίο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 10-digit number that starts with 1 or 2. If it's right on the card, check for a mistyped digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el número de 10 dígitos que empieza por 1 o 2. Si es correcto según la tarjeta, comprueba que no hayas escrito mal algún dígito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna 10-numeroinen luku, joka alkaa numerolla 1 tai 2. Jos se on kortissa oikein, tarkista, onko jokin numero kirjoitettu väärin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le numéro à 10 chiffres qui commence par 1 ou 2. S’il est correct sur la carte, vérifiez qu’un chiffre n’a pas été mal saisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את המספר בן 10 הספרות שמתחיל ב-1 או ב-2. אם הוא נכון בכרטיס, בדוק אם הוקלדה ספרה שגויה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 या 2 से शुरू होने वाला 10 अंकों का नंबर डालें। अगर कार्ड पर यही है, तो किसी ग़लत टाइप हुए अंक को जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi 10-znamenkasti broj koji počinje s 1 ili 2. Ako je na kartici točan, provjeri jesi li pogrešno upisao/la znamenku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a 10 számjegyű, 1-gyel vagy 2-vel kezdődő számot. Ha a kártyán ez áll, ellenőrizd, nem gépeltél-e el egy számjegyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nomor 10 digit yang diawali 1 atau 2. Jika di kartu sudah benar, periksa digit yang salah ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il numero di 10 cifre che inizia con 1 o 2. Se è giusto sulla carta, controlla di non aver sbagliato una cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1または2で始まる10桁の番号を入力してください。カードの番号が合っている場合は、入力ミスがないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1 또는 2로 시작하는 10자리 숫자를 입력하세요. 카드에 적힌 번호가 맞다면 잘못 입력한 숫자가 없는지 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "1 അല്ലെങ്കിൽ 2 കൊണ്ട് തുടങ്ങുന്ന 10 അക്ക നമ്പർ നൽകുക. കാർഡിൽ ശരിയാണെങ്കിൽ, തെറ്റായി ടൈപ്പ് ചെയ്ത അക്കമുണ്ടോ എന്ന് നോക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nombor 10 digit yang bermula dengan 1 atau 2. Jika ia betul pada kad, semak digit yang tersalah taip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn nummeret på 10 siffer som starter med 1 eller 2. Hvis det stemmer med kortet, sjekk for et feiltastet siffer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het nummer van 10 cijfers in dat met 1 of 2 begint. Als het op de kaart klopt, controleer dan op een verkeerd getypt cijfer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz 10-cyfrowy numer zaczynający się od 1 lub 2. Jeśli na karcie jest poprawny, sprawdź, czy nie wpisałeś błędnej cyfry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o número de 10 dígitos que começa com 1 ou 2. Se estiver certo no cartão, confira se não digitou algum dígito errado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o número de 10 dígitos que começa por 1 ou 2. Se está certo no cartão, verifique se algum dígito foi mal escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu numărul de 10 cifre care începe cu 1 sau 2. Dacă este corect pe card, verifică dacă ai greșit o cifră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 10-значный номер, начинающийся с 1 или 2. Если он верен на карте, проверьте, нет ли опечатки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj 10-ciferné číslo, ktoré začína číslicou 1 alebo 2. Ak je na karte správne, skontroluj preklep v číslici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange det tiosiffriga numret som börjar med 1 eller 2. Om det stämmer med kortet, kontrollera om du skrivit fel siffra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 அல்லது 2 இல் தொடங்கும் 10 இலக்க எண்ணை உள்ளிடுங்கள். அட்டையில் அது சரியாக இருந்தால், தவறாகத் தட்டச்சு செய்த இலக்கம் உள்ளதா எனப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1 లేదా 2 తో మొదలయ్యే 10 అంకెల నంబర్ నమోదు చేయండి. కార్డుపై సరిగ్గా ఉంటే, తప్పుగా టైప్ చేసిన అంకె ఉందేమో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่หมายเลข 10 หลักที่ขึ้นต้นด้วย 1 หรือ 2 หากถูกต้องตามบัตร ให้ตรวจสอบว่าพิมพ์ตัวเลขผิดหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 veya 2 ile başlayan 10 haneli numarayı girin. Kartta doğruysa yanlış yazılmış bir hane olup olmadığına bakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть 10-значний номер, що починається з 1 або 2. Якщо на картці він правильний, перевірте, чи немає помилки в цифрі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "10 ہندسوں کا وہ نمبر درج کریں جو 1 یا 2 سے شروع ہو۔ اگر کارڈ پر یہی ہے تو دیکھیں کہ کوئی ہندسہ غلط تو ٹائپ نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập số 10 chữ số bắt đầu bằng 1 hoặc 2. Nếu trên thẻ đúng như vậy, hãy kiểm tra xem có gõ nhầm chữ số nào không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入以 1 或 2 开头的 10 位数字。如果卡上的号码就是这样，请检查是否输错了某一位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入以 1 或 2 開頭的 10 位數號碼。若證件上確實如此，請檢查是否打錯了數字。"
          }
        }
      }
    },
    "verification.field.nationalId.hint": {
      "comment": "A11y hint of the ID field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشرة أرقام، تبدأ بـ1 للهوية الوطنية أو بـ2 للإقامة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দশটি সংখ্যা, জাতীয় পরিচয়ের জন্য ১ বা Iqama-র জন্য ২ দিয়ে শুরু"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deu dígits, començant per 1 per a un document nacional d'identitat o per 2 per a una Iqama"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deset číslic, začínajících 1 pro National ID nebo 2 pro Iqama"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti cifre, der starter med 1 for et nationalt id eller 2 for et Iqama"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn Ziffern, beginnend mit 1 bei einer National ID oder 2 bei einer Iqama"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δέκα ψηφία, που ξεκινούν με 1 για National ID ή 2 για Iqama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten digits, starting with 1 for a National ID or 2 for an Iqama"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez dígitos, que empiezan por 1 para un National ID o por 2 para una Iqama"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kymmenen numeroa, alkaen numerolla 1 henkilökortille tai 2 Iqamalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix chiffres, commençant par 1 pour une carte nationale ou par 2 pour une Iqama"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עשר ספרות, שמתחילות ב-1 לתעודת זהות לאומית או ב-2 ל-Iqama"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस अंक, राष्ट्रीय ID के लिए 1 से और Iqama के लिए 2 से शुरू"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deset znamenki, počinje s 1 za nacionalnu osobnu iskaznicu ili 2 za Iqamu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tíz számjegy, 1-gyel kezdődik személyi azonosítónál, 2-vel Iqamánál"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh digit, diawali 1 untuk ID Nasional atau 2 untuk Iqama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieci cifre, che iniziano con 1 per una carta d'identità nazionale o con 2 per un Iqama"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10桁。国民IDは1、Iqamaは2で始まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10자리 숫자, 신분증은 1, Iqama는 2로 시작해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പത്ത് അക്കങ്ങൾ, നാഷണൽ ഐഡിക്ക് 1 കൊണ്ടും Iqama-യ്ക്ക് 2 കൊണ്ടും തുടങ്ങുന്നത്"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh digit, bermula dengan 1 untuk National ID atau 2 untuk Iqama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti siffer, som starter med 1 for nasjonalt ID-kort eller 2 for Iqama"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tien cijfers, beginnend met 1 voor een nationale ID of 2 voor een Iqama"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziesięć cyfr, zaczynających się od 1 dla dowodu osobistego lub 2 dla Iqama"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez dígitos, começando com 1 para Identidade Nacional ou 2 para Iqama"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez dígitos, começando por 1 para um Documento Nacional ou 2 para uma Iqama"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zece cifre, începând cu 1 pentru National ID sau 2 pentru Iqama"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Десять цифр, начиная с 1 для National ID или с 2 для Iqama"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Desať číslic, začínajúcich 1 pre národný preukaz alebo 2 pre Iqama"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tio siffror, börjar med 1 för National ID eller 2 för Iqama"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பத்து இலக்கங்கள்; தேசிய அடையாள அட்டைக்கு 1 இலும் Iqama-வுக்கு 2 இலும் தொடங்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పది అంకెలు, నేషనల్ ID కి 1 తో, Iqama కి 2 తో మొదలవుతాయి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบหลัก ขึ้นต้นด้วย 1 สำหรับบัตรประจำตัวประชาชน หรือ 2 สำหรับ Iqama"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On hane; Ulusal Kimlik için 1, Iqama için 2 ile başlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Десять цифр: починається з 1 для Національного ID або з 2 для Iqama"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دس ہندسے، قومی شناختی کارڈ کے لیے 1 سے شروع اور Iqama کے لیے 2 سے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mười chữ số, bắt đầu bằng 1 với căn cước quốc gia hoặc 2 với Iqama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "十位数字，国民身份证以 1 开头，Iqama 以 2 开头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "十位數字，身分證以 1 開頭，Iqama 以 2 開頭"
          }
        }
      }
    },
