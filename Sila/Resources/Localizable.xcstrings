    "rooms.cohosts.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لثلاثة مضيفين مشاركين على الأكثر دعوة الناس إلى المنصة وكتمهم وإدارة الأسئلة والاستطلاعات وإنهاء الغرفة. أنت وحدك من يلغي أو يدعو أو يعيّن المضيفين المشاركين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ তিনজন সহ-হোস্ট মানুষকে মঞ্চে আনতে, মিউট করতে, প্রশ্ন ও পোল চালাতে এবং রুম শেষ করতে পারেন। শুধু আপনি বাতিল করতে, আমন্ত্রণ জানাতে বা সহ-হোস্ট ঠিক করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a tres coanfitrions poden fer pujar gent, silenciar, gestionar les preguntes i enquestes, i acabar la sala. Només tu pots cancel·lar, convidar o nomenar coanfitrions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až tři spoluhostitelé mohou přivádět lidi na pódium, ztlumovat, vést otázky a ankety a ukončit místnost. Jen ty můžeš rušit, zvát nebo jmenovat spoluhostitele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til tre medværter kan hente folk op, gøre lydløs, styre spørgsmål og afstemninger og afslutte rummet. Kun du kan aflyse, invitere eller udpege medværter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu drei Co-Hosts können Personen nach oben holen, stummschalten, die Fragen und Umfragen leiten und den Raum beenden. Nur du kannst absagen, einladen oder Co-Hosts ernennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως τρεις συνδιοργανωτές μπορούν να ανεβάζουν άτομα στη σκηνή, να βάζουν σε σίγαση, να διαχειρίζονται τις ερωτήσεις και τις δημοσκοπήσεις και να τερματίζουν την αίθουσα. Μόνο εσύ μπορείς να ακυρώσεις, να προσκαλέσεις ή να ορίσεις συνδιοργανωτές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to three co-hosts can bring people up, mute, run the questions and polls, and end the room. Only you can cancel, invite or name co-hosts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta tres coanfitriones pueden subir a gente, silenciar, gestionar las preguntas y encuestas, y terminar la sala. Solo tú puedes cancelar, invitar o nombrar coanfitriones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään kolme yhteisäntää voi tuoda ihmisiä lavalle, mykistää, hoitaa kysymykset ja kyselyt sekä päättää huoneen. Vain sinä voit perua huoneen, kutsua tai nimetä yhteisäntiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à trois co-animateurs peuvent faire monter des personnes, couper des micros, gérer les questions et les sondages, et terminer le salon. Vous seul pouvez annuler, inviter ou nommer des co-animateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד שלושה מארחים שותפים יכולים להעלות אנשים, להשתיק, לנהל את השאלות והסקרים, ולסיים את החדר. רק אתה יכול לבטל, להזמין או למנות מארחים שותפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम तीन सह-होस्ट लोगों को ऊपर बुला सकते हैं, म्यूट कर सकते हैं, सवाल और पोल चला सकते हैं, और रूम खत्म कर सकते हैं। रद्द करना, आमंत्रित करना या सह-होस्ट चुनना केवल आप कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tri sudomaćina mogu dovoditi ljude na pozornicu, utišavati, voditi pitanja i ankete te završiti sobu. Samo ti možeš otkazati, pozivati ili imenovati sudomaćine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb három társházigazda hozhat fel embereket, némíthat, kezelheti a kérdéseket és szavazásokat, és befejezheti a szobát. Lemondani, meghívni vagy társházigazdát megnevezni csak te tudsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga tiga co-host bisa mengundang orang naik, membisukan, menjalankan pertanyaan dan jajak pendapat, dan mengakhiri room. Hanya kamu yang bisa membatalkan, mengundang, atau menunjuk co-host."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a tre co-host possono far salire le persone, silenziare, gestire domande e sondaggi e chiudere la stanza. Solo tu puoi annullare, invitare o nominare co-host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大3人の共同ホストが、人をステージに上げる、ミュートする、質問や投票を進行する、ルームを終了する、といったことができます。中止、招待、共同ホストの指名ができるのはあなただけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공동 호스트는 최대 3명까지 사람을 무대로 올리고, 뮤트하고, 질문과 투표를 진행하고, 룸을 종료할 수 있어요. 취소, 초대, 공동 호스트 지정은 나만 할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൂന്ന് സഹ-ഹോസ്റ്റുകൾ വരെ ആളുകളെ സ്റ്റേജിൽ കൊണ്ടുവരാനും മ്യൂട്ട് ചെയ്യാനും ചോദ്യങ്ങളും പോളുകളും നടത്താനും റൂം അവസാനിപ്പിക്കാനും കഴിയും. റദ്ദാക്കാനും ക്ഷണിക്കാനും സഹ-ഹോസ്റ്റുകളെ നിശ്ചയിക്കാനും നിങ്ങൾക്ക് മാത്രമേ കഴിയൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga tiga hos bersama boleh membawa orang naik, menyenyapkan, menguruskan soalan dan tinjauan, dan menamatkan bilik. Hanya anda boleh membatalkan, menjemput atau menamakan hos bersama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil tre medverter kan hente folk opp, dempe, styre spørsmålene og avstemningene og avslutte rommet. Bare du kan avlyse, invitere eller utnevne medverter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal drie co-hosts kunnen mensen naar voren halen, dempen, de vragen en peilingen beheren en de room beëindigen. Alleen jij kunt annuleren, uitnodigen of co-hosts aanwijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do trzech współgospodarzy może zapraszać osoby na scenę, wyciszać, prowadzić pytania i ankiety oraz kończyć pokój. Tylko Ty możesz anulować, zapraszać lub wyznaczać współgospodarzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até três coanfitriões podem chamar pessoas ao palco, silenciar, conduzir as perguntas e enquetes e encerrar a sala. Só você pode cancelar, convidar ou nomear coanfitriões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até três co-anfitriões podem chamar pessoas ao palco, silenciar, gerir as perguntas e sondagens e terminar a sala. Só você pode cancelar, convidar ou nomear co-anfitriões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la trei coorganizatori pot invita oameni pe scenă, pot dezactiva microfonul, pot conduce întrebările și sondajele și pot încheia camera. Doar tu poți anula, invita sau numi coorganizatori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До трёх соведущих могут приглашать людей на сцену, заглушать, вести вопросы и опросы и завершать комнату. Отменять комнату, приглашать людей и назначать соведущих можете только вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Až traja spoluhostitelia môžu pozývať ľudí na pódium, stlmovať, viesť otázky a ankety a ukončiť miestnosť. Zrušiť, pozývať alebo určovať spoluhostiteľov môžeš iba ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till tre medvärdar kan ta upp folk på scenen, tysta, sköta frågor och omröstningar och avsluta rummet. Bara du kan ställa in, bjuda in eller utse medvärdar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூன்று இணை நடத்துநர்கள் வரை மக்களை மேடைக்கு அழைக்கவும், ஒலியடக்கவும், கேள்விகளையும் கருத்துக்கணிப்புகளையும் நடத்தவும், அறையை முடிக்கவும் முடியும். ரத்து செய்வது, அழைப்பது, இணை நடத்துநர்களைப் பெயரிடுவது நீங்கள் மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముగ్గురు వరకు సహ-హోస్ట్‌లు వ్యక్తులను పైకి తీసుకురావచ్చు, మ్యూట్ చేయవచ్చు, ప్రశ్నలు, పోల్స్ నడపవచ్చు, రూమ్‌ను ముగించవచ్చు. రద్దు చేయడం, ఆహ్వానించడం, సహ-హోస్ట్‌లను నియమించడం మీరు మాత్రమే చేయగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้จัดร่วมสูงสุดสามคนเชิญคนขึ้นเวที ปิดเสียง ดูแลคำถามและโพล และจบห้องได้ เฉพาะคุณเท่านั้นที่ยกเลิก เชิญ หรือตั้งชื่อผู้จัดร่วมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla üç ortak sunucu insanları sahneye çağırabilir, sesini kapatabilir, soruları ve anketleri yönetebilir ve odayı sonlandırabilir. Ortak sunucuyu yalnızca siz iptal edebilir, davet edebilir veya belirleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До трьох співведучих можуть запрошувати людей на сцену, вимикати мікрофон, вести запитання й опитування та завершувати кімнату. Лише ви можете скасовувати, запрошувати чи призначати співведучих."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین تک شریک میزبان لوگوں کو اوپر بلا سکتے ہیں، میوٹ کر سکتے ہیں، سوالات اور پول چلا سکتے ہیں، اور روم ختم کر سکتے ہیں۔ شریک میزبان کو منسوخ، مدعو یا نامزد صرف آپ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa ba đồng chủ trì có thể mời người lên, tắt tiếng, điều hành câu hỏi và bình chọn, và kết thúc phòng. Chỉ bạn mới hủy, mời hoặc chỉ định đồng chủ trì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多三位共同主持人可以邀请他人上台、静音、管理提问和投票，以及结束房间。只有你能取消房间、邀请或指定共同主持人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多三位共同主持人可以邀人上台、靜音、管理提問與投票，以及結束聊天室。只有你能取消、邀請或指定共同主持人。"
          }
        }
      }
    },
