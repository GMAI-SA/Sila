    "profile.requests.decline.hint": {
      "comment": "VoiceOver hint on Decline. %@ is the name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الطلب. لن يُخبَر %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরোধটি সরায়। %@-কে জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la sol·licitud. %@ no ho sap."
          }
        },
        "cs": {
