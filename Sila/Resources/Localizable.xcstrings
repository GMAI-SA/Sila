    "document.birthdate.field.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط اليوم والشهر والسنة المطبوعة في وثيقتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নথিতে ছাপা দিন, মাস ও বছর ঠিক করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el dia, el mes i l'any impresos al teu document"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav den, měsíc a rok vytištěné na dokladu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv dag, måned og år, som de står på dit dokument"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Tag, Monat und Jahr ein, wie sie in deinem Dokument stehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όρισε την ημέρα, τον μήνα και το έτος που αναγράφονται στο έγγραφό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the day, month and year printed on your document"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el día, el mes y el año impresos en tu documento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta asiakirjaasi painettu päivä, kuukausi ja vuosi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez le jour, le mois et l’année imprimés sur votre document"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר את היום, החודש והשנה המודפסים במסמך שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने दस्तावेज़ पर छपा दिन, महीना और साल सेट करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi dan, mjesec i godinu otisnute na tvojoj ispravi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be az okmányodra nyomtatott napot, hónapot és évet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur hari, bulan, dan tahun yang tercetak di dokumenmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta giorno, mese e anno stampati sul tuo documento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類に印字されている日、月、年を設定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 인쇄된 일, 월, 연도를 설정하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖയിൽ അച്ചടിച്ച ദിവസം, മാസം, വർഷം എന്നിവ സജ്ജമാക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan hari, bulan dan tahun yang tercetak pada dokumen anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi dagen, måneden og året som står på dokumentet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de dag, maand en het jaar in zoals op je document staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw dzień, miesiąc i rok wydrukowane na dokumencie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o dia, o mês e o ano impressos no seu documento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o dia, o mês e o ano impressos no seu documento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează ziua, luna și anul tipărite pe document"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите день, месяц и год, напечатанные в документе"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav deň, mesiac a rok vytlačené na tvojom doklade"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange dag, månad och år som står på ditt dokument"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்தில் அச்சிடப்பட்ட நாள், மாதம், ஆண்டை அமையுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రంపై ముద్రించిన రోజు, నెల, సంవత్సరాన్ని సెట్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งวัน เดือน และปีที่พิมพ์บนเอกสารของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenizde yazan gün, ay ve yılı ayarlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть день, місяць і рік, надруковані у вашому документі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے دستاویز پر چھپا ہوا دن، مہینہ اور سال سیٹ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ngày, tháng và năm in trên giấy tờ của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置证件上印有的日、月、年"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定證件上印的日、月、年"
          }
        }
      }
    },
    "document.birthdate.message": {
      "comment": "Birthdate step body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمامًا كما هو مطبوع في وثيقتك. يُقارن بالمنطقة المقروءة آليًا في الوثيقة نفسها، فأي خطأ هنا يصبح عدم تطابق لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নথিতে যেমন ছাপা আছে হুবহু তেমন। এটি নথির নিজস্ব মেশিন-রিডেবল জোনের সাথে মেলানো হয়, তাই এখানে ভুল হলে পরে অমিল দেখা দেবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactament com apareix impresa al document. Es comprova amb la zona de lectura mecànica del mateix document, així que un error aquí serà una discrepància més endavant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesně tak, jak je vytištěno na dokladu. Kontroluje se vůči strojově čitelné zóně dokladu, takže překlep tady znamená později neshodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præcis som den står på dit dokument. Den kontrolleres mod dokumentets egen maskinlæsbare zone, så en fejl her giver en uoverensstemmelse senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau so, wie es in deinem Dokument steht. Es wird mit der maschinenlesbaren Zone des Dokuments abgeglichen; ein Tippfehler hier führt später zu einer Abweichung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακριβώς όπως αναγράφεται στο έγγραφό σου. Ελέγχεται με τη μηχαναγνώσιμη ζώνη του ίδιου του εγγράφου, οπότε ένα λάθος εδώ σημαίνει ασυμφωνία αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly as printed on your document. It's checked against the document's own machine-readable zone, so a slip here is a mismatch later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactamente como figura en tu documento. Se contrasta con la zona legible por máquina del propio documento, así que un descuido aquí será una discrepancia más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täsmälleen kuten asiakirjassasi lukee. Se tarkistetaan asiakirjan omaa koneluettavaa aluetta vastaan, joten lipsahdus tässä on epäsuhta myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactement comme imprimée sur votre document. Elle est comparée à la zone lisible par machine du document : une erreur ici provoquera une divergence plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיוק כפי שהוא מודפס במסמך שלך. הוא נבדק מול האזור הקריא-מכונה של המסמך עצמו, ולכן טעות כאן תהפוך לאי-התאמה בהמשך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक वैसी जैसी आपके दस्तावेज़ पर छपी है। इसे दस्तावेज़ के अपने मशीन-रीडेबल ज़ोन से मिलाया जाता है, इसलिए यहाँ की चूक बाद में मेल न खाने की वजह बनती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Točno kako je otisnuto na tvojoj ispravi. Provjerava se prema strojno čitljivoj zoni same isprave, pa greška ovdje kasnije znači nepodudaranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontosan úgy, ahogy az okmányodra van nyomtatva. A rendszer az okmány gépileg olvasható zónájával veti össze, így egy elírás később eltérést okoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persis seperti tercetak di dokumenmu. Tanggal ini dicocokkan dengan zona yang dapat dibaca mesin pada dokumen, jadi salah di sini berarti tidak cocok nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esattamente come stampata sul documento. Viene confrontata con la zona a lettura ottica del documento stesso, quindi un errore qui diventa una discrepanza dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類に印字されているとおりに入力してください。書類自身の機械読み取りゾーンと照合されるため、ここでの入力ミスはあとで不一致になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 인쇄된 그대로 입력하세요. 문서의 MRZ(기계 판독 영역)와 대조하므로, 여기서 실수하면 나중에 불일치가 생겨요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖയിൽ അച്ചടിച്ചതുപോലെ തന്നെ. രേഖയിലെ മെഷീൻ-റീഡബിൾ സോണുമായി ഇത് ഒത്തുനോക്കും, അതിനാൽ ഇവിടത്തെ ഒരു പിഴവ് പിന്നീട് പൊരുത്തക്കേടാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat seperti yang tercetak pada dokumen anda. Ia disemak dengan zon boleh baca mesin pada dokumen itu sendiri, jadi satu silap di sini menjadi ketidakpadanan kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøyaktig slik den står på dokumentet. Den kontrolleres mot dokumentets egen maskinlesbare sone, så en feil her blir en uoverensstemmelse senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precies zoals op je document staat. Het wordt gecontroleerd met de machineleesbare zone van het document, dus een foutje hier wordt later een afwijking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładnie tak, jak na dokumencie. Jest porównywana ze strefą odczytu maszynowego dokumentu, więc pomyłka tutaj oznacza później niezgodność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente como está impressa no documento. Ela é conferida com a zona legível por máquina do próprio documento, então um deslize aqui vira uma divergência depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente como está impressa no seu documento. É comparada com a zona de leitura ótica do próprio documento, por isso um erro aqui torna-se uma divergência mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact cum este tipărită pe document. Este comparată cu zona lizibilă automat a documentului, deci o greșeală aici devine o nepotrivire mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно так, как напечатано в документе. Она сверяется с машиночитаемой зоной документа, так что опечатка здесь обернётся несовпадением позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presne tak, ako je vytlačený na tvojom doklade. Kontroluje sa s strojovo čitateľnou zónou dokladu, takže chyba tu sa neskôr prejaví ako nezhoda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakt som det står på ditt dokument. Det kontrolleras mot dokumentets egen maskinläsbara zon, så ett fel här blir en avvikelse senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்தில் அச்சிடப்பட்டபடியே. இது ஆவணத்தின் இயந்திரம் படிக்கும் பகுதியுடன் சரிபார்க்கப்படும், எனவே இங்கே தவறினால் பின்னர் பொருந்தாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రంపై ముద్రించినట్లే సరిగ్గా నమోదు చేయండి. ఇది పత్రంలోని మెషిన్-రీడబుల్ జోన్‌తో సరిపోల్చబడుతుంది, కాబట్టి ఇక్కడ పొరపాటు తర్వాత అసమతుల్యతగా మారుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงตามที่พิมพ์บนเอกสารของคุณ ระบบจะตรวจกับโซนที่เครื่องอ่านได้ของเอกสารเอง ดังนั้นหากพลาดตรงนี้ภายหลังจะไม่ตรงกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenizde yazdığı gibi tam olarak girin. Belgenin kendi makine tarafından okunabilir bölgesiyle karşılaştırılır, bu yüzden buradaki bir hata sonra uyuşmazlık olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно так, як надруковано у вашому документі. Вона звіряється з машинозчитуваною зоною документа, тож помилка тут обернеться розбіжністю пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بالکل ویسے ہی جیسے آپ کے دستاویز پر چھپی ہے۔ اس کا موازنہ دستاویز کے مشین ریڈایبل زون سے کیا جاتا ہے، اس لیے یہاں کی غلطی بعد میں عدم مطابقت بن جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng như in trên giấy tờ của bạn. Ngày này được đối chiếu với vùng đọc được bằng máy của giấy tờ, nên nhập sai ở đây sẽ gây lệch về sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请与证件上印的完全一致。它会与证件自带的机读区进行核对，这里一旦出错，之后就会不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請與證件上印的完全一致。系統會與證件本身的機器可讀區比對，這裡出錯，之後就會不相符。"
          }
        }
      }
    },
    "document.birthdate.privacy": {
      "comment": "Privacy note.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتفظ بتاريخ ميلادك للتحقق من عمرك ووثيقتك. ولا يظهر أبدًا في ملفك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বয়স ও নথি যাচাইয়ের জন্য জন্মতারিখ রাখা হয়। এটি কখনও আপনার প্রোফাইলে দেখানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva data de naixement es conserva per comprovar la teva edat i el teu document. No es mostra mai al teu perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum narození se uchovává ke kontrole tvého věku a dokladu. Nikdy se nezobrazuje na profilu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fødselsdato gemmes for at kontrollere din alder og dit dokument. Den vises aldrig på din profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Geburtsdatum wird nur zur Prüfung deines Alters und deines Dokuments gespeichert. Es wird nie in deinem Profil angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία γέννησής σου διατηρείται για τον έλεγχο της ηλικίας και του εγγράφου σου. Δεν εμφανίζεται ποτέ στο προφίλ σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your date of birth is kept to check your age and your document. It is never shown on your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fecha de nacimiento se guarda para comprobar tu edad y tu documento. Nunca se muestra en tu perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syntymäaikasi säilytetään iän ja asiakirjasi tarkistamista varten. Sitä ei koskaan näytetä profiilissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre date de naissance est conservée pour vérifier votre âge et votre document. Elle n’est jamais affichée sur votre profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך הלידה שלך נשמר כדי לבדוק את גילך ואת המסמך שלך. הוא אף פעם לא מוצג בפרופיל שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी जन्म तिथि आपकी उम्र और दस्तावेज़ की जाँच के लिए रखी जाती है। यह आपकी प्रोफ़ाइल पर कभी नहीं दिखती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj datum rođenja čuva se radi provjere tvoje dobi i isprave. Nikada se ne prikazuje na tvom profilu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A születési dátumodat az életkorod és az okmányod ellenőrzésére őrizzük meg. A profilodon soha nem jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal lahirmu disimpan untuk memeriksa usia dan dokumenmu. Tidak pernah ditampilkan di profilmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua data di nascita viene conservata per verificare la tua età e il tuo documento. Non viene mai mostrata sul tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生年月日は、年齢と書類の確認のために保管されます。プロフィールに表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생년월일은 나이와 문서를 확인하기 위해서만 보관돼요. 프로필에는 절대 표시되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രായവും രേഖയും പരിശോധിക്കാൻ ജനനത്തീയതി സൂക്ഷിക്കുന്നു. ഇത് നിങ്ങളുടെ പ്രൊഫൈലിൽ ഒരിക്കലും കാണിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh lahir anda disimpan untuk menyemak umur dan dokumen anda. Ia tidak pernah dipaparkan pada profil anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdatoen din lagres for å kontrollere alderen din og dokumentet ditt. Den vises aldri på profilen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geboortedatum wordt bewaard om je leeftijd en je document te controleren. Hij wordt nooit op je profiel getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data urodzenia jest przechowywana w celu sprawdzenia Twojego wieku i dokumentu. Nigdy nie jest widoczna na profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua data de nascimento é guardada para conferir sua idade e seu documento. Ela nunca aparece no seu perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua data de nascimento é guardada para verificar a sua idade e o seu documento. Nunca é mostrada no seu perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data nașterii este păstrată pentru a verifica vârsta și documentul. Nu apare niciodată în profilul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата рождения хранится для проверки вашего возраста и документа. Она никогда не показывается в профиле."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj dátum narodenia sa uchováva na kontrolu veku a dokladu. Nikdy sa nezobrazuje na tvojom profile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt födelsedatum sparas för att kontrollera din ålder och ditt dokument. Det visas aldrig på din profil."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வயதையும் ஆவணத்தையும் சரிபார்க்க மட்டுமே பிறந்த தேதி வைக்கப்படுகிறது. அது உங்கள் சுயவிவரத்தில் ஒருபோதும் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వయస్సును, పత్రాన్ని తనిఖీ చేయడానికి మీ పుట్టిన తేదీని ఉంచుతాం. అది మీ ప్రొఫైల్‌లో ఎప్పుడూ కనిపించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบเก็บวันเกิดของคุณไว้เพื่อตรวจสอบอายุและเอกสารของคุณ และจะไม่แสดงในโปรไฟล์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum tarihiniz, yaşınızı ve belgenizi kontrol etmek için saklanır. Profilinizde asla gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша дата народження зберігається, щоб перевірити ваш вік і документ. Вона ніколи не показується у вашому профілі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تاریخ پیدائش آپ کی عمر اور دستاویز جانچنے کے لیے رکھی جاتی ہے۔ یہ آپ کے پروفائل پر کبھی نہیں دکھائی جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày sinh của bạn được giữ để kiểm tra độ tuổi và giấy tờ. Nó không bao giờ hiển thị trên hồ sơ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的出生日期仅用于核对年龄和证件，绝不会显示在你的个人主页上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的出生日期僅用於檢查你的年齡和證件，絕不會顯示在你的個人檔案上。"
          }
        }
      }
    },
