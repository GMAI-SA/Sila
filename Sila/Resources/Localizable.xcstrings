    "safety.suspended.checkAgain.hint": {
      "comment": "VoiceOver hint for the check-again button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد قراءة حالة إيقافك من «معروف»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known থেকে আপনার স্থগিতাদেশ আবার পড়ে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a llegir la teva suspensió des de Known"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu načte tvé pozastavení z aplikace Known"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter din suspension fra Known igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deine Sperre erneut von Known ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει ξανά την αναστολή σου από το Known"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reads your suspension from Known"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer tu suspensión desde Known"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee jäädytyksesi uudelleen Knownilta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit votre suspension depuis Known"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קורא שוב את ההשעיה שלך מ-Known"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known से आपका निलंबन दोबारा पढ़ता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno čita tvoju suspenziju iz aplikacije Known"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra beolvassa a felfüggesztésedet a Knowntól"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca ulang penangguhanmu dari Known"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilegge da Known lo stato della tua sospensione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止の状況をKnownから再取得します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known에서 정지 상태를 다시 불러와요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ൽ നിന്ന് നിങ്ങളുടെ സസ്പെൻഷൻ വീണ്ടും വായിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca semula penggantungan anda daripada Known"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser suspensjonen din på nytt fra Known"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest je schorsing opnieuw van Known"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie pobiera z Known informacje o zawieszeniu"
