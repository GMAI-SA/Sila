    "communities.create.unverified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق هويتك قبل فتح مجتمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমিউনিটি খোলার আগে আপনার পরিচয় যাচাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la teva identitat abans d'obrir una comunitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před otevřením komunity ověř svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificér din identitet, før du åbner et fællesskab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiziere deine Identität, bevor du eine Community eröffnest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαλήθευσε την ταυτότητά σου πριν ανοίξεις κοινότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity before opening a community."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu identidad antes de abrir una comunidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista henkilöllisyytesi ennen yhteisön perustamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité avant d’ouvrir une communauté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמת את זהותך לפני שתפתח קהילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम्युनिटी शुरू करने से पहले अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi svoj identitet prije otvaranja zajednice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közösség megnyitása előtt hitelesítsd a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi identitasmu sebelum membuka komunitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la tua identità prima di aprire una community."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティを開設する前に本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티를 열기 전에 신원을 인증하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കമ്മ്യൂണിറ്റി തുടങ്ങുന്നതിന് മുമ്പ് നിങ്ങളുടെ ഐഡന്റിറ്റി പരിശോധിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan identiti anda sebelum membuka komuniti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiser identiteten din før du oppretter et fellesskap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer je identiteit voordat je een community opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikuj swoją tożsamość, zanim utworzysz społeczność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade antes de abrir uma comunidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a sua identidade antes de abrir uma comunidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică-ți identitatea înainte de a deschide o comunitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите личность, прежде чем открывать сообщество."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred otvorením komunity over svoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiera din identitet innan du öppnar en community."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமூகத்தைத் தொடங்கும் முன் உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కమ్యూనిటీని ప్రారంభించే ముందు మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันตัวตนของคุณก่อนเปิดชุมชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk açmadan önce kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верифікуйте свою особу, перш ніж відкривати спільноту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمیونٹی شروع کرنے سے پہلے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh danh tính trước khi mở cộng đồng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建社区前请先验证你的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開設社群前，請先驗證你的身分。"
          }
        }
      }
    },
    "communities.create.verifiedOnly.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للجميع القراءة؛ والنشر للموثّقين فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ পড়তে পারবে; শুধু ভেরিফায়েড অ্যাকাউন্ট পোস্ট করতে পারবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom pot llegir; només els comptes verificats poden publicar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číst může každý; psát jen ověřené účty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan læse; kun verificerede konti kan slå op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle dürfen lesen; nur verifizierte Konten dürfen posten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλοι μπορούν να διαβάζουν· μόνο οι επαληθευμένοι λογαριασμοί μπορούν να δημοσιεύουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone may read; only verified accounts may post."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede leer; solo las cuentas verificadas pueden publicar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa voi lukea; vain vahvistetut tilit voivat julkaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut lire ; seuls les comptes vérifiés peuvent publier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול לקרוא; רק חשבונות מאומתים יכולים לפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी पढ़ सकता है; केवल सत्यापित अकाउंट पोस्ट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko može čitati; objavljivati mogu samo potvrđeni računi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki olvashat; csak hitelesített fiókok írhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun boleh membaca; hanya akun terverifikasi yang boleh memposting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti possono leggere; solo gli account verificati possono pubblicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰でも読めますが、投稿できるのは認証済みアカウントだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 읽을 수 있고, 인증된 계정만 게시할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആർക്കും വായിക്കാം; പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ പോസ്റ്റ് ചെയ്യാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa boleh membaca; hanya akaun yang disahkan boleh menyiar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan lese. Bare verifiserte kontoer kan publisere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen mag lezen; alleen geverifieerde accounts mogen posten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może czytać; wpisy mogą pisać tylko zweryfikowane konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode ler; só contas verificadas podem postar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode ler; só contas verificadas podem publicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate citi; doar conturile verificate pot posta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать может любой; публиковать — только проверенные аккаунты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítať môže ktokoľvek; príspevky môžu písať iba overené účty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla får läsa; bara verifierade konton får publicera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாரும் படிக்கலாம்; சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே இடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా చదవవచ్చు; ధృవీకరించబడిన ఖాతాలు మాత్రమే పోస్ట్ చేయగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็อ่านได้ แต่โพสต์ได้เฉพาะบัญชีที่ยืนยันตัวตนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes okuyabilir; yalnızca doğrulanmış hesaplar gönderi paylaşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читати може будь-хто; публікувати — лише верифіковані облікові записи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی پڑھ سکتا ہے؛ صرف تصدیق شدہ اکاؤنٹ پوسٹ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng đọc được; chỉ tài khoản đã xác minh mới được đăng bài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以阅读；只有已验证的账户可以发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能閱讀，只有已驗證的帳號能發文。"
          }
        }
      }
    },
