    "guest.join.follow.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصنع خلاصة من الأشخاص الذين تريد سماعهم فعلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাদের কথা সত্যিই শুনতে চান, তাদের নিয়ে নিজের টাইমলাইন গড়ুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cronologia amb les persones que realment vols escoltar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoř si časovou osu lidí, které opravdu chceš slyšet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byg en tidslinje med de folk, du virkelig vil høre fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue eine Timeline mit den Menschen auf, von denen du wirklich hören willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξε μια ροή με τα άτομα που θέλεις πραγματικά να ακούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a timeline of the people you actually want to hear from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cronología con las personas a las que de verdad quieres escuchar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenna aikajana ihmisistä, joilta todella haluat kuulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Composez un fil avec les personnes que vous voulez vraiment entendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנה ציר זמן של האנשים שאתה באמת רוצה לשמוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन लोगों की टाइमलाइन बनाएँ जिन्हें आप सच में सुनना चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izradi vremensku traku od ljudi koje stvarno želiš slušati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Építs idővonalat azokból, akiket tényleg hallani szeretnél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun timeline dari orang-orang yang benar-benar ingin kamu dengar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci una timeline con le persone da cui vuoi davvero sentire qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に声を聞きたい人たちのタイムラインを作りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 듣고 싶은 사람들로 나만의 타임라인을 만들어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ശരിക്കും കേൾക്കാൻ ആഗ്രഹിക്കുന്നവരുടെ ഒരു ടൈംലൈൻ ഉണ്ടാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bina garis masa orang yang benar-benar anda mahu dengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg en tidslinje med folkene du faktisk vil høre fra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw een tijdlijn op met de mensen van wie je echt wilt horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj oś czasu z osób, które naprawdę chcesz czytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte uma linha do tempo com as pessoas que você realmente quer ouvir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa uma cronologia com as pessoas que realmente quer ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Construiește-ți un flux cu oamenii pe care chiar vrei să-i auzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите ленту из людей, которых вам действительно интересно слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvor si časovú os z ľudí, ktorých chceš naozaj počúvať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg en tidslinje med de personer du verkligen vill höra från."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உண்மையிலேயே கேட்க விரும்புபவர்களின் காலவரிசையை உருவாக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నిజంగా వినాలనుకునే వ్యక్తుల టైమ్‌లైన్‌ను నిర్మించుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างไทม์ไลน์จากคนที่คุณอยากฟังจริงๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekten duymak istediğiniz kişilerden oluşan bir zaman akışı kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть стрічку з тих людей, яких ви справді хочете слухати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان لوگوں کی ٹائم لائن بنائیں جنہیں آپ واقعی سننا چاہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây dựng dòng thời gian gồm những người bạn thực sự muốn nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打造一条只包含你真正想听到其声音的人的时间线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打造一個只有你真正想聽的人的時間軸。"
          }
        }
      }
    },
