    "notifications.kind.vouchEnded.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند انتهاء تزكية منحتها أو تحملها، وسبب ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেওয়া বা বহন করা কোনো সুপারিশ শেষ হলে, এবং কেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan acaba un aval que has donat o tens, i per què."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když skončí ručení, které jsi dal nebo nesl, a proč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en garanti, du har givet eller har, ophører, og hvorfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Bürgschaft, die du gegeben hast oder trägst, endet, und warum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν λήγει μια εγγύηση που έδωσες ή φέρεις, και γιατί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a vouch you gave or carry ends, and why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termina un aval que diste o que tienes, y por qué."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun antamasi tai kantamasi takuu päättyy, ja miksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une caution que vous avez donnée ou portez prend fin, et pourquoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשערבות שנתת או שאתה נושא מסתיימת, ומדוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपका दिया या निभाया वाउच खत्म हो, और क्यों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad jamstvo koje si dao/la ili nosiš završi, i zašto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy általad vállalt vagy rád vonatkozó kezesség véget ér, és miért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat jaminan yang kamu berikan atau emban berakhir, dan alasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una garanzia che hai dato o che porti termina, e perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが与えた、または受けている保証が終了したとき。理由付き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 했거나 받은 보증이 종료될 때와 그 이유."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നൽകിയതോ വഹിക്കുന്നതോ ആയ ഒരു ഉറപ്പ് അവസാനിക്കുമ്പോൾ, കാരണത്തോടെ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila jaminan yang anda berikan atau pikul berakhir, dan sebabnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en garanti du ga eller har, avsluttes, og hvorfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een garantie die je gaf of draagt eindigt, en waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy poręczenie, które udzieliłeś lub które Cię obejmuje, się kończy, i dlaczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um aval que você deu ou recebeu termina, e por quê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um aval que deu ou que tem termina, e porquê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când o garanție pe care ai dat-o sau o porți se încheie, și de ce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда поручительство, которое вы дали или которое за вами, заканчивается, и почему."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa skončí ručenie, ktoré si dal alebo máš, a prečo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När ett intygande du gav eller bär upphör, och varför."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அளித்த அல்லது பெற்ற உத்தரவாதம் முடிவடையும்போது, ஏன் என்பதுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇచ్చిన లేదా పొందిన హామీ ముగిసినప్పుడు, ఎందుకో కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการยืนยันให้ที่คุณให้หรือถือไว้สิ้นสุด และเหตุผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiğiniz veya taşıdığınız bir kefillik sona erdiğinde ve nedeni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли поручительство, яке ви дали або маєте, закінчується, і чому."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کی دی ہوئی یا آپ پر موجود ضمانت ختم ہو، اور کیوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một lời bảo chứng bạn đã trao hoặc đang mang kết thúc, và lý do."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你提供或获得的担保结束时，以及原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你給予或受到的擔保結束時，以及原因。"
          }
        }
      }
    },
