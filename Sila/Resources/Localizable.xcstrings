    "auth.wall.inProgress.message": {
      "comment": "Wall body when verification was abandoned part-way.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت التوثيق ولم تُكمله. تابع من حيث توقفت — لم يضع شيء مما أرسلته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ভেরিফিকেশন শুরু করেছিলেন কিন্তু শেষ করেননি। যেখানে ছেড়েছিলেন সেখান থেকে শুরু করুন — আপনার জমা দেওয়া কিছুই হারায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas començar a verificar-te però no vas acabar. Continua on ho vas deixar: no s'ha perdut res del que vas enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začal jsi se ověřovat, ale nedokončil. Pokračuj tam, kde jsi skončil – nic z odeslaného se neztratilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du begyndte at verificere, men blev ikke færdig. Fortsæt, hvor du slap – intet af det, du har sendt, er gået tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Verifizierung begonnen, aber nicht beendet. Mach dort weiter, wo du aufgehört hast – nichts von dem, was du eingereicht hast, ist verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνησες την επαλήθευση αλλά δεν την ολοκλήρωσες. Συνέχισε από εκεί που σταμάτησες — τίποτα από όσα υπέβαλες δεν χάθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You started verifying but didn't finish. Pick up where you left off — nothing you submitted has been lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezaste a verificarte pero no terminaste. Retoma donde lo dejaste: no se ha perdido nada de lo que enviaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitit vahvistuksen mutta et saanut sitä valmiiksi. Jatka siitä, mihin jäit – mitään lähettämääsi ei ole menetetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez commencé la vérification sans la terminer. Reprenez où vous en étiez — rien de ce que vous avez envoyé n’a été perdu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלת לאמת אבל לא סיימת. המשך מהמקום שבו עצרת — שום דבר ממה ששלחת לא אבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने सत्यापन शुरू किया था पर पूरा नहीं किया। जहाँ छोड़ा था वहीं से शुरू करें — आपने जो कुछ सबमिट किया वह सुरक्षित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Započeo/Započela si provjeru, ali je nisi završio/završila. Nastavi gdje si stao/stala — ništa što si poslao/poslala nije izgubljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elkezdted a hitelesítést, de nem fejezted be. Folytasd ott, ahol abbahagytad – semmi nem veszett el abból, amit beküldtél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mulai memverifikasi tetapi belum selesai. Lanjutkan dari tempat terakhir — tidak ada yang hilang dari yang sudah kamu kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai iniziato la verifica ma non l'hai finita. Riparti da dove eri rimasto: nulla di ciò che hai inviato è andato perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証を始めましたが、完了していません。途中から再開できます。送信した内容は失われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증을 시작했지만 끝내지 않았어요. 멈춘 곳에서 이어서 하세요. 제출한 내용은 하나도 사라지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ പരിശോധന തുടങ്ങിയെങ്കിലും പൂർത്തിയാക്കിയില്ല. നിർത്തിയിടത്തുനിന്ന് തുടരാം — സമർപ്പിച്ചതൊന്നും നഷ്ടമായിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mula mengesahkan tetapi belum selesai. Sambung dari tempat anda berhenti — tiada apa yang anda hantar telah hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du begynte å verifisere deg, men ble ikke ferdig. Fortsett der du slapp. Ingenting du har sendt inn, er gått tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent begonnen met verifiëren maar niet klaar gekomen. Ga verder waar je gebleven was: er is niets verloren gegaan van wat je hebt ingediend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacząłeś weryfikację, ale jej nie dokończyłeś. Wróć tam, gdzie skończyłeś — nic, co wysłałeś, nie przepadło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você começou a verificação, mas não terminou. Continue de onde parou: nada do que você enviou foi perdido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começou a verificar mas não terminou. Retome onde ficou — nada do que enviou se perdeu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai început verificarea, dar nu ai terminat-o. Continuă de unde ai rămas — nimic din ce ai trimis nu s-a pierdut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы начали проверку, но не закончили. Продолжите с того же места — ничего из отправленного не потеряно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overenie si začal, ale nedokončil. Pokračuj tam, kde si skončil — nič z toho, čo si odoslal, sa nestratilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du började verifiera dig men blev inte klar. Fortsätt där du slutade – inget du skickat in har gått förlorat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கத் தொடங்கினீர்கள், ஆனால் முடிக்கவில்லை. விட்ட இடத்திலிருந்து தொடருங்கள் — நீங்கள் சமர்ப்பித்தவை எதுவும் இழக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ధృవీకరణ మొదలుపెట్టారు కానీ పూర్తి చేయలేదు. ఆపిన చోటి నుండి కొనసాగించండి — మీరు సమర్పించినదేదీ కోల్పోలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเริ่มยืนยันตัวตนแล้วแต่ยังไม่เสร็จ ทำต่อจากที่ค้างไว้ สิ่งที่คุณส่งไปไม่สูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulamaya başladınız ama bitirmediniz. Kaldığınız yerden devam edin; gönderdiğiniz hiçbir şey kaybolmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви почали верифікацію, але не завершили. Продовжте з того місця, де зупинилися — нічого з надісланого не втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے تصدیق شروع کی تھی مگر مکمل نہیں کی۔ جہاں چھوڑا تھا وہیں سے جاری رکھیں — آپ کی جمع کرائی گئی کوئی چیز ضائع نہیں ہوئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bắt đầu xác minh nhưng chưa xong. Hãy tiếp tục từ chỗ bạn dừng — những gì bạn đã gửi không bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已开始验证但尚未完成。从上次中断的地方继续即可，你提交的内容都没有丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已開始驗證但尚未完成。從上次中斷的地方繼續即可，你送出的內容都沒有遺失。"
          }
        }
      }
    },
    "auth.wall.inProgress.title": {
      "comment": "Wall headline when verification was abandoned part-way.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل توثيقك"
          }
        },
        "bn": {
