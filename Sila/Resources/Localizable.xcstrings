    "verification.method.saudiOnly": {
      "comment": "Shown instead of the document option for a Saudi claim.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترت الجنسية السعودية، لذا نفاذ هو طريقك — فوري، بهويتك الوطنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সৌদি জাতীয়তা বেছেছেন, তাই Nafath-ই আপনার পথ — তাৎক্ষণিক, আপনার জাতীয় পরিচয় দিয়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has triat la nacionalitat saudita, així que Nafath és la teva via: instantània, amb el teu document nacional d'identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybral sis saúdskou státní příslušnost, takže tvá cesta je Nafath – okamžitě, s National ID."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valgte saudisk nationalitet, så Nafath er din vej – øjeblikkeligt, med dit nationale id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die saudische Staatsangehörigkeit gewählt, daher ist Nafath dein Weg – sofort, mit deiner National ID."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επέλεξες σαουδαραβική υπηκοότητα, οπότε το Nafath είναι η διαδρομή σου — άμεσα, με το National ID σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose Saudi nationality, so Nafath is your route — instant, with your National ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste la nacionalidad saudí, así que Nafath es tu vía: instantánea, con tu National ID."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsit Saudi-Arabian kansalaisuuden, joten Nafath on reittisi – välitön, henkilökortillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez choisi la nationalité saoudienne, Nafath est donc votre voie — instantanée, avec votre carte nationale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרת באזרחות סעודית, ולכן Nafath היא הדרך שלך — מיידית, עם תעודת הזהות הלאומית שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने सऊदी राष्ट्रीयता चुनी, इसलिए Nafath आपका रास्ता है — तुरंत, आपकी राष्ट्रीय ID से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrao/la si saudijsko državljanstvo pa je Nafath tvoj put — trenutačno, s tvojom nacionalnom osobnom iskaznicom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szaúdi állampolgárságot választottál, ezért a Nafath az utad – azonnali, a személyi azonosítóddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memilih kewarganegaraan Saudi, jadi Nafath adalah jalurmu — instan, dengan ID Nasionalmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai scelto la nazionalità saudita, quindi la tua strada è Nafath: immediato, con la tua carta d'identità nazionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウジ国籍を選んだため、Nafathをご利用ください。国民IDで即時に完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사우디 국적을 선택했으므로 Nafath가 인증 방법이에요. 신분증으로 즉시 처리돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സൗദി ദേശീയത തിരഞ്ഞെടുത്തു, അതിനാൽ നിങ്ങളുടെ വഴി Nafath ആണ് — നാഷണൽ ഐഡി ഉപയോഗിച്ച് തൽക്ഷണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memilih kewarganegaraan Saudi, jadi Nafath ialah laluan anda — serta-merta, dengan National ID anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valgte saudisk nasjonalitet, så Nafath er veien din: umiddelbart, med nasjonalt ID-kort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je koos de Saoedische nationaliteit, dus Nafath is je route: direct, met je nationale ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrałeś obywatelstwo saudyjskie, więc Twoją drogą jest Nafath — natychmiast, z dowodem osobistym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escolheu a nacionalidade saudita, então o Nafath é o seu caminho: instantâneo, com sua Identidade Nacional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolheu a nacionalidade saudita, por isso o Nafath é o seu caminho — instantâneo, com o seu Documento Nacional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai ales cetățenia saudită, deci Nafath este calea ta — instantaneu, cu National ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выбрали саудовское гражданство, поэтому ваш путь — Nafath: мгновенно, по вашему National ID."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybral si saudskú národnosť, takže tvojou cestou je Nafath — okamžite, s národným preukazom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du valde saudisk nationalitet, så Nafath är din väg – direkt, med ditt National ID."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சவூதி நாட்டினத்தைத் தேர்ந்தெடுத்ததால் Nafath தான் உங்கள் வழி — உங்கள் தேசிய அடையாள அட்டையுடன் உடனடி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సౌదీ జాతీయతను ఎంచుకున్నారు, కాబట్టి Nafath మీ మార్గం — తక్షణం, మీ నేషనల్ ID తో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลือกสัญชาติซาอุดีอาระเบีย จึงต้องใช้ Nafath ทันทีด้วยบัตรประจำตัวประชาชนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suudi uyruğunu seçtiniz, bu yüzden yolunuz Nafath: anında, Ulusal Kimliğinizle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вибрали саудівське громадянство, тож ваш шлях — Nafath: миттєво, за вашим Національним ID."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے سعودی قومیت چنی، اس لیے Nafath آپ کا راستہ ہے — فوری، آپ کے قومی شناختی کارڈ کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chọn quốc tịch Ả Rập Xê Út, nên Nafath là lựa chọn của bạn — tức thì, bằng căn cước quốc gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择了沙特国籍，所以请使用 Nafath，凭国民身份证即时完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇了沙烏地國籍，所以 Nafath 是你的途徑，使用你的國民身分證即時完成。"
          }
        }
      }
    },
    "verification.method.subtitle": {
      "comment": "Sheet subtitle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلاهما يستغرق دقائق قليلة. وفي الحالتين تُقرأ جنسيتك من الوثيقة، لا منك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটিতেই কয়েক মিনিট লাগে। যেভাবেই হোক, আপনার জাতীয়তা আসে নথি থেকে — আপনার কাছ থেকে নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes dues triguen uns minuts. En qualsevol cas, la teva nacionalitat prové del document, mai de tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě trvají pár minut. V obou případech se státní příslušnost bere z dokladu – nikdy od tebe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge tager et par minutter. Uanset hvad kommer din nationalitet fra dokumentet – aldrig fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides dauert ein paar Minuten. So oder so stammt deine Staatsangehörigkeit aus dem Dokument – nie von dir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και τα δύο παίρνουν λίγα λεπτά. Σε κάθε περίπτωση, η υπηκοότητά σου προέρχεται από το έγγραφο — ποτέ από εσένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both take a few minutes. Either way, your nationality comes from the document — never from you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas llevan unos minutos. En cualquier caso, tu nacionalidad sale del documento, nunca de ti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat vievät muutaman minuutin. Kummassakin tapauksessa kansalaisuutesi tulee asiakirjasta – ei koskaan sinulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux prennent quelques minutes. Dans les deux cas, votre nationalité vient du document — jamais de vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתיהן לוקחות כמה דקות. בכל מקרה, האזרחות שלך באה מהמסמך — לעולם לא ממך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों में कुछ मिनट लगते हैं। किसी भी तरह, आपकी राष्ट्रीयता दस्तावेज़ से आती है — आपसे कभी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba traju nekoliko minuta. U svakom slučaju, tvoje državljanstvo dolazi iz isprave — nikada od tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkettő néhány perc. Így vagy úgy, az állampolgárságod az okmányból származik – soha nem tőled."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keduanya butuh beberapa menit. Bagaimanapun, kewarganegaraanmu berasal dari dokumen — bukan dari kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi richiedono pochi minuti. In ogni caso la tua nazionalità deriva dal documento, mai da te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも数分で完了します。どちらの場合も、国籍は書類から決まり、自己申告では決まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 몇 분이면 돼요. 어느 쪽이든 국적은 직접 입력하는 것이 아니라 문서에서 가져와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രണ്ടിനും കുറച്ച് മിനിറ്റ് മതി. ഏതായാലും നിങ്ങളുടെ ദേശീയത രേഖയിൽ നിന്നാണ് വരുന്നത് — നിങ്ങളിൽ നിന്നല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya mengambil masa beberapa minit. Dalam apa jua cara, kewarganegaraan anda datang daripada dokumen — tidak pernah daripada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge tar noen minutter. Uansett kommer nasjonaliteten din fra dokumentet, aldri fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide duren een paar minuten. In beide gevallen komt je nationaliteit van het document, nooit van jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie zajmują kilka minut. Tak czy inaczej obywatelstwo pochodzi z dokumentu — nigdy od Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois levam poucos minutos. De qualquer forma, sua nacionalidade vem do documento, nunca de você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos demoram alguns minutos. Em qualquer caso, a sua nacionalidade vem do documento — nunca de si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambele durează câteva minute. În ambele cazuri, cetățenia vine din document — niciodată de la tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба способа занимают несколько минут. В любом случае гражданство берётся из документа — а не от вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obe trvajú pár minút. V oboch prípadoch tvoja národnosť pochádza z dokladu — nikdy nie od teba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda tar några minuter. Oavsett vilken kommer din nationalitet från dokumentet – aldrig från dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டுக்கும் சில நிமிடங்களே ஆகும். எப்படியிருந்தாலும் உங்கள் நாட்டினம் ஆவணத்திலிருந்தே எடுக்கப்படும் — நீங்கள் சொல்வதிலிருந்து அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండింటికీ కొన్ని నిమిషాలు పడుతుంది. ఏదైనా, మీ జాతీయత పత్రం నుండే వస్తుంది — మీరు చెప్పేది కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งสองวิธีใช้เวลาไม่กี่นาที ไม่ว่าวิธีใด สัญชาติของคุณมาจากเอกสาร ไม่เคยมาจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de birkaç dakika sürer. Hangisi olursa olsun uyruğunuz belgeden gelir, asla sizden değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва займають кілька хвилин. У будь-якому разі ваше громадянство береться з документа — ніколи не від вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں میں چند منٹ لگتے ہیں۔ دونوں صورتوں میں آپ کی قومیت دستاویز سے آتی ہے — آپ کے بتانے سے کبھی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều mất vài phút. Dù cách nào, quốc tịch của bạn đến từ giấy tờ — không bao giờ từ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种方式都只需几分钟。无论哪种，你的国籍都来自证件，而不是由你自己填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種方式都只需幾分鐘。無論哪種，你的國籍都來自證件，而不是你自己填寫。"
          }
        }
      }
    },
    "verification.method.title": {
      "comment": "Sheet title: choosing between Nafath and document verification.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف تودّ التحقق؟"
          }
        },
        "bn": {
