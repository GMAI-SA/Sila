    "video.status.processing": {
      "comment": "The author's own post while the server converts and screens its video (contract v28 §11).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تجهيز الفيديو. لن يرى هذا المنشور أحد غيرك حتى يصبح جاهزًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভিডিও প্রস্তুত হচ্ছে। প্রস্তুত না হওয়া পর্যন্ত এই পোস্ট শুধু আপনি দেখতে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparant el teu vídeo. Només tu pots veure aquesta publicació fins que estigui a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava videa. Tento příspěvek vidíš jen ty, dokud nebude hotový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargør din video. Kun du kan se dette opslag, til den er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Video wird vorbereitet. Nur du siehst diesen Beitrag, bis es fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προετοιμασία του βίντεό σου. Μόνο εσύ βλέπεις αυτή την ανάρτηση μέχρι να είναι έτοιμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing your video. Only you can see this post until it's ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando tu vídeo. Solo tú ves esta publicación hasta que esté listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistellaan videotasi. Vain sinä näet tämän julkaisun, kunnes se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de votre vidéo. Vous seul voyez ce post tant qu’elle n’est pas prête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכין את הווידאו שלך. רק אתה יכול לראות את הפוסט הזה עד שיהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वीडियो तैयार हो रहा है। तैयार होने तक इस पोस्ट को सिर्फ़ आप देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priprema tvog videa. Samo ti vidiš ovu objavu dok ne bude spremna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videód előkészítése. Ezt a bejegyzést csak te látod, amíg el nem készül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiapkan videomu. Hanya kamu yang bisa melihat postingan ini sampai siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparazione del tuo video. Solo tu puoi vedere questo post finché non è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を準備中です。準備ができるまで、この投稿はあなただけに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 준비하는 중이에요. 준비가 끝날 때까지 이 게시물은 나만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വീഡിയോ തയ്യാറാക്കുന്നു. തയ്യാറാകുംവരെ ഈ പോസ്റ്റ് നിങ്ങൾക്ക് മാത്രമേ കാണാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyediakan video anda. Hanya anda yang boleh melihat siaran ini sehingga ia siap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargjør videoen din. Bare du kan se dette innlegget til den er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je video wordt voorbereid. Alleen jij kunt dit bericht zien totdat hij klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowywanie Twojego wideo. Tylko Ty widzisz ten wpis, dopóki nie będzie gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando seu vídeo. Só você vê este post até ele ficar pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A preparar o seu vídeo. Só você vê esta publicação até estar pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pregătește videoul. Doar tu vezi această postare până când este gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовим ваше видео. Пока оно не готово, этот пост видите только вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripravuje sa tvoje video. Kým nie je hotové, tento príspevok vidíš iba ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbereder din video. Bara du kan se det här inlägget tills den är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வீடியோவைத் தயார் செய்கிறது. தயாராகும் வரை இந்த இடுகையை நீங்கள் மட்டுமே பார்க்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వీడియో సిద్ధమవుతోంది. అది సిద్ధమయ్యే వరకు ఈ పోస్ట్‌ను మీరు మాత్రమే చూడగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเตรียมวิดีโอของคุณ เฉพาะคุณที่เห็นโพสต์นี้จนกว่าจะพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videonuz hazırlanıyor. Hazır olana kadar bu gönderiyi yalnızca siz görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готуємо ваше відео. Поки воно не буде готове, цей допис бачите лише ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ویڈیو تیار ہو رہی ہے۔ تیار ہونے تک اس پوسٹ کو صرف آپ دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chuẩn bị video của bạn. Chỉ bạn thấy bài đăng này cho đến khi nó sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理你的视频。在准备好之前，只有你能看到这条帖子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在處理你的影片。在準備好之前，只有你看得到這則貼文。"
          }
        }
      }
    },
    "video.status.removedByModerator": {
      "comment": "The author's own post after a moderator removed its video (contract v28 §11).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزال أحد المشرفين هذا الفيديو لمخالفته إرشادات المجتمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমিউনিটি নির্দেশিকা ভাঙায় একজন মডারেটর এই ভিডিও সরিয়েছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderador ha eliminat aquest vídeo perquè incompleix les normes de la comunitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderátor toto video odstranil, protože porušuje zásady komunity."
