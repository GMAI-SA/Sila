    "communities.empty.mine.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلى واحد من «لك»، أو افتح مجتمعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য থেকে একটিতে যোগ দিন, বা নিজেরটি খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Uneix-te a una des de Per a tu o obre la teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj se k některé v Pro tebe, nebo otevři vlastní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld dig ind i et under Til dig, eller åbn dit eget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt über „Für dich“ einer bei oder eröffne deine eigene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμμετείχε σε μία από το Για εσένα ή άνοιξε τη δική σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join one from For you, or open your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a una desde Para ti, o abre la tuya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liity johonkin Sinulle-välilehdeltä tai perusta oma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez-en une depuis Pour vous, ou ouvrez la vôtre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרף לאחת מ״בשבילך״, או פתח משלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"आपके लिए\" से किसी से जुड़ें, या अपनी खुद की शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridruži se nekoj iz Za tebe ili otvori svoju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozz egyhez a Neked fülön, vagy nyisd meg a sajátodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabung dari Untukmu, atau buka komunitasmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a una da Per te, o apri la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「おすすめ」から参加するか、自分で開設しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천에서 가입하거나 직접 열어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കായി എന്നതിൽ നിന്ന് ഒന്നിൽ ചേരുക, അല്ലെങ്കിൽ സ്വന്തമായി തുടങ്ങുക."
          }
        },
