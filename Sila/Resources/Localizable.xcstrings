                  "state": "translated",
                  "value": "మీరు ఒకేసారి %lld వ్యక్తికి అండగా నిలబడవచ్చు."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "మీరు ఒకేసారి %lld మందికి అండగా నిలబడవచ్చు."
                }
              }
            }
          }
        },
        "th": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "คุณรับรองได้ครั้งละ %lld คน"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aynı anda %lld kişinin arkasında durabilirsiniz."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aynı anda %lld kişinin arkasında durabilirsiniz."
                }
