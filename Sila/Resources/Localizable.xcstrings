            "value": "Sletter kontaktnummeret ditt. Krever også passordet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je contactnummer. Vereist ook je wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa Twój numer kontaktowy. Wymaga też hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui seu número de contato. Também exige sua senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina o seu número de contacto. Exige também a sua palavra-passe."
