    "video.error.unavailable": {
      "comment": "503 video_upload_unavailable. Retried with a backoff.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرفع متوقف مؤقتًا، وسيُستأنف تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপলোড কিছুক্ষণের জন্য থেমে আছে। এটি নিজে থেকেই চলবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pujada està en pausa un moment. Continuarà per si sola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání je na chvíli pozastaveno. Bude pokračovat samo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload er sat på pause et øjeblik. Det fortsætter af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hochladen ist kurz pausiert. Es geht von selbst weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεταφόρτωση σταμάτησε προσωρινά. Θα συνεχιστεί μόνη της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploading is paused for a moment. It will carry on by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida está en pausa un momento. Continuará sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus on hetkeksi tauolla. Se jatkuu itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi est en pause un instant. Il reprendra de lui-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההעלאה מושהית לרגע. היא תמשיך מעצמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड कुछ देर के लिए रुका है। यह अपने-आप जारी रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijenos je na trenutak pauziran. Nastavit će se sam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feltöltés egy pillanatra szünetel. Magától folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengunggahan dijeda sebentar. Akan berlanjut dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caricamento è in pausa per un momento. Riprenderà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードを一時停止しています。自動的に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 잠시 중단되었어요. 저절로 이어서 진행돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്‌ലോഡ് കുറച്ച് നേരത്തേക്ക് നിർത്തിവച്ചിരിക്കുന്നു. അത് തനിയെ തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat naik dijeda seketika. Ia akan diteruskan dengan sendirinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplastingen er satt på pause et øyeblikk. Den fortsetter av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaden is even gepauzeerd. Het gaat vanzelf verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie jest na chwilę wstrzymane. Wznowi się samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio está em pausa por um instante. Ele continuará sozinho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio está em pausa por um momento. Continuará por si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcarea este oprită pentru o clipă. Va continua singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка ненадолго приостановлена. Она продолжится сама."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávanie je na chvíľu pozastavené. Bude pokračovať samo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdningen är pausad en stund. Den fortsätter av sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவேற்றம் சிறிது நேரம் நிறுத்தப்பட்டுள்ளது. அது தானாகத் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్‌లోడ్ కొద్దిసేపు ఆగింది. అది దానంతట అదే కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปโหลดหยุดชั่วคราว จะทำต่อเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme bir an için duraklatıldı. Kendiliğinden devam edecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження ненадовго призупинено. Воно продовжиться саме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپ لوڈ تھوڑی دیر کے لیے رکا ہوا ہے۔ یہ خود جاری ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tải lên tạm dừng một lúc. Nó sẽ tự tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传暂时暂停，稍后会自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳暫停片刻，稍後會自動繼續。"
          }
        }
      }
    },
    "video.error.unreadable": {
      "comment": "failure video_unreadable, and a picked file the phone cannot read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الفيديو. صدِّره مرة أخرى أو اختر فيديو آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিও পড়া যায়নি। আবার এক্সপোর্ট করুন বা অন্যটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut llegir aquest vídeo. Exporta'l de nou o tria'n un altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto video se nepodařilo přečíst. Exportuj ho znovu nebo vyber jiné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke læse denne video. Eksportér den igen, eller vælg en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten dieses Video nicht lesen. Exportiere es erneut oder wähle ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να διαβάσουμε αυτό το βίντεο. Εξήγαγέ το ξανά ή επίλεξε άλλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read this video. Export it again or choose another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer este vídeo. Expórtalo de nuevo o elige otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä videota ei voitu lukea. Vie se uudelleen tai valitse toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu lire cette vidéo. Exportez-la à nouveau ou choisissez-en une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לקרוא את הווידאו הזה. ייצא אותו שוב או בחר אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इस वीडियो को पढ़ नहीं सके। इसे दोबारा एक्सपोर्ट करें या कोई दूसरा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli pročitati ovaj video. Ponovno ga izvezi ili odaberi drugi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült beolvasni ezt a videót. Exportáld újra, vagy válassz másikat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa membaca video ini. Ekspor lagi atau pilih yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a leggere questo video. Esportalo di nuovo o scegline un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画を読み取れませんでした。書き出し直すか、別の動画を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상을 읽을 수 없어요. 다시 내보내거나 다른 동영상을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വീഡിയോ വായിക്കാനായില്ല. വീണ്ടും എക്സ്പോർട്ട് ചെയ്യുക അല്ലെങ്കിൽ മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat membaca video ini. Eksport semula atau pilih yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke lese denne videoen. Eksporter den på nytt eller velg en annen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden deze video niet lezen. Exporteer hem opnieuw of kies een andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego wideo. Wyeksportuj je ponownie lub wybierz inne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos ler este vídeo. Exporte-o de novo ou escolha outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos ler este vídeo. Exporte-o novamente ou escolha outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut citi acest video. Exportă-l din nou sau alege altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать это видео. Экспортируйте его заново или выберите другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa nám toto video prečítať. Exportuj ho znova alebo vyber iné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte läsa den här videon. Exportera den igen eller välj en annan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோவைப் படிக்க முடியவில்லை. மீண்டும் ஏற்றுமதி செய்யுங்கள் அல்லது வேறொன்றைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వీడియోను చదవలేకపోయాము. మళ్లీ ఎక్స్‌పోర్ట్ చేయండి లేదా మరొకటి ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราอ่านวิดีโอนี้ไม่ได้ ส่งออกใหม่หรือเลือกวิดีโออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videoyu okuyamadık. Yeniden dışa aktarın veya başka birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати це відео. Експортуйте його знову або виберіть інше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم یہ ویڈیو پڑھ نہیں سکے۔ اسے دوبارہ ایکسپورٹ کریں یا دوسری چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không đọc được video này. Hãy xuất lại hoặc chọn video khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法读取此视频。请重新导出或选择另一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法讀取此影片。請重新匯出，或選擇其他影片。"
          }
        }
      }
    },
    "video.error.uploadExpired": {
      "comment": "410 upload_expired. The app starts again silently; this is only ever shown if that fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف رفع هذا الفيديو قبل اكتماله. ارفعه مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আপলোড শেষ হওয়ার আগেই থেমে গেছে। ভিডিওটি আবার আপলোড করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta pujada s'ha aturat abans d'acabar. Torna a pujar el vídeo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nahrávání se zastavilo dřív, než skončilo. Nahraj video znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette upload stoppede, før det blev færdigt. Upload videoen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Upload wurde vor dem Ende abgebrochen. Lade das Video erneut hoch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η μεταφόρτωση σταμάτησε πριν ολοκληρωθεί. Ανέβασε ξανά το βίντεο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload stopped before it finished. Upload the video again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta subida se detuvo antes de terminar. Sube el vídeo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä lataus pysähtyi ennen valmistumista. Lataa video uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet envoi s’est arrêté avant la fin. Envoyez à nouveau la vidéo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההעלאה הזו נעצרה לפני שהסתיימה. העלה את הווידאו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अपलोड पूरा होने से पहले रुक गया। वीडियो दोबारा अपलोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj prijenos je stao prije završetka. Prenesi video ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a feltöltés megállt, mielőtt befejeződött volna. Töltsd fel újra a videót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggahan ini berhenti sebelum selesai. Unggah videonya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo caricamento si è interrotto prima della fine. Carica di nuovo il video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップロードは完了する前に停止しました。動画をもう一度アップロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업로드가 끝나기 전에 중단되었어요. 동영상을 다시 업로드하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അപ്‌ലോഡ് പൂർത്തിയാകുന്നതിന് മുമ്പ് നിലച്ചു. വീഡിയോ വീണ്ടും അപ്‌ലോഡ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat naik ini berhenti sebelum selesai. Muat naik video semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne opplastingen stoppet før den var ferdig. Last opp videoen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze upload is gestopt voordat hij klaar was. Upload de video opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To przesyłanie zatrzymało się przed końcem. Prześlij wideo ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este envio parou antes de terminar. Envie o vídeo novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este envio parou antes de terminar. Envie o vídeo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această încărcare s-a oprit înainte să se termine. Încarcă videoul din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта загрузка прервалась до завершения. Загрузите видео снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nahrávanie sa zastavilo pred dokončením. Nahraj video znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här uppladdningen avbröts innan den blev klar. Ladda upp videon igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பதிவேற்றம் முடிவதற்குள் நின்றுவிட்டது. வீடியோவை மீண்டும் பதிவேற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అప్‌లోడ్ పూర్తి కాకముందే ఆగిపోయింది. వీడియోను మళ్లీ అప్‌లోడ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปโหลดนี้หยุดก่อนเสร็จ อัปโหลดวิดีโออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yükleme bitmeden durdu. Videoyu yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завантаження зупинилося, не завершившись. Завантажте відео знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اپ لوڈ مکمل ہونے سے پہلے رک گیا۔ ویڈیو دوبارہ اپ لوڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần tải lên này đã dừng trước khi xong. Hãy tải video lên lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次上传在完成之前中断了。请重新上传视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此上傳在完成前中斷了，請重新上傳影片。"
          }
        }
      }
    },
    "video.error.uploadFailed": {
      "comment": "upload_chunk_invalid, upload_type_mismatch, request_too_large during an upload (contract v28 §10).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء الرفع. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপলোডের সময় কিছু একটা ভুল হয়েছে। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha anat malament en pujar. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nahrávání se něco pokazilo. Zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt under upload. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Hochladen ist etwas schiefgelaufen. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά κατά τη μεταφόρτωση. Δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while uploading. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al subir. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latauksessa meni jokin pieleen. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite pendant l’envoi. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש בזמן ההעלאה. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड करते समय कुछ गड़बड़ हो गई। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu tijekom prijenosa. Pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt a feltöltés közben. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat mengunggah. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto durante il caricamento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード中に問題が発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 중 문제가 발생했어요. 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്‌ലോഡ് ചെയ്യുമ്പോൾ എന്തോ പിഴവ് സംഭവിച്ചു. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu tersilap semasa memuat naik. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt under opplastingen. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het uploaden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak podczas przesyłania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado durante o envio. Tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal durante o envio. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a mers bine la încărcare. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке что-то пошло не так. Повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri nahrávaní sa niečo pokazilo. Skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel vid uppladdningen. Försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவேற்றும்போது ஏதோ தவறு நேர்ந்தது. மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్‌లోడ్ చేస్తున్నప్పుడు ఏదో తప్పు జరిగింది. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดระหว่างอัปโหลด ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklerken bir şeyler ters gitti. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час завантаження щось пішло не так. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپ لوڈ کے دوران کچھ غلط ہو گیا۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi tải lên. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传时出了点问题，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳時發生錯誤，請再試一次。"
          }
        }
      }
    },
    "video.error.uploadIncomplete": {
      "comment": "409 upload_incomplete. The app sends what is missing; this is only ever shown if that fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل جزء من الفيديو بعد. أبقِ التطبيق مفتوحًا حتى يكتمل الرفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওর একটি অংশ এখনও পৌঁছায়নি। আপলোড শেষ করতে অ্যাপ খোলা রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una part d'aquest vídeo encara no ha arribat. Mantén l'app oberta per acabar de pujar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část tohoto videa ještě nedorazila. Nech aplikaci otevřenou, aby se nahrávání dokončilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En del af denne video er ikke nået frem endnu. Hold appen åben for at gøre uploadet færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil dieses Videos ist noch nicht angekommen. Lass die App geöffnet, um das Hochladen abzuschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μέρος αυτού του βίντεο δεν έχει φτάσει ακόμα. Κράτα την εφαρμογή ανοιχτή για να ολοκληρωθεί η μεταφόρτωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of this video hasn't arrived yet. Keep the app open to finish uploading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de este vídeo aún no ha llegado. Mantén la app abierta para terminar de subirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa tästä videosta ei ole vielä perillä. Pidä sovellus auki viimeistelläksesi latauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de cette vidéo n’est pas encore arrivée. Gardez l’app ouverte pour terminer l’envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהווידאו הזה עדיין לא הגיע. השאר את האפליקציה פתוחה כדי לסיים להעלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वीडियो का एक हिस्सा अभी नहीं पहुँचा। अपलोड पूरा करने के लिए ऐप खुला रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dio ovog videa još nije stigao. Drži aplikaciju otvorenom da se prijenos dovrši."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videó egy része még nem érkezett meg. Hagyd nyitva az appot a feltöltés befejezéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian video ini belum sampai. Biarkan app terbuka untuk menyelesaikan unggahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte di questo video non è ancora arrivata. Tieni l'app aperta per completare il caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画の一部がまだ届いていません。アップロードが終わるまで、アプリを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상의 일부가 아직 도착하지 않았어요. 업로드를 마치려면 앱을 열어 두세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വീഡിയോയുടെ ഒരു ഭാഗം ഇതുവരെ എത്തിയിട്ടില്ല. അപ്‌ലോഡ് പൂർത്തിയാക്കാൻ ആപ്പ് തുറന്നു വയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian video ini belum sampai. Biarkan app terbuka untuk menyelesaikan muat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av denne videoen har ikke kommet fram ennå. Hold appen åpen for å fullføre opplastingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van deze video is nog niet aangekomen. Houd de app open om het uploaden af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część tego wideo jeszcze nie dotarła. Zostaw aplikację otwartą, aby dokończyć przesyłanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte deste vídeo ainda não chegou. Mantenha o app aberto para terminar o envio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte deste vídeo ainda não chegou. Mantenha a app aberta para terminar o envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O parte din acest video nu a ajuns încă. Ține aplicația deschisă pentru a termina încărcarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть этого видео ещё не дошла. Не закрывайте приложение, чтобы загрузка завершилась."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časť tohto videa ešte nedorazila. Nechaj aplikáciu otvorenú, aby sa nahrávanie dokončilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av den här videon har inte kommit fram än. Håll appen öppen för att slutföra uppladdningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோவின் ஒரு பகுதி இன்னும் வந்து சேரவில்லை. பதிவேற்றம் முடிய செயலியைத் திறந்தே வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వీడియోలో కొంత భాగం ఇంకా చేరలేదు. అప్‌లోడ్ పూర్తయ్యే వరకు యాప్‌ను తెరిచి ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอบางส่วนยังมาไม่ถึง เปิดแอปค้างไว้เพื่ออัปโหลดให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videonun bir kısmı henüz gelmedi. Yüklemeyi bitirmek için uygulamayı açık tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частина цього відео ще не надійшла. Не закривайте застосунок, щоб завершити завантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ویڈیو کا کچھ حصہ ابھی نہیں پہنچا۔ اپ لوڈ مکمل کرنے کے لیے ایپ کھلی رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phần video này chưa đến. Hãy giữ ứng dụng mở để tải lên xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频的一部分尚未到达。请保持应用打开以完成上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片的一部分尚未送達。請保持 App 開啟以完成上傳。"
          }
        }
      }
