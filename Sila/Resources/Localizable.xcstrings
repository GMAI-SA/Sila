            "value": "Торкніться, щоб відкрити кімнату. Утримуйте, щоб побачити більше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم کھولنے کے لیے ٹیپ کریں۔ مزید کے لیے دبائے رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
