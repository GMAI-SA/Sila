    "profile.requests.empty.subtitle": {
      "comment": "Empty state subtitle of the follow-requests sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يطلب أحد متابعتك، يظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনাকে ফলো করতে চাইলে তারা এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú demani seguir-te, apareixerà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tě někdo požádá o sledování, objeví se tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen beder om at følge dig, vises de her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand fragt, ob er dir folgen darf, erscheint er hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος ζητήσει να σε ακολουθήσει, θα εμφανιστεί εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When somebody asks to follow you, they appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien pida seguirte, aparecerá aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku pyytää lupaa seurata sinua, hän näkyy täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un demande à vous suivre, il apparaît ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו מבקש לעקוב אחריך, הוא מופיע כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपको फ़ॉलो करने को कहेगा, वह यहाँ दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad te netko zatraži pratiti, pojavit će se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor valaki követni kér, itt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat seseorang meminta mengikutimu, mereka muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno chiede di seguirti, compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのフォローを申請すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 나를 팔로우하려고 요청하면 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും നിങ്ങളെ ഫോളോ ചെയ്യാൻ അഭ്യർഥിക്കുമ്പോൾ അവർ ഇവിടെ വരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seseorang meminta untuk mengikut anda, mereka muncul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen ber om å følge deg, vises de her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als iemand je wil volgen, verschijnt die persoon hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś poprosi o obserwowanie, pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém pedir para seguir você, aparecerá aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém pedir para o seguir, aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când cineva cere să te urmărească, apare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кто-то попросится подписаться на вас, он появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď ťa niekto požiada o sledovanie, zobrazí sa tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon ber att få följa dig visas de här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது உங்களைப் பின்தொடரக் கேட்டால் இங்கே தோன்றுவார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా మిమ్మల్ని ఫాలో అవ్వాలని అడిగినప్పుడు, వారు ఇక్కడ కనిపిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนขอติดตามคุณ จะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri sizi takip etmek istediğinde burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли хтось попросить підписатися на вас, він з’явиться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی آپ کو فالو کرنے کی درخواست کرے گا تو وہ یہاں نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó xin theo dõi bạn, họ sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人请求关注你时，会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人申請追蹤你時，會顯示在這裡。"
          }
        }
      }
    },
    "profile.requests.hint": {
      "comment": "VoiceOver hint on the follow-requests entry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح قائمة من ينتظرون متابعتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যারা আপনাকে ফলো করার অপেক্ষায় আছে তাদের খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre les persones que esperen per seguir-te"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře lidi, kteří čekají na sledování tebe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner de folk, der venter på at følge dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Personen, die darauf warten, dir zu folgen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τα άτομα που περιμένουν να σε ακολουθήσουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the people waiting to follow you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las personas que esperan para seguirte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa sinua seuraamaan haluavat ihmiset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la liste des personnes qui attendent de vous suivre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את האנשים שממתינים לעקוב אחריך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको फ़ॉलो करने की प्रतीक्षा कर रहे लोगों को खोलता है"
