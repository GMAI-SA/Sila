        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra thư rác nếu mã không đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有收到，请检查垃圾邮件文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
