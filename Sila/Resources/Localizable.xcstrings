    "vouch.new.closeWarning": {
      "comment": "Asked in place when the voucher tries to close the sheet before sharing or copying a link they just made. The server shows the link only once, and the day's link is spent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر هذا الرابط هذه المرة فقط. شاركه أو انسخه قبل الإغلاق — بعدها لا يمكن عرضه مرة أخرى، ويكون رابط اليوم قد استُخدم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লিংক শুধু এই একবারই দেখানো হয়। বন্ধ করার আগে শেয়ার বা কপি করুন — পরে আর দেখানো যাবে না, আর আজকের লিংকটি ব্যবহার হয়ে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest enllaç només es mostra aquesta vegada. Comparteix-lo o copia'l abans de tancar: després no es podrà tornar a mostrar, i l'enllaç d'avui ja s'haurà fet servir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento odkaz se zobrazí jen jednou. Sdílej ho nebo zkopíruj před zavřením – potom už ho nelze zobrazit a dnešní odkaz je spotřebován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette link vises kun denne ene gang. Del eller kopiér det, før du lukker – bagefter kan det ikke vises igen, og dagens link er brugt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link wird nur dieses eine Mal angezeigt. Teile oder kopiere ihn, bevor du schließt – danach kann er nicht erneut angezeigt werden, und der heutige Link ist verbraucht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο σύνδεσμος εμφανίζεται μόνο αυτή τη φορά. Κοινοποίησέ τον ή αντίγραψέ τον πριν κλείσεις — μετά δεν μπορεί να εμφανιστεί ξανά και ο σημερινός σύνδεσμος θεωρείται χρησιμοποιημένος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is shown only this once. Share or copy it before you close — afterwards it can't be shown again, and today's link is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace se muestra solo esta vez. Compártelo o cópialo antes de cerrar: después no se podrá volver a mostrar y se habrá usado el enlace de hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä linkki näytetään vain tämän kerran. Jaa tai kopioi se ennen sulkemista – sen jälkeen sitä ei voi näyttää uudelleen, ja tämän päivän linkki on käytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien n’est affiché qu’une seule fois. Partagez-le ou copiez-le avant de fermer — ensuite il ne pourra plus être affiché, et le lien du jour est utilisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישור הזה מוצג רק הפעם. שתף או העתק אותו לפני שתסגור — אחר כך אי אפשר להציג אותו שוב, והקישור של היום נוצל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लिंक सिर्फ़ इसी एक बार दिखाया जाता है। बंद करने से पहले इसे शेयर या कॉपी कर लें — बाद में इसे दोबारा नहीं दिखाया जा सकता, और आज का लिंक इस्तेमाल हो चुका होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova poveznica prikazuje se samo jednom. Podijeli je ili kopiraj prije zatvaranja — poslije se ne može ponovno prikazati, a današnja poveznica je iskorištena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hivatkozás csak ezúttal látható. Oszd meg vagy másold ki bezárás előtt – utána már nem mutatható meg újra, és a mai hivatkozásod elhasználódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan ini hanya ditampilkan sekali ini. Bagikan atau salin sebelum menutup — setelahnya tidak bisa ditampilkan lagi, dan jatah tautan hari ini terpakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link viene mostrato solo questa volta. Condividilo o copialo prima di chiudere: dopo non potrà essere mostrato di nuovo e il link di oggi risulta usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクが表示されるのは今回だけです。閉じる前に共有またはコピーしてください。あとからは表示できず、今日の分のリンクは使用済みになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 이번 한 번만 표시돼요. 닫기 전에 공유하거나 복사하세요. 이후에는 다시 볼 수 없고 오늘의 링크는 사용된 것으로 처리돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ലിങ്ക് ഇപ്പോൾ ഒരിക്കൽ മാത്രമേ കാണിക്കൂ. അടയ്ക്കുന്നതിന് മുമ്പ് പങ്കിടുകയോ കോപ്പി ചെയ്യുകയോ ചെയ്യുക — പിന്നീട് വീണ്ടും കാണിക്കാനാകില്ല, ഇന്നത്തെ ലിങ്ക് ഉപയോഗിച്ചതായി കണക്കാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan ini hanya dipaparkan sekali ini. Kongsi atau salin sebelum anda menutup — selepas itu ia tidak boleh dipaparkan semula, dan pautan hari ini telah digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne lenken vises bare denne ene gangen. Del eller kopier den før du lukker. Etterpå kan den ikke vises igjen, og dagens lenke er brukt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link wordt maar één keer getoond. Deel of kopieer hem voordat je sluit: daarna kan hij niet meer worden getoond en is de link van vandaag gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten link jest pokazywany tylko ten jeden raz. Udostępnij lub skopiuj go przed zamknięciem — później nie będzie można go pokazać ponownie, a dzisiejszy link zostanie wykorzystany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link é mostrado só desta vez. Compartilhe ou copie antes de fechar: depois não será possível vê-lo de novo, e o link de hoje será gasto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ligação só é mostrada esta vez. Partilhe-a ou copie-a antes de fechar — depois não poderá ser mostrada de novo, e a ligação de hoje fica usada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest link este afișat o singură dată. Distribuie-l sau copiază-l înainte să închizi — după aceea nu mai poate fi afișat, iar linkul de azi este folosit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка показывается только один раз. Поделитесь или скопируйте её, прежде чем закрыть, — потом показать её снова нельзя, а сегодняшняя ссылка уже использована."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento odkaz sa zobrazí iba raz. Zdieľaj ho alebo skopíruj skôr, než zavrieš — potom sa už nedá znova zobraziť a dnešný odkaz je použitý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här länken visas bara den här enda gången. Dela eller kopiera den innan du stänger – efteråt kan den inte visas igen, och dagens länk är förbrukad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இணைப்பு இந்த ஒரு முறை மட்டுமே காட்டப்படும். மூடும் முன் பகிருங்கள் அல்லது நகலெடுங்கள் — பிறகு மீண்டும் காட்ட முடியாது, இன்றைய இணைப்பும் பயன்படுத்தப்பட்டதாகிவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ లింక్ ఈ ఒక్కసారి మాత్రమే చూపబడుతుంది. మూసివేసే ముందు షేర్ చేయండి లేదా కాపీ చేయండి — ఆ తర్వాత మళ్లీ చూపలేము, ఈ రోజు లింక్ వాడబడినట్లే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์นี้แสดงเพียงครั้งเดียว แชร์หรือคัดลอกก่อนปิด หลังจากนั้นจะแสดงอีกไม่ได้ และลิงก์ของวันนี้จะถูกใช้ไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı yalnızca bir kez gösterilir. Kapatmadan önce paylaşın veya kopyalayın; sonra yeniden gösterilemez ve bugünkü bağlantı hakkınız kullanılmış olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це посилання показується лише один раз. Поділіться ним або скопіюйте, перш ніж закрити — потім його не можна буде показати знову, а сьогоднішнє посилання буде використано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لنک صرف ایک بار دکھایا جاتا ہے۔ بند کرنے سے پہلے شیئر یا کاپی کر لیں — اس کے بعد اسے دوبارہ نہیں دکھایا جا سکتا، اور آج کا لنک استعمال ہو چکا ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết này chỉ hiển thị đúng một lần. Hãy chia sẻ hoặc sao chép trước khi đóng — sau đó không thể hiển thị lại, và liên kết của hôm nay đã được dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接只显示这一次。请在关闭前分享或拷贝，之后将无法再次显示，而今天的链接额度已被使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結只會顯示這一次。關閉前請先分享或拷貝，之後就無法再顯示，且今天的連結額度已被使用。"
          }
        }
      }
    },
