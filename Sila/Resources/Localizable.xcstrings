        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukernavn er på 3–20 tegn med bokstaver, tall og understreker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles bestaan uit 3–20 tekens: letters, cijfers en underscores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchwyt ma 3–20 znaków: litery, cyfry i podkreślenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O @usuário deve ter de 3 a 20 caracteres, entre letras, números e sublinhados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os identificadores têm 3 a 20 carateres, entre letras, números e sublinhados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle-urile au 3–20 de caractere: litere, cifre și liniuțe de subliniere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя — от 3 до 20 символов: буквы, цифры и подчёркивания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používateľské meno má 3–20 znakov: písmená, číslice a podčiarkovníky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användarnamn är 3–20 tecken med bokstäver, siffror och understreck."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஹேண்டில்கள் 3–20 எழுத்துகள் கொண்டவை; எழுத்துகள், எண்கள், அடிக்கோடுகள் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హ్యాండిల్‌లు 3–20 అక్షరాలు ఉండాలి, అందులో అక్షరాలు, అంకెలు, అండర్‌స్కోర్‌లు మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แฮนเดิลมี 3–20 ตัวอักษร ประกอบด้วยตัวอักษร ตัวเลข และขีดล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adları 3–20 karakterden oluşur; harf, rakam ve alt çizgi içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@ім’я — це 3–20 символів: літери, цифри та підкреслення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہینڈل 3 سے 20 حروف کے ہوتے ہیں، جن میں حروف، ہندسے اور انڈر سکور ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người dùng gồm 3–20 ký tự là chữ cái, chữ số và dấu gạch dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名为 3–20 个字符，可用字母、数字和下划线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代號為 3 至 20 個字元，可使用字母、數字和底線。"
          }
        }
      }
    },
    "error.invalidImage": {
      "comment": "The uploaded file could not be decoded as an image.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الملف كصورة. اختر صورة بدلًا منه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি ছবি হিসেবে পড়া যায়নি। বরং একটি ফটো বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest fitxer no s'ha pogut llegir com a imatge. Tria una foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor nešlo přečíst jako obrázek. Vyber místo toho fotku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke læses som et billede. Vælg i stedet et foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht als Bild gelesen werden. Wähle stattdessen ein Foto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο δεν διαβάστηκε ως εικόνα. Διάλεξε μια φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file couldn't be read as an image. Pick a photo instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ese archivo como imagen. Elige una foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoa ei voitu lukea kuvana. Valitse sen sijaan valokuva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas pu être lu comme une image. Choisissez plutôt une photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את הקובץ הזה כתמונה. בחר תמונה במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ाइल इमेज के रूप में पढ़ी नहीं जा सकी। इसके बजाय कोई फ़ोटो चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu datoteku nije moguće pročitati kao sliku. Odaberi fotografiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a fájlt nem lehetett képként beolvasni. Válassz inkább fotót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas itu tidak bisa dibaca sebagai gambar. Pilih foto saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere quel file come immagine. Scegli una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを画像として読み取れませんでした。代わりに写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 이미지로 읽을 수 없어요. 대신 사진을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫയൽ ചിത്രമായി വായിക്കാനായില്ല. പകരം ഒരു ഫോട്ടോ തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail itu tidak dapat dibaca sebagai imej. Pilih foto sebagai ganti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke leses som et bilde. Velg et foto i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat bestand kon niet als afbeelding worden gelezen. Kies in plaats daarvan een foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego pliku jako obrazu. Wybierz zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse arquivo como imagem. Escolha uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse ficheiro não pôde ser lido como imagem. Escolha antes uma foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul nu a putut fi citit ca imagine. Alege o fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл как изображение. Выберите фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento súbor sa nepodarilo prečítať ako obrázok. Vyber radšej fotku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen gick inte att läsa som en bild. Välj ett foto i stället."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தக் கோப்பைப் படமாகப் படிக்க முடியவில்லை. அதற்குப் பதிலாக ஒரு புகைப்படத்தைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫైల్‌ను చిత్రంగా చదవలేకపోయాం. బదులుగా ఫోటోను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านไฟล์นั้นเป็นรูปภาพไม่ได้ เลือกรูปถ่ายแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya görsel olarak okunamadı. Bunun yerine bir fotoğraf seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл не вдалося прочитати як зображення. Виберіть натомість фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ فائل تصویر کے طور پر پڑھی نہیں جا سکی۔ اس کے بجائے کوئی فوٹو چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được tệp đó như một ảnh. Hãy chọn một bức ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将该文件作为图片读取。请改选一张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將該檔案讀取為圖片，請改選照片。"
          }
        }
      }
    },
    "error.invalidImageUrl": {
      "comment": "400 invalid_image_url (contract v27): a picture on the post is not one this person uploaded for it, or the same one is attached twice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرفاق إحدى الصور. احذفها ثم أضفها من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ছবি যুক্ত করা যায়নি। সেটি সরিয়ে আবার যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut adjuntar una de les imatges. Elimina-la i torna-la a afegir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden z obrázků se nepodařilo připojit. Odeber ho a přidej znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et af billederne kunne ikke vedhæftes. Fjern det, og tilføj det igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines der Bilder konnte nicht angehängt werden. Entferne es und füge es erneut hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία από τις εικόνες δεν μπόρεσε να επισυναφθεί. Αφαίρεσέ την και πρόσθεσέ την ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the pictures couldn't be attached. Remove it and add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo adjuntar una de las imágenes. Quítala y vuelve a añadirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhtä kuvista ei voitu liittää. Poista se ja lisää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une des images n’a pas pu être jointe. Retirez-la et ajoutez-la à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לצרף אחת התמונות. הסר אותה והוסף אותה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तस्वीर जोड़ी नहीं जा सकी। उसे हटाकर फिर से जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna od slika nije mogla biti priložena. Ukloni je i dodaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik képet nem sikerült csatolni. Töröld, és add hozzá újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah satu gambar tidak bisa dilampirkan. Hapus lalu tambahkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile allegare una delle immagini. Rimuovila e aggiungila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の1つを添付できませんでした。削除して、もう一度追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 중 하나를 첨부할 수 없었어요. 삭제한 후 다시 추가하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചിത്രം ചേർക്കാനായില്ല. അത് നീക്കം ചെയ്ത് വീണ്ടും ചേർക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah satu gambar tidak dapat dilampirkan. Alih keluar dan tambah semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et av bildene kunne ikke legges ved. Fjern det og legg det til på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de afbeeldingen kon niet worden bijgevoegd. Verwijder hem en voeg hem opnieuw toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dołączyć jednego z obrazów. Usuń go i dodaj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma das imagens não pôde ser anexada. Remova-a e adicione de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível anexar uma das imagens. Remova-a e adicione-a novamente."
          }
