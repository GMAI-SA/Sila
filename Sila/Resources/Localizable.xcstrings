        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your preferences"
          }
        }
      }
    },
    "preferences.filter.detail": {
      "comment": "Says which feed the filter applies to, and why it does not apply to the others.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق على الصفحة الدولية فقط. أما «المتابَعون» و«بلدي» و«مخصص لك» فهي مُضيَّقة أصلًا بحسب دولة أو بحسب الحسابات التي تتابعها، لذلك لا تُطبَّق عليها المواضيع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the International feed only. Following, My Country and For You are already narrowed by a country or by the accounts you follow, so topics are not applied to them."
          }
        }
      }
    },
    "preferences.filter.hint": {
      "comment": "VoiceOver hint for the interest filter switch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيّق الصفحة الدولية على المواضيع التي حددتها كمهتم بها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrows the International feed to the topics you marked interested"
          }
        }
      }
    },
    "preferences.filter.title": {
      "comment": "The main switch: narrow the International feed to chosen topics.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
