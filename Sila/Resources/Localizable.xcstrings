    "vouch.refusal.selfVerify": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق هويتك أولًا قبل أن تزكّي أحدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কারও জন্য ভাউচ করার আগে নিজের পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la teva pròpia identitat abans d'avalar ningú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než za někoho zaručíš, ověř vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificér din egen identitet, før du går i god for nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiziere deine eigene Identität, bevor du für jemanden bürgst."
          }
        },
        "el": {
          "stringUnit": {
