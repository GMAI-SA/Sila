    "document.capture.failed": {
      "comment": "Under the document camera: the shutter fired but no photo came back.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُلتقط الصورة. اثبت وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি তোলা যায়নি। স্থির থেকে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto no s'ha fet. Queda't quiet i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka se nepovedla. Drž telefon klidně a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet blev ikke taget. Hold stille, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto hat nicht geklappt. Halte still und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία δεν τραβήχτηκε. Κράτησε σταθερό το τηλέφωνο και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo didn't take. Hold still and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se hizo la foto. Quédate quieto e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva ei onnistunut. Pidä paikallasi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo n’a pas été prise. Ne bougez pas et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה לא צולמה. החזק יציב ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो नहीं खिंची। स्थिर रहें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija nije snimljena. Drži mirno i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó nem sikerült. Tartsd mozdulatlanul, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto gagal diambil. Tahan diam dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto non è riuscita. Stai fermo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影できませんでした。動かさずに、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 찍히지 않았어요. 가만히 들고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ എടുക്കാനായില്ല. അനങ്ങാതെ പിടിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tidak berjaya diambil. Pegang dengan stabil dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet ble ikke tatt. Hold deg i ro og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto is niet gelukt. Houd stil en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zrobić zdjęcia. Trzymaj nieruchomo i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto não saiu. Fique parado e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto não ficou registada. Fique quieto e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia nu a reușit. Stai nemișcat și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок не получился. Не двигайтесь и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka sa nepodarila. Drž pokojne a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot blev inte av. Håll still och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் எடுக்கப்படவில்லை. அசையாமல் பிடித்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో తీయబడలేదు. కదలకుండా పట్టుకుని మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพไม่สำเร็จ ถือให้นิ่งแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çekilemedi. Sabit tutun ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото не вийшло. Не рухайтеся й спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر نہیں آئی۔ ساکت رہیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh không thành công. Hãy giữ yên và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有拍成功。请保持稳定后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有拍到照片。請拿穩後再試一次。"
          }
        }
      }
    },
    "document.capture.front.instruction": {
      "comment": "Capture step instruction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "املأ الإطار بالصفحة كاملة. يجب أن تكون سطور الحروف والأرقام في الأسفل واضحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেম ভরে পুরো পাতাটি দেখান। নিচের অক্ষর ও সংখ্যার লাইনগুলো স্পষ্ট হতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omple el requadre amb tota la pàgina. Les línies de lletres i números de la part inferior han de quedar nítides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplň rámeček celou stránkou. Řádky písmen a číslic dole musí být ostré."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad hele siden fylde rammen. Linjerne med bogstaver og tal nederst skal være skarpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle den Rahmen mit der ganzen Seite. Die Zeilen aus Buchstaben und Ziffern unten müssen scharf sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γέμισε το πλαίσιο με ολόκληρη τη σελίδα. Οι γραμμές με γράμματα και αριθμούς στο κάτω μέρος πρέπει να είναι καθαρές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the frame with the whole page. The lines of letters and numbers at the bottom must be sharp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llena el encuadre con la página entera. Las líneas de letras y números de la parte inferior deben verse nítidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täytä kehys koko sivulla. Alareunan kirjain- ja numerorivien on oltava teräviä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissez le cadre avec toute la page. Les lignes de lettres et de chiffres en bas doivent être nettes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלא את המסגרת בעמוד כולו. שורות האותיות והספרות שבתחתית חייבות להיות חדות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे पन्ने से फ़्रेम भरें। नीचे अक्षरों और अंकों की पंक्तियाँ साफ़ होनी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispuni okvir cijelom stranicom. Retci slova i brojeva pri dnu moraju biti oštri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töltsd ki a keretet a teljes oldallal. Az alul lévő betű- és számsoroknak élesnek kell lenniük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penuhi bingkai dengan seluruh halaman. Baris huruf dan angka di bagian bawah harus tajam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempi l'inquadratura con tutta la pagina. Le righe di lettere e numeri in basso devono essere nitide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ全体が枠いっぱいになるようにしてください。下部の文字と数字の行がはっきり写っている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 전체가 프레임에 가득 차게 하세요. 아래쪽의 글자와 숫자 줄이 선명해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേജ് മുഴുവനായും ഫ്രെയിമിൽ നിറയ്ക്കുക. താഴെയുള്ള അക്ഷരങ്ങളുടെയും അക്കങ്ങളുടെയും വരികൾ വ്യക്തമായിരിക്കണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penuhkan bingkai dengan seluruh halaman. Baris huruf dan nombor di bahagian bawah mesti jelas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll rammen med hele siden. Linjene med bokstaver og tall nederst må være skarpe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het kader met de hele pagina. De regels met letters en cijfers onderaan moeten scherp zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnij kadr całą stroną. Linie liter i cyfr na dole muszą być ostre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o quadro com a página inteira. As linhas de letras e números na parte de baixo precisam estar nítidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encha o enquadramento com a página inteira. As linhas de letras e números na parte inferior têm de estar nítidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Umple cadrul cu toată pagina. Rândurile de litere și cifre din partea de jos trebuie să fie clare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполните рамку всей страницей. Строки букв и цифр внизу должны быть чёткими."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplň rámček celou stranou. Riadky písmen a číslic dole musia byť ostré."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll rutan med hela sidan. Raderna med bokstäver och siffror längst ned måste vara skarpa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழுப் பக்கமும் சட்டத்தை நிரப்பும்படி வையுங்கள். கீழே உள்ள எழுத்து, எண் வரிகள் தெளிவாக இருக்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేజీ మొత్తం ఫ్రేమ్‌లో నిండేలా ఉంచండి. అడుగున ఉన్న అక్షరాలు, అంకెల లైన్లు స్పష్టంగా ఉండాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ทั้งหน้าเต็มกรอบ บรรทัดตัวอักษรและตัวเลขด้านล่างต้องคมชัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfanın tamamını çerçeveye sığdırın. Alttaki harf ve rakam satırları net olmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
