    "feed.profileOff.preferences.detail": {
      "comment": "What the feed preferences row contains.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواضيع والمواضيع المكتومة والدول المكتومة — وكيف تُصنَّف المنشورات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়, মিউট করা বিষয় ও মিউট করা দেশ — এবং পোস্টে কীভাবে লেবেল দেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Temes, temes silenciats i països silenciats, i com s'etiqueten les publicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Témata, ztlumená témata a ztlumené země – a jak se příspěvky označují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner, skjulte emner og skjulte lande – og hvordan opslag mærkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themen, stummgeschaltete Themen und Länder – und wie Beiträge gelabelt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέματα, θέματα σε σίγαση και χώρες σε σίγαση — και πώς επισημαίνονται οι αναρτήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics, muted topics and muted countries — and how posts get labelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas, temas silenciados y países silenciados, y cómo se etiquetan las publicaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiheet, mykistetyt aiheet ja mykistetyt maat – ja miten julkaisut luokitellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujets, sujets masqués et pays masqués — et comment les posts sont étiquetés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נושאים, נושאים מושתקים ומדינות מושתקות — ואיך פוסטים מתויגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टॉपिक, म्यूट किए टॉपिक और म्यूट किए देश — और पोस्ट पर लेबल कैसे लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teme, utišane teme i utišane zemlje — i kako se objave označavaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Témák, némított témák és némított országok – és hogyan kapnak címkét a bejegyzések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik, topik yang dibisukan, dan negara yang dibisukan — dan bagaimana postingan diberi label."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Argomenti, argomenti silenziati e paesi silenziati, e come vengono etichettati i post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピック、ミュートしたトピック、ミュートした国、投稿へのラベル付けのしくみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제, 뮤트한 주제, 뮤트한 국가, 그리고 게시물에 라벨이 붙는 방식."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഷയങ്ങൾ, മ്യൂട്ട് ചെയ്ത വിഷയങ്ങൾ, മ്യൂട്ട് ചെയ്ത രാജ്യങ്ങൾ — പോസ്റ്റുകൾക്ക് ലേബൽ നൽകുന്ന വിധവും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik, topik disenyapkan dan negara disenyapkan — dan cara siaran dilabelkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner, dempede emner og dempede land, og hvordan innlegg merkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwerpen, gedempte onderwerpen en gedempte landen, en hoe berichten worden gelabeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tematy, wyciszone tematy i wyciszone kraje — oraz sposób oznaczania wpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tópicos, tópicos silenciados e países silenciados, e como os posts são rotulados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tópicos, tópicos silenciados e países silenciados — e como as publicações são etiquetadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subiecte, subiecte dezactivate și țări dezactivate — și cum sunt etichetate postările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы, скрытые темы и скрытые страны — и как помечаются посты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Témy, stlmené témy a stlmené krajiny — a ako sa príspevky označujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ämnen, tystade ämnen och tystade länder – och hur inlägg får etiketter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகள், ஒலியடக்கிய தலைப்புகள், ஒலியடக்கிய நாடுகள் — மேலும் இடுகைகள் எப்படி லேபிளிடப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశాలు, మ్యూట్ చేసిన అంశాలు, మ్యూట్ చేసిన దేశాలు — అలాగే పోస్ట్‌లకు లేబుల్‌లు ఎలా వేస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หัวข้อ หัวข้อที่ปิดเสียง ประเทศที่ปิดเสียง และวิธีติดป้ายโพสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konular, sessize alınmış konular ve sessize alınmış ülkeler; ayrıca gönderilerin nasıl etiketlendiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теми, теми та країни із вимкненими сповіщеннями — і як позначаються дописи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موضوعات، میوٹ کیے گئے موضوعات اور میوٹ کیے گئے ممالک — اور پوسٹس پر لیبل کیسے لگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề, chủ đề đã ẩn và quốc gia đã ẩn — và cách bài đăng được gắn nhãn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "话题、已静音话题和已静音国家，以及帖子如何被标注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題、靜音主題和靜音國家，以及貼文如何被標示。"
          }
        }
      }
    },
    "feed.profileOff.preferences.hint": {
      "comment": "VoiceOver hint for the feed preferences row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح اهتماماتك بالمواضيع والمواضيع والدول المكتومة، ويشرح كيف تُصنَّف المنشورات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়ের আগ্রহ, মিউট করা বিষয় ও মিউট করা দেশ খোলে এবং পোস্টে কীভাবে লেবেল দেওয়া হয় তা ব্যাখ্যা করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre els interessos de temes, els temes silenciats i els països silenciats, i explica com s'etiqueten les publicacions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře zájmová témata, ztlumená témata a ztlumené země a vysvětlí, jak se příspěvky označují"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner emneinteresser, skjulte emner og skjulte lande og forklarer, hvordan opslag mærkes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Themeninteressen, stummgeschaltete Themen und Länder und erklärt, wie Beiträge gelabelt werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τα θέματα ενδιαφέροντος, τα θέματα και τις χώρες σε σίγαση και εξηγεί πώς επισημαίνονται οι αναρτήσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens topic interests, muted topics and muted countries, and explains how posts are labelled"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los temas de interés, los temas y países silenciados, y explica cómo se etiquetan las publicaciones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa aihekiinnostukset, mykistetyt aiheet ja mykistetyt maat ja selittää, miten julkaisut luokitellaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les centres d’intérêt, les sujets masqués et les pays masqués, et explique comment les posts sont étiquetés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח תחומי עניין, נושאים מושתקים ומדינות מושתקות, ומסביר איך פוסטים מתויגים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टॉपिक की रुचियाँ, म्यूट किए टॉपिक और म्यूट किए देश खोलता है, और बताता है कि पोस्ट पर लेबल कैसे लगते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara interese za teme, utišane teme i utišane zemlje te objašnjava kako se objave označavaju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a témaérdeklődéseket, a némított témákat és országokat, és elmagyarázza, hogyan kapnak címkét a bejegyzések"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka minat topik, topik dan negara yang dibisukan, dan menjelaskan cara postingan diberi label"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre gli interessi per argomento, gli argomenti e i paesi silenziati, e spiega come vengono etichettati i post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関心のあるトピック、ミュートしたトピックと国を開き、投稿へのラベル付けのしくみを説明します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심 주제, 뮤트한 주제와 국가를 열고 게시물에 라벨이 붙는 방식을 설명해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഷയ താൽപര്യങ്ങൾ, മ്യൂട്ട് ചെയ്ത വിഷയങ്ങൾ, മ്യൂട്ട് ചെയ്ത രാജ്യങ്ങൾ എന്നിവ തുറക്കുകയും പോസ്റ്റുകൾക്ക് ലേബൽ നൽകുന്ന വിധം വിശദീകരിക്കുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka minat topik, topik disenyapkan dan negara disenyapkan, dan menerangkan cara siaran dilabelkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner emneinteresser, dempede emner og dempede land, og forklarer hvordan innlegg merkes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent onderwerpinteresses, gedempte onderwerpen en gedempte landen, en legt uit hoe berichten worden gelabeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera zainteresowania tematyczne, wyciszone tematy i kraje oraz wyjaśnia, jak oznaczane są wpisy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os interesses por tópico, os tópicos e países silenciados e explica como os posts são rotulados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os interesses por tópicos, tópicos e países silenciados, e explica como as publicações são etiquetadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide interesele de subiecte, subiectele și țările dezactivate și explică cum sunt etichetate postările"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает интересы по темам, скрытые темы и страны и объясняет, как помечаются посты"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí záujmy o témy, stlmené témy a stlmené krajiny a vysvetlí, ako sa príspevky označujú"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ämnesintressen, tystade ämnen och tystade länder, och förklarar hur inlägg etiketteras"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்பு ஆர்வங்கள், ஒலியடக்கிய தலைப்புகள், ஒலியடக்கிய நாடுகளைத் திறந்து இடுகைகள் எப்படி லேபிளிடப்படுகின்றன என்பதை விளக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశ ఆసక్తులు, మ్యూట్ చేసిన అంశాలు, మ్యూట్ చేసిన దేశాలను తెరిచి, పోస్ట్‌లకు లేబుల్‌లు ఎలా వేస్తారో వివరిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหัวข้อที่สนใจ หัวข้อที่ปิดเสียง และประเทศที่ปิดเสียง และอธิบายวิธีติดป้ายโพสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu ilgi alanlarını, sessize alınmış konuları ve ülkeleri açar ve gönderilerin nasıl etiketlendiğini açıklar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває інтереси за темами, теми та країни із вимкненими сповіщеннями й пояснює, як позначаються дописи"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موضوعات کی دلچسپیاں، میوٹ کیے گئے موضوعات اور ممالک کھولتا ہے، اور بتاتا ہے کہ پوسٹس پر لیبل کیسے لگتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở sở thích chủ đề, chủ đề đã ẩn và quốc gia đã ẩn, và giải thích cách bài đăng được gắn nhãn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开话题兴趣、已静音话题和已静音国家，并说明帖子如何被标注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟主題興趣、靜音主題和靜音國家，並說明貼文如何被標示"
          }
        }
      }
    },
