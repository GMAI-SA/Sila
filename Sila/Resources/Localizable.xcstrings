        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के 48 घंटे बीत चुके हैं — नया लिंक भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "48 sati za potvrdu je prošlo — pošalji novu poveznicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megerősítésre szánt 48 óra letelt – küldj új hivatkozást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "48 jam untuk mengonfirmasi sudah lewat — kirim tautan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 48 ore per confermare sono passate: invia un nuovo link."
