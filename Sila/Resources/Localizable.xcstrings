        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can listen to this room, but its audience means you can't speak in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes escuchar esta sala, pero por su audiencia no puedes hablar en ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kuunnella tätä huonetta, mutta sen yleisön vuoksi et voi puhua siinä."
