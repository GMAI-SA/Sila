    "safety.unblock.hint": {
      "comment": "VoiceOver hint for unblocking. Says what unblocking does not restore, because assuming a follow came back loses somebody an account they cared about.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لكما رؤية بعضكما مجددًا. ولا يعيد أي متابعة أُزيلت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you see each other again. It does not restore any follow that was severed."
          }
        }
      }
    },
    "safety.unblock.toast": {
      "comment": "Toast after an unblock. Says what did not come back, so nobody assumes a follow was restored. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي حظر %@. ولم تُستعد المتابعة — تابعه من جديد إن أردت عودة منشوراته."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblocked %@. Following is not restored — follow them again if you want their posts back."
          }
        }
      }
    },
    "safety.unmute.toast": {
