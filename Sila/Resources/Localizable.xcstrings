        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏమవుతుందో వివరించి, మీ పాస్‌వర్డ్ అడిగే తొలగింపు ఫారమ్‌ను తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแบบฟอร์มการลบ ซึ่งอธิบายสิ่งที่จะเกิดขึ้นและขอรหัสผ่านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neler olacağını açıklayan ve şifrenizi isteyen silme formunu açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває форму видалення, яка пояснює, що станеться, і запитує пароль"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف کرنے کا فارم کھولتا ہے، جو بتاتا ہے کہ کیا ہوگا اور آپ کا پاس ورڈ مانگتا ہے"
