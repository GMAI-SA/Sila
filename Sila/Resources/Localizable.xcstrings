    "document.review.noCountry": {
      "comment": "Shown when the zone names no country.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الوثيقة لا تذكر دولة، لذا لا يمكنها منحك شارة دولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নথিতে কোনো দেশের নাম নেই, তাই এটি দিয়ে দেশের ব্যাজ পাওয়া যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest document no indica cap país, així que no et pot donar una insígnia de país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento doklad neuvádí žádnou zemi, takže ti nemůže dát odznak země."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette dokument nævner intet land, så det kan ikke give dig et landebadge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Dokument ist kein Land angegeben, daher kann es dir kein Länderabzeichen geben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το έγγραφο δεν αναφέρει χώρα, οπότε δεν μπορεί να σου δώσει σήμα χώρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document names no country, so it cannot give you a country badge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no indica ningún país, así que no puede darte una insignia de país."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä asiakirjassa ei ole maata, joten se ei voi antaa sinulle maamerkkiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document n’indique aucun pays, il ne peut donc pas vous donner de badge de pays."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמך הזה לא מציין מדינה, ולכן הוא לא יכול לתת לך תג מדינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दस्तावेज़ में कोई देश नहीं लिखा है, इसलिए इससे आपको देश का बैज नहीं मिल सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova isprava ne navodi nijednu zemlju pa ti ne može dati značku zemlje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az okmány nem nevez meg országot, ezért nem tud országjelvényt adni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini tidak menyebut negara, jadi tidak bisa memberimu lencana negara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo documento non indica nessun paese, quindi non può darti un badge del paese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類には国が記載されていないため、国のバッジは付与できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서에는 국가가 표시되어 있지 않아 국가 배지를 받을 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ രേഖയിൽ രാജ്യം പറയുന്നില്ല, അതിനാൽ രാജ്യ ബാഡ്ജ് നൽകാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini tidak menamakan sebarang negara, jadi ia tidak dapat memberi anda lencana negara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette dokumentet oppgir ikke noe land, så det kan ikke gi deg et landsmerke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document vermeldt geen land, dus je kunt er geen landbadge mee krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dokument nie wskazuje kraju, więc nie można nadać Ci odznaki kraju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento não indica nenhum país, então não pode lhe dar um selo de país."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento não indica nenhum país, por isso não pode dar-lhe um selo de país."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest document nu menționează nicio țară, deci nu îți poate da o insignă de țară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом документе не указана страна, поэтому значок страны выдать нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento doklad neuvádza žiadnu krajinu, takže ti nemôže dať odznak krajiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här dokumentet anger inget land, så det kan inte ge dig ett landsmärke."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆவணத்தில் நாடு குறிப்பிடப்படவில்லை, எனவே நாட்டுப் பேட்ஜ் வழங்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పత్రంలో ఏ దేశం పేరూ లేదు, కాబట్టి ఇది మీకు దేశ బ్యాడ్జ్ ఇవ్వలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารนี้ไม่ระบุประเทศ จึงให้ป้ายประเทศแก่คุณไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu belgede bir ülke belirtilmiyor, bu yüzden size ülke rozeti veremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому документі не вказано країни, тому він не може дати вам значок країни."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دستاویز میں کسی ملک کا نام نہیں، اس لیے یہ آپ کو ملک کا بیج نہیں دے سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy tờ này không nêu quốc gia nào nên không thể cấp cho bạn huy hiệu quốc gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此证件上没有标明国家，因此无法为你提供国家徽章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件沒有註明國家，因此無法給你國家徽章。"
          }
        }
      }
    },
