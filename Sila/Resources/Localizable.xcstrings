    "vouch.refusal.paused": {
      "comment": "%@ is a date.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقك في التزكية موقوف حتى %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত আপনার ভাউচ করার অধিকার স্থগিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu dret d'avalar està en pausa fins al %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé právo ručit je pozastaveno do %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din ret til at gå i god for andre er sat på pause indtil %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Recht zu bürgen ist bis %@ ausgesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δικαίωμά σου να εγγυάσαι έχει ανασταλεί μέχρι τις %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your right to vouch is paused until %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu derecho a avalar está en pausa hasta el %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaamisoikeutesi on keskeytetty %@ asti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre droit de vous porter garant est suspendu jusqu’au %@."
          }
        },
        "he": {
          "stringUnit": {
