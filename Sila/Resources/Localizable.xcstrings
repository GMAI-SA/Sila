    "auth.rejected.tryAgain.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود إلى شاشة التحقق لتجربة الطريقة الأخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য পদ্ধতিতে চেষ্টা করতে ভেরিফিকেশন স্ক্রিনে ফিরে যায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a la pantalla de verificació per provar l'altre mètode"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí se na obrazovku ověření, kde můžeš zkusit jinou metodu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går tilbage til verificeringsskærmen, så du kan prøve den anden metode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehrt zum Verifizierungsbildschirm zurück, um die andere Methode auszuprobieren"
