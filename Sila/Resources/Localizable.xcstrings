        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí formulár na odstránenie, ktorý vysvetľuje, čo sa stane, a pýta si tvoje heslo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar raderingsformuläret, som förklarar vad som händer och ber om ditt lösenord"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன நடக்கும் என்பதை விளக்கி உங்கள் கடவுச்சொல்லைக் கேட்கும் நீக்கப் படிவத்தைத் திறக்கும்"
