          "stringUnit": {
            "state": "translated",
            "value": "Verified human"
          }
        }
      }
    },
    "error.accountDeactivated": {
      "comment": "Last-resort copy if a pending-deletion account reaches a normal screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب مجدول للحذف. ألغِ الحذف لاستخدامه من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion. Cancel the deletion to use it again."
          }
        }
      }
    },
    "error.accountSuspended": {
      "comment": "Last-resort copy if a suspended account reaches a normal screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب موقوف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is suspended."
          }
        }
      }
    },
    "error.alreadyAppealed": {
      "comment": "A second appeal against the same suspension.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق أن قدّمت تظلّمًا على هذا الإيقاف. سِلة تقبل تظلّمًا واحدًا فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already appealed this suspension. One appeal is all Sila accepts."
          }
        }
      }
    },
    "error.alreadyVerified": {
      "comment": "409 already_verified.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هويتك موثّقة بالفعل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your identity is already verified."
          }
        }
      }
    },
    "error.blocked": {
      "comment": "A block exists between the viewer and this thread. Deliberately says nothing about which direction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك الرد هنا. يوجد حظر بينك وبين هذا الحساب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't reply here. There's a block between you and this account."
          }
        }
      }
    },
    "error.confirmationRequired": {
      "comment": "Account deletion arrived without the typed confirmation word. DELETE is typed literally and is never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب DELETE تمامًا للتأكيد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type DELETE exactly to confirm."
          }
        }
      }
    },
    "error.decoding": {
      "comment": "The response body did not match the expected shape.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة رد الخادم. أعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read the server's response. Please try again."
          }
        }
      }
    },
    "error.emailTaken": {
      "comment": "Registration with an address that already has an account.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا البريد لديه حساب في سِلة بالفعل. جرّب تسجيل الدخول بدلًا من ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email already has a Sila account. Try signing in instead."
          }
        }
      }
    },
    "error.emailUnchanged": {
      "comment": "The requested address is the one already on the account.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو بريدك الإلكتروني الحالي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is already your email address."
          }
        }
      }
    },
    "error.emailUnverified": {
      "comment": "Credentials were correct but the address has never been confirmed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد بريدك الإلكتروني للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your email address to continue."
          }
        }
      }
    },
    "error.handleTaken": {
      "comment": "The requested handle is already in use.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المعرّف مستخدم بالفعل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That handle is already taken."
          }
        }
      }
    },
    "error.httpStatus": {
      "comment": "Unparseable non-2xx response. The %@ is the HTTP status code, which is never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الطلب (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request failed (%@)."
          }
        }
      }
    },
    "error.identityAlreadyUsed": {
      "comment": "409 identity_already_used.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الهوية مرتبطة بحساب آخر في سِلة بالفعل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identity is already linked to another Sila account."
          }
        }
      }
    },
    "error.identityHold": {
      "comment": "A write refused while an identity challenge against this account is being reviewed. States what is paused and what is not; never repeats the claim.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشر متوقف مؤقتًا بينما نتحقق من سؤال حول هوية هذا الحساب. لا يزال بإمكانك القراءة، ومنشوراتك لا تزال ظاهرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posting is paused while we check a question about this account's identity. You can still read, and your posts are still visible."
          }
        }
      }
    },
    "error.imageTooLarge": {
      "comment": "The uploaded image is over the size limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة كبيرة جدًا. اختر صورة أقل من 5 ميغابايت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That image is too big. Pick one under 5 MB."
          }
        }
      }
    },
    "error.invalidCountry": {
      "comment": "A preferences save carried something that is not an ISO-3166 alpha-2 code.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رموز الدول من حرفين، مثل SA أو JP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country codes are two letters, like SA or JP."
          }
        }
      }
    },
    "error.invalidCredentials": {
      "comment": "Wrong email/password pair on sign-in.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد وكلمة المرور غير متطابقين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password don't match."
          }
        }
      }
    },
    "error.invalidHandle": {
      "comment": "The requested handle breaks the character rule.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعرّف من 3–20 حرفًا من الأحرف والأرقام والشرطات السفلية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles are 3–20 characters of letters, numbers and underscores."
          }
        }
      }
    },
    "error.invalidImage": {
      "comment": "The uploaded file could not be decoded as an image.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الملف كصورة. اختر صورة بدلًا منه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file couldn't be read as an image. Pick a photo instead."
          }
        }
      }
    },
    "error.invalidNationalId": {
      "comment": "400 invalid_national_id.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو هذا رقم هوية وطنية أو إقامة صالحًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a valid National ID or Iqama number."
          }
        }
      }
    },
    "error.invalidPhone": {
      "comment": "The submitted phone number is not E.164.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الصيغة الدولية، تبدأ بعلامة زائد ورمز الدولة — مثل +966501234567."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use international format, starting with a plus and a country code — for example +966501234567."
          }
        }
      }
    },
    "error.invalidReason": {
      "comment": "A report carried a reason the server no longer knows. Nothing was sent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت قائمة الأسباب في سِلة، فلم يُرسَل شيء. أعد فتح هذا النموذج وأعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila's list of reasons has changed, so nothing was sent. Reopen this form and try again."
          }
        }
      }
    },
    "error.invalidScope": {
      "comment": "The audience combination on a post was rejected by the server.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجمهور غير متاح لهذا المنشور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That audience isn't available for this post."
          }
        }
      }
    },
    "error.noCountry": {
      "comment": "The My Country feed was opened by an account with no verified country.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علم بلدك يأتي من التحقق من الهوية. أكمل التوثيق لفتح بلدي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country flag comes from identity verification. Verify to unlock My Country."
          }
        }
      }
    },
    "error.notPendingDeletion": {
      "comment": "Deletion cancel on an account with nothing scheduled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب غير مجدول للحذف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account isn't scheduled for deletion."
          }
        }
      }
    },
    "error.notPostAuthor": {
      "comment": "Delete or edit attempted on someone else's post.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك حذف سوى منشوراتك أنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only delete your own posts."
          }
        }
      }
    },
    "error.notRoomHost": {
      "comment": "A host-only action attempted by somebody who is not the host.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضيف الغرفة وحده من يستطيع فعل ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the room's host can do that."
          }
        }
      }
    },
    "error.otpAttemptsExceeded": {
      "comment": "Too many wrong code guesses; a fresh code is required.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات خاطئة كثيرة. اطلب رمز تحقق جديدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many incorrect attempts. Request a new code."
          }
        }
      }
    },
    "error.otpExpired": {
      "comment": "The verification code is past its lifetime.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رمز التحقق. اطلب رمزًا جديدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code has expired. Request a new one."
          }
        }
      }
    },
    "error.otpInvalid": {
      "comment": "The submitted verification code does not match.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز التحقق غير صحيح. راجع الأرقام وأعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code isn't right. Check the digits and try again."
          }
        }
      }
    },
    "error.passwordUnchanged": {
      "comment": "The new password is the same as the current one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه كلمة مرورك الحالية. اختر كلمة مرور مختلفة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is already your password. Choose a different one."
          }
        }
      }
    },
    "error.postNotFound": {
      "comment": "The requested post id does not exist or is no longer visible.",
      "extractionState": "manual",
