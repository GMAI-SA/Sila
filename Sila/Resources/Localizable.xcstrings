    "profile.loading.accessibilityLabel": {
      "comment": "VoiceOver label while a profile loads.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحميل هذا الملف"
