    "search.trending.footnote": {
      "comment": "Footnote under the trending list, limiting what the ranking claims.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محسوبة من أحدث المنشورات — وليست ترتيبًا لكل الأوقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাম্প্রতিকতম পোস্ট জুড়ে গোনা — সর্বকালের র‍্যাংকিং নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptat entre les publicacions més recents; no és un rànquing de tots els temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítáno z nejnovějších příspěvků – není to žebříček za celou dobu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talt på tværs af de seneste opslag – ikke en rangliste over alle tider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt über die neuesten Beiträge – keine Bestenliste aller Zeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετράται στις πιο πρόσφατες αναρτήσεις — όχι κατάταξη όλων των εποχών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted across the most recent posts — not an all-time ranking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuentan entre las publicaciones más recientes; no es un ranking histórico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasketaan viimeisimmistä julkaisuista – ei kaikkien aikojen sijoitus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptés sur les posts les plus récents — pas un classement de tous les temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נספר בין הפוסטים האחרונים — לא דירוג של כל הזמנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे हाल की पोस्ट में गिना गया — हर समय की रैंकिंग नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broji se u najnovijim objavama — nije to ljestvica svih vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legfrissebb bejegyzések alapján számolva – nem örökranglista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihitung dari postingan terbaru — bukan peringkat sepanjang masa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contati sui post più recenti, non è una classifica di sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の投稿から集計したもので、通算ランキングではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근 게시물에서 집계한 것으로, 전체 기간 순위가 아니에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും പുതിയ പോസ്റ്റുകളിലാണ് എണ്ണിയത് — എക്കാലത്തെയും റാങ്കിംഗ് അല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikira merentas siaran terkini — bukan kedudukan sepanjang masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt på tvers av de nyeste innleggene, ikke en rangering gjennom alle tider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteld over de meest recente berichten, geen ranglijst aller tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczone w najnowszych wpisach — to nie ranking wszech czasów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contadas entre os posts mais recentes, não é um ranking de todos os tempos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contadas nas publicações mais recentes — não é uma classificação de todos os tempos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărate din cele mai recente postări — nu este un clasament din toate timpurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсчёт по самым свежим постам — это не рейтинг за всё время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítané z najnovších príspevkov — nie celkové poradie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknat över de senaste inläggen – inte en lista över alla tider."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய இடுகைகளில் எண்ணப்பட்டது — எல்லா காலத்துக்குமான தரவரிசை அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇటీవలి పోస్ట్‌లలో లెక్కించబడింది — ఎప్పటికైనా ర్యాంకింగ్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับจากโพสต์ล่าสุด ไม่ใช่อันดับตลอดกาล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son gönderiler üzerinden sayılır; tüm zamanların sıralaması değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підраховано за найновішими дописами — це не рейтинг за весь час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تازہ ترین پوسٹس میں گنا گیا — ہمیشہ کی درجہ بندی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đếm trong những bài đăng gần đây nhất — không phải bảng xếp hạng mọi thời đại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于最近的帖子统计，并非历史总排名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據最近的貼文統計，並非歷來排行。"
          }
        }
      }
    },
