    "vouch.mine.remove.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود إلى خطوة التوثيق إلى أن توثّق هويتك. يبقى كل ما كتبته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয় ভেরিফাই না করা পর্যন্ত আপনি ভেরিফিকেশন ধাপে ফিরে যাবেন। আপনার লেখা সবকিছু থেকে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornes al pas de verificació fins que verifiquis la teva identitat. Tot el que has escrit es manté."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátíš se ke kroku ověření, dokud neověříš svou totožnost. Vše, co jsi napsal, zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du går tilbage til verificeringstrinnet, indtil du verificerer din identitet. Alt, hvad du skrev, bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gehst zurück zum Verifizierungsschritt, bis du deine Identität verifizierst. Alles, was du geschrieben hast, bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέφεις στο βήμα επαλήθευσης μέχρι να επαληθεύσεις την ταυτότητά σου. Ό,τι έγραψες παραμένει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You go back to the verification step until you verify your identity. Everything you wrote stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelves al paso de verificación hasta que verifiques tu identidad. Todo lo que escribiste permanece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaat vahvistusvaiheeseen, kunnes vahvistat henkilöllisyytesi. Kaikki kirjoittamasi säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous revenez à l’étape de vérification jusqu’à ce que vous vérifiiez votre identité. Tout ce que vous avez écrit reste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחזור לשלב האימות עד שתאמת את זהותך. כל מה שכתבת נשאר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपनी पहचान सत्यापित करने तक सत्यापन चरण पर लौट जाते हैं। आपका लिखा सब कुछ बना रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćaš se na korak provjere dok ne potvrdiš identitet. Sve što si napisao/la ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszakerülsz a hitelesítési lépéshez, amíg nem hitelesíted a személyazonosságodat. Minden, amit írtál, megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu kembali ke langkah verifikasi sampai kamu memverifikasi identitasmu. Semua yang kamu tulis tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torni al passaggio di verifica finché non verifichi la tua identità. Tutto ciò che hai scritto resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認をするまで、認証の手順に戻ります。あなたが書いたものはすべて残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 인증할 때까지 인증 단계로 돌아가요. 내가 쓴 글은 모두 그대로 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുംവരെ നിങ്ങൾ വെരിഫിക്കേഷൻ ഘട്ടത്തിലേക്ക് മടങ്ങും. നിങ്ങൾ എഴുതിയതെല്ലാം നിലനിൽക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda kembali ke langkah pengesahan sehingga anda mengesahkan identiti anda. Semua yang anda tulis kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du går tilbake til verifiseringstrinnet til du verifiserer identiteten din. Alt du skrev, blir stående."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gaat terug naar de verificatiestap totdat je je identiteit verifieert. Alles wat je schreef blijft staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wracasz do kroku weryfikacji, dopóki nie zweryfikujesz tożsamości. Wszystko, co napisałeś, zostaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você volta à etapa de verificação até verificar sua identidade. Tudo o que você escreveu permanece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta ao passo de verificação até verificar a sua identidade. Tudo o que escreveu fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Revii la pasul de verificare până când îți verifici identitatea. Tot ce ai scris rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вернётесь к шагу проверки, пока не пройдёте проверку личности. Всё, что вы написали, останется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátiš sa ku kroku overenia, kým si neoveríš totožnosť. Všetko, čo si napísal, zostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du går tillbaka till verifieringssteget tills du verifierar din identitet. Allt du skrivit finns kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடையாளத்தைச் சரிபார்க்கும் வரை சரிபார்ப்புப் படிக்கு நீங்கள் திரும்புவீர்கள். நீங்கள் எழுதியவை அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపును ధృవీకరించే వరకు మీరు ధృవీకరణ దశకు తిరిగి వెళ్తారు. మీరు రాసినవన్నీ అలాగే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะกลับไปที่ขั้นตอนการยืนยันจนกว่าจะยืนยันตัวตน ทุกสิ่งที่คุณเขียนยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi doğrulayana kadar doğrulama adımına geri dönersiniz. Yazdığınız her şey kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви повернетеся до кроку верифікації, доки не верифікуєте особу. Усе, що ви написали, залишається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ اپنی شناخت کی تصدیق نہ کریں آپ تصدیق کے مرحلے پر واپس چلے جاتے ہیں۔ آپ کا لکھا ہوا سب کچھ رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn quay lại bước xác minh cho đến khi xác minh danh tính. Mọi thứ bạn đã viết vẫn còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你验证身份之前，你会回到验证步骤。你写的所有内容都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你驗證身分之前，你會回到驗證步驟。你寫的所有內容都會保留。"
          }
        }
      }
    },
