    "vouch.form.nationality.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جنسيته كما في هويته. على من يفتح الرابط أن يختار الجنسية نفسها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাঁর আইডিতে যে জাতীয়তা আছে। যিনি লিংক খুলবেন তাঁকে একই জাতীয়তা দিতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La seva nacionalitat, tal com és al document. Qui obri l'enllaç n'ha d'indicar la mateixa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich státní příslušnost jako na dokladu. Kdokoli odkaz otevře, musí uvést stejnou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedkommendes nationalitet, som på id'et. Den, der åbner linket, skal angive den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Staatsangehörigkeit wie im Ausweis. Wer den Link öffnet, muss dieselbe angeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηκοότητά του, όπως στην ταυτότητά του. Όποιος ανοίξει τον σύνδεσμο πρέπει να δώσει την ίδια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their nationality, as on their ID. Whoever opens the link has to give the same one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nacionalidad, como en su documento. Quien abra el enlace tiene que indicar la misma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heidän kansalaisuutensa kuten henkilöllisyystodistuksessa. Linkin avaajan on annettava sama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa nationalité, comme sur sa pièce d’identité. La personne qui ouvre le lien doit donner la même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזרחות שלהם, כפי שהיא בתעודת הזהות. מי שפותח את הקישור חייב למסור את אותה אזרחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनकी राष्ट्रीयता, जैसी उनकी ID पर है। जो भी लिंक खोले उसे यही देनी होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihovo državljanstvo, kao na ispravi. Tko god otvori poveznicu mora navesti isto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az állampolgársága, az azonosítóján szereplő módon. Akárki nyitja meg a hivatkozást, ugyanezt kell megadnia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan mereka, seperti di ID. Siapa pun yang membuka tautan harus memberikan yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua nazionalità, come sul documento. Chi apre il link deve indicare la stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のIDに記載の国籍です。リンクを開く人も同じものを入力する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방 신분증에 적힌 국적이에요. 링크를 여는 사람도 같은 국적을 입력해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരുടെ ഐഡിയിലുള്ള ദേശീയത. ലിങ്ക് തുറക്കുന്നയാൾ അതേത് തന്നെ നൽകണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan mereka, seperti pada ID mereka. Sesiapa yang membuka pautan mesti memberikan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasjonaliteten deres, som på ID-en. Den som åpner lenken, må oppgi den samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun nationaliteit, zoals op hun identiteitsbewijs. Wie de link opent moet dezelfde opgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej obywatelstwo, jak w jej dokumencie. Osoba, która otworzy link, musi podać to samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nacionalidade da pessoa, como no documento. Quem abrir o link precisa informar a mesma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nacionalidade da pessoa, como no documento. Quem abrir a ligação tem de indicar a mesma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetățenia lor, ca pe act. Cine deschide linkul trebuie să dea aceeași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гражданство человека, как в его документе. Тот, кто откроет ссылку, должен указать то же самое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej národnosť ako na preukaze. Kto otvorí odkaz, musí uviesť rovnakú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras nationalitet, som på deras id. Den som öppnar länken måste ange samma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் அடையாள அட்டையில் உள்ளபடி அவர்களின் நாட்டினம். இணைப்பைத் திறப்பவர் அதே நாட்டினத்தையே கொடுக்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారి ID లో ఉన్న వారి జాతీయత. లింక్ తెరిచే వ్యక్తి కూడా అదే ఇవ్వాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญชาติของเขาตามบัตรประจำตัว คนที่เปิดลิงก์ต้องระบุสัญชาติเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinde yazdığı şekliyle uyruğu. Bağlantıyı açan kişi aynısını vermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їхнє громадянство, як у документі. Той, хто відкриє посилання, має вказати те саме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کی قومیت، جیسی ان کے شناختی کارڈ پر ہے۔ جو بھی لنک کھولے اسے یہی دینی ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc tịch của họ, như trên giấy tờ. Ai mở liên kết phải khai đúng quốc tịch đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方证件上的国籍。打开链接的人必须填写相同的国籍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方證件上的國籍。開啟連結的人必須填寫相同的國籍。"
          }
        }
      }
    },
