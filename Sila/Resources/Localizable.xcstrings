    "vouch.wall.pending.withdraw.message": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُطلب من ⁦@%@⁩ التأكيد. ما زال بإمكانك توثيق هويتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@-কে নিশ্চিত করতে বলা হবে না। আপনি তবুও নিজের পরিচয় ভেরিফাই করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es demanarà a @%@ que confirmi. Encara pots verificar la teva pròpia identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nebude požádán o potvrzení. Stále můžeš ověřit vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bliver ikke bedt om at bekræfte. Du kan stadig verificere din egen identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ wird nicht gebeten zu bestätigen. Du kannst weiterhin deine eigene Identität verifizieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ δεν θα κληθεί να επιβεβαιώσει. Μπορείς ακόμα να επαληθεύσεις την ταυτότητά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ won't be asked to confirm. You can still verify your own identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se le pedirá a @%@ que confirme. Aún puedes verificar tu propia identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjää @%@ ei pyydetä vahvistamaan. Voit yhä vahvistaa oman henkilöllisyytesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ne sera pas invité à confirmer. Vous pouvez toujours vérifier votre propre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ לא יתבקש לאשר. אפשר עדיין לאמת את זהותך בעצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ से कन्फ़र्म करने को नहीं कहा जाएगा। आप फिर भी अपनी पहचान खुद सत्यापित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od @%@ se neće tražiti potvrda. I dalje možeš potvrditi vlastiti identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nem kap felkérést a megerősítésre. A saját személyazonosságodat továbbra is hitelesítheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak akan diminta mengonfirmasi. Kamu masih bisa memverifikasi identitasmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A @%@ non verrà chiesto di confermare. Puoi comunque verificare la tua identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@に確認は依頼されなくなります。ご自身で本人確認をすることはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님에게 확인을 요청하지 않아요. 직접 신원을 인증할 수는 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ നോട് സ്ഥിരീകരിക്കാൻ ആവശ്യപ്പെടില്ല. നിങ്ങൾക്ക് ഇപ്പോഴും സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak akan diminta mengesahkan. Anda masih boleh mengesahkan identiti anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ blir ikke bedt om å bekrefte. Du kan fortsatt verifisere din egen identitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ wordt niet gevraagd te bevestigen. Je kunt nog steeds je eigen identiteit verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nie zostanie poproszony(-a) o potwierdzenie. Nadal możesz zweryfikować własną tożsamość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não será solicitado a confirmar. Você ainda pode verificar sua própria identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não será pedido a @%@ que confirme. Pode ainda verificar a sua própria identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lui @%@ nu i se va cere să confirme. Îți poți verifica în continuare propria identitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ не попросят подтверждать. Вы по-прежнему можете пройти собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nebude požiadaný o potvrdenie. Stále si môžeš overiť vlastnú totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ombeds inte bekräfta. Du kan fortfarande verifiera din egen identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிப்படுத்த @%@ இடம் கேட்கப்படாது. நீங்கள் இன்னும் உங்கள் அடையாளத்தைச் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిర్ధారించమని @%@ ను అడగరు. మీరు ఇప్పటికీ మీ స్వంత గుర్తింపును ధృవీకరించుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ จะไม่ถูกขอให้ยืนยัน คุณยังยืนยันตัวตนของตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kişisinden onay istenmeyecek. Yine de kendi kimliğinizi doğrulayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ не попросять підтвердити. Ви все ще можете верифікувати власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ سے تصدیق کرنے کو نہیں کہا جائے گا۔ آپ پھر بھی اپنی شناخت کی تصدیق کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sẽ không được yêu cầu xác nhận. Bạn vẫn có thể tự xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将不再请 @%@ 确认。你仍可验证自己的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 將不會被請求確認。你仍可驗證自己的身分。"
          }
        }
      }
    },
