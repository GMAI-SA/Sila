    "account.email.useDifferent.hint": {
      "comment": "VoiceOver hint for starting the email change over.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاهل هذا الرمز ويبدأ من جديد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discards this code and starts again"
          }
        }
      }
    },
    "account.export.detail": {
      "comment": "What the export contains, and what it deliberately leaves out — the automatic topic labels are Sila's guesses, not the user's words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك، وكل منشور كتبته، وإعدادات مواضيعك، ومن تتابعهم، في ملف JSON. أما تصنيفات المواضيع التلقائية فمستثناة، والملف يوضّح ذلك: فهي تخمينات من سِلة عن منشوراتك، وليست شيئًا كتبته أنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, every post you have written, your topic settings and who you follow, as a JSON file. Automatic topic labels are left out and the file says so: they are guesses Sila made about your posts, not anything you wrote."
          }
        }
      }
    },
    "account.export.download": {
      "comment": "Button that fetches the export.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزيل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        }
      }
    },
