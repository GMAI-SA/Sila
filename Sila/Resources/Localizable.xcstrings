    "guest.room.refusal.roomEnded.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف لا تُسجَّل أبدًا، فلا يوجد ما يُعاد تشغيله. انضم إلى «معروف» لتسمع الغرفة القادمة مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম কখনও রেকর্ড করা হয় না, তাই চালানোর মতো কিছু নেই। পরেরটি লাইভ শুনতে Known-এ যোগ দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sales no s'enregistren mai, així que no hi ha res per reproduir. Uneix-te a Known per poder escoltar la propera en directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnosti se nikdy nenahrávají, takže není co přehrát. Připoj se k aplikaci Known, abys příště slyšel živě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum bliver aldrig optaget, så der er intet at afspille. Deltag i Known, så du kan høre det næste live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume werden nie aufgezeichnet, daher gibt es nichts zum Abspielen. Tritt Known bei, um den nächsten live zu hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αίθουσες δεν ηχογραφούνται ποτέ, οπότε δεν υπάρχει τίποτα να αναπαραχθεί. Γράψου στο Known για να ακούσεις την επόμενη ζωντανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms are never recorded, so there's nothing to play back. Join Known so you can hear the next one live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas nunca se graban, así que no hay nada que reproducir. Únete a Known para oír la próxima en directo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huoneita ei koskaan tallenneta, joten toistettavaa ei ole. Liity Knowniin, jotta voit kuulla seuraavan livenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les salons ne sont jamais enregistrés, il n’y a donc rien à réécouter. Rejoignez Known pour entendre le prochain en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרים לעולם לא מוקלטים, ולכן אין מה להשמיע מחדש. הצטרף ל-Known כדי לשמוע את הבא בשידור חי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम कभी रिकॉर्ड नहीं होते, इसलिए दोबारा सुनने को कुछ नहीं है। अगला रूम लाइव सुनने के लिए Known से जुड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe se nikada ne snimaju pa nema što reproducirati. Pridruži se aplikaciji Known da sljedeću čuješ uživo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szobákat soha nem rögzítjük, így nincs mit visszajátszani. Csatlakozz a Knownhoz, hogy a következőt élőben hallhasd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room tidak pernah direkam, jadi tidak ada yang bisa diputar ulang. Gabung Known agar kamu bisa mendengar yang berikutnya secara langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stanze non vengono mai registrate, quindi non c'è nulla da riascoltare. Iscriviti a Known per ascoltare la prossima dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームは録音されないため、再生できるものはありません。次回はライブで聴けるよう、Knownに参加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸은 녹음되지 않으므로 다시 들을 수 있는 것이 없어요. 다음 룸을 라이브로 들으려면 Known에 가입하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമുകൾ ഒരിക്കലും റെക്കോർഡ് ചെയ്യാത്തതിനാൽ പ്ലേ ചെയ്യാൻ ഒന്നുമില്ല. അടുത്തത് ലൈവ് ആയി കേൾക്കാൻ Known-ൽ ചേരുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik tidak pernah dirakam, jadi tiada apa-apa untuk dimainkan semula. Sertai Known supaya anda boleh mendengar yang seterusnya secara langsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rom tas aldri opp, så det er ingenting å spille av. Bli med på Known slik at du kan høre det neste live."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms worden nooit opgenomen, dus er is niets om terug te luisteren. Meld je aan bij Known om de volgende live te horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje nigdy nie są nagrywane, więc nie ma czego odtworzyć. Dołącz do Known, aby usłyszeć następny na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas, então não há nada para reproduzir. Entre no Known para ouvir a próxima ao vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas, por isso não há nada para reproduzir. Entre na Known para ouvir a próxima em direto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerele nu sunt înregistrate niciodată, deci nu e nimic de redat. Alătură-te Known ca s-o auzi pe următoarea live."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комнаты никогда не записываются, поэтому воспроизводить нечего. Присоединитесь к Known, чтобы услышать следующую вживую."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosti sa nikdy nenahrávajú, takže nie je čo prehrať. Pripoj sa k Known a nasledujúcu si vypočuj naživo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum spelas aldrig in, så det finns inget att spela upp. Gå med i Known så kan du höra nästa live."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைகள் ஒருபோதும் பதிவு செய்யப்படுவதில்லை, எனவே மீண்டும் ஒலிக்க எதுவும் இல்லை. அடுத்ததை நேரலையில் கேட்க Known-இல் சேருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లు ఎప్పుడూ రికార్డ్ చేయబడవు, కాబట్టి తిరిగి ప్లే చేయడానికి ఏదీ లేదు. తదుపరిదాన్ని లైవ్‌లో వినడానికి Knownలో చేరండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องไม่เคยถูกบันทึกเสียง จึงไม่มีอะไรให้เล่นย้อนหลัง เข้าร่วม Known เพื่อฟังห้องถัดไปแบบสด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odalar asla kaydedilmez, bu yüzden oynatılacak bir şey yok. Bir sonrakini canlı duyabilmek için Known'a katılın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнати ніколи не записуються, тож нічого відтворити. Приєднайтеся до Known, щоб почути наступну наживо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رومز کبھی ریکارڈ نہیں ہوتے، اس لیے چلانے کو کچھ نہیں۔ Known میں شامل ہوں تاکہ اگلا روم لائیو سن سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng không bao giờ được ghi âm nên không có gì để phát lại. Hãy tham gia Known để nghe trực tiếp phòng tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间从不录音，所以没有可回放的内容。加入 Known，下次就能现场收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室絕不會被錄音，所以無法回放。加入 Known，就能即時收聽下一場。"
          }
        }
      }
    },
