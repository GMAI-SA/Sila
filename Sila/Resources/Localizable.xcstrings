    "safety.report.reason.selectedHint": {
      "comment": "VoiceOver hint for the selected reason row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُختار. اضغط مرة أخرى لإلغائه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাছাই করা। সরাতে আবার ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
