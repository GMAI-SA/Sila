        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’une connexion. L’envoi reprendra de lui-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין לחיבור. ההעלאה תמשיך מעצמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन का इंतज़ार है। अपलोड अपने-आप जारी रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka se veza. Prijenos će se nastaviti sam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolatra várunk. A feltöltés magától folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu koneksi. Unggahan akan berlanjut dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di connessione. Il caricamento riprenderà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を待っています。アップロードは自動的に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 기다리는 중이에요. 업로드는 저절로 이어서 진행돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്ഷനായി കാത്തിരിക്കുന്നു. അപ്‌ലോഡ് തനിയെ തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu sambungan. Muat naik akan diteruskan dengan sendirinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på tilkobling. Opplastingen fortsetter av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op verbinding. Het uploaden gaat vanzelf verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekam na połączenie. Przesyłanie wznowi się samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando conexão. O envio continuará sozinho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera de ligação. O envio continuará por si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă o conexiune. Încărcarea va continua singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание соединения. Загрузка продолжится сама."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čaká sa na pripojenie. Nahrávanie bude pokračovať samo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på anslutning. Uppladdningen fortsätter av sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்புக்காகக் காத்திருக்கிறது. பதிவேற்றம் தானாகத் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్షన్ కోసం వేచి ఉంది. అప్‌లోడ్ దానంతట అదే కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอการเชื่อมต่อ การอัปโหลดจะทำต่อเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı bekleniyor. Yükleme kendiliğinden devam edecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуємо підключення. Завантаження продовжиться саме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن کا انتظار ہے۔ اپ لوڈ خود جاری ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ kết nối. Việc tải lên sẽ tự tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待网络连接，上传会自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待連線。上傳會自動繼續。"
          }
        }
      }
