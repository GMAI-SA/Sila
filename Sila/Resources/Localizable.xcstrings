        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 룸을 열어요. 길게 누르면 더 많은 옵션이 나와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം തുറക്കാൻ ടാപ്പ് ചെയ്യുക. കൂടുതലിന് അമർത്തിപ്പിടിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk membuka bilik. Tahan untuk lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å åpne et rom. Trykk og hold for mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om een room te openen. Houd ingedrukt voor meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby otworzyć pokój. Przytrzymaj, aby zobaczyć więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para abrir uma sala. Mantenha pressionado para ver mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para abrir uma sala. Mantenha premido para mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a deschide o cameră. Ține apăsat pentru mai multe."
