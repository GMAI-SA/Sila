    "rooms.copy.neverRecorded": {
      "comment": "The promise every room screen carries, placed where somebody reads it before they speak.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف لا تُسجَّل أبدًا. لا إعادة ولا نص مكتوب ولا ملف — وعندما تنتهي هذه الغرفة يذهب ما قيل فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম কখনও রেকর্ড করা হয় না। কোনো রিপ্লে, ট্রান্সক্রিপ্ট বা ফাইল নেই — রুম শেষ হলে এতে যা বলা হয়েছে তা চিরতরে চলে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sales no s'enregistren mai. No hi ha repetició, ni transcripció, ni fitxer: quan acabi aquesta sala, el que s'hi ha dit desapareix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnosti se nikdy nenahrávají. Neexistuje záznam, přepis ani soubor – až tato místnost skončí, to, co v ní zaznělo, zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum bliver aldrig optaget. Der er ingen genafspilning, ingen udskrift og ingen fil – når dette rum slutter, er det, der blev sagt i det, væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume werden nie aufgezeichnet. Es gibt keine Wiedergabe, kein Transkript und keine Datei – wenn dieser Raum endet, ist das Gesagte weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αίθουσες δεν ηχογραφούνται ποτέ. Δεν υπάρχει επανάληψη, απομαγνητοφώνηση ή αρχείο — όταν τελειώσει αυτή η αίθουσα, ό,τι ειπώθηκε χάνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms are never recorded. There is no replay, no transcript and no file — when this room ends, what was said in it is gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas nunca se graban. No hay repetición, ni transcripción, ni archivo: cuando esta sala termine, lo que se dijo en ella desaparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huoneita ei koskaan tallenneta. Uusintaa, litteraattia tai tiedostoa ei ole – kun tämä huone päättyy, siinä sanottu on poissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les salons ne sont jamais enregistrés. Il n’y a ni réécoute, ni transcription, ni fichier — quand ce salon se termine, ce qui s’y est dit disparaît."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרים לעולם לא מוקלטים. אין הקלטה חוזרת, אין תמלול ואין קובץ — כשהחדר הזה מסתיים, מה שנאמר בו נעלם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम कभी रिकॉर्ड नहीं होते। न रीप्ले है, न ट्रांसक्रिप्ट, न कोई फ़ाइल — रूम खत्म होते ही उसमें जो कहा गया वह चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe se nikada ne snimaju. Nema reprize, transkripta ni datoteke — kad ova soba završi, ono što je u njoj rečeno nestaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szobákat soha nem rögzítjük. Nincs visszajátszás, átirat vagy fájl – amikor a szoba véget ér, ami elhangzott benne, eltűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room tidak pernah direkam. Tidak ada putar ulang, transkrip, atau berkas — saat room ini berakhir, apa yang dikatakan di dalamnya hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stanze non vengono mai registrate. Non c'è replay, trascrizione o file: quando questa stanza finisce, ciò che vi è stato detto sparisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームは録音されません。再生も、文字起こしも、ファイルもありません。ルームが終わると、そこで話されたことは消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸은 절대 녹음되지 않아요. 다시 듣기도, 녹취록도, 파일도 없어요. 룸이 끝나면 그 안에서 나눈 말은 사라져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമുകൾ ഒരിക്കലും റെക്കോർഡ് ചെയ്യില്ല. റീപ്ലേ ഇല്ല, ട്രാൻസ്ക്രിപ്റ്റ് ഇല്ല, ഫയൽ ഇല്ല — ഈ റൂം അവസാനിക്കുമ്പോൾ ഇതിൽ പറഞ്ഞതെല്ലാം ഇല്ലാതാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik tidak pernah dirakam. Tiada main semula, tiada transkrip dan tiada fail — apabila bilik ini tamat, apa yang dikatakan di dalamnya hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rom tas aldri opp. Det finnes ingen avspilling, ingen utskrift og ingen fil. Når dette rommet avsluttes, er det som ble sagt i det, borte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms worden nooit opgenomen. Er is geen terugkijkfunctie, geen transcript en geen bestand: als deze room eindigt, is wat erin gezegd is weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje nigdy nie są nagrywane. Nie ma powtórki, transkrypcji ani pliku — gdy ten pokój się skończy, to, co w nim powiedziano, zniknie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas. Não há replay, transcrição nem arquivo: quando esta sala terminar, o que foi dito nela desaparece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas. Não há repetição, transcrição nem ficheiro — quando esta sala terminar, o que foi dito desaparece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerele nu sunt înregistrate niciodată. Nu există reluare, transcriere sau fișier — când această cameră se încheie, ce s-a spus în ea dispare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комнаты никогда не записываются. Нет ни повтора, ни расшифровки, ни файла — когда комната закончится, сказанное в ней исчезнет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosti sa nikdy nenahrávajú. Neexistuje prehrávanie, prepis ani súbor — keď miestnosť skončí, to, čo v nej odznelo, je preč."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum spelas aldrig in. Det finns ingen uppspelning, ingen utskrift och ingen fil – när det här rummet avslutas är det som sades borta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைகள் ஒருபோதும் பதிவு செய்யப்படுவதில்லை. மறு ஒலிபரப்பு இல்லை, எழுத்துப்படி இல்லை, கோப்பு இல்லை — இந்த அறை முடிந்ததும் இதில் பேசப்பட்டவை மறைந்துவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లు ఎప్పుడూ రికార్డ్ చేయబడవు. రీప్లే లేదు, ట్రాన్‌స్క్రిప్ట్ లేదు, ఫైల్ లేదు — ఈ రూమ్ ముగిసినప్పుడు, అందులో చెప్పినదంతా పోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องไม่เคยถูกบันทึกเสียง ไม่มีการเล่นย้อนหลัง ไม่มีถอดความ และไม่มีไฟล์ เมื่อห้องนี้จบ สิ่งที่พูดในห้องจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odalar asla kaydedilmez. Tekrar oynatma, döküm ve dosya yoktur; bu oda sona erdiğinde içinde söylenenler yok olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнати ніколи не записуються. Немає ні повтору, ні стенограми, ні файлу — коли ця кімната завершиться, сказане в ній зникне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رومز کبھی ریکارڈ نہیں ہوتے۔ نہ ری پلے ہے، نہ ٹرانسکرپٹ، نہ کوئی فائل — جب یہ روم ختم ہوتا ہے تو اس میں جو کہا گیا وہ ختم ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng không bao giờ được ghi âm. Không có phát lại, không có bản ghi chép và không có tệp — khi phòng này kết thúc, những gì đã nói trong đó sẽ biến mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间从不录音。没有回放、没有文字记录、也没有文件，房间结束后，其中说过的话就消失了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室絕不會被錄音。沒有重播、沒有逐字稿、沒有檔案，聊天室結束後，其中說過的話就消失了。"
          }
        }
      }
    },
