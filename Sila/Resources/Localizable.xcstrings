    "search.empty.noResults.posts": {
      "comment": "No matching posts. %@ is the query. Says search matches words, not meaning, so an empty result is not read as a claim about the topic.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد منشور يحتوي على «%@». البحث يطابق كلمات المنشور، لا معناها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো পোস্টে “%@” নেই। সার্চ পোস্টের শব্দ মেলায়, অর্থ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap publicació conté «%@». La cerca coincideix amb les paraules d'una publicació, no amb el seu significat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný příspěvek neobsahuje „%@“. Hledání odpovídá slovům v příspěvku, ne jejich významu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet opslag indeholder “%@”. Søgningen matcher ordene i et opslag, ikke deres betydning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Beitrag enthält „%@“. Die Suche findet die Wörter in einem Beitrag, nicht ihre Bedeutung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία ανάρτηση δεν περιέχει «%@». Η αναζήτηση ταιριάζει με τις λέξεις μιας ανάρτησης, όχι με το νόημά τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No post contains “%@”. Search matches the words in a post, not their meaning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna publicación contiene «%@». La búsqueda coincide con las palabras de una publicación, no con su significado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään julkaisu ei sisällä hakua “%@”. Haku vastaa julkaisun sanoja, ei niiden merkitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun post ne contient « %@ ». La recherche porte sur les mots d’un post, pas sur leur sens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף פוסט לא מכיל ״%@״. החיפוש מתאים למילים בפוסט, לא למשמעות שלהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पोस्ट में “%@” नहीं है। खोज पोस्ट के शब्दों से मेल खाती है, उनके अर्थ से नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna objava ne sadrži „%@”. Pretraga se podudara s riječima u objavi, a ne s njihovim značenjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen bejegyzés sem tartalmazza ezt: „%@”. A keresés a bejegyzések szavaira illeszkedik, nem a jelentésükre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada postingan yang memuat “%@”. Pencarian mencocokkan kata dalam postingan, bukan maknanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun post contiene “%@”. La ricerca trova le parole in un post, non il loro significato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を含む投稿はありません。検索は投稿内の言葉に一致するもので、意味では検索しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”가 포함된 게시물이 없어요. 검색은 게시물의 단어와 일치하는 것을 찾으며 의미를 찾지는 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” അടങ്ങിയ പോസ്റ്റ് ഇല്ല. തിരയൽ പോസ്റ്റിലെ വാക്കുകളെയാണ് നോക്കുന്നത്, അർത്ഥത്തെയല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada siaran mengandungi “%@”. Carian memadankan perkataan dalam siaran, bukan maknanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen innlegg inneholder «%@». Søket treffer ordene i et innlegg, ikke betydningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bericht bevat “%@”. Zoeken vindt de woorden in een bericht, niet de betekenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden wpis nie zawiera „%@”. Wyszukiwanie dopasowuje słowa we wpisie, nie ich znaczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum post contém “%@”. A busca encontra as palavras de um post, não o significado delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma publicação contém “%@”. A pesquisa procura as palavras de uma publicação, não o seu significado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio postare nu conține „%@”. Căutarea potrivește cuvintele dintr-o postare, nu sensul lor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет постов, содержащих «%@». Поиск совпадает со словами в посте, а не с их смыслом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny príspevok neobsahuje „%@“. Hľadanie zodpovedá slovám v príspevku, nie ich významu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget inlägg innehåller ”%@”. Sökningen matchar orden i ett inlägg, inte deras betydelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” உள்ள இடுகை எதுவும் இல்லை. தேடல் இடுகையில் உள்ள சொற்களைப் பொருத்துகிறது, பொருளை அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ఉన్న పోస్ట్ ఏదీ లేదు. శోధన పోస్ట్‌లోని పదాలను సరిపోల్చుతుంది, అర్థాన్ని కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีโพสต์ที่มี “%@” การค้นหาจับคู่กับคำในโพสต์ ไม่ใช่ความหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir gönderi “%@” içermiyor. Arama, bir gönderideki sözcükleri eşleştirir, anlamını değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден допис не містить «%@». Пошук збігається зі словами в дописі, а не з їхнім змістом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی پوسٹ میں “%@” نہیں ہے۔ تلاش پوسٹ کے الفاظ سے ملتی ہے، ان کے مطلب سے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bài đăng nào chứa “%@”. Tìm kiếm khớp với các từ trong bài đăng, không phải ý nghĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有包含“%@”的帖子。搜索匹配的是帖子中的字词，而不是含义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有貼文包含「%@」。搜尋比對的是貼文中的字詞，而非語意。"
