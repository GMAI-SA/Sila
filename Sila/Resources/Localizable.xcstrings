    "error.imageUnavailable": {
      "comment": "400 image_unavailable (contract v27): an uploaded picture is gone, already on another post, or never arrived. Uploading it again fixes it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحدى صور هذا المنشور لم تعد متاحة. احذفها ثم أضفها من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোস্টের একটি ছবি আর পাওয়া যাচ্ছে না। সেটি সরিয়ে আবার যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imatge d'aquesta publicació ja no està disponible. Elimina-la i torna-la a afegir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek v tomto příspěvku už není dostupný. Odeber ho a přidej znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et billede i dette opslag er ikke længere tilgængeligt. Fjern det, og tilføj det igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild in diesem Beitrag ist nicht mehr verfügbar. Entferne es und füge es erneut hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια εικόνα σε αυτή την ανάρτηση δεν είναι πια διαθέσιμη. Αφαίρεσέ την και πρόσθεσέ την ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
