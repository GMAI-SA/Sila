    "notifications.kind.roomCancelled.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تُلغى غرفة تنتظرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে রুমের অপেক্ষায় আছেন তা বাতিল হলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan es cancel·la una sala que esperaves."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se zruší místnost, na kterou čekáš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et rum, du venter på, aflyses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Raum, auf den du wartest, abgesagt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ακυρώνεται μια αίθουσα που περιμένεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a room you're waiting for is cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se cancela una sala que esperabas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun odottamasi huone perutaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un salon que vous attendez est annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשחדר שאתה ממתין לו בוטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपके इंतज़ार वाला रूम रद्द हो जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad se otkaže soba koju čekaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy szoba, amelyre vársz, le lesz mondva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat room yang kamu tunggu dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una stanza che aspetti viene annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始を待っているルームが中止されたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리던 룸이 취소되었을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കാത്തിരിക്കുന്ന ഒരു റൂം റദ്ദാക്കപ്പെടുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila bilik yang anda tunggu dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et rom du venter på, avlyses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een room waarop je wacht wordt geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy pokój, na który czekasz, zostanie anulowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma sala que você esperava é cancelada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma sala que está a aguardar é cancelada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când o cameră pe care o aștepți este anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда отменяется комната, которую вы ждёте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa zruší miestnosť, na ktorú čakáš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När ett rum du väntar på ställs in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காத்திருக்கும் அறை ரத்து செய்யப்படும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎదురుచూస్తున్న రూమ్ రద్దయినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อห้องที่คุณรออยู่ถูกยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklediğiniz bir oda iptal edildiğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли кімнату, на яку ви чекаєте, скасовано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی روم جس کا آپ انتظار کر رہے ہوں منسوخ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một phòng bạn đang chờ bị hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在等待的房间被取消时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在等待的聊天室被取消時。"
          }
        }
      }
    },
