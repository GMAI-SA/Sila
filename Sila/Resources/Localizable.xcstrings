    "ds.verifiedBadge.hint": {
      "comment": "VoiceOver hint spelling out exactly what the checkmark means.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجتاز هذا الحساب التحقق من الهوية الحكومية والتحقق من الوجه الحي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্ট সরকারি আইডি ও লাইভনেস ভেরিফিকেশন পার করেছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte ha superat la verificació de document d'identitat oficial i de prova de vida"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet prošel ověřením úředním dokladem a kontrolou živosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto har bestået verificering med officielt id og livlighedskontrol"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat die Prüfung per amtlichem Ausweis und Lebenderkennung bestanden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός πέρασε επαλήθευση με κρατική ταυτότητα και έλεγχο ζωντάνιας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account passed government ID and liveness verification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta superó la verificación con documento de identidad oficial y prueba de vida"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tili läpäisi viranomaisen myöntämän henkilöllisyystodistuksen ja elävyyden vahvistuksen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte a passé la vérification de pièce d’identité officielle et de présence"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון הזה עבר אימות תעודת זהות ממשלתית ובדיקת חיות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट ने सरकारी ID और लाइवनेस सत्यापन पास किया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj račun prošao je provjeru državne isprave i provjeru uživosti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók átment a hivatalos azonosítóval és az élőségi ellenőrzéssel történő hitelesítésen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini lolos verifikasi ID resmi dan keaslian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account ha superato la verifica del documento d'identità e della presenza reale"
          }
        },
        "ja": {
          "stringUnit": {
