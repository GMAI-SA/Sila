        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఎవరూ వినడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีใครฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kimse dinlemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ніхто не слухає."
          }
        },
        "ur": {
          "stringUnit": {
