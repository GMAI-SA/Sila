    "composer.gif.unavailable.subtitle": {
      "comment": "Under “GIFs aren't available yet” in the GIF picker: what the person can still do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال بإمكانك إضافة صورة إلى منشورك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তবু আপনার পোস্টে একটি ছবি যোগ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara pots afegir una foto a la teva publicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K příspěvku můžeš stále přidat fotku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan stadig tilføje et foto til dit opslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deinem Beitrag trotzdem ein Foto hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς ακόμα να προσθέσεις μια φωτογραφία στην ανάρτησή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still add a photo to your post."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes añadir una foto a tu publicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit silti lisätä julkaisuusi kuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez quand même ajouter une photo à votre post."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אפשר להוסיף תמונה לפוסט שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप फिर भी अपनी पोस्ट में फ़ोटो जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svejedno možeš dodati fotografiju svojoj objavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotót továbbra is hozzáadhatsz a bejegyzésedhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tetap bisa menambahkan foto ke postinganmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi comunque aggiungere una foto al tuo post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿に写真を追加することはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물에 사진은 계속 추가할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പോസ്റ്റിൽ ഒരു ഫോട്ടോ ചേർക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda masih boleh menambah foto pada siaran anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsatt legge til et bilde i innlegget ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nog steeds een foto aan je bericht toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal możesz dodać zdjęcie do wpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode adicionar uma foto ao seu post."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda pode adicionar uma foto à sua publicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot poți adăuga o fotografie la postare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К посту по-прежнему можно добавить фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K príspevku môžeš stále pridať fotku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortfarande lägga till ett foto i ditt inlägg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடுகையில் புகைப்படத்தை இன்னும் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా మీ పోస్ట్‌కు ఫోటోను జోడించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังเพิ่มรูปภาพในโพสต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderinize yine de fotoğraf ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви все ще можете додати фото до допису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنی پوسٹ میں پھر بھی تصویر شامل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vẫn có thể thêm ảnh vào bài đăng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍然可以为帖子添加照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍然可以在貼文中加入照片。"
          }
        }
      }
    },
    "composer.gif.unavailable.title": {
