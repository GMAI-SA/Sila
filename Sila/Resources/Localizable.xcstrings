        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionné. Touchez à nouveau pour désélectionner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבחר. הקש שוב כדי לנקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया। हटाने के लिए फिर टैप करें।"
