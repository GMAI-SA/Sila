    "error.consentChanged": {
      "comment": "Contract v34 §7.4: 400 consent_version_unknown / 409 consent_not_offered.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر شيء من جهتنا. راجع التفاصيل وأرسل مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের দিকে কিছু বদলেছে। তথ্য দেখে আবার পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha canviat per part nostra. Revisa les dades i torna-ho a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na naší straně se něco změnilo. Zkontroluj údaje a odešli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget har ændret sig hos os. Tjek oplysningerne, og send igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf unserer Seite hat sich etwas geändert. Prüfe die Angaben und sende erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι άλλαξε από τη δική μας πλευρά. Έλεγξε τα στοιχεία και στείλε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something changed on our side. Check the details and send again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo cambió por nuestra parte. Revisa los detalles y envía de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotain muuttui meidän päässämme. Tarkista tiedot ja lähetä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a changé de notre côté. Vérifiez les informations et renvoyez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתנה אצלנו. בדוק את הפרטים ושלח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारी तरफ़ कुछ बदल गया। विवरण जाँचें और फिर भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto se promijenilo na našoj strani. Provjeri podatke i pošalji ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami megváltozott a mi oldalunkon. Ellenőrizd az adatokat, és küldd el újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang berubah di sisi kami. Periksa detailnya dan kirim lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è cambiato da parte nostra. Controlla i dettagli e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちら側で変更がありました。内容を確認して、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 쪽에서 변경된 내용이 있어요. 내용을 확인하고 다시 보내세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങളുടെ ഭാഗത്ത് എന്തോ മാറി. വിവരങ്ങൾ പരിശോധിച്ച് വീണ്ടും അയയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu berubah di pihak kami. Semak butiran dan hantar semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe endret seg hos oss. Sjekk opplysningene og send på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets veranderd aan onze kant. Controleer de gegevens en verstuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś się zmieniło po naszej stronie. Sprawdź szczegóły i wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo mudou do nosso lado. Confira os detalhes e envie de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo mudou do nosso lado. Verifique os dados e envie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva s-a schimbat din partea noastră. Verifică detaliile și trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нашей стороне что-то изменилось. Проверьте данные и отправьте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na našej strane sa niečo zmenilo. Skontroluj údaje a odošli znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något ändrades hos oss. Kontrollera uppgifterna och skicka igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்கள் பக்கத்தில் ஏதோ மாறியுள்ளது. விவரங்களைச் சரிபார்த்து மீண்டும் அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మా వైపు ఏదో మారింది. వివరాలను తనిఖీ చేసి మళ్లీ పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีบางอย่างเปลี่ยนไปในฝั่งของเรา ตรวจสอบรายละเอียดแล้วส่งอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizim tarafımızda bir şey değişti. Bilgileri kontrol edin ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З нашого боку щось змінилося. Перевірте деталі й надішліть знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہماری طرف کچھ بدل گیا ہے۔ تفصیلات دیکھیں اور دوبارہ بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thay đổi ở phía chúng tôi. Hãy kiểm tra lại thông tin và gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们这边有所变动。请检查详细信息后重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們這邊有些變動。請檢查詳細資料後再次送出。"
          }
        }
      }
    },
