          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ شناخت پہلے ہی کسی دوسرے Known اکاؤنٹ سے جڑی ہوئی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính này đã được liên kết với một tài khoản Known khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此身份已关联到另一个 Known 账户。"
          }
        },
