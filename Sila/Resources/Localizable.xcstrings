    "voice.kind.hotTake.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى دقيقة. سيوافقك الناس أو يخالفونك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ এক মিনিট। মানুষ একমত বা দ্বিমত হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a un minut. La gent hi estarà d'acord o no."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až minutu. Lidé budou souhlasit nebo nesouhlasit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til et minut. Folk vil være enige eller uenige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu einer Minute. Andere stimmen zu oder widersprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως ένα λεπτό. Οι άλλοι θα συμφωνήσουν ή θα διαφωνήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to a minute. People will agree or disagree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta un minuto. La gente estará de acuerdo o en desacuerdo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään minuutti. Ihmiset ovat samaa tai eri mieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à une minute. Les gens seront d’accord ou non."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד דקה. אנשים יסכימו או לא יסכימו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम एक मिनट। लोग सहमत या असहमत होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minute. Ljudi će se složiti ili ne složiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb egy perc. Az emberek egyetértenek vagy nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga satu menit. Orang akan setuju atau tidak setuju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a un minuto. Le persone saranno d'accordo o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長1分。賛成か反対かを他の人が示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 1분. 사람들이 찬성하거나 반대해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മിനിറ്റ് വരെ. ആളുകൾ യോജിക്കുകയോ വിയോജിക്കുകയോ ചെയ്യും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga seminit. Orang akan bersetuju atau tidak bersetuju."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil ett minutt. Folk kan være enige eller uenige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal een minuut. Mensen kunnen het ermee eens of oneens zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minuty. Ludzie będą się zgadzać lub nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até um minuto. As pessoas vão concordar ou discordar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até um minuto. As pessoas vão concordar ou discordar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la un minut. Oamenii vor fi de acord sau nu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До минуты. Люди согласятся или нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minúty. Ľudia budú súhlasiť alebo nesúhlasiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till en minut. Folk håller med eller inte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நிமிடம் வரை. மக்கள் ஒப்புக்கொள்வார்கள் அல்லது மறுப்பார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నిమిషం వరకు. ప్రజలు అంగీకరిస్తారు లేదా అంగీకరించరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกินหนึ่งนาที ผู้คนจะเห็นด้วยหรือไม่เห็นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla bir dakika. İnsanlar katılır veya katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До хвилини. Люди погодяться або ні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک منٹ تک۔ لوگ متفق یا غیر متفق ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa một phút. Mọi người sẽ đồng ý hoặc không đồng ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长一分钟。大家可以赞同或反对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最長一分鐘。大家會表示同意或不同意。"
          }
        }
      }
    },
