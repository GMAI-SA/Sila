    "profile.unavailable.subtitle": {
      "comment": "The 404 dead end. %@ is the handle with its at sign, or the fallback phrase.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا يعود إلى حساب نشط في سِلة. ربما حُذف الحساب أو تغيّر المعرّف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't belong to an active Sila account. It may have been deleted, or the handle may have changed."
          }
