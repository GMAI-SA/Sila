        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不會得知。Known 不會發送通知，也不會向對方顯示任何相關訊息。"
          }
        }
      }
    },
    "safety.block.consequence.visibility": {
      "comment": "Block consequence 1 of 4: what stops being visible, in both directions. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف كل منكما عن رؤية الآخر. تختفي منشورات %@ وردوده من صفحاتك ونتائج بحثك وكل سلسلة تفتحها — وتختفي منشوراتك عنه كذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনারা পরস্পরকে দেখা বন্ধ করেন। %@-এর পোস্ট ও উত্তর আপনার ফিড, সার্চ ফলাফল এবং আপনার খোলা প্রতিটি থ্রেড থেকে চলে যায় — আর আপনারগুলো তাদের থেকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixeu de veure-us. Les publicacions i respostes de %@ desapareixen dels teus canals, dels resultats de cerca i de tots els fils que obris, i les teves desapareixen dels seus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přestanete se vidět. Příspěvky a odpovědi uživatele %@ zmizí z tvých kanálů, hledání i každého vlákna, které otevřeš – a tvé zmizí z jeho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I holder op med at se hinanden. Opslag og svar fra %@ forsvinder fra dine feeds, dine søgeresultater og enhver tråd, du åbner – og dine fra deres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seht einander nicht mehr. Beiträge und Antworten von %@ verschwinden aus deinen Feeds, Suchergebnissen und jedem Thread, den du öffnest – und deine aus denen der Person."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταματάτε να βλέπετε ο ένας τον άλλον. Οι αναρτήσεις και οι απαντήσεις του/της %@ φεύγουν από τις ροές σου, τα αποτελέσματα αναζήτησης και κάθε νήμα που ανοίγεις — και οι δικές σου φεύγουν από τις δικές του/της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stop seeing each other. %@'s posts and replies leave your feeds, your search results and every thread you open — and yours leave theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejáis de veros. Las publicaciones y respuestas de %@ desaparecen de tus feeds, tus búsquedas y todos los hilos que abras, y las tuyas de los suyos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ette enää näe toisianne. Käyttäjän %@ julkaisut ja vastaukset poistuvat syötteistäsi, hakutuloksistasi ja kaikista avaamistasi ketjuista – ja sinun hänen omistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous voyez plus. Les posts et réponses de %@ disparaissent de vos fils, de vos résultats de recherche et de chaque discussion que vous ouvrez — et les vôtres disparaissent des siens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם מפסיקים לראות זה את זה. הפוסטים והתגובות של %@ יוצאים מהפידים שלך, מתוצאות החיפוש ומכל שרשור שאתה פותח — והשלך יוצאים משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक-दूसरे को देखना बंद कर देते हैं। %@ की पोस्ट और जवाब आपकी फ़ीड, खोज नतीजों और आपके खोले हर थ्रेड से हट जाते हैं — और आपके उनके यहाँ से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestajete se vidjeti. Objave i odgovori korisnika %@ nestaju iz tvojih feedova, rezultata pretraživanja i svake niti koju otvoriš — a tvoje iz njegovih/njezinih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem látjátok egymást. %@ bejegyzései és válaszai eltűnnek a hírfolyamaidból, a keresési találataidból és minden megnyitott szálból – és a tieid az övéiből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalian berhenti saling melihat. Postingan dan balasan %@ hilang dari feed, hasil pencarian, dan setiap utas yang kamu buka — dan milikmu hilang dari milik mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smettete di vedervi. I post e le risposte di %@ spariscono dai tuoi feed, dai risultati di ricerca e da ogni discussione che apri, e i tuoi spariscono dai suoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お互いが見えなくなります。%@の投稿と返信は、あなたのフィード、検索結果、開くすべてのスレッドから消え、あなたの投稿と返信も相手から消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 보이지 않게 돼요. %@님의 게시물과 답글이 내 피드, 검색 결과, 내가 여는 모든 스레드에서 사라지고, 내 것도 상대방에게서 사라져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ പരസ്പരം കാണില്ല. %@ എന്നയാളുടെ പോസ്റ്റുകളും മറുപടികളും നിങ്ങളുടെ ഫീഡുകളിൽ നിന്നും തിരയൽ ഫലങ്ങളിൽ നിന്നും നിങ്ങൾ തുറക്കുന്ന ഓരോ ത്രെഡിൽ നിന്നും ഇല്ലാതാകും — നിങ്ങളുടേത് അവരുടേതിൽ നിന്നും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berhenti saling melihat. Siaran dan balasan %@ hilang daripada suapan, hasil carian dan setiap utas yang anda buka — dan milik anda hilang daripada milik mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dere slutter å se hverandre. Innleggene og svarene til %@ forsvinner fra feedene dine, søkeresultatene dine og alle tråder du åpner, og dine forsvinner fra deres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zien elkaar niet meer. De berichten en reacties van %@ verdwijnen uit je feeds, zoekresultaten en elke thread die je opent, en die van jou uit die van hen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestajecie się widzieć. Wpisy i odpowiedzi: %@ znikają z Twoich kanałów, wyników wyszukiwania i każdego otwieranego wątku — a Twoje z ich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês deixam de se ver. Os posts e respostas de %@ saem dos seus feeds, dos resultados de busca e de todos os fios que você abrir, e os seus saem dos dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixam de se ver. As publicações e respostas de %@ saem dos seus feeds, resultados de pesquisa e de todas as conversas que abrir — e as suas saem dos dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vă mai vedeți reciproc. Postările și răspunsurile lui %@ dispar din fluxurile tale, din rezultatele căutării și din fiecare conversație pe care o deschizi — iar ale tale dispar de la el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы перестаёте видеть друг друга. Посты и ответы %@ исчезают из ваших лент, результатов поиска и всех открываемых вами веток — а ваши из их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestanete sa navzájom vidieť. Príspevky a odpovede používateľa %@ zmiznú z tvojich kanálov, výsledkov vyhľadávania aj každého vlákna, ktoré otvoríš — a tvoje z jeho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni slutar se varandra. %@s inlägg och svar försvinner från dina flöden, dina sökresultat och varje tråd du öppnar – och dina från deras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஒருவரையொருவர் பார்ப்பது நின்றுவிடும். %@ இன் இடுகைகளும் பதில்களும் உங்கள் ஊட்டங்கள், தேடல் முடிவுகள், நீங்கள் திறக்கும் ஒவ்வொரு உரையாடலிலிருந்தும் நீங்கும் — உங்களுடையவையும் அவர்களுடையதிலிருந்து நீங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఒకరినొకరు చూడటం ఆగిపోతుంది. %@ పోస్ట్‌లు, రిప్లైలు మీ ఫీడ్‌ల నుండి, శోధన ఫలితాల నుండి, మీరు తెరిచే ప్రతి థ్రెడ్ నుండి మాయమవుతాయి — మీవి వారి నుండి మాయమవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่เห็นกันและกัน โพสต์และคำตอบของ %@ จะหายจากฟีด ผลการค้นหา และทุกเธรดที่คุณเปิด และของคุณก็หายจากของพวกเขาเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirinizi görmezsiniz. %@ kişisinin gönderileri ve yanıtları akışlarınızdan, arama sonuçlarınızdan ve açtığınız her konuşmadan çıkar; sizinkiler de onunkilerden çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви перестаєте бачити одне одного. Дописи й відповіді %@ зникають із ваших стрічок, результатів пошуку та кожного обговорення, яке ви відкриваєте, — а ваші зникають з їхніх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ایک دوسرے کو دیکھنا بند کر دیتے ہیں۔ %@ کی پوسٹس اور جوابات آپ کی فیڈز، سرچ نتائج اور آپ کے کھولے ہر تھریڈ سے نکل جاتے ہیں — اور آپ کی ان کی سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai bên không còn thấy nhau. Bài đăng và trả lời của %@ rời khỏi bảng tin, kết quả tìm kiếm và mọi chuỗi bạn mở — và của bạn cũng rời khỏi của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们将互相看不到对方。%@ 的帖子和回复会从你的信息流、搜索结果和你打开的每个对话串中消失，你的内容在对方那边也一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們看不到彼此。%@ 的貼文和回覆會從你的動態、搜尋結果和你開啟的所有串文中消失，你的內容也會從對方那邊消失。"
          }
        }
      }
    },
    "safety.block.reversible": {
      "comment": "The line under the confirmation's buttons, saying where a block can be undone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إلغاء الحظر من الإعدادات ← الأمان في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো সময় সেটিংস → নিরাপত্তা থেকে আনব্লক করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots desbloquejar des d'Ajustos → Seguretat en qualsevol moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokovat můžeš kdykoli v Nastavení → Bezpečí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fjerne blokeringen under Indstillinger → Sikkerhed når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit unter Einstellungen → Sicherheit entblocken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να άρεις τον αποκλεισμό οποτεδήποτε από Ρυθμίσεις → Ασφάλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can unblock from Settings → Safety at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desbloquear en cualquier momento desde Ajustes → Seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit poistaa eston milloin tahansa kohdassa Asetukset → Turvallisuus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez débloquer à tout moment depuis Réglages → Sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבטל חסימה בהגדרות ← בטיחות בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कभी भी सेटिंग्स → सुरक्षा से अनब्लॉक कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš odblokirati u Postavke → Sigurnost bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor feloldhatod: Beállítások → Biztonság."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa membuka blokir dari Pengaturan → Keamanan kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi sbloccare da Impostazioni → Sicurezza in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックは、設定 → 安全からいつでも解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 안전에서 언제든 차단을 해제할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണങ്ങൾ → സുരക്ഷ എന്നതിൽ നിന്ന് എപ്പോൾ വേണമെങ്കിലും അൺബ്ലോക്ക് ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyahsekat daripada Tetapan → Keselamatan pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan oppheve blokkeringen fra Innstillinger → Sikkerhet når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd deblokkeren via Instellingen → Veiligheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W każdej chwili możesz odblokować w Ustawienia → Bezpieczeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode desbloquear em Ajustes → Segurança a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode desbloquear em Definições → Segurança em qualquer altura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți debloca oricând din Setări → Siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать можно в любой момент в «Настройки» → «Безопасность»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedykoľvek môžeš odblokovať v Nastavenia → Bezpečnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avblockera från Inställningar → Säkerhet när som helst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் → பாதுகாப்பு என்பதில் எப்போது வேண்டுமானாலும் தடையை நீக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎప్పుడైనా సెట్టింగ్‌లు → భద్రత నుండి అన్‌బ్లాక్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลิกบล็อกได้ทุกเมื่อจาก การตั้งค่า → ความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engeli istediğiniz zaman Ayarlar → Güvenlik'ten kaldırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокувати можна в Налаштування → Безпека будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کسی بھی وقت سیٹنگز ← تحفظ سے ان بلاک کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể bỏ chặn từ Cài đặt → An toàn bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在“设置 → 安全”中取消屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在「設定」→「安全」中解除封鎖。"
          }
        }
      }
    },
    "safety.block.toast": {
      "comment": "Toast after a block. Repeats what happened, including the silence. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُظر %@. اختفت منشوراته عنك، وأُزيلت أي متابعة بينكما، ولم يُبلَّغ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে ব্লক করা হয়েছে। তাদের পোস্ট আপনার ফিড থেকে চলে গেছে, আপনাদের মধ্যকার যেকোনো ফলো সরানো হয়েছে, এবং তাদের জানানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has bloquejat %@. Les seves publicacions han desaparegut dels teus canals, s'ha eliminat qualsevol seguiment entre vosaltres i no ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ je zablokován. Jeho příspěvky zmizely z tvých kanálů, veškeré sledování mezi vámi je odstraněno a nebyl o tom informován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokerede %@. Vedkommendes opslag er væk fra dine feeds, enhver følgning mellem jer er fjernet, og vedkommende fik ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blockiert. Die Beiträge sind aus deinen Feeds verschwunden, jedes Follow zwischen euch wurde entfernt, und die Person wurde nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποκλείστηκε ο/η %@. Οι αναρτήσεις του/της έφυγαν από τις ροές σου, κάθε ακολούθηση μεταξύ σας αφαιρέθηκε και δεν ενημερώθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked %@. Their posts are gone from your feeds, any follow between you is removed, and they were not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueaste a %@. Sus publicaciones ya no están en tus feeds, se eliminó cualquier seguimiento entre vosotros y no se le avisó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estit käyttäjän %@. Hänen julkaisunsa ovat poissa syötteistäsi, kaikki välillänne olleet seuraamiset poistettu, eikä hänelle kerrottu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est bloqué. Ses posts ont disparu de vos fils, tout abonnement entre vous est supprimé, et il n’en a pas été informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ נחסם. הפוסטים שלו נעלמו מהפידים שלך, כל מעקב ביניכם הוסר, והוא לא קיבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को ब्लॉक किया। उनकी पोस्ट आपकी फ़ीड से हट गईं, आपके बीच का कोई भी फ़ॉलो हटा दिया गया, और उन्हें बताया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokirano: %@. Njihove objave nestale su iz tvojih feedova, svako praćenje među vama je uklonjeno i nisu obaviješteni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ letiltva. A bejegyzései eltűntek a hírfolyamaidból, a köztetek lévő követések megszűntek, és nem kapott értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diblokir. Postingannya hilang dari feed-mu, hubungan mengikuti di antara kalian dihapus, dan mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bloccato. I suoi post sono spariti dai tuoi feed, ogni follow tra voi è stato rimosso e non è stato avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をブロックしました。投稿はフィードから消え、2人の間のフォローは解除され、相手には知らされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 차단했어요. 게시물이 피드에서 사라지고, 둘 사이의 팔로우가 해제되었으며, 상대방에게는 알려지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ ബ്ലോക്ക് ചെയ്തു. അവരുടെ പോസ്റ്റുകൾ നിങ്ങളുടെ ഫീഡുകളിൽ നിന്ന് മാഞ്ഞു, നിങ്ങൾക്കിടയിലെ ഫോളോ നീക്കി, അവരെ അറിയിച്ചിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disekat. Siaran mereka hilang daripada suapan anda, sebarang ikutan antara anda dialih keluar, dan mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkerte %@. Innleggene deres er borte fra feedene dine, all følging mellom dere er fjernet, og de fikk ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geblokkeerd. Hun berichten zijn uit je feeds verdwenen, elke volgrelatie tussen jullie is verwijderd en ze zijn hier niet van op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowano: %@. Jego wpisy zniknęły z Twoich kanałów, obserwowanie między Wami zostało usunięte, a on nie został poinformowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bloqueado. Os posts dessa pessoa saíram dos seus feeds, qualquer vínculo de seguir entre vocês foi removido, e ela não foi avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bloqueado. As publicações desta conta desapareceram dos seus feeds, qualquer seguimento entre vocês foi removido, e a conta não foi avisada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ai blocat pe %@. Postările lui au dispărut din fluxurile tale, orice urmărire dintre voi este eliminată și nu a fost anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заблокирован(а). Посты исчезли из ваших лент, подписки между вами удалены, а владельца аккаунта не уведомляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je zablokovaný. Jeho príspevky zmizli z tvojich kanálov, sledovanie medzi vami sa zrušilo a nedozvedel sa o tom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockerade %@. Deras inlägg är borta från dina flöden, all följning mellan er har tagits bort och de fick inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தடுக்கப்பட்டார். அவர்களின் இடுகைகள் உங்கள் ஊட்டங்களிலிருந்து நீங்கின, உங்களுக்கிடையிலான பின்தொடர்தல்கள் அகற்றப்பட்டன, அவர்களுக்குத் தெரிவிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ను బ్లాక్ చేశారు. వారి పోస్ట్‌లు మీ ఫీడ్‌ల నుండి పోయాయి, మీ మధ్య ఉన్న ఏ ఫాలో అయినా తొలగించబడింది, వారికి చెప్పబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อก %@ แล้ว โพสต์ของพวกเขาหายจากฟีดของคุณ การติดตามระหว่างกันถูกลบ และพวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ engellendi. Gönderileri akışlarınızdan kalktı, aranızdaki takipler kaldırıldı ve kendilerine haber verilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заблоковано. Їхні дописи зникли з ваших стрічок, будь-яку підписку між вами видалено, і їх не повідомили."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو بلاک کیا۔ ان کی پوسٹس آپ کی فیڈز سے غائب ہیں، آپ کے درمیان کوئی بھی فالو ہٹا دیا گیا، اور انہیں نہیں بتایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chặn %@. Bài đăng của họ biến mất khỏi bảng tin của bạn, mọi lượt theo dõi giữa hai bên bị xóa, và họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽 %@。对方的帖子已从你的信息流中消失，你们之间的任何关注已移除，对方并不知情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封鎖 %@。對方的貼文已從你的動態消失，你們之間的追蹤關係已移除，對方不會得知。"
          }
        }
      }
    },
    "safety.list.blocked.caption": {
      "comment": "The explanation at the top of the blocked list. Repeats the silence and that unblocking restores no follow.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك أنت وهذه الحسابات رؤية بعضكم. ولم يُبلَّغ أي منها، وإلغاء الحظر لا يعيد أي متابعة قُطعت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ও এই অ্যাকাউন্টগুলো পরস্পরকে দেখতে পান না। এদের কাউকে জানানো হয়নি, আর আনব্লক করলে ছিন্ন হওয়া কোনো ফলো ফিরে আসে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu i aquests comptes no us podeu veure. Cap d'ells no ho sap, i desbloquejar no restaura cap seguiment que s'hagi tallat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty a tyto účty se navzájem nevidíte. Nikdo z nich nebyl informován a odblokování neobnoví žádné přerušené sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og disse konti kan ikke se hinanden. Ingen af dem fik besked, og når du fjerner blokeringen, genskabes ingen afbrudt følgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du und diese Konten könnt einander nicht sehen. Keines wurde benachrichtigt, und Entblocken stellt kein getrenntes Follow wieder her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσύ και αυτοί οι λογαριασμοί δεν βλέπετε ο ένας τον άλλον. Κανείς τους δεν ενημερώθηκε και η άρση αποκλεισμού δεν επαναφέρει καμία ακολούθηση που διακόπηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and these accounts cannot see each other. None of them were told, and unblocking does not restore any follow that was severed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú y estas cuentas no podéis veros. A ninguna se le avisó, y desbloquear no restablece ningún seguimiento cortado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä ja nämä tilit ette näe toisianne. Kenellekään heistä ei kerrottu, eikä eston poistaminen palauta katkaistuja seuraamisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous et ces comptes ne pouvez pas vous voir. Aucun n’en a été informé, et débloquer ne rétablit aucun abonnement rompu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה והחשבונות האלה לא יכולים לראות זה את זה. אף אחד מהם לא קיבל הודעה, וביטול חסימה לא משחזר מעקב שנותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप और ये अकाउंट एक-दूसरे को नहीं देख सकते। इनमें से किसी को बताया नहीं गया, और अनब्लॉक करने से कटा हुआ कोई फ़ॉलो वापस नहीं आता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti i ovi računi ne možete vidjeti jedni druge. Nitko od njih nije obaviješten, a odblokiranje ne vraća nijedno prekinuto praćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te és ezek a fiókok nem láttok egymást. Egyikük sem kapott értesítést, és a feloldás nem állítja vissza a megszüntetett követéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dan akun-akun ini tidak bisa saling melihat. Tidak ada yang diberi tahu, dan membuka blokir tidak memulihkan hubungan mengikuti yang diputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu e questi account non potete vedervi. Nessuno è stato avvisato, e sbloccare non ripristina i follow che erano stati interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたとこれらのアカウントは、お互いが見えません。誰にも知らされておらず、ブロックを解除しても、解除されたフォローは元に戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나와 이 계정들은 서로를 볼 수 없어요. 누구에게도 알려지지 않았으며, 차단을 해제해도 끊어진 팔로우는 복원되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കും ഈ അക്കൗണ്ടുകൾക്കും പരസ്പരം കാണാനാകില്ല. ആരെയും അറിയിച്ചിട്ടില്ല, അൺബ്ലോക്ക് ചെയ്താലും ഇല്ലാതായ ഫോളോ തിരികെ വരില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dan akaun ini tidak dapat saling melihat. Tiada seorang pun daripada mereka diberitahu, dan menyahsekat tidak memulihkan sebarang ikutan yang telah diputuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du og disse kontoene kan ikke se hverandre. Ingen av dem fikk vite det, og å oppheve blokkeringen gjenoppretter ingen følging som ble avbrutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij en deze accounts kunnen elkaar niet zien. Geen van hen is op de hoogte gesteld, en deblokkeren herstelt geen verbroken volgrelatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty i te konta nie widzicie się nawzajem. Żadne z nich nie zostało poinformowane, a odblokowanie nie przywraca przerwanego obserwowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você e estas contas não podem se ver. Nenhuma delas foi avisada, e desbloquear não restaura nenhum vínculo de seguir que tenha sido desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você e estas contas não se conseguem ver. Nenhuma foi avisada, e desbloquear não repõe nenhum seguimento que tenha sido cortado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu și aceste conturi nu vă puteți vedea reciproc. Niciunul nu a fost anunțat, iar deblocarea nu readuce urmăririle întrerupte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и эти аккаунты не видите друг друга. Никого из них не уведомляли, а разблокировка не возвращает разорванные подписки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty a tieto účty sa nevidíte. Nikto z nich sa to nedozvedel a odblokovanie neobnoví žiadne zrušené sledovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du och dessa konton kan inte se varandra. Ingen av dem fick veta det, och att avblockera återställer ingen följning som bröts."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்களும் இந்தக் கணக்குகளும் ஒருவரையொருவர் பார்க்க முடியாது. அவர்களில் யாருக்கும் தெரிவிக்கப்படவில்லை, தடையை நீக்கினாலும் துண்டிக்கப்பட்ட பின்தொடர்தல் எதுவும் மீளாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు, ఈ ఖాతాలు ఒకరినొకరు చూడలేరు. వారిలో ఎవరికీ చెప్పబడలేదు, అన్‌బ్లాక్ చేసినా తెగిపోయిన ఫాలోలేవీ పునరుద్ధరించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณและบัญชีเหล่านี้มองไม่เห็นกันและกัน ไม่มีใครได้รับแจ้ง และการเลิกบล็อกไม่ได้คืนการติดตามที่ถูกตัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz ve bu hesaplar birbirinizi göremezsiniz. Hiçbirine haber verilmedi ve engeli kaldırmak kesilen takipleri geri getirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви й ці облікові записи не бачите одне одного. Нікого з них не повідомили, а розблокування не відновлює жодної розірваної підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اور یہ اکاؤنٹس ایک دوسرے کو نہیں دیکھ سکتے۔ ان میں سے کسی کو نہیں بتایا گیا، اور ان بلاک کرنے سے ختم کیا گیا کوئی فالو بحال نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn và các tài khoản này không thấy nhau. Không ai trong số họ được thông báo, và bỏ chặn không khôi phục lượt theo dõi đã bị cắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你和这些账户互相看不到对方。他们都不知情，取消屏蔽也不会恢复已被切断的关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你和這些帳號看不到彼此。他們都不會得知，且解除封鎖不會恢復被切斷的追蹤。"
          }
        }
      }
    },
    "safety.list.muted.caption": {
      "comment": "The explanation at the top of the muted list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الحسابات لا تظهر لك. ولم يُبلَّغ أي منها، ولم يتغير شيء آخر في علاقتكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টগুলো আপনার ফিডে দেখা যায় না। এদের কাউকে জানানো হয়নি, আর আপনাদের সম্পর্কে আর কিছুই বদলায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquests comptes no apareixen als teus canals. Cap d'ells no ho sap i res més de la vostra relació ha canviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto účty se ve tvých kanálech nezobrazují. Nikdo z nich nebyl informován a na vašem vztahu se nic jiného nezměnilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse konti vises ikke i dine feeds. Ingen af dem fik besked, og intet andet i jeres forhold er ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Konten erscheinen nicht in deinen Feeds. Keines wurde benachrichtigt, und an eurer Beziehung hat sich sonst nichts geändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτοί οι λογαριασμοί δεν εμφανίζονται στις ροές σου. Κανείς τους δεν ενημερώθηκε και τίποτα άλλο στη σχέση σας δεν άλλαξε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These accounts do not appear in your feeds. None of them were told, and nothing else about your relationship changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cuentas no aparecen en tus feeds. A ninguna se le avisó y nada más de vuestra relación ha cambiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä tilit eivät näy syötteissäsi. Kenellekään heistä ei kerrottu, eikä mikään muu suhteessanne muuttunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces comptes n’apparaissent pas dans vos fils. Aucun n’en a été informé, et rien d’autre n’a changé dans votre relation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבונות האלה לא מופיעים בפידים שלך. אף אחד מהם לא קיבל הודעה, ושום דבר אחר ביחסים שלכם לא השתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अकाउंट आपकी फ़ीड में नहीं दिखते। इनमें से किसी को बताया नहीं गया, और आपके रिश्ते में और कुछ नहीं बदला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovi računi ne pojavljuju se u tvojim feedovima. Nitko od njih nije obaviješten i ništa drugo u vašem odnosu nije promijenjeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a fiókok nem jelennek meg a hírfolyamaidban. Egyikük sem kapott értesítést, és a kapcsolatotokban semmi más nem változott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun-akun ini tidak muncul di feed-mu. Tidak ada yang diberi tahu, dan tidak ada hal lain tentang hubungan kalian yang berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi account non compaiono nei tuoi feed. Nessuno è stato avvisato e nient'altro del vostro rapporto è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアカウントは、あなたのフィードに表示されません。誰にも知らされておらず、それ以外の関係は何も変わっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정들은 내 피드에 나타나지 않아요. 누구에게도 알려지지 않았으며 그 밖의 관계는 변한 것이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടുകൾ നിങ്ങളുടെ ഫീഡുകളിൽ കാണില്ല. ആരെയും അറിയിച്ചിട്ടില്ല, നിങ്ങളുടെ ബന്ധത്തിൽ മറ്റൊന്നും മാറിയിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini tidak muncul dalam suapan anda. Tiada seorang pun daripada mereka diberitahu, dan tiada apa lagi tentang hubungan anda berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse kontoene vises ikke i feedene dine. Ingen av dem fikk vite det, og ingenting annet ved forholdet deres er endret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze accounts verschijnen niet in je feeds. Geen van hen is op de hoogte gesteld en er is verder niets veranderd aan jullie relatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te konta nie pojawiają się w Twoich kanałach. Żadne z nich nie zostało poinformowane i nic innego w waszej relacji się nie zmieniło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas contas não aparecem nos seus feeds. Nenhuma foi avisada, e nada mais na relação de vocês mudou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas contas não aparecem nos seus feeds. Nenhuma foi avisada, e mais nada na vossa relação mudou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste conturi nu apar în fluxurile tale. Niciunul nu a fost anunțat și nimic altceva din relația voastră nu s-a schimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти аккаунты не появляются в ваших лентах. Никого из них не уведомляли, и больше ничего в ваших отношениях не изменилось."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto účty sa nezobrazujú v tvojich kanáloch. Nikto z nich sa to nedozvedel a na vašom vzťahu sa inak nič nezmenilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa konton visas inte i dina flöden. Ingen av dem fick veta det, och inget annat i er relation har ändrats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்குகள் உங்கள் ஊட்டங்களில் தோன்றாது. அவர்களில் யாருக்கும் தெரிவிக்கப்படவில்லை, உங்கள் உறவில் வேறு எதுவும் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతాలు మీ ఫీడ్‌లలో కనిపించవు. వారిలో ఎవరికీ చెప్పబడలేదు, మీ సంబంధం గురించి మరేదీ మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีเหล่านี้ไม่ปรากฏในฟีดของคุณ ไม่มีใครได้รับแจ้ง และไม่มีอะไรอย่างอื่นในความสัมพันธ์ของคุณเปลี่ยนไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaplar akışlarınızda görünmez. Hiçbirine haber verilmedi ve ilişkinizle ilgili başka hiçbir şey değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці облікові записи не з’являються у ваших стрічках. Нікого з них не повідомили, і більше нічого у ваших стосунках не змінилося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اکاؤنٹس آپ کی فیڈز میں نظر نہیں آتے۔ ان میں سے کسی کو نہیں بتایا گیا، اور آپ کے تعلق میں کچھ اور نہیں بدلا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tài khoản này không xuất hiện trong bảng tin của bạn. Không ai trong số họ được thông báo, và không có gì khác về mối quan hệ của bạn thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些账户不会出现在你的信息流中。他们都不知情，你们之间的其他关系也没有改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些帳號不會出現在你的動態中。他們都不會得知，你們之間的其他關係也沒有改變。"
          }
        }
      }
    },
    "safety.list.reports.caption": {
      "comment": "The explanation at the top of the reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أبلغت عنه، وما وصل إليه كل بلاغ. ولا يُعرض على الحسابات المعنية من أبلغ عنها أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা কিছু রিপোর্ট করেছেন এবং প্রতিটি কতদূর এগিয়েছে। জড়িত অ্যাকাউন্টগুলোকে কখনও দেখানো হয় না কে রিপোর্ট করেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el que has denunciat i en quin punt és cada cas. Als comptes implicats mai se'ls mostra qui els ha denunciat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co jsi nahlásil, a kde to každé je. Dotčeným účtům se nikdy neukáže, kdo je nahlásil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad du har anmeldt, og hvor langt hver sag er nået. De involverede konti får aldrig vist, hvem der anmeldte dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du gemeldet hast, und wie weit jede Meldung ist. Den betroffenen Konten wird nie gezeigt, wer sie gemeldet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα έχεις αναφέρει και πού βρίσκεται το καθένα. Στους λογαριασμούς που αφορούν δεν εμφανίζεται ποτέ ποιος τους ανέφερε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have reported, and where each one has got to. The accounts involved are never shown who reported them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que has denunciado y en qué punto está cada denuncia. A las cuentas implicadas nunca se les muestra quién las denunció."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki ilmiantamasi ja se, missä vaiheessa kukin on. Osallisille tileille ei koskaan näytetä, kuka ilmiantoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez signalé, et où en est chaque signalement. Les comptes concernés ne voient jamais qui les a signalés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שדיווחת עליו, ולאן כל אחד הגיע. החשבונות המעורבים אף פעם לא רואים מי דיווח עליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कुछ रिपोर्ट किया, और हर एक अब कहाँ तक पहुँचा। शामिल अकाउंट को कभी नहीं दिखाया जाता कि किसने रिपोर्ट किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve što si prijavio/la i dokle je svaka prijava stigla. Uključenim računima nikada se ne prikazuje tko ih je prijavio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit jelentettél, és hol tart az ügy. Az érintett fiókok soha nem látják, ki jelentette őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang pernah kamu laporkan, dan sampai di mana masing-masing. Akun yang terlibat tidak pernah diperlihatkan siapa yang melaporkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai segnalato e a che punto è ciascuna segnalazione. Agli account coinvolti non viene mai mostrato chi li ha segnalati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでに報告したすべてと、それぞれの現在の状況です。報告された側に、誰が報告したかが表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고한 모든 내용과 각각의 진행 상황이에요. 신고당한 계정에는 누가 신고했는지 절대 표시되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ റിപ്പോർട്ട് ചെയ്തതെല്ലാം, ഓരോന്നും ഇപ്പോൾ എവിടെ എത്തി എന്നതും. ആരാണ് റിപ്പോർട്ട് ചെയ്തതെന്ന് ബന്ധപ്പെട്ട അക്കൗണ്ടുകളെ ഒരിക്കലും കാണിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang telah anda laporkan, dan perkembangan setiap satu. Akaun yang terlibat tidak pernah ditunjukkan siapa yang melaporkan mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har rapportert, og hvor hver enkelt har kommet. Kontoene det gjelder, får aldri se hvem som rapporterte dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je hebt gemeld, en hoe ver elke melding is. De betrokken accounts krijgen nooit te zien wie hen heeft gemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co zgłosiłeś, i na jakim etapie jest każde zgłoszenie. Zgłaszanym kontom nigdy nie pokazuje się, kto je zgłosił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você denunciou e em que pé está cada denúncia. As contas envolvidas nunca veem quem as denunciou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que denunciou, e em que ponto está cada denúncia. As contas envolvidas nunca veem quem as denunciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce ai raportat și unde a ajuns fiecare. Conturilor implicate nu li se arată niciodată cine le-a raportat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, на что вы пожаловались, и на каком этапе каждая жалоба. Аккаунтам, на которые жалуются, никогда не показывают, кто пожаловался."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko, čo si nahlásil, a v akom stave to je. Dotknutým účtom sa nikdy nezobrazí, kto ich nahlásil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du har rapporterat, och hur långt varje ärende har kommit. Kontona det gäller får aldrig se vem som rapporterade dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் புகாரளித்த அனைத்தும், ஒவ்வொன்றும் எந்த நிலையில் உள்ளது என்பதுடன். சம்பந்தப்பட்ட கணக்குகளுக்கு யார் புகாரளித்தார் என்று ஒருபோதும் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రిపోర్ట్ చేసినవన్నీ, ప్రతిదీ ఎంత వరకు వచ్చింది. రిపోర్ట్ చేయబడిన ఖాతాలకు ఎవరు రిపోర్ట్ చేశారో ఎప్పుడూ చూపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่คุณรายงาน และความคืบหน้าของแต่ละเรื่อง บัญชีที่เกี่ยวข้องจะไม่เห็นว่าใครรายงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şikayet ettiğiniz her şey ve her birinin geldiği nokta. İlgili hesaplara kimin şikayet ettiği asla gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, на що ви поскаржилися, і на якому етапі кожна скарга. Облікові записи, яких це стосується, ніколи не бачать, хто на них поскаржився."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر وہ چیز جس کی آپ نے رپورٹ کی، اور ہر ایک کہاں تک پہنچی۔ متعلقہ اکاؤنٹس کو کبھی نہیں دکھایا جاتا کہ کس نے رپورٹ کی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn đã báo cáo, và mỗi báo cáo đã đến đâu. Các tài khoản liên quan không bao giờ được cho biết ai đã báo cáo họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你举报过的所有内容，以及每一项的处理进度。被举报的账户永远不会看到是谁举报了他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你檢舉過的所有內容，以及每一項目前的進度。被檢舉的帳號絕不會得知是誰檢舉的。"
          }
        }
      }
    },
    "safety.lists.blocked.empty.subtitle": {
      "comment": "Empty blocked list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تحظر شخصًا يظهر هنا، ويمكنك التراجع من هذه القائمة في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাউকে ব্লক করলে তারা এখানে দেখা যায়, আর যেকোনো সময় এই তালিকা থেকে তা ফিরিয়ে নিতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan bloquegis algú, apareixerà aquí, i ho pots desfer des d'aquesta llista en qualsevol moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někoho zablokuješ, objeví se tady a můžeš to z tohoto seznamu kdykoli vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du blokerer nogen, vises de her, og du kan fortryde det fra denne liste når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jemanden blockierst, erscheint er hier, und du kannst es jederzeit aus dieser Liste rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν αποκλείεις κάποιον, εμφανίζεται εδώ και μπορείς να το αναιρέσεις από αυτή τη λίστα οποτεδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you block someone they appear here, and you can undo it from this list at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando bloquees a alguien aparecerá aquí, y podrás deshacerlo desde esta lista en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun estät jonkun, hän näkyy täällä, ja voit kumota eston tältä listalta milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous bloquez quelqu’un, il apparaît ici, et vous pouvez annuler depuis cette liste à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשתחסום מישהו הוא יופיע כאן, ואפשר לבטל זאת מהרשימה הזו בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी को ब्लॉक करते हैं तो वे यहाँ दिखते हैं, और आप इस सूची से कभी भी इसे पलट सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad nekoga blokiraš, pojavit će se ovdje i možeš to poništiti s ovog popisa bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha letiltasz valakit, itt jelenik meg, és innen bármikor visszavonhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu memblokir seseorang, mereka muncul di sini, dan kamu bisa membatalkannya dari daftar ini kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando blocchi qualcuno compare qui, e puoi annullare da questo elenco in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かをブロックすると、ここに表示されます。このリストからいつでも元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가를 차단하면 여기에 표시되며, 이 목록에서 언제든 되돌릴 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ആരെയെങ്കിലും ബ്ലോക്ക് ചെയ്താൽ അവർ ഇവിടെ കാണും, ഈ പട്ടികയിൽ നിന്ന് എപ്പോൾ വേണമെങ്കിലും പഴയപടിയാക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menyekat seseorang mereka muncul di sini, dan anda boleh membuat asalnya daripada senarai ini pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du blokkerer noen, vises de her, og du kan angre fra denne listen når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iemand blokkeert, verschijnt die persoon hier, en je kunt het op elk moment vanuit deze lijst ongedaan maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy kogoś zablokujesz, pojawi się tutaj, a w każdej chwili możesz to cofnąć z tej listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você bloquear alguém, a pessoa aparece aqui, e você pode desfazer por esta lista a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando bloquear alguém, essa conta aparece aqui, e pode anular a qualquer momento a partir desta lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când blochezi pe cineva, apare aici și poți anula oricând din această listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы кого-то заблокируете, он появится здесь, и вы сможете отменить это из списка в любой момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekoho zablokuješ, zobrazí sa tu a môžeš to kedykoľvek vrátiť z tohto zoznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du blockerar någon visas de här, och du kan ångra det från den här listan när som helst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருவரைத் தடுத்தால் அவர் இங்கே தோன்றுவார், இந்தப் பட்டியலிலிருந்து எப்போது வேண்டுமானாலும் தடையை நீக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎవరినైనా బ్లాక్ చేసినప్పుడు వారు ఇక్కడ కనిపిస్తారు, ఈ జాబితా నుండి ఎప్పుడైనా దాన్ని రద్దు చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณบล็อกใคร พวกเขาจะปรากฏที่นี่ และคุณยกเลิกได้จากรายการนี้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini engellediğinizde burada görünür ve bunu istediğiniz zaman bu listeden geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви когось заблокуєте, він з’явиться тут, і це можна скасувати з цього списку будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کسی کو بلاک کرتے ہیں تو وہ یہاں نظر آتا ہے، اور آپ کسی بھی وقت اس فہرست سے اسے واپس کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chặn ai đó, họ sẽ xuất hiện ở đây, và bạn có thể hoàn tác từ danh sách này bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你屏蔽某人后，他们会出现在这里，你可以随时在此列表中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你封鎖某人後，對方會出現在這裡，你隨時可以在此列表中復原。"
          }
        }
      }
    },
