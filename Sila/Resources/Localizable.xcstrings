        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí fotoaparát a otáčanie hlavy"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar kameran och huvudvridningen"
          }
        },
        "ta": {
