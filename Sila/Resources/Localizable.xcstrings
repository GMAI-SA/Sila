    "rooms.removed.toast": {
      "comment": "Toast the host sees after removing somebody. %@ is who was removed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُخرج %@ من هذه الغرفة. وما زال بإمكانه الانضمام إلى غرف أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে এই রুম থেকে সরানো হয়েছে। তিনি এখনও অন্য রুমে যোগ দিতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha estat expulsat d'aquesta sala. Encara es pot unir a altres sales."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ byl z této místnosti odebrán. Může se stále připojit k jiným místnostem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev fjernet fra dette rum. Vedkommende kan stadig deltage i andre rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde aus diesem Raum entfernt. Die Person kann weiterhin anderen Räumen beitreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ αφαιρέθηκε από αυτή την αίθουσα. Μπορεί ακόμα να μπει σε άλλες αίθουσες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was removed from this room. They can still join other rooms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fue expulsado de esta sala. Aún puede unirse a otras salas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poistettiin tästä huoneesta. Hän voi yhä liittyä muihin huoneisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été retiré de ce salon. Il peut encore rejoindre d’autres salons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוסר מהחדר הזה. הוא עדיין יכול להצטרף לחדרים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को इस रूम से हटा दिया गया। वे दूसरे रूम में अब भी जुड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je uklonjen/a iz ove sobe. I dalje se može pridružiti drugim sobama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ el lett távolítva ebből a szobából. Más szobákhoz továbbra is csatlakozhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dikeluarkan dari room ini. Mereka tetap bisa bergabung ke room lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato rimosso da questa stanza. Può ancora entrare in altre stanze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をこのルームから削除しました。ほかのルームには参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 이 룸에서 내보냈어요. 다른 룸에는 계속 참여할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ ഈ റൂമിൽ നിന്ന് നീക്കം ചെയ്തു. അവർക്ക് മറ്റ് റൂമുകളിൽ ചേരാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dialih keluar daripada bilik ini. Mereka masih boleh menyertai bilik lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ble fjernet fra dette rommet. Vedkommende kan fortsatt bli med i andre rom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is uit deze room verwijderd. Diegene kan nog aan andere rooms deelnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ został(a) usunięty(-a) z tego pokoju. Nadal może dołączać do innych pokoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi removido desta sala. A pessoa ainda pode entrar em outras salas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi removido desta sala. Pode continuar a entrar noutras salas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fost scos din această cameră. Poate intra în alte camere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удалён(а) из этой комнаты. Можно по-прежнему заходить в другие комнаты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bol odstránený z tejto miestnosti. Do iných miestností sa môže stále pripojiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ togs bort från det här rummet. De kan fortfarande gå med i andra rum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இந்த அறையிலிருந்து நீக்கப்பட்டார். அவர் மற்ற அறைகளில் சேரலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ను ఈ రూమ్ నుండి తొలగించారు. వారు ఇతర రూమ్‌లలో ఇంకా చేరవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกนำออกจากห้องนี้ พวกเขายังเข้าร่วมห้องอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu odadan çıkarıldı. Diğer odalara yine katılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вилучено з цієї кімнати. Він(вона) все ще може приєднуватися до інших кімнат."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو اس روم سے ہٹا دیا گیا۔ وہ دوسرے رومز میں اب بھی شامل ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bị xóa khỏi phòng này. Họ vẫn có thể tham gia các phòng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被移出此房间，仍可加入其他房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被移出此聊天室，仍可加入其他聊天室。"
          }
        }
      }
    },
