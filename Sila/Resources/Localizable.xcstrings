    "vouch.error.confirmWindowPassed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّت الساعات الـ48 المتاحة للتأكيد — أرسل رابطًا جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করার ৪৮ ঘণ্টা পার হয়ে গেছে — নতুন লিংক পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 48 hores per confirmar han passat: envia un enllaç nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "48 hodin na potvrzení uplynulo – pošli nový odkaz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De 48 timer til at bekræfte er gået – send et nyt link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 48 Stunden zum Bestätigen sind vorbei – sende einen neuen Link."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι 48 ώρες για επιβεβαίωση πέρασαν — στείλε νέο σύνδεσμο."
