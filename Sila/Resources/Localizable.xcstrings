    "post.scope.region.room.accessibility": {
      "comment": "VoiceOver reading of a regional room's scope. %@ is the region code.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غرفة إقليمية. لا يمكن التحدث إلا للحسابات الموثّقة في %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আঞ্চলিক রুম। শুধু %@-এ ভেরিফায়েড অ্যাকাউন্টরা কথা বলতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Només hi poden parlar els comptes verificats a %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionální místnost. Mluvit mohou jen ověřené účty v oblasti: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rum. Kun verificerede konti i %@ kan tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionaler Raum. Nur verifizierte Konten in %@ können sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιφερειακή αίθουσα. Μόνο επαληθευμένοι λογαριασμοί στην περιοχή %@ μπορούν να μιλήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional room. Only verified accounts in %@ can speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Solo pueden hablar las cuentas verificadas en %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluehuone. Vain alueella %@ vahvistetut tilit voivat puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon régional. Seuls les comptes vérifiés dans la zone %@ peuvent parler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר אזורי. רק חשבונות מאומתים ב-%@ יכולים לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्रीय रूम। केवल %@ के सत्यापित अकाउंट बोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalna soba. Govoriti mogu samo potvrđeni računi u regiji: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionális szoba. Csak a(z) %@ térségben hitelesített fiókok szólalhatnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room regional. Hanya akun terverifikasi di %@ yang bisa berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanza regionale. Solo gli account verificati in %@ possono parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域のルーム。%@で認証されたアカウントだけが発言できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 룸. %@에서 인증된 계정만 말할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മേഖലാ റൂം. %@-ൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ സംസാരിക്കാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik serantau. Hanya akaun yang disahkan di %@ boleh bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rom. Bare verifiserte kontoer i %@ kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale room. Alleen geverifieerde accounts in %@ kunnen spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój regionalny. Mówić mogą tylko zweryfikowane konta w regionie: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Só contas verificadas em %@ podem falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Só contas verificadas em %@ podem falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră regională. Doar conturile verificate în %@ pot vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Региональная комната. Говорить могут только проверенные аккаунты региона %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionálna miestnosť. Hovoriť môžu iba overené účty z regiónu %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rum. Bara verifierade konton i %@ kan tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிராந்திய அறை. %@ இல் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంతీయ రూమ్. %@లో ధృవీకరించబడిన ఖాతాలు మాత్రమే మాట్లాడగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องระดับภูมิภาค เฉพาะบัญชีที่ยืนยันตัวตนแล้วใน %@ เท่านั้นที่พูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgesel oda. Yalnızca %@ bölgesinde doğrulanmış hesaplar konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регіональна кімната. Говорити можуть лише верифіковані облікові записи в регіоні: %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "علاقائی روم۔ صرف %@ کے تصدیق شدہ اکاؤنٹ بول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng khu vực. Chỉ tài khoản đã xác minh ở %@ mới phát biểu được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区房间。只有在 %@ 验证的账户可以发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地區聊天室。只有在 %@ 通過驗證的帳號能發言。"
          }
        }
      }
    },
