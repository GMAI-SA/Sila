        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser innlegg fra verifiserte kontoer i landet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont berichten van geverifieerde accounts in jouw land"
