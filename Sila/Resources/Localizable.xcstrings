        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada acara akan datang. Mulakan satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kommende arrangementer. Start ett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen evenementen op komst. Start er een."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak nadchodzących wydarzeń. Utwórz jedno."
          }
