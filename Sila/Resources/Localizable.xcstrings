            "value": "Показывает посты проверенных аккаунтов из вашей страны"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí príspevky z overených účtov v tvojej krajine"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar inlägg från verifierade konton i ditt land"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்டிலுள்ள சரிபார்க்கப்பட்ட கணக்குகளின் இடுகைகளைக் காட்டும்"
