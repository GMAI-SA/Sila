    "document.sweep.keepGoing": {
      "comment": "Prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واصل — تمتلئ الحلقة كلما أدرت رأسك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যান — ঘোরালে বৃত্ত ভরে উঠবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua: l'anell s'omple a mesura que gires"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračuj – kruh se plní, jak se otáčíš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt – ringen fyldes, mens du drejer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so – der Ring füllt sich beim Drehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνέχισε — ο δακτύλιος γεμίζει καθώς γυρνάς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going — the ring fills as you turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue: el anillo se llena al girar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka – rengas täyttyy, kun käännät päätäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez — l’anneau se remplit à mesure que vous tournez"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך — הטבעת מתמלאת בזמן שאתה מסתובב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलते रहें — घुमाते ही रिंग भरती जाती है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo nastavi — prsten se puni dok se okrećeš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytasd – a gyűrű fordulás közben telik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan — cincin terisi saat kamu menoleh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua: l'anello si riempie mentre giri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま続けてください。回すとリングが埋まっていきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하세요. 고개를 돌릴수록 링이 채워져요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരുക — നിങ്ങൾ തിരിയുമ്പോൾ വളയം നിറയും"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan — cincin terisi semasa anda berpusing"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett. Ringen fylles mens du snur deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door: de ring vult zich terwijl je draait"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kręć dalej — okrąg wypełnia się, gdy obracasz głowę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue: o anel se preenche conforme você gira"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue — o anel enche à medida que vira"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă — inelul se umple pe măsură ce te întorci"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте — кольцо заполняется по мере поворота"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračuj — prstenec sa plní, ako sa otáčaš"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt – ringen fylls när du vrider på huvudet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடருங்கள் — நீங்கள் திரும்பும்போது வளையம் நிரம்பும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగించండి — మీరు తిరిగే కొద్దీ వలయం నిండుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำต่อไป วงแหวนจะเต็มเมื่อคุณหันหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edin; döndükçe halka dolar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуйте — кільце заповнюється, поки ви повертаєтеся"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری رکھیں — جیسے جیسے آپ مڑتے ہیں دائرہ بھرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục — vòng sẽ đầy dần khi bạn xoay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续，转动头部时圆环会逐渐填满"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續轉動，圓環會隨著你轉頭而填滿"
          }
        }
      }
    },
    "document.sweep.lookStraight": {
      "comment": "Prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر مباشرة إلى الكاميرا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোজা ক্যামেরার দিকে তাকান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira directament a la càmera"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se přímo do fotoaparátu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lige ind i kameraet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh geradeaus in die Kamera"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοίτα κατευθείαν την κάμερα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look straight at the camera"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira directamente a la cámara"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso suoraan kameraan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez droit vers l’appareil photo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבט ישר אל המצלמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे कैमरे की ओर देखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledaj ravno u kameru"
          }
        },
        "hu": {
