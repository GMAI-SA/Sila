{
  "sourceLanguage": "en",
  "strings": {
    "account.avatar.error.tooLarge": {
      "comment": "The file is over the size limit. %1$@ is its size in megabytes, %2$@ the limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم هذه الصورة %1$@ ميغابايت. يجب أن تقل صورة الملف عن %2$@ ميغابايت — اختر صورة أصغر أو اقتصّها أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি %1$@ MB। প্রোফাইল ছবি %2$@ MB-এর কম হতে হবে — ছোট একটি ছবি বেছে নিন, অথবা আগে ক্রপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta foto fa %1$@ MB. Les fotos de perfil han de fer menys de %2$@ MB: tria'n una de més petita o retalla-la primer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fotka má %1$@ MB. Profilové obrázky musí mít méně než %2$@ MB – vyber menší nebo ji nejdřív ořízni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det foto er %1$@ MB. Profilbilleder skal være under %2$@ MB – vælg et mindre, eller beskær det først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist %1$@ MB groß. Profilbilder dürfen höchstens %2$@ MB haben – wähle ein kleineres oder schneide es vorher zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η φωτογραφία είναι %1$@ MB. Οι εικόνες προφίλ πρέπει να είναι κάτω από %2$@ MB — διάλεξε μικρότερη ή περίκοψέ την πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo is %1$@ MB. Profile pictures must be under %2$@ MB — pick a smaller one, or crop it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa foto pesa %1$@ MB. Las fotos de perfil deben pesar menos de %2$@ MB: elige una más pequeña o recórtala antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva on %1$@ Mt. Profiilikuvan on oltava alle %2$@ Mt – valitse pienempi tai rajaa se ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo fait %1$@ Mo. Les photos de profil doivent faire moins de %2$@ Mo : choisissez-en une plus petite ou recadrez-la d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה שוקלת %1$@ MB. תמונות פרופיל חייבות להיות קטנות מ-%2$@ MB — בחר תמונה קטנה יותר, או חתוך אותה קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ोटो %1$@ MB की है। प्रोफ़ाइल फ़ोटो %2$@ MB से कम होनी चाहिए — कोई छोटी फ़ोटो चुनें, या पहले उसे क्रॉप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fotografija ima %1$@ MB. Profilne slike moraju biti manje od %2$@ MB — odaberi manju ili je prvo izreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fotó %1$@ MB. A profilképnek %2$@ MB-nál kisebbnek kell lennie – válassz kisebbet, vagy vágd meg előbb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu berukuran %1$@ MB. Foto profil harus di bawah %2$@ MB — pilih yang lebih kecil, atau pangkas dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella foto pesa %1$@ MB. Le immagini del profilo devono essere sotto i %2$@ MB: scegline una più leggera o ritagliala prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は%1$@ MBです。プロフィール写真は%2$@ MB未満にしてください。小さい写真を選ぶか、先にトリミングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 %1$@MB예요. 프로필 사진은 %2$@MB 미만이어야 해요. 더 작은 사진을 고르거나 먼저 잘라 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫോട്ടോ %1$@ MB ആണ്. പ്രൊഫൈൽ ചിത്രങ്ങൾ %2$@ MB-യിൽ താഴെയായിരിക്കണം — ചെറുതൊന്ന് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ ആദ്യം ക്രോപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu %1$@ MB. Gambar profil mesti kurang daripada %2$@ MB — pilih yang lebih kecil, atau pangkas dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet er %1$@ MB. Profilbilder må være under %2$@ MB. Velg et mindre bilde, eller beskjær det først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die foto is %1$@ MB. Profielfoto's mogen maximaal %2$@ MB zijn. Kies een kleinere foto of snijd hem eerst bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie ma %1$@ MB. Zdjęcia profilowe muszą mieć mniej niż %2$@ MB — wybierz mniejsze lub najpierw je przytnij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa foto tem %1$@ MB. As fotos de perfil devem ter menos de %2$@ MB. Escolha uma menor ou recorte-a antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem %1$@ MB. As fotografias de perfil têm de ter menos de %2$@ MB — escolha uma mais pequena ou recorte-a primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia are %1$@ MB. Pozele de profil trebuie să aibă sub %2$@ MB — alege una mai mică sau decupeaz-o mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер фото — %1$@ МБ. Фото профиля должно быть меньше %2$@ МБ — выберите фото поменьше или сначала обрежьте его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto fotka má %1$@ MB. Profilové obrázky musia mať menej ako %2$@ MB — vyber menšiu alebo ju najprv orež."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den bilden är %1$@ MB. Profilbilder måste vara under %2$@ MB – välj en mindre eller beskär den först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் புகைப்படம் %1$@ MB உள்ளது. சுயவிவரப் படங்கள் %2$@ MB-க்குக் குறைவாக இருக்க வேண்டும் — சிறியதைத் தேர்ந்தெடுங்கள் அல்லது முதலில் செதுக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫోటో %1$@ MB ఉంది. ప్రొఫైల్ చిత్రాలు %2$@ MB లోపు ఉండాలి — చిన్నదాన్ని ఎంచుకోండి, లేదా ముందు క్రాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนี้มีขนาด %1$@ MB รูปโปรไฟล์ต้องมีขนาดไม่เกิน %2$@ MB กรุณาเลือกรูปที่เล็กกว่า หรือครอบตัดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf %1$@ MB. Profil fotoğrafları %2$@ MB'tan küçük olmalı; daha küçük bir tane seçin veya önce kırpın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це фото має %1$@ МБ. Фото профілю має бути менше ніж %2$@ МБ — виберіть менше або спершу обріжте його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ تصویر %1$@ MB کی ہے۔ پروفائل تصویر %2$@ MB سے کم ہونی چاہیے — کوئی چھوٹی تصویر چنیں، یا پہلے اسے کراپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh này nặng %1$@ MB. Ảnh hồ sơ phải dưới %2$@ MB — hãy chọn ảnh nhỏ hơn hoặc cắt ảnh trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片有 %1$@ MB。头像必须小于 %2$@ MB，请选择更小的照片，或先裁剪一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片有 %1$@ MB。大頭貼必須小於 %2$@ MB，請選擇較小的照片，或先裁切。"
          }
        }
      }
    },
    "account.avatar.error.unreadable": {
      "comment": "The file could not be decoded as an image.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الصورة. اختر صورة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি পড়া যায়নি। অন্য একটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir la foto. Tria'n una altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotku se nepodařilo přečíst. Vyber jinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet kunne ikke læses. Vælg et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto konnte nicht gelesen werden. Wähle ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση της φωτογραφίας. Διάλεξε άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo couldn't be read. Pick another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esa foto. Elige otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa ei voitu lukea. Valitse toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette photo. Choisissez-en une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את התמונה. בחר תמונה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ोटो पढ़ी नहीं जा सकी। कोई दूसरी चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiju nije moguće pročitati. Odaberi drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotót nem sikerült beolvasni. Válassz másikat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu tidak bisa dibaca. Pilih foto lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la foto. Scegline un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込めませんでした。別の写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 읽을 수 없어요. 다른 사진을 골라 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫോട്ടോ വായിക്കാനായില്ല. മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu tidak dapat dibaca. Pilih foto lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet kunne ikke leses. Velg et annet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die foto kon niet worden gelezen. Kies een andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego zdjęcia. Wybierz inne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler essa foto. Escolha outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esta foto. Escolha outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia nu a putut fi citită. Alege alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать это фото. Выберите другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotku sa nepodarilo načítať. Vyber inú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden gick inte att läsa. Välj en annan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் புகைப்படத்தைப் படிக்க முடியவில்லை. வேறொன்றைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫోటోను చదవలేకపోయాం. మరొకటి ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรูปนี้ไม่ได้ กรุณาเลือกรูปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf okunamadı. Başka bir tane seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати це фото. Виберіть інше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ تصویر پڑھی نہیں جا سکی۔ کوئی اور تصویر چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được ảnh này. Hãy chọn ảnh khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这张照片。请换一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這張照片，請選擇另一張。"
          }
        }
      }
    },
    "account.avatar.processingDisclosure": {
      "comment": "What the server does to an uploaded picture, in plain language — including that EXIF and location data are dropped and the original is never kept. Both placeholders are the output edge length in pixels.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد معروف ترميز صورتك على الخادم: تُقصّ مربعة، ويُغيَّر حجمها إلى %1$@×%2$@، وتُحفظ كملف JPEG جديد. وتُحذف في هذه العملية بيانات الموقع وكل بيانات EXIF الأخرى التي أضافتها الكاميرا — ولا يُخزَّن الملف الأصلي ولا يُعرض أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known সার্ভারে আপনার ছবি নতুন করে এনকোড করে: চৌকো করে ক্রপ হয়, %1$@×%2$@ আকারে ছোট বা বড় হয় এবং নতুন JPEG হিসেবে সেভ হয়। এই প্রক্রিয়ায় লোকেশন ডেটা ও ক্যামেরার যুক্ত করা অন্যান্য সব EXIF ট্যাগ বাদ যায় — আসল ফাইল কখনও সংরক্ষণ বা প্রদর্শন করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known recodifica la teva imatge al servidor: es retalla en quadrat, es redimensiona a %1$@×%2$@ i es desa com a JPEG nou. Les dades d'ubicació i qualsevol altra etiqueta EXIF que hi hagi afegit la càmera s'eliminen en el procés; el fitxer original no es desa ni es serveix mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tvůj obrázek na serveru překóduje: ořízne ho na čtverec, změní velikost na %1$@×%2$@ a uloží jako nové JPEG. Údaje o poloze a všechny další značky EXIF od fotoaparátu se přitom odstraní – původní soubor se nikdy neukládá ani nezobrazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known omkoder dit billede på serveren: Det beskæres til kvadrat, ændres til %1$@×%2$@ og gemmes som en ny JPEG. Lokationsdata og alle andre EXIF-tags fra dit kamera fjernes undervejs – den originale fil bliver aldrig gemt eller vist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known kodiert dein Bild auf dem Server neu: Es wird quadratisch zugeschnitten, auf %1$@×%2$@ verkleinert und als neues JPEG gespeichert. Standortdaten und alle anderen EXIF-Angaben deiner Kamera werden dabei entfernt – die Originaldatei wird weder gespeichert noch ausgeliefert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known ξανακωδικοποιεί την εικόνα σου στον διακομιστή: περικόπτεται σε τετράγωνο, αλλάζει μέγεθος σε %1$@×%2$@ και αποθηκεύεται ως νέο JPEG. Τα δεδομένα τοποθεσίας και κάθε άλλη ετικέτα EXIF της κάμεράς σου αφαιρούνται — το αρχικό αρχείο δεν αποθηκεύεται ούτε εμφανίζεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known re-encodes your picture on the server: it is cropped square, resized to %1$@×%2$@ and saved as a new JPEG. Location data and every other EXIF tag your camera attached is dropped in the process — the original file is never stored or served."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known vuelve a codificar tu foto en el servidor: la recorta en cuadrado, la redimensiona a %1$@×%2$@ y la guarda como un JPEG nuevo. Los datos de ubicación y cualquier otra etiqueta EXIF de tu cámara se eliminan en el proceso; el archivo original nunca se guarda ni se sirve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known koodaa kuvasi uudelleen palvelimella: se rajataan neliöksi, muutetaan kokoon %1$@×%2$@ ja tallennetaan uutena JPEG-tiedostona. Sijaintitiedot ja kaikki muut kameran liittämät EXIF-tiedot poistetaan – alkuperäistä tiedostoa ei koskaan tallenneta eikä jaeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ré-encode votre photo sur le serveur : elle est recadrée en carré, redimensionnée à %1$@×%2$@ et enregistrée comme nouveau JPEG. Les données de localisation et toutes les autres balises EXIF ajoutées par votre appareil sont supprimées — le fichier d’origine n’est jamais stocké ni diffusé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known מקודדת מחדש את התמונה שלך בשרת: היא נחתכת לריבוע, משתנה לגודל %1$@×%2$@ ונשמרת כ-JPEG חדש. נתוני מיקום וכל תג EXIF אחר שהמצלמה צירפה מוסרים בתהליך — קובץ המקור לא נשמר ולא מוגש לעולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known सर्वर पर आपकी फ़ोटो को दोबारा एन्कोड करता है: उसे चौकोर क्रॉप किया जाता है, %1$@×%2$@ में बदला जाता है और नए JPEG के रूप में सहेजा जाता है। इस प्रक्रिया में लोकेशन डेटा और आपके कैमरे का जोड़ा हुआ हर दूसरा EXIF टैग हटा दिया जाता है — मूल फ़ाइल न कभी सहेजी जाती है, न दिखाई जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ponovno kodira tvoju sliku na poslužitelju: izrezuje se u kvadrat, mijenja veličinu na %1$@×%2$@ i sprema kao novi JPEG. Podaci o lokaciji i sve ostale EXIF oznake koje je dodala kamera pritom se brišu — izvorna datoteka nikada se ne sprema niti poslužuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known újrakódolja a képedet a szerveren: négyzetesre vágja, %1$@×%2$@ méretűre állítja, és új JPEG-ként menti. A helyadatok és a fényképezőgéped által csatolt összes többi EXIF-címke törlődik – az eredeti fájlt soha nem tároljuk és nem szolgáljuk ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known mengenkode ulang fotomu di server: dipangkas persegi, diubah ukurannya menjadi %1$@×%2$@ dan disimpan sebagai JPEG baru. Data lokasi dan semua tag EXIF lain dari kameramu dibuang dalam prosesnya — berkas aslinya tidak pernah disimpan atau ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ricodifica la tua immagine sul server: viene ritagliata in formato quadrato, ridimensionata a %1$@×%2$@ e salvata come nuovo JPEG. I dati di posizione e ogni altro tag EXIF aggiunto dalla fotocamera vengono eliminati nel processo: il file originale non viene mai conservato né distribuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownはサーバー上で画像を再エンコードします。正方形にトリミングし、%1$@×%2$@にリサイズして、新しいJPEGとして保存します。位置情報やカメラが付けたその他のEXIFタグはすべて削除され、元のファイルが保存・配信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known은 서버에서 사진을 다시 인코딩해요. 정사각형으로 자르고 %1$@×%2$@ 크기로 조정한 뒤 새 JPEG로 저장해요. 이 과정에서 위치 정보와 카메라가 남긴 모든 EXIF 태그가 제거되며, 원본 파일은 저장되거나 제공되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known നിങ്ങളുടെ ചിത്രം സെർവറിൽ വീണ്ടും എൻകോഡ് ചെയ്യുന്നു: ചതുരമായി ക്രോപ്പ് ചെയ്ത്, %1$@×%2$@ ആയി വലുപ്പം മാറ്റി പുതിയ JPEG ആയി സേവ് ചെയ്യുന്നു. ലൊക്കേഷൻ ഡാറ്റയും ക്യാമറ ചേർത്ത മറ്റെല്ലാ EXIF ടാഗുകളും ഇതിൽ ഒഴിവാക്കപ്പെടുന്നു — യഥാർഥ ഫയൽ ഒരിക്കലും സൂക്ഷിക്കുകയോ നൽകുകയോ ചെയ്യില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known mengekod semula gambar anda di pelayan: ia dipangkas segi empat sama, diubah saiz kepada %1$@×%2$@ dan disimpan sebagai JPEG baharu. Data lokasi dan semua teg EXIF lain yang dilampirkan kamera anda dibuang dalam proses ini — fail asal tidak pernah disimpan atau disajikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known koder om bildet ditt på serveren: det beskjæres til en firkant, endres til %1$@×%2$@ og lagres som en ny JPEG. Posisjonsdata og alle andre EXIF-merker kameraet la til, fjernes underveis. Originalfilen lagres eller deles aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known codeert je foto op de server opnieuw: hij wordt vierkant bijgesneden, verkleind naar %1$@×%2$@ en opgeslagen als nieuwe JPEG. Locatiegegevens en alle andere EXIF-tags van je camera worden daarbij verwijderd. Het originele bestand wordt nooit opgeslagen of getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ponownie koduje Twoje zdjęcie na serwerze: przycina je do kwadratu, zmienia rozmiar na %1$@×%2$@ i zapisuje jako nowy plik JPEG. Dane o lokalizacji i wszystkie inne znaczniki EXIF dodane przez aparat są usuwane — oryginalny plik nigdy nie jest przechowywany ani udostępniany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known recodifica sua foto no servidor: ela é recortada em formato quadrado, redimensionada para %1$@×%2$@ e salva como um novo JPEG. Os dados de localização e todas as outras tags EXIF da sua câmera são descartados no processo. O arquivo original nunca é armazenado nem exibido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known recodifica a sua imagem no servidor: é recortada em quadrado, redimensionada para %1$@×%2$@ e guardada como um novo JPEG. Os dados de localização e todas as outras etiquetas EXIF da câmara são removidos neste processo — o ficheiro original nunca é guardado nem disponibilizado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known recodifică poza ta pe server: este decupată pătrat, redimensionată la %1$@×%2$@ și salvată ca JPEG nou. Datele de locație și orice altă etichetă EXIF atașată de cameră sunt eliminate — fișierul original nu este stocat și nu este servit niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Known заново кодирует ваше фото на сервере: обрезает его до квадрата, изменяет размер до %1$@×%2$@ и сохраняет как новый JPEG. Геоданные и все остальные EXIF-теги, добавленные камерой, при этом удаляются — исходный файл не хранится и не отдаётся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known na serveri znova zakóduje tvoj obrázok: orezá ho na štvorec, zmení veľkosť na %1$@×%2$@ a uloží ako nový JPEG. Údaje o polohe a všetky ostatné značky EXIF z fotoaparátu sa pritom odstránia — pôvodný súbor sa nikdy neukladá ani neposkytuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known kodar om din bild på servern: den beskärs kvadratiskt, ändras till %1$@×%2$@ och sparas som en ny JPEG. Platsdata och alla andra EXIF-taggar som kameran lagt till tas bort – originalfilen sparas eller visas aldrig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known உங்கள் படத்தைச் சேவையகத்தில் மீண்டும் குறியாக்கம் செய்கிறது: சதுரமாகச் செதுக்கி, %1$@×%2$@ அளவுக்கு மாற்றி, புதிய JPEG ஆகச் சேமிக்கிறது. இருப்பிடத் தரவும் உங்கள் கேமரா இணைத்த மற்ற எல்லா EXIF குறிச்சொற்களும் இதில் நீக்கப்படும் — அசல் கோப்பு ஒருபோதும் சேமிக்கப்படாது, வழங்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known మీ చిత్రాన్ని సర్వర్‌లో మళ్లీ ఎన్‌కోడ్ చేస్తుంది: చతురస్రంగా క్రాప్ చేసి, %1$@×%2$@కు మార్చి, కొత్త JPEGగా సేవ్ చేస్తుంది. ఈ ప్రక్రియలో లొకేషన్ డేటా, మీ కెమెరా జోడించిన ఇతర EXIF ట్యాగ్‌లన్నీ తొలగించబడతాయి — అసలు ఫైల్ ఎప్పుడూ నిల్వ చేయబడదు, అందించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known จะเข้ารหัสรูปของคุณใหม่บนเซิร์ฟเวอร์ โดยครอบตัดเป็นสี่เหลี่ยมจัตุรัส ปรับขนาดเป็น %1$@×%2$@ และบันทึกเป็น JPEG ใหม่ ข้อมูลตำแหน่งและแท็ก EXIF อื่นๆ ทั้งหมดที่กล้องแนบมาจะถูกลบออก และจะไม่เก็บหรือแสดงไฟล์ต้นฉบับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known fotoğrafınızı sunucuda yeniden kodlar: kare olarak kırpılır, %1$@×%2$@ boyutuna küçültülür ve yeni bir JPEG olarak kaydedilir. Konum verileri ve kameranızın eklediği diğer tüm EXIF etiketleri bu sırada silinir; özgün dosya asla saklanmaz veya sunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known перекодовує ваше фото на сервері: воно обрізається до квадрата, змінюється до %1$@×%2$@ і зберігається як новий JPEG. Дані про місцезнаходження та всі інші теги EXIF, які додала камера, при цьому видаляються — оригінальний файл ніколи не зберігається і не віддається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known سرور پر آپ کی تصویر کو دوبارہ انکوڈ کرتا ہے: اسے چوکور کراپ کیا جاتا ہے، %1$@×%2$@ میں تبدیل کیا جاتا ہے اور نئی JPEG کے طور پر محفوظ کیا جاتا ہے۔ اس عمل میں مقام کا ڈیٹا اور آپ کے کیمرے کے لگائے ہوئے باقی تمام EXIF ٹیگ ہٹا دیے جاتے ہیں — اصل فائل نہ کبھی محفوظ کی جاتی ہے اور نہ دکھائی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known mã hóa lại ảnh của bạn trên máy chủ: ảnh được cắt vuông, đổi kích thước thành %1$@×%2$@ và lưu thành một tệp JPEG mới. Dữ liệu vị trí và mọi thẻ EXIF khác do máy ảnh gắn vào đều bị loại bỏ — tệp gốc không bao giờ được lưu hay phân phối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 会在服务器上重新编码你的图片：裁剪为正方形，调整为 %1$@×%2$@，并保存为新的 JPEG。位置数据以及相机附带的所有其他 EXIF 标签都会被去除，原始文件不会被存储或提供访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 會在伺服器上重新編碼你的照片：裁切為正方形、縮放為 %1$@×%2$@，並儲存為新的 JPEG。位置資料及相機附加的所有其他 EXIF 標籤都會被移除，原始檔案絕不會被儲存或提供。"
          }
        }
      }
    },
