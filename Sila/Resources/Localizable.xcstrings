        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പോൾ ഇതിനകം തുറന്നിട്ടുണ്ട് — ആദ്യം അത് അടയ്ക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah tinjauan sudah terbuka — tutupnya dahulu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avstemning er allerede åpen. Lukk den først"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een peiling open: sluit die eerst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankieta jest już otwarta — najpierw ją zamknij"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há uma enquete aberta: encerre-a primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há uma sondagem aberta — feche-a primeiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sondaj este deja deschis — închide-l mai întâi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один опрос уже открыт — сначала закройте его"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna anketa je už otvorená — najprv ju zavri"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En omröstning är redan öppen – stäng den först"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கருத்துக்கணிப்பு ஏற்கெனவே திறந்துள்ளது — முதலில் அதை மூடுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక పోల్ ఇప్పటికే తెరిచి ఉంది — ముందు దాన్ని మూసివేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีโพลเปิดอยู่แล้ว ปิดโพลนั้นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten açık bir anket var; önce onu kapatın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитування вже відкрите — спершу закрийте його"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک پول پہلے ہی کھلا ہے — پہلے اسے بند کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có một bình chọn đang mở — hãy đóng nó trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一个投票正在进行，请先关闭它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有進行中的投票，請先關閉它"
          }
        }
      }
    },
