            "value": "認証マーク、国旗、認証済みの名前"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 마크, 내 국가의 깃발, 인증된 이름"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സീൽ, നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാക, വെരിഫൈ ചെയ്ത പേര്"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meterai, bendera negara anda dan nama anda yang disahkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seglet, landsflagget ditt og det verifiserte navnet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zegel, de vlag van je land en je geverifieerde naam"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieczęć, flaga kraju i zweryfikowane imię"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O selo, a bandeira do seu país e seu nome verificado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O selo, a bandeira do seu país e o seu nome verificado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigiliul, steagul țării tale și numele tău verificat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печать, флаг вашей страны и проверенное имя"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pečať, vlajka tvojej krajiny a tvoje overené meno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Märket, ditt lands flagga och ditt verifierade namn"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முத்திரை, உங்கள் நாட்டுக் கொடி, சரிபார்க்கப்பட்ட பெயர்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సీల్, మీ దేశం జెండా మరియు మీ ధృవీకరించబడిన పేరు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรา ธงประเทศ และชื่อที่ยืนยันแล้วของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mühür, ülkenizin bayrağı ve doğrulanmış adınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатка, прапор вашої країни та ваше верифіковане ім’я"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہر، آپ کے ملک کا جھنڈا اور آپ کا تصدیق شدہ نام"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu chứng nhận, cờ quốc gia và tên đã xác minh của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证印章、你所在国家的旗帜和你的验证姓名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認證標章、你國家的旗幟和你的已驗證姓名"
          }
        }
      }
    },
