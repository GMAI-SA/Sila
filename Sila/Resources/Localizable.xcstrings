    "preferences.topicFilter.titleWithCount": {
      "comment": "A topic filter chip with its count. %1$@ is the filter's name, %2$@ the number of topics in it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "preferences.topics.emptySlice": {
      "comment": "Shown when the chosen topic filter matches no rows.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مواضيع في هذه القائمة بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No topics in this list yet."
          }
        }
      }
    },
    "preferences.topics.explanation": {
      "comment": "What Interested and Muted each do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«مهتم» يحتسب الموضوع ضمن التصفية أعلاه. و«مكتوم» يخفي المنشورات المتعلقة به من الصفحة الدولية سواء كانت التصفية مفعّلة أم لا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interested counts a topic towards the filter above. Muted hides posts about it from International whether or not that filter is on."
          }
        }
      }
    },
    "preferences.untagged.detail": {
      "comment": "Why unlabelled posts exist at all.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدث التصنيف بعد نشر المنشور، لذلك قد لا يكون للمنشور الجديد موضوع بعد. وهذا الخيار يقرر ما إذا كانت تلك المنشورات ستصلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labelling happens after a post is published, so a new post may have no topic yet. This decides whether those posts still reach you."
          }
        }
      }
    },
    "preferences.untagged.detail.noEffect": {
      "comment": "Appended when nothing is currently narrowing the feed, so the switch changes nothing today.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولا يغيّر شيئًا الآن، لأنه لا يوجد ما يضيّق صفحتك الدولية على المواضيع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changes nothing right now, because nothing is narrowing your International feed to topics."
          }
        }
      }
    },
    "preferences.untagged.hint": {
      "comment": "VoiceOver hint for the unlabelled-posts switch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي المنشورات غير المصنّفة ضمن صفحتك الدولية المصفّاة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps posts with no topic label in your filtered International feed"
          }
        }
      }
    },
    "preferences.untagged.title": {
      "comment": "The switch governing posts with no topic label yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المنشورات غير المصنّفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show posts that haven't been labelled"
          }
        }
      }
    },
    "profile.action.tryAgain": {
      "comment": "Retry action on the profile error states.",
      "extractionState": "manual",
