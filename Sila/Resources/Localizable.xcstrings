    "composer.thread.partialSummary": {
      "comment": "Says exactly how much of a thread went out and that the rest is still in the composer. %1$@ posted, %2$@ total, %3$@ the server's error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُشر %1$@ من %2$@. %3$@ والباقي ما زال هنا — اضغط «انشر» لمتابعة السلسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এর মধ্যে %1$@ পোস্ট হয়েছে। %3$@ বাকিটা এখনও এখানে আছে — থ্রেড চালিয়ে যেতে পোস্ট চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicades %1$@ de %2$@. %3$@ La resta continua aquí: toca Publica per continuar el fil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zveřejněno %1$@ z %2$@. %3$@ Zbytek tu stále je – klepnutím na Zveřejnit v vlákně pokračuj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ af %2$@ er slået op. %3$@ Resten er stadig her – tryk på Slå op for at fortsætte tråden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ gepostet. %3$@ Der Rest ist noch hier – tippe auf Posten, um den Thread fortzusetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημοσιεύτηκαν %1$@ από %2$@. %3$@ Τα υπόλοιπα είναι ακόμα εδώ — πάτησε Ανάρτηση για να συνεχίσεις το νήμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posted %1$@ of %2$@. %3$@ The rest is still here — tap Post to continue the thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se publicaron %1$@ de %2$@. %3$@ El resto sigue aquí: toca Publicar para continuar el hilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaistu %1$@/%2$@. %3$@ Loput ovat yhä tässä – napauta Julkaise jatkaaksesi ketjua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ publiés. %3$@ Le reste est toujours là — touchez Publier pour poursuivre le fil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פורסמו %1$@ מתוך %2$@. %3$@ השאר עדיין כאן — הקש על פרסם כדי להמשיך את השרשור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ में से %1$@ पोस्ट हुईं। %3$@ बाकी यहीं हैं — थ्रेड जारी रखने के लिए पोस्ट करें दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objavljeno %1$@ od %2$@. %3$@ Ostatak je još ovdje — dodirni Objavi za nastavak niti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közzétéve: %1$@ / %2$@. %3$@ A többi még itt van – koppints a Közzététel gombra a szál folytatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terposting %1$@ dari %2$@. %3$@ Sisanya masih di sini — ketuk Posting untuk melanjutkan utas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblicati %1$@ di %2$@. %3$@ Il resto è ancora qui: tocca Pubblica per continuare il thread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@件中%1$@件を投稿しました。%3$@ 残りはここに残っています。「投稿」をタップしてスレッドを続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@개 중 %1$@개를 게시했어요. %3$@ 나머지는 그대로 남아 있어요. 게시를 탭해 스레드를 이어가세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ൽ %1$@ പോസ്റ്റ് ചെയ്തു. %3$@ ബാക്കിയുള്ളത് ഇവിടെത്തന്നെയുണ്ട് — ത്രെഡ് തുടരാൻ പോസ്റ്റ് ടാപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiarkan %1$@ daripada %2$@. %3$@ Selebihnya masih di sini — ketik Siar untuk menyambung utas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiserte %1$@ av %2$@. %3$@ Resten er fortsatt her. Trykk på Publiser for å fortsette tråden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ geplaatst. %3$@ De rest staat hier nog: tik op Plaatsen om de thread voort te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opublikowano %1$@ z %2$@. %3$@ Reszta nadal tu jest — stuknij Opublikuj, aby kontynuować wątek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicados %1$@ de %2$@. %3$@ O restante continua aqui: toque em Postar para continuar o fio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicadas %1$@ de %2$@. %3$@ O resto continua aqui — toque em Publicar para continuar a conversa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postate %1$@ din %2$@. %3$@ Restul este încă aici — apasă Postează pentru a continua conversația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опубликовано %1$@ из %2$@. %3$@ Остальное осталось здесь — нажмите «Опубликовать», чтобы продолжить цепочку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zverejnené: %1$@ z %2$@. %3$@ Zvyšok je stále tu — ťuknutím na Zverejniť a pokračuj vo vlákne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicerade %1$@ av %2$@. %3$@ Resten finns kvar här – tryck på Publicera för att fortsätta tråden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ இடப்பட்டது. %3$@ மீதமுள்ளவை இன்னும் இங்கேயே உள்ளன — உரையாடலைத் தொடர இடு என்பதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@లో %1$@ పోస్ట్ అయ్యాయి. %3$@ మిగిలినవి ఇంకా ఇక్కడే ఉన్నాయి — థ్రెడ్‌ను కొనసాగించడానికి పోస్ట్ నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์แล้ว %1$@ จาก %2$@ %3$@ ส่วนที่เหลือยังอยู่ที่นี่ แตะโพสต์เพื่อทำเธรดต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ gönderiden %1$@ tanesi paylaşıldı. %3$@ Gerisi hâlâ burada; konuşmaya devam etmek için Gönder'e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опубліковано %1$@ з %2$@. %3$@ Решта залишилася тут — торкніться «Опублікувати», щоб продовжити ланцюжок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ میں سے %1$@ پوسٹ ہوئیں۔ %3$@ باقی یہیں موجود ہیں — تھریڈ جاری رکھنے کے لیے پوسٹ کریں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng %1$@ trên %2$@. %3$@ Phần còn lại vẫn ở đây — chạm Đăng để tiếp tục chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布 %1$@ 条，共 %2$@ 条。%3$@ 其余内容仍保留在这里，轻点“发布”即可继续这个对话串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已發布 %2$@ 則中的 %1$@ 則。%3$@ 其餘內容仍保留在這裡，點一下「發布」即可繼續串文。"
          }
        }
      }
    },
