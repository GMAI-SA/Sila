    "communities.visibility.public.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص أن يجده ويقرأ ما يُنشر فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ এটি খুঁজে পেতে ও পোস্ট করা লেখা পড়তে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom la pot trobar i llegir el que s'hi publica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý ji může najít a číst, co se v ní zveřejní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan finde det og læse det, der slås op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann sie finden und lesen, was gepostet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο καθένας μπορεί να τη βρει και να διαβάσει τις αναρτήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can find it and read what is posted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede encontrarla y leer lo que se publica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa voi löytää sen ja lukea julkaisut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut la trouver et lire ce qui y est publié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול למצוא אותה ולקרוא את מה שמתפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी इसे ढूँढ सकता है और जो पोस्ट हुआ उसे पढ़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko je može pronaći i čitati što je objavljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki megtalálhatja, és elolvashatja a bejegyzéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun bisa menemukannya dan membaca isinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può trovarla e leggere ciò che viene pubblicato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰でも見つけて、投稿を読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 찾을 수 있고 게시된 글을 읽을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആർക്കും ഇത് കണ്ടെത്താനും പോസ്റ്റ് ചെയ്തത് വായിക്കാനും കഴിയും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa boleh menemuinya dan membaca apa yang disiarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan finne det og lese det som publiseres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan hem vinden en lezen wat er wordt geplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może ją znaleźć i czytać opublikowane wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode encontrá-la e ler o que é postado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa a pode encontrar e ler o que é publicado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine o poate găsi și citi ce se postează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой может найти его и читать посты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájsť ju a čítať, čo sa v nej zverejňuje, môže ktokoľvek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kan hitta den och läsa det som publiceras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யார் வேண்டுமானாலும் இதைக் கண்டுபிடித்து இடப்பட்டதைப் படிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా దీన్ని కనుగొని, పోస్ట్ చేసినవి చదవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ค้นเจอและอ่านสิ่งที่โพสต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes bulabilir ve paylaşılanları okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто може її знайти й читати, що в ній публікується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی اسے ڈھونڈ سکتا ہے اور جو پوسٹ ہو وہ پڑھ سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể tìm thấy và đọc những gì được đăng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以找到它并阅读其中的帖子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能找到並閱讀所發布的內容。"
          }
        }
      }
    },
