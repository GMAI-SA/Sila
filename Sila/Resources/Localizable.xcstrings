    "voice.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشورات الصوتية غير متاحة الآن — أعد المحاولة بعد قليل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস পোস্ট এখন পাওয়া যাচ্ছে না — একটু পরে আবার চেষ্টা করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions de veu no estan disponibles ara mateix: torna-ho a provar aviat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasové příspěvky teď nejsou dostupné – zkus to za chvíli"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydopslag er ikke tilgængelige lige nu – prøv igen om lidt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachbeiträge sind gerade nicht verfügbar – versuche es gleich noch einmal"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωνητικές αναρτήσεις δεν είναι διαθέσιμες αυτή τη στιγμή — δοκίμασε ξανά σε λίγο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice posts are unavailable right now — try again shortly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones de voz no están disponibles ahora: inténtalo de nuevo en breve"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääniviestit eivät ole juuri nyt käytettävissä – yritä pian uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts vocaux sont indisponibles pour le moment — réessayez bientôt"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים קוליים אינם זמינים כרגע — נסה שוב בקרוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस पोस्ट अभी उपलब्ध नहीं हैं — थोड़ी देर में फिर कोशिश करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovne objave trenutačno nisu dostupne — pokušaj ponovno uskoro"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangbejegyzések most nem érhetők el – próbáld újra hamarosan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan suara tidak tersedia saat ini — coba lagi sebentar lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post vocali non sono disponibili al momento: riprova a breve"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声投稿は現在利用できません。しばらくしてからもう一度お試しください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 게시물을 지금은 사용할 수 없어요. 잠시 후 다시 시도하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോയ്‌സ് പോസ്റ്റുകൾ ഇപ്പോൾ ലഭ്യമല്ല — അല്പസമയം കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran suara tidak tersedia sekarang — cuba lagi sebentar lagi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydinnlegg er utilgjengelige akkurat nå. Prøv igjen om litt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakberichten zijn nu niet beschikbaar: probeer het zo opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy głosowe są teraz niedostępne — spróbuj za chwilę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts de voz estão indisponíveis agora: tente de novo em breve"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações de voz estão indisponíveis neste momento — tente novamente daqui a pouco"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările vocale sunt indisponibile acum — încearcă din nou în curând"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые посты сейчас недоступны — повторите чуть позже"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasové príspevky sú momentálne nedostupné — skús to o chvíľu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstinlägg är inte tillgängliga just nu – försök igen om en stund"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் இடுகைகள் இப்போது கிடைக்கவில்லை — சிறிது நேரத்தில் மீண்டும் முயலுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్ పోస్ట్‌లు ప్రస్తుతం అందుబాటులో లేవు — కాసేపట్లో మళ్లీ ప్రయత్నించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ใช้โพสต์เสียงไม่ได้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli gönderiler şu anda kullanılamıyor; birazdan tekrar deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосові дописи зараз недоступні — спробуйте невдовзі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائس پوسٹس ابھی دستیاب نہیں — تھوڑی دیر میں کوشش کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng giọng nói hiện không khả dụng — hãy thử lại sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音帖子目前不可用，请稍后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音貼文目前無法使用，請稍後再試"
