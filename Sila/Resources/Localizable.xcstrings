        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает посты %@ в вашей ленте подписок"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí príspevky používateľa %@ v tvojom kanáli Sledované"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar %@s inlägg i ditt Följer-flöde"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் இடுகைகளை உங்கள் பின்தொடர்கிறீர்கள் ஊட்டத்தில் காட்டும்"
