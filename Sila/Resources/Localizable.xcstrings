            "value": "%@ — verifică-ți identitatea ca să poți posta în continuare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — пройдите проверку личности, чтобы продолжать писать"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — over svoju totožnosť, aby si mohol pokračovať v zverejňovaní"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – verifiera din identitet för att fortsätta publicera"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — தொடர்ந்து இடுகையிட உங்கள் அடையாளத்தைச் சரிபார்க்கவும்"
