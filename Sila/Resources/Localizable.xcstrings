    "auth.resetPassword.signsOutEverywhere": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير كلمة المرور يسجّل خروجك من كل مكان آخر — وهذا هو المقصود، إن كان أحد غيرك داخل حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ড বদলালে অন্য সব জায়গা থেকে আপনি সাইন আউট হয়ে যাবেন — অন্য কেউ আপনার অ্যাকাউন্টে ঢুকে থাকলে সেটাই এর উদ্দেশ্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar la contrasenya et desconnecta de tots els altres llocs, que és el que cal si algú altre era al teu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna hesla tě odhlásí všude jinde – což je smyslem, pokud ti do účtu vstoupil někdo jiný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skifter adgangskode, bliver du logget ud alle andre steder – og det er meningen, hvis en anden har haft adgang til din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dein Passwort änderst, wirst du überall sonst abgemeldet – genau das ist der Sinn, falls jemand anderes in deinem Konto war."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή κωδικού σε αποσυνδέει από παντού αλλού — και αυτό είναι το νόημα, αν κάποιος άλλος είχε μπει στον λογαριασμό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your password signs you out everywhere else — which is the point, if somebody else was in your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar tu contraseña cierra tu sesión en todos los demás sitios, que es justo lo que buscas si otra persona estaba en tu cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanan vaihtaminen kirjaa sinut ulos kaikkialta muualta – mikä on tarkoituskin, jos joku muu oli tililläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer votre mot de passe vous déconnecte partout ailleurs — c’est voulu, si quelqu’un d’autre était dans votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי הסיסמה מנתק אותך בכל מקום אחר — וזו המטרה, אם מישהו אחר היה בחשבון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड बदलने पर आप बाकी हर जगह साइन आउट हो जाते हैं — अगर आपके अकाउंट में कोई और घुसा था, तो यही मकसद है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena lozinke odjavljuje te posvuda drugdje — u tome je poanta ako je netko drugi bio u tvom računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó módosítása máshol is kijelentkeztet – ez a lényeg, ha valaki más járt a fiókodban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah kata sandi mengeluarkanmu dari tempat lain — dan memang itu tujuannya, jika ada orang lain di akunmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la password ti disconnette da tutti gli altri dispositivi: è lo scopo, se qualcun altro era nel tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更すると、他のすべての場所でサインアウトされます。他の誰かがアカウントに入っていた場合に備えた仕組みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호를 바꾸면 다른 모든 곳에서 로그아웃돼요. 다른 사람이 내 계정에 접속했다면 바로 그게 목적이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌വേഡ് മാറ്റിയാൽ മറ്റെല്ലായിടത്തും നിങ്ങൾ സൈൻ ഔട്ട് ആകും — മറ്റാരെങ്കിലും നിങ്ങളുടെ അക്കൗണ്ടിൽ ഉണ്ടായിരുന്നെങ്കിൽ അതാണ് ഉദ്ദേശ്യം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar kata laluan akan melog keluar anda di tempat lain — itulah tujuannya, jika orang lain berada dalam akaun anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du endrer passordet, logges du ut overalt ellers. Det er poenget hvis noen andre var inne på kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je wachtwoord wijzigt, word je overal elders uitgelogd. Dat is de bedoeling als iemand anders in je account zat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana hasła wyloguje Cię wszędzie indziej — i o to chodzi, jeśli ktoś inny miał dostęp do Twojego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a senha desconecta você de todos os outros lugares, e é essa a ideia se outra pessoa estava na sua conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a palavra-passe termina a sua sessão em todos os outros sítios — que é o objetivo, se mais alguém estava na sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea parolei te deconectează de peste tot — exact asta e ideea, dacă altcineva era în contul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После смены пароля вы выйдете на всех остальных устройствах — в этом и смысл, если в аккаунт заходил кто-то чужой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenou hesla sa odhlásiš všade inde — o to ide, ak bol v tvojom účte niekto cudzí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ändrar lösenordet loggas du ut överallt annars – det är meningen om någon annan var inne på ditt konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுச்சொல்லை மாற்றினால் மற்ற எல்லா இடங்களிலும் வெளியேற்றப்படுவீர்கள் — வேறொருவர் உங்கள் கணக்கில் இருந்தால் அதுவே நோக்கம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌వర్డ్ మార్చితే మిగతా అన్ని చోట్లా మీరు సైన్ అవుట్ అవుతారు — మీ ఖాతాలో మరెవరైనా ఉంటే అదే ఉద్దేశం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนรหัสผ่านจะออกจากระบบทุกที่อื่น ซึ่งเป็นจุดประสงค์หากมีคนอื่นเข้าบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrenizi değiştirmek diğer tüm yerlerdeki oturumlarınızı kapatır; hesabınızda başkası varsa amaç da bu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна пароля виводить вас із системи скрізь — це саме те, що потрібно, якщо в ваш обліковий запис заходив хтось інший."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس ورڈ بدلنے سے آپ باقی ہر جگہ سائن آؤٹ ہو جاتے ہیں — یہی مقصد ہے، اگر کوئی اور آپ کے اکاؤنٹ میں تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi mật khẩu sẽ đăng xuất bạn ở mọi nơi khác — đó là chủ đích, nếu có người khác đã vào tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改密码会让你在其他所有地方退出登录。如果有人曾进入你的账户，这正是用意所在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更密碼會讓你在其他所有地方登出。如果有人曾進入你的帳號，這正是目的所在。"
          }
        }
      }
    },
