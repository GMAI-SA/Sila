    "composer.sensitive.note.hint": {
      "comment": "VoiceOver hint on the note field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر على الغطاء بكلماتك. حتى 80 حرفًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবরণে আপনার ভাষায় দেখানো হয়। সর্বোচ্চ ৮০ অক্ষর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostra a la coberta, amb les teves paraules. Fins a 80 caràcters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se na zakrytí tvými slovy. Nejvýše 80 znaků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises på afdækningen med dine egne ord. Op til 80 tegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf der Abdeckung in deinen Worten angezeigt. Bis zu 80 Zeichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται στο κάλυμμα, με δικά σου λόγια. Έως 80 χαρακτήρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on the cover, in your words. Up to 80 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra en la cubierta, con tus palabras. Hasta 80 caracteres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään peitteessä omin sanoin. Enintään 80 merkkiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché sur le voile, avec vos mots. 80 caractères au maximum."
          }
        },
        "he": {
          "stringUnit": {
