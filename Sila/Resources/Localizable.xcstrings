    "document.type.message": {
      "comment": "Body of the document picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منطقتها المقروءة آليًا تخبرنا بجنسيتك. وهذا ما ستعرضه شارتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর মেশিন-রিডেবল জোন থেকে আপনার জাতীয়তা জানা যায়। আপনার ব্যাজে সেটাই দেখাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La seva zona de lectura mecànica ens diu la teva nacionalitat. Això és el que mostrarà la teva insígnia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strojově čitelná zóna nám prozradí tvou státní příslušnost. To se zobrazí na tvém odznaku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dets maskinlæsbare zone fortæller os din nationalitet. Det er den, dit badge kommer til at vise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine maschinenlesbare Zone verrät uns deine Staatsangehörigkeit. Das zeigt dein Abzeichen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχαναγνώσιμη ζώνη του μας δείχνει την υπηκοότητά σου. Αυτό θα εμφανίζει το σήμα σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its machine-readable zone tells us your nationality. That is what your badge will show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su zona legible por máquina nos indica tu nacionalidad. Eso es lo que mostrará tu insignia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen koneluettava alue kertoo kansalaisuutesi. Merkkisi näyttää sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa zone lisible par machine nous indique votre nationalité. C’est ce que votre badge affichera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזור הקריא-מכונה שלו מגלה לנו את האזרחות שלך. זה מה שהתג שלך יציג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका मशीन-रीडेबल ज़ोन हमें आपकी राष्ट्रीयता बताता है। आपका बैज वही दिखाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njezina strojno čitljiva zona govori nam tvoje državljanstvo. To će prikazivati tvoja značka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gépileg olvasható zónája elárulja az állampolgárságodat. Ezt fogja mutatni a jelvényed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona yang dapat dibaca mesin pada dokumen memberi tahu kami kewarganegaraanmu. Itulah yang akan ditampilkan lencanamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua zona a lettura ottica ci dice la tua nazionalità. È ciò che mostrerà il tuo badge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械読み取りゾーンから国籍がわかります。バッジにはそれが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 MRZ(기계 판독 영역)로 국적을 알 수 있어요. 배지에 표시되는 정보예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖയിലെ മെഷീൻ-റീഡബിൾ സോൺ നിങ്ങളുടെ പൗരത്വം ഞങ്ങളോട് പറയുന്നു. അതാണ് നിങ്ങളുടെ ബാഡ്ജ് കാണിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zon boleh baca mesinnya memberitahu kami kewarganegaraan anda. Itulah yang akan dipaparkan oleh lencana anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den maskinlesbare sonen forteller oss nasjonaliteten din. Det er den merket ditt vil vise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De machineleesbare zone vertelt ons je nationaliteit. Dat is wat je badge laat zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego strefa odczytu maszynowego podaje nam Twoje obywatelstwo. To zobaczysz na swojej odznace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona legível por máquina informa sua nacionalidade. É isso que seu selo vai mostrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona de leitura ótica indica a sua nacionalidade. É isso que o seu selo vai mostrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona lizibilă automat ne spune cetățenia ta. Aceasta va apărea pe insigna ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гражданство определяется по машиночитаемой зоне. Именно оно будет показано на вашем значке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho strojovo čitateľná zóna nám prezradí tvoju štátnu príslušnosť. To sa zobrazí na tvojom odznaku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess maskinläsbara zon talar om din nationalitet. Det är vad ditt märke kommer att visa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதன் இயந்திரம் படிக்கும் பகுதி உங்கள் குடியுரிமையை எங்களுக்குச் சொல்கிறது. உங்கள் பேட்ஜ் அதைத்தான் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీనిలోని మెషిన్-రీడబుల్ జోన్ మీ జాతీయతను చెబుతుంది. మీ బ్యాడ్జ్ చూపేది అదే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซนที่เครื่องอ่านได้ของเอกสารบอกสัญชาติของคุณ ซึ่งเป็นสิ่งที่ป้ายของคุณจะแสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine tarafından okunabilir bölgesi uyruğunuzu söyler. Rozetinizde bu görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його машинозчитувана зона показує ваше громадянство. Саме його покаже ваш значок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا مشین ریڈایبل زون ہمیں آپ کی قومیت بتاتا ہے۔ آپ کا بیج وہی دکھائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng đọc được bằng máy của giấy tờ cho chúng tôi biết quốc tịch của bạn. Đó là điều huy hiệu của bạn sẽ hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证件的机读区会告诉我们你的国籍，这就是你的徽章将显示的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的機器可讀區會告訴我們你的國籍，你的徽章將顯示這個國籍。"
          }
        }
      }
    },
