    "vouch.list.confirm.message": {
      "comment": "%1$@ is the person's handle, %2$@ a number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستطيع ⁦@%1$@⁩ النشر لمدة %2$@ يومًا واسمك مقرون باسمه. إن تبيّن أنه ليس من قلت، تفقد حق التزكية — وقد يُعلَّق حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নামসহ @%1$@ %2$@ দিন পোস্ট করতে পারবেন। আপনি যা বলেছিলেন তিনি সেই ব্যক্তি না হলে আপনি ভাউচ করার অধিকার হারাবেন — এবং আপনার অ্যাকাউন্ট স্থগিত হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ pot publicar durant %2$@ dies amb el teu nom al seu costat. Si resulta que no és qui deies, perds el dret d'avalar, i el teu compte pot ser suspès."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ může %2$@ dní psát s tvým jménem vedle svého. Pokud se ukáže, že to není ten, za koho jsi ručil, ztratíš právo ručit – a tvůj účet může být pozastaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kan slå op i %2$@ dage med dit navn på sit. Viser det sig, at vedkommende ikke er den, du sagde, mister du retten til at gå i god for andre – og din konto kan blive suspenderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kann %2$@ Tage lang mit deinem Namen hinter dem eigenen posten. Stellt sich heraus, dass die Person nicht ist, wer du gesagt hast, verlierst du das Recht zu bürgen – und dein Konto kann gesperrt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%1$@ μπορεί να δημοσιεύει για %2$@ ημέρες με το όνομά σου δίπλα στο δικό του/της. Αν αποδειχθεί ότι δεν είναι αυτός/ή που είπες, χάνεις το δικαίωμα να εγγυάσαι — και ο λογαριασμός σου μπορεί να τεθεί σε αναστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ can post for %2$@ days with your name on theirs. If they turn out not to be who you said, you lose the right to vouch — and your account can be suspended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ puede publicar durante %2$@ días con tu nombre junto al suyo. Si resulta no ser quien dijiste, pierdes el derecho a avalar y tu cuenta puede ser suspendida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ voi julkaista %2$@ päivää nimesi ollessa hänen nimensä vieressä. Jos käy ilmi, ettei hän ole se, joksi sanoit, menetät takaamisoikeuden – ja tilisi voidaan jäädyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ pourra publier pendant %2$@ jours avec votre nom à côté du sien. S’il s’avère ne pas être celui que vous avez annoncé, vous perdez le droit de vous porter garant — et votre compte peut être suspendu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ יכול לפרסם במשך %2$@ ימים עם שמך על שמו. אם יתברר שהוא לא מי שאמרת, תאבד את הזכות לערוב — והחשבון שלך עלול להיות מושעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ आपके नाम के साथ अपने नाम पर %2$@ दिन तक पोस्ट कर सकते हैं। अगर वे वह नहीं निकले जो आपने कहा, तो आप वाउच करने का अधिकार खो देंगे — और आपका अकाउंट निलंबित हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ može objavljivati %2$@ dana s tvojim imenom uz svoje. Ako se pokaže da nije osoba koju si naveo/la, gubiš pravo na jamčenje — a tvoj račun može biti suspendiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ %2$@ napig írhat a te nevedet a sajátja mellett. Ha kiderül, hogy nem az, akit mondtál, elveszíted a kezeskedés jogát – és a fiókodat fel lehet függeszteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ bisa memposting selama %2$@ hari dengan namamu di samping namanya. Jika ternyata ia bukan orang yang kamu sebut, kamu kehilangan hak menjamin — dan akunmu bisa ditangguhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ può pubblicare per %2$@ giorni con il tuo nome accanto al suo. Se risulta non essere chi hai detto, perdi il diritto di garantire e il tuo account può essere sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@は、あなたの名前が添えられた状態で%2$@日間投稿できます。保証した人物と別人だと判明した場合、あなたは保証する権利を失い、アカウントが停止されることもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@님은 내 이름을 걸고 %2$@일 동안 게시할 수 있어요. 내가 말한 사람이 아닌 것으로 밝혀지면 나는 보증 자격을 잃고 계정이 정지될 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പേരോടൊപ്പം @%1$@ ന് %2$@ ദിവസം പോസ്റ്റ് ചെയ്യാം. നിങ്ങൾ പറഞ്ഞ ആളല്ല അവരെന്ന് തെളിഞ്ഞാൽ, വൗച്ച് ചെയ്യാനുള്ള അവകാശം നിങ്ങൾക്ക് നഷ്ടമാകും — നിങ്ങളുടെ അക്കൗണ്ടും സസ്പെൻഡ് ചെയ്യപ്പെടാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ boleh menyiar selama %2$@ hari dengan nama anda pada namanya. Jika ternyata dia bukan orang yang anda nyatakan, anda kehilangan hak untuk menjamin — dan akaun anda boleh digantung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kan publisere i %2$@ dager med navnet ditt på sitt. Hvis det viser seg at vedkommende ikke er den du sa, mister du retten til å garantere, og kontoen din kan bli suspendert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kan %2$@ dagen posten met jouw naam op de zijne of hare. Als blijkt dat diegene niet is wie je zei, verlies je het recht om in te staan en kan je account worden geschorst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ może publikować przez %2$@ dni z Twoim imieniem obok swojego. Jeśli okaże się, że to nie ta osoba, którą wskazałeś, tracisz prawo do poręczania — a Twoje konto może zostać zawieszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ pode postar por %2$@ dias com o seu nome junto ao dele. Se a pessoa não for quem você disse, você perde o direito de avalizar, e sua conta pode ser suspensa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ pode publicar durante %2$@ dias com o seu nome associado ao dele. Se se vier a verificar que não é quem disse, perde o direito de avalizar — e a sua conta pode ser suspensa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ poate posta timp de %2$@ zile cu numele tău lângă al lui. Dacă se dovedește că nu este cine ai spus, pierzi dreptul de a garanta — iar contul tău poate fi suspendat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ сможет публиковать посты в течение %2$@ дней с вашим именем рядом со своим. Если окажется, что это не тот человек, о котором вы говорили, вы потеряете право поручаться, а ваш аккаунт могут заблокировать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ môže %2$@ dní zverejňovať s tvojím menom pri svojom. Ak sa ukáže, že nie je tým, kým si uviedol, stratíš právo ručiť — a tvoj účet môže byť pozastavený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kan publicera i %2$@ dagar med ditt namn på sitt. Om det visar sig att de inte är den du sa förlorar du rätten att intyga – och ditt konto kan stängas av."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயருடன் @%1$@ %2$@ நாட்கள் இடுகையிடலாம். நீங்கள் கூறிய நபர் அவர் அல்ல எனத் தெரிந்தால், உறுதியளிக்கும் உரிமையை இழப்பீர்கள் — உங்கள் கணக்கும் இடைநிறுத்தப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ మీ పేరుతో %2$@ రోజులు పోస్ట్ చేయగలరు. వారు మీరు చెప్పిన వ్యక్తి కాదని తేలితే, మీరు హామీ ఇచ్చే హక్కును కోల్పోతారు — మీ ఖాతా సస్పెండ్ కూడా కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ จะโพสต์ได้ %2$@ วันโดยมีชื่อของคุณกำกับ หากเขาไม่ใช่คนที่คุณระบุ คุณจะเสียสิทธิ์ในการรับรอง และบัญชีของคุณอาจถูกระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ sizin adınız kendi adının yanında %2$@ gün gönderi paylaşabilir. Söylediğiniz kişi olmadığı anlaşılırsa kefil olma hakkınızı kaybedersiniz ve hesabınız askıya alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ може публікувати протягом %2$@ днів з вашим іменем поруч зі своїм. Якщо виявиться, що це не та людина, про яку ви казали, ви втратите право ручатися — а ваш обліковий запис можуть призупинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ آپ کے نام کے ساتھ %2$@ دن تک پوسٹ کر سکتے ہیں۔ اگر وہ وہ نہ نکلے جو آپ نے بتایا، تو آپ ضمانت دینے کا حق کھو دیں گے — اور آپ کا اکاؤنٹ معطل ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ có thể đăng bài trong %2$@ ngày với tên của bạn gắn trên tên họ. Nếu họ không phải người bạn đã nói, bạn mất quyền bảo chứng — và tài khoản của bạn có thể bị đình chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 可以在 %2$@ 天内发帖，名字旁带有你的名字。如果对方并非你所说的人，你会失去担保资格，你的账户也可能被封禁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 可以在 %2$@ 天內以你的名義背書發文。如果對方並非你所說的人，你會失去擔保資格，你的帳號也可能被停權。"
          }
        }
      }
    },
    "vouch.list.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل هذا من قصدته؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি এঁকেই বুঝিয়েছিলেন?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És qui volies dir?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to ten, koho jsi myslel?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er det den, du mente?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das die Person, die du meintest?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι αυτός/ή που εννοούσες;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this who you meant?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es esta la persona que querías decir?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko tämä se, jota tarkoitit?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est-ce bien la personne visée ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מי שהתכוונת אליו?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपका मतलब यही व्यक्ति था?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je li to osoba koju si mislio/la?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ő az, akire gondoltál?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah ini orang yang kamu maksud?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la persona che intendevi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人で間違いありませんか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의도한 사람이 맞나요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഉദ്ദേശിച്ചത് ഇവരെയാണോ?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah ini orang yang anda maksudkan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er dette den du mente?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is dit wie je bedoelde?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy to ta osoba, o którą Ci chodziło?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É quem você queria dizer?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É esta a pessoa que quis dizer?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este persoana la care te-ai gândit?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это тот, кого вы имели в виду?"
          }
        },
        "sk": {
          "stringUnit": {
