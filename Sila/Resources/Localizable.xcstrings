    "account.email.error.claimedWhileWaiting": {
      "comment": "The address was taken between sending the code and confirming. Says plainly that nothing changed. %@ is the address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل شخص آخر %@ بينما كان رمزك في بريدك، لذلك لم يُنفَّذ التغيير. وعنوانك كما هو. جرّب عنوانًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কোড ইনবক্সে থাকাকালীন অন্য কেউ %@ নিয়ে নিয়েছে, তাই পরিবর্তনটি হয়নি। আপনার ঠিকানা আগের মতোই আছে। অন্য একটি চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú altre ha reclamat %@ mentre el teu codi era a la safata d'entrada, així que no s'ha fet el canvi. La teva adreça no ha canviat. Prova'n una altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo jiný si zabral %@, zatímco tvůj kód čekal v doručené poště, takže ke změně nedošlo. Tvá adresa zůstala beze změny. Zkus jinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden tog %@, mens din kode lå i indbakken, så ændringen blev ikke udført. Din adresse er uændret. Prøv en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes hat %@ belegt, während dein Code im Postfach lag, deshalb wurde nichts geändert. Deine Adresse bleibt unverändert. Versuche eine andere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος άλλος χρησιμοποίησε το %@ ενώ ο κωδικός σου ήταν στα εισερχόμενα, οπότε η αλλαγή δεν έγινε. Η διεύθυνσή σου παραμένει ίδια. Δοκίμασε άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somebody else claimed %@ while your code was in the inbox, so the change was not made. Your address is unchanged. Try a different one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona reclamó %@ mientras tu código estaba en la bandeja de entrada, así que no se hizo el cambio. Tu dirección sigue igual. Prueba con otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku muu otti osoitteen %@ käyttöönsä koodin odottaessa postilaatikossa, joten vaihtoa ei tehty. Osoitteesi ei muuttunut. Kokeile toista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre a pris %@ pendant que votre code était dans la boîte de réception, le changement n’a donc pas été effectué. Votre adresse n’a pas changé. Essayez-en une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו אחר תפס את %@ בזמן שהקוד שלך היה בדרך, ולכן השינוי לא בוצע. הכתובת שלך לא השתנתה. נסה כתובת אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कोड इनबॉक्स में रहते हुए किसी और ने %@ ले लिया, इसलिए बदलाव नहीं हुआ। आपका पता वही है। कोई दूसरा आज़माएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko drugi preuzeo je %@ dok je tvoj kod bio u sandučiću, pa promjena nije izvršena. Tvoja adresa je nepromijenjena. Pokušaj s drugom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki más lefoglalta a(z) %@ címet, amíg a kódod a postaládában volt, ezért a módosítás nem történt meg. A címed változatlan. Próbálj meg egy másikat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang lain memakai %@ saat kodemu ada di kotak masuk, jadi perubahan tidak dilakukan. Alamatmu tidak berubah. Coba alamat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro ha preso %@ mentre il tuo codice era in arrivo, quindi la modifica non è stata fatta. Il tuo indirizzo è invariato. Provane un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが届くのを待っている間に、別の人が%@を使用したため、変更されませんでした。メールアドレスはそのままです。別のアドレスをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 도착하기를 기다리는 동안 다른 사람이 %@을(를) 사용하기 시작해서 변경되지 않았어요. 주소는 그대로예요. 다른 주소를 사용해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കോഡ് ഇൻബോക്സിൽ എത്തിനിൽക്കുമ്പോൾ മറ്റൊരാൾ %@ സ്വന്തമാക്കി, അതിനാൽ മാറ്റം നടന്നില്ല. നിങ്ങളുടെ വിലാസം മാറിയിട്ടില്ല. മറ്റൊന്ന് ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang lain telah menuntut %@ semasa kod anda dalam peti masuk, jadi perubahan tidak dibuat. Alamat anda tidak berubah. Cuba yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen andre tok %@ mens koden lå i innboksen, så endringen ble ikke gjort. Adressen din er uendret. Prøv en annen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand anders heeft %@ in gebruik genomen terwijl je code onderweg was, dus de wijziging is niet doorgevoerd. Je adres is ongewijzigd. Probeer een ander adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś inny zajął adres %@, zanim wpisałeś(-aś) kod, więc zmiana nie została wykonana. Twój adres pozostał bez zmian. Spróbuj użyć innego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa passou a usar %@ enquanto seu código estava na caixa de entrada, então a mudança não foi feita. Seu endereço continua o mesmo. Tente outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém reclamou %@ enquanto o seu código estava na caixa de entrada, por isso a alteração não foi feita. O seu endereço mantém-se. Experimente outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Altcineva a folosit %@ cât timp codul tău era în inbox, așa că schimbarea nu s-a făcut. Adresa ta a rămas neschimbată. Încearcă alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы ждали код, адрес %@ занял кто-то другой, поэтому изменение не выполнено. Ваш адрес остался прежним. Попробуйте другой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto iný si zabral %@, kým tvoj kód čakal v schránke, takže zmena sa neuskutočnila. Tvoja adresa zostala nezmenená. Skús inú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon annan tog %@ medan din kod låg i inkorgen, så ändringen gjordes inte. Din adress är oförändrad. Prova en annan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் குறியீடு இன்பாக்ஸில் இருந்தபோது வேறொருவர் %@ முகவரியைப் பெற்றுவிட்டார், அதனால் மாற்றம் செய்யப்படவில்லை. உங்கள் முகவரி மாறவில்லை. வேறொன்றை முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కోడ్ ఇన్‌బాక్స్‌లో ఉండగానే మరొకరు %@ను తీసుకున్నారు, కాబట్టి మార్పు జరగలేదు. మీ చిరునామా మారలేదు. వేరొకటి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนอื่นใช้ %@ ไปแล้วระหว่างที่คุณรอรหัสในกล่องจดหมาย จึงไม่ได้เปลี่ยนอีเมล ที่อยู่ของคุณยังเหมือนเดิม ลองใช้ที่อยู่อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodunuz gelen kutusundayken başka biri %@ adresini aldı, bu yüzden değişiklik yapılmadı. Adresiniz aynı kaldı. Başka bir adres deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось інший зайняв %@, поки ваш код був у скриньці, тож зміну не виконано. Вашу адресу не змінено. Спробуйте іншу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا کوڈ ان باکس میں ہی تھا کہ کسی اور نے %@ لے لیا، اس لیے تبدیلی نہیں ہوئی۔ آپ کا پتا وہی ہے۔ کوئی دوسرا پتا آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người khác đã đăng ký %@ trong lúc mã của bạn còn trong hộp thư, nên thay đổi không được thực hiện. Địa chỉ của bạn không đổi. Hãy thử địa chỉ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你等待验证码期间，%@ 已被其他人占用，因此未做更改。你的邮箱保持不变。请换一个试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你等待驗證碼期間，其他人已使用了 %@，因此未進行變更。你的信箱維持不變，請改用其他信箱。"
          }
        }
      }
    },
    "account.email.intro": {
      "comment": "Explains why the code goes to the new address, not the current one. %@ is the current address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل الدخول باستخدام %@. سيُرسل معروف رمزًا من ستة أرقام إلى العنوان **الجديد** — لا إلى هذا العنوان — لأن الشيء الوحيد الذي يستحق الإثبات هنا هو أنك تستطيع قراءة البريد الذي تنتقل إليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি %@ দিয়ে সাইন ইন করেন। Known **নতুন** ঠিকানায় — এটিতে নয় — ছয় সংখ্যার একটি কোড ইমেইল করবে, কারণ এখানে শুধু এটুকু প্রমাণ করাই জরুরি যে আপনি যে মেইলবক্সে যাচ্ছেন সেটি পড়তে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicies la sessió amb %@. Known enviarà un codi de sis dígits a l'adreça **nova**, no a aquesta, perquè l'únic que cal demostrar aquí és que pots llegir la bústia a la qual et canvies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlašuješ se pomocí %@. Known pošle šestimístný kód na **novou** adresu – ne na tuto – protože jediné, co tu stojí za ověření, je, že si umíš přečíst schránku, na kterou přecházíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du logger ind med %@. Known sender en sekscifret kode til den **nye** adresse – ikke til denne – fordi det eneste, der er værd at bevise her, er, at du kan læse den postkasse, du flytter til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich mit %@ an. Known sendet einen sechsstelligen Code an die **neue** Adresse – nicht an diese –, denn es geht nur darum zu beweisen, dass du das Postfach lesen kannst, zu dem du wechselst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέεσαι με το %@. Το Known θα στείλει έναν εξαψήφιο κωδικό στη **νέα** διεύθυνση — όχι σε αυτήν — γιατί το μόνο που αξίζει να αποδείξεις εδώ είναι ότι διαβάζεις το γραμματοκιβώτιο στο οποίο μετακινείσαι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in with %@. Known will email a six-digit code to the **new** address — not to this one — because the only thing worth proving here is that you can read the mailbox you are moving to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicias sesión con %@. Known enviará un código de seis dígitos a la dirección **nueva**, no a esta, porque lo único que importa comprobar aquí es que puedes leer el buzón al que te mudas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudut osoitteella %@. Known lähettää kuusinumeroisen koodin **uuteen** osoitteeseen – ei tähän – koska ainoa tässä todistettava asia on, että pääset lukemaan postilaatikkoa, johon olet siirtymässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connectez avec %@. Known enverra un code à six chiffres à la **nouvelle** adresse — pas à celle-ci — car il suffit de prouver que vous pouvez lire la boîte mail vers laquelle vous passez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מתחבר עם %@. Known תשלח קוד בן שש ספרות לכתובת **החדשה** — לא לזו — כי הדבר היחיד ששווה להוכיח כאן הוא שאתה יכול לקרוא את תיבת הדואר שאליה אתה עובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ से साइन इन करते हैं। Known छह अंकों का कोड **नए** पते पर ईमेल करेगा — इस पते पर नहीं — क्योंकि यहाँ बस यह साबित करना ज़रूरी है कि आप जिस मेलबॉक्स में जा रहे हैं उसे पढ़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljuješ se s %@. Known će poslati šesteroznamenkasti kod na **novu** adresu — ne na ovu — jer je jedino važno dokazati da možeš čitati sandučić na koji se seliš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel jelentkezel be: %@. A Known egy hatjegyű kódot küld az **új** címre – nem erre –, mert itt csak azt kell igazolni, hogy el tudod olvasni azt a postafiókot, ahová átköltözöl."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu masuk dengan %@. Known akan mengirim kode enam digit lewat email ke alamat **baru** — bukan ke alamat ini — karena yang perlu dibuktikan di sini hanyalah bahwa kamu bisa membaca kotak surat tujuanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con %@. Known invierà un codice di sei cifre al **nuovo** indirizzo, non a questo, perché l'unica cosa da dimostrare qui è che puoi leggere la casella a cui stai passando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は%@でサインインしています。Knownは**新しい**アドレス(このアドレスではありません)に6桁のコードをメールで送ります。移行先のメールボックスを読めることを確認するためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@(으)로 로그인하고 있어요. Known은 이 주소가 아닌 **새** 주소로 6자리 코드를 보내요. 옮겨 갈 메일함을 읽을 수 있는지가 여기서 확인할 유일한 것이기 때문이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ %@ ഉപയോഗിച്ചാണ് സൈൻ ഇൻ ചെയ്യുന്നത്. Known ആറക്ക കോഡ് **പുതിയ** വിലാസത്തിലേക്ക് ഇമെയിൽ ചെയ്യും — ഇതിലേക്കല്ല — കാരണം നിങ്ങൾ മാറുന്ന മെയിൽബോക്സ് വായിക്കാൻ നിങ്ങൾക്ക് കഴിയുമെന്ന് തെളിയിക്കുക എന്നതാണ് ഇവിടെ പ്രധാനം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda log masuk dengan %@. Known akan mengemel kod enam digit ke alamat **baharu** — bukan ke alamat ini — kerana satu-satunya perkara yang perlu dibuktikan di sini ialah anda boleh membaca peti mel yang anda tuju."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du logger inn med %@. Known sender en sekssifret kode på e-post til den **nye** adressen, ikke til denne, fordi det eneste som er verdt å bekrefte her, er at du kan lese postkassen du flytter til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je logt in met %@. Known mailt een zescijferige code naar het **nieuwe** adres, niet naar dit adres, want het enige dat hier telt is dat je de mailbox kunt lezen waarnaar je overstapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logujesz się adresem %@. Known wyśle sześciocyfrowy kod na **nowy** adres — nie na ten — bo jedyne, co tu warto sprawdzić, to czy masz dostęp do skrzynki, na którą się przenosisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entra com %@. O Known enviará um código de seis dígitos para o **novo** endereço, e não para este, porque o que importa aqui é provar que você consegue ler a caixa de entrada para a qual está mudando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão com %@. A Known vai enviar um código de seis dígitos para o **novo** endereço — não para este — porque a única coisa que importa provar aqui é que consegue ler a caixa de correio para onde vai mudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te autentifici cu %@. Known va trimite un cod din șase cifre la adresa **nouă** — nu la aceasta — pentru că singurul lucru care contează aici este că poți citi căsuța în care te muți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы входите с адресом %@. Known отправит шестизначный код на **новый** адрес — не на этот, — ведь важно лишь убедиться, что у вас есть доступ к почтовому ящику, на который вы переходите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlasuješ sa pomocou %@. Known pošle šesťmiestny kód na **novú** adresu — nie na túto — pretože jediné, čo tu stojí za overenie, je, že vieš čítať schránku, na ktorú prechádzaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggar in med %@. Known skickar en sexsiffrig kod till den **nya** adressen – inte till den här – eftersom det enda som behöver bevisas är att du kan läsa brevlådan du flyttar till."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் %@ மூலம் உள்நுழைகிறீர்கள். Known ஆறு இலக்கக் குறியீட்டை **புதிய** முகவரிக்கு — இதற்கு அல்ல — மின்னஞ்சல் செய்யும்; ஏனெனில் நீங்கள் மாறும் அஞ்சல்பெட்டியைப் படிக்க முடியும் என்பதை நிரூபிப்பதே இங்கு முக்கியம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు %@తో సైన్ ఇన్ చేస్తున్నారు. Known ఆరు అంకెల కోడ్‌ను **కొత్త** చిరునామాకు ఈమెయిల్ చేస్తుంది — ఈ చిరునామాకు కాదు — ఎందుకంటే మీరు మారుతున్న మెయిల్‌బాక్స్‌ను చదవగలరని నిరూపించడమే ఇక్కడ ముఖ్యం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณลงชื่อเข้าใช้ด้วย %@ Known จะส่งรหัสหกหลักไปที่ที่อยู่**ใหม่** ไม่ใช่ที่อยู่นี้ เพราะสิ่งเดียวที่ต้องยืนยันคือคุณอ่านกล่องจดหมายที่จะย้ายไปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile giriş yapıyorsunuz. Known, altı haneli bir kodu bu adrese değil **yeni** adrese e-postayla gönderir; çünkü burada kanıtlanması gereken tek şey, taşındığınız posta kutusunu okuyabildiğinizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви входите з %@. Known надішле шестизначний код на **нову** адресу — не на цю — бо єдине, що тут варто підтвердити, це що ви можете прочитати скриньку, на яку переходите."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ %@ سے سائن اِن کرتے ہیں۔ Known **نئے** پتے پر چھ ہندسوں کا کوڈ ای میل کرے گا — اس پتے پر نہیں — کیونکہ یہاں بس یہی ثابت کرنا ضروری ہے کہ آپ اس میل باکس کو پڑھ سکتے ہیں جس پر آپ جا رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đăng nhập bằng %@. Known sẽ gửi mã sáu chữ số đến địa chỉ **mới** — không phải địa chỉ này — vì điều duy nhất cần chứng minh ở đây là bạn đọc được hộp thư mình chuyển đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前使用 %@ 登录。Known 会向**新**邮箱（而不是这个）发送一个六位验证码，因为这里唯一需要证明的，就是你能读取要迁移到的那个邮箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前使用 %@ 登入。Known 會將六位數驗證碼寄到**新的**信箱（而非此信箱），因為這裡唯一需要證明的是你能讀取要換過去的信箱。"
          }
        }
      }
