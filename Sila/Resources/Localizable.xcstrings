        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a sua identidade para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică-ți identitatea pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите проверку личности, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Over svoju totožnosť, aby si mohol pokračovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiera din identitet för att fortsätta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగడానికి మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันตัวตนของคุณเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верифікуйте особу, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری رکھنے کے لیے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh danh tính để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请验证你的身份以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請驗證你的身分以繼續。"
          }
        }
      }
    },
    "vouch.ended.reason.declined": {
      "comment": "Why the vouch ended. %@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكّد ⁦@%@⁩ أنك أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ নিশ্চিত করেননি যে এটি আপনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ no ha confirmat que fossis tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nepotvrdil, že jsi to ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bekræftede ikke, at det var dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ hat nicht bestätigt, dass du es warst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ δεν επιβεβαίωσε ότι ήσουν εσύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ didn't confirm it was you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ no confirmó que fueras tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ei vahvistanut, että se olit sinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ n’a pas confirmé que c’était vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ לא אישר שזה אתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ने पुष्टि नहीं की कि यह आप थे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nije potvrdio/la da si to ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nem erősítette meg, hogy te vagy az."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak mengonfirmasi bahwa itu kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ non ha confermato che eri tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@は、あなた本人であると確認しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@님이 본인이 맞다고 확인하지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് നിങ്ങളാണെന്ന് @%@ സ്ഥിരീകരിച്ചില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ tidak mengesahkan itu anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bekreftet ikke at det var deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ heeft niet bevestigd dat jij het was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nie potwierdził(a), że to Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não confirmou que era você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não confirmou que era você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nu a confirmat că ești tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ не подтвердил(а), что это вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nepotvrdil, že si to ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bekräftade inte att det var du."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது நீங்கள்தான் என @%@ உறுதிப்படுத்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది మీరేనని @%@ నిర్ధారించలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ไม่ยืนยันว่าเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ sizin olduğunuzu onaylamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ не підтвердив(ла), що це ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ نے تصدیق نہیں کی کہ یہ آپ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
