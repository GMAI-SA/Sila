    "account.email.row.detail": {
      "comment": "What changing the email requires.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان الذي تسجّل الدخول به. تغييره يحتاج كلمة مرورك ورمزًا يُرسل إلى العنوان الجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে ঠিকানা দিয়ে আপনি সাইন ইন করেন। বদলাতে আপনার পাসওয়ার্ড এবং নতুন ঠিকানায় পাঠানো একটি কোড লাগবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adreça amb la qual inicies la sessió. Canviar-la requereix la contrasenya i un codi enviat a l'adreça nova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa, kterou se přihlašuješ. Změna vyžaduje heslo a kód zaslaný na novou adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den adresse, du logger ind med. For at ændre den skal du bruge din adgangskode og en kode sendt til den nye adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, mit der du dich anmeldest. Zum Ändern brauchst du dein Passwort und einen Code, der an die neue Adresse gesendet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση με την οποία συνδέεσαι. Η αλλαγή απαιτεί τον κωδικό σου και έναν κωδικό που στέλνεται στη νέα διεύθυνση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address you sign in with. Changing it needs your password and a code sent to the new address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección con la que inicias sesión. Cambiarla requiere tu contraseña y un código enviado a la nueva dirección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoite, jolla kirjaudut. Sen vaihtaminen vaatii salasanasi ja uuteen osoitteeseen lähetetyn koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse avec laquelle vous vous connectez. La modifier demande votre mot de passe et un code envoyé à la nouvelle adresse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתובת שאיתה אתה מתחבר. שינוי דורש את הסיסמה שלך וקוד שנשלח לכתובת החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पता जिससे आप साइन इन करते हैं। इसे बदलने के लिए आपका पासवर्ड और नए पते पर भेजा गया कोड चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa s kojom se prijavljuješ. Za promjenu trebaju ti lozinka i kod poslan na novu adresu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cím, amellyel bejelentkezel. A módosításhoz a jelszavad és egy az új címre küldött kód szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat yang kamu pakai untuk masuk. Mengubahnya butuh kata sandimu dan kode yang dikirim ke alamat baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo con cui accedi. Per cambiarlo servono la password e un codice inviato al nuovo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに使うアドレスです。変更にはパスワードと、新しいアドレスに送られるコードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에 사용하는 주소예요. 변경하려면 비밀번호와 새 주소로 전송된 코드가 필요해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സൈൻ ഇൻ ചെയ്യാൻ ഉപയോഗിക്കുന്ന വിലാസം. ഇത് മാറ്റാൻ നിങ്ങളുടെ പാസ്‌വേഡും പുതിയ വിലാസത്തിലേക്ക് അയയ്ക്കുന്ന കോഡും വേണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat yang anda gunakan untuk log masuk. Menukarnya memerlukan kata laluan anda dan kod yang dihantar ke alamat baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen du logger inn med. For å endre den trenger du passordet og en kode sendt til den nye adressen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres waarmee je inlogt. Wijzigen vereist je wachtwoord en een code die naar het nieuwe adres wordt gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres, którym się logujesz. Zmiana wymaga hasła i kodu wysłanego na nowy adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço com o qual você entra. Para alterá-lo, é preciso sua senha e um código enviado ao novo endereço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço com que inicia sessão. Alterá-lo exige a sua palavra-passe e um código enviado para o novo endereço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa cu care te autentifici. Schimbarea cere parola și un cod trimis la adresa nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес, с которым вы входите. Для изменения нужны пароль и код, отправленный на новый адрес."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa, ktorou sa prihlasuješ. Na zmenu treba tvoje heslo a kód poslaný na novú adresu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen du loggar in med. För att ändra den krävs ditt lösenord och en kod som skickas till den nya adressen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழையும் முகவரி. இதை மாற்ற உங்கள் கடவுச்சொல்லும் புதிய முகவரிக்கு அனுப்பப்படும் குறியீடும் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సైన్ ఇన్ చేసే చిరునామా. దీన్ని మార్చడానికి మీ పాస్‌వర్డ్, కొత్త చిరునామాకు పంపిన కోడ్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ที่คุณใช้ลงชื่อเข้าใช้ การเปลี่ยนต้องใช้รหัสผ่านและรหัสที่ส่งไปยังที่อยู่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yaptığınız adres. Değiştirmek için şifreniz ve yeni adrese gönderilen bir kod gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса, з якою ви входите. Для зміни потрібні ваш пароль і код, надісланий на нову адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ پتا جس سے آپ سائن اِن کرتے ہیں۔ اسے بدلنے کے لیے آپ کا پاس ورڈ اور نئے پتے پر بھیجا گیا کوڈ چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ bạn dùng để đăng nhập. Đổi địa chỉ cần mật khẩu và một mã gửi đến địa chỉ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你用来登录的邮箱。更改需要输入密码，以及发送到新邮箱的验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你用來登入的信箱。變更需要輸入密碼，以及寄到新信箱的驗證碼。"
          }
        }
      }
    },
    "account.email.row.hint": {
