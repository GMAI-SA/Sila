        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാസ്‌വേഡ് മാറ്റി എല്ലാ ഉപകരണങ്ങളും സൈൻ ഔട്ട് ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggantikan kata laluan anda dan melog keluar semua peranti"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatter passordet ditt og logger alle enheter ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt je wachtwoord en logt alle apparaten uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępuje hasło i wylogowuje wszystkie urządzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui sua senha e desconecta todos os dispositivos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a sua palavra-passe e termina a sessão em todos os dispositivos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înlocuiește parola și deconectează toate dispozitivele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет пароль и завершает сеансы на всех устройствах"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradí tvoje heslo a odhlási všetky zariadenia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter ditt lösenord och loggar ut alla enheter"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல்லை மாற்றி எல்லாச் சாதனங்களையும் வெளியேற்றும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాస్‌వర్డ్‌ను మార్చి ప్రతి పరికరాన్ని సైన్ అవుట్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่รหัสผ่านของคุณและออกจากระบบทุกอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrenizi değiştirir ve tüm cihazlardaki oturumları kapatır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінює ваш пароль і виводить із системи всі пристрої"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پاس ورڈ بدلتا ہے اور ہر ڈیوائس سائن آؤٹ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay mật khẩu của bạn và đăng xuất mọi thiết bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换你的密码，并让所有设备退出登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換你的密碼並讓所有裝置登出"
          }
        }
      }
    },
    "account.phone.badgeNote": {
      "comment": "Says a phone number cannot change the country flag or the verified badge.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علم بلدك وشارة التوثيق يأتيان من توثيق الهوية، ولا يمكن لرقم جوال أن يغيّر أيًا منهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেশের পতাকা ও ভেরিফায়েড ব্যাজ পরিচয় যাচাই থেকে আসে, আর ফোন নম্বর এর কোনোটিই বদলাতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera del teu país i la teva insígnia de verificat provenen de la verificació d'identitat, i un número de telèfon no pot canviar cap de les dues."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvé země a odznak ověření vycházejí z ověření totožnosti a telefonní číslo ani jedno z toho změnit nemůže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit landeflag og dit verificerede badge kommer fra identitetsverificeringen, og et telefonnummer kan ikke ændre nogen af dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Landesflagge und dein Verifiziert-Abzeichen stammen aus der Identitätsprüfung, und eine Telefonnummer kann an keinem von beiden etwas ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημαία της χώρας σου και το σήμα επαλήθευσης προέρχονται από την επαλήθευση ταυτότητας και ένας αριθμός τηλεφώνου δεν μπορεί να αλλάξει κανένα από τα δύο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country flag and your verified badge come from identity verification, and a phone number cannot change either of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera de tu país y tu insignia de verificado provienen de la verificación de identidad, y un número de teléfono no puede cambiar ninguna de las dos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maasi lippu ja vahvistusmerkkisi tulevat henkilöllisyyden vahvistuksesta, eikä puhelinnumero voi muuttaa kumpaakaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drapeau de votre pays et votre badge Vérifié proviennent de la vérification d’identité, et un numéro de téléphone ne peut modifier ni l’un ni l’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דגל המדינה שלך והתג המאומת שלך מגיעים מאימות הזהות, ומספר טלפון לא יכול לשנות אף אחד מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके देश का झंडा और सत्यापित बैज पहचान सत्यापन से आते हैं, और फ़ोन नंबर इनमें से कुछ भी नहीं बदल सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastava tvoje zemlje i značka potvrđenog računa dolaze iz provjere identiteta, a broj telefona ne može promijeniti ni jedno ni drugo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az országzászlód és a hitelesített jelvényed a személyazonosság-ellenőrzésből származik, és a telefonszám egyiket sem változtathatja meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara dan lencana terverifikasimu berasal dari verifikasi identitas, dan nomor telepon tidak bisa mengubah keduanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandiera del tuo paese e il badge di verifica derivano dalla verifica d'identità, e un numero di telefono non può modificare nessuno dei due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗と認証バッジは本人確認によって決まるもので、電話番号では変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 깃발과 인증 배지는 신원 인증에서 가져오며, 전화번호로는 둘 다 바꿀 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാകയും വെരിഫൈഡ് ബാഡ്ജും ലഭിക്കുന്നത് തിരിച്ചറിയൽ പരിശോധനയിൽ നിന്നാണ്; ഫോൺ നമ്പറിന് ഇവ രണ്ടും മാറ്റാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara dan lencana disahkan anda datang daripada pengesahan identiti, dan nombor telefon tidak boleh mengubah kedua-duanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsflagget ditt og det verifiserte merket ditt kommer fra identitetsverifiseringen, og et telefonnummer kan ikke endre noen av dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je landvlag en je geverifieerd-badge komen van de identiteitsverificatie, en een telefoonnummer kan daar niets aan veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaga Twojego kraju i odznaka zweryfikowanego pochodzą z weryfikacji tożsamości, a numer telefonu nie może zmienić żadnej z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país e o seu selo de verificado vêm da verificação de identidade, e um número de telefone não pode mudar nenhum dos dois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país e o seu selo de verificado vêm da verificação de identidade, e um número de telefone não pode alterar nenhum dos dois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steagul țării tale și insigna de verificat provin din verificarea identității, iar un număr de telefon nu poate schimba niciuna dintre ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Флаг вашей страны и значок «Проверен» появляются по результатам проверки личности, и номер телефона не может изменить ни то, ни другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvojej krajiny a odznak overenia pochádzajú z overenia totožnosti a telefónne číslo nemôže zmeniť ani jedno z nich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaggan för ditt land och ditt verifierade märke kommer från identitetsverifieringen, och ett telefonnummer kan inte ändra någondera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்டுக் கொடியும் சரிபார்க்கப்பட்ட பேட்ஜும் அடையாளச் சரிபார்ப்பிலிருந்து வருகின்றன; தொலைபேசி எண்ணால் அவற்றில் எதையும் மாற்ற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దేశ జెండా, ధృవీకరించబడిన బ్యాడ్జ్ గుర్తింపు ధృవీకరణ నుండి వస్తాయి; ఫోన్ నంబర్ వాటిలో దేన్నీ మార్చలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธงประเทศและป้ายยืนยันของคุณมาจากการยืนยันตัวตน และหมายเลขโทรศัพท์ไม่สามารถเปลี่ยนสองอย่างนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke bayrağınız ve doğrulanmış rozetiniz kimlik doğrulamasından gelir; telefon numarası bunların hiçbirini değiştiremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапор вашої країни та значок верифікації походять із перевірки особи, і номер телефону не може змінити жодне з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ملک کا جھنڈا اور آپ کا تصدیق شدہ بیج شناخت کی تصدیق سے آتے ہیں، اور فون نمبر ان میں سے کچھ نہیں بدل سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ quốc gia và huy hiệu đã xác minh của bạn đến từ việc xác minh danh tính, và số điện thoại không thể thay đổi cả hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的国家旗帜和已验证徽章来自身份验证，手机号码无法改变这两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的國家旗幟和已驗證徽章來自身分驗證，電話號碼無法改變這兩者。"
          }
        }
      }
    },
    "account.phone.error.empty": {
      "comment": "Validation when the phone field is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب رقمًا، أو احذف الرقم المسجّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নম্বর লিখুন, অথবা সংরক্ষিত নম্বরটি সরিয়ে দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu un número o elimina el que hi ha desat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš číslo, nebo odeber uložené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv et nummer, eller fjern det registrerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Nummer ein oder entferne die gespeicherte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολόγησε έναν αριθμό ή αφαίρεσε αυτόν που είναι καταχωρισμένος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a number, or remove the one on file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un número o elimina el que está guardado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita numero tai poista tallennettu numero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un numéro, ou supprimez celui enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד מספר, או הסר את המספר השמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई नंबर लिखें, या दर्ज नंबर हटा दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši broj ili ukloni onaj koji je spremljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj be egy számot, vagy töröld a megadottat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik nomor, atau hapus nomor yang tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un numero oppure rimuovi quello registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を入力するか、登録済みの番号を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호를 입력하거나 등록된 번호를 삭제하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു നമ്പർ ടൈപ്പ് ചെയ്യുക, അല്ലെങ്കിൽ നിലവിലുള്ളത് നീക്കം ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip nombor, atau alih keluar nombor yang ada dalam fail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et nummer, eller fjern det som er registrert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een nummer, of verwijder het nummer dat is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz numer albo usuń zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um número ou remova o que está salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um número ou remova o que está registado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie un număr sau șterge-l pe cel salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите номер или удалите сохранённый."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj číslo alebo odstráň to uložené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ett nummer, eller ta bort det som är sparat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்ணை உள்ளிடுங்கள், அல்லது பதிவில் உள்ளதை அகற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నంబర్ టైప్ చేయండి, లేదా ఉన్నదాన్ని తొలగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์หมายเลข หรือลบหมายเลขที่บันทึกไว้"
          }
        },
        "tr": {
