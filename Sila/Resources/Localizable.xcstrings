    "preferences.stance.interested.hint": {
      "comment": "What choosing Interested actually does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتسب هذا الموضوع ضمن صفحتك الدولية عندما تكون تصفية المواضيع مفعّلة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়ের ফিল্টার চালু থাকলে এই বিষয়কে আপনার আন্তর্জাতিক ফিডের জন্য গণ্য করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compta aquest tema per al teu canal Internacional quan el filtre de temes està activat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Započítá toto téma do tvého Mezinárodního kanálu, když je filtr témat zapnutý"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller dette emne med i dit internationale feed, når emnefiltret er slået til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt dieses Thema für deinen internationalen Feed, wenn der Themenfilter an ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπολογίζει αυτό το θέμα στη Διεθνή ροή σου όταν το φίλτρο θεμάτων είναι ενεργό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts this topic towards your International feed when the topic filter is on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta este tema para tu feed Internacional cuando el filtro de temas está activado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskee tämän aiheen mukaan Kansainvälinen-syötteeseesi, kun aihesuodatin on päällä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend ce sujet en compte pour votre fil International quand le filtre par sujet est activé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סופר את הנושא הזה לטובת הפיד הבינלאומי שלך כשמסנן הנושאים פעיל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टॉपिक फ़िल्टर चालू होने पर इस टॉपिक को आपकी अंतरराष्ट्रीय फ़ीड में गिनता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubraja ovu temu u tvoj međunarodni feed kad je filtar tema uključen"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beleszámítja ezt a témát a Nemzetközi hírfolyamodba, ha a témaszűrő be van kapcsolva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghitung topik ini untuk feed Internasionalmu saat filter topik aktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta questo argomento per il tuo feed Internazionale quando il filtro per argomento è attivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックフィルターがオンのとき、このトピックを国際フィードの対象に含めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제 필터가 켜져 있을 때 이 주제를 국제 피드에 반영해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഷയ ഫിൽട്ടർ ഓണായിരിക്കുമ്പോൾ ഈ വിഷയം നിങ്ങളുടെ അന്താരാഷ്ട്ര ഫീഡിനായി കണക്കാക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengira topik ini untuk suapan Antarabangsa anda apabila penapis topik dihidupkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller dette emnet med i den internasjonale feeden din når emnefilteret er på"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt dit onderwerp mee voor je internationale feed als het onderwerpfilter aan staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wlicza ten temat do kanału międzynarodowego, gdy filtr tematów jest włączony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta este tópico para o seu feed Internacional quando o filtro de tópicos está ativado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta este tópico para o seu feed Internacional quando o filtro de tópicos está ativo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numără acest subiect pentru fluxul tău Internațional când filtrul de subiecte este activ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывает эту тему в вашей международной ленте, когда включён фильтр тем"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Započíta túto tému do tvojho medzinárodného kanála, keď je filter tém zapnutý"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknar det här ämnet till ditt internationella flöde när ämnesfiltret är på"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்பு வடிகட்டி இயக்கத்தில் இருக்கும்போது இந்தத் தலைப்பை உங்கள் சர்வதேச ஊட்டத்தில் சேர்க்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశ ఫిల్టర్ ఆన్‌లో ఉన్నప్పుడు ఈ అంశాన్ని మీ అంతర్జాతీయ ఫీడ్ కోసం లెక్కిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับหัวข้อนี้เข้าฟีดนานาชาติของคุณเมื่อเปิดตัวกรองหัวข้อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu filtresi açıkken bu konuyu Uluslararası akışınız için sayar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховує цю тему у вашій стрічці «Світ», коли фільтр тем увімкнено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موضوع کا فلٹر آن ہونے پر اس موضوع کو آپ کی بین الاقوامی فیڈ میں شمار کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính chủ đề này vào bảng tin Quốc tế của bạn khi bộ lọc chủ đề bật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "话题筛选开启时，将此话题计入你的国际信息流"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題篩選開啟時，將此主題納入你的「國際」動態"
          }
        }
      }
    },
