        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف کرنے کا عمل آج ہوگا۔ ابھی منسوخ کرنا ممکن ہے، لیکن زیادہ دیر تک نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa sẽ diễn ra hôm nay. Hủy bây giờ vẫn được, nhưng không còn lâu nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除将在今天执行。现在取消仍然有效，但时间不多了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天將執行刪除。現在取消仍然有效，但時間所剩不多。"
          }
        }
      }
    },
    "account.recovery.countdown.unknown": {
      "comment": "Countdown when the purge date is unknown.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء ما زال موجودًا، والإلغاء أدناه يعيده كله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু এখনও আছে, আর নিচে বাতিল করলে সব ফিরে আসবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot continua aquí, i si cancel·les a sota ho recuperes tot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše tu ještě je a zrušením smazání níže se to celé vrátí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er her stadig, og hvis du annullerer nedenfor, kommer det hele tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ist alles da, und mit dem Abbrechen unten kommt alles zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα είναι ακόμα εδώ και η ακύρωση παρακάτω τα επαναφέρει όλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is still here, and cancelling below brings it all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo sigue aquí, y si cancelas abajo lo recuperas todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki on yhä tallessa, ja peruminen alta palauttaa kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est encore là, et annuler ci-dessous ramène tout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול עדיין כאן, וביטול למטה מחזיר את הכול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ अभी यहीं है, और नीचे रद्द करने पर सब वापस आ जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve je još ovdje, a otkazivanje ispod vraća sve natrag."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden megvan még, és a lenti visszavonással mindent visszakapsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya masih ada, dan membatalkan di bawah mengembalikan semuanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto è ancora qui, e annullando qui sotto torna tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてそのまま残っています。下で取り消すと、すべて元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것이 그대로 있고, 아래에서 취소하면 전부 돌아와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം ഇപ്പോഴും ഇവിടെയുണ്ട്, താഴെ റദ്ദാക്കിയാൽ എല്ലാം തിരിച്ചുവരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Segalanya masih ada, dan membatalkan di bawah akan memulihkan semuanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er fortsatt her, og hvis du avbryter nedenfor, kommer alt tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles is er nog, en door hieronder te annuleren krijg je alles terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest nadal na miejscu, a anulowanie poniżej przywróci to wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo continua aqui, e cancelar abaixo traz tudo de volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda está tudo aqui, e cancelar abaixo traz tudo de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul este încă aici, iar anularea de mai jos readuce totul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё пока на месте, и если отменить удаление ниже, всё вернётся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko tu ešte je a zrušením nižšie sa to celé vráti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt finns kvar, och om du avbryter nedan kommer allt tillbaka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் இன்னும் இங்கேயே உள்ளது; கீழே ரத்து செய்தால் அனைத்தும் திரும்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా ఇంకా ఇక్కడే ఉంది, కింద రద్దు చేస్తే అంతా తిరిగి వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างยังอยู่ที่นี่ และการยกเลิกด้านล่างจะนำทุกอย่างกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey hâlâ burada ve aşağıdan iptal ederseniz hepsi geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе ще на місці, а скасування нижче поверне все назад."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ ابھی یہاں موجود ہے، اور نیچے منسوخ کرنے سے سب واپس آ جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ vẫn còn đây, và hủy bên dưới sẽ đưa tất cả trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切仍在，在下方取消即可全部恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切仍然保留，在下方取消即可全部恢復。"
          }
        }
      }
    },
