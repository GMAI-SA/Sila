            "state": "translated",
            "value": "Zadej jednu číslici kódu, který ti přišel e-mailem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast ét ciffer af din bekræftelseskode fra e-mailen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Ziffer deines per E-Mail gesendeten Bestätigungscodes ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε ένα ψηφίο του κωδικού επιβεβαίωσης που στάλθηκε με email"
