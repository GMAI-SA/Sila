    "safety.report.received.body": {
      "comment": "Body of the ordinary receipt. %@ is the reference clause, which may be empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقرأ هذا مراجع.%@ ويمكنك رؤية كل ما أبلغت عنه في الإعدادات ← الأمان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একজন রিভিউয়ার এটি পড়বেন।%@ আপনার রিপোর্ট করা সবকিছু সেটিংস → নিরাপত্তায় দেখতে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor ho llegirà.%@ Pots veure tot el que has denunciat a Ajustos → Seguretat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuzovatel si to přečte.%@ Vše, co jsi nahlásil, uvidíš v Nastavení → Bezpečí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gennemgående vil læse dette.%@ Du kan se alt, du har anmeldt, under Indstillinger → Sikkerhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prüfer wird das lesen.%@ Alles, was du gemeldet hast, siehst du unter Einstellungen → Sicherheit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ελεγκτής θα το διαβάσει.%@ Μπορείς να δεις όλα όσα έχεις αναφέρει στις Ρυθμίσεις → Ασφάλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reviewer will read this.%@ You can see everything you have reported under Settings → Safety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor leerá esto.%@ Puedes ver todo lo que has denunciado en Ajustes → Seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastaja lukee tämän.%@ Näet kaiken ilmiantamasi kohdassa Asetukset → Turvallisuus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vérificateur le lira.%@ Vous pouvez voir tout ce que vous avez signalé dans Réglages → Sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק יקרא את זה.%@ אפשר לראות את כל מה שדיווחת עליו בהגדרות ← בטיחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समीक्षक इसे पढ़ेगा।%@ आपने जो कुछ रिपोर्ट किया है वह सब आप सेटिंग्स → सुरक्षा में देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenzent će ovo pročitati.%@ Sve što si prijavio/la možeš vidjeti u Postavke → Sigurnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy elbíráló el fogja olvasni.%@ Mindent, amit jelentettél, megtalálsz itt: Beállítások → Biztonság."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang peninjau akan membaca ini.%@ Kamu bisa melihat semua yang pernah kamu laporkan di Pengaturan → Keamanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisore la leggerà.%@ Puoi vedere tutto ciò che hai segnalato in Impostazioni → Sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査担当者が確認します。%@報告した内容は、設定 → 安全ですべて確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토자가 읽을 거예요.%@ 신고한 모든 내용은 설정 → 안전에서 확인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പരിശോധകൻ ഇത് വായിക്കും.%@ നിങ്ങൾ റിപ്പോർട്ട് ചെയ്തതെല്ലാം ക്രമീകരണങ്ങൾ → സുരക്ഷ എന്നതിൽ കാണാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang penyemak akan membaca ini.%@ Anda boleh melihat semua yang telah anda laporkan di bawah Tetapan → Keselamatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vurderer leser dette.%@ Du kan se alt du har rapportert under Innstillinger → Sikkerhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beoordelaar leest dit.%@ Alles wat je hebt gemeld zie je onder Instellingen → Veiligheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenzent to przeczyta.%@ Wszystko, co zgłosiłeś, zobaczysz w Ustawienia → Bezpieczeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um analista vai ler isto.%@ Você pode ver tudo o que denunciou em Ajustes → Segurança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um revisor vai ler isto.%@ Pode ver tudo o que denunciou em Definições → Segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evaluator va citi asta.%@ Poți vedea tot ce ai raportat în Setări → Siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобу прочтёт проверяющий.%@ Всё, на что вы пожаловались, можно увидеть в «Настройки» → «Безопасность»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posudzovateľ si to prečíta.%@ Všetko, čo si nahlásil, vidíš v Nastavenia → Bezpečnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En granskare läser detta.%@ Du kan se allt du har rapporterat under Inställningar → Säkerhet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மதிப்பாய்வாளர் இதைப் படிப்பார்.%@ நீங்கள் புகாரளித்த அனைத்தையும் அமைப்புகள் → பாதுகாப்பு என்பதில் காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్షకుడు దీన్ని చదువుతారు.%@ మీరు రిపోర్ట్ చేసినవన్నీ సెట్టింగ్‌లు → భద్రతలో చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ตรวจสอบจะอ่านเรื่องนี้%@ คุณดูทุกอย่างที่รายงานได้ใต้ การตั้งค่า → ความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir inceleyici bunu okuyacak.%@ Şikayet ettiğiniz her şeyi Ayarlar → Güvenlik altında görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це прочитає перевіряльник.%@ Усе, на що ви поскаржилися, можна побачити в Налаштування → Безпека."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک جائزہ لینے والا اسے پڑھے گا۔%@ آپ نے جو کچھ رپورٹ کیا وہ سب سیٹنگز ← تحفظ میں دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người xét duyệt sẽ đọc báo cáo này.%@ Bạn có thể xem mọi thứ bạn đã báo cáo trong Cài đặt → An toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核员会阅读此举报。%@ 你可以在“设置 → 安全”中查看你举报过的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審核人員會閱讀此檢舉。%@你可以在「設定」→「安全」中查看你檢舉過的所有內容。"
          }
        }
      }
    },
