    "vouch.claim.guest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقبول التزكية، أنشئ حسابًا أو سجّل الدخول أولًا، ثم تعود إلى هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রহণ করতে আগে অ্যাকাউন্ট তৈরি করুন বা সাইন ইন করুন। আপনি এখানে ফিরে আসবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per acceptar, crea un compte o inicia la sessió primer. Tornaràs aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přijetí si nejdřív vytvoř účet nebo se přihlas. Vrátíš se sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at acceptere skal du først oprette en konto eller logge ind. Du kommer tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zum Annehmen zuerst ein Konto oder melde dich an. Du kommst hierher zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να αποδεχτείς, δημιούργησε πρώτα λογαριασμό ή συνδέσου. Θα επιστρέψεις εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To accept, create an account or sign in first. You'll come back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aceptar, crea una cuenta o inicia sesión primero. Volverás aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksyäksesi luo ensin tili tai kirjaudu sisään. Palaat tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour accepter, créez d’abord un compte ou connectez-vous. Vous reviendrez ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לקבל, צור חשבון או התחבר קודם. תחזור לכאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकार करने के लिए पहले अकाउंट बनाएँ या साइन इन करें। आप यहीं वापस आएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prihvaćanje prvo izradi račun ili se prijavi. Vratit ćeš se ovamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elfogadáshoz előbb hozz létre fiókot, vagy jelentkezz be. Utána visszatérsz ide."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima, buat akun atau masuk dulu. Kamu akan kembali ke sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per accettare, crea prima un account o accedi. Tornerai qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け入れるには、先にアカウントを作成するかサインインしてください。ここに戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락하려면 먼저 계정을 만들거나 로그인하세요. 그러면 여기로 돌아와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വീകരിക്കാൻ ആദ്യം അക്കൗണ്ട് സൃഷ്ടിക്കുകയോ സൈൻ ഇൻ ചെയ്യുകയോ ചെയ്യുക. നിങ്ങൾ ഇവിടേക്ക് തിരികെ വരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menerima, cipta akaun atau log masuk dahulu. Anda akan kembali ke sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å godta må du først opprette en konto eller logge inn. Du kommer tilbake hit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te accepteren moet je eerst een account aanmaken of inloggen. Daarna kom je hier terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przyjąć, najpierw utwórz konto lub się zaloguj. Wrócisz tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aceitar, crie uma conta ou entre primeiro. Você voltará para cá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aceitar, crie primeiro uma conta ou inicie sessão. Voltará para aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a accepta, creează mai întâi un cont sau autentifică-te. Te vei întoarce aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы принять, сначала создайте аккаунт или войдите. Вы вернётесь сюда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prijatie si najprv vytvor účet alebo sa prihlás. Vrátiš sa sem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att godta, skapa först ett konto eller logga in. Du kommer tillbaka hit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்க, முதலில் கணக்கை உருவாக்குங்கள் அல்லது உள்நுழையுங்கள். நீங்கள் இங்கே திரும்பி வருவீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంగీకరించడానికి ముందుగా ఖాతా సృష్టించండి లేదా సైన్ ఇన్ చేయండి. మీరు ఇక్కడికి తిరిగి వస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการรับ ให้สร้างบัญชีหรือลงชื่อเข้าใช้ก่อน แล้วคุณจะกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul etmek için önce hesap oluşturun veya giriş yapın. Buraya geri döneceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб прийняти, спершу створіть обліковий запис або увійдіть. Ви повернетеся сюди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قبول کرنے کے لیے پہلے اکاؤنٹ بنائیں یا سائن اِن کریں۔ آپ یہیں واپس آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chấp nhận, hãy tạo tài khoản hoặc đăng nhập trước. Bạn sẽ quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接受，请先创建账户或登录，之后你会回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接受，請先建立帳號或登入，完成後會回到這裡。"
          }
        }
      }
    },
