        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நேரத்தில் அதிகபட்சம் %1$@ பேர் கேட்டனர், மொத்தம் %2$@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకేసారి గరిష్ఠంగా %1$@ మంది వింటున్నారు, మొత్తం %2$@ మంది"
