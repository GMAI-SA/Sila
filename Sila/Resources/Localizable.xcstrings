            "state": "translated",
            "value": "Verificér din identitet for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiziere deine Identität, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαλήθευσε την ταυτότητά σου για να συνεχίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu identidad para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista henkilöllisyytesi jatkaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמת את זהותך כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi svoj identitet da nastaviš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáshoz hitelesítsd a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi identitasmu untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la tua identità per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 신원을 인증하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക."
          }
