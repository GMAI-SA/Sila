    "safety.reason.sexualContent.detail": {
      "comment": "What the sexual-content reason covers, including material involving a child.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواد جنسية، أو أي محتوى جنسي يشمل من قد يكون طفلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যৌন উপাদান, বা শিশু হতে পারে এমন কাউকে জড়িয়ে যেকোনো যৌন বিষয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Material sexual, o qualsevol cosa sexual que impliqui algú que pot ser menor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexuální materiál nebo cokoli sexuálního, co se týká někoho, kdo může být dítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seksuelt materiale eller noget seksuelt, der involverer en, som kan være et barn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexuelles Material oder alles Sexuelle, das jemanden betrifft, der ein Kind sein könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σεξουαλικό υλικό ή οτιδήποτε σεξουαλικό που αφορά κάποιον που μπορεί να είναι παιδί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexual material, or anything sexual involving someone who may be a child."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Material sexual, o cualquier contenido sexual con alguien que pueda ser menor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seksuaalinen aineisto tai mikä tahansa seksuaalinen, johon liittyy mahdollisesti lapsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu sexuel, ou tout contenu sexuel impliquant une personne qui pourrait être un enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חומר מיני, או כל דבר מיני שמערב מישהו שעשוי להיות ילד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यौन सामग्री, या ऐसा कुछ भी यौन जिसमें कोई बच्चा हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seksualni materijal ili bilo što seksualno u čemu sudjeluje netko tko bi mogao biti dijete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szexuális tartalom, vagy bármi szexuális, amiben gyermek is érintett lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Materi seksual, atau apa pun yang bersifat seksual yang melibatkan seseorang yang mungkin anak-anak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Materiale sessuale, o qualsiasi cosa sessuale che coinvolga qualcuno che potrebbe essere un minore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性的な内容、または子どもの可能性がある人が関わる性的なもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성적인 자료, 또는 아동일 수 있는 사람이 관련된 모든 성적 내용."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈംഗിക ഉള്ളടക്കം, അല്ലെങ്കിൽ കുട്ടിയാകാൻ സാധ്യതയുള്ള ഒരാൾ ഉൾപ്പെട്ട ലൈംഗികമായ എന്തും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahan seksual, atau apa-apa yang bersifat seksual melibatkan seseorang yang mungkin kanak-kanak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seksuelt materiale, eller noe seksuelt som involverer en som kan være et barn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seksueel materiaal, of iets seksueels waarbij iemand betrokken is die een kind kan zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Materiały seksualne lub cokolwiek seksualnego z udziałem kogoś, kto może być dzieckiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Material sexual, ou qualquer coisa sexual envolvendo alguém que possa ser criança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Material sexual, ou qualquer coisa sexual envolvendo alguém que possa ser menor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Material sexual sau orice conținut sexual care implică pe cineva care ar putea fi copil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Материалы сексуального характера или что-либо сексуальное с участием, возможно, ребёнка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexuálny materiál alebo čokoľvek sexuálne, čo sa týka niekoho, kto môže byť dieťa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sexuellt material, eller något sexuellt som involverar någon som kan vara ett barn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாலியல் உள்ளடக்கம், அல்லது குழந்தையாக இருக்கக்கூடிய ஒருவர் சம்பந்தப்பட்ட எந்தப் பாலியல் உள்ளடக்கமும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైంగిక విషయాలు, లేదా పిల్లలు కావచ్చునని అనిపించే వారికి సంబంధించిన ఏదైనా లైంగిక అంశం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สื่อทางเพศ หรืออะไรที่เกี่ยวกับเพศซึ่งเกี่ยวข้องกับผู้ที่อาจเป็นเด็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinsel içerik veya çocuk olabilecek birini içeren cinsel her şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сексуальні матеріали або будь-що сексуальне за участю того, хто може бути дитиною."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جنسی مواد، یا کوئی بھی جنسی چیز جس میں ممکنہ طور پر بچہ شامل ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu tình dục, hoặc bất cứ điều gì mang tính tình dục liên quan đến người có thể là trẻ em."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色情内容，或任何涉及可能是儿童的人的性内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "性相關內容，或涉及可能是兒童的任何性內容。"
          }
        }
      }
    },
