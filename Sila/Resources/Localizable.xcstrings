    "notifications.filter.unread.hint": {
      "comment": "VoiceOver hint for the Unread filter.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الإشعارات التي لم تقرأها فقط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার না পড়া বিজ্ঞপ্তি দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra només les notificacions que no has llegit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí jen upozornění, která jsi nečetl"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kun notifikationer, du ikke har læst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nur Mitteilungen, die du nicht gelesen hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει μόνο τις ειδοποιήσεις που δεν έχεις διαβάσει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only notifications you haven't read"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo las notificaciones que no has leído"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää vain lukemattomat ilmoitukset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche uniquement les notifications non lues"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג רק התראות שלא קראת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे सूचनाएँ दिखाता है जो आपने नहीं पढ़ीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje samo obavijesti koje nisi pročitao/la"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az el nem olvasott értesítéseket mutatja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menampilkan notifikasi yang belum kamu baca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra solo le notifiche che non hai letto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読の通知だけを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 않은 알림만 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വായിക്കാത്ത അറിയിപ്പുകൾ മാത്രം കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya memaparkan pemberitahuan yang belum anda baca"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser bare varsler du ikke har lest"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alleen meldingen die je nog niet hebt gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje tylko nieprzeczytane powiadomienia"
