        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kan kun gås i god for en, der er 18 år eller ældre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jemanden kann nur gebürgt werden, wenn die Person 18 oder älter ist."
