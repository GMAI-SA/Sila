    "rooms.mic.denied": {
      "comment": "Shown when microphone access was denied at the system level. Names the exact Settings path and repeats that listening still works.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع سِلة الوصول إلى الميكروفون. فعّله من الإعدادات › سِلة › الميكروفون لتتحدث — ويمكنك الاستمرار في الاستماع في الحالتين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila can't reach your microphone. Turn it on in Settings › Sila › Microphone to speak — you can keep listening either way."
          }
        }
      }
    },
    "rooms.mic.drop": {
      "comment": "The control that turns the microphone off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتم المايك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute"
          }
        }
      }
    },
    "rooms.mic.dropHint": {
      "comment": "What muting does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الميكروفون. ولن يعود من في الغرفة يسمعك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns your microphone off. The room can no longer hear you."
          }
        }
      }
    },
    "rooms.mic.take": {
      "comment": "The control that turns the microphone on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح المايك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute"
          }
        }
      }
    },
    "rooms.mic.takeHint": {
      "comment": "What unmuting does, including that iOS will ask for permission — said before the dialog appears, because an unannounced prompt is one people deny by reflex.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل الميكروفون ليسمعك من في الغرفة. وسيطلب iOS إذن الميكروفون في المرة الأولى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns your microphone on so the room can hear you. iOS asks for microphone permission the first time."
          }
        }
      }
    },
    "rooms.nav.title": {
      "comment": "Navigation title on the rooms list.",
