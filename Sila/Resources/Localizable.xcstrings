            "state": "translated",
            "value": "Arată postările al căror text se potrivește căutării"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает посты, текст которых совпадает с запросом"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí príspevky, ktorých text zodpovedá hľadaniu"
