    "error.passwordTooLong": {
      "comment": "400 password_too_long (contract v26): a new password over the 72 bytes the server reads — at registration, a reset, a password change, or sent with a code.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور هذه طويلة جدًا. استخدم 72 حرفًا لاتينيًا على الأكثر، أو نحو 36 حرفًا عربيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডটি খুব বড়। সর্বোচ্চ ৭২ অক্ষর ব্যবহার করুন, আরবিতে প্রায় ৩৬।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta contrasenya és massa llarga. Fes servir fins a 72 caràcters, o uns 36 en àrab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo je příliš dlouhé. Použij nejvýše 72 znaků, v arabštině asi 36."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den adgangskode er for lang. Brug op til 72 tegn, eller cirka 36 på arabisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort ist zu lang. Verwende bis zu 72 Zeichen, auf Arabisch etwa 36."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κωδικός είναι πολύ μεγάλος. Χρησιμοποίησε έως 72 χαρακτήρες, ή περίπου 36 στα αραβικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That password is too long. Use up to 72 characters, or about 36 in Arabic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña es demasiado larga. Usa hasta 72 caracteres, o unos 36 en árabe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana on liian pitkä. Käytä enintään 72 merkkiä, arabiaksi noin 36."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe est trop long. Utilisez 72 caractères au maximum, soit environ 36 en arabe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה הזו ארוכה מדי. השתמש ב-72 תווים לכל היותר, או כ-36 בערבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पासवर्ड बहुत लंबा है। अधिकतम 72 अक्षर इस्तेमाल करें, या अरबी में करीब 36।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lozinka je predugačka. Koristi do 72 znaka, ili oko 36 na arapskom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a jelszó túl hosszú. Legfeljebb 72 karakter használható, arabul nagyjából 36."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi itu terlalu panjang. Pakai maksimal 72 karakter, atau sekitar 36 dalam huruf Arab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella password è troppo lunga. Usa fino a 72 caratteri, o circa 36 in arabo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが長すぎます。72文字以内にしてください(アラビア語では約36文字)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 너무 길어요. 72자 이내로, 아랍어는 약 36자까지 사용할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ പാസ്‌വേഡ് വളരെ നീണ്ടതാണ്. പരമാവധി 72 അക്ഷരം ഉപയോഗിക്കുക, അറബിയിൽ ഏകദേശം 36."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan itu terlalu panjang. Gunakan sehingga 72 aksara, atau kira-kira 36 dalam bahasa Arab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet er for langt. Bruk opptil 72 tegn, eller omtrent 36 på arabisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat wachtwoord is te lang. Gebruik maximaal 72 tekens, of ongeveer 36 in het Arabisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To hasło jest za długie. Użyj maksymalnie 72 znaków, a w alfabecie arabskim około 36."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa senha é longa demais. Use até 72 caracteres, ou cerca de 36 em árabe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa palavra-passe é demasiado longa. Use até 72 carateres, ou cerca de 36 em árabe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola este prea lungă. Folosește cel mult 72 de caractere, sau cam 36 în arabă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль слишком длинный. Используйте не более 72 символов или около 36 на арабском."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto heslo je príliš dlhé. Použi najviac 72 znakov, v arabčine asi 36."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenordet är för långt. Använd högst 72 tecken, eller omkring 36 på arabiska."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தக் கடவுச்சொல் மிக நீளமானது. 72 எழுத்துகள் வரை பயன்படுத்துங்கள், அரபியில் சுமார் 36."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ పాస్‌వర్డ్ చాలా పొడవుగా ఉంది. గరిష్ఠంగా 72 అక్షరాలు వాడండి, అరబిక్‌లో సుమారు 36."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านยาวเกินไป ใช้ได้สูงสุด 72 ตัวอักษร หรือประมาณ 36 ตัวในภาษาอาหรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şifre çok uzun. En fazla 72 karakter kullanın; Arapçada yaklaşık 36."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пароль задовгий. Використайте до 72 символів, або близько 36 арабською."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پاس ورڈ بہت لمبا ہے۔ 72 حروف تک استعمال کریں، یا عربی میں تقریباً 36۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu này quá dài. Dùng tối đa 72 ký tự, hoặc khoảng 36 ký tự nếu viết bằng tiếng Ả Rập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码太长了。最多 72 个字符，阿拉伯语大约 36 个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼太長了。最多 72 個字元，阿拉伯文約為 36 個。"
          }
        }
      }
    },
