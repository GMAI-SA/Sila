    "feed.profileOff.empty.action": {
      "comment": "Action on the profiles-off empty state.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغني عند إطلاقها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু হলে আমাকে জানান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa'm quan arribi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dej mi vědět, až přijde"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv mig besked, når den kommer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtige mich, wenn es so weit ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωσέ με όταν έρθει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me when it lands"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame cuando llegue"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, kun se on valmis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez-moi à sa sortie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרו לי כשזה יגיע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने पर मुझे बताएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Javi mi kad stigne"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szóljatok, ha megjelenik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu aku saat tersedia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami quando arriva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されたら知らせて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출시되면 알려 주세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എത്തുമ്പോൾ അറിയിക്കൂ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beritahu saya apabila tiba"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si fra når den kommer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het me weten als het er is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadom mnie, gdy będzie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise-me quando chegar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise-me quando chegar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunță-mă când apare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите, когда появится"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dať mi vedieť, keď to príde"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddela mig när det kommer"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வந்ததும் சொல்லுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వచ్చినప్పుడు నాకు చెప్పండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งฉันเมื่อพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldiğinde haber ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомте мені, коли з’явиться"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آنے پر مجھے بتائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho tôi khi có"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上线时通知我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上線時通知我"
          }
        }
      }
    },
    "feed.profileOff.empty.subtitle": {
      "comment": "Says exactly what is off and what still works. Invents no follower count.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات الملفات العامة — عدد المتابِعين وسجل المنشورات وكيف يراك الآخرون — معطّلة في هذا الإصدار. أما اسمك ومعرّفك ونبذتك وصورتك فيمكن تعديلها الآن من «الحساب». ولا نخمّن هنا أي شيء في هذه الأثناء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাবলিক প্রোফাইল পাতা — ফলোয়ারের সংখ্যা, পোস্টের ইতিহাস ও অন্যরা আপনাকে কীভাবে দেখে — এই সংস্করণে বন্ধ আছে। আপনার নাম, হ্যান্ডেল, বায়ো ও ছবি এখন অ্যাকাউন্টে সম্পাদনা করা যায়। ইতিমধ্যে এখানে কিছুই আন্দাজে দেখানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pàgines de perfil públic (seguidors, historial de publicacions i com et veuen els altres) estan desactivades en aquesta versió. El teu nom, identificador, biografia i foto ara es poden editar a Compte. Mentrestant no s'endevina res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veřejné stránky profilů – počty sledujících, historie příspěvků a jak tě vidí ostatní – jsou v této verzi vypnuté. Jméno, handle, bio a obrázek můžeš nyní upravit v Účtu. Zatím se zde nic nehádá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offentlige profilsider – antal følgere, opslagshistorik og hvordan andre ser dig – er slået fra i denne version. Dit navn, handle, bio og billede kan redigeres nu under Konto. Intet her bliver gættet imens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliche Profilseiten – Follower-Zahlen, Beitragsverlauf und wie andere dich sehen – sind in dieser Version abgeschaltet. Name, Handle, Bio und Bild kannst du jetzt unter Konto bearbeiten. Bis dahin wird hier nichts geraten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δημόσιες σελίδες προφίλ — αριθμός ακολούθων, ιστορικό αναρτήσεων και πώς σε βλέπουν οι άλλοι — είναι απενεργοποιημένες σε αυτή την έκδοση. Το όνομα, το handle, το βιογραφικό και η εικόνα σου μπορούν να επεξεργαστούν τώρα στον Λογαριασμό. Εν τω μεταξύ, τίποτα εδώ δεν υποθέτεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public profile pages — follower counts, post history and how others see you — are turned off in this build. Your name, handle, bio and picture are editable now under Account. Nothing here is guessed in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas de perfil públicas (número de seguidores, historial de publicaciones y cómo te ven los demás) están desactivadas en esta versión. Tu nombre, identificador, biografía y foto ya se pueden editar en Cuenta. Mientras tanto, aquí no se supone nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkiset profiilisivut – seuraajamäärät, julkaisuhistoria ja se, miten muut näkevät sinut – on poistettu käytöstä tässä versiossa. Nimesi, käyttäjätunnuksesi, esittelysi ja kuvasi ovat nyt muokattavissa kohdassa Tili. Mitään ei arvailla sillä välin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages de profil publiques — nombre d’abonnés, historique des posts et ce que les autres voient de vous — sont désactivées dans cette version. Votre nom, identifiant, bio et photo sont modifiables dès maintenant dans Compte. Rien n’est deviné en attendant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דפי פרופיל ציבוריים — מספרי עוקבים, היסטוריית פוסטים ואיך אחרים רואים אותך — כבויים בגרסה הזו. אפשר לערוך עכשיו את השם, שם המשתמש, התיאור והתמונה תחת חשבון. שום דבר כאן לא מנוחש בינתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पब्लिक प्रोफ़ाइल पेज — फ़ॉलोअर संख्या, पोस्ट इतिहास और दूसरे आपको कैसे देखते हैं — इस बिल्ड में बंद हैं। आपका नाम, हैंडल, बायो और फ़ोटो अभी \"अकाउंट\" में बदले जा सकते हैं। इस बीच यहाँ कुछ भी अंदाज़े से नहीं दिखाया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Javne stranice profila — broj pratitelja, povijest objava i kako te drugi vide — isključene su u ovoj verziji. Tvoje ime, handle, bio i slika sada se mogu uređivati pod Račun. Ovdje se u međuvremenu ništa ne nagađa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyilvános profiloldalak – követőszámok, bejegyzéstörténet és hogy mások hogyan látnak – ebben a verzióban ki vannak kapcsolva. A neved, @neved, bemutatkozásod és képed most a Fiók alatt szerkeszthető. Közben semmit nem találgatunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman profil publik — jumlah pengikut, riwayat postingan, dan bagaimana orang lain melihatmu — dimatikan di versi ini. Nama, handle, bio, dan fotomu bisa diedit sekarang di Akun. Tidak ada yang ditebak untuk sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine pubbliche dei profili, con numero di follower, cronologia dei post e come ti vedono gli altri, sono disattivate in questa versione. Nome, handle, bio e immagine sono modificabili ora in Account. Nel frattempo nulla qui è ipotizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開プロフィールページ(フォロワー数、投稿履歴、他の人からの見え方)は、このビルドでは無効です。名前、ハンドル、自己紹介、写真は、今は「アカウント」から編集できます。それまでの間、ここに推測で表示されるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로워 수, 게시물 기록, 다른 사람에게 보이는 모습을 담은 공개 프로필 페이지는 이 빌드에서 꺼져 있어요. 이름, 핸들, 소개, 사진은 지금 계정에서 수정할 수 있어요. 그동안 여기에 추측으로 채운 것은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പബ്ലിക് പ്രൊഫൈൽ പേജുകൾ — ഫോളോവർ എണ്ണം, പോസ്റ്റ് ചരിത്രം, മറ്റുള്ളവർ നിങ്ങളെ എങ്ങനെ കാണുന്നു — ഈ ബിൽഡിൽ ഓഫാണ്. നിങ്ങളുടെ പേര്, ഹാൻഡിൽ, ബയോ, ചിത്രം എന്നിവ ഇപ്പോൾ അക്കൗണ്ടിൽ എഡിറ്റ് ചെയ്യാം. ഇതിനിടയിൽ ഇവിടെ ഒന്നും ഊഹിച്ചതല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman profil awam — bilangan pengikut, sejarah siaran dan cara orang lain melihat anda — dimatikan dalam binaan ini. Nama, nama pengendali, bio dan gambar anda boleh disunting sekarang di bawah Akaun. Tiada apa di sini diteka sementara itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Offentlige profilsider, med antall følgere, innleggshistorikk og hvordan andre ser deg, er slått av i denne versjonen. Navnet, brukernavnet, biografien og bildet ditt kan redigeres nå under Konto. Ingenting her blir gjettet i mellomtiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Openbare profielpagina's, met aantallen volgers, berichtgeschiedenis en hoe anderen je zien, zijn uitgeschakeld in deze versie. Je naam, handle, bio en foto zijn nu te bewerken onder Account. Intussen wordt hier niets geraden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiczne strony profilu — liczba obserwujących, historia wpisów i to, jak widzą Cię inni — są wyłączone w tej wersji. Imię, uchwyt, opis i zdjęcie możesz teraz edytować w sekcji Konto. Nic tu nie jest zgadywane w międzyczasie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas de perfil público (número de seguidores, histórico de posts e como os outros veem você) estão desativadas nesta versão. Seu nome, @usuário, bio e foto podem ser editados agora em Conta. Nada aqui é adivinhado nesse meio tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas de perfil públicas — número de seguidores, histórico de publicações e como os outros o veem — estão desativadas nesta versão. O seu nome, identificador, bio e foto são editáveis agora em Conta. Nada aqui é adivinhado entretanto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Paginile publice de profil — numărul de urmăritori, istoricul postărilor și cum te văd alții — sunt dezactivate în această versiune. Numele, handle-ul, bio și poza se pot edita acum în Cont. Nimic de aici nu este ghicit între timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публичные страницы профилей — число подписчиков, история постов и то, как вас видят другие — в этой сборке отключены. Имя, @имя, описание и фото можно изменить уже сейчас в разделе «Аккаунт». Пока ничего здесь не выдумывается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Verejné stránky profilov — počty sledovateľov, história príspevkov a to, ako ťa vidia ostatní — sú v tejto verzii vypnuté. Tvoje meno, používateľské meno, opis a obrázok môžeš teraz upraviť v časti Účet. Zatiaľ sa tu nič neháda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offentliga profilsidor – antal följare, inläggshistorik och hur andra ser dig – är avstängda i den här versionen. Ditt namn, användarnamn, din presentation och bild kan redigeras nu under Konto. Inget här gissas under tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொதுச் சுயவிவரப் பக்கங்கள் — பின்தொடர்பவர் எண்ணிக்கை, இடுகை வரலாறு, மற்றவர்கள் உங்களை எப்படிப் பார்க்கிறார்கள் — இந்த உருவாக்கத்தில் முடக்கப்பட்டுள்ளன. உங்கள் பெயர், ஹேண்டில், அறிமுகம், படத்தை இப்போது கணக்கில் திருத்தலாம். இதற்கிடையில் இங்கே எதுவும் ஊகிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పబ్లిక్ ప్రొఫైల్ పేజీలు — ఫాలోయర్ల సంఖ్య, పోస్ట్ చరిత్ర, ఇతరులకు మీరు ఎలా కనిపిస్తారు — ఈ వెర్షన్‌లో ఆఫ్ చేయబడ్డాయి. మీ పేరు, హ్యాండిల్, బయో, చిత్రం ఇప్పుడు ఖాతా కింద సవరించవచ్చు. ఈ మధ్యలో ఇక్కడ ఏదీ ఊహించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าโปรไฟล์สาธารณะ ได้แก่ จำนวนผู้ติดตาม ประวัติโพสต์ และวิธีที่คนอื่นเห็นคุณ ถูกปิดในเวอร์ชันนี้ ตอนนี้คุณแก้ไขชื่อ แฮนเดิล ประวัติย่อ และรูปได้ใต้บัญชี ระหว่างนี้ไม่มีอะไรถูกเดา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkese açık profil sayfaları (takipçi sayıları, gönderi geçmişi ve başkalarının sizi nasıl gördüğü) bu sürümde kapalı. Adınız, kullanıcı adınız, biyografiniz ve fotoğrafınız şimdi Hesap altında düzenlenebilir. Bu arada burada hiçbir şey tahmin edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публічні сторінки профілів — кількість підписників, історія дописів і те, як вас бачать інші, — вимкнено в цій збірці. Ваше ім’я, @ім’я, опис і фото можна редагувати вже зараз у розділі «Обліковий запис». Нічого тут не вгадується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عوامی پروفائل صفحات — فالوورز کی تعداد، پوسٹس کی تاریخ اور دوسرے آپ کو کیسے دیکھتے ہیں — اس ورژن میں بند ہیں۔ آپ کا نام، ہینڈل، تعارف اور تصویر ابھی اکاؤنٹ میں قابل ترمیم ہیں۔ اس دوران یہاں کچھ بھی اندازے سے نہیں دکھایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang hồ sơ công khai — số người theo dõi, lịch sử bài đăng và cách người khác thấy bạn — đang tắt trong bản này. Tên, tên người dùng, tiểu sử và ảnh của bạn có thể chỉnh sửa ngay bây giờ trong Tài khoản. Trong lúc đó, không có gì ở đây được đoán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开主页（关注者数量、帖子历史以及他人眼中的你）在此版本中已关闭。你的名称、用户名、简介和头像现在可在“账户”中编辑。在此期间，这里不会有任何猜测的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開的個人檔案頁面（追蹤者人數、貼文紀錄，以及別人如何看你）在此版本中已關閉。你的名稱、代號、自我介紹和照片現在可在「帳號」中編輯。在此期間，這裡不會有任何臆測的內容。"
          }
        }
      }
    },
    "feed.profileOff.empty.title": {
      "comment": "Empty state on the profile tab while public profiles are switched off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
