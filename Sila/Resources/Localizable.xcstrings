    "guest.join.notifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف من ردّ، ومن تابعك، ومن ذكر اسمك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে উত্তর দিল, কে আপনাকে ফলো করল এবং কে আপনার নাম মেনশন করল তা দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qui t'ha respost, qui t'ha seguit i qui t'ha mencionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidíš, kdo odpověděl, kdo tě začal sledovat a kdo zmínil tvé jméno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvem der har svaret, hvem der har fulgt dig, og hvem der har nævnt dit navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wer geantwortet hat, wer dir gefolgt ist und wer deinen Namen erwähnt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες ποιος απάντησε, ποιος σε ακολούθησε και ποιος ανέφερε το όνομά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See who replied, who followed you, and who mentioned your name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira quién te respondió, quién te siguió y quién mencionó tu nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe, kuka vastasi, kuka seurasi sinua ja kuka mainitsi nimesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez qui a répondu, qui vous a suivi et qui a mentionné votre nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראה מי הגיב, מי התחיל לעקוב אחריך ומי תייג את שמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें किसने जवाब दिया, किसने आपको फ़ॉलो किया, और किसने आपका नाम मेंशन किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidi tko je odgovorio, tko te počeo pratiti i tko je spomenuo tvoje ime."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lásd, ki válaszolt, ki követett, és ki említett meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat siapa yang membalas, siapa yang mengikutimu, dan siapa yang menyebut namamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri chi ha risposto, chi ti ha seguito e chi ha menzionato il tuo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰が返信したか、誰がフォローしたか、誰があなたの名前をメンションしたかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 답글을 달았는지, 팔로우했는지, 내 이름을 멘션했는지 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരൊക്കെ മറുപടി നൽകി, ആരൊക്കെ ഫോളോ ചെയ്തു, ആരൊക്കെ നിങ്ങളുടെ പേര് പരാമർശിച്ചു എന്ന് കാണുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat siapa yang membalas, siapa yang mengikut anda, dan siapa yang menyebut nama anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvem som svarte, hvem som fulgte deg og hvem som nevnte navnet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wie heeft gereageerd, wie je is gaan volgen en wie je naam heeft genoemd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, kto odpowiedział, kto Cię zaczął obserwować i kto wspomniał Twoje imię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quem respondeu, quem seguiu você e quem mencionou seu nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quem respondeu, quem o seguiu e quem mencionou o seu nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi cine a răspuns, cine te-a urmărit și cine ți-a menționat numele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнавайте, кто ответил, кто подписался и кто упомянул вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zisti, kto odpovedal, kto ťa začal sledovať a kto spomenul tvoje meno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vem som svarade, vem som följde dig och vem som nämnde ditt namn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யார் பதிலளித்தார், யார் பின்தொடர்ந்தார், யார் உங்கள் பெயரைக் குறிப்பிட்டார் என்று பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరు రిప్లై ఇచ్చారో, ఎవరు ఫాలో అయ్యారో, ఎవరు మీ పేరును ప్రస్తావించారో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าใครตอบกลับ ใครติดตามคุณ และใครกล่าวถึงชื่อคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin yanıtladığını, kimin sizi takip ettiğini ve kimin adınızı andığını görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнавайтеся, хто відповів, хто підписався на вас і хто згадав ваше ім’я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کس نے جواب دیا، کس نے فالو کیا، اور کس نے آپ کا نام لیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ai đã trả lời, ai đã theo dõi bạn, và ai đã nhắc đến tên bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看谁回复了你、谁关注了你、谁提到了你的名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看誰回覆了你、誰追蹤了你、誰提到了你的名字。"
          }
        }
      }
    },
