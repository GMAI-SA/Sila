    "document.capture.permissionDenied": {
      "comment": "Shown when camera access was refused.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج معروف إلى الكاميرا لتصوير وثيقتك. اسمح بها من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নথির ছবি তুলতে Known-এর ক্যামেরা দরকার। সেটিংসে অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known necessita la càmera per fotografiar el teu document. Permet-ho a Ajustos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known potřebuje fotoaparát k vyfotografování dokladu. Povol ho v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known har brug for kameraet for at fotografere dit dokument. Tillad det i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known braucht die Kamera, um dein Dokument zu fotografieren. Erlaube sie in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known χρειάζεται την κάμερα για να φωτογραφίσει το έγγραφό σου. Επίτρεψέ το στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known needs the camera to photograph your document. Allow it in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known necesita la cámara para fotografiar tu documento. Permítela en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tarvitsee kameraa asiakirjasi kuvaamiseen. Salli se Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known a besoin de l’appareil photo pour photographier votre document. Autorisez-le dans les Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known צריכה את המצלמה כדי לצלם את המסמך שלך. אפשר לאפשר זאת בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दस्तावेज़ की फ़ोटो लेने के लिए Known को कैमरा चाहिए। सेटिंग्स में इसकी अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikaciji Known je potrebna kamera za fotografiranje tvoje isprave. Dopusti je u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Knownnak szüksége van a kamerára az okmányod lefényképezéséhez. Engedélyezd a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known butuh kamera untuk memotret dokumenmu. Izinkan di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ha bisogno della fotocamera per fotografare il tuo documento. Consentila in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類を撮影するには、Knownがカメラを使用する必要があります。設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 촬영하려면 Known에 카메라 권한이 필요해요. 설정에서 허용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖയുടെ ഫോട്ടോ എടുക്കാൻ Known-ന് ക്യാമറ വേണം. ക്രമീകരണങ്ങളിൽ അനുവദിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known memerlukan kamera untuk memotret dokumen anda. Benarkannya dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known trenger kameraet for å ta bilde av dokumentet ditt. Gi tilgang i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known heeft de camera nodig om je document te fotograferen. Sta dit toe in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known potrzebuje dostępu do aparatu, aby sfotografować Twój dokument. Zezwól na to w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known precisa da câmera para fotografar seu documento. Permita o acesso em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known precisa da câmara para fotografar o seu documento. Permita-o nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known are nevoie de cameră pentru a fotografia documentul. Permite accesul în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Known нужна камера, чтобы сфотографировать ваш документ. Разрешите доступ в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known potrebuje fotoaparát na odfotenie tvojho dokladu. Povoľ ho v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known behöver kameran för att fotografera ditt dokument. Tillåt den i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்தைப் படம் எடுக்க Known-க்குக் கேமரா தேவை. அமைப்புகளில் அனுமதியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రాన్ని ఫోటో తీయడానికి Knownకు కెమెరా అవసరం. సెట్టింగ్‌లలో అనుమతించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ต้องใช้กล้องเพื่อถ่ายเอกสารของคุณ อนุญาตได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'un belgenizi fotoğraflamak için kameraya ihtiyacı var. Ayarlar'dan izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known потрібна камера, щоб сфотографувати ваш документ. Дозвольте доступ у Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے دستاویز کی تصویر لینے کے لیے Known کو کیمرا چاہیے۔ سیٹنگز میں اجازت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known cần camera để chụp giấy tờ của bạn. Hãy cho phép trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 需要使用相机来拍摄你的证件。请在“设置”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 需要使用相機來拍攝你的證件。請在「設定」中允許。"
          }
        }
      }
    },
