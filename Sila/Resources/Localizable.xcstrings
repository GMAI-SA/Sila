    "events.error.notShareable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نشر فعالية مغلقة في الخلاصة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ ইভেন্ট টাইমলাইনে দেওয়া যায় না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esdeveniment tancat no es pot posar a una cronologia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzavřenou událost nelze dát na časovou osu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lukket begivenhed kan ikke komme på en tidslinje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geschlossenes Event kann nicht auf eine Timeline"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια κλειστή εκδήλωση δεν μπορεί να μπει σε ροή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closed event can't go on a timeline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento cerrado no puede ir a una cronología"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suljettua tapahtumaa ei voi jakaa aikajanalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement fermé ne peut pas aller sur un fil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירוע סגור לא יכול לעלות לציר הזמן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद इवेंट टाइमलाइन पर नहीं जा सकता"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvoreni događaj ne može ići na vremensku traku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zárt esemény nem kerülhet idővonalra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara tertutup tidak bisa masuk ke timeline"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento chiuso non può andare su una timeline"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開のイベントはタイムラインに載せられません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 이벤트는 타임라인에 올릴 수 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടച്ച ഇവന്റ് ടൈംലൈനിൽ ഇടാനാവില്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara tertutup tidak boleh diletakkan pada garis masa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lukket arrangement kan ikke legges ut på en tidslinje"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gesloten evenement kan niet op een tijdlijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamkniętego wydarzenia nie można dodać na oś czasu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um evento fechado não pode ir para a linha do tempo"
