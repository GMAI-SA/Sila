    "mutedTerms.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشورات والردود والإشعارات التي تحتوي عليها تختفي من خلاصاتك وبحثك وتنبيهاتك. تُطابَق صيغ الكتابة العربية والتشكيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো আছে এমন পোস্ট, উত্তর ও বিজ্ঞপ্তি আপনার টাইমলাইন, সার্চ ও বিজ্ঞপ্তি থেকে সরে যায়। আরবি বানানের ভিন্নতা ও হরকত মিলিয়ে নেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions, respostes i notificacions que continguin aquestes paraules desapareixen de les cronologies, la cerca i els avisos. Es detecten variants ortogràfiques de l'àrab i els diacrítics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky, odpovědi a oznámení s těmito slovy zmizí z tvých časových os, hledání i upozornění. Shodují se i arabské pravopisné varianty a diakritika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag, svar og notifikationer med disse forsvinder fra dine tidslinjer, din søgning og dine notifikationer. Arabiske stavevarianter og diakritiske tegn matches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge, Antworten und Mitteilungen mit diesen Begriffen verschwinden aus deinen Timelines, der Suche und den Mitteilungen. Arabische Schreibvarianten und Diakritika werden mit erkannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναρτήσεις, απαντήσεις και ειδοποιήσεις που περιέχουν αυτά φεύγουν από τις ροές, την αναζήτηση και τις ειδοποιήσεις σου. Αντιστοιχίζονται και οι παραλλαγές γραφής και τα διακριτικά της αραβικής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts, replies and notifications containing these leave your timelines, search and alerts. Arabic spelling variants and diacritics are matched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones, respuestas y notificaciones que contengan esto desaparecen de tus cronologías, búsquedas y avisos. Se detectan variantes ortográficas del árabe y signos diacríticos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näitä sisältävät julkaisut, vastaukset ja ilmoitukset poistuvat aikajanoiltasi, hausta ja ilmoituksistasi. Arabian kirjoitusasut ja diakriittiset merkit huomioidaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts, réponses et notifications contenant ces mots disparaissent de vos fils, de la recherche et de vos alertes. Les variantes d’orthographe arabe et les signes diacritiques sont pris en compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים, תגובות והתראות שמכילים אותן יוצאים מצירי הזמן, מהחיפוש ומההתראות שלך. גם וריאנטים של איות בערבית וניקוד מזוהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें शामिल करने वाली पोस्ट, जवाब और सूचनाएँ आपकी टाइमलाइन, खोज और अलर्ट से हट जाती हैं। अरबी वर्तनी के रूप और हरकतें भी मिलाई जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave, odgovori i obavijesti koji ih sadrže nestaju s tvojih vremenskih traka, pretrage i obavijesti. Podudaraju se arapske varijante pisanja i dijakritici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezeket tartalmazó bejegyzések, válaszok és értesítések eltűnnek az idővonalaidról, a keresésből és az értesítésekből. Az arab írásváltozatokat és ékezeteket is figyelembe vesszük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan, balasan, dan notifikasi yang memuat ini menghilang dari timeline, pencarian, dan notifikasimu. Variasi ejaan dan tanda baca Arab ikut dicocokkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post, le risposte e le notifiche che le contengono spariscono dalle tue timeline, dalla ricerca e dagli avvisi. Vengono riconosciute le varianti ortografiche arabe e i segni diacritici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらを含む投稿、返信、通知は、タイムライン、検索、通知から除外されます。アラビア語の表記ゆれやダイアクリティカルマークも一致の対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어가 포함된 게시물, 답글, 알림은 타임라인, 검색, 알림에서 사라져요. 아랍어 철자 변형과 발음 기호도 함께 일치시켜요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവ അടങ്ങിയ പോസ്റ്റുകളും മറുപടികളും അറിയിപ്പുകളും നിങ്ങളുടെ ടൈംലൈനുകളിൽ നിന്നും തിരയലിൽ നിന്നും അലേർട്ടുകളിൽ നിന്നും ഒഴിവാകും. അറബി അക്ഷരവിന്യാസ വ്യത്യാസങ്ങളും ഡയാക്രിറ്റിക്കുകളും പൊരുത്തപ്പെടുത്തും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran, balasan dan pemberitahuan yang mengandungi ini hilang daripada garis masa, carian dan makluman anda. Variasi ejaan Arab dan tanda baris dipadankan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlegg, svar og varsler som inneholder disse, forsvinner fra tidslinjene, søket og varslene dine. Arabiske stavevarianter og diakritiske tegn blir gjenkjent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten, reacties en meldingen met deze woorden verdwijnen uit je tijdlijnen, zoekresultaten en meldingen. Arabische spellingsvarianten en diakritische tekens worden meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy, odpowiedzi i powiadomienia zawierające te słowa znikną z Twoich osi czasu, wyszukiwania i powiadomień. Dopasowywane są arabskie warianty pisowni i znaki diakrytyczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts, respostas e notificações que contenham estes termos saem das suas linhas do tempo, da busca e dos alertas. Variações de grafia e diacríticos em árabe também são reconhecidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações, respostas e notificações que contenham estas saem das suas cronologias, pesquisa e alertas. As variantes ortográficas e os diacríticos em árabe são reconhecidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările, răspunsurile și notificările care le conțin dispar din fluxuri, căutare și alerte. Variantele de scriere în arabă și diacriticele sunt potrivite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты, ответы и уведомления с этими словами пропадут из ваших лент, поиска и уведомлений. Учитываются варианты написания на арабском и огласовки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky, odpovede a upozornenia, ktoré to obsahujú, zmiznú z tvojich časových osí, vyhľadávania a upozornení. Zhodujú sa aj varianty arabského pravopisu a diakritika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlägg, svar och aviseringar som innehåller dessa försvinner från dina tidslinjer, din sökning och dina aviseringar. Arabiska stavningsvarianter och diakritiska tecken matchas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவற்றைக் கொண்ட இடுகைகள், பதில்கள், அறிவிப்புகள் உங்கள் காலவரிசைகள், தேடல், அறிவிப்புகளிலிருந்து மறையும். அரபு எழுத்துப்பிழை வேறுபாடுகளும் உச்சரிப்புக் குறிகளும் பொருத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇవి ఉన్న పోస్ట్‌లు, రిప్లైలు, నోటిఫికేషన్‌లు మీ టైమ్‌లైన్‌ల నుండి, శోధన నుండి, అలర్ట్‌ల నుండి మాయమవుతాయి. అరబిక్ స్పెల్లింగ్ రూపాంతరాలు, డయాక్రిటిక్స్ కూడా సరిపోల్చబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ ตอบกลับ และการแจ้งเตือนที่มีคำเหล่านี้จะหายไปจากไทม์ไลน์ การค้นหา และการแจ้งเตือนของคุณ ระบบจับคู่รูปแบบการสะกดและเครื่องหมายกำกับเสียงของภาษาอาหรับด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları içeren gönderiler, yanıtlar ve bildirimler zaman akışlarınızdan, aramadan ve bildirimlerden çıkar. Arapça yazım varyantları ve harekeler eşleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дописи, відповіді та сповіщення з цими словами зникають із ваших стрічок, пошуку й сповіщень. Враховуються варіанти написання арабською та діакритичні знаки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جن پوسٹس، جوابات اور اطلاعات میں یہ ہوں وہ آپ کی ٹائم لائنز، سرچ اور الرٹس سے نکل جاتی ہیں۔ عربی املا کے فرق اور اعراب کا بھی ملان کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng, trả lời và thông báo chứa những từ này sẽ biến mất khỏi dòng thời gian, tìm kiếm và thông báo của bạn. Các biến thể chính tả và dấu trong tiếng Ả Rập đều được khớp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含这些词的帖子、回复和通知会从你的时间线、搜索和提醒中消失。阿拉伯语的拼写变体和变音符号也会被匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含這些詞的貼文、回覆和通知，會從你的時間軸、搜尋和提醒中消失。阿拉伯文的拼寫變體和變音符號也會被比對。"
          }
        }
      }
    },
