    "rooms.chat.notKept": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدردشة والتفاعلات تبقى ما دامت الغرفة قائمة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট ও রিঅ্যাকশন শুধু রুম যতক্ষণ থাকে ততক্ষণই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El xat i les reaccions duren només mentre dura la sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat a reakce trvají jen po dobu místnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat og reaktioner varer kun, så længe rummet gør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat und Reaktionen bestehen nur, solange der Raum besteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνομιλία και οι αντιδράσεις διαρκούν μόνο όσο και η αίθουσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat and reactions last only while the room does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat y las reacciones duran solo lo que dura la sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelu ja reaktiot säilyvät vain niin kauan kuin huone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat et les réactions ne durent que le temps du salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצ׳אט והתגובות נמשכים רק כל עוד החדר נמשך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट और रिएक्शन सिर्फ़ तब तक रहते हैं जब तक रूम रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čavrljanje i reakcije traju samo dok traje soba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csevegés és a reakciók csak a szoba fennállásáig maradnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan dan reaksi hanya bertahan selama room berlangsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat e le reazioni durano solo quanto la stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットとリアクションは、ルームが続いている間だけ残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅과 반응은 룸이 열려 있는 동안에만 유지돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചാറ്റും പ്രതികരണങ്ങളും റൂം ഉള്ളിടത്തോളം മാത്രം നിലനിൽക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembang dan reaksi hanya kekal selagi bilik itu ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat og reaksjoner varer bare så lenge rommet gjør det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat en reacties duren alleen zolang de room duurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat i reakcje trwają tylko tak długo, jak pokój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat e as reações duram apenas enquanto a sala durar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat e as reações duram apenas enquanto a sala durar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatul și reacțiile durează doar cât durează camera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат и реакции существуют, только пока идёт комната."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čet a reakcie trvajú len dovtedy, kým miestnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatt och reaktioner finns bara kvar så länge rummet gör det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அரட்டையும் எதிர்வினைகளும் அறை இருக்கும் வரை மட்டுமே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాట్, రియాక్షన్‌లు రూమ్ ఉన్నంత వరకే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทและรีแอกชันอยู่ได้เท่าที่ห้องยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet ve tepkiler yalnızca oda açık olduğu sürece kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат і реакції існують лише доки існує кімната."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیٹ اور ردعمل صرف اتنی دیر رہتے ہیں جتنی دیر روم رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện và cảm xúc chỉ tồn tại khi phòng còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天和回应只在房间存在期间保留。"
          }
        },
        "zh-Hant": {
