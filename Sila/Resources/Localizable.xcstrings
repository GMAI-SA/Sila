            "value": "Quan algú comparteix una sala que has dirigit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někdo sdílí místnost, kterou jsi vedl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen deler et rum, du var vært for."
