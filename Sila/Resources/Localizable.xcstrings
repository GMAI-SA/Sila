        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوچھتا ہے کہ وہ کون ہیں، پھر آپ کو انہیں بھیجنے کے لیے لنک دیتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi họ là ai, rồi cho bạn một liên kết để gửi cho họ"
