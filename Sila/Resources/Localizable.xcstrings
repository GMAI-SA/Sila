    "auth.welcome.a11yLabel": {
      "comment": "VoiceOver label combining the wordmark and the tagline.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معروف. الشبكة الاجتماعية الوحيدة التي كل إنسان فيها حقيقي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known। একমাত্র সোশ্যাল নেটওয়ার্ক যেখানে প্রতিটি মানুষ আসল।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. L'única xarxa social on cada persona és real."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Jediná sociální síť, kde je každý člověk skutečný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Det eneste sociale netværk, hvor ethvert menneske er ægte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Das einzige soziale Netzwerk, in dem jeder Mensch echt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Το μοναδικό κοινωνικό δίκτυο όπου κάθε άνθρωπος είναι αληθινός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. The only social network where every human is real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. La única red social donde cada persona es real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Ainoa sosiaalinen verkosto, jossa jokainen ihminen on aito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. Le seul réseau social où chaque humain est réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known. הרשת החברתית היחידה שבה כל אדם הוא אמיתי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known। एकमात्र सोशल नेटवर्क जहाँ हर इंसान असली है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
