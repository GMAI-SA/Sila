        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New email"
          }
        }
      }
    },
    "account.email.password.hint": {
      "comment": "VoiceOver hint for the password field on the email change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوبة: هاتف مفتوح وحده يجب ألا يكفي لنقل حساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required: an unlocked phone must not be enough to move an account"
          }
