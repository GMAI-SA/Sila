    "error.gifUnavailable": {
      "comment": "503 gif_unavailable (contract v27): the GIF library could not look the GIF up because its provider is down. The post can go without it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور المتحركة غير متاحة الآن. احذف الصورة المتحركة، أو أعد المحاولة بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF এখন পাওয়া যাচ্ছে না। GIF সরিয়ে দিন, অথবা একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els GIF no estan disponibles ara mateix. Elimina el GIF o torna-ho a provar d'aquí a un moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFy teď nejsou dostupné. Odeber GIF, nebo to za chvíli zkus znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF'er er ikke tilgængelige lige nu. Fjern GIF'en, eller prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs sind gerade nicht verfügbar. Entferne das GIF oder versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα GIF δεν είναι διαθέσιμα αυτή τη στιγμή. Αφαίρεσε το GIF ή δοκίμασε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs aren't available right now. Remove the GIF, or try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF no están disponibles ahora. Quita el GIF o inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-kuvat eivät ole nyt käytettävissä. Poista GIF tai yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF ne sont pas disponibles pour le moment. Retirez le GIF, ou réessayez dans un instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF לא זמין כרגע. הסר את ה-GIF, או נסה שוב עוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF अभी उपलब्ध नहीं हैं। GIF हटाएँ, या कुछ देर में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-ovi trenutačno nisu dostupni. Ukloni GIF ili pokušaj ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GIF-ek most nem érhetők el. Távolítsd el a GIF-et, vagy próbáld újra egy pillanat múlva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF tidak tersedia saat ini. Hapus GIF-nya, atau coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GIF non sono disponibili al momento. Rimuovi la GIF o riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在GIFを利用できません。GIFを削除するか、しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 GIF를 사용할 수 없어요. GIF를 삭제하거나 잠시 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-കൾ ഇപ്പോൾ ലഭ്യമല്ല. GIF നീക്കം ചെയ്യുക, അല്ലെങ്കിൽ കുറച്ച് കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF tidak tersedia sekarang. Alih keluar GIF, atau cuba lagi sebentar lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-er er ikke tilgjengelige akkurat nå. Fjern GIF-en, eller prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF's zijn nu niet beschikbaar. Verwijder de GIF of probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-y są teraz niedostępne. Usuń GIF lub spróbuj za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os GIFs não estão disponíveis agora. Remova o GIF ou tente de novo em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os GIFs não estão disponíveis neste momento. Remova o GIF ou tente novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-urile nu sunt disponibile acum. Elimină GIF-ul sau încearcă din nou în scurt timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF сейчас недоступны. Удалите GIF или повторите чуть позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFy momentálne nie sú dostupné. Odstráň GIF alebo to o chvíľu skús znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF:ar är inte tillgängliga just nu. Ta bort GIF:en eller försök igen om en stund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF கள் இப்போது கிடைக்கவில்லை. GIF ஐ அகற்றுங்கள் அல்லது சிறிது நேரம் கழித்து முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFలు ఇప్పుడు అందుబాటులో లేవు. GIFను తొలగించండి, లేదా కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังใช้ GIF ไม่ได้ ลบ GIF หรือลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF'ler şu anda kullanılamıyor. GIF'i kaldırın veya biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF зараз недоступні. Видаліть GIF або спробуйте за мить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF ابھی دستیاب نہیں۔ GIF ہٹائیں، یا ذرا دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF hiện không khả dụng. Hãy xóa GIF, hoặc thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 目前不可用。请移除 GIF，或稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用 GIF。請移除 GIF，或稍後再試。"
          }
        }
      }
