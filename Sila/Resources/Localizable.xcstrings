            "state": "translated",
            "value": "எப்படிச் சரிபார்க்க விரும்புகிறீர்கள்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎలా ధృవీకరించుకోవాలనుకుంటున్నారు?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากยืนยันตัวตนอย่างไร"
