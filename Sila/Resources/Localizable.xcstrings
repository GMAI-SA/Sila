          "stringUnit": {
            "state": "translated",
            "value": "国のスレッド。%@で認証されたアカウントだけが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 스레드. %@에서 인증된 계정만 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രാജ്യ ത്രെഡ്. %@-ൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ മറുപടി നൽകാനാകൂ."
