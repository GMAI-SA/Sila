    "feed.profileOff.account.detail": {
      "comment": "What the account row contains.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك ومعرّفك وصورتك وبريدك وكلمة مرورك — وكيفية تنزيل كل بياناتك أو حذفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নাম, হ্যান্ডেল, ছবি, ইমেইল, পাসওয়ার্ড — এবং সবকিছু কীভাবে ডাউনলোড বা মুছবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu nom, identificador, foto, correu, contrasenya, i com descarregar o eliminar-ho tot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé jméno, handle, obrázek, e-mail, heslo – a jak vše stáhnout nebo smazat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn, handle, billede, e-mail, adgangskode – og hvordan du henter eller sletter alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name, Handle, Bild, E-Mail, Passwort – und wie du alles herunterlädst oder löschst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα, το handle, η εικόνα, το email, ο κωδικός σου — και πώς να κατεβάσεις ή να διαγράψεις τα πάντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, handle, picture, email, password — and how to download or delete everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre, identificador, foto, correo y contraseña, y cómo descargar o eliminar todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimesi, käyttäjätunnuksesi, kuvasi, sähköpostisi, salasanasi – ja miten lataat tai poistat kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom, identifiant, photo, e-mail, mot de passe — et comment tout télécharger ou supprimer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם, שם המשתמש, התמונה, הדוא״ל והסיסמה שלך — ואיך להוריד או למחוק הכול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नाम, हैंडल, फ़ोटो, ईमेल, पासवर्ड — और सब कुछ डाउनलोड या डिलीट करने का तरीका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ime, handle, slika, e-pošta, lozinka — i kako preuzeti ili izbrisati sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A neved, @neved, képed, e-mail-címed, jelszavad – és hogyan töltheted le vagy törölheted az egészet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama, handle, foto, email, kata sandimu — dan cara mengunduh atau menghapus semuanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome, handle, immagine, email, password e come scaricare o eliminare tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、ハンドル、写真、メール、パスワード。すべてのダウンロードや削除もここから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 핸들, 사진, 이메일, 비밀번호, 그리고 모든 데이터를 다운로드하거나 삭제하는 방법."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പേര്, ഹാൻഡിൽ, ചിത്രം, ഇമെയിൽ, പാസ്‌വേഡ് — എല്ലാം ഡൗൺലോഡ് ചെയ്യാനോ ഇല്ലാതാക്കാനോ ഉള്ള വഴിയും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama, nama pengendali, gambar, emel, kata laluan anda — dan cara memuat turun atau memadam semuanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
