    "notifications.settings.summary.nothingSilenced": {
      "comment": "Summary when every kind is switched on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلك كل أنواع الإشعارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব ধরনের বিজ্ঞপ্তি আপনার কাছে আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et arriben tots els tipus de notificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávaš všechny druhy upozornění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle slags notifikationer når dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Art von Mitteilung erreicht dich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα είδη ειδοποιήσεων φτάνουν σε εσένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every kind of notification reaches you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te llegan todos los tipos de notificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikenlaiset ilmoitukset tulevat sinulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les types de notifications vous parviennent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל סוגי ההתראות מגיעים אליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर तरह की सूचना आप तक पहुँचती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stižu ti sve vrste obavijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden fajta értesítés eljut hozzád."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap jenis notifikasi sampai kepadamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi ogni tipo di notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての種類の通知が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 종류의 알림을 받고 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ തരം അറിയിപ്പുകളും നിങ്ങൾക്ക് ലഭിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap jenis pemberitahuan sampai kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle typer varsler når deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk soort melding bereikt je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docierają do Ciebie wszystkie rodzaje powiadomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os tipos de notificação chegam até você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os tipos de notificação chegam até si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate tipurile de notificări ajung la tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получаете уведомления всех типов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávaš všetky druhy upozornení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla sorters aviseringar når dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா வகை அறிவிப்புகளும் உங்களை வந்தடையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి రకమైన నోటిఫికేషన్ మీకు చేరుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนทุกประเภทมาถึงคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tür bildirim size ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До вас доходять усі види сповіщень."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر قسم کی اطلاع آپ تک پہنچتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi loại thông báo đều đến với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有类型的通知都会送达你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有類型的通知都會送達你。"
          }
        }
      }
    },
