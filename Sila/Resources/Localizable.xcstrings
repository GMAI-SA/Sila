    "account.phone.badgeNote": {
      "comment": "Says a phone number cannot change the country flag or the verified badge.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علم بلدك وشارة التوثيق يأتيان من توثيق الهوية، ولا يمكن لرقم جوال أن يغيّر أيًا منهما."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country flag and your verified badge come from identity verification, and a phone number cannot change either of them."
          }
        }
      }
    },
    "account.phone.error.empty": {
      "comment": "Validation when the phone field is empty.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب رقمًا، أو احذف الرقم المسجّل."
