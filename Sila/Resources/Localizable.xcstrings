    "guest.join.reply.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلف كل رد هنا شخص حقيقي — موثّق، أو مُزكّى من موثّق. وردّك كذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানকার প্রতিটি উত্তরের পেছনে একজন আসল মানুষ আছেন — ভেরিফায়েড, বা কোনো ভেরিফায়েড মানুষের সুপারিশে আসা। আপনারটিও তেমনই হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada resposta d'aquí té al darrere una persona real: verificada, o avalada per una que ho és. La teva també."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za každou odpovědí tu stojí skutečný člověk – ověřený, nebo takový, za kterého někdo ručí. Ta tvá také."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert svar her har et rigtigt menneske bag sig – verificeret eller indestået for af et. Det ville dit også have."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter jeder Antwort hier steht ein echter Mensch – verifiziert oder von einem verifizierten Menschen bestätigt. Bei deiner wäre es genauso."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πίσω από κάθε απάντηση εδώ υπάρχει πραγματικός άνθρωπος — επαληθευμένος ή εγγυημένος από κάποιον. Το ίδιο θα ισχύει και για τη δική σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every reply here has a real person behind it — verified, or vouched for by one. Yours would too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detrás de cada respuesta de aquí hay una persona real: verificada o avalada por una. La tuya también la tendría."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen vastauksen takana on oikea ihminen – vahvistettu tai vahvistetun takaama. Niin olisi sinunkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réponse ici a une vraie personne derrière elle — vérifiée, ou garantie par l’une d’elles. La vôtre aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאחורי כל תגובה כאן עומד אדם אמיתי — מאומת, או כזה שאדם מאומת ערב לו. כך גם בשלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ हर जवाब के पीछे एक असली व्यक्ति है — खुद सत्यापित, या किसी सत्यापित व्यक्ति द्वारा गारंटीशुदा। आपका भी होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iza svakog odgovora ovdje stoji stvarna osoba — potvrđena ili ona za koju je netko jamčio. Tako bi bilo i s tvojim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden itteni válasz mögött valódi ember áll – hitelesített, vagy olyan, akiért egy hitelesített ember kezeskedett. A tiéd mögött is így lenne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap balasan di sini punya orang sungguhan di baliknya — terverifikasi, atau dijamin oleh orang yang terverifikasi. Balasanmu juga begitu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni risposta qui ha dietro una persona reale: verificata, o garantita da una persona verificata. Anche la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでの返信はすべて、実在の人によるものです。本人が認証したか、認証済みの人が保証しています。あなたの返信も同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 모든 답글 뒤에는 실제 사람이 있어요. 직접 인증했거나, 인증된 사람이 보증했어요. 내 답글도 마찬가지예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടത്തെ ഓരോ മറുപടിക്കും പിന്നിൽ ഒരു യഥാർഥ വ്യക്തിയുണ്ട് — പരിശോധിച്ചതോ, ഒരാൾ ഉറപ്പുനൽകിയതോ. നിങ്ങളുടേതും അങ്ങനെയാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap balasan di sini ada orang sebenar di belakangnya — yang disahkan, atau dijamin oleh seseorang yang disahkan. Balasan anda juga begitu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert svar her har et ekte menneske bak seg, verifisert eller garantert for av et. Det vil ditt også ha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achter elke reactie hier zit een echt persoon: geverifieerd, of gegarandeerd door iemand die dat is. Die van jou ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdą odpowiedzią stoi tu prawdziwa osoba — zweryfikowana lub poręczona przez taką. Za Twoją też."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda resposta aqui tem uma pessoa real por trás, verificada ou avalizada por alguém verificado. A sua também teria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada resposta aqui tem uma pessoa real por trás — verificada, ou avalizada por uma. A sua também teria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare răspuns de aici are în spate o persoană reală — verificată sau garantată de una. Și al tău ar avea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За каждым ответом здесь стоит реальный человек — проверенный или тот, за кого поручился проверенный. И за вашим тоже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za každou odpoveďou tu stojí skutočný človek — overený alebo s ručiteľom. Aj za tvojou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje svar här har en verklig person bakom sig – verifierad, eller intygad av en sådan. Det skulle ditt också ha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்குள்ள ஒவ்வொரு பதிலுக்குப் பின்னும் உண்மையான ஒருவர் இருக்கிறார் — சரிபார்க்கப்பட்டவர் அல்லது அவரால் உத்தரவாதம் அளிக்கப்பட்டவர். உங்களுடையதும் அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడి ప్రతి రిప్లై వెనుక నిజమైన వ్యక్తి ఉన్నారు — ధృవీకరించబడినవారు, లేదా వారిలో ఒకరు హామీ ఇచ్చినవారు. మీదీ అలాగే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคำตอบที่นี่มีคนจริงอยู่เบื้องหลัง ที่ยืนยันตัวตนแล้วหรือมีคนยืนยันให้ ของคุณก็เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki her yanıtın arkasında gerçek bir kişi var; ya doğrulanmış ya da doğrulanmış biri ona kefil olmuş. Sizinki de öyle olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За кожною відповіддю тут стоїть реальна людина — верифікована або така, за яку поручилася верифікована людина. Ваша теж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں ہر جواب کے پیچھے ایک حقیقی شخص ہے — تصدیق شدہ، یا کسی تصدیق شدہ شخص کا ضمانت یافتہ۔ آپ کا بھی ایسا ہی ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi câu trả lời ở đây đều có một người thật đứng sau — đã xác minh, hoặc được một người như vậy bảo chứng. Câu trả lời của bạn cũng vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的每条回复背后都是真人，他们或已通过验证，或由已验证的人担保。你也会是其中之一。"
          }
        },
