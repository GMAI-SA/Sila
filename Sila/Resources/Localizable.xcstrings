    "feed.order.ranked.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحدث أولًا، مع رفع مواضيعك والمنشورات التي يرد عليها الناس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুনটি আগে, আপনার বিষয় ও যেসব পোস্টে মানুষ উত্তর দিচ্ছে সেগুলোর জন্য এগিয়ে আনা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De la més nova a la més antiga, amb prioritat per als teus temes i per a les publicacions que la gent està responent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější první, posílené podle tvých témat a příspěvků, na které lidé odpovídají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyeste først, løftet for dine emner og for opslag, folk svarer på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuesten zuerst, angehoben für deine Themen und für Beiträge, auf die geantwortet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι νεότερες πρώτα, με προώθηση για τα θέματά σου και για αναρτήσεις στις οποίες απαντούν άλλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest first, lifted for your subjects and for posts people are replying to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las más recientes primero, realzadas por tus temas y por las publicaciones que la gente está respondiendo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusimmat ensin, aiheidesi ja vastauksia keräävien julkaisujen mukaan nostettuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus récents d’abord, remontés pour vos sujets et pour les posts auxquels on répond."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהחדש לישן, מועלה לפי הנושאים שלך ולפי פוסטים שאנשים מגיבים להם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे नई पहले, आपके विषयों और जिन पोस्ट पर लोग जवाब दे रहे हैं उनके लिए ऊपर उठी हुई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od najnovijih, podignuto za tvoje teme i za objave na koje ljudi odgovaraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legújabb elöl, a témáid és a válaszokat kapó bejegyzések szerint előrébb hozva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbaru dulu, diangkat sesuai topikmu dan untuk postingan yang sedang dibalas orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal più recente, con più peso ai tuoi argomenti e ai post a cui le persone rispondono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい順を基本に、あなたの分野と返信が付いている投稿が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신순이며, 내 주제와 사람들이 답글을 다는 게시물이 위로 올라와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയത് ആദ്യം, നിങ്ങളുടെ വിഷയങ്ങൾക്കും ആളുകൾ മറുപടി നൽകുന്ന പോസ്റ്റുകൾക്കും മുൻഗണന."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbaharu dahulu, dinaikkan untuk subjek anda dan untuk siaran yang sedang dibalas orang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyeste først, løftet for temaene dine og for innlegg folk svarer på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwste eerst, omhoog gehaald voor jouw onderwerpen en voor berichten waarop mensen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od najnowszych, z podbiciem dla Twoich tematów i wpisów, na które ludzie odpowiadają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais recentes primeiro, com destaque para seus assuntos e para posts que as pessoas estão respondendo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Das mais recentes para as mais antigas, realçadas pelos seus assuntos e pelas publicações a que as pessoas estão a responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele mai noi primele, ridicate pentru subiectele tale și pentru postările la care răspund oamenii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала новые, с приоритетом для ваших тем и для постов, на которые отвечают."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovšie ako prvé, zvýraznené podľa tvojich tém a príspevkov, na ktoré ľudia odpovedajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyast först, med lyft för dina ämnen och för inlägg som folk svarar på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதியவை முதலில், உங்கள் தலைப்புகளுக்கும் மக்கள் பதிலளிக்கும் இடுகைகளுக்கும் முன்னுரிமையுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్తవి ముందు, మీ అంశాలకు, ప్రజలు రిప్లై ఇస్తున్న పోస్ట్‌లకు పైకి తీసుకురాబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหม่สุดก่อน โดยดันเรื่องที่คุณสนใจและโพสต์ที่คนกำลังตอบกลับขึ้นมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeniden eskiye; konularınız ve insanların yanıtladığı gönderiler öne çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від найновіших, з підняттям за вашими темами та за дописами, на які відповідають."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی سب سے پہلے، آپ کے موضوعات اور جن پوسٹس کا لوگ جواب دے رہے ہیں ان کے لیے اوپر اٹھائی ہوئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới nhất trước, đẩy lên theo chủ đề của bạn và theo các bài đang được trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新优先，并根据你的主题和有人正在回复的帖子提前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新優先，並依你的主題和有人回覆的貼文調整。"
          }
        }
      }
    },
