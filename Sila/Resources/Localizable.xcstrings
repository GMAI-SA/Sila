    "verification.rejected.message": {
      "comment": "Body when Nafath declined, above the server's reason if any.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض نفاذ هذا الطلب. يمكنك البدء من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath এই অনুরোধ প্রত্যাখ্যান করেছে। আপনি আবার শুরু করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ha rebutjat aquesta sol·licitud. Pots tornar a començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath tuto žádost odmítl. Můžeš začít znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath afviste denne anmodning. Du kan starte forfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath hat diese Anfrage abgelehnt. Du kannst neu beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Nafath απέρριψε αυτό το αίτημα. Μπορείς να ξεκινήσεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath declined this request. You can start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath rechazó esta solicitud. Puedes empezar de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath hylkäsi tämän pyynnön. Voit aloittaa alusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath a refusé cette demande. Vous pouvez recommencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath דחתה את הבקשה הזו. אפשר להתחיל שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ने इस अनुरोध को अस्वीकार कर दिया। आप फिर शुरू कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath je odbio ovaj zahtjev. Možeš početi ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nafath elutasította ezt a kérést. Újraindíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath menolak permintaan ini. Kamu bisa memulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ha rifiutato questa richiesta. Puoi ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafathがこのリクエストを承認しませんでした。最初からやり直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath가 이 요청을 거부했어요. 처음부터 다시 시작할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ഈ അഭ്യർഥന നിരസിച്ചു. നിങ്ങൾക്ക് വീണ്ടും തുടങ്ങാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath menolak permintaan ini. Anda boleh bermula semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath avslo denne forespørselen. Du kan starte på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath heeft dit verzoek geweigerd. Je kunt opnieuw beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath odrzucił tę prośbę. Możesz zacząć od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath recusou este pedido. Você pode começar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath recusou este pedido. Pode recomeçar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath a respins această cerere. Poți începe din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath отклонил этот запрос. Вы можете начать заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath túto požiadavku zamietol. Môžeš začať znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath avslog den här begäran. Du kan börja om."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath இந்தக் கோரிக்கையை நிராகரித்தது. மீண்டும் தொடங்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ఈ అభ్యర్థనను తిరస్కరించింది. మీరు మళ్లీ ప్రారంభించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ปฏิเสธคำขอนี้ คุณเริ่มใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath bu isteği reddetti. Yeniden başlayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath відхилив цей запит. Ви можете почати знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath نے یہ درخواست مسترد کر دی۔ آپ دوبارہ شروع کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath đã từ chối yêu cầu này. Bạn có thể bắt đầu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 拒绝了此请求。你可以重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 拒絕了此請求。你可以重新開始。"
          }
        }
      }
    },
