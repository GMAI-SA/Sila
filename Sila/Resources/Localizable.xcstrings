            "state": "translated",
            "value": "Тепер ви входите з %@. Стара адреса більше не працює."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب آپ %@ سے سائن اِن کرتے ہیں۔ آپ کا پرانا پتا اب کام نہیں کرتا۔"
          }
        },
        "vi": {
