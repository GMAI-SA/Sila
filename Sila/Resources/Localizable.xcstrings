    "profile.language.sheet.message": {
      "comment": "Explainer at the top of the picker sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق فورًا، بما في ذلك اتجاه التصميم. خيار النظام يتبع لغة جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেআউটের দিকসহ সঙ্গে সঙ্গে প্রয়োগ হয়। সিস্টেম মানে আপনার ডিভাইসের ভাষা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'aplica immediatament, inclosa la direcció del disseny. Sistema segueix l'idioma del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije se okamžitě, včetně směru rozvržení. Systémový se řídí jazykem tvého zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træder i kraft med det samme, også retningen på layoutet. System følger din enheds sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort angewendet, auch die Schreibrichtung. „System“ folgt der Sprache deines Geräts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμόζεται αμέσως, συμπεριλαμβανομένης της κατεύθυνσης διάταξης. Το Σύστημα ακολουθεί τη γλώσσα της συσκευής σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies immediately, including the layout direction. System follows your device's language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al instante, incluida la dirección del diseño. «Sistema» sigue el idioma de tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otetaan käyttöön heti, myös tekstin suunta. Järjestelmä seuraa laitteesi kieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique immédiatement, y compris le sens de lecture. Système suit la langue de votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חל מיד, כולל כיוון הפריסה. ״מערכת״ עוקבת אחרי שפת המכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत लागू होता है, लेआउट की दिशा सहित। \"सिस्टम\" आपके डिवाइस की भाषा के अनुसार चलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje se odmah, uključujući smjer rasporeda. Sustav prati jezik tvog uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnal érvénybe lép, az írásirányt is beleértve. A Rendszer az eszközöd nyelvét követi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku seketika, termasuk arah tata letak. Sistem mengikuti bahasa perangkatmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica subito, compresa la direzione del layout. Sistema segue la lingua del tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトの向きを含め、すぐに反映されます。「システム」はデバイスの言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃 방향을 포함해 즉시 적용돼요. 시스템은 기기의 언어를 따라요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലേഔട്ട് ദിശ ഉൾപ്പെടെ ഉടൻ പ്രാബല്യത്തിൽ വരും. സിസ്റ്റം എന്നത് നിങ്ങളുടെ ഉപകരണത്തിന്റെ ഭാഷ പിന്തുടരുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkuat kuasa serta-merta, termasuk arah susun atur. Sistem mengikut bahasa peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder umiddelbart, også leseretningen. System følger språket på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt direct toegepast, inclusief de schrijfrichting. Systeem volgt de taal van je apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana działa natychmiast, łącznie z kierunkiem układu. Opcja Systemowy podąża za językiem urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale imediatamente, inclusive a direção do layout. Sistema segue o idioma do seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se de imediato, incluindo o sentido do texto. Sistema segue o idioma do seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică imediat, inclusiv direcția de afișare. Sistem urmează limba dispozitivului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется сразу, включая направление текста. «Системный» следует языку вашего устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije sa okamžite, vrátane smeru rozloženia. Systémový jazyk sleduje jazyk tvojho zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar gälla direkt, inklusive layoutriktningen. System följer enhetens språk."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தளவமைப்புத் திசை உட்பட உடனே பயன்படுத்தப்படும். சிஸ்டம் என்பது உங்கள் சாதனத்தின் மொழியைப் பின்பற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లేఅవుట్ దిశతో సహా వెంటనే వర్తిస్తుంది. సిస్టమ్ మీ పరికరం భాషను అనుసరిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลทันที รวมถึงทิศทางการจัดวาง ระบบจะใช้ภาษาของอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yön düzeni dahil hemen uygulanır. Sistem, cihazınızın dilini izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується одразу, зокрема й напрямок тексту. «Системна» відповідає мові вашого пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوراً لاگو ہوتا ہے، بشمول تحریر کی سمت۔ سسٹم آپ کی ڈیوائس کی زبان کے مطابق چلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng ngay lập tức, kể cả hướng bố cục. Hệ thống theo ngôn ngữ của thiết bị bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，包括布局方向。“跟随系统”将使用你设备的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，包括版面方向。「系統」會跟隨你裝置的語言。"
          }
        }
      }
    },
