    "vouch.error.detailsRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمه الكامل وجنسيته وتاريخ ميلاده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাঁর পুরো নাম, জাতীয়তা ও জন্ম তারিখ দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica'n el nom complet, la nacionalitat i la data de naixement."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej jejich celé jméno, státní příslušnost a datum narození."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv vedkommendes fulde navn, nationalitet og fødselsdato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den vollständigen Namen, die Staatsangehörigkeit und das Geburtsdatum an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε το πλήρες όνομα, την υπηκοότητα και την ημερομηνία γέννησής του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give their full name, nationality and date of birth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica su nombre completo, nacionalidad y fecha de nacimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna heidän koko nimensä, kansalaisuutensa ja syntymäaikansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez son nom complet, sa nationalité et sa date de naissance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסור את שמם המלא, האזרחות ותאריך הלידה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनका पूरा नाम, राष्ट्रीयता और जन्म तिथि दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši njihovo puno ime, državljanstvo i datum rođenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a teljes nevét, állampolgárságát és születési dátumát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan nama lengkap, kewarganegaraan, dan tanggal lahir mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica nome completo, nazionalità e data di nascita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の氏名、国籍、生年月日を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방의 전체 이름, 국적, 생년월일을 입력하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരുടെ മുഴുവൻ പേര്, ദേശീയത, ജനനത്തീയതി എന്നിവ നൽകുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan nama penuh, kewarganegaraan dan tarikh lahir mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi fullt navn, nasjonalitet og fødselsdato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef hun volledige naam, nationaliteit en geboortedatum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj jej pełne imię i nazwisko, obywatelstwo i datę urodzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o nome completo, a nacionalidade e a data de nascimento da pessoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique o nome completo, a nacionalidade e a data de nascimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu numele complet, cetățenia și data nașterii persoanei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите полное имя, гражданство и дату рождения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uveď jej celé meno, národnosť a dátum narodenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange deras fullständiga namn, nationalitet och födelsedatum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் முழுப் பெயர், நாட்டினம், பிறந்த தேதியைக் கொடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారి పూర్తి పేరు, జాతీయత మరియు పుట్టిన తేదీ ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุชื่อเต็ม สัญชาติ และวันเกิดของเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam adını, uyruğunu ve doğum tarihini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть повне ім’я, громадянство й дату народження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کا پورا نام، قومیت اور تاریخ پیدائش دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập họ tên đầy đủ, quốc tịch và ngày sinh của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写对方的全名、国籍和出生日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫對方的全名、國籍和出生日期。"
          }
        }
      }
    },
