    "safety.report.intro": {
      "comment": "The line at the top of the reason picker. Says a human reads every report and that the choice decides who reads it first.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأقرب. كل بلاغ يراجعه إنسان، وما تختاره يحدد من يقرؤه أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে কাছেরটি বেছে নিন। একজন মানুষ প্রতিটি রিপোর্ট পর্যালোচনা করেন, আর আপনার বাছাই ঠিক করে কে এটি প্রথম পড়বেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria la opció més propera. Una persona revisa cada denúncia, i el que triïs decideix qui la llegeix primer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber nejbližší možnost. Každé nahlášení posuzuje člověk a to, co zvolíš, určuje, kdo ho přečte jako první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det nærmeste match. Et menneske gennemgår hver anmeldelse, og det, du vælger, afgør, hvem der læser den først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die passendste Option. Ein Mensch prüft jede Meldung, und deine Wahl entscheidet, wer sie zuerst liest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε την πιο κοντινή επιλογή. Κάθε αναφορά εξετάζεται από άνθρωπο και αυτό που επιλέγεις καθορίζει ποιος τη διαβάζει πρώτος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the closest match. A human reviews every report, and what you choose decides who reads it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la opción más cercana. Una persona revisa cada denuncia, y lo que elijas decide quién la lee primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lähin vastine. Ihminen tarkastaa jokaisen ilmiannon, ja valintasi päättää, kuka sen lukee ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le motif le plus proche. Une personne examine chaque signalement, et votre choix détermine qui le lit en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את ההתאמה הקרובה ביותר. אדם בודק כל דיווח, ומה שתבחר קובע מי קורא אותו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे करीबी विकल्प चुनें। हर रिपोर्ट को एक इंसान देखता है, और आपका चुनाव तय करता है कि उसे पहले कौन पढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi najbliže podudaranje. Čovjek pregledava svaku prijavu, a ono što odabereš određuje tko je čita prvi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd a legközelebbit. Minden jelentést ember néz át, és a választásod dönti el, ki olvassa el először."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih yang paling mendekati. Manusia meninjau setiap laporan, dan pilihanmu menentukan siapa yang membacanya lebih dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la corrispondenza più vicina. Una persona esamina ogni segnalazione, e ciò che scegli decide chi la legge per primo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も近いものを選んでください。すべての報告は人が確認し、選んだ内容によって最初に読む人が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가까운 항목을 선택하세요. 모든 신고는 사람이 검토하며, 선택에 따라 누가 먼저 읽을지 결정돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും അടുത്തത് തിരഞ്ഞെടുക്കുക. ഓരോ റിപ്പോർട്ടും ഒരു മനുഷ്യൻ പരിശോധിക്കും, നിങ്ങൾ തിരഞ്ഞെടുക്കുന്നത് ആദ്യം ആര് വായിക്കണമെന്ന് തീരുമാനിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih yang paling hampir. Seorang manusia menyemak setiap laporan, dan pilihan anda menentukan siapa yang membacanya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg det som passer best. Et menneske vurderer hver rapport, og det du velger, avgjør hvem som leser den først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de beste overeenkomst. Een mens beoordeelt elke melding, en wat je kiest bepaalt wie hem als eerste leest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz najbliższe dopasowanie. Każde zgłoszenie sprawdza człowiek, a Twój wybór decyduje, kto przeczyta je najpierw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a opção mais próxima. Uma pessoa analisa cada denúncia, e o que você escolher define quem a lê primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a opção mais próxima. Uma pessoa revê todas as denúncias, e o que escolher decide quem a lê primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cea mai apropiată variantă. Fiecare raportare este analizată de un om, iar alegerea ta decide cine o citește primul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите наиболее подходящий вариант. Каждую жалобу рассматривает человек, а ваш выбор определяет, кто прочтёт её первым."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber najbližšiu možnosť. Každé nahlásenie posudzuje človek a tvoj výber rozhoduje, kto ho prečíta ako prvý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det som passar bäst. En människa granskar varje rapport, och ditt val avgör vem som läser den först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிகவும் நெருக்கமானதைத் தேர்ந்தெடுங்கள். ஒரு மனிதர் ஒவ்வொரு புகாரையும் மதிப்பாய்வு செய்கிறார், நீங்கள் தேர்ந்தெடுப்பது யார் முதலில் படிப்பார் என்பதைத் தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అత్యంత దగ్గరగా సరిపోయేదాన్ని ఎంచుకోండి. ప్రతి రిపోర్ట్‌ను మనిషి సమీక్షిస్తారు, మీరు ఎంచుకున్నది దాన్ని ముందు ఎవరు చదవాలో నిర్ణయిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกที่ใกล้เคียงที่สุด มีคนตรวจสอบทุกรายงาน และสิ่งที่คุณเลือกกำหนดว่าใครอ่านก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yakın eşleşmeyi seçin. Her şikayeti bir insan inceler ve seçiminiz, onu önce kimin okuyacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть найближчий варіант. Кожну скаргу розглядає людина, і ваш вибір визначає, хто прочитає її першим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے قریب والی وجہ چنیں۔ ہر رپورٹ کو ایک انسان دیکھتا ہے، اور آپ کا انتخاب طے کرتا ہے کہ اسے پہلے کون پڑھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mục gần đúng nhất. Một người thật xem xét mọi báo cáo, và lựa chọn của bạn quyết định ai đọc đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择最接近的一项。每份举报都会由真人审核，你的选择决定谁最先阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇最接近的選項。每項檢舉都由真人審核，你的選擇會決定誰先閱讀。"
          }
        }
      }
    },
    "safety.report.isSilent": {
      "comment": "Said next to the submit button, every time.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ سري. ولا يُعرض على الحساب الذي تبلّغ عنه من أبلغ عنه أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্ট গোপনীয়। যে অ্যাকাউন্ট রিপোর্ট করেন তাকে কখনও দেখানো হয় না কে রিপোর্ট করেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Denunciar és confidencial. Al compte que denuncies mai se li mostra qui l'ha denunciat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlášení je důvěrné. Nahlášenému účtu se nikdy neukáže, kdo ho nahlásil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser er fortrolige. Den konto, du anmelder, får aldrig vist, hvem der anmeldte den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen sind vertraulich. Dem gemeldeten Konto wird nie gezeigt, wer es gemeldet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναφορά είναι εμπιστευτική. Στον λογαριασμό που αναφέρεις δεν εμφανίζεται ποτέ ποιος τον ανέφερε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporting is confidential. The account you report is never shown who reported them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La denuncia es confidencial. A la cuenta que denuncias nunca se le muestra quién la denunció."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmiantaminen on luottamuksellista. Ilmiantamallesi tilille ei koskaan näytetä, kuka ilmiantoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signalement est confidentiel. Le compte signalé ne voit jamais qui l’a signalé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווח הוא חסוי. החשבון שעליו דיווחת אף פעם לא רואה מי דיווח עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्टिंग गोपनीय है। आप जिस अकाउंट को रिपोर्ट करते हैं उसे कभी नहीं दिखाया जाता कि किसने रिपोर्ट किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava je povjerljiva. Računu koji prijaviš nikada se ne prikazuje tko ga je prijavio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentés bizalmas. A jelentett fiók soha nem látja, ki jelentette."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaporan bersifat rahasia. Akun yang kamu laporkan tidak pernah diperlihatkan siapa yang melaporkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La segnalazione è riservata. All'account che segnali non viene mai mostrato chi l'ha segnalato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告は非公開です。報告されたアカウントに、誰が報告したかが表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고는 비밀이 보장돼요. 신고당한 계정에는 누가 신고했는지 절대 표시되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിപ്പോർട്ടിംഗ് രഹസ്യമാണ്. ആരാണ് റിപ്പോർട്ട് ചെയ്തതെന്ന് റിപ്പോർട്ട് ചെയ്യപ്പെട്ട അക്കൗണ്ടിനെ ഒരിക്കലും കാണിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaporan adalah sulit. Akaun yang anda laporkan tidak pernah ditunjukkan siapa yang melaporkan mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapportering er konfidensiell. Kontoen du rapporterer, får aldri se hvem som rapporterte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden is vertrouwelijk. Het account dat je meldt krijgt nooit te zien wie hen heeft gemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenia są poufne. Zgłaszane konto nigdy nie widzi, kto je zgłosił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A denúncia é confidencial. A conta denunciada nunca vê quem a denunciou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A denúncia é confidencial. A conta denunciada nunca vê quem a denunciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportarea este confidențială. Contului raportat nu i se arată niciodată cine l-a raportat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба конфиденциальна. Аккаунту, на который вы жалуетесь, никогда не показывают, кто пожаловался."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásenie je dôverné. Nahlásenému účtu sa nikdy nezobrazí, kto ho nahlásil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapportering är konfidentiell. Kontot du rapporterar får aldrig se vem som rapporterade det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகார் ரகசியமானது. நீங்கள் புகாரளிக்கும் கணக்குக்கு யார் புகாரளித்தார் என்று ஒருபோதும் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిపోర్టింగ్ గోప్యమైనది. మీరు రిపోర్ట్ చేసిన ఖాతాకు ఎవరు రిపోర్ట్ చేశారో ఎప్పుడూ చూపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรายงานเป็นความลับ บัญชีที่คุณรายงานจะไม่เห็นว่าใครรายงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şikayet gizlidir. Şikayet ettiğiniz hesaba kimin şikayet ettiği asla gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скарга конфіденційна. Обліковий запис, на який ви скаржитеся, ніколи не бачить, хто це зробив."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ رازدارانہ ہے۔ جس اکاؤنٹ کی آپ رپورٹ کریں اسے کبھی نہیں دکھایا جاتا کہ کس نے رپورٹ کی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo là bí mật. Tài khoản bạn báo cáo không bao giờ được cho biết ai đã báo cáo họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报是保密的。被举报的账户永远不会看到是谁举报了他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢舉是保密的。被檢舉的帳號絕不會得知是誰檢舉的。"
          }
        }
      }
    },
