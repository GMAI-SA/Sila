    "account.profile.hideVerifiedName.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر في ملفك اسمك المعروض ومعرّفك فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইলে শুধু প্রদর্শন নাম ও হ্যান্ডেল দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al teu perfil només es mostraran el nom visible i l'identificador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvém profilu se zobrazí jen zobrazované jméno a handle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun dit visningsnavn og handle vises på din profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Profil werden nur dein Anzeigename und dein Handle angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο προφίλ σου θα εμφανίζονται μόνο το εμφανιζόμενο όνομα και το handle σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your display name and handle will show on your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu perfil solo se mostrarán tu nombre visible y tu identificador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilissasi näkyvät vain näyttönimesi ja käyttäjätunnuksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls votre nom affiché et votre identifiant apparaîtront sur votre profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק שם התצוגה ושם המשתמש שלך יוצגו בפרופיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रोफ़ाइल पर केवल आपका डिस्प्ले नाम और हैंडल दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvom profilu prikazat će se samo prikazano ime i handle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A profilodon csak a megjelenített neved és az @neved látszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama tampilan dan handle-mu yang akan tampil di profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo profilo verranno mostrati solo il nome visualizzato e l'handle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールには表示名とハンドルだけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필에는 표시 이름과 핸들만 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രൊഫൈലിൽ പ്രദർശന നാമവും ഹാൻഡിലും മാത്രം കാണിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama paparan dan nama pengendali anda akan dipaparkan pada profil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare visningsnavnet og brukernavnet ditt vises på profilen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je profiel worden alleen je weergavenaam en handle getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Twoim profilu będą widoczne tylko nazwa wyświetlana i uchwyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas seu nome de exibição e seu @usuário aparecerão no perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o seu nome de apresentação e identificador serão mostrados no seu perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar numele afișat și handle-ul vor apărea în profilul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В профиле будут видны только отображаемое имя и @имя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvojom profile sa zobrazí iba zobrazované meno a používateľské meno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast ditt visningsnamn och användarnamn visas på din profil."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் காட்சிப் பெயரும் ஹேண்டிலும் மட்டுமே சுயவிவரத்தில் காட்டப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రొఫైల్‌లో మీ ప్రదర్శన పేరు, హ్యాండిల్ మాత్రమే కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ของคุณจะแสดงเฉพาะชื่อที่แสดงและแฮนเดิล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilinizde yalnızca görünen adınız ve kullanıcı adınız gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вашому профілі показуватимуться лише відображуване ім’я та @ім’я."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پروفائل پر صرف ڈسپلے نام اور ہینڈل نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ của bạn sẽ chỉ hiển thị tên hiển thị và tên người dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人主页上只会显示显示名称和用户名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的個人檔案只會顯示顯示名稱和代號。"
          }
        }
      }
    },
