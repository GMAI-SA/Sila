    "guidelines.error.changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الإرشادات أثناء قراءتك — اقرأها مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পড়ার সময় নির্দেশিকা বদলে গেছে — আবার পড়ুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les normes han canviat mentre les llegies; torna-les a llegir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady se při čtení změnily – přečti si je prosím znovu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjerne ændrede sig, mens du læste – læs dem venligst igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Richtlinien haben sich geändert, während du gelesen hast – bitte lies sie noch einmal"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι οδηγίες άλλαξαν ενώ διάβαζες — διάβασέ τες ξανά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guidelines changed while you were reading — please read them again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las normas cambiaron mientras las leías; vuelve a leerlas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjeet muuttuivat lukiessasi – lue ne uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ont changé pendant votre lecture — veuillez les relire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכללים השתנו בזמן שקראת — קרא אותם שוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पढ़ते समय दिशानिर्देश बदल गए — कृपया उन्हें फिर से पढ़ें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smjernice su se promijenile dok si čitao/la — pročitaj ih ponovno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az irányelvek megváltoztak, amíg olvastad – olvasd el őket újra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedoman berubah saat kamu membacanya — silakan baca lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le linee guida sono cambiate mentre le leggevi: leggile di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んでいる間にガイドラインが変更されました。もう一度お読みください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽는 동안 가이드라인이 변경되었어요. 다시 읽어 주세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വായിക്കുന്നതിനിടെ മാർഗനിർദേശങ്ങൾ മാറി — ദയവായി വീണ്ടും വായിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Garis panduan berubah semasa anda membaca — sila baca semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjene ble endret mens du leste. Les dem på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De richtlijnen zijn gewijzigd terwijl je las. Lees ze opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasady zmieniły się, gdy je czytałeś — przeczytaj je ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As diretrizes mudaram enquanto você lia. Leia-as novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As diretrizes mudaram enquanto lia — leia-as novamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulile s-au schimbat cât timp le citeai — citește-le din nou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила изменились, пока вы читали, — прочитайте их ещё раз"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady sa zmenili, kým si ich čítal — prečítaj si ich prosím znova"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Riktlinjerna ändrades medan du läste – läs dem igen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் படிக்கும்போது வழிகாட்டுதல்கள் மாறின — மீண்டும் படியுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చదువుతుండగా మార్గదర్శకాలు మారాయి — దయచేసి మళ్లీ చదవండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวปฏิบัติเปลี่ยนไประหว่างที่คุณอ่าน กรุณาอ่านอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okurken kurallar değişti; lütfen yeniden okuyun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила змінилися, поки ви читали — прочитайте їх ще раз"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پڑھتے ہوئے رہنما اصول بدل گئے — براہ کرم انہیں دوبارہ پڑھیں"
