    "notifications.kind.reaction.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يجد أحد منشورك مفيدًا أو ملهمًا أو مضحكًا أو سؤالًا رائعًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার পোস্টকে সহায়ক, অন্তর্দৃষ্টিপূর্ণ, মজার বা দারুণ প্রশ্ন মনে করলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú troba la teva publicació útil, perspicaç, divertida o una gran pregunta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někdo považuje tvůj příspěvek za užitečný, nápaditý, vtipný nebo za skvělou otázku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen finder dit opslag hjælpsomt, indsigtsfuldt, sjovt eller et godt spørgsmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand deinen Beitrag hilfreich, aufschlussreich oder lustig findet oder eine tolle Frage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος βρίσκει την ανάρτησή σου χρήσιμη, διορατική, αστεία ή εξαιρετική ερώτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone finds your post helpful, insightful, funny or a great question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando a alguien le parece tu publicación útil, interesante, divertida o una gran pregunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku pitää julkaisuasi hyödyllisenä, oivaltavana, hauskana tai hyvänä kysymyksenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un trouve votre post utile, pertinent, drôle ou une excellente question."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו מוצא את הפוסט שלך מועיל, מעמיק, מצחיק או שאלה מצוינת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपकी पोस्ट को मददगार, समझदारी भरी, मज़ेदार या बढ़िया सवाल पाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad netko tvoju objavu smatra korisnom, pronicljivom, smiješnom ili sjajnim pitanjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor valaki hasznosnak, elgondolkodtatónak, viccesnek vagy remek kérdésnek találja a bejegyzésedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat seseorang menganggap postinganmu membantu, berwawasan, lucu, atau pertanyaan bagus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno trova il tuo post utile, acuto, divertente o una gran bella domanda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたの投稿を、参考になった、洞察に富む、面白い、すてきな質問だと感じたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내 게시물을 도움이 된다, 통찰력 있다, 재미있다 또는 훌륭한 질문이라고 느꼈을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും നിങ്ങളുടെ പോസ്റ്റ് സഹായകരമോ ഉൾക്കാഴ്ചയുള്ളതോ രസകരമോ മികച്ച ചോദ്യമോ ആയി കാണുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seseorang mendapati siaran anda membantu, bernas, lucu atau soalan yang hebat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen synes innlegget ditt er nyttig, innsiktsfullt, morsomt eller et godt spørsmål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer iemand je bericht nuttig, inzichtelijk of grappig vindt, of een goede vraag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś uzna Twój wpis za pomocny, wnikliwy, śmieszny lub świetne pytanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém acha seu post útil, perspicaz, engraçado ou uma ótima pergunta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém acha a sua publicação útil, perspicaz, engraçada ou uma ótima pergunta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când cineva găsește postarea ta utilă, pătrunzătoare, amuzantă sau o întrebare bună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кто-то находит ваш пост полезным, глубоким, смешным или отличным вопросом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekto považuje tvoj príspevok za užitočný, prenikavý, vtipný alebo za skvelú otázku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon tycker att ditt inlägg är hjälpsamt, insiktsfullt, roligt eller en bra fråga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது உங்கள் இடுகையைப் பயனுள்ளது, நுண்ணறிவுள்ளது, நகைச்சுவையானது அல்லது சிறந்த கேள்வி எனக் கருதும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా మీ పోస్ట్ ఉపయోగకరంగా, అంతర్దృష్టితో, హాస్యంగా ఉందని లేదా గొప్ప ప్రశ్న అని భావించినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนเห็นว่าโพสต์ของคุณมีประโยชน์ มีมุมมอง ตลก หรือเป็นคำถามที่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri gönderinizi faydalı, anlayışlı, komik veya harika bir soru bulduğunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли комусь здався ваш допис корисним, влучним, смішним або чудовим запитанням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی آپ کی پوسٹ کو مددگار، بصیرت بھری، مزیدار یا بہترین سوال سمجھے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó thấy bài đăng của bạn hữu ích, sâu sắc, hài hước hoặc là một câu hỏi hay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人认为你的帖子有帮助、有见地、有趣，或是个好问题时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人覺得你的貼文有幫助、有見地、好笑，或是個好問題時。"
          }
        }
      }
    },
