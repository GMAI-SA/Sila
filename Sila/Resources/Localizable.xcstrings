    "search.tab.people.a11yHint": {
      "comment": "VoiceOver hint for the people results tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الحسابات التي يطابق معرّفها أو اسمها بحثك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাদের হ্যান্ডেল বা নাম আপনার সার্চের সাথে মেলে সেই অ্যাকাউন্ট দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els comptes l'identificador o el nom dels quals coincideix amb la teva cerca"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, jejichž handle nebo jméno odpovídá hledání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser konti, hvis handle eller navn matcher din søgning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Konten, deren Handle oder Name zu deiner Suche passt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει λογαριασμούς των οποίων το handle ή το όνομα ταιριάζει με την αναζήτησή σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows accounts whose handle or name matches your search"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las cuentas cuyo identificador o nombre coincide con tu búsqueda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää tilit, joiden käyttäjätunnus tai nimi täsmää hakuun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les comptes dont l’identifiant ou le nom correspond à votre recherche"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג חשבונות ששם המשתמש או השם שלהם תואם לחיפוש שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन अकाउंट को दिखाता है जिनका हैंडल या नाम आपकी खोज से मेल खाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje račune čiji se handle ili ime podudara s tvojom pretragom"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azokat a fiókokat mutatja, amelyek @neve vagy neve egyezik a kereséseddel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan akun yang handle atau namanya cocok dengan pencarianmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli account il cui handle o nome corrisponde alla ricerca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルまたは名前が検索に一致するアカウントを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들이나 이름이 검색어와 일치하는 계정을 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹാൻഡിലോ പേരോ നിങ്ങളുടെ തിരയലുമായി ഒത്തുപോകുന്ന അക്കൗണ്ടുകൾ കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan akaun yang nama pengendali atau namanya sepadan dengan carian anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kontoer hvis brukernavn eller navn samsvarer med søket ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont accounts waarvan de handle of naam overeenkomt met je zoekopdracht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje konta, których uchwyt lub nazwa pasuje do wyszukiwania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra contas cujo @usuário ou nome corresponde à sua busca"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as contas cujo identificador ou nome corresponde à pesquisa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată conturile al căror handle sau nume se potrivește căutării"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает аккаунты, имя которых совпадает с запросом"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, ktorých používateľské meno alebo meno zodpovedá hľadaniu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar konton vars användarnamn eller namn matchar din sökning"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தேடலுடன் பயனர்பெயரோ பெயரோ பொருந்தும் கணக்குகளைக் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హ్యాండిల్ లేదా పేరు మీ శోధనకు సరిపోలే ఖాతాలను చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบัญชีที่แฮนเดิลหรือชื่อตรงกับคำค้นหาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı veya adı aramanızla eşleşen hesapları gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує облікові записи, чиє @ім’я чи ім’я збігається з вашим пошуком"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ اکاؤنٹس دکھاتا ہے جن کا ہینڈل یا نام آپ کی تلاش سے ملتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các tài khoản có tên người dùng hoặc tên khớp với tìm kiếm của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示用户名或名称与你的搜索匹配的账户"
          }
        },
        "zh-Hant": {
