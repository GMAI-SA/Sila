            "state": "translated",
            "value": "Aquestes dades no coincideixen amb les que va introduir qui va enviar l'enllaç."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto údaje se neshodují s tím, co zadala osoba, která poslala odkaz."
