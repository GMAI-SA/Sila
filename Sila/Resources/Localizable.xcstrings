        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas da sua ligação"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de la conexiunea ta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток с вашего подключения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov z tvojho pripojenia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många försök från din anslutning"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இணைப்பிலிருந்து முயற்சிகள் மிக அதிகம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కనెక్షన్ నుండి చాలా ప్రయత్నాలు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองจากการเชื่อมต่อของคุณหลายครั้งเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
