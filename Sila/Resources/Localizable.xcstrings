    "notifications.markAll.hint": {
      "comment": "VoiceOver hint for Mark all read. Says it notifies nobody and cannot be undone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلّم كل الإشعارات كمقروءة. لا يُبلَّغ أحد بذلك، ولا يمكن التراجع عنه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি বিজ্ঞপ্তি পঠিত করে। কাউকে জানানো হয় না, আর এটি ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca totes les notificacions com a llegides. Ningú no ho sap i no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označí všechna upozornění jako přečtená. Nikdo se to nedozví a nelze to vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markerer alle notifikationer som læst. Ingen får besked, og det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert alle Mitteilungen als gelesen. Niemand erfährt davon, und es lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισημαίνει όλες τις ειδοποιήσεις ως αναγνωσμένες. Κανείς δεν ενημερώνεται και δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks every notification as read. Nobody is told, and it cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todas las notificaciones como leídas. A nadie se le avisa y no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitsee jokaisen ilmoituksen luetuksi. Kenellekään ei kerrota, eikä sitä voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque toutes les notifications comme lues. Personne n’est prévenu, et c’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסמן כל התראה כנקראה. אף אחד לא מקבל הודעה, ואי אפשר לבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सूचना को पढ़ी हुई चिह्नित करता है। किसी को नहीं बताया जाता, और इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označava sve obavijesti pročitanima. Nitko nije obaviješten i ne može se poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden értesítést olvasottnak jelöl. Senki nem tudja meg, és nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandai semua notifikasi sebagai dibaca. Tidak ada yang diberi tahu, dan tidak bisa dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna tutte le notifiche come lette. Nessuno viene avvisato e non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての通知を既読にします。相手には知らされず、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 알림을 읽음으로 표시해요. 상대방에게 알려지지 않으며 되돌릴 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ അറിയിപ്പുകളും വായിച്ചതായി അടയാളപ്പെടുത്തുന്നു. ആരെയും അറിയിക്കില്ല, ഇത് തിരിച്ചെടുക്കാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandakan setiap pemberitahuan sebagai dibaca. Tiada sesiapa diberitahu, dan ia tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merker alle varsler som lest. Ingen får vite det, og det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert elke melding als gelezen. Niemand hoort het en het kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacza wszystkie powiadomienia jako przeczytane. Nikt nie jest o tym informowany, a tego nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todas as notificações como lidas. Ninguém é avisado, e não dá para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todas as notificações como lidas. Ninguém é avisado e não pode ser anulado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează toate notificările ca citite. Nimeni nu este anunțat și nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечает все уведомления прочитанными. Никто не узнает, и это нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označí všetky upozornenia ako prečítané. Nikto sa to nedozvie a nedá sa to vrátiť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markerar alla aviseringar som lästa. Ingen får veta det, och det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா அறிவிப்புகளையும் படித்ததாகக் குறிக்கும். யாருக்கும் தெரிவிக்கப்படாது, திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి నోటిఫికేషన్‌ను చదివినట్లు గుర్తిస్తుంది. ఎవరికీ తెలియదు, దీన్ని వెనక్కి తీసుకోలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายทุกการแจ้งเตือนว่าอ่านแล้ว ไม่มีใครรู้ และย้อนกลับไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bildirimi okundu olarak işaretler. Kimseye haber verilmez ve geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначає кожне сповіщення прочитаним. Нікого не повідомляють, і це неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اطلاع کو پڑھی ہوئی نشان زد کرتا ہے۔ کسی کو نہیں بتایا جاتا، اور اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu mọi thông báo là đã đọc. Không ai được báo, và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有通知标为已读。不会通知任何人，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有通知標為已讀。沒有人會知道，且無法復原。"
          }
        }
      }
    },
    "notifications.open.postGone": {
      "comment": "Toast when a tapped notification's post no longer exists.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
