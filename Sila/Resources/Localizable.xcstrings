    "video.status.held": {
      "comment": "The author's own post, video held for a moderator (contract v28 §11). Never says why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُراجَع الفيديو قبل أن يراه الآخرون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যরা দেখার আগে আপনার ভিডিও পর্যালোচনা করা হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu vídeo s'està revisant abans que la resta el pugui veure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé video se kontroluje, než ho uvidí ostatní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din video bliver gennemgået, før andre kan se den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Video wird geprüft, bevor andere es sehen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βίντεό σου εξετάζεται προτού το δουν οι άλλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is being reviewed before others can see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vídeo se está revisando antes de que otros puedan verlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Videosi tarkastetaan, ennen kuin muut näkevät sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vidéo est en cours d’examen avant que d’autres puissent la voir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הווידאו שלך נבדק לפני שאחרים יכולים לראות אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वीडियो को दूसरों के देखने से पहले उसकी समीक्षा हो रही है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj video se pregledava prije nego ga drugi mogu vidjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videódat átvizsgáljuk, mielőtt mások láthatnák."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Videomu sedang ditinjau sebelum orang lain bisa melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo video è in revisione prima che gli altri possano vederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人に表示される前に、動画を審査しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 보기 전에 동영상을 검토하고 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റുള്ളവർക്ക് കാണാൻ കഴിയുന്നതിന് മുമ്പ് നിങ്ങളുടെ വീഡിയോ പരിശോധിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Video anda sedang disemak sebelum orang lain dapat melihatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoen din vurderes før andre kan se den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je video wordt beoordeeld voordat anderen hem kunnen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wideo jest sprawdzane, zanim inni je zobaczą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu vídeo está sendo analisado antes que outras pessoas possam vê-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu vídeo está a ser revisto antes de os outros o poderem ver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoul tău este analizat înainte ca alții să-l poată vedea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео проверяется, прежде чем его смогут увидеть другие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje video sa posudzuje, kým ho uvidia ostatní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din video granskas innan andra kan se den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றவர்கள் பார்ப்பதற்கு முன் உங்கள் வீடியோ மதிப்பாய்வு செய்யப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతరులు చూడకముందు మీ వీడియో సమీక్షించబడుతోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอของคุณกำลังถูกตรวจสอบก่อนที่คนอื่นจะเห็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videonuz, başkaları görmeden önce inceleniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше відео перевіряється, перш ніж його побачать інші."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ویڈیو کا جائزہ لیا جا رہا ہے، اس کے بعد دوسرے اسے دیکھ سکیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video của bạn đang được xem xét trước khi người khác thấy được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的视频正在审核，通过后其他人才能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的影片正在審核，通過後其他人才能看到。"
          }
        }
      }
    },
