    "guest.room.refusal.guestsFull.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مقاعد الزوار مشغولة. أعد المحاولة بعد قليل — أو انضم إلى «معروف» أو سجّل الدخول، فلن تحتاج إلى مقعد زائر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতিথির সব আসন ভরে গেছে। একটু পরে আবার চেষ্টা করুন — অথবা Known-এ যোগ দিন বা সাইন ইন করুন, তখন অতিথির আসন লাগবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els seients de convidat estan ocupats. Torna-ho a provar d'aquí a una estona, o uneix-te a Known o inicia la sessió i no necessitaràs un seient de convidat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna místa pro hosty jsou obsazena. Zkus to za chvíli – nebo se připoj k aplikaci Known či přihlas, a host nebudeš potřebovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gæstepladser er optaget. Prøv igen om lidt – eller deltag i Known eller log ind, så behøver du ikke en gæsteplads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gästeplätze sind belegt. Versuche es in Kürze erneut – oder tritt Known bei oder melde dich an, dann brauchst du keinen Gästeplatz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι θέσεις επισκεπτών είναι κατειλημμένες. Δοκίμασε ξανά σε λίγο — ή γράψου στο Known ή συνδέσου και δεν θα χρειάζεσαι θέση επισκέπτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every guest seat is taken. Try again in a little while — or join Known or sign in, and you won't need a guest seat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los asientos de invitado están ocupados. Inténtalo de nuevo en un rato, o únete a Known o inicia sesión y no necesitarás un asiento de invitado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki vieraspaikat on otettu. Yritä hetken kuluttua uudelleen – tai liity Knowniin tai kirjaudu sisään, niin et tarvitse vieraspaikkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les places d’invité sont prises. Réessayez dans un moment — ou rejoignez Known ou connectez-vous, et vous n’aurez plus besoin d’une place d’invité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מושבי האורחים תפוסים. נסה שוב בעוד זמן קצר — או הצטרף ל-Known או התחבר, ולא תזדקק למושב אורח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेहमानों की सारी सीटें भर चुकी हैं। थोड़ी देर बाद फिर कोशिश करें — या Known से जुड़ें या साइन इन करें, तब आपको मेहमान सीट की ज़रूरत नहीं पड़ेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sva gostinska mjesta su zauzeta. Pokušaj ponovno za malo — ili se pridruži aplikaciji Known ili se prijavi i nećeš trebati gostinsko mjesto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden vendéghely foglalt. Próbáld újra egy kis idő múlva – vagy csatlakozz a Knownhoz, illetve jelentkezz be, és nem kell vendéghely."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua kursi tamu terisi. Coba lagi sebentar lagi — atau gabung Known atau masuk, maka kamu tidak butuh kursi tamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i posti per gli ospiti sono occupati. Riprova tra poco, oppure iscriviti a Known o accedi e non ti servirà un posto da ospite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲスト席がすべて埋まっています。しばらくしてからもう一度お試しください。Knownに参加するかサインインすれば、ゲスト席は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트 자리가 모두 찼어요. 잠시 후 다시 시도하거나 Known에 가입하거나 로그인하면 게스트 자리가 필요 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതിഥികൾക്കുള്ള എല്ലാ സീറ്റുകളും നിറഞ്ഞു. കുറച്ച് കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കുക — അല്ലെങ്കിൽ Known-ൽ ചേരുകയോ സൈൻ ഇൻ ചെയ്യുകയോ ചെയ്താൽ അതിഥി സീറ്റ് വേണ്ടി വരില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tempat duduk tetamu telah diambil. Cuba lagi sebentar lagi — atau sertai Known atau log masuk, dan anda tidak memerlukan tempat duduk tetamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gjesteplasser er tatt. Prøv igjen om litt, eller bli med på Known eller logg inn, så trenger du ikke en gjesteplass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gastenplaatsen zijn bezet. Probeer het zo opnieuw, of meld je aan bij Known of log in, dan heb je geen gastenplaats nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie miejsca dla gości są zajęte. Spróbuj za jakiś czas — albo dołącz do Known lub zaloguj się, a miejsce dla gościa nie będzie Ci potrzebne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lugares para visitantes estão ocupados. Tente de novo daqui a pouco, ou entre no Known ou faça login e você não precisará de um lugar de visitante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lugares de convidado estão ocupados. Tente novamente daqui a pouco — ou entre na Known ou inicie sessão, e não precisará de um lugar de convidado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate locurile pentru invitați sunt ocupate. Încearcă din nou peste puțin timp — sau alătură-te Known ori autentifică-te și nu vei mai avea nevoie de un loc de invitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все гостевые места заняты. Повторите чуть позже — или присоединитесь к Known либо войдите в аккаунт, и гостевое место не понадобится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky miesta pre hostí sú obsadené. Skús to o chvíľu — alebo sa pripoj k Known či prihlás, a miesto pre hosťa nebudeš potrebovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla gästplatser är upptagna. Försök igen om en stund – eller gå med i Known eller logga in, så behöver du ingen gästplats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருந்தினர் இருக்கைகள் அனைத்தும் நிரம்பிவிட்டன. சிறிது நேரம் கழித்து முயலுங்கள் — அல்லது Known-இல் சேருங்கள் அல்லது உள்நுழையுங்கள், விருந்தினர் இருக்கை தேவையிருக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అతిథి సీట్లన్నీ నిండిపోయాయి. కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి — లేదా Knownలో చేరండి లేదా సైన్ ఇన్ చేయండి, అప్పుడు అతిథి సీటు అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่นั่งผู้เยี่ยมชมเต็มทุกที่ ลองอีกครั้งในอีกสักครู่ หรือเข้าร่วม Known หรือลงชื่อเข้าใช้ คุณก็ไม่ต้องใช้ที่นั่งผู้เยี่ยมชม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm misafir yerleri dolu. Biraz sonra tekrar deneyin; veya Known'a katılın ya da giriş yapın, misafir yerine ihtiyacınız kalmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі місця для гостей зайняті. Спробуйте трохи згодом — або приєднайтеся до Known чи увійдіть, і гостьове місце вам не знадобиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مہمانوں کی تمام نشستیں بھر گئی ہیں۔ تھوڑی دیر بعد دوبارہ کوشش کریں — یا Known میں شامل ہوں یا سائن اِن کریں، پھر آپ کو مہمان نشست کی ضرورت نہیں ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi chỗ cho khách đã kín. Hãy thử lại sau ít phút — hoặc tham gia Known hay đăng nhập, bạn sẽ không cần chỗ dành cho khách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访客席位已满。请稍后再试，或加入 Known 或登录，这样就不需要访客席位了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訪客席位已滿。請稍後再試，或加入 Known／登入，就不需要訪客席位。"
          }
        }
      }
    },
    "guest.room.refusal.guestsFull.title": {
      "comment": "Why a guest is not listening to a room (contract v31).",
      "extractionState": "manual",
      "localizations": {
