          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tożsamość niezweryfikowana · poręczenie od @%1$@ od %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidade não verificada · avalizado por @%1$@ desde %2$@"
          }
        },
        "pt-PT": {
