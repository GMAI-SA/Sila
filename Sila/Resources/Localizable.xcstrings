    "post.scope.region.room.unknownAccessibility": {
      "comment": "VoiceOver reading of a regional room whose region is unnamed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غرفة إقليمية. لا يمكن التحدث إلا للحسابات الموثّقة في تلك المنطقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আঞ্চলিক রুম। শুধু ওই অঞ্চলের ভেরিফায়েড অ্যাকাউন্টরা কথা বলতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Només hi poden parlar els comptes verificats en aquesta regió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionální místnost. Mluvit mohou jen ověřené účty v dané oblasti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rum. Kun verificerede konti i den region kan tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionaler Raum. Nur verifizierte Konten in dieser Region können sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιφερειακή αίθουσα. Μόνο επαληθευμένοι λογαριασμοί σε αυτή την περιοχή μπορούν να μιλήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional room. Only verified accounts in that region can speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Solo pueden hablar las cuentas verificadas en esa región."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluehuone. Vain kyseisellä alueella vahvistetut tilit voivat puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon régional. Seuls les comptes vérifiés dans cette région peuvent parler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר אזורי. רק חשבונות מאומתים באותו אזור יכולים לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्रीय रूम। केवल उस क्षेत्र के सत्यापित अकाउंट बोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalna soba. Govoriti mogu samo potvrđeni računi u toj regiji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionális szoba. Csak az adott térségben hitelesített fiókok szólalhatnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room regional. Hanya akun terverifikasi di kawasan itu yang bisa berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanza regionale. Solo gli account verificati in quella regione possono parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域のルーム。その地域で認証されたアカウントだけが発言できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 룸. 해당 지역에서 인증된 계정만 말할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മേഖലാ റൂം. ആ മേഖലയിൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ സംസാരിക്കാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik serantau. Hanya akaun yang disahkan di rantau itu boleh bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rom. Bare verifiserte kontoer i den regionen kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale room. Alleen geverifieerde accounts in die regio kunnen spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój regionalny. Mówić mogą tylko zweryfikowane konta z tego regionu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Só contas verificadas nessa região podem falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala regional. Só contas verificadas nessa região podem falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră regională. Doar conturile verificate în acea regiune pot vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Региональная комната. Говорить могут только проверенные аккаунты из этого региона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionálna miestnosť. Hovoriť môžu iba overené účty z tohto regiónu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalt rum. Bara verifierade konton i den regionen kan tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிராந்திய அறை. அந்தப் பிராந்தியத்தில் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంతీయ రూమ్. ఆ ప్రాంతంలో ధృవీకరించబడిన ఖాతాలు మాత్రమే మాట్లాడగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องระดับภูมิภาค เฉพาะบัญชีที่ยืนยันตัวตนแล้วในภูมิภาคนั้นเท่านั้นที่พูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgesel oda. Yalnızca o bölgede doğrulanmış hesaplar konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регіональна кімната. Говорити можуть лише верифіковані облікові записи в цьому регіоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "علاقائی روم۔ صرف اس خطے کے تصدیق شدہ اکاؤنٹ بول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng khu vực. Chỉ tài khoản đã xác minh ở khu vực đó mới phát biểu được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区房间。只有在该地区验证的账户可以发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地區聊天室。只有在該地區通過驗證的帳號能發言。"
          }
        }
      }
    },
    "post.scope.region.thread.accessibility": {
