    "account.profile.handle.hint": {
      "comment": "VoiceOver hint for the handle field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من ثلاثة إلى عشرين حرفًا لاتينيًا صغيرًا أو رقمًا أو شرطة سفلية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিন থেকে বিশটি ছোট হাতের অক্ষর, সংখ্যা ও আন্ডারস্কোর"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De tres a vint caràcters, entre lletres minúscules, números i guions baixos"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři až dvacet znaků: malá písmena, číslice a podtržítka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre til tyve tegn med små bogstaver, tal og understregninger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei bis zwanzig Zeichen: Kleinbuchstaben, Ziffern und Unterstriche"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρεις έως είκοσι χαρακτήρες από πεζά γράμματα, αριθμούς και κάτω παύλες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three to twenty characters of lowercase letters, numbers and underscores"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De tres a veinte caracteres: letras minúsculas, números y guiones bajos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolmesta kahteenkymmeneen merkkiä: pieniä kirjaimia, numeroita ja alaviivoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois à vingt caractères : lettres minuscules, chiffres et tirets bas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלושה עד עשרים תווים של אותיות קטנות, ספרות וקווים תחתונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन से बीस अक्षर: छोटे अक्षर, संख्याएँ और अंडरस्कोर"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tri do dvadeset znakova: mala slova, brojevi i podcrte"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Három–húsz karakter: kisbetűk, számok és aláhúzás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga sampai dua puluh karakter berupa huruf kecil, angka, dan garis bawah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da tre a venti caratteri tra lettere minuscole, numeri e trattini bassi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小文字の英字、数字、アンダースコアで3〜20文字"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문 소문자, 숫자, 밑줄 3~20자"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൂന്ന് മുതൽ ഇരുപത് വരെ ചെറിയ അക്ഷരങ്ങൾ, അക്കങ്ങൾ, അണ്ടർസ്കോറുകൾ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga hingga dua puluh aksara huruf kecil, nombor dan garis bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre til tjue tegn med små bokstaver, tall og understreker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie tot twintig tekens: kleine letters, cijfers en underscores"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od trzech do dwudziestu znaków: małych liter, cyfr i podkreślników"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De três a vinte caracteres, entre letras minúsculas, números e sublinhados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Três a vinte carateres, entre letras minúsculas, números e sublinhados"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între trei și douăzeci de caractere: litere mici, cifre și liniuțe de subliniere"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От трёх до двадцати символов: строчные буквы, цифры и подчёркивания"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tri až dvadsať znakov: malé písmená, číslice a podčiarkovníky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre till tjugo tecken med små bokstäver, siffror och understreck"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறிய எழுத்துகள், எண்கள், அடிக்கோடுகள் கொண்ட மூன்று முதல் இருபது எழுத்துகள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూడు నుండి ఇరవై అక్షరాలు: చిన్న అక్షరాలు, అంకెలు, అండర్‌స్కోర్‌లు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามถึงยี่สิบตัว เป็นตัวอักษรพิมพ์เล็ก ตัวเลข และขีดล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç ila yirmi karakter; küçük harf, rakam ve alt çizgi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від трьох до двадцяти символів: малі літери, цифри та підкреслення"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین سے بیس حروف: چھوٹے حروف، ہندسے اور انڈر سکور"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ ba đến hai mươi ký tự gồm chữ thường, chữ số và dấu gạch dưới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三到二十个字符，可用小写字母、数字和下划线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三至二十個字元，可使用小寫字母、數字和底線"
          }
        }
      }
    },
