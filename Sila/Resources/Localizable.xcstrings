          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicações repetitivas, automatizadas ou não solicitadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postări repetitive, automate sau nesolicitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяющиеся, автоматические или нежелательные публикации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakované, automatizované alebo nevyžiadané zverejňovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upprepade, automatiserade eller oönskade inlägg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரும்பத் திரும்ப, தானியங்கி அல்லது கேட்கப்படாத இடுகைகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే, ఆటోమేటెడ్ లేదా కోరని పోస్టింగ్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโพสต์ซ้ำๆ แบบอัตโนมัติ หรือที่ไม่ได้รับเชิญ"
          }
        },
        "tr": {
          "stringUnit": {
