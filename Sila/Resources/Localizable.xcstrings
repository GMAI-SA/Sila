    "verification.approved.message": {
      "comment": "Body of the approved step.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد نفاذ هويتك. مرحبًا بك في «معروف»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath আপনার পরিচয় নিশ্চিত করেছে। Known-এ স্বাগতম।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ha confirmat la teva identitat. Et donem la benvinguda a Known."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath potvrdil tvou totožnost. Vítej v aplikaci Known."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath bekræftede din identitet. Velkommen til Known."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath hat deine Identität bestätigt. Willkommen bei Known."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Nafath επιβεβαίωσε την ταυτότητά σου. Καλώς ήρθες στο Known."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath confirmed your identity. Welcome to Known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath confirmó tu identidad. Te damos la bienvenida a Known."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath vahvisti henkilöllisyytesi. Tervetuloa Knowniin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath a confirmé votre identité. Bienvenue sur Known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath אישרה את זהותך. ברוך בואך ל-Known."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ने आपकी पहचान की पुष्टि कर दी। Known में स्वागत है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath je potvrdio tvoj identitet. Dobro došao/došla u aplikaciju Known."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nafath megerősítette a személyazonosságodat. Üdv a Knownban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath mengonfirmasi identitasmu. Selamat datang di Known."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ha confermato la tua identità. Benvenuto su Known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafathが本人確認を完了しました。Knownへようこそ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath가 신원을 확인했어요. Known에 오신 것을 환영해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath നിങ്ങളുടെ ഐഡന്റിറ്റി സ്ഥിരീകരിച്ചു. Known-ലേക്ക് സ്വാഗതം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath mengesahkan identiti anda. Selamat datang ke Known."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath bekreftet identiteten din. Velkommen til Known."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath heeft je identiteit bevestigd. Welkom bij Known."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath potwierdził Twoją tożsamość. Witaj w Known."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath confirmou sua identidade. Boas-vindas ao Known."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath confirmou a sua identidade. Bem-vindo à Known."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath a confirmat identitatea ta. Bun venit pe Known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath подтвердил вашу личность. Добро пожаловать в Known."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath potvrdil tvoju totožnosť. Vitaj v Known."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath bekräftade din identitet. Välkommen till Known."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath உங்கள் அடையாளத்தை உறுதிப்படுத்தியது. Known-க்கு வரவேற்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath మీ గుర్తింపును నిర్ధారించింది. Known కు స్వాగతం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ยืนยันตัวตนของคุณแล้ว ยินดีต้อนรับสู่ Known"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath kimliğinizi onayladı. Known'a hoş geldiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath підтвердив вашу особу. Ласкаво просимо до Known."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath نے آپ کی شناخت کی تصدیق کر دی۔ Known میں خوش آمدید۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath đã xác nhận danh tính của bạn. Chào mừng đến với Known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 已确认你的身份。欢迎来到 Known。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 已確認你的身分。歡迎來到 Known。"
          }
        }
      }
    },
