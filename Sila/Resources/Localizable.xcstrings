    "composer.scope.row.a11yHintUnavailable": {
      "comment": "VoiceOver hint for an audience row that cannot be chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متاح. اختياره يوضّح السبب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাওয়া যাচ্ছে না। বেছে নিলে কারণ জানানো হবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible. En seleccionar-la s'explica per què"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupné. Po vybrání se vysvětlí proč"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilgængelig. Hvis du vælger den, forklares hvorfor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfügbar. Beim Auswählen wird der Grund erklärt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη διαθέσιμο. Η επιλογή του εξηγεί γιατί"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable. Selecting it explains why"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible. Al seleccionarla se explica por qué"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei käytettävissä. Valinta kertoo syyn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible. La sélectionner explique pourquoi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא זמין. בחירה בו מסבירה למה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुपलब्ध। इसे चुनने पर कारण बताया जाएगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupno. Odabirom se objašnjava zašto"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem elérhető. A kiválasztása elmagyarázza az okát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia. Memilihnya menjelaskan alasannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile. Selezionandolo ne spiega il motivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できません。選ぶと理由が表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 없음. 선택하면 이유를 알려줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭ്യമല്ല. തിരഞ്ഞെടുത്താൽ കാരണം വിശദീകരിക്കും"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia. Memilihnya menerangkan sebabnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilgjengelig. Hvis du velger den, får du vite hvorfor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet beschikbaar. Door het te selecteren zie je waarom"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępne. Wybranie pokaże dlaczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível. Ao selecioná-la, você vê o motivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível. Ao selecioná-la, é explicado porquê"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponibil. Selectarea explică motivul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно. При выборе объяснит почему"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupné. Po výbere sa vysvetlí prečo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillgängligt. Om du väljer det förklaras varför"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிடைக்கவில்லை. தேர்ந்தெடுத்தால் ஏன் என்று விளக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అందుబాటులో లేదు. దాన్ని ఎంచుకుంటే కారణం తెలుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไม่ได้ การเลือกจะอธิบายเหตุผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılamıyor. Seçmek nedenini açıklar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно. Вибір пояснює чому"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستیاب نہیں۔ اسے چننے سے وجہ بتائی جاتی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khả dụng. Chọn sẽ cho biết lý do"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用。选择它会说明原因"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用。選取後會說明原因"
          }
        }
      }
    },
    "composer.scope.section.a11yLabel": {
      "comment": "VoiceOver label for the audience section.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يمكنه الرد. الجميع يمكنهم قراءة هذا المنشور في الحالتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে উত্তর দিতে পারবে। যেভাবেই হোক সবাই এই পোস্ট পড়তে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui pot respondre. En qualsevol cas, tothom pot llegir aquesta publicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo může odpovídat. Tento příspěvek může číst každý v každém případě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan svare. Alle kan under alle omstændigheder læse dette opslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer antworten kann. Alle können diesen Beitrag in jedem Fall lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιος μπορεί να απαντήσει. Όλοι μπορούν να διαβάσουν αυτή την ανάρτηση σε κάθε περίπτωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can reply. Everyone can read this post either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién puede responder. De todos modos, todos pueden leer esta publicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka voi vastata. Kaikki voivat lukea tämän julkaisun joka tapauksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut répondre. Tout le monde peut lire ce post dans tous les cas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי יכול להגיב. כולם יכולים לקרוא את הפוסט הזה בכל מקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन जवाब दे सकता है। यह पोस्ट हर कोई पढ़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tko može odgovarati. Svatko može čitati ovu objavu u svakom slučaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki válaszolhat. A bejegyzést így is, úgy is mindenki elolvashatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang bisa membalas. Semua orang bisa membaca postingan ini apa pun pilihannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi può rispondere. In ogni caso tutti possono leggere questo post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信できる人。どちらの場合も、この投稿は誰でも読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글을 달 수 있는 사람. 어느 쪽이든 누구나 이 게시물을 읽을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആർക്ക് മറുപടി നൽകാം. ഏതായാലും എല്ലാവർക്കും ഈ പോസ്റ്റ് വായിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa boleh membalas. Semua orang boleh membaca siaran ini dalam apa jua keadaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan svare. Alle kan lese dette innlegget uansett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie kan reageren. Iedereen kan dit bericht hoe dan ook lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto może odpowiadać. Każdy może przeczytać ten wpis tak czy inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode responder. De qualquer forma, todos podem ler este post."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode responder. Todos podem ler esta publicação de qualquer forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine poate răspunde. Oricine poate citi această postare în ambele cazuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто может отвечать. Читать этот пост может любой в любом случае."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto môže odpovedať. Tento príspevok môže čítať každý v každom prípade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som kan svara. Alla kan läsa det här inlägget oavsett."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யார் பதிலளிக்கலாம். எப்படியும் எல்லோரும் இந்த இடுகையைப் படிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరు రిప్లై ఇవ్వగలరు. ఎలాగైనా ఈ పోస్ట్‌ను ఎవరైనా చదవగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครตอบกลับได้ ไม่ว่าอย่างไรทุกคนก็อ่านโพสต์นี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimler yanıt verebilir. Bu gönderiyi her durumda herkes okuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто може відповідати. Читати цей допис може кожен у будь-якому разі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون جواب دے سکتا ہے۔ یہ پوسٹ ہر صورت میں سب پڑھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai được trả lời. Dù thế nào ai cũng đọc được bài đăng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁可以回复。无论如何，所有人都能阅读此帖子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誰可以回覆。無論如何，所有人都能閱讀這則貼文。"
          }
        }
      }
    },
