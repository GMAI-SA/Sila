    "push.vouch_expiring": {
      "comment": "Push notification body, shown from the loc-key alone: it names nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تزكيتك قريبًا — وثّق هويتك لتواصل النشر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সুপারিশ শিগগিরই শেষ হবে — পোস্ট করা চালিয়ে যেতে পরিচয় যাচাই করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu aval s'acaba aviat: verifica la teva identitat per continuar publicant"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé ručení brzy skončí – ověř svou totožnost, abys mohl dál psát"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din garanti ophører snart – verificér din identitet for at kunne blive ved med at slå op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bürgschaft endet bald – verifiziere deine Identität, um weiter zu posten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγύησή σου λήγει σύντομα — επαλήθευσε την ταυτότητά σου για να συνεχίσεις να δημοσιεύεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vouch ends soon — verify your identity to keep posting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu aval termina pronto: verifica tu identidad para seguir publicando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takuusi päättyy pian – vahvista henkilöllisyytesi jatkaaksesi julkaisemista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre caution se termine bientôt — vérifiez votre identité pour continuer à publier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערבות שלך מסתיימת בקרוב — אמת את זהותך כדי להמשיך לפרסם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वाउच जल्द खत्म होगा — पोस्ट करते रहने के लिए अपनी पहचान सत्यापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje jamstvo uskoro završava — potvrdi svoj identitet da nastaviš objavljivati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezességed hamarosan véget ér – hitelesítsd a személyazonosságodat, hogy továbbra is írhass"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminanmu segera berakhir — verifikasi identitasmu agar tetap bisa memposting"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua garanzia termina presto: verifica la tua identità per continuare a pubblicare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証がまもなく終了します。投稿を続けるには本人確認をしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증이 곧 종료돼요. 계속 게시하려면 신원을 인증하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഉറപ്പ് ഉടൻ അവസാനിക്കും — പോസ്റ്റ് ചെയ്യുന്നത് തുടരാൻ ഐഡന്റിറ്റി പരിശോധിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminan anda akan berakhir tidak lama lagi — sahkan identiti anda untuk terus menyiar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantien din avsluttes snart. Verifiser identiteten din for å fortsette å publisere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je garantie loopt binnenkort af: verifieer je identiteit om te kunnen blijven posten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje poręczenie wkrótce się kończy — zweryfikuj tożsamość, aby dalej publikować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu aval termina em breve: verifique sua identidade para continuar postando"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu aval termina em breve — verifique a sua identidade para continuar a publicar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanția ta se încheie curând — verifică-ți identitatea ca să poți posta în continuare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство скоро закончится — пройдите проверку личности, чтобы продолжать писать"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ručenie sa čoskoro končí — over svoju identitu, aby si mohol ďalej písať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt intygande upphör snart – verifiera din identitet för att fortsätta publicera"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உத்தரவாதம் விரைவில் முடிகிறது — தொடர்ந்து இட உங்கள் அடையாளத்தைச் சரிபாருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హామీ త్వరలో ముగుస్తుంది — పోస్ట్ చేస్తూ ఉండటానికి మీ గుర్తింపును ధృవీకరించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันให้ของคุณจะสิ้นสุดเร็วๆ นี้ ยืนยันตัวตนของคุณเพื่อโพสต์ต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefilliğiniz yakında sona eriyor; gönderi paylaşmaya devam etmek için kimliğinizi doğrulayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство скоро закінчиться — верифікуйте особу, щоб і далі публікувати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ضمانت جلد ختم ہو رہی ہے — پوسٹ کرتے رہنے کے لیے اپنی شناخت کی تصدیق کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bảo chứng của bạn sắp kết thúc — hãy xác minh danh tính để tiếp tục đăng bài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的担保即将结束，请验证身份以继续发帖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的擔保即將結束，請驗證身分以繼續發文"
          }
        }
      }
    },
    "push.vouch_graduated": {
      "comment": "Push notification body, shown from the loc-key alone: it names nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق شخص زكّيته هويته — لم تعد مسؤولًا عنه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সুপারিশ করা কেউ পরিচয় যাচাই করেছে — আপনি আর তার জন্য দায়ী নন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú que has avalat ha verificat la seva identitat: ja no en ets responsable"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo, za koho ručíš, ověřil svou totožnost – už za něj neneseš odpovědnost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, du gik i god for, verificerede sin identitet – du hæfter ikke længere for vedkommende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, für den du gebürgt hast, hat die Identität verifiziert – du bist nicht mehr für die Person verantwortlich"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος που εγγυήθηκες επαλήθευσε την ταυτότητά του — δεν είσαι πια υπεύθυνος για αυτόν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone you vouched for verified their identity — you're no longer answerable for them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien a quien avalaste verificó su identidad: ya no respondes por esa persona"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku, jolle takasit, vahvisti henkilöllisyytensä – et ole enää vastuussa hänestä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un dont vous vous portiez garant a vérifié son identité — vous n’en êtes plus responsable"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו שערבת לו אימת את זהותו — אתה כבר לא אחראי לו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे आपने वाउच किया उसने अपनी पहचान सत्यापित कर ली — अब आप उसके लिए जवाबदेह नहीं हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko za koga si jamčio/la potvrdio je svoj identitet — više ne odgovaraš za tu osobu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki, akiért kezeskedtél, hitelesítette a személyazonosságát – már nem felelsz érte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang kamu jamin memverifikasi identitasnya — kamu tidak lagi bertanggung jawab atasnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona che hai garantito ha verificato la propria identità: non sei più responsabile per lei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが保証した人が本人確認を完了しました。あなたはもう責任を負いません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 보증한 사람이 신원을 인증했어요. 이제 그 사람에 대한 책임이 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഉറപ്പുനൽകിയ ഒരാൾ ഐഡന്റിറ്റി പരിശോധിച്ചു — ഇനി നിങ്ങൾ അവർക്ക് ഉത്തരവാദിയല്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang yang anda jamin telah mengesahkan identitinya — anda tidak lagi bertanggungjawab ke atasnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen du garanterte for, verifiserte identiteten sin. Du er ikke lenger ansvarlig for vedkommende"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand voor wie je instond heeft zijn of haar identiteit geverifieerd: je staat niet meer voor die persoon in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, za którą poręczyłeś, zweryfikowała tożsamość — nie odpowiadasz już za nią"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que você avalizou verificou a identidade: você não responde mais por essa pessoa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que avalizou verificou a sua identidade — já não é responsável por essa pessoa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva pentru care ai garantat și-a verificat identitatea — nu mai ești răspunzător pentru această persoană"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот, за кого вы поручились, прошёл проверку личности — вы больше не отвечаете за него"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto, za koho si ručil, overil svoju identitu — už za neho nezodpovedáš"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon du intygat för verifierade sin identitet – du ansvarar inte längre för dem"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உத்தரவாதம் அளித்த ஒருவர் தன் அடையாளத்தைச் சரிபார்த்தார் — இனி அவருக்கு நீங்கள் பொறுப்பல்ல"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు హామీ ఇచ్చిన వ్యక్తి తమ గుర్తింపును ధృవీకరించుకున్నారు — ఇకపై వారికి మీరు బాధ్యులు కారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่คุณยืนยันให้ยืนยันตัวตนแล้ว คุณไม่ต้องรับผิดชอบต่อพวกเขาอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olduğunuz biri kimliğini doğruladı; artık onun sorumlusu değilsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Людина, за яку ви поручилися, верифікувала особу — ви більше не відповідаєте за неї"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس کی آپ نے ضمانت دی تھی اس نے اپنی شناخت کی تصدیق کر لی — اب آپ ان کے ذمہ دار نہیں رہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bạn bảo chứng đã xác minh danh tính — bạn không còn chịu trách nhiệm về họ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你担保的人已验证身份，你不再需要为其负责"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你擔保的人已驗證身分，你不再需要為他們負責"
          }
        }
      }
    },
