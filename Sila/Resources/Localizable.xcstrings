          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýta sa, kto to je, a potom ti dá odkaz, ktorý jej pošleš"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågar vem de är och ger dig sedan en länk att skicka till dem"
