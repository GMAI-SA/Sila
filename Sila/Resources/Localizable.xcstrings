            "value": "Jokin meni pieleen. Päivitä vetämällä alas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite. Tirez pour actualiser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. משוך לרענון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई। रिफ़्रेश करने के लिए खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu. Povuci za osvježavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami elromlott. Húzd lefelé a frissítéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan. Tarik untuk menyegarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto. Trascina verso il basso per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。引っ張って更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했어요. 당겨서 새로 고침하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തോ പിഴവ് സംഭവിച്ചു. പുതുക്കാൻ താഴേക്ക് വലിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu telah tersilap. Tarik untuk muat semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt. Dra ned for å oppdatere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Trek omlaag om te vernieuwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Pociągnij, aby odświeżyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Puxe para atualizar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal. Puxe para atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a mers bine. Trage în jos pentru a reîmprospăta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Потяните вниз, чтобы обновить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo. Potiahnutím nadol obnov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel. Dra för att uppdatera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறு நடந்தது. புதுப்பிக்கக் கீழே இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది. రిఫ్రెష్ చేయడానికి క్రిందికి లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาด ดึงลงเพื่อรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyler ters gitti. Yenilemek için aşağı çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так. Потягніть вниз, щоб оновити."
