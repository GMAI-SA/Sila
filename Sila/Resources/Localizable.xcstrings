    "feed.tab.following.hint": {
      "comment": "VoiceOver hint for the Following tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض منشورات الحسابات التي تتابعها، الأحدث أولًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যাদের ফলো করেন তাদের পোস্ট নতুনটি আগে দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les publicacions dels comptes que segueixes, les més noves primer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příspěvky z účtů, které sleduješ, nejnovější první"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opslag fra konti, du følger, de nyeste først"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Beiträge von Konten, denen du folgst, die neuesten zuerst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει αναρτήσεις από λογαριασμούς που ακολουθείς, οι νεότερες πρώτα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows posts from accounts you follow, newest first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las publicaciones de las cuentas que sigues, las más recientes primero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää seuraamiesi tilien julkaisut, uusimmat ensin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les posts des comptes que vous suivez, les plus récents d’abord"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג פוסטים מחשבונות שאתה עוקב אחריהם, החדשים ראשונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़ॉलो किए अकाउंट की पोस्ट दिखाता है, सबसे नई पहले"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje objave računa koje pratiš, najnovije prve"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad követett fiókok bejegyzéseit mutatja, a legújabbat elöl"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan postingan dari akun yang kamu ikuti, yang terbaru dulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i post degli account che segui, dal più recente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー中のアカウントの投稿を新しい順に表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우하는 계정의 게시물을 최신순으로 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഫോളോ ചെയ്യുന്ന അക്കൗണ്ടുകളുടെ പോസ്റ്റുകൾ പുതിയത് ആദ്യം കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan siaran daripada akaun yang anda ikuti, terbaharu dahulu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser innlegg fra kontoer du følger, de nyeste først"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont berichten van accounts die je volgt, nieuwste eerst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wpisy z obserwowanych kont, od najnowszych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os posts das contas que você segue, dos mais recentes aos mais antigos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as publicações das contas que segue, das mais recentes para as mais antigas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată postările conturilor pe care le urmărești, cele mai noi primele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает посты аккаунтов, на которые вы подписаны, сначала новые"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí príspevky z účtov, ktoré sleduješ, najnovšie ako prvé"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar inlägg från konton du följer, de nyaste först"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பின்தொடரும் கணக்குகளின் இடுகைகளைப் புதியவை முதலில் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫాలో అయ్యే ఖాతాల పోస్ట్‌లను కొత్తవి ముందుగా చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงโพสต์จากบัญชีที่คุณติดตาม ใหม่สุดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip ettiğiniz hesapların gönderilerini en yeniden eskiye gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує дописи від облікових записів, на які ви підписані, — спершу найновіші"
          }
        },
        "ur": {
          "stringUnit": {
