        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You verified your identity — your name now carries your own word"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaste tu identidad: ahora tu nombre cuenta con tu propia palabra"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistit henkilöllisyytesi – nimesi takana on nyt oma sanasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez vérifié votre identité — votre nom repose désormais sur votre propre parole"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימתת את זהותך — השם שלך נושא עכשיו את המילה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपनी पहचान सत्यापित कर ली — अब आपका नाम आपके अपने वचन पर टिका है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdio/la si svoj identitet — tvoje ime sada nosi tvoju vlastitu riječ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitelesítetted a személyazonosságodat – a neved mostantól a saját szavadat hordozza"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memverifikasi identitasmu — namamu kini dibawa oleh kata-katamu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai verificato la tua identità: ora il tuo nome si regge sulla tua parola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認が完了しました。あなたの名前は、あなた自身の言葉で裏付けられています"
