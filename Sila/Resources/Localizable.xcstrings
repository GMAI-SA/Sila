    "voice.error.withMedia": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحمل المنشور الصوتي صورًا أو صورة متحركة أو استطلاعًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস পোস্টে ছবি, GIF বা পোল থাকতে পারে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una publicació de veu no pot portar imatges, un GIF ni una enquesta"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasový příspěvek nemůže obsahovat obrázky, GIF ani anketu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lydopslag kan ikke have billeder, en GIF eller en afstemning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sprachbeitrag kann keine Bilder, kein GIF und keine Umfrage enthalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια φωνητική ανάρτηση δεν μπορεί να περιέχει εικόνες, GIF ή δημοσκόπηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voice post can't carry pictures, a GIF or a poll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una publicación de voz no puede llevar imágenes, un GIF ni una encuesta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääniviestiin ei voi liittää kuvia, GIF-kuvaa tai kyselyä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un post vocal ne peut pas contenir d’images, de GIF ni de sondage"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסט קולי לא יכול לכלול תמונות, GIF או סקר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस पोस्ट में तस्वीरें, GIF या पोल नहीं हो सकते"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovna objava ne može sadržavati slike, GIF ni anketu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangbejegyzéshez nem csatolható kép, GIF vagy szavazás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan suara tidak bisa membawa gambar, GIF, atau jajak pendapat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un post vocale non può contenere immagini, una GIF o un sondaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声投稿には、画像、GIF、投票を付けられません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 게시물에는 사진, GIF, 투표를 넣을 수 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോയ്‌സ് പോസ്റ്റിൽ ചിത്രങ്ങളോ GIF-ഓ പോളോ ഉൾപ്പെടുത്താനാകില്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran suara tidak boleh membawa gambar, GIF atau tinjauan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lydinnlegg kan ikke ha bilder, en GIF eller en avstemning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een spraakbericht kan geen afbeeldingen, GIF of peiling bevatten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis głosowy nie może zawierać zdjęć, GIF-a ani ankiety"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um post de voz não pode ter imagens, GIF nem enquete"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma publicação de voz não pode ter imagens, um GIF nem uma sondagem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O postare vocală nu poate conține imagini, un GIF sau un sondaj"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К голосовому посту нельзя добавить фото, GIF или опрос"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasový príspevok nemôže obsahovať obrázky, GIF ani anketu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett röstinlägg kan inte innehålla bilder, en GIF eller en omröstning"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் இடுகையில் படங்கள், GIF அல்லது வாக்கெடுப்பைச் சேர்க்க முடியாது"
          }
