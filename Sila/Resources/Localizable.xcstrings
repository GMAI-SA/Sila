          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos viajam criptografadas e são excluídas assim que um analista decide."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas fotos seguem cifradas e são eliminadas no momento em que um revisor decidir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile tale circulă criptate și sunt șterse în clipa în care un evaluator decide."
