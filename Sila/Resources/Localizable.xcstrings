    "app.signOut.hint": {
      "comment": "VoiceOver hint on every sign-out control that returns to the welcome screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي جلستك ويعيدك إلى شاشة الترحيب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সেশন শেষ করে স্বাগত স্ক্রিনে ফিরিয়ে নেয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalitza la sessió i torna a la pantalla de benvinguda"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí tvou relaci a vrátí tě na uvítací obrazovku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslutter din session og går tilbage til velkomstskærmen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet deine Sitzung und kehrt zum Willkommensbildschirm zurück"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τερματίζει τη συνεδρία σου και επιστρέφει στην οθόνη καλωσορίσματος"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends your session and returns to the welcome screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina tu sesión y vuelve a la pantalla de bienvenida"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättää istuntosi ja palaa tervetulonäkymään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine votre session et revient à l’écran d’accueil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיים את ההתחברות וחוזר למסך הפתיחה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सेशन खत्म करता है और वेलकम स्क्रीन पर लौटता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava tvoju sesiju i vraća te na zaslon dobrodošlice"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Befejezi a munkamenetet, és visszatér az üdvözlőképernyőre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakhiri sesimu dan kembali ke layar sambutan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la sessione e torna alla schermata di benvenuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを終了し、ウェルカム画面に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 종료하고 시작 화면으로 돌아가요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സെഷൻ അവസാനിപ്പിച്ച് സ്വാഗത സ്ക്രീനിലേക്ക് മടങ്ങുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamatkan sesi anda dan kembali ke skrin alu-aluan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutter økten din og går tilbake til velkomstskjermen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindigt je sessie en gaat terug naar het welkomstscherm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy sesję i wraca do ekranu powitalnego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra sua sessão e volta para a tela de boas-vindas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sua sessão e volta ao ecrã de boas-vindas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie sesiunea și revine la ecranul de bun venit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает сеанс и возвращает на экран приветствия"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí tvoju reláciu a vráti ťa na úvodnú obrazovku"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutar din session och återgår till välkomstskärmen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அமர்வை முடித்து வரவேற்புத் திரைக்குத் திரும்பும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సెషన్‌ను ముగించి స్వాగత స్క్రీన్‌కు తిరిగి వెళ్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จบเซสชันของคุณและกลับไปที่หน้าต้อนรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumunuzu sonlandırır ve karşılama ekranına döner"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершує ваш сеанс і повертає на екран привітання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا سیشن ختم کر کے خوش آمدید اسکرین پر لے جاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc phiên và quay về màn hình chào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束会话并返回欢迎页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束你的工作階段並回到歡迎畫面"
          }
        }
      }
    },
    "auth.biometric.error.noSavedSignIn": {
