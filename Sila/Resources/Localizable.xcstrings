    "notifications.kind.followRequest.detail": {
      "comment": "What the follow-request kind covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شخص يطلب متابعة حسابك الخاص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার প্রাইভেট অ্যাকাউন্ট ফলো করতে চাইলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú que demana seguir el teu compte privat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo žádá o sledování tvého soukromého účtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, der beder om at følge din private konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand möchte deinem privaten Konto folgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος ζητά να ακολουθήσει τον ιδιωτικό σου λογαριασμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone asking to follow your private account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien que pide seguir tu cuenta privada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku pyytää lupaa seurata yksityistä tiliäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un qui demande à suivre votre compte privé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו שמבקש לעקוב אחרי החשבון הפרטי שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आपके प्राइवेट अकाउंट को फ़ॉलो करने को कह रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko traži da prati tvoj privatni račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki követni kéri a privát fiókodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang meminta mengikuti akun privatmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno che chiede di seguire il tuo account privato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたの非公開アカウントのフォローを申請したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내 비공개 계정을 팔로우하려고 요청할 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും നിങ്ങളുടെ പ്രൈവറ്റ് അക്കൗണ്ട് ഫോളോ ചെയ്യാൻ അഭ്യർഥിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang meminta untuk mengikut akaun peribadi anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen som ber om å følge din private konto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die je privéaccount wil volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś prosi o obserwowanie Twojego prywatnego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém pedindo para seguir sua conta privada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém a pedir para seguir a sua conta privada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva cere să-ți urmărească contul privat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то просит разрешения подписаться на ваш закрытый аккаунт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto žiada o sledovanie tvojho súkromného účtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon som ber att få följa ditt privata konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது உங்கள் தனிப்பட்ட கணக்கைப் பின்தொடரக் கேட்கிறார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా మీ ప్రైవేట్ ఖాతాను ఫాలో అవ్వాలని అడిగినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนขอติดตามบัญชีส่วนตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri gizli hesabınızı takip etmek istediğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось просить підписатися на ваш приватний обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آپ کے نجی اکاؤنٹ کو فالو کرنے کی درخواست کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đó xin theo dõi tài khoản riêng tư của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人请求关注你的私密账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人申請追蹤你的私人帳號。"
          }
        }
      }
    },
