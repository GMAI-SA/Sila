    "rooms.card.a11yHint.open": {
      "comment": "VoiceOver hint on a joinable room card. Listening is open to anyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الغرفة. يمكن لأي شخص الاستماع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমটি খোলে। যে কেউ শুনতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la sala. Tothom pot escoltar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře místnost. Poslouchat může každý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner rummet. Alle kan lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Raum. Jeder kann zuhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει την αίθουσα. Ο καθένας μπορεί να ακούσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the room. Anyone can listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la sala. Cualquiera puede escuchar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa huoneen. Kuka tahansa voi kuunnella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le salon. Tout le monde peut écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את החדר. כל אחד יכול להאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम खोलता है। कोई भी सुन सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara sobu. Svatko može slušati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a szobát. Bárki hallgathat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka room. Siapa pun bisa mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la stanza. Chiunque può ascoltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームを開きます。誰でも聴けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸을 열어요. 누구나 들을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം തുറക്കുന്നു. ആർക്കും കേൾക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka bilik. Sesiapa boleh mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner rommet. Alle kan lytte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de room. Iedereen kan luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera pokój. Każdy może słuchać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a sala. Qualquer pessoa pode ouvir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a sala. Qualquer pessoa pode ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide camera. Oricine poate asculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает комнату. Слушать может любой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí miestnosť. Počúvať môže každý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar rummet. Alla kan lyssna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறையைத் திறக்கும். யார் வேண்டுமானாலும் கேட்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌ను తెరుస్తుంది. ఎవరైనా వినవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดห้อง ทุกคนฟังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odayı açar. Herkes dinleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває кімнату. Слухати може кожен."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم کھولتا ہے۔ کوئی بھی سن سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở phòng. Ai cũng có thể nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开房间。任何人都可以收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟聊天室。任何人都能收聽。"
          }
        }
      }
