    "error.invalidGif": {
      "comment": "400 invalid_gif (contract v27): the GIF is not in Sila's library and no provider can vouch for it — with no provider, only GIFs already in the library can be posted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نشر هذه الصورة المتحركة. احذفها أو اختر غيرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই GIF পোস্ট করা যাবে না। এটি সরিয়ে দিন, অথবা অন্যটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest GIF no es pot publicar. Elimina'l o tria'n un altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento GIF nelze zveřejnit. Odeber ho, nebo vyber jiný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den GIF kan ikke slås op. Fjern den, eller vælg en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses GIF kann nicht gepostet werden. Entferne es oder wähle ein anderes."
