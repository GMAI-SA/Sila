    "ds.textField.revealHint": {
      "comment": "VoiceOver hint on a secure field's reveal toggle. The %@ is the field's label.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدّل ظهور %@ على الشاشة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ স্ক্রিনে দেখা যাবে কি না তা বদলায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia si %@ és visible a la pantalla"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná, zda je %@ na obrazovce viditelné"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter mellem at vise og skjule %@ på skærmen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet um, ob %@ auf dem Bildschirm sichtbar ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλάσσει την ορατότητα του πεδίου %@ στην οθόνη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles whether the %@ is visible on screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna si %@ es visible en pantalla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaa, näkyykö %@ ruudulla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque %@ à l’écran"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף אם %@ גלוי על המסך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर %@ दिखे या नहीं, इसे बदलता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebacuje je li polje „%@” vidljivo na zaslonu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átváltja, hogy a(z) %@ látható legyen-e a képernyőn"
