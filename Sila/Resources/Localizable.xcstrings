    "guest.join.repost.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاركه مع من يتابعك، باسمك أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফলোয়ারদের সাথে নিজের নামে এটি শেয়ার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparteix-ho amb les persones que et segueixen, amb el teu nom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílej to s lidmi, kteří tě sledují, pod svým jménem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del det med dem, der følger dig, under dit eget navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile es unter deinem eigenen Namen mit den Menschen, die dir folgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιράσου το με όσους σε ακολουθούν, με το δικό σου όνομα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share it with the people who follow you, under your own name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compártela con quienes te siguen, con tu propio nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa se sinua seuraaville omalla nimelläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez-le avec vos abonnés, sous votre propre nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתף אותו עם האנשים שעוקבים אחריך, בשמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे अपने फ़ॉलोअर के साथ अपने नाम से शेयर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podijeli to s ljudima koji te prate, pod svojim imenom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd meg a követőiddel, a saját neveden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan ke orang yang mengikutimu, dengan namamu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividilo con chi ti segue, con il tuo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの名前で、フォロワーに共有しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 이름으로 나를 팔로우하는 사람들에게 공유하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളെ ഫോളോ ചെയ്യുന്നവരുമായി സ്വന്തം പേരിൽ ഇത് പങ്കിടുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsikannya dengan orang yang mengikut anda, atas nama anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del det med folkene som følger deg, under ditt eget navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel het met de mensen die je volgen, onder je eigen naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij to osobom, które Cię obserwują, pod własnym imieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe com quem segue você, com o seu próprio nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhe-a com quem o segue, com o seu próprio nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împărtășește-l cu cei care te urmăresc, sub propriul nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь с теми, кто подписан на вас, под своим именем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľaj to s ľuďmi, ktorí ťa sledujú, pod vlastným menom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela det med de som följer dig, under ditt eget namn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களைப் பின்தொடர்பவர்களுடன் உங்கள் சொந்தப் பெயரில் பகிருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిమ్మల్ని ఫాలో అయ్యేవారితో మీ స్వంత పేరుతో పంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ให้คนที่ติดตามคุณ ภายใต้ชื่อของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi takip edenlerle kendi adınız altında paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться цим із людьми, які на вас підписані, під власним іменем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے اپنے فالوورز کے ساتھ اپنے نام سے شیئر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ nó với những người theo dõi bạn, dưới tên của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你自己的名字，把它分享给关注你的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以你自己的名義，與追蹤你的人分享。"
          }
        }
      }
    },
