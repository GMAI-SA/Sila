        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 내 보증을 수락했어요. 본인이 맞는지 확인하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ നിങ്ങളുടെ ഉറപ്പ് സ്വീകരിച്ചു — അത് അവർ തന്നെയാണെന്ന് സ്ഥിരീകരിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menerima jaminan anda — sahkan itu mereka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godtok garantien din. Bekreft at det er vedkommende"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft je garantie geaccepteerd: bevestig dat hij of zij het is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przyjął(-ęła) Twoje poręczenie — potwierdź, że to ta osoba"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceitou seu aval: confirme que é a pessoa certa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceitou o seu aval — confirme que é essa pessoa"
