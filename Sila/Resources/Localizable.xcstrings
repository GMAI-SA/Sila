    "vouch.list.notOpen.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إتاحتها، يمكنك الوقوف خلف شخص تعرفه ريثما يوثّق هويته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি চালু হলে, কেউ নিজের পরিচয় ভেরিফাই করার সময় আপনি আপনার পরিচিত ব্যক্তির পাশে দাঁড়াতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan s'obri, podràs respondre per algú que coneixes mentre verifica la seva pròpia identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až se otevře, budeš se moci postavit za někoho, koho znáš, zatímco ověřuje vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det åbner, kan du stå inde for en, du kender, mens vedkommende verificerer sin egen identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald es öffnet, kannst du für jemanden einstehen, den du kennst, während die Person die eigene Identität verifiziert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ανοίξει, μπορείς να στηρίξεις κάποιον που γνωρίζεις όσο επαληθεύει την ταυτότητά του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it opens, you can stand behind someone you know while they verify their own identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se abra, podrás respaldar a alguien que conoces mientras verifica su propia identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun se avautuu, voit taata tuntemasi ihmisen, kun hän vahvistaa oman henkilöllisyytensä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand elle ouvrira, vous pourrez soutenir quelqu’un que vous connaissez pendant qu’il vérifie sa propre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשזה ייפתח, תוכל לעמוד מאחורי מישהו שאתה מכיר בזמן שהוא מאמת את זהותו בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब यह खुलेगा, तो आप किसी जानने वाले के पीछे खड़े हो सकेंगे जब तक वे अपनी पहचान खुद सत्यापित करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad se otvori, možeš stati iza nekoga koga poznaješ dok potvrđuje vlastiti identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor megnyílik, kezeskedhetsz valakiért, akit ismersz, amíg hitelesíti a saját személyazonosságát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat dibuka, kamu bisa berdiri di belakang orang yang kamu kenal selagi mereka memverifikasi identitasnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si apre, potrai garantire per qualcuno che conosci mentre verifica la propria identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始されると、知っている人が自分で本人確認をする間、その人の後ろ盾になれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열리면 직접 신원을 인증하는 동안 아는 사람을 보증할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് തുറക്കുമ്പോൾ, സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുന്നതിനിടെ നിങ്ങൾക്ക് അറിയാവുന്ന ഒരാളെ പിന്തുണയ്ക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila ia dibuka, anda boleh berdiri di belakang seseorang yang anda kenal semasa dia mengesahkan identitinya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det åpner, kan du stå bak noen du kjenner mens de verifiserer sin egen identitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra het opent, kun je instaan voor iemand die je kent terwijl diegene de eigen identiteit verifieert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy się otworzy, będziesz mógł poręczyć za kogoś, kogo znasz, dopóki nie zweryfikuje własnej tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando abrir, você poderá responder por alguém que conhece enquanto essa pessoa verifica a própria identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando abrir, poderá responder por alguém que conhece enquanto essa pessoa verifica a própria identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când se deschide, poți garanta pentru cineva pe care îl cunoști cât timp își verifică propria identitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда оно откроется, вы сможете поручиться за знакомого, пока он проходит собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa otvorí, budeš sa môcť zaručiť za niekoho, koho poznáš, kým si overuje vlastnú totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det öppnar kan du stå bakom någon du känner medan de verifierar sin egen identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது திறந்ததும், உங்களுக்குத் தெரிந்தவர் தன் அடையாளத்தைச் சரிபார்க்கும் வரை அவருக்குத் துணை நிற்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది తెరిచినప్పుడు, మీకు తెలిసిన వ్యక్తి తమ గుర్తింపును ధృవీకరించుకునే వరకు మీరు వారికి అండగా నిలబడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน คุณจะรับรองคนที่คุณรู้จักได้ ระหว่างที่เขายืนยันตัวตนของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıldığında, tanıdığınız biri kendi kimliğini doğrularken onun arkasında durabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли воно відкриється, ви зможете поручитися за того, кого знаєте, поки він верифікує власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب یہ کھلے گا تو آپ اپنے جاننے والے کے ساتھ کھڑے ہو سکیں گے جب تک وہ اپنی شناخت کی تصدیق کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi mở, bạn có thể đứng sau lưng người bạn quen trong lúc họ tự xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开放后，你可以在你认识的人验证自己身份期间为其担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開放後，你可以在你認識的人驗證自己身分期間為他們背書。"
          }
        }
      }
    },
