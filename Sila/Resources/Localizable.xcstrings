          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fio internacional. Qualquer conta verificada pode responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversa internacional. Qualquer conta verificada pode responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversație internațională. Orice cont verificat poate răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Международная ветка. Отвечать может любой проверенный аккаунт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzinárodné vlákno. Odpovedať môže každý overený účet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationell tråd. Alla verifierade konton kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சர்வதேச உரையாடல். சரிபார்க்கப்பட்ட எந்தக் கணக்கும் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతర్జాతీయ థ్రెడ్. ధృవీకరించబడిన ఏ ఖాతా అయినా రిప్లై ఇవ్వగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เธรดนานาชาติ บัญชีที่ยืนยันตัวตนแล้วใดก็ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uluslararası konuşma. Doğrulanmış her hesap yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міжнародне обговорення. Відповідати може будь-який верифікований обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بین الاقوامی تھریڈ۔ کوئی بھی تصدیق شدہ اکاؤنٹ جواب دے سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi quốc tế. Mọi tài khoản đã xác minh đều trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际对话串。任何已验证的账户都可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國際串文。任何已驗證的帳號都能回覆。"
          }
        }
      }
    },
