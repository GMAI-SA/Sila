    "groups.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوائم خاصة بأشخاص تحتفظ بها لتفتح لهم غرفًا. لا يُخبَر أحد بأنه فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রাখা মানুষদের প্রাইভেট তালিকা, রুম খোলার জন্য। কাউকে জানানো হয় না যে তারা কোনোটিতে আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llistes privades de persones que tens per obrir-los sales. Ningú no sap que hi és."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromé seznamy lidí, které si udržuješ, pro které otevíráš místnosti. Nikdo se nedozví, že je v nějakém."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Private lister over folk, du holder, til at åbne rum for. Ingen får besked om, at de er på en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Listen von Personen, die du führst, um Räume für sie zu öffnen. Niemand erfährt, dass er in einer ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ιδιωτικές λίστες ατόμων που κρατάς, για να ανοίγεις αίθουσες για αυτά. Κανείς δεν ενημερώνεται ότι βρίσκεται σε μία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private lists of people you keep, to open rooms for. Nobody is told they're in one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas privadas de personas que guardas, para abrirles salas. A nadie se le avisa de que está en una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityisiä luetteloita ihmisistä, joille avaat huoneita. Kenellekään ei kerrota, että hän on mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des listes privées de personnes que vous gardez, pour leur ouvrir des salons. Personne n’est prévenu d’en faire partie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימות פרטיות של אנשים שאתה שומר, כדי לפתוח עבורם חדרים. אף אחד לא מקבל הודעה שהוא באחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा रखी गई लोगों की प्राइवेट सूचियाँ, जिनके लिए रूम खोले जा सकें। किसी को नहीं बताया जाता कि वह किसी सूची में है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatni popisi ljudi koje čuvaš, za koje otvaraš sobe. Nitko nije obaviješten da je u nekoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Privát listák az emberekről, akikhez szobákat nyithatsz. Senki nem kap értesítést arról, hogy benne van egyben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar privat orang yang kamu simpan, untuk dibukakan room. Tidak ada yang diberi tahu bahwa mereka ada di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenchi privati di persone che tieni, per cui aprire stanze. Nessuno viene avvisato di essere in uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームを開く相手を管理する、非公開のリストです。リストに入っていることは、本人には知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸을 열 때 쓰는 나만의 비공개 사람 목록이에요. 목록에 포함된 사람에게는 알리지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമുകൾ തുറക്കാനായി നിങ്ങൾ സൂക്ഷിക്കുന്ന ആളുകളുടെ സ്വകാര്യ പട്ടികകൾ. ഒന്നിൽ ഉണ്ടെന്ന് ആരെയും അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai peribadi orang yang anda simpan, untuk dibukakan bilik. Tiada seorang pun diberitahu bahawa mereka ada dalam satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Private lister over folk du beholder, til å åpne rom for. Ingen får vite at de er med i en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privélijsten met mensen die je bewaart om rooms voor te openen. Niemand hoort dat ze erin staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatne listy osób, dla których możesz otwierać pokoje. Nikt nie wie, że na nich jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas privadas de pessoas, para abrir salas. Ninguém é avisado de que está em uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas privadas de pessoas que guarda, para abrir salas. Ninguém é avisado de que está numa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste private de oameni pe care le păstrezi, pentru a deschide camere pentru ei. Nimeni nu este anunțat că face parte dintr-una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные списки людей, для которых вы открываете комнаты. Никого не уведомляют, что он в списке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromné zoznamy ľudí, ktoré si uchovávaš, aby si pre ne otváral miestnosti. Nikomu sa nepovie, že v nejakom je."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Privata listor över personer du håller kontakt med, att öppna rum för. Ingen får veta att de finns i en."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைகளைத் திறப்பதற்காக நீங்கள் வைத்திருக்கும் மக்களின் தனிப்பட்ட பட்டியல்கள். ஒரு பட்டியலில் இருப்பது யாருக்கும் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లు తెరవడానికి మీరు ఉంచుకునే వ్యక్తుల ప్రైవేట్ జాబితాలు. ఒక జాబితాలో ఉన్నట్లు ఎవరికీ చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายชื่อส่วนตัวของคนที่คุณเก็บไว้เพื่อเปิดห้องให้ ไม่มีใครได้รับแจ้งว่าอยู่ในรายชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda açmak için sakladığınız özel kişi listeleri. Kimseye bir listede olduğu söylenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватні списки людей, яких ви ведете, щоб відкривати для них кімнати. Нікого не повідомляють, що він у такому списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوگوں کی نجی فہرستیں جو آپ رومز کھولنے کے لیے رکھتے ہیں۔ کسی کو نہیں بتایا جاتا کہ وہ ایک میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách riêng tư những người bạn giữ, để mở phòng cho họ. Không ai được báo là họ ở trong một nhóm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你保存的私人名单，用来开启房间。没有人会被告知自己在名单里。"
