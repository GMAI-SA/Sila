    "poll.anonymous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصويت سري. لا أحد، ولا حتى الكاتب، يرى من اختار ماذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভোট বেনামি। লেখকসহ কেউ দেখতে পায় না কে কী বেছেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els vots són anònims. Ningú, ni l'autor, veu qui ha triat què."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasy jsou anonymní. Nikdo, ani autor, nevidí, kdo co zvolil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmer er anonyme. Ingen, heller ikke forfatteren, kan se, hvem der valgte hvad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstimmungen sind anonym. Niemand, auch nicht der Autor, sieht, wer was gewählt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ψήφοι είναι ανώνυμες. Κανείς, ούτε ο συντάκτης, δεν βλέπει ποιος επέλεξε τι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Votes are anonymous. Nobody, including the author, sees who chose what."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los votos son anónimos. Nadie, ni siquiera el autor, ve quién eligió qué."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänet ovat nimettömiä. Kukaan, myöskään kirjoittaja, ei näe kuka valitsi mitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les votes sont anonymes. Personne, auteur compris, ne voit qui a choisi quoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצבעות אנונימיות. אף אחד, כולל הכותב, לא רואה מי בחר מה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वोट गुमनाम हैं। लेखक सहित कोई नहीं देखता कि किसने क्या चुना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovi su anonimni. Nitko, uključujući autora, ne vidi tko je što odabrao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavazatok névtelenek. Senki, a szerzőt is beleértve, nem látja, ki mit választott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara bersifat anonim. Tidak ada yang tahu siapa memilih apa, termasuk penulisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I voti sono anonimi. Nessuno, autore compreso, vede chi ha scelto cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投票は匿名です。投稿者を含め、誰が何を選んだかは誰にも見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투표는 익명이에요. 작성자를 포함해 누가 무엇을 골랐는지 아무도 볼 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോട്ടുകൾ അജ്ഞാതമാണ്. ആര് എന്ത് തിരഞ്ഞെടുത്തുവെന്ന് രചയിതാവ് ഉൾപ്പെടെ ആരും കാണില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Undi tanpa nama. Tiada sesiapa, termasuk penulis, melihat siapa memilih apa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmer er anonyme. Ingen, heller ikke forfatteren, ser hvem som valgte hva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen zijn anoniem. Niemand, ook de auteur niet, ziet wie wat heeft gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głosy są anonimowe. Nikt, także autor, nie widzi, kto co wybrał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os votos são anônimos. Ninguém, nem o autor, vê quem escolheu o quê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os votos são anónimos. Ninguém, nem o autor, vê quem escolheu o quê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Voturile sunt anonime. Nimeni, nici autorul, nu vede cine ce a ales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосование анонимное. Никто, включая автора, не видит, кто что выбрал."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasy sú anonymné. Nikto, ani autor, nevidí, kto čo vybral."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röster är anonyma. Ingen, inte ens skribenten, ser vem som valde vad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாக்குகள் பெயரில்லாதவை. ஆசிரியர் உட்பட யாருக்கும் யார் எதைத் தேர்ந்தெடுத்தார் என்று தெரியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఓట్లు అజ్ఞాతం. రచయితతో సహా ఎవరూ ఎవరు ఏది ఎంచుకున్నారో చూడలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโหวตไม่ระบุชื่อ ไม่มีใคร รวมถึงผู้เขียน เห็นว่าใครเลือกอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylar anonimdir. Yazar dahil kimse kimin neyi seçtiğini görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голоси анонімні. Ніхто, зокрема й автор, не бачить, хто що вибрав."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ووٹ گمنام ہیں۔ مصنف سمیت کوئی نہیں دیکھ سکتا کہ کس نے کیا چنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiếu bầu ẩn danh. Không ai, kể cả tác giả, thấy ai đã chọn gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投票是匿名的。包括作者在内，没有人能看到谁选了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投票為匿名。包括作者在內，沒有人看得到誰選了什麼。"
          }
        }
      }
    },
