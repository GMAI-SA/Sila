    "feed.fab.post.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لكتابة منشور، أو اضغط مطولًا للمزيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্ট লিখতে ট্যাপ করুন। আরও দেখতে চেপে ধরুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per escriure una publicació. Mantén premut per veure'n més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím napíšeš příspěvek. Podržením zobrazíš další možnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at skrive et opslag. Hold nede for mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um einen Beitrag zu schreiben. Halten für mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε για να γράψεις ανάρτηση. Κράτησε πατημένο για περισσότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to write a post. Hold for more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para escribir una publicación. Mantén pulsado para ver más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kirjoittaaksesi julkaisun. Pidä painettuna nähdäksesi lisää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour écrire un post. Maintenez pour plus d’options."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי לכתוב פוסט. החזק לעוד אפשרויות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट लिखने के लिए टैप करें। और विकल्पों के लिए दबाए रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za pisanje objave. Drži za više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a bejegyzés írásához. Tartsd lenyomva a továbbiakhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk menulis postingan. Tahan untuk opsi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per scrivere un post. Tieni premuto per altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして投稿を書きます。長押しでその他の操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 게시물을 작성해요. 길게 누르면 더 많은 옵션이 나와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റ് എഴുതാൻ ടാപ്പ് ചെയ്യുക. കൂടുതലിന് അമർത്തിപ്പിടിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk menulis siaran. Tahan untuk lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å skrive et innlegg. Trykk og hold for mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om een bericht te schrijven. Houd ingedrukt voor meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby napisać wpis. Przytrzymaj, aby zobaczyć więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para escrever um post. Mantenha pressionado para ver mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para escrever uma publicação. Mantenha premido para mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a scrie o postare. Ține apăsat pentru mai multe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь, чтобы написать пост. Удерживайте для других действий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím napíšeš príspevok. Podržaním zobrazíš viac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att skriva ett inlägg. Håll ned för fler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகை எழுத தட்டுங்கள். மேலும் பார்க்க அழுத்திப் பிடியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్ రాయడానికి ట్యాప్ చేయండి. మరిన్నింటికి నొక్కి పట్టుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเขียนโพสต์ กดค้างเพื่อดูเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderi yazmak için dokunun. Daha fazlası için basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб написати допис. Утримуйте, щоб побачити більше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسٹ لکھنے کے لیے ٹیپ کریں۔ مزید کے لیے دبائے رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để viết bài đăng. Giữ để xem thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点撰写帖子，长按查看更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點以撰寫貼文，按住可看更多選項。"
          }
        }
      }
    },
