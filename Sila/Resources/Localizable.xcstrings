    "auth.otp.resendFailed": {
      "comment": "Toast when a resend fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال رمز جديد. أعد المحاولة."
