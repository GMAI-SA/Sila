    "feed.subject.muted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أخفيت هذا الموضوع. أظهره من التفضيلات لتراه مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই বিষয়টি লুকিয়েছেন। আবার দেখতে পছন্দে গিয়ে এটি দেখান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has amagat aquest tema. Deixa d'amagar-lo a Preferències per tornar-lo a veure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto téma jsi skryl. Zobraz ho znovu v Předvolbách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skjulte dette emne. Vis det igen under Præferencer for at se det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dieses Thema ausgeblendet. Blende es in den Einstellungen wieder ein, um es erneut zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έκρυψες αυτό το θέμα. Επανάφερέ το στις Προτιμήσεις για να το δεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hid this subject. Unhide it in Preferences to see it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultaste este tema. Vuelve a mostrarlo en Preferencias para verlo otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotit tämän aiheen. Näytä se uudelleen Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez masqué ce sujet. Réaffichez-le dans les Préférences pour le revoir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסתרת את הנושא הזה. בטל את ההסתרה בהעדפות כדי לראות אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने यह विषय छिपाया था। इसे फिर देखने के लिए प्राथमिकताओं में दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrio/la si ovu temu. Otkrij je u Postavkama da je ponovno vidiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejtetted ezt a témát. A Beállításokban visszaállíthatod, hogy újra lásd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menyembunyikan topik ini. Tampilkan lagi di Preferensi untuk melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai nascosto questo argomento. Mostralo di nuovo nelle Preferenze per vederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この分野を非表示にしています。再び表示するには、設定で非表示を解除してください。"
