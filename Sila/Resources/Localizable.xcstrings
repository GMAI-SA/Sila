    "rooms.recap.listeners": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %1$@ مستمعًا معًا، و%2$@ إجمالًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে সর্বোচ্চ %1$@ জন শুনেছেন, মোট %2$@ জন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a %1$@ escoltant alhora, %2$@ en total"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až %1$@ posluchačů najednou, celkem %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %1$@ lyttede på én gang, %2$@ i alt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %1$@ gleichzeitig dabei, insgesamt %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως %1$@ ακροατές ταυτόχρονα, %2$@ συνολικά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %1$@ listening at once, %2$@ in all"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %1$@ escuchando a la vez, %2$@ en total"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enimmillään %1$@ kuuntelijaa yhtä aikaa, yhteensä %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %1$@ à l’écoute en même temps, %2$@ au total"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד %1$@ מאזינים בו-זמנית, %2$@ בסך הכול"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ अधिकतम %1$@ सुन रहे थे, कुल %2$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše %1$@ slušatelja odjednom, ukupno %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre legfeljebb %1$@ hallgató, összesen %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga %1$@ mendengarkan sekaligus, %2$@ secara keseluruhan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %1$@ in ascolto contemporaneamente, %2$@ in tutto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大%1$@人が同時に聴取、のべ%2$@人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동시 청취 최대 %1$@명, 총 %2$@명"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരേസമയം പരമാവധി %1$@ പേർ കേട്ടു, ആകെ %2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga %1$@ mendengar serentak, %2$@ keseluruhannya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %1$@ lyttet samtidig, %2$@ til sammen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot %1$@ tegelijk luisteraars, %2$@ in totaal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalnie %1$@ słuchaczy naraz, łącznie %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@ ouvindo ao mesmo tempo, %2$@ no total"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@ a ouvir em simultâneo, %2$@ no total"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la %1$@ ascultători simultan, %2$@ în total"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно слушали до %1$@, всего — %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naraz počúvalo až %1$@, spolu %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %1$@ lyssnade samtidigt, %2$@ totalt"
