    "auth.wall.pendingReview.message": {
      "comment": "Wall body while a reviewer decides.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستنداتك لدى المراجعين. معظم القرارات تصدر خلال ساعات قليلة، وسيصلك بريد إلكتروني في الحالتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নথি আমাদের রিভিউয়ারদের কাছে আছে। বেশির ভাগ সিদ্ধান্ত কয়েক ঘণ্টার মধ্যেই আসে; যাই হোক, আপনি ইমেইল পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus documents són amb els nostres revisors. La majoria de decisions arriben en unes hores; rebràs un correu en qualsevol cas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé dokumenty jsou u našich posuzovatelů. Většina rozhodnutí přijde během několika hodin; dostaneš e-mail v obou případech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine dokumenter er hos vores gennemgåede. De fleste afgørelser falder inden for få timer, og du får en e-mail uanset udfaldet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dokumente liegen bei unseren Prüfern. Die meisten Entscheidungen fallen innerhalb weniger Stunden; du bekommst in jedem Fall eine E-Mail."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα έγγραφά σου βρίσκονται στους ελεγκτές μας. Οι περισσότερες αποφάσεις βγαίνουν μέσα σε λίγες ώρες· θα λάβεις email είτε έτσι είτε αλλιώς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your documents are with our reviewers. Most decisions land within a few hours; you'll get an email either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus documentos están con nuestros revisores. La mayoría de las decisiones llegan en unas horas; recibirás un correo en cualquier caso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjasi ovat tarkastajiemme käsissä. Useimmat päätökset tulevat muutamassa tunnissa, ja saat sähköpostin kummassakin tapauksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos documents sont entre les mains de nos vérificateurs. La plupart des décisions arrivent en quelques heures ; vous recevrez un e-mail dans tous les cas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמכים שלך אצל הבודקים שלנו. רוב ההחלטות מתקבלות תוך כמה שעות; תקבל דוא״ל בכל מקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दस्तावेज़ हमारे समीक्षकों के पास हैं। ज़्यादातर फ़ैसले कुछ घंटों में आ जाते हैं; किसी भी हाल में आपको ईमेल मिलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji dokumenti su kod naših recenzenata. Većina odluka stiže u nekoliko sati; dobit ćeš e-poštu u svakom slučaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányaid az elbírálóinknál vannak. A legtöbb döntés néhány órán belül megszületik; így vagy úgy, e-mailt kapsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumenmu sedang ditangani peninjau kami. Sebagian besar keputusan keluar dalam beberapa jam; kamu akan menerima email apa pun hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi documenti sono dai nostri revisori. La maggior parte delle decisioni arriva entro poche ore; riceverai comunque un'email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類は審査担当者が確認中です。ほとんどの判断は数時間以内に出ます。結果はどちらの場合もメールでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 검토자에게 전달되었어요. 대부분 몇 시간 안에 결정이 나오며, 결과는 이메일로 알려드려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖകൾ ഞങ്ങളുടെ റിവ്യൂവർമാരുടെ പക്കലുണ്ട്. മിക്ക തീരുമാനങ്ങളും ഏതാനും മണിക്കൂറിനുള്ളിൽ വരും; ഏതായാലും നിങ്ങൾക്ക് ഇമെയിൽ ലഭിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen anda sedang bersama penyemak kami. Kebanyakan keputusan siap dalam beberapa jam; anda akan menerima emel sama ada cara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentene dine er hos de som vurderer dem. De fleste avgjørelser kommer i løpet av noen timer, og du får en e-post uansett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je documenten liggen bij onze beoordelaars. De meeste beslissingen vallen binnen een paar uur; je krijgt in beide gevallen een e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dokumenty są u weryfikatorów. Większość decyzji zapada w ciągu kilku godzin; w obu przypadkach dostaniesz e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus documentos estão com nossos analistas. A maioria das decisões sai em poucas horas, e você receberá um e-mail de qualquer forma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus documentos estão com os nossos revisores. A maioria das decisões chega em poucas horas; receberá um email em qualquer dos casos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentele tale sunt la evaluatorii noștri. Majoritatea deciziilor vin în câteva ore; vei primi un e-mail în ambele cazuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши документы у проверяющих. Большинство решений принимается за несколько часов; в любом случае вы получите письмо."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje doklady sú u našich posudzovateľov. Väčšina rozhodnutí príde do pár hodín; e-mail dostaneš v oboch prípadoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina dokument ligger hos våra granskare. De flesta beslut kommer inom några timmar, och du får ett e-postmeddelande oavsett utfall."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணங்கள் எங்கள் மதிப்பாய்வாளர்களிடம் உள்ளன. பெரும்பாலான முடிவுகள் சில மணி நேரங்களில் வரும்; எந்த முடிவானாலும் மின்னஞ்சல் வரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రాలు మా సమీక్షకుల వద్ద ఉన్నాయి. చాలా నిర్ణయాలు కొన్ని గంటల్లో వస్తాయి; ఎలాగైనా మీకు ఈమెయిల్ వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารของคุณอยู่กับผู้ตรวจสอบของเรา การตัดสินส่วนใหญ่เสร็จภายในไม่กี่ชั่วโมง และคุณจะได้รับอีเมลไม่ว่าผลจะเป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgeleriniz inceleyicilerimizde. Kararların çoğu birkaç saat içinde çıkar; hangi sonuç olursa olsun size e-posta gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші документи в наших перевіряльників. Більшість рішень ухвалюється за кілька годин; ви отримаєте лист у будь-якому разі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے دستاویز ہمارے جائزہ کاروں کے پاس ہیں۔ زیادہ تر فیصلے چند گھنٹوں میں ہو جاتے ہیں؛ نتیجہ جو بھی ہو آپ کو ای میل ملے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy tờ của bạn đang ở chỗ người xét duyệt. Hầu hết quyết định có trong vài giờ; bạn sẽ nhận email dù kết quả thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件正在由审核员处理。大多数决定会在几小时内作出，无论结果如何，你都会收到邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件正由審核人員處理。多數決定會在幾小時內完成，無論結果如何，你都會收到電子郵件。"
          }
        }
      }
    },
