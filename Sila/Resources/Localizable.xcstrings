    "safety.reason.illegal.detail": {
      "comment": "What the illegal reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتيال أو اتجار أو أي شيء آخر مخالف للقانون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জালিয়াতি, পাচার, বা আইনবিরুদ্ধ অন্য কিছু।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Frau, tràfic o qualsevol altra cosa contrària a la llei."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podvod, obchodování s lidmi nebo cokoli jiného protizákonného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svindel, menneskehandel eller andet, der er imod loven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrug, Menschenhandel oder alles andere, was gegen das Gesetz verstößt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απάτη, εμπορία ή οτιδήποτε άλλο παράνομο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraud, trafficking, or anything else against the law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraude, trata o cualquier otra cosa contraria a la ley."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Petos, ihmiskauppa tai mikä tahansa muu laiton."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraude, traite, ou tout ce qui est contraire à la loi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הונאה, סחר, או כל דבר אחר שמנוגד לחוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धोखाधड़ी, तस्करी, या कुछ भी और जो क़ानून के ख़िलाफ़ है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijevara, trgovina ljudima ili bilo što drugo protuzakonito."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csalás, emberkereskedelem, vagy bármi más, ami törvénybe ütközik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penipuan, perdagangan manusia, atau apa pun yang melanggar hukum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frode, traffico di persone o qualsiasi altra cosa contro la legge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詐欺、人身取引、その他の違法行為。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사기, 인신매매 또는 그 밖의 불법 행위."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തട്ടിപ്പ്, കടത്ത്, അല്ലെങ്കിൽ നിയമവിരുദ്ധമായ മറ്റെന്തും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penipuan, pemerdagangan, atau apa-apa lagi yang bertentangan dengan undang-undang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svindel, menneskehandel eller noe annet som er mot loven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraude, mensenhandel of iets anders wat tegen de wet is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszustwo, handel ludźmi lub cokolwiek innego niezgodnego z prawem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraude, tráfico ou qualquer outra coisa contra a lei."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraude, tráfico ou qualquer outra coisa contra a lei."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraudă, trafic sau orice altceva împotriva legii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мошенничество, торговля людьми или что-либо ещё, противоречащее закону."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podvod, obchodovanie s ľuďmi alebo čokoľvek iné, čo je protizákonné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrägeri, människohandel eller annat som strider mot lagen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மோசடி, ஆள்கடத்தல் அல்லது சட்டத்துக்கு எதிரான வேறு எதுவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోసం, అక్రమ రవాణా, లేదా చట్టవిరుద్ధమైన మరేదైనా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฉ้อโกง การค้ามนุษย์ หรืออย่างอื่นที่ผิดกฎหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolandırıcılık, insan ticareti veya yasalara aykırı başka her şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шахрайство, торгівля людьми чи будь-що інше, що суперечить закону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دھوکہ دہی، انسانی اسمگلنگ، یا قانون کے خلاف کوئی اور چیز۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lừa đảo, buôn người, hoặc bất cứ điều gì khác trái pháp luật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欺诈、贩运，或任何其他违法行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詐騙、人口販運，或任何其他違法行為。"
          }
        }
      }
    },
