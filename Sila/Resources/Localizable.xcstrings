    "document.type.passport.detail": {
      "comment": "Document option detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أي دولة. صفحة الصورة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো দেশের। শুধু ছবির পাতা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol país. Només la pàgina de la foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z kterékoli země. Jen stránka s fotografií."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra et hvilket som helst land. Kun fotosiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Land. Nur die Fotoseite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οποιαδήποτε χώρα. Μόνο η σελίδα με τη φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any country. The photo page only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cualquier país. Solo la página de la foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tahansa maa. Vain kuvasivu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quel pays. Page photo uniquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכל מדינה. עמוד התמונה בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी देश। केवल फ़ोटो वाला पन्ना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo koja zemlja. Samo stranica s fotografijom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely ország. Csak a fotóoldal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Negara mana pun. Hanya halaman foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qualsiasi paese. Solo la pagina con la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの国のものでも可。写真ページのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 국가. 사진 페이지만."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് രാജ്യത്തേതും. ഫോട്ടോ പേജ് മാത്രം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mana-mana negara. Halaman foto sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle land. Bare bildesiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk land. Alleen de fotopagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolny kraj. Tylko strona ze zdjęciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer país. Só a página da foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer país. Apenas a página da fotografia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din orice țară. Doar pagina cu fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая страна. Только страница с фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktorákoľvek krajina. Iba strana s fotkou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket land som helst. Bara fotosidan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த நாடும். புகைப்பக்கம் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ దేశానిదైనా. ఫోటో పేజీ మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของประเทศใดก็ได้ เฉพาะหน้ารูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir ülke. Yalnızca fotoğraf sayfası."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-якої країни. Лише сторінка з фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی ملک۔ صرف تصویر والا صفحہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Của bất kỳ quốc gia nào. Chỉ trang ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何国家，仅需照片页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何國家，只需照片頁。"
          }
        }
      }
    },
