    "verification.start.hint": {
      "comment": "A11y hint on the Start button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل رقمك إلى نفاذ ويعرض الرقم الذي ستضغطه في تطبيق نفاذ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নম্বর Nafath-এ পাঠায় এবং Nafath অ্যাপে ট্যাপ করার নম্বরটি দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia el teu número a Nafath i mostra el número que has de tocar a l'app Nafath"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle tvé číslo do Nafath a zobrazí číslo, které klepneš v aplikaci Nafath"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dit nummer til Nafath og viser det nummer, du skal trykke på i Nafath-appen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet deine Nummer an Nafath und zeigt die Nummer, die du in der Nafath-App antippen musst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει τον αριθμό σου στο Nafath και εμφανίζει τον αριθμό που θα πατήσεις στην εφαρμογή Nafath"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your number to Nafath and shows the number to tap in the Nafath app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu número a Nafath y muestra el número que debes tocar en la app de Nafath"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää numerosi Nafathille ja näyttää numeron, jota napautetaan Nafath-sovelluksessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie votre numéro à Nafath et affiche le numéro à toucher dans l’app Nafath"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את המספר שלך ל-Nafath ומציג את המספר להקשה באפליקציית Nafath"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नंबर Nafath को भेजता है और Nafath ऐप में टैप करने का नंबर दिखाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje tvoj broj Nafathu i prikazuje broj koji treba dodirnuti u aplikaciji Nafath"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi a számodat a Nafathnak, és megmutatja a Nafath appban megkoppintandó számot"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim nomormu ke Nafath dan menampilkan nomor untuk diketuk di app Nafath"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il tuo numero a Nafath e mostra il numero da toccare nell'app Nafath"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号をNafathに送信し、Nafathアプリでタップする番号を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호를 Nafath로 보내고 Nafath 앱에서 탭할 번호를 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നമ്പർ Nafath-ലേക്ക് അയയ്ക്കുകയും Nafath ആപ്പിൽ ടാപ്പ് ചെയ്യേണ്ട നമ്പർ കാണിക്കുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar nombor anda kepada Nafath dan memaparkan nombor untuk diketik dalam app Nafath"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender nummeret ditt til Nafath og viser nummeret du skal trykke på i Nafath-appen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt je nummer naar Nafath en toont het nummer waarop je in de Nafath-app moet tikken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła Twój numer do Nafath i pokazuje numer do stuknięcia w aplikacji Nafath"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia seu número ao Nafath e mostra o número a tocar no app Nafath"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
