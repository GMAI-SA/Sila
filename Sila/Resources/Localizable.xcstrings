        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím otvoríš miestnosť. Podržaním zobrazíš viac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att öppna ett rum. Håll ned för fler."
