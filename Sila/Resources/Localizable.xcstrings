    "error.verificationUnavailable": {
      "comment": "503 verification_unavailable.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توثيق الهوية غير متاح مؤقتًا. حاول مرة أخرى بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয় যাচাই সাময়িকভাবে বন্ধ আছে। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificació d'identitat no està disponible temporalment. Torna-ho a provar d'aquí a una estona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření totožnosti je dočasně nedostupné. Zkus to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitetsverificering er midlertidigt utilgængelig. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identitätsprüfung ist vorübergehend nicht verfügbar. Versuche es in Kürze erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επαλήθευση ταυτότητας δεν είναι προσωρινά διαθέσιμη. Δοκίμασε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity verification is temporarily unavailable. Try again in a little while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de identidad no está disponible temporalmente. Inténtalo de nuevo en un rato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyyden vahvistus ei ole tilapäisesti käytettävissä. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification d’identité est temporairement indisponible. Réessayez dans un moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימות הזהות אינו זמין זמנית. נסה שוב בעוד זמן קצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान सत्यापन अभी अस्थायी रूप से उपलब्ध नहीं है। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjera identiteta privremeno nije dostupna. Pokušaj ponovno za malo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A személyazonosság hitelesítése átmenetileg nem érhető el. Próbáld újra egy kis idő múlva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi identitas sementara tidak tersedia. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica dell'identità non è temporaneamente disponibile. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認は一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원 인증을 일시적으로 사용할 수 없어요. 잠시 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐഡന്റിറ്റി പരിശോധന താൽക്കാലികമായി ലഭ്യമല്ല. കുറച്ച് കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
