    "vouch.claim.details.hint": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبها كما هي في هويتك. تُقارَن فقط بما أدخله ⁦@%@⁩."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আইডিতে যেমন আছে তেমন লিখুন। শুধু @%@-এর দেওয়া তথ্যের সাথে এগুলো মেলানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu-les tal com són al teu document. Només es comparen amb el que va introduir @%@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš je tak, jak jsou na tvém dokladu. Porovnávají se jen s tím, co zadal @%@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dem, som de står på dit id. De sammenlignes kun med det, @%@ indtastede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe sie so, wie sie in deinem Ausweis stehen. Sie werden nur mit dem verglichen, was @%@ eingegeben hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψε τα όπως είναι στην ταυτότητά σου. Συγκρίνονται μόνο με όσα εισήγαγε ο/η @%@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write them as they are on your ID. They're only compared with what @%@ entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelos tal como figuran en tu documento. Solo se comparan con lo que introdujo @%@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita ne kuten henkilöllisyystodistuksessasi. Niitä verrataan vain siihen, mitä @%@ antoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez-les comme sur votre pièce d’identité. Elles sont seulement comparées à ce que @%@ a saisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתוב אותם כפי שהם בתעודת הזהות שלך. הם מושווים רק למה ש-@%@ הזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें वैसे ही लिखें जैसे आपकी ID पर हैं। इनकी तुलना सिर्फ़ उससे होती है जो @%@ ने दर्ज किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši ih kako stoje na tvojoj ispravi. Uspoređuju se samo s onim što je unio/unijela @%@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy írd, ahogy az azonosítódon áll. Csak azzal vetjük össze, amit @%@ megadott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis seperti di ID-mu. Detail ini hanya dibandingkan dengan yang dimasukkan @%@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivili come sul tuo documento. Vengono solo confrontati con ciò che ha inserito @%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDに記載のとおりに入力してください。@%@が入力した内容とだけ照合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증에 적힌 대로 입력하세요. @%@님이 입력한 내용과 비교하는 데만 쓰여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഐഡിയിലുള്ളതുപോലെ എഴുതുക. @%@ നൽകിയതുമായി മാത്രമേ ഇവ താരതമ്യം ചെയ്യൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis seperti yang tertera pada ID anda. Ia hanya dibandingkan dengan apa yang @%@ masukkan."
          }
