    "people.picker.known.noMatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد ممن تعرفهم يطابق. تابع الكتابة للبحث عن الجميع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চেনা কেউ মিলছে না। সবার মধ্যে খুঁজতে লিখতে থাকুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap persona que coneixes coincideix. Continua escrivint per cercar entre tothom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo, koho znáš, neodpovídá. Piš dál a hledej mezi všemi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen, du kender, matcher. Skriv videre for at søge blandt alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand, den du kennst, passt. Tippe weiter, um alle zu durchsuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς από όσους γνωρίζεις δεν ταιριάζει. Συνέχισε να πληκτρολογείς για να αναζητήσεις όλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody you know matches. Keep typing to search everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna persona que conoces coincide. Sigue escribiendo para buscar entre todos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan tuntemasi ei täsmää. Jatka kirjoittamista hakeaksesi kaikkien joukosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune personne connue ne correspond. Continuez à taper pour chercher parmi tous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד שאתה מכיר לא תואם. המשך להקליד כדי לחפש בין כולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जानने वालों में कोई मेल नहीं खाता। सबमें खोजने के लिए टाइप करते रहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko koga znaš ne odgovara. Nastavi tipkati da pretražiš sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik ismerősöd sem egyezik. Írj tovább, hogy mindenkiben keress."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada orang yang kamu kenal yang cocok. Terus ketik untuk mencari semua orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna persona che conosci corrisponde. Continua a scrivere per cercare tra tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っている人に一致する人はいません。入力を続けると、全員から検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 아는 사람이 없어요. 계속 입력하면 모든 사람 중에서 검색해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കറിയാവുന്ന ആരും ഒത്തുവരുന്നില്ല. എല്ലാവരിലും തിരയാൻ ടൈപ്പ് ചെയ്യുന്നത് തുടരുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada orang yang anda kenal yang sepadan. Teruskan menaip untuk mencari semua orang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen du kjenner passer. Fortsett å skrive for å søke blant alle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand die je kent komt overeen. Blijf typen om iedereen te doorzoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna znana Ci osoba nie pasuje. Pisz dalej, aby szukać wśród wszystkich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém que você conhece corresponde. Continue digitando para buscar entre todos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém que conheça corresponde. Continue a escrever para pesquisar todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni din cei pe care îi cunoști nu se potrivește. Continuă să scrii pentru a căuta printre toți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди знакомых совпадений нет. Продолжайте вводить, чтобы искать среди всех."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto z tvojich známych nevyhovuje. Píš ďalej a hľadaj medzi všetkými."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen du känner matchar. Fortsätt skriva för att söka bland alla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தெரிந்தவர்களில் யாரும் பொருந்தவில்லை. அனைவரிலும் தேட தட்டச்சு செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు తెలిసిన వారిలో ఎవరూ సరిపోలడం లేదు. అందరిలో వెతకడానికి టైప్ చేస్తూ ఉండండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีคนที่คุณรู้จักที่ตรงกัน พิมพ์ต่อเพื่อค้นหาทุกคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıdığınız kimse eşleşmiyor. Herkesi aramak için yazmaya devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден зі знайомих не підходить. Продовжуйте вводити, щоб шукати серед усіх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جاننے والوں میں کوئی نہیں ملتا۔ سب میں تلاش کرنے کے لیے ٹائپ کرتے رہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có người quen nào khớp. Hãy tiếp tục gõ để tìm tất cả mọi người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你认识的人中没有匹配项。继续输入可搜索所有人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你認識的人中沒有符合的。繼續輸入以搜尋所有人。"
          }
        }
      }
    },
