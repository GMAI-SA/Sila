    "account.email.row.action": {
      "comment": "Action on the email row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change"
          }
        }
      }
    },
    "account.email.row.detail": {
      "comment": "What changing the email requires.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان الذي تسجّل الدخول به. تغييره يحتاج كلمة مرورك ورمزًا يُرسل إلى العنوان الجديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address you sign in with. Changing it needs your password and a code sent to the new address."
          }
        }
      }
    },
    "account.email.row.hint": {
      "comment": "VoiceOver hint for the email row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تغيير البريد المكوّن من خطوتين"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the two-step email change"
          }
        }
      }
    },
    "account.email.row.title": {
      "comment": "Settings row: the sign-in address.",
      "extractionState": "manual",
      "localizations": {
