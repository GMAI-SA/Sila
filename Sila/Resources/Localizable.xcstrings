          "stringUnit": {
            "state": "translated",
            "value": "מישהו כבר ערב לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आपके लिए पहले से वाउच कर रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
