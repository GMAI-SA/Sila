        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आने वाला इवेंट नहीं है। एक शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema nadolazećih događaja. Pokreni jedan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs közelgő esemény. Indíts egyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada acara mendatang. Buat satu."
          }
        },
