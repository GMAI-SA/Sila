    },
    "discover.needsReply.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل منشور حديث يمكنك الرد عليه قد حصل على رد. عد لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি উত্তর দিতে পারেন এমন সব সাম্প্রতিক পোস্টের উত্তর আছে। পরে আবার আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les publicacions recents a les quals pots respondre ja tenen resposta. Torna més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý nedávný příspěvek, na který můžeš odpovědět, už odpověď má. Vrať se později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert nyligt opslag, du kan svare på, har fået et svar. Kom tilbage senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder aktuelle Beitrag, den du beantworten kannst, hat eine Antwort. Schau später wieder vorbei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε πρόσφατη ανάρτηση που μπορείς να απαντήσεις έχει απάντηση. Έλα ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every recent post you can answer has an answer. Come back later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las publicaciones recientes que puedes responder ya tienen respuesta. Vuelve más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaiseen tuoreeseen julkaisuun, johon voit vastata, on jo vastattu. Palaa myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque post récent auquel vous pouvez répondre a une réponse. Revenez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל פוסט אחרון שאתה יכול להשיב לו יש תשובה. חזור מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिन हाल की पोस्ट का जवाब दे सकते हैं, सबका जवाब आ चुका है। बाद में आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka nedavna objava na koju možeš odgovoriti već ima odgovor. Vrati se kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden friss bejegyzésre, amelyre válaszolhatsz, már van válasz. Nézz vissza később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua postingan terbaru yang bisa kamu jawab sudah dijawab. Kembali lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni post recente a cui puoi rispondere ha già una risposta. Torna più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信できる最近の投稿には、すべて返信があります。またあとで見に来てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글을 달 수 있는 최근 게시물에 모두 답글이 달렸어요. 나중에 다시 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് മറുപടി നൽകാവുന്ന എല്ലാ പുതിയ പോസ്റ്റുകൾക്കും മറുപടിയുണ്ട്. പിന്നീട് വരൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap siaran terkini yang boleh anda jawab sudah ada jawapan. Datang semula nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle nyere innlegg du kan svare på, har fått svar. Kom tilbake senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op elk recent bericht waarop je kunt reageren is al gereageerd. Kom later terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na każdy ostatni wpis, na który możesz odpowiedzieć, ktoś już odpowiedział. Wróć później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo post recente que você pode responder já tem resposta. Volte mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as publicações recentes a que pode responder já têm resposta. Volte mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare postare recentă la care poți răspunde are un răspuns. Revino mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каждый недавний пост, где вы можете ответить, уже есть ответ. Загляните позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý nedávny príspevok, na ktorý môžeš odpovedať, už odpoveď má. Vráť sa neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla nya inlägg du kan svara på har fått svar. Kom tillbaka senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிலளிக்கக்கூடிய ஒவ்வொரு சமீபத்திய இடுகைக்கும் பதில் உள்ளது. பிறகு வாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమాధానం ఇవ్వగల ప్రతి ఇటీవలి పోస్ట్‌కు సమాధానం ఉంది. తర్వాత మళ్లీ రండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกโพสต์ล่าสุดที่คุณตอบได้มีคนตอบแล้ว กลับมาใหม่ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlayabileceğiniz her yeni gönderinin bir yanıtı var. Daha sonra tekrar gelin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожен свіжий допис, на який ви можете відповісти, уже є відповідь. Зазирніть пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جن حالیہ پوسٹس کا جواب دے سکتے ہیں ان سب کا جواب آ چکا ہے۔ بعد میں دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi bài đăng gần đây bạn có thể trả lời đều đã có người trả lời. Hãy quay lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你能回答的近期帖子都已有回复。稍后再来看看。"
          }
        },
