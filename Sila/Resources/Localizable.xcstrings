    "rooms.listening.subtitle": {
      "comment": "What listening means, said without apology. Names the fact that no microphone is involved, which is why Sila never asks a listener for one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمع كل شيء. الميكروفون غير مستخدم، ومعروف لم يطلبه أصلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সবকিছু শুনতে পাচ্ছেন। আপনার মাইক্রোফোন ব্যবহার হচ্ছে না, আর Known তা চায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho pots sentir tot. El micròfon no s'està fent servir i Known no l'ha demanat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slyšíš vše. Tvůj mikrofon se nepoužívá a Known o něj nežádala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan høre alt. Din mikrofon er ikke i brug, og Known har ikke bedt om den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst alles. Dein Mikrofon ist nicht in Benutzung, und Known hat nicht danach gefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούς τα πάντα. Το μικρόφωνό σου δεν χρησιμοποιείται και το Known δεν το έχει ζητήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hear everything. Your microphone is not in use and Known hasn't asked for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes oír todo. Tu micrófono no está en uso y Known no lo ha pedido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuulet kaiken. Mikrofoniasi ei käytetä, eikä Known ole pyytänyt sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous entendez tout. Votre micro n’est pas utilisé et Known ne l’a pas demandé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה שומע הכול. המיקרופון שלך לא בשימוש ו-Known לא ביקשה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सब सुन सकते हैं। आपका माइक्रोफ़ोन इस्तेमाल में नहीं है और Known ने उसे माँगा भी नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuješ sve. Tvoj mikrofon se ne koristi i Known ga nije zatražila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindent hallasz. A mikrofonod nincs használatban, és a Known nem kérte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa mendengar semuanya. Mikrofonmu tidak dipakai dan Known tidak memintanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi sentire tutto. Il tuo microfono non è in uso e Known non lo ha richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて聞こえます。マイクは使われておらず、Knownが求めることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 들을 수 있어요. 마이크는 사용 중이 아니며 Known은 마이크를 요청하지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് എല്ലാം കേൾക്കാം. നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗത്തിലില്ല, Known അത് ആവശ്യപ്പെട്ടിട്ടുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mendengar semuanya. Mikrofon anda tidak digunakan dan Known tidak memintanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan høre alt. Mikrofonen din er ikke i bruk, og Known har ikke bedt om den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoort alles. Je microfoon is niet in gebruik en Known heeft er niet om gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słyszysz wszystko. Twój mikrofon nie jest używany, a Known o niego nie prosiła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ouve tudo. Seu microfone não está em uso e o Known não pediu acesso a ele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ouvir tudo. O seu microfone não está a ser usado e a Known não o pediu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți auzi tot. Microfonul tău nu este folosit, iar Known nu l-a cerut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы слышите всё. Ваш микрофон не используется, и Known его не запрашивала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počuješ všetko. Tvoj mikrofón sa nepoužíva a Known oň nepožiadala."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hör allt. Din mikrofon används inte och Known har inte bett om den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனைத்தையும் கேட்கலாம். உங்கள் மைக்ரோஃபோன் பயன்பாட்டில் இல்லை, Known அதைக் கேட்கவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అంతా వినగలరు. మీ మైక్రోఫోన్ వాడుకలో లేదు, Known దాన్ని అడగలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้ยินทุกอย่าง ไมโครโฟนของคุณไม่ได้ใช้งาน และ Known ไม่ได้ขอใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi duyabilirsiniz. Mikrofonunuz kullanılmıyor ve Known onu istemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви чуєте все. Ваш мікрофон не використовується, і Known не запитувала до нього доступу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سب کچھ سن سکتے ہیں۔ آپ کا مائیکروفون استعمال میں نہیں اور Known نے اسے مانگا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn nghe được mọi thứ. Micro của bạn không được dùng và Known chưa xin dùng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你能听到所有内容。你的麦克风未被使用，Known 也没有请求使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以聽到所有內容。你的麥克風未使用，Known 也沒有要求使用。"
          }
        }
      }
    },
