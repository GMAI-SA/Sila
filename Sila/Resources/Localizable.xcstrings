    "document.review.unreadable.message": {
      "comment": "Review step body when no zone was read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقرأ مراجعٌ الوثيقة بعينه بدلًا من ذلك. إعادة التقاط الصورة في إضاءة أفضل تحلّ هذا عادةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর বদলে একজন রিভিউয়ার নিজের চোখে নথিটি পড়বেন। ভালো আলোতে আবার ছবি তুললে সাধারণত এটি ঠিক হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor llegirà el document a ull. Repetir la foto amb millor llum sol solucionar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklad místo toho přečte posuzovatel očima. Obvykle pomůže vyfotit znovu při lepším světle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gennemgående læser i stedet dokumentet med det blotte øje. Hvis du tager fotoet om i bedre lys, løser det som regel problemet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prüfer liest das Dokument stattdessen mit bloßem Auge. Meist hilft es, das Foto bei besserem Licht neu aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ελεγκτής θα διαβάσει το έγγραφο με το μάτι. Η νέα λήψη με καλύτερο φως συνήθως το διορθώνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reviewer will read the document by eye instead. Retaking the photo in better light usually fixes this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor leerá el documento a simple vista. Repetir la foto con mejor luz suele solucionarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastaja lukee asiakirjan sen sijaan silmämääräisesti. Kuvan ottaminen uudelleen paremmassa valossa korjaa tämän yleensä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vérificateur lira plutôt le document à l’œil. Reprendre la photo avec une meilleure lumière règle généralement le problème."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק יקרא את המסמך בעין במקום זאת. צילום חוזר באור טוב יותר בדרך כלל פותר זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समीक्षक दस्तावेज़ को आँख से पढ़ेगा। बेहतर रोशनी में फ़ोटो दोबारा लेने से आमतौर पर यह ठीक हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenzent će umjesto toga ispravu pročitati okom. Ponovno snimanje na boljem svjetlu obično to rješava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányt egy elbíráló szemmel olvassa majd el. Általában segít, ha jobb fényben újra lefényképezed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang peninjau akan membaca dokumen secara manual. Mengambil ulang foto dengan cahaya lebih baik biasanya memperbaikinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisore leggerà invece il documento a occhio. Rifare la foto con una luce migliore di solito risolve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに、審査担当者が目で書類を確認します。明るい場所で撮り直すと、たいてい解決します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 검토자가 문서를 직접 눈으로 읽어요. 더 밝은 곳에서 다시 촬영하면 대개 해결돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകരം ഒരു റിവ്യൂവർ രേഖ നേരിട്ട് നോക്കി വായിക്കും. മെച്ചപ്പെട്ട വെളിച്ചത്തിൽ ഫോട്ടോ വീണ്ടും എടുത്താൽ സാധാരണ ഇത് പരിഹരിക്കപ്പെടും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang penyemak akan membaca dokumen itu dengan mata sebagai ganti. Mengambil semula foto dalam cahaya yang lebih baik biasanya menyelesaikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator leser dokumentet med øynene i stedet. Å ta bildet på nytt i bedre lys løser vanligvis dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beoordelaar leest het document dan met het oog. De foto opnieuw maken bij beter licht lost dit meestal op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast tego recenzent odczyta dokument na oko. Ponowne zdjęcie przy lepszym świetle zwykle rozwiązuje problem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um analista lerá o documento a olho nu. Tirar a foto de novo com mais luz costuma resolver."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um revisor lerá o documento à vista. Repetir a foto com melhor luz costuma resolver isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evaluator va citi documentul cu ochiul liber. De obicei, refacerea fotografiei la lumină mai bună rezolvă problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяющий прочтёт документ вручную. Обычно помогает переснять фото при лучшем освещении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posudzovateľ prečíta doklad namiesto toho očami. Odfotenie pri lepšom svetle to zvyčajne vyrieši."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En granskare läser i stället dokumentet för hand. Att ta om fotot i bättre ljus löser oftast detta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மதிப்பாய்வாளர் அதற்குப் பதிலாக ஆவணத்தைக் கண்ணால் படிப்பார். நல்ல வெளிச்சத்தில் மீண்டும் எடுத்தால் பொதுவாக இது சரியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బదులుగా సమీక్షకుడు పత్రాన్ని కళ్లతో చదువుతారు. మెరుగైన వెలుతురులో ఫోటోను మళ్లీ తీస్తే సాధారణంగా ఇది సరవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ตรวจสอบจะอ่านเอกสารด้วยตาแทน การถ่ายใหม่ในที่ที่มีแสงดีกว่ามักช่วยแก้ปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir inceleyici belgeyi bunun yerine gözle okuyacak. Fotoğrafı daha iyi ışıkta yeniden çekmek genellikle bunu çözer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряльник прочитає документ на око. Зазвичай допомагає перезйомка при кращому освітленні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بجائے ایک جائزہ لینے والا دستاویز کو آنکھ سے پڑھے گا۔ بہتر روشنی میں تصویر دوبارہ لینے سے عموماً یہ مسئلہ حل ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người xét duyệt sẽ đọc giấy tờ bằng mắt thay thế. Chụp lại ảnh ở nơi sáng hơn thường khắc phục được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核员会改为人工查看证件。在更好的光线下重拍通常能解决这个问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審核人員會改以人工查看證件。在較好的光線下重拍，通常就能解決。"
          }
        }
      }
    },
