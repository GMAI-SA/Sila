    "ds.toast.dismissHint": {
      "comment": "VoiceOver hint on a toast, which dismisses on tap.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مرتين لإخفاء هذه الرسالة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বার্তা সরাতে দুবার ট্যাপ করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dues vegades per descartar aquest missatge"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím zprávu zavřeš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk to gange for at lukke denne besked"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um diese Meldung zu schließen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε δύο φορές για να κλείσεις αυτό το μήνυμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to dismiss this message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para descartar este mensaje"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje tämä viesti kaksoisnapauttamalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour fermer ce message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש פעמיים כדי לסגור את ההודעה הזו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संदेश को हटाने के लिए डबल टैप करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirni za odbacivanje ove poruke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints duplán az üzenet elvetéséhez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk menutup pesan ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per chiudere questo messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップしてこのメッセージを閉じます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하면 이 메시지를 닫아요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സന്ദേശം ഒഴിവാക്കാൻ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik dua kali untuk menolak mesej ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk to ganger for å lukke denne meldingen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik twee keer om dit bericht te sluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie, aby zamknąć ten komunikat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para dispensar esta mensagem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para dispensar esta mensagem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge de două ori pentru a închide acest mesaj"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь, чтобы закрыть сообщение"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým ťuknutím túto správu zavrieš"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck två gånger för att stänga meddelandet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செய்தியை மூட இருமுறை தட்டுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సందేశాన్ని తొలగించడానికి రెండుసార్లు ట్యాప్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อปิดข้อความนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı kapatmak için çift dokunun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкніться, щоб закрити це повідомлення"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پیغام ہٹانے کے لیے دو بار ٹیپ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm đúp để đóng thông báo này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下以关闭此消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連點兩下以關閉此訊息"
          }
        }
      }
    },
