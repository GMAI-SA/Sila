    "notifications.emptyUnread.subtitle": {
      "comment": "Empty unread list. %lld is how many notifications exist in the All tab — zero means there is genuinely nothing older either.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء. انتقل إلى «الكل» لعرض كل شيء مجددًا."
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء. انتقل إلى «الكل» لعرض كل شيء مجددًا."
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء. انتقل إلى «الكل» لعرض كل شيء مجددًا."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء. انتقل إلى «الكل» لعرض كل شيء مجددًا."
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء. انتقل إلى «الكل» لعرض كل شيء مجددًا."
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا شيء غير مقروء، ولا شيء أقدم أيضًا."
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Nothing unread. Switch to All to see everything again."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Nothing unread. Switch to All to see everything again."
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Nothing unread, and nothing older either."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
