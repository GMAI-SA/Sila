        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefillik bağlantısı açılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриваємо посилання на поручительство"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ضمانت کا لنک کھل رہا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang mở liên kết bảo chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开担保链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟擔保連結"
          }
        }
      }
    },
    "vouch.claim.member.pending": {
      "comment": "A person whose claim is already waiting for its voucher opens another vouch link. %@ is the voucher of the claim already made.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قبلت تزكية من ⁦@%@⁩، وهي بانتظار أن يؤكّد أنك أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে @%@-এর একটি সুপারিশ গ্রহণ করেছেন। তিনি নিশ্চিত করবেন যে এটি আপনি, তার অপেক্ষায় আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja has acceptat un aval de @%@. Està esperant que confirmi que ets tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručení od @%@ jsi už přijal. Čeká se, až potvrdí, že jsi to ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede accepteret en garanti fra @%@. Den venter på, at vedkommende bekræfter, at det er dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast bereits eine Bürgschaft von @%@ angenommen. Sie wartet darauf, dass die Person bestätigt, dass du es bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ήδη αποδεχτεί εγγύηση από τον/την @%@. Περιμένει να επιβεβαιώσει ότι είσαι εσύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already accepted a vouch from @%@. It's waiting for them to confirm it's you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya aceptaste un aval de @%@. Está esperando a que confirme que eres tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo hyväksynyt takuun käyttäjältä @%@. Se odottaa, että hän vahvistaa sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà accepté une caution de @%@. Elle attend qu’il confirme que c’est vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר קיבלת ערבות מ-@%@. היא ממתינה לכך שהוא יאשר שזה אתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप @%@ का वाउच पहले ही स्वीकार कर चुके हैं। यह उनके यह पुष्टि करने की प्रतीक्षा में है कि यह आप हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već si prihvatio/la jamstvo od @%@. Čeka da potvrdi da si to ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már elfogadtál egy kezességet @%@ részéről. Arra vár, hogy megerősítsék, te vagy az."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah menerima jaminan dari @%@. Menunggu mereka mengonfirmasi bahwa itu kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già accettato una garanzia da @%@. Aspetta che confermi che sei tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@からの保証はすでに受け入れ済みです。あなた本人であることを、相手が確認するのを待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 @%@님의 보증을 수락했어요. 본인이 맞는지 상대방이 확인하기를 기다리고 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം @%@ ന്റെ വൗച്ച് സ്വീകരിച്ചു. അത് നിങ്ങളാണെന്ന് അവർ സ്ഥിരീകരിക്കാൻ കാത്തിരിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah menerima jaminan daripada @%@. Ia menunggu mereka mengesahkan itu anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede godtatt en garanti fra @%@. Den venter på at vedkommende bekrefter at det er deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al een garantie van @%@ geaccepteerd. Die wacht tot diegene bevestigt dat jij het bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już przyjąłeś poręczenie od @%@. Czeka na jego potwierdzenie, że to Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já aceitou um aval de @%@. Ele aguarda que a pessoa confirme que é você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já aceitou um aval de @%@. Está à espera que confirme que é você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai acceptat deja o garanție de la @%@. Se așteaptă confirmarea că ești tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже приняли поручительство от @%@. Ждём, пока он(а) подтвердит, что это вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručenie od @%@ si už prijal. Čaká sa, kým potvrdí, že si to ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan godtagit ett intygande från @%@. Det väntar på att de bekräftar att det är du."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ இன் உறுதிமொழியை ஏற்கெனவே ஏற்றுவிட்டீர்கள். அது நீங்கள்தான் என அவர் உறுதிப்படுத்தக் காத்திருக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే @%@ నుండి హామీని అంగీకరించారు. అది మీరేనని వారు నిర్ధారించడం కోసం వేచి ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรับการยืนยันให้จาก @%@ แล้ว กำลังรอให้พวกเขายืนยันว่าเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ kişisinden gelen bir kefilliği zaten kabul ettiniz. Sizin olduğunuzu onaylamasını bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже прийняли поручительство від @%@. Воно чекає, поки ця людина підтвердить, що це ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ @%@ کی ضمانت پہلے ہی قبول کر چکے ہیں۔ یہ ان کی تصدیق کی منتظر ہے کہ یہ آپ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chấp nhận lời bảo chứng từ @%@. Đang chờ họ xác nhận đó là bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经接受了 @%@ 的担保，正在等待对方确认是你本人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已接受 @%@ 的擔保，正在等待對方確認是你本人。"
          }
        }
      }
    },
    "vouch.claim.member.verified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هويتك موثّقة بالفعل — لا تحتاج إلى تزكية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে ভেরিফায়েড — সুপারিশ লাগবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja estàs verificat: no necessites cap aval."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už jsi ověřen – ručení nepotřebuješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede verificeret – du behøver ikke en garanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereits verifiziert – du brauchst keine Bürgschaft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είσαι ήδη επαληθευμένος — δεν χρειάζεσαι εγγύηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're already verified — you don't need a vouch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya estás verificado: no necesitas un aval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo vahvistettu – et tarvitse takuuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déjà vérifié — vous n’avez pas besoin de caution."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה כבר מאומת — אינך זקוק לערבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से सत्यापित हैं — आपको वाउच की ज़रूरत नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već si potvrđen/a — ne trebaš jamstvo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már hitelesítve vagy – nincs szükséged kezességre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah terverifikasi — tidak butuh jaminan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei già verificato: non ti serve una garanzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに認証済みです。保証は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 인증되었어요. 보증이 필요 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം വെരിഫൈ ചെയ്തിട്ടുണ്ട് — വൗച്ച് ആവശ്യമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah disahkan — anda tidak memerlukan jaminan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede verifisert. Du trenger ingen garanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent al geverifieerd: je hebt geen garantie nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś już zweryfikowany — nie potrzebujesz poręczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já está verificado: não precisa de um aval."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está verificado — não precisa de um aval."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești deja verificat — nu ai nevoie de o garanție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже проверены — поручительство вам не нужно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Si už overený — ručenie nepotrebuješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är redan verifierad – du behöver inget intygande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கெனவே சரிபார்க்கப்பட்டுள்ளீர்கள் — உறுதிமொழி தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే ధృవీకరించబడ్డారు — మీకు హామీ అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันตัวตนแล้ว ไม่ต้องใช้การยืนยันให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten doğrulandınız; kefilliğe ihtiyacınız yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже верифіковані — поручительство вам не потрібне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ پہلے ہی تصدیق شدہ ہیں — آپ کو ضمانت کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã được xác minh — bạn không cần lời bảo chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经通过验证，不需要担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已通過驗證，不需要擔保。"
          }
        }
      }
    },
    "vouch.claim.message": {
      "comment": "%1$@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كنت الشخص الذي يقصده ⁦@%1$@⁩، فأدخل بياناتك. يجب أن تطابق ما أدخله ⁦@%1$@⁩."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ যাকে বোঝাচ্ছেন সেই ব্যক্তি আপনি হলে, নিজের তথ্য দিন। সেগুলো @%1$@-এর দেওয়া তথ্যের সাথে মিলতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ets la persona a qui es refereix @%1$@, indica les teves pròpies dades. Han de coincidir amb el que va introduir @%1$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jsi osoba, kterou @%1$@ myslí, zadej své vlastní údaje. Musí se shodovat s tím, co zadal @%1$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du er den person, @%1$@ mener, så angiv dine egne oplysninger. De skal passe med det, @%1$@ indtastede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Person bist, die @%1$@ meint, gib deine eigenen Angaben ein. Sie müssen zu dem passen, was @%1$@ eingegeben hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν είσαι το άτομο που εννοεί ο/η @%1$@, δώσε τα δικά σου στοιχεία. Πρέπει να ταιριάζουν με όσα εισήγαγε ο/η @%1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're the person @%1$@ means, give your own details. They have to match what @%1$@ entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eres la persona a la que se refiere @%1$@, da tus propios datos. Tienen que coincidir con lo que introdujo @%1$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet henkilö, jota @%1$@ tarkoittaa, anna omat tietosi. Niiden on täsmättävä siihen, mitä @%1$@ antoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous êtes la personne que @%1$@ désigne, donnez vos propres informations. Elles doivent correspondre à ce que @%1$@ a saisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם אתה האדם ש-@%1$@ מתכוון אליו, מסור את הפרטים שלך. הם חייבים להתאים למה ש-@%1$@ הזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर @%1$@ जिस व्यक्ति की बात कर रहे हैं वह आप हैं, तो अपना खुद का विवरण दें। यह वही होना चाहिए जो @%1$@ ने दर्ज किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako si osoba koju @%1$@ misli, upiši svoje podatke. Moraju se podudarati s onim što je unio/unijela @%1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha te vagy az a személy, akire @%1$@ gondol, add meg a saját adataidat. Egyezniük kell azzal, amit @%1$@ megadott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu orang yang dimaksud @%1$@, berikan detailmu sendiri. Detail itu harus cocok dengan yang dimasukkan @%1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sei la persona a cui si riferisce @%1$@, fornisci i tuoi dati. Devono corrispondere a ciò che ha inserito @%1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@が指している本人であれば、ご自身の詳細を入力してください。@%1$@が入力した内容と一致する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@님이 말하는 사람이 본인이라면 본인의 정보를 입력하세요. @%1$@님이 입력한 내용과 일치해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ഉദ്ദേശിച്ച വ്യക്തി നിങ്ങളാണെങ്കിൽ, നിങ്ങളുടെ സ്വന്തം വിവരങ്ങൾ നൽകുക. അവ @%1$@ നൽകിയതുമായി ഒത്തുപോകണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda orang yang dimaksudkan @%1$@, berikan butiran anda sendiri. Ia mesti sepadan dengan apa yang @%1$@ masukkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du er personen @%1$@ mener, oppgi dine egne opplysninger. De må stemme med det @%1$@ skrev inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als jij de persoon bent die @%1$@ bedoelt, geef dan je eigen gegevens. Ze moeten overeenkomen met wat @%1$@ heeft ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to Ty jesteś osobą, o którą chodzi @%1$@, podaj własne dane. Muszą zgadzać się z tym, co wpisał @%1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você é a pessoa a quem @%1$@ se refere, informe seus próprios dados. Eles precisam coincidir com o que @%1$@ informou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se é a pessoa a quem @%1$@ se refere, indique os seus próprios dados. Têm de coincidir com o que @%1$@ introduziu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ești persoana la care se referă @%1$@, dă propriile date. Trebuie să coincidă cu ce a introdus @%1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если @%1$@ имеет в виду вас, укажите свои данные. Они должны совпадать с тем, что ввёл(а) @%1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si osoba, ktorú @%1$@ myslí, zadaj svoje vlastné údaje. Musia sa zhodovať s tým, čo zadal @%1$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du är personen @%1$@ menar, ange dina egna uppgifter. De måste stämma med det @%1$@ angav."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ குறிப்பிடுவது நீங்கள்தான் என்றால், உங்கள் சொந்த விவரங்களைக் கொடுங்கள். அவை @%1$@ உள்ளிட்டவற்றுடன் பொருந்த வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ఉద్దేశించిన వ్యక్తి మీరే అయితే, మీ స్వంత వివరాలు ఇవ్వండి. అవి @%1$@ నమోదు చేసిన వాటితో సరిపోలాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณคือคนที่ @%1$@ หมายถึง ให้ใส่รายละเอียดของคุณเอง ต้องตรงกับที่ @%1$@ กรอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kişisinin kastettiği kişi sizseniz kendi bilgilerinizi verin. @%1$@ kişisinin girdikleriyle eşleşmeleri gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви та людина, яку має на увазі @%1$@, вкажіть власні дані. Вони мають збігатися з тим, що ввів @%1$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ وہی شخص ہیں جس کا @%1$@ نے مطلب لیا ہے تو اپنی تفصیلات دیں۔ انہیں اس سے ملنا ہوگا جو @%1$@ نے درج کیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn là người mà @%1$@ nhắc đến, hãy nhập thông tin của chính bạn. Chúng phải khớp với những gì @%1$@ đã nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你就是 @%1$@ 所指的人，请提供你自己的信息，它们必须与 @%1$@ 输入的一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你是 @%1$@ 所指的人，請提供你自己的資料。它們必須與 @%1$@ 輸入的相符。"
          }
        }
      }
    },
