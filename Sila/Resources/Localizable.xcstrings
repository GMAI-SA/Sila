    "safety.reason.spam.detail": {
      "comment": "What the spam reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشر متكرر أو آلي أو غير مرغوب فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্তিমূলক, স্বয়ংক্রিয় বা অযাচিত পোস্ট।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicacions repetitives, automatitzades o no sol·licitades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakující se, automatizované nebo nevyžádané příspěvky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentagne, automatiserede eller uopfordrede opslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholtes, automatisiertes oder unerwünschtes Posten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναλαμβανόμενες, αυτοματοποιημένες ή ανεπιθύμητες αναρτήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetitive, automated or unsolicited posting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicaciones repetitivas, automatizadas o no solicitadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistuva, automaattinen tai ei-toivottu julkaiseminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publications répétitives, automatisées ou non sollicitées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרסום חוזר, אוטומטי או לא רצוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बार-बार दोहराई गई, स्वचालित या अनचाही पोस्टिंग।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponavljajuće, automatizirano ili neželjeno objavljivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismétlődő, automatizált vagy kéretlen bejegyzések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan berulang, otomatis, atau tidak diminta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblicazione ripetitiva, automatica o non richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返し、自動化された、または求められていない投稿。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복적이거나 자동화되었거나 원치 않는 게시."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവർത്തിച്ചുള്ളതോ ഓട്ടോമേറ്റഡോ ആവശ്യപ്പെടാത്തതോ ആയ പോസ്റ്റിംഗ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
