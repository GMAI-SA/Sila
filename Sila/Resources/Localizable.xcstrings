        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעכשיו אתה מתחבר עם %@. הכתובת הישנה כבר לא פעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप %@ से साइन इन करते हैं। आपका पुराना पता अब काम नहीं करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada se prijavljuješ s %@. Stara adresa više ne radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostantól ezzel jelentkezel be: %@. A régi címed már nem működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang kamu masuk dengan %@. Alamat lamamu tidak berlaku lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora accedi con %@. Il vecchio indirizzo non funziona più."
