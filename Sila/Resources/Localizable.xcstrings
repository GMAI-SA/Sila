{
  "sourceLanguage": "en",
  "strings": {
    "account.avatar.error.tooLarge": {
      "comment": "The file is over the size limit. %1$@ is its size in megabytes, %2$@ the limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم هذه الصورة %1$@ ميغابايت. يجب أن تقل صورة الملف عن %2$@ ميغابايت — اختر صورة أصغر أو اقتصّها أولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo is %1$@ MB. Profile pictures must be under %2$@ MB — pick a smaller one, or crop it first."
          }
        }
      }
    },
    "account.avatar.error.unreadable": {
      "comment": "The file could not be decoded as an image.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الصورة. اختر صورة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo couldn't be read. Pick another one."
          }
        }
      }
    },
    "account.avatar.processingDisclosure": {
      "comment": "What the server does to an uploaded picture, in plain language — including that EXIF and location data are dropped and the original is never kept. Both placeholders are the output edge length in pixels.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد سِلة ترميز صورتك على الخادم: تُقصّ مربعة، ويُغيَّر حجمها إلى %1$@×%2$@، وتُحفظ كملف JPEG جديد. وتُحذف في هذه العملية بيانات الموقع وكل بيانات EXIF الأخرى التي أضافتها الكاميرا — ولا يُخزَّن الملف الأصلي ولا يُعرض أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila re-encodes your picture on the server: it is cropped square, resized to %1$@×%2$@ and saved as a new JPEG. Location data and every other EXIF tag your camera attached is dropped in the process — the original file is never stored or served."
          }
        }
      }
    },
    "account.avatar.toast.removeFailed": {
      "comment": "Toast when removing the avatar fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إزالة صورتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove your picture."
          }
        }
      }
    },
    "account.avatar.toast.removed": {
      "comment": "Toast after removing the avatar.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيلت الصورة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture removed."
          }
        }
      }
    },
    "account.avatar.toast.updated": {
      "comment": "Toast after a successful avatar upload. Repeats the privacy fact.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُدّثت الصورة. وأُزيلت بيانات الموقع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture updated. Location data was removed."
          }
        }
      }
    },
    "account.avatar.toast.uploadFailed": {
      "comment": "Toast when an avatar upload fails and the server named no reason.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تعيين هذه الصورة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't set that picture."
          }
        }
      }
    },
    "account.delete.blocked.password": {
      "comment": "Why the delete button is still disabled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة مرورك الحالية للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your current password to continue."
          }
        }
      }
    },
    "account.delete.blocked.passwordAndWord": {
      "comment": "Why the delete button is still disabled. %@ is the required word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة مرورك واكتب %@ للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password and type %@ to continue."
          }
        }
      }
    },
    "account.delete.blocked.word": {
      "comment": "Why the delete button is still disabled. %@ is the required word.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب %@ بحروف كبيرة، تمامًا كما هي، للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type %@ in capitals, exactly, to continue."
          }
        }
      }
    },
    "account.delete.confirmButton": {
      "comment": "The destructive button on the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف حسابي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my account"
          }
        }
      }
    },
    "account.delete.confirmButton.hint": {
      "comment": "VoiceOver hint for the delete button. %lld is the grace period in days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه بعد %lld أيام"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه بعد %lld يومًا"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه بعد يوم واحد"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه بعد %lld يوم"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه بعد يومين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يعطّل حسابك الآن ويجدول حذفه اليوم"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deactivates your account now and schedules it for deletion in %lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deactivates your account now and schedules it for deletion in %lld days"
                }
              }
            }
          }
        }
      }
    },
    "account.delete.consequences.header": {
      "comment": "Header above the list of what deletion does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا يحدث عندما تؤكد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens when you confirm"
          }
        }
      }
    },
    "account.delete.effect.immediate": {
      "comment": "Consequence 1: the account is gone to everyone else at once.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعطَّل حسابك لحظة تأكيدك. وبالنسبة لبقية من في سِلة يكون قد اختفى بالفعل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is deactivated the moment you confirm. To everyone else on Sila it is already gone."
          }
        }
      }
    },
    "account.delete.effect.permanent": {
      "comment": "What happens after the grace period. Says posts are deleted, not anonymised. %lld is the number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد %lld أيام يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد %lld يومًا يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد يوم واحد يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد %lld يوم يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد يومين يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "بعد ذلك يُحذف حسابك ومنشوراتك وتفاعلاتك ومتابعاتك وإعداداتك حذفًا نهائيًا. المنشورات تُحذف ولا يُخفى صاحبها فقط. ولا يمكن التراجع عن ذلك."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "After %lld day your account, your posts, your reactions, your follows and your settings are deleted outright. Posts are deleted, not anonymised. That cannot be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "After %lld days your account, your posts, your reactions, your follows and your settings are deleted outright. Posts are deleted, not anonymised. That cannot be undone."
                }
              }
            }
          }
        }
      }
    },
    "account.delete.effect.posts": {
      "comment": "Consequence 3: the posts and the profile disappear.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختفي منشوراتك من كل الصفحات ونتائج البحث والسلاسل، ويتوقف ملفك عن الظهور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts leave every feed, every search result and every thread, and your profile stops resolving."
          }
        }
      }
    },
    "account.delete.effect.recoverable": {
      "comment": "Consequence 4: the grace period. %lld is the number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف لمدة %lld أيام. سجّل الدخول خلالها واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف لمدة %lld يومًا. سجّل الدخول خلالها واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف لمدة يوم واحد. سجّل الدخول خلاله واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف لمدة %lld يوم. سجّل الدخول خلالها واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف لمدة يومين. سجّل الدخول خلالهما واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا شيء يُتلف اليوم. سجّل الدخول واختر «إلغاء الحذف» ويعود كل شيء كما كان تمامًا."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nothing is destroyed for %lld day. Sign in during that time and choose Cancel deletion and everything comes back exactly as it was."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nothing is destroyed for %lld days. Sign in during that time and choose Cancel deletion and everything comes back exactly as it was."
                }
              }
            }
          }
        }
      }
    },
    "account.delete.effect.sessions": {
      "comment": "Consequence 2: every session ends, and signing back in is the undo.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل الخروج من كل الجلسات، على هذا الجهاز وعلى غيره. وتسجيل الدخول من جديد هو ما تفعله للتراجع عن ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session is signed out, on this device and every other one. Signing back in is what you would do to undo this."
          }
        }
      }
    },
    "account.delete.exportFirst": {
      "comment": "Urges a data export before deletion, because it cannot be requested afterwards.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل نسخة من بياناتك أولًا إن أردت الاحتفاظ بها. الأمر لا يستغرق سوى لحظات، ولا يمكنك طلبها بعد الحذف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a copy of your data first if you want to keep it. It takes a moment and you cannot ask for it afterwards."
          }
        }
      }
    },
    "account.delete.keepButton": {
      "comment": "The safe button on the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بحسابي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep my account"
          }
        }
      }
    },
    "account.delete.keepButton.hint": {
      "comment": "VoiceOver hint for the keep button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق هذا دون حذف أي شيء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this without deleting anything"
          }
        }
      }
    },
    "account.delete.notReady.a11y": {
      "comment": "VoiceOver reading of the blocking reason. %@ is the reason.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير جاهز بعد. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not ready yet. %@"
          }
        }
      }
    },
    "account.delete.open": {
      "comment": "Button that opens the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف الحساب…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account…"
          }
        }
      }
    },
    "account.delete.open.hint": {
      "comment": "VoiceOver hint for opening the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح نموذج الحذف، وهو يشرح ما سيحدث ويطلب كلمة مرورك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the deletion form, which explains what happens and asks for your password"
          }
        }
      }
    },
    "account.delete.password.hint": {
      "comment": "VoiceOver hint for the password field on the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبت أن هذا حسابك قبل حذف أي شيء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proves this is your account before anything is deleted"
          }
        }
      }
    },
    "account.delete.typeWord.hint": {
      "comment": "VoiceOver hint for the confirmation-word field. %@ is the required word, which is never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كلمة %@ بحروف لاتينية كبيرة، تمامًا كما هي، للتأكيد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the word %@ in capital letters, exactly, to confirm"
          }
        }
      }
    },
    "account.delete.typeWord.label": {
      "comment": "Label above the confirmation-word field. %@ is the required word, which the server checks and which is never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type %@"
          }
        }
      }
    },
    "account.done.hint": {
      "comment": "VoiceOver hint for the Done button on account settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق إعدادات الحساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes account settings"
          }
        }
      }
    },
    "account.email.code.hint": {
      "comment": "VoiceOver hint for the code field. %1$lld is the digit count, %2$@ the address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الأرقام %1$lld المرسلة إلى %2$@"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الـ%1$lld رقمًا المرسلة إلى %2$@"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الرقم الواحد المرسل إلى %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الـ%1$lld رقم المرسلة إلى %2$@"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الرقمان المرسلان إلى %2$@"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الرمز المرسل إلى %2$@"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The %1$lld digit emailed to %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The %1$lld digits emailed to %2$@"
                }
              }
            }
          }
        }
      }
    },
    "account.email.code.label": {
      "comment": "Label above the confirmation-code field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        }
      }
    },
    "account.email.code.note": {
      "comment": "Reassurance that the old address still works until the change completes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وليس إلى عنوانك الحالي. لا يتغيّر بريدك حتى يُقبل الرمز، لذلك ما زال بإمكانك تسجيل الدخول بالعنوان القديم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not to your current address. Your email does not change until the code is accepted, so you can still sign in with the old one."
          }
        }
      }
    },
    "account.email.code.sentTo": {
      "comment": "Header above the address the code went to. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل الرمز إلى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CODE SENT TO"
          }
        }
      }
    },
    "account.email.confirm": {
      "comment": "Button that completes the email change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد البريد الجديد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm new email"
          }
        }
      }
    },
    "account.email.confirm.hint": {
      "comment": "VoiceOver hint for the confirm button. %@ is the new address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقل حسابك إلى %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves your account to %@"
          }
        }
      }
    },
    "account.email.done.hint": {
      "comment": "VoiceOver hint for the Done button after an email change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق هذه الصفحة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this sheet"
          }
        }
      }
    },
    "account.email.done.subtitle": {
      "comment": "Success state after an email change. %@ is the new address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبحت تسجّل الدخول باستخدام %@. ولم يعد عنوانك القديم يعمل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You now sign in with %@. Your old address no longer works."
          }
        }
      }
    },
    "account.email.done.title": {
      "comment": "Success state after an email change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر البريد الإلكتروني"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email changed"
          }
        }
      }
    },
    "account.email.error.claimedWhileWaiting": {
      "comment": "The address was taken between sending the code and confirming. Says plainly that nothing changed. %@ is the address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل شخص آخر %@ بينما كان رمزك في بريدك، لذلك لم يُنفَّذ التغيير. وعنوانك كما هو. جرّب عنوانًا آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somebody else claimed %@ while your code was in the inbox, so the change was not made. Your address is unchanged. Try a different one."
          }
        }
      }
    },
    "account.email.intro": {
      "comment": "Explains why the code goes to the new address, not the current one. %@ is the current address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل الدخول باستخدام %@. ستُرسل سِلة رمزًا من ستة أرقام إلى العنوان **الجديد** — لا إلى هذا العنوان — لأن الشيء الوحيد الذي يستحق الإثبات هنا هو أنك تستطيع قراءة البريد الذي تنتقل إليه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in with %@. Sila will email a six-digit code to the **new** address — not to this one — because the only thing worth proving here is that you can read the mailbox you are moving to."
          }
        }
      }
    },
    "account.email.intro.thisAddress": {
      "comment": "Stands in for the current address when it is unknown.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنوان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this address"
          }
        }
      }
    },
    "account.email.new.hint": {
      "comment": "VoiceOver hint for the new-email field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان الذي سيُرسل إليه رمز التأكيد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address the confirmation code will be sent to"
          }
        }
      }
    },
    "account.email.new.label": {
      "comment": "Label above the new-email field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الجديد"
