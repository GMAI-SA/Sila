    "preferences.topicFilter.interested.hint": {
      "comment": "VoiceOver hint for the Interested topic filter.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المواضيع التي حددتها كمهتم بها فقط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার আগ্রহী চিহ্নিত বিষয় দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra només els temes que has marcat com a M'interessa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí jen témata, která tě zajímají"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kun emner, du markerede som interesseret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nur Themen, die du als interessiert markiert hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει μόνο θέματα που σημείωσες ότι σε ενδιαφέρουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only topics you marked interested"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo los temas que marcaste como de interés"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää vain aiheet, joista merkitsit olevasi kiinnostunut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche uniquement les sujets marqués Intéressé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג רק נושאים שסימנת כמעניינים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे टॉपिक दिखाता है जिनमें आपने रुचि चुनी"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje samo teme koje si označio/la kao zanimljive"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az érdeklő témákat mutatja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menampilkan topik yang kamu tandai tertarik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra solo gli argomenti che hai segnato come interessanti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "興味ありにしたトピックだけを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심 있음으로 표시한 주제만 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ താൽപര്യമുള്ളതായി അടയാളപ്പെടുത്തിയ വിഷയങ്ങൾ മാത്രം കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya memaparkan topik yang anda tandakan berminat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser bare emner du markerte som interessert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alleen onderwerpen waarin je geïnteresseerd bent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje tylko tematy oznaczone jako interesujące"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra só os tópicos que você marcou como interessado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra apenas os tópicos em que marcou interesse"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată doar subiectele marcate ca Mă interesează"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает только темы, отмеченные как интересные"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí iba témy, ktoré ťa zaujímajú"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar bara ämnen du markerat som intresserad"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆர்வம் எனக் குறித்த தலைப்புகளை மட்டும் காட்டும்"
