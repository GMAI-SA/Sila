    "preferences.stance.muted": {
      "comment": "Topic stance: hidden from the International feed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted"
          }
        }
      }
    },
    "preferences.stance.muted.hint": {
      "comment": "What choosing Muted actually does — including that it works with the filter off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي المنشورات المصنّفة بهذا الموضوع من صفحتك الدولية، حتى عندما تكون التصفية موقفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides posts labelled with this topic from your International feed, even when the filter is off"
          }
        }
      }
    },
    "preferences.stance.none": {
