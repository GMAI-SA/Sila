    "profile.timeline.empty.subtitle": {
      "comment": "Empty profile timeline. %@ is the account's display name. Repeats the exclusion so an empty list is not read as an inactive account.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ %@ أي سلسلة بعد. الردود لا تُعرض هنا، لذلك لن تظهر محادثة شارك فيها فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এখনও কোনো থ্রেড শুরু করেননি। উত্তর এখানে দেখানো হয় না, তাই যে আলোচনায় তিনি শুধু যোগ দিয়েছেন তা দেখা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encara no ha iniciat cap fil. Les respostes no es mostren aquí, així que una conversa a la qual només s'ha unit no hi apareixerà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zatím nezahájil žádné vlákno. Odpovědi se tu nezobrazují, takže konverzace, do které se jen zapojil, se neobjeví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke startet en tråd endnu. Svar vises ikke her, så en samtale, vedkommende kun har deltaget i, dukker ikke op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat noch keinen Thread begonnen. Antworten werden hier nicht gezeigt, daher erscheint ein Gespräch, dem die Person nur beigetreten ist, nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ δεν έχει ξεκινήσει ακόμα νήμα. Οι απαντήσεις δεν εμφανίζονται εδώ, οπότε μια συζήτηση στην οποία απλώς συμμετείχε δεν θα φαίνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't started a thread yet. Replies aren't shown here, so a conversation they only joined won't appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no ha iniciado ningún hilo. Las respuestas no se muestran aquí, así que una conversación en la que solo participó no aparecerá."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole vielä aloittanut ketjua. Vastauksia ei näytetä täällä, joten keskustelu, johon hän vain osallistui, ei näy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas encore lancé de discussion. Les réponses ne sont pas affichées ici, une conversation qu’il a seulement rejointe n’apparaîtra donc pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עדיין לא פתח שרשור. תגובות לא מוצגות כאן, ולכן שיחה שהוא רק הצטרף אליה לא תופיע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने अभी कोई थ्रेड शुरू नहीं किया। जवाब यहाँ नहीं दिखते, इसलिए जिस बातचीत में वे सिर्फ़ शामिल हुए वह नहीं दिखेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korisnik %@ još nije započeo nit. Odgovori se ovdje ne prikazuju pa se razgovor kojem se samo pridružio neće pojaviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ még nem indított szálat. A válaszok itt nem jelennek meg, ezért egy beszélgetés, amelyhez csak csatlakozott, nem látszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum memulai utas. Balasan tidak ditampilkan di sini, jadi percakapan yang hanya diikutinya tidak akan muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha ancora iniziato nessun thread. Le risposte non sono mostrate qui, quindi una conversazione a cui ha solo partecipato non compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はまだスレッドを始めていません。返信はここには表示されないため、参加しただけの会話は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님은 아직 스레드를 시작하지 않았어요. 답글은 여기에 표시되지 않으므로 참여만 한 대화는 나타나지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഇതുവരെ ഒരു ത്രെഡ് തുടങ്ങിയിട്ടില്ല. മറുപടികൾ ഇവിടെ കാണിക്കില്ല, അതിനാൽ അവർ ചേർന്ന ഒരു സംഭാഷണം ഇവിടെ വരില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum memulakan utas. Balasan tidak dipaparkan di sini, jadi perbualan yang hanya disertainya tidak akan muncul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke startet noen tråd ennå. Svar vises ikke her, så en samtale de bare har deltatt i, dukker ikke opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft nog geen thread gestart. Reacties worden hier niet getoond, dus een gesprek waaraan alleen is deelgenomen verschijnt niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie rozpoczął(-ęła) jeszcze żadnego wątku. Odpowiedzi nie są tu pokazywane, więc rozmowa, do której tylko dołączył(a), się nie pojawi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não começou um fio. As respostas não aparecem aqui, então uma conversa em que a pessoa só entrou não aparece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não iniciou nenhuma conversa. As respostas não são mostradas aqui, por isso uma conversa em que só participou não aparece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a început încă nicio conversație. Răspunsurile nu sunt afișate aici, deci o conversație la care doar s-a alăturat nu va apărea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ещё не начинал(а) ветку. Ответы здесь не показываются, поэтому обсуждение, к которому он(а) лишь присоединился(-лась), не появится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ešte nezačal(a) žiadne vlákno. Odpovede sa tu nezobrazujú, takže konverzácia, do ktorej sa iba zapojil(a), sa neobjaví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har inte startat någon tråd än. Svar visas inte här, så en konversation de bara deltagit i syns inte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன்னும் உரையாடலைத் தொடங்கவில்லை. பதில்கள் இங்கே காட்டப்படுவதில்லை, எனவே அவர்கள் சேர்ந்த உரையாடல் மட்டும் தோன்றாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఇంకా థ్రెడ్ ప్రారంభించలేదు. రిప్లైలు ఇక్కడ చూపబడవు, కాబట్టి వారు కేవలం చేరిన సంభాషణ కనిపించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่ได้เริ่มเธรด คำตอบไม่แสดงที่นี่ การสนทนาที่พวกเขาเพียงเข้าร่วมจึงไม่ปรากฏ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz bir konuşma başlatmadı. Yanıtlar burada gösterilmez, bu yüzden yalnızca katıldığı bir konuşma görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не почав(ла) жодного обговорення. Відповіді тут не показуються, тому розмова, до якої він(вона) лише долучився(лась), не з’явиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نے ابھی تک کوئی تھریڈ شروع نہیں کیا۔ جوابات یہاں نہیں دکھائے جاتے، اس لیے جس گفتگو میں وہ صرف شامل ہوئے وہ نظر نہیں آئے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chưa bắt đầu chuỗi nào. Trả lời không hiển thị ở đây, nên cuộc trò chuyện họ chỉ tham gia sẽ không xuất hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还没有发起过对话串。回复不会显示在这里，所以对方只是参与过的对话不会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 還沒有發起串文。這裡不顯示回覆，所以對方僅參與的對話不會出現。"
          }
        }
      }
    },
