    "safety.reason.impersonation.detail": {
      "comment": "What the impersonation reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التظاهر بأنه شخص آخر أو شركة أو جهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ব্যক্তি, ব্যবসা বা প্রতিষ্ঠান সেজে থাকা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fer-se passar per una altra persona, una empresa o una organització."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vydávání se za jinou osobu, firmu nebo organizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At foregive at være en anden person, en virksomhed eller en organisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich als eine andere Person, ein Unternehmen oder eine Organisation auszugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσποίηση ότι είναι άλλο άτομο, επιχείρηση ή οργανισμός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretending to be another person, a business or an organisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacerse pasar por otra persona, una empresa o una organización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiintyminen toisena henkilönä, yrityksenä tai organisaationa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faire passer pour une autre personne, une entreprise ou une organisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחזות לאדם אחר, לעסק או לארגון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे व्यक्ति, व्यवसाय या संगठन का रूप धरना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lažno predstavljanje kao druga osoba, tvrtka ili organizacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más személynek, vállalkozásnak vagy szervezetnek kiadni magát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpura-pura menjadi orang lain, bisnis, atau organisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingere di essere un'altra persona, un'azienda o un'organizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人、企業、団体になりすますこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람, 기업 또는 단체인 척하는 행위."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരാളായോ ബിസിനസ്സായോ സ്ഥാപനമായോ നടിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpura-pura menjadi orang lain, perniagaan atau organisasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgir seg for å være en annen person, en bedrift eller en organisasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zich voordoen als een andere persoon, een bedrijf of een organisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podawanie się za inną osobę, firmę lub organizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingir ser outra pessoa, uma empresa ou uma organização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer-se passar por outra pessoa, uma empresa ou uma organização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretinde că este altă persoană, o companie sau o organizație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдаёт себя за другого человека, компанию или организацию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vydávanie sa za inú osobu, firmu alebo organizáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtsas vara en annan person, ett företag eller en organisation."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறொரு நபர், நிறுவனம் அல்லது அமைப்பாக நடிப்பது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో వ్యక్తిగా, వ్యాపారంగా లేదా సంస్థగా నటించడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกล้งเป็นบุคคลอื่น ธุรกิจ หรือองค์กร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kişi, işletme veya kuruluş gibi davranmak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видає себе за іншу людину, компанію чи організацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی دوسرے شخص، کاروبار یا ادارے کا روپ دھارنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giả làm người khác, một doanh nghiệp hoặc một tổ chức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假冒他人、企业或组织。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "假冒他人、企業或組織。"
          }
        }
      }
    },
