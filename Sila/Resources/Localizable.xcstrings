    "error.invalidMrz": {
      "comment": "Server refused the machine-readable zone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من المنطقة المقروءة آليًا في الوثيقة. أعد التقاط الصورة في إضاءة جيدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নথির মেশিন-রিডেবল জোন যাচাই করা যায়নি। ভালো আলোতে আবার ছবি তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut verificar la zona de lectura mecànica del document. Repeteix la foto amb bona llum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strojově čitelnou zónu dokladu se nepodařilo ověřit. Vyfoť znovu při dobrém světle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentets maskinlæsbare zone kunne ikke bekræftes. Tag fotoet om i godt lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maschinenlesbare Zone des Dokuments konnte nicht verifiziert werden. Nimm das Foto bei gutem Licht neu auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχαναγνώσιμη ζώνη του εγγράφου δεν μπόρεσε να επαληθευτεί. Τράβηξε ξανά τη φωτογραφία με καλό φως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document's machine-readable zone couldn't be verified. Retake the photo in good light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la zona legible por máquina del documento. Repite la foto con buena luz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjan koneluettavaa aluetta ei voitu vahvistaa. Ota kuva uudelleen hyvässä valossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone lisible par machine du document n’a pas pu être vérifiée. Reprenez la photo avec une bonne lumière."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לאמת את האזור הקריא-מכונה של המסמך. צלם שוב באור טוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ का मशीन-रीडेबल ज़ोन सत्यापित नहीं हो सका। अच्छी रोशनी में फ़ोटो दोबारा लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strojno čitljiva zona isprave nije se mogla provjeriti. Ponovno snimi fotografiju na dobrom svjetlu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmány gépileg olvasható zónáját nem sikerült ellenőrizni. Fényképezd le újra jó fényben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona yang dapat dibaca mesin pada dokumen tidak bisa diverifikasi. Ambil ulang foto dengan cahaya yang baik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare la zona a lettura ottica del documento. Rifai la foto con buona luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の機械読み取りゾーンを確認できませんでした。明るい場所で撮り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 MRZ(기계 판독 영역)를 확인할 수 없었어요. 밝은 곳에서 다시 촬영하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖയിലെ മെഷീൻ-റീഡബിൾ സോൺ പരിശോധിക്കാനായില്ല. നല്ല വെളിച്ചത്തിൽ ഫോട്ടോ വീണ്ടും എടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zon boleh baca mesin pada dokumen tidak dapat disahkan. Ambil semula foto dalam cahaya yang baik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentets maskinlesbare sone kunne ikke verifiseres. Ta bildet på nytt i godt lys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De machineleesbare zone van het document kon niet worden geverifieerd. Maak de foto opnieuw bij goed licht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować strefy odczytu maszynowego dokumentu. Zrób zdjęcie ponownie przy dobrym świetle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a zona legível por máquina do documento. Tire a foto de novo com boa luz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a zona de leitura ótica do documento. Repita a foto com boa luz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona lizibilă automat a documentului nu a putut fi verificată. Refă fotografia la lumină bună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить машиночитаемую зону документа. Переснимите фото при хорошем освещении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Strojovo čitateľnú zónu dokladu sa nepodarilo overiť. Odfoť ho znova pri dobrom svetle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentets maskinläsbara zon kunde inte verifieras. Ta om fotot i bra ljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆவணத்தின் இயந்திரம் படிக்கும் பகுதியைச் சரிபார்க்க முடியவில்லை. நல்ல வெளிச்சத்தில் மீண்டும் படம் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పత్రంలోని మెషిన్-రీడబుల్ జోన్‌ను ధృవీకరించలేకపోయాం. మంచి వెలుతురులో ఫోటోను మళ్లీ తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบโซนที่เครื่องอ่านได้ของเอกสารไม่ได้ ถ่ายรูปใหม่ในที่ที่มีแสงดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenin makine tarafından okunabilir bölgesi doğrulanamadı. Fotoğrafı iyi ışıkta yeniden çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машинозчитувану зону документа не вдалося перевірити. Зробіть фото знову при гарному освітленні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستاویز کے مشین ریڈایبل زون کی تصدیق نہیں ہو سکی۔ اچھی روشنی میں تصویر دوبارہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được vùng đọc được bằng máy của giấy tờ. Hãy chụp lại ở nơi đủ sáng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证证件的机读区。请在光线良好的地方重拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證證件的機器可讀區。請在光線良好處重新拍照。"
          }
        }
      }
    },
