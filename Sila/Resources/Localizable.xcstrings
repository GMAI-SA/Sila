    "vouch.refusal.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط تزكية واحد في اليوم، وعشرة في السنة — بلغت هذا الحد الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একটি এবং বছরে দশটি ভাউচ লিংক — আপাতত আপনি সেই সীমায় পৌঁছেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enllaç d'aval al dia, deu a l'any: ja has arribat al límit per ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden odkaz na ručení denně, deset ročně – prozatím jsi dosáhl limitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét garantilink om dagen, ti om året – du har nået det for nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bürgschaftslink pro Tag, zehn pro Jahr – das hast du vorerst erreicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας σύνδεσμος εγγύησης την ημέρα, δέκα τον χρόνο — έφτασες το όριο προς το παρόν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One vouch link a day, ten a year — you've reached that for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace de aval al día, diez al año: has llegado a ese límite por ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi takuulinkki päivässä, kymmenen vuodessa – olet saavuttanut sen toistaiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien de caution par jour, dix par an — vous avez atteint cette limite pour l’instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישור ערבות אחד ביום, עשרה בשנה — הגעת לכך כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ एक वाउच लिंक, साल में दस — आप फ़िलहाल उस सीमा पर पहुँच गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna poveznica jamstva dnevno, deset godišnje — za sada si to dosegao/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta egy kezességi hivatkozás, évente tíz – ezt most elérted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tautan jaminan sehari, sepuluh setahun — kamu sudah mencapainya untuk saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link di garanzia al giorno, dieci all'anno: per ora hai raggiunto il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証リンクは1日1つ、年10個までです。現在は上限に達しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증 링크는 하루 한 개, 일 년에 열 개까지예요. 지금은 한도에 도달했어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിവസം ഒരു വൗച്ച് ലിങ്ക്, വർഷത്തിൽ പത്ത് — നിങ്ങൾ തൽക്കാലം പരിധിയിലെത്തി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pautan jaminan sehari, sepuluh setahun — anda telah mencapainya buat masa ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én garantilenke om dagen, ti i året. Du har nådd det for nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén garantielink per dag, tien per jaar: dat heb je nu bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden link poręczenia dziennie, dziesięć rocznie — na razie osiągnąłeś ten limit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link de aval por dia, dez por ano: você atingiu esse limite por enquanto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ligação de aval por dia, dez por ano — atingiu esse limite por agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link de garanție pe zi, zece pe an — ai atins limita deocamdată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна ссылка поручительства в день, десять в год — на сейчас вы достигли предела."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden odkaz na ručenie za deň, desať za rok — zatiaľ si dosiahol limit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En intygandelänk per dag, tio per år – du har nått den gränsen för tillfället."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நாளுக்கு ஓர் உறுதிமொழி இணைப்பு, ஆண்டுக்குப் பத்து — இப்போதைக்கு அந்த வரம்பை எட்டிவிட்டீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజుకు ఒక హామీ లింక్, సంవత్సరానికి పది — ప్రస్తుతానికి మీరు ఆ పరిమితిని చేరుకున్నారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์รับรองได้วันละหนึ่งลิงก์ ปีละสิบลิงก์ ตอนนี้คุณใช้ครบแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir, yılda on kefillik bağlantısı; şimdilik buna ulaştınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне посилання на поручительство на день, десять на рік — ви наразі вичерпали ліміт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روزانہ ایک ضمانت کا لنک، سالانہ دس — آپ فی الحال اس حد تک پہنچ گئے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một liên kết bảo chứng mỗi ngày, mười mỗi năm — hiện bạn đã đạt giới hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一个担保链接，每年十个，你目前已达上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一個擔保連結、每年十個，你目前已達上限。"
          }
        }
      }
    },
