            "value": "Jetzt im Trend, gezählt über aktuelle Beiträge"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε τάση τώρα, μετρημένο σε πρόσφατες αναρτήσεις"
