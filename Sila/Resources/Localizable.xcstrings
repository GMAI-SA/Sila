      }
    },
    "notifications.settings.explanation": {
      "comment": "Says exactly what the switches govern — this list — and promises nothing about push, which Sila does not send. Also promises the other person is never told.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد هذه الخيارات ما يظهر في قائمة إشعاراتك. إيقاف أحدها يمنع ظهور ذلك النوع هنا فقط؛ ولا يمنع أحدًا من متابعتك أو الإعجاب بمنشورك أو الرد عليك، ولا يُبلَّغ أحد بما أوقفته."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These decide what shows up in your notifications list. Turning one off stops that kind appearing here; it does not stop anybody following, liking or replying, and they are never told what you switched off."
          }
        }
      }
    },
    "notifications.settings.explanation.title": {
      "comment": "Header above the explanation of what the switches do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تفعل هذه الخيارات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What these do"
          }
        }
      }
    },
