    "rooms.create.titleField.a11yHint": {
      "comment": "VoiceOver hint for the room title field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمّي الغرفة. الناس يقررون الانضمام بناءً عليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমের নাম দেয়। এটি দেখেই মানুষ যোগ দেবে কি না ঠিক করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa nom a la sala. La gent decideix si s'hi uneix a partir d'això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojmenuje místnost. Podle toho se lidé rozhodují, zda se připojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giver rummet et navn. Folk beslutter ud fra det, om de vil deltage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt den Raum. Daran entscheiden die Leute, ob sie beitreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίνει όνομα στην αίθουσα. Οι άλλοι αποφασίζουν αν θα μπουν από αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names the room. People decide whether to join from this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone nombre a la sala. La gente decide si entrar según esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeää huoneen. Ihmiset päättävät liittymisestä tämän perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme le salon. Les gens décident de le rejoindre ou non d’après ce nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותן שם לחדר. אנשים מחליטים אם להצטרף לפי זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम का नाम रखता है। लोग इसी से तय करते हैं कि जुड़ना है या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imenuje sobu. Ljudi po tome odlučuju hoće li se pridružiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elnevezi a szobát. Ennek alapján döntik el az emberek, csatlakoznak-e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi nama room. Orang memutuskan bergabung dari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà un nome alla stanza. Le persone decidono se entrare in base a questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームの名前です。人はこれを見て参加を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸의 이름이에요. 사람들은 이것을 보고 참여를 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമിന് പേര് നൽകുന്നു. ചേരണോ എന്ന് ആളുകൾ തീരുമാനിക്കുന്നത് ഇതിൽ നിന്നാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamakan bilik. Orang memutuskan sama ada hendak menyertai berdasarkan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir rommet navn. Folk avgjør om de vil bli med ut fra dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft de room een naam. Mensen beslissen hierop of ze meedoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazywa pokój. Na tej podstawie ludzie decydują, czy dołączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá nome à sala. As pessoas decidem se entram com base nisso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá nome à sala. As pessoas decidem se entram com base nisto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dă un nume camerei. Oamenii decid după el dacă intră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название комнаты. По нему люди решают, заходить ли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomenuje miestnosť. Podľa nej sa ľudia rozhodnú, či sa pripoja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger rummet ett namn. Folk avgör utifrån det om de går med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைக்குப் பெயரிடும். இதைக் கொண்டே மக்கள் சேர்வதா என்று முடிவு செய்கிறார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌కు పేరు పెడుతుంది. ప్రజలు దీని ఆధారంగా చేరాలో వద్దో నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อห้อง คนตัดสินใจว่าจะเข้าร่วมหรือไม่จากชื่อนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odayı adlandırır. İnsanlar katılıp katılmayacaklarına buna bakarak karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Називає кімнату. За цим люди вирішують, чи приєднуватися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم کا نام رکھتا ہے۔ لوگ اسی سے طے کرتے ہیں کہ شامل ہوں یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên cho phòng. Mọi người dựa vào đó để quyết định có tham gia không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为房间命名。人们根据它决定是否加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為聊天室命名。大家會依此決定是否加入。"
          }
        }
      }
    },
