            "state": "translated",
            "value": "Toto ručenie už na teba nečaká."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här intygandet väntar inte längre på dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுதிமொழி இனி உங்களுக்காகக் காத்திருக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ హామీ ఇకపై మీ కోసం వేచి లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรับรองนี้ไม่ได้รอคุณอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kefillik artık sizi beklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це поручительство більше не чекає на вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ضمانت اب آپ کی منتظر نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bảo chứng này không còn chờ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此担保已不再等待你处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這項擔保已不再等待你處理。"
          }
        }
      }
    },
    "vouch.error.notVerified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدير المجتمع إلا عضو وثّق هويته بنفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু যে সদস্য নিজের পরিচয় ভেরিফাই করেছেন তিনিই কমিউনিটি চালাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només un membre que hagi verificat la seva pròpia identitat pot gestionar una comunitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunitu může spravovat jen člen, který ověřil vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et medlem, der selv har verificeret sin identitet, kan drive et fællesskab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Mitglied, das die eigene Identität verifiziert hat, kann eine Community leiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο ένα μέλος που επαλήθευσε την ταυτότητά του μπορεί να διαχειρίζεται κοινότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a member who verified their own identity can run a community."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un miembro que verificó su propia identidad puede gestionar una comunidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain jäsen, joka on vahvistanut oman henkilöllisyytensä, voi ylläpitää yhteisöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un membre ayant vérifié sa propre identité peut gérer une communauté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חבר שאימת את זהותו בעצמו יכול לנהל קהילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही सदस्य कम्युनिटी चला सकता है जिसने अपनी पहचान खुद सत्यापित की हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajednicu može voditi samo član koji je sam potvrdio svoj identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közösséget csak olyan tag vezethet, aki saját maga hitelesítette a személyazonosságát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anggota yang memverifikasi identitasnya sendiri yang bisa mengelola komunitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un membro che ha verificato la propria identità può gestire una community."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティを運営できるのは、自分自身で本人確認をしたメンバーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 신원을 인증한 멤버만 커뮤니티를 운영할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്ത അംഗത്തിന് മാത്രമേ കമ്മ്യൂണിറ്റി നടത്താനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ahli yang mengesahkan identitinya sendiri boleh mengurus komuniti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et medlem som har verifisert sin egen identitet, kan drive et fellesskap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een lid dat de eigen identiteit heeft geverifieerd kan een community beheren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Społeczność może prowadzić tylko członek, który zweryfikował własną tożsamość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um membro que verificou a própria identidade pode administrar uma comunidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um membro que verificou a própria identidade pode gerir uma comunidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un membru care și-a verificat propria identitate poate administra o comunitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вести сообщество может только участник, прошедший собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunitu môže viesť iba člen, ktorý si sám overil totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en medlem som verifierat sin egen identitet kan driva en community."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தன் அடையாளத்தைத் தானே சரிபார்த்த உறுப்பினர் மட்டுமே சமூகத்தை நடத்த முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తమ గుర్తింపును స్వయంగా ధృవీకరించుకున్న సభ్యులు మాత్రమే కమ్యూనిటీని నడపగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะสมาชิกที่ยืนยันตัวตนด้วยตัวเองเท่านั้นที่ดูแลชุมชนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendi kimliğini doğrulayan bir üye topluluk yönetebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керувати спільнотою може лише учасник, який верифікував власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمیونٹی صرف وہ رکن چلا سکتا ہے جس نے اپنی شناخت کی خود تصدیق کی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thành viên đã tự xác minh danh tính mới quản lý được cộng đồng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有自行验证过身份的成员才能管理社区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已自行驗證身分的成員才能經營社群。"
          }
        }
      }
    },
    "vouch.error.recipientCannotMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع استخدام الرسائل حتى يوثّق هويته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয় ভেরিফাই না করা পর্যন্ত তিনি মেসেজ ব্যবহার করতে পারবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No poden fer servir els missatges fins que verifiquin la seva identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohou používat zprávy, dokud neověří svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke bruge beskeder, før de har verificeret deres identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person kann Nachrichten erst nutzen, wenn sie ihre Identität verifiziert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορούν να χρησιμοποιήσουν μηνύματα μέχρι να επαληθεύσουν την ταυτότητά τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can't use messages until they verify their identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede usar los mensajes hasta que verifique su identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "He eivät voi käyttää viestejä, ennen kuin vahvistavat henkilöllisyytensä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne peut pas utiliser les messages tant qu’elle n’a pas vérifié son identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם לא יכולים להשתמש בהודעות עד שיאמתו את זהותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पहचान सत्यापित करने तक वे संदेशों का उपयोग नहीं कर सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu koristiti poruke dok ne potvrde svoj identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem használhatnak üzeneteket, amíg nem hitelesítik a személyazonosságukat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak bisa memakai pesan sampai memverifikasi identitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può usare i messaggi finché non verifica la propria identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手は、本人確認をするまでメッセージを使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방은 신원을 인증하기 전에는 메시지를 사용할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുംവരെ അവർക്ക് സന്ദേശങ്ങൾ ഉപയോഗിക്കാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak boleh menggunakan mesej sehingga mereka mengesahkan identiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan ikke bruke meldinger før de har verifisert identiteten sin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze kunnen geen berichten gebruiken totdat ze hun identiteit verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta osoba nie może korzystać z wiadomości, dopóki nie zweryfikuje tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa não pode usar mensagens até verificar a identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode usar mensagens até verificar a sua identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu pot folosi mesajele până nu își verifică identitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не смогут пользоваться сообщениями, пока не пройдут проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správy nemôže používať, kým si neoverí totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kan inte använda meddelanden förrän de verifierar sin identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடையாளத்தைச் சரிபார்க்கும் வரை அவர்களால் செய்திகளைப் பயன்படுத்த முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తింపును ధృవీకరించుకునే వరకు వారు మెసేజ్‌లను వాడలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขาใช้ข้อความไม่ได้จนกว่าจะยืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliklerini doğrulayana kadar mesajları kullanamazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони не можуть користуватися повідомленнями, доки не верифікують особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک وہ اپنی شناخت کی تصدیق نہ کریں وہ پیغامات استعمال نہیں کر سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ không dùng được tin nhắn cho đến khi xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对方验证身份之前，无法使用私信。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方在驗證身分之前無法使用訊息。"
          }
        }
      }
    },
