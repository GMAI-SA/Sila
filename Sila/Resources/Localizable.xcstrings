    "rooms.live.end.a11yHint": {
      "comment": "VoiceOver hint for the end-room button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي الغرفة للجميع. ولا يمكن إعادة فتحها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবার জন্য রুম শেষ করে। এটি আর খোলা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Acaba la sala per a tothom. No es pot tornar a obrir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí místnost pro všechny. Nelze ji znovu otevřít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslutter rummet for alle. Det kan ikke genåbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet den Raum für alle. Er lässt sich nicht wieder öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τερματίζει την αίθουσα για όλους. Δεν μπορεί να ανοίξει ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the room for everybody. It cannot be reopened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la sala para todos. No se puede reabrir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättää huoneen kaikilta. Sitä ei voi avata uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine le salon pour tout le monde. Il ne peut pas être rouvert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיים את החדר לכולם. אי אפשר לפתוח אותו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम को सबके लिए खत्म करता है। इसे दोबारा नहीं खोला जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava sobu za sve. Ne može se ponovno otvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindenki számára befejezi a szobát. Nem nyitható újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakhiri room untuk semua orang. Tidak bisa dibuka kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la stanza per tutti. Non può essere riaperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員のルームを終了します。再び開くことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람에게 룸을 종료해요. 다시 열 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാവർക്കും വേണ്ടി റൂം അവസാനിപ്പിക്കുന്നു. വീണ്ടും തുറക്കാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamatkan bilik untuk semua orang. Ia tidak boleh dibuka semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutter rommet for alle. Det kan ikke åpnes igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindigt de room voor iedereen. Hij kan niet opnieuw worden geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy pokój dla wszystkich. Nie można go ponownie otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a sala para todos. Não pode ser reaberta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sala para todos. Não pode ser reaberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie camera pentru toți. Nu poate fi redeschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает комнату для всех. Открыть её снова нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončí miestnosť pre všetkých. Nedá sa znova otvoriť."
