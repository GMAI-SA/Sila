    "rooms.join.cannotEnter.title": {
      "comment": "Heading over a refusal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك دخول هذه الغرفة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই রুমে ঢুকতে পারবেন না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No pots entrar a aquesta sala"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do této místnosti nemůžeš vstoupit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke komme ind i dette rum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Raum nicht betreten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείς να μπεις σε αυτή την αίθουσα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't enter this room"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes entrar en esta sala"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et pääse tähän huoneeseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas entrer dans ce salon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינך יכול להיכנס לחדר הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस रूम में नहीं आ सकते"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne možeš ući u ovu sobu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebbe a szobába nem léphetsz be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tidak bisa masuk ke room ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi entrare in questa stanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルームには入れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 룸에 입장할 수 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് ഈ റൂമിൽ പ്രവേശിക്കാനാകില്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak boleh memasuki bilik ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke gå inn i dette rommet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze room niet betreden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie możesz wejść do tego pokoju"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode entrar nesta sala"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode entrar nesta sala"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu poți intra în această cameră"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете войти в эту комнату"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tejto miestnosti nemôžeš vstúpiť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte gå in i det här rummet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அறைக்குள் உங்களால் நுழைய முடியாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ రూమ్‌లోకి ప్రవేశించలేరు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้าห้องนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odaya giremezsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не можете увійти в цю кімнату"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اس روم میں داخل نہیں ہو سکتے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không thể vào phòng này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你无法进入此房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你無法進入此聊天室"
          }
        }
      }
    },
