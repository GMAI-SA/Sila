          "stringUnit": {
            "state": "translated",
            "value": "அடையாளச் சரிபார்ப்பு தற்காலிகமாகக் கிடைக்கவில்லை. சிறிது நேரம் கழித்து முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తింపు ధృవీకరణ తాత్కాలికంగా అందుబాటులో లేదు. కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนใช้งานไม่ได้ชั่วคราว ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulaması geçici olarak kullanılamıyor. Biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верифікація особи тимчасово недоступна. Спробуйте трохи згодом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شناخت کی تصدیق عارضی طور پر دستیاب نہیں۔ تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh danh tính tạm thời không khả dụng. Hãy thử lại sau ít phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证暂时不可用。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分驗證暫時無法使用，請稍後再試。"
          }
        }
      }
    },
