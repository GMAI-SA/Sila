    "notifications.kind.identityImpostor.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما قد يدّعي حساب آخر أنه أنت. مفعّل دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য কোনো অ্যাকাউন্ট নিজেকে আপনি বলে দাবি করতে পারে। সবসময় চালু।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan un altre compte pot estar fent-se passar per tu. Sempre activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se jiný účet může vydávat za tebe. Vždy zapnuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en anden konto muligvis udgiver sig for at være dig. Altid slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein anderes Konto möglicherweise vorgibt, du zu sein. Immer an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ένας άλλος λογαριασμός μπορεί να παριστάνει εσένα. Πάντα ενεργό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another account may be claiming to be you. Always on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando otra cuenta puede estar haciéndose pasar por ti. Siempre activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun toinen tili voi esiintyä sinuna. Aina päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un autre compte prétend peut-être être vous. Toujours activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשחשבון אחר אולי מתחזה לך. תמיד פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई दूसरा अकाउंट आपका होने का दावा कर रहा हो सकता है। हमेशा चालू।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad se drugi račun možda izdaje za tebe. Uvijek uključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy másik fiók esetleg a nevedben lép fel. Mindig be van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat akun lain mungkin mengaku sebagai kamu. Selalu aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un altro account potrebbe spacciarsi per te. Sempre attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントがあなたになりすましている可能性があるとき。常にオンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정이 나를 사칭할 가능성이 있을 때. 항상 켜져 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു അക്കൗണ്ട് നിങ്ങളാണെന്ന് അവകാശപ്പെടുന്നുണ്ടാകാം എന്നപ്പോൾ. എപ്പോഴും ഓൺ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila akaun lain mungkin mengaku sebagai anda. Sentiasa aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en annen konto kanskje utgir seg for å være deg. Alltid på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een ander account zich mogelijk als jou voordoet. Altijd aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy inne konto może podawać się za Ciebie. Zawsze włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando outra conta pode estar se passando por você. Sempre ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando outra conta pode estar a fazer-se passar por si. Sempre ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un alt cont ar putea pretinde că ești tu. Mereu activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда другой аккаунт, возможно, выдаёт себя за вас. Всегда включено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa za teba môže vydávať iný účet. Vždy zapnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När ett annat konto kan utge sig för att vara du. Alltid på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறொரு கணக்கு நீங்கள் என்று கூறிக்கொள்ளக்கூடும்போது. எப்போதும் இயக்கத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో ఖాతా మీరని చెప్పుకుంటూ ఉండవచ్చని అనిపించినప్పుడు. ఎప్పుడూ ఆన్‌లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่ออาจมีบัญชีอื่นแอบอ้างเป็นคุณ เปิดตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir hesap sizmişsiniz gibi davranıyor olabilir. Her zaman açık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли інший обліковий запис, можливо, видає себе за вас. Завжди ввімкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی دوسرا اکاؤنٹ آپ ہونے کا دعویٰ کر رہا ہو۔ ہمیشہ آن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một tài khoản khác có thể đang mạo danh bạn. Luôn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当其他账户可能在冒充你时。始终开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他帳號可能冒充你時。永遠開啟。"
          }
        }
      }
    },
