      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت قائمة المواضيع في «معروف»، فلم يُحفظ شيء. أعد تحميل هذه الشاشة وأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এর বিষয়ের তালিকা বদলেছে, তাই কিছুই সেভ হয়নি। এই স্ক্রিন রিলোড করে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llista de temes de Known ha canviat, així que no s'ha desat res. Torna a carregar aquesta pantalla i prova-ho de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam témat v aplikaci Known se změnil, takže nic nebylo uloženo. Načti tuto obrazovku znovu a zkus to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns emneliste er ændret, så intet blev gemt. Genindlæs denne skærm, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Themenliste von Known hat sich geändert, daher wurde nichts gesichert. Lade diesen Bildschirm neu und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα θεμάτων του Known άλλαξε, οπότε δεν αποθηκεύτηκε τίποτα. Φόρτωσε ξανά αυτή την οθόνη και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known's topic list has changed, so nothing was saved. Reload this screen and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de temas de Known ha cambiado, así que no se guardó nada. Recarga esta pantalla e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownin aiheluettelo on muuttunut, joten mitään ei tallennettu. Lataa tämä näkymä uudelleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des sujets de Known a changé, rien n’a donc été enregistré. Rechargez cet écran et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת הנושאים של Known השתנתה, ולכן שום דבר לא נשמר. טען את המסך מחדש ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known की टॉपिक सूची बदल गई है, इसलिए कुछ सेव नहीं हुआ। यह स्क्रीन दोबारा लोड करें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popis tema aplikacije Known se promijenio pa ništa nije spremljeno. Ponovno učitaj ovaj zaslon i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known témalistája megváltozott, ezért nem mentettünk semmit. Töltsd újra ezt a képernyőt, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar topik Known telah berubah, jadi tidak ada yang tersimpan. Muat ulang layar ini dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco degli argomenti di Known è cambiato, quindi non è stato salvato nulla. Ricarica questa schermata e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownのトピックの一覧が変更されたため、何も保存されていません。この画面を読み込み直して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known의 주제 목록이 변경되어 아무것도 저장되지 않았어요. 이 화면을 새로 고침하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ന്റെ വിഷയ പട്ടിക മാറിയതിനാൽ ഒന്നും സേവ് ചെയ്തില്ല. ഈ സ്ക്രീൻ വീണ്ടും ലോഡ് ചെയ്ത് ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai topik Known telah berubah, jadi tiada apa-apa disimpan. Muat semula skrin ini dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns emneliste er endret, så ingenting ble lagret. Last denne skjermen på nytt og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onderwerpenlijst van Known is gewijzigd, dus er is niets opgeslagen. Laad dit scherm opnieuw en probeer het nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista tematów w Known się zmieniła, więc nic nie zapisano. Wczytaj ten ekran ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de tópicos do Known mudou, então nada foi salvo. Recarregue esta tela e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de tópicos da Known mudou, por isso nada foi guardado. Recarregue este ecrã e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de subiecte Known s-a schimbat, așa că nu s-a salvat nimic. Reîncarcă acest ecran și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список тем Known изменился, поэтому ничего не сохранено. Обновите экран и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam tém v Known sa zmenil, takže sa nič neuložilo. Načítaj túto obrazovku znova a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns ämneslista har ändrats, så inget sparades. Läs in skärmen igen och försök på nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இன் தலைப்புப் பட்டியல் மாறியுள்ளது, எனவே எதுவும் சேமிக்கப்படவில்லை. இந்தத் திரையை மீண்டும் ஏற்றி முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known అంశాల జాబితా మారింది, కాబట్టి ఏదీ సేవ్ కాలేదు. ఈ స్క్రీన్‌ను మళ్లీ లోడ్ చేసి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการหัวข้อของ Known เปลี่ยนไป จึงไม่ได้บันทึกอะไร โหลดหน้านี้ใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'un konu listesi değişti, bu yüzden hiçbir şey kaydedilmedi. Bu ekranı yeniden yükleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список тем у Known змінився, тож нічого не збережено. Перезавантажте цей екран і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known کے موضوعات کی فہرست بدل گئی ہے، اس لیے کچھ محفوظ نہیں ہوا۔ یہ اسکرین دوبارہ لوڈ کریں اور پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách chủ đề của Known đã thay đổi nên chưa có gì được lưu. Hãy tải lại màn hình này và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 的话题列表已更新，因此未保存任何内容。请重新加载此页面后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 的主題清單已變更，因此沒有儲存任何內容。請重新載入此畫面後再試一次。"
          }
        }
      }
    },
    "error.unverified": {
      "comment": "Posting attempted by an account that has not finished identity verification.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشر متاح للموثّقين فقط. القراءة متاحة للجميع في «معروف» — أكمل التحقق من الهوية لتتحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভেরিফায়েড মানুষ পোস্ট করতে পারে। Known সবাই পড়তে পারে — কথা বলতে পরিচয় যাচাই শেষ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només les persones verificades poden publicar. Tothom pot llegir Known; acaba la verificació d'identitat per parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psát mohou jen ověření lidé. Known je čitelná pro všechny – dokonči ověření totožnosti, abys mohl mluvit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun verificerede mennesker kan slå op. Alle kan læse Known – gør din identitetsverificering færdig for at tage ordet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verifizierte Menschen können posten. Alle können Known lesen – schließe die Identitätsprüfung ab, um mitzureden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο επαληθευμένοι άνθρωποι μπορούν να δημοσιεύουν. Όλοι μπορούν να διαβάζουν το Known — ολοκλήρωσε την επαλήθευση ταυτότητας για να μιλήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only verified humans can post. Everyone can read Known — finish identity verification to speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas verificadas pueden publicar. Todo el mundo puede leer Known; termina la verificación de identidad para hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain vahvistetut ihmiset voivat julkaista. Kaikki voivat lukea Knownia – viimeistele henkilöllisyyden vahvistus puhuaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les humains vérifiés peuvent publier. Tout le monde peut lire Known — terminez la vérification d’identité pour prendre la parole."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק בני אדם מאומתים יכולים לפרסם. כולם יכולים לקרוא את Known — השלם אימות זהות כדי לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सत्यापित इंसान पोस्ट कर सकते हैं। Known सब पढ़ सकते हैं — बोलने के लिए पहचान सत्यापन पूरा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objavljivati mogu samo potvrđeni ljudi. Svatko može čitati objave u aplikaciji Known — dovrši provjeru identiteta da bi mogao/la govoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak hitelesített emberek írhatnak. A Knownt mindenki olvashatja – az íráshoz fejezd be a személyazonosság hitelesítését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia terverifikasi yang bisa memposting. Semua orang bisa membaca Known — selesaikan verifikasi identitas untuk bersuara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone verificate possono pubblicare. Tutti possono leggere Known: completa la verifica dell'identità per parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿できるのは認証済みの人だけです。Knownは誰でも読めます。発言するには本人確認を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 사람만 게시할 수 있어요. 누구나 Known을 읽을 수 있지만, 말하려면 신원 인증을 완료하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിച്ച മനുഷ്യർക്ക് മാത്രമേ പോസ്റ്റ് ചെയ്യാനാകൂ. Known എല്ലാവർക്കും വായിക്കാം — സംസാരിക്കാൻ ഐഡന്റിറ്റി പരിശോധന പൂർത്തിയാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia yang disahkan boleh menyiar. Sesiapa boleh membaca Known — selesaikan pengesahan identiti untuk bersuara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare verifiserte mennesker kan publisere. Alle kan lese Known. Fullfør identitetsverifiseringen for å ta ordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geverifieerde mensen kunnen posten. Iedereen kan Known lezen; rond je identiteitsverificatie af om mee te praten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko zweryfikowani ludzie mogą publikować. Każdy może czytać Known — dokończ weryfikację tożsamości, aby zabierać głos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem postar. Todos podem ler o Known; conclua a verificação de identidade para participar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem publicar. Todos podem ler a Known — conclua a verificação de identidade para falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar oamenii verificați pot posta. Oricine poate citi Known — finalizează verificarea identității ca să poți vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публиковать могут только проверенные люди. Читать Known может каждый — завершите проверку личности, чтобы писать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky môžu písať iba overení ľudia. Known môže čítať každý — dokonči overenie totožnosti, aby si mohol hovoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara verifierade människor kan publicera. Alla kan läsa Known – slutför identitetsverifieringen för att kunna delta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்பட்ட மனிதர்கள் மட்டுமே இடலாம். Known-ஐ எல்லோரும் படிக்கலாம் — பேச அடையாளச் சரிபார்ப்பை முடியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధృవీకరించబడిన మనుషులు మాత్రమే పోస్ట్ చేయగలరు. Knownను ఎవరైనా చదవవచ్చు — మాట్లాడటానికి గుర్తింపు ధృవీకరణ పూర్తి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนจริงที่ยืนยันตัวตนแล้วเท่านั้นที่โพสต์ได้ ทุกคนอ่าน Known ได้ ยืนยันตัวตนให้เสร็จเพื่อร่วมพูดคุย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğrulanmış insanlar gönderi paylaşabilir. Known'u herkes okuyabilir; konuşmak için kimlik doğrulamasını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публікувати можуть лише верифіковані люди. Читати Known може кожен — завершіть верифікацію особи, щоб писати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تصدیق شدہ انسان پوسٹ کر سکتے ہیں۔ Known ہر کوئی پڑھ سکتا ہے — بولنے کے لیے شناخت کی تصدیق مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người thật đã xác minh mới được đăng bài. Ai cũng đọc được Known — hãy hoàn tất xác minh danh tính để lên tiếng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已验证的真人才能发帖。每个人都能阅读 Known，完成身份验证后即可发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已驗證的真人才能發文。任何人都能閱讀 Known，完成身分驗證即可發言。"
          }
        }
      }
    },
    "error.useNafath": {
      "comment": "Server said a Saudi document must go through Nafath.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق المواطنون والمقيمون في السعودية عبر نفاذ — يستغرق دقيقة وهو فوري."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সৌদি নাগরিক ও বাসিন্দারা Nafath দিয়ে ভেরিফাই করেন — এতে এক মিনিট লাগে এবং তাৎক্ষণিক।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els ciutadans i residents saudites es verifiquen amb Nafath: triga un minut i és instantani."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Saúdští občané a rezidenti se ověřují přes Nafath – trvá to minutu a je to okamžité."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudiske statsborgere og bosatte verificerer med Nafath – det tager et minut og er øjeblikkeligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudische Staatsbürger und Einwohner verifizieren sich mit Nafath – das dauert eine Minute und geht sofort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πολίτες και οι κάτοικοι της Σαουδικής Αραβίας επαληθεύονται με Nafath — παίρνει ένα λεπτό και είναι άμεσο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudi citizens and residents verify with Nafath — it takes a minute and is instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ciudadanos y residentes saudíes se verifican con Nafath: lleva un minuto y es instantáneo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudi-Arabian kansalaiset ja asukkaat vahvistavat Nafathilla – se vie minuutin ja on välitön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les citoyens et résidents saoudiens se vérifient avec Nafath — c’est instantané et cela prend une minute."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזרחים ותושבים סעודים מאמתים עם Nafath — זה לוקח דקה והוא מיידי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सऊदी नागरिक और निवासी Nafath से सत्यापित करते हैं — इसमें एक मिनट लगता है और यह तुरंत होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudijski državljani i stanovnici provjeravaju se putem Nafatha — traje minutu i trenutačno je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szaúdi állampolgárok és lakosok Nafath-tal hitelesítenek – egy perc, és azonnali."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warga dan penduduk Saudi memverifikasi dengan Nafath — hanya semenit dan instan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cittadini e i residenti sauditi si verificano con Nafath: ci vuole un minuto ed è immediato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウジ国民と居住者はNafathで認証します。1分で済み、即時に完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사우디 국민과 거주자는 Nafath로 인증해요. 1분이면 되고 즉시 처리돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗദി പൗരന്മാരും താമസക്കാരും Nafath ഉപയോഗിച്ചാണ് പരിശോധിക്കുന്നത് — ഒരു മിനിറ്റ് മതി, തൽക്ഷണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warganegara dan pemastautin Saudi mengesahkan dengan Nafath — ia mengambil masa seminit dan serta-merta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudiske borgere og bosatte verifiserer seg med Nafath. Det tar et minutt og er umiddelbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saoedische burgers en inwoners verifiëren met Nafath: het duurt een minuut en is direct."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obywatele i rezydenci Arabii Saudyjskiej weryfikują się przez Nafath — zajmuje to minutę i jest natychmiastowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cidadãos e residentes sauditas se verificam com o Nafath: leva um minuto e é instantâneo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cidadãos e residentes sauditas verificam-se com Nafath — demora um minuto e é instantâneo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cetățenii și rezidenții saudiți se verifică prin Nafath — durează un minut și este instantaneu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Граждане и резиденты Саудовской Аравии проходят проверку через Nafath — это занимает минуту и происходит мгновенно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudskí občania a rezidenti sa overujú cez Nafath — trvá to minútu a je to okamžité."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudiska medborgare och boende verifierar sig med Nafath – det tar en minut och går direkt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சவூதி குடிமக்களும் குடியிருப்பாளர்களும் Nafath மூலம் சரிபார்க்கிறார்கள் — ஒரு நிமிடம் ஆகும், உடனடி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సౌదీ పౌరులు, నివాసులు Nafathతో ధృవీకరించుకుంటారు — ఒక నిమిషం పడుతుంది, తక్షణమే అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พลเมืองและผู้พำนักในซาอุดีอาระเบียยืนยันตัวตนด้วย Nafath ใช้เวลาหนึ่งนาทีและทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suudi vatandaşlar ve mukimler Nafath ile doğrular; bir dakika sürer ve anında olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Громадяни та резиденти Саудівської Аравії верифікуються через Nafath — це займає хвилину і відбувається миттєво."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سعودی شہری اور رہائشی Nafath سے تصدیق کرتے ہیں — اس میں ایک منٹ لگتا ہے اور یہ فوری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công dân và cư dân Ả Rập Xê Út xác minh bằng Nafath — chỉ mất một phút và tức thì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙特公民和居民通过 Nafath 验证，只需一分钟，即时完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙烏地公民和居民請使用 Nafath 驗證，只需一分鐘，即時完成。"
          }
        }
      }
    },
