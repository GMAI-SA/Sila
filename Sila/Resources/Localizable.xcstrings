            "value": "لا يمكن لهذا الحساب قبول التزكية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্ট সুপারিশ গ্রহণ করতে পারে না"
          }
        },
