    "guest.join.bookmark.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحفوظات خاصة بك وحدك، وتنتظرك في حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত পোস্ট শুধু আপনার, আর সেগুলো আপনার অ্যাকাউন্টের অপেক্ষায় থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions desades són privades i t'esperen al teu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené příspěvky jsou jen tvoje a čekají na tvém účtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemte opslag er private for dig, og de venter på din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Beiträge sind privat und warten in deinem Konto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αποθηκευμένες αναρτήσεις είναι ιδιωτικές και περιμένουν στον λογαριασμό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved posts are private to you, and they wait on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones guardadas son privadas y esperan en tu cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetut julkaisut ovat vain sinun, ja ne odottavat tililläsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts enregistrés sont privés, et ils vous attendent sur votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים שמורים פרטיים לך, והם ממתינים בחשבון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी हुई पोस्ट सिर्फ़ आपके लिए प्राइवेट रहती हैं, और आपके अकाउंट पर आपका इंतज़ार करती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljene objave privatne su za tebe i čekaju na tvom računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett bejegyzések csak neked láthatók, és a fiókodra várnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan tersimpan bersifat privat untukmu, dan menunggu di akunmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post salvati sono privati e ti aspettano nel tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した投稿はあなただけのもので、アカウントに保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 게시물은 나만 볼 수 있고 내 계정에 보관돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്ത പോസ്റ്റുകൾ നിങ്ങൾക്ക് മാത്രമുള്ളതാണ്, അവ നിങ്ങളുടെ അക്കൗണ്ടിൽ കാത്തിരിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran tersimpan adalah peribadi kepada anda, dan menunggu pada akaun anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrede innlegg er private for deg, og de venter på kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen berichten zijn alleen voor jou zichtbaar en wachten op je account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane wpisy są prywatne i czekają na Twoim koncie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts salvos são só seus e ficam esperando na sua conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações guardadas são privadas e ficam à espera na sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările salvate sunt private și te așteaptă în contul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые посты видны только вам и ждут в вашем аккаунте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené príspevky sú súkromné a čakajú na tvojom účte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade inlägg är privata för dig och väntar på ditt konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த இடுகைகள் உங்களுக்கு மட்டுமே, அவை உங்கள் கணக்கில் காத்திருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేసిన పోస్ట్‌లు మీకు మాత్రమే కనిపిస్తాయి, అవి మీ ఖాతా కోసం వేచి ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ที่บันทึกเป็นส่วนตัวของคุณ และรออยู่ในบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen gönderiler yalnızca size özeldir ve hesabınızda bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені дописи бачите лише ви, і вони чекають у вашому обліковому записі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کی گئی پوسٹس صرف آپ کے لیے نجی ہیں، اور آپ کے اکاؤنٹ میں رکھی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đã lưu chỉ riêng bạn thấy, và chúng chờ sẵn trong tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏的帖子仅你自己可见，并保存在你的账户中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的貼文僅你自己可見，並保留在你的帳號中。"
          }
        }
      }
    },
