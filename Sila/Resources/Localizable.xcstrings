            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Η Διεθνής ροή σου εμφανίζει μόνο αναρτήσεις για %lld θέμα που επέλεξες· οι αναρτήσεις που δεν έχουν ακόμα επισημανθεί κρύβονται."
