    "rooms.create.blocked.audience": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر جمهورًا يمكنك فتح غرفة له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে শ্রোতাদের জন্য রুম খুলতে পারেন তাদের একটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una audiència per a la qual puguis obrir una sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber publikum, pro které můžeš otevřít místnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en målgruppe, du kan åbne et rum for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Zielgruppe, für die du einen Raum öffnen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε κοινό για το οποίο μπορείς να ανοίξεις αίθουσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an audience you can open a room for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una audiencia para la que puedas abrir una sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yleisö, jolle voit avata huoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une audience pour laquelle vous pouvez ouvrir un salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר קהל שאתה יכול לפתוח עבורו חדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी ऑडियंस चुनें जिसके लिए आप रूम खोल सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
