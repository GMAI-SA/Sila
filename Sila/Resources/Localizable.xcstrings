    "document.sweep.turn": {
      "comment": "Prompt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن أدر رأسك ببطء دورة كاملة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এবার ধীরে ধীরে মাথা পুরো ঘুরিয়ে নিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara gira el cap lentament, fent la volta completa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní pomalu otoč hlavu celým kruhem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej nu langsomt hovedet hele vejen rundt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe jetzt den Kopf langsam einmal ganz herum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα γύρνα αργά το κεφάλι σου ολόκληρο κύκλο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now turn your head slowly, all the way round"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora gira la cabeza despacio, dando toda la vuelta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä nyt päätäsi hitaasti kokonaan ympäri"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez maintenant lentement la tête, en faisant un tour complet"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו סובב את הראש לאט, עד הסוף"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब अपना सिर धीरे-धीरे पूरा घुमाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada polako okreći glavu u cijelom krugu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most lassan fordítsd körbe a fejed"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang putar kepalamu perlahan satu putaran penuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora gira la testa lentamente, tutto intorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭をゆっくりと一周させてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 고개를 천천히 한 바퀴 돌리세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനി തല പതുക്കെ ചുറ്റും തിരിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang pusingkan kepala anda perlahan-lahan sepenuhnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snu hodet sakte, hele veien rundt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai nu langzaam je hoofd helemaal rond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz powoli obróć głowę dookoła"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora gire a cabeça devagar, dando a volta toda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vire a cabeça lentamente, todo à volta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum întoarce capul încet, complet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь медленно поверните голову по кругу"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz pomaly otáčaj hlavu dokola"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid nu huvudet långsamt, hela varvet runt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்கள் தலையை மெதுவாக முழுவதும் சுற்றித் திருப்புங்கள்"
