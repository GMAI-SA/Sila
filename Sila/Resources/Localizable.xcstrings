    "error.alreadyAppealed": {
      "comment": "A second appeal against the same suspension.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق أن قدّمت تظلّمًا على هذا الإيقاف. معروف يقبل تظلّمًا واحدًا فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে এই স্থগিতাদেশের বিরুদ্ধে আপিল করেছেন। Known একটিই আপিল গ্রহণ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja has apel·lat aquesta suspensió. Known només accepta una apel·lació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proti tomuto pozastavení ses už odvolal. Known přijímá jen jedno odvolání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede anket denne suspension. Known accepterer kun én anke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gegen diese Sperre bereits Einspruch eingelegt. Known akzeptiert nur einen Einspruch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ήδη υποβάλει ένσταση για αυτή την αναστολή. Το Known δέχεται μόνο μία ένσταση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already appealed this suspension. One appeal is all Known accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya apelaste esta suspensión. Known solo acepta una apelación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo valittanut tästä jäädytyksestä. Known hyväksyy vain yhden valituksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà contesté cette suspension. Known n’accepte qu’un seul recours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר ערערת על ההשעיה הזו. ערעור אחד הוא כל מה ש-Known מקבלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस निलंबन के ख़िलाफ़ पहले ही अपील कर चुके हैं। Known सिर्फ़ एक अपील स्वीकार करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već si se žalio/la na ovu suspenziju. Known prihvaća samo jednu žalbu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a felfüggesztést már megfellebbezted. A Known csak egy fellebbezést fogad el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah mengajukan banding atas penangguhan ini. Known hanya menerima satu banding."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già fatto ricorso contro questa sospensione. Known accetta un solo ricorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この停止にはすでに異議を申し立てています。Knownが受け付ける異議は1回だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이 정지에 이의를 신청했어요. Known은 이의 신청을 한 번만 받아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സസ്പെൻഷനെതിരെ നിങ്ങൾ ഇതിനകം അപ്പീൽ ചെയ്തു. Known ഒരു അപ്പീൽ മാത്രമേ സ്വീകരിക്കൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah merayu penggantungan ini. Satu rayuan sahaja yang diterima Known."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede anket denne suspensjonen. Known godtar bare én anke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al bezwaar gemaakt tegen deze schorsing. Known accepteert maar één bezwaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już odwołałeś się od tego zawieszenia. Known przyjmuje tylko jedno odwołanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já contestou esta suspensão. O Known aceita apenas uma contestação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já contestou esta suspensão. A Known só aceita uma contestação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai contestat deja această suspendare. Known acceptă o singură contestație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже оспорили эту блокировку. Known принимает только одну апелляцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Proti tomuto pozastaveniu si sa už odvolal. Known prijíma iba jedno odvolanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan överklagat den här avstängningen. Known tar bara emot ett överklagande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இடைநிறுத்தத்துக்கு ஏற்கெனவே மேல்முறையீடு செய்துவிட்டீர்கள். Known ஒரே ஒரு மேல்முறையீட்டை மட்டுமே ஏற்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే ఈ సస్పెన్షన్‌పై అప్పీల్ చేశారు. Known ఒక్క అప్పీల్‌ను మాత్రమే అంగీకరిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอุทธรณ์การระงับนี้แล้ว Known รับอุทธรณ์ได้เพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu askıya almaya zaten itiraz ettiniz. Known yalnızca bir itirazı kabul eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже оскаржили це призупинення. Known приймає лише одну апеляцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اس معطلی کے خلاف پہلے ہی اپیل کر چکے ہیں۔ Known صرف ایک اپیل قبول کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã khiếu nại việc đình chỉ này. Known chỉ chấp nhận một lần khiếu nại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经对此次封禁提出过申诉。Known 只接受一次申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已對這次停權提出申訴。Known 只接受一次申訴。"
          }
        }
      }
    },
