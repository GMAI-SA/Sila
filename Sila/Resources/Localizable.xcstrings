    "communities.rooms.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرفة المفتوحة هنا لهذا المجتمع وحده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে খোলা রুম শুধু এই কমিউনিটির জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sala oberta aquí és només per a aquesta comunitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost otevřená tady je jen pro tuto komunitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rum, der åbnes her, er kun for dette fællesskab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hier geöffneter Raum gehört nur zu dieser Community."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αίθουσα που ανοίγει εδώ είναι μόνο για αυτή την κοινότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room opened here is for this community only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sala abierta aquí es solo para esta comunidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänne avattu huone on vain tälle yhteisölle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salon ouvert ici est réservé à cette communauté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר שנפתח כאן מיועד לקהילה הזו בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ खोला गया रूम केवल इसी कम्युनिटी के लिए है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba otvorena ovdje namijenjena je samo ovoj zajednici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az itt megnyitott szoba csak ennek a közösségnek szól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room yang dibuka di sini hanya untuk komunitas ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stanza aperta qui è solo per questa community."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで開いたルームは、このコミュニティ専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 연 룸은 이 커뮤니티 전용이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ തുടങ്ങുന്ന റൂം ഈ കമ്മ്യൂണിറ്റിക്ക് മാത്രമുള്ളതാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik yang dibuka di sini hanya untuk komuniti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rom som åpnes her, er bare for dette fellesskapet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een room die hier wordt geopend is alleen voor deze community."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój otwarty tutaj jest tylko dla tej społeczności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala aberta aqui é só para esta comunidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala aberta aqui é só para esta comunidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cameră deschisă aici este doar pentru această comunitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комната, открытая здесь, доступна только этому сообществу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť otvorená tu je iba pre túto komunitu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rum som öppnas här är bara för den här communityn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே தொடங்கப்படும் அறை இந்தச் சமூகத்துக்கு மட்டுமே."
