    "auth.rejected.message": {
      "comment": "Body on the rejected-account screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من توثيق هويتك، لذلك هذا الحساب مقفل. إن كنت ترى أن هذا خطأ، يمكنك تقديم تظلّم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয় যাচাই করা যায়নি, তাই এই অ্যাকাউন্ট লক করা হয়েছে। ভুল হয়েছে মনে করলে আপিল করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut verificar la teva identitat, així que aquest compte està bloquejat. Si creus que ha estat un error, pots apel·lar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvou totožnost se nepodařilo ověřit, proto je tento účet uzamčen. Pokud si myslíš, že šlo o chybu, můžeš se odvolat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke verificere din identitet, så denne konto er låst. Hvis du mener, det var en fejl, kan du anke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten deine Identität nicht verifizieren, daher ist dieses Konto gesperrt. Wenn du glaubst, dass es ein Fehler war, kannst du Einspruch einlegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να επαληθεύσουμε την ταυτότητά σου, γι' αυτό ο λογαριασμός είναι κλειδωμένος. Αν πιστεύεις ότι έγινε λάθος, μπορείς να υποβάλεις ένσταση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify your identity, so this account is locked. If you believe this was a mistake, you can appeal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu identidad, por lo que esta cuenta está bloqueada. Si crees que fue un error, puedes apelar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyyttäsi ei voitu vahvistaa, joten tämä tili on lukittu. Jos uskot tämän olevan virhe, voit valittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier votre identité, ce compte est donc verrouillé. Si vous pensez qu’il s’agit d’une erreur, vous pouvez faire un recours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לאמת את זהותך, ולכן החשבון הזה נעול. אם אתה סבור שזו טעות, אפשר לערער."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी पहचान सत्यापित नहीं कर सके, इसलिए यह अकाउंट लॉक है। अगर आपको लगता है कि यह ग़लती थी, तो आप अपील कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli potvrditi tvoj identitet pa je ovaj račun zaključan. Ako smatraš da je to pogreška, možeš se žaliti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtuk hitelesíteni a személyazonosságodat, ezért a fiók zárolva van. Ha szerinted tévedés történt, fellebbezhetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa memverifikasi identitasmu, jadi akun ini dikunci. Jika kamu merasa ini keliru, kamu bisa mengajukan banding."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a verificare la tua identità, quindi questo account è bloccato. Se pensi sia stato un errore, puoi fare ricorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認ができなかったため、このアカウントはロックされています。誤りだと思われる場合は、異議を申し立てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 확인하지 못해 이 계정이 잠겼어요. 실수라고 생각하면 이의를 신청할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഐഡന്റിറ്റി പരിശോധിക്കാനായില്ല, അതിനാൽ ഈ അക്കൗണ്ട് ലോക്ക് ചെയ്തിരിക്കുന്നു. ഇതൊരു പിഴവാണെന്ന് തോന്നുന്നെങ്കിൽ അപ്പീൽ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat mengesahkan identiti anda, jadi akaun ini dikunci. Jika anda percaya ini satu kesilapan, anda boleh membuat rayuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke verifisere identiteten din, så denne kontoen er låst. Hvis du tror det var en feil, kan du anke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je identiteit niet verifiëren, dus dit account is vergrendeld. Denk je dat dit een vergissing is, dan kun je bezwaar maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować Twojej tożsamości, więc to konto jest zablokowane. Jeśli uważasz, że to pomyłka, możesz się odwołać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar sua identidade, por isso esta conta está bloqueada. Se acha que foi um engano, você pode contestar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar a sua identidade, por isso esta conta está bloqueada. Se acha que foi um engano, pode contestar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ți-am putut verifica identitatea, așa că acest cont este blocat. Dacă crezi că a fost o greșeală, poți contesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам не удалось подтвердить вашу личность, поэтому аккаунт заблокирован. Если считаете, что это ошибка, вы можете подать апелляцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa nám overiť tvoju totožnosť, preto je tento účet uzamknutý. Ak si myslíš, že išlo o chybu, môžeš sa odvolať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte verifiera din identitet, så det här kontot är låst. Om du tror att det var ett misstag kan du överklaga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடையாளத்தைச் சரிபார்க்க முடியவில்லை, எனவே இந்தக் கணக்கு பூட்டப்பட்டுள்ளது. இது தவறு என்று நினைத்தால் மேல்முறையீடு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపును ధృవీకరించలేకపోయాం, కాబట్టి ఈ ఖాతా లాక్ చేయబడింది. ఇది పొరపాటని మీరు భావిస్తే, అప్పీల్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรายืนยันตัวตนของคุณไม่ได้ บัญชีนี้จึงถูกล็อก หากคุณคิดว่าเป็นความผิดพลาด คุณอุทธรณ์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi doğrulayamadık, bu yüzden bu hesap kilitli. Bunun bir hata olduğunu düşünüyorsanız itiraz edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам не вдалося верифікувати вашу особу, тому цей обліковий запис заблоковано. Якщо ви вважаєте, що це помилка, ви можете оскаржити рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کی شناخت کی تصدیق نہیں کر سکے، اس لیے یہ اکاؤنٹ مقفل ہے۔ اگر آپ کو لگتا ہے کہ یہ غلطی تھی تو آپ اپیل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không xác minh được danh tính của bạn nên tài khoản này bị khóa. Nếu bạn cho rằng đây là nhầm lẫn, bạn có thể khiếu nại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法验证你的身份，因此此账户已被锁定。如果你认为这是个错误，可以申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法驗證你的身分，因此此帳號已被鎖定。若你認為這是誤判，可以提出申訴。"
          }
        }
      }
    },
