        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora inicias sesión con %@. Tu dirección anterior ya no funciona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudut nyt osoitteella %@. Vanha osoitteesi ei enää toimi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connectez désormais avec %@. Votre ancienne adresse ne fonctionne plus."
