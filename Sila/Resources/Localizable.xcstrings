        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příspěvky uživatele %@ v kanálu Sleduji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opslag fra %@ i dit feed Følger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Beiträge von %@ in deinem Feed „Folge ich“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τις αναρτήσεις του/της %@ στη ροή Ακολουθείς"
