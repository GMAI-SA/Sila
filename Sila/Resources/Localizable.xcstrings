          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątek krajowy. Odpowiadać mogą tylko zweryfikowane konta w kraju: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
