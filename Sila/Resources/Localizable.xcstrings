        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave pelo menos um segundo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave pelo menos um segundo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează cel puțin o secundă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите хотя бы секунду"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraj aspoň sekundu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in minst en sekund"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது ஒரு வினாடி பதிவு செய்யுங்கள்"
