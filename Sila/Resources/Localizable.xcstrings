    "feed.profileOff.empty.action": {
      "comment": "Action on the profiles-off empty state.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغني عند إطلاقها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me when it lands"
          }
        }
      }
    },
    "feed.profileOff.empty.subtitle": {
      "comment": "Says exactly what is off and what still works. Invents no follower count.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات الملفات العامة — عدد المتابِعين وسجل المنشورات وكيف يراك الآخرون — معطّلة في هذا الإصدار. أما اسمك ومعرّفك ونبذتك وصورتك فيمكن تعديلها الآن من «الحساب». ولا نخمّن هنا أي شيء في هذه الأثناء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public profile pages — follower counts, post history and how others see you — are turned off in this build. Your name, handle, bio and picture are editable now under Account. Nothing here is guessed in the meantime."
          }
        }
      }
    },
    "feed.profileOff.empty.title": {
      "comment": "Empty state on the profile tab while public profiles are switched off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات الشخصية معطّلة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles are switched off"
          }
        }
      }
    },
