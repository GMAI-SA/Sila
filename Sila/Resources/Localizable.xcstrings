    "post.hide.done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُخفي الرد. لا يزال كاتبه يراه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর লুকানো হয়েছে। এর লেখক এখনও এটি দেখতে পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta amagada. El seu autor encara la pot veure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď skryta. Její autor ji stále vidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar skjult. Dets forfatter kan stadig se det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort ausgeblendet. Ihr Autor kann sie weiterhin sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση κρύφτηκε. Ο συντάκτης της μπορεί ακόμα να τη δει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply hidden. Its author can still see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta oculta. Su autor aún puede verla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaus piilotettu. Sen kirjoittaja näkee sen yhä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse masquée. Son auteur peut toujours la voir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התגובה הוסתרה. הכותב שלה עדיין יכול לראות אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब छिपा दिया गया। इसका लेखक इसे अब भी देख सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovor sakriven. Njegov autor ga i dalje vidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasz elrejtve. A szerzője továbbra is látja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan disembunyikan. Penulisnya masih bisa melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta nascosta. Il suo autore può ancora vederla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信を非表示にしました。投稿者には引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글을 숨겼어요. 작성자는 여전히 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറുപടി മറച്ചു. അതിന്റെ രചയിതാവിന് ഇപ്പോഴും കാണാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan disembunyikan. Penulisnya masih boleh melihatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret er skjult. Forfatteren kan fortsatt se det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactie verborgen. De auteur ervan kan hem nog zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź ukryta. Jej autor nadal ją widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta ocultada. O autor ainda pode vê-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta ocultada. O autor ainda a consegue ver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspuns ascuns. Autorul lui îl poate vedea în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ скрыт. Его автор по-прежнему его видит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpoveď je skrytá. Jej autor ju stále vidí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret är dolt. Dess skribent kan fortfarande se det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதில் மறைக்கப்பட்டது. அதன் ஆசிரியர் இன்னும் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిప్లై దాచబడింది. దాని రచయితకు అది ఇంకా కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนคำตอบแล้ว ผู้เขียนยังเห็นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt gizlendi. Yazarı yine de görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь приховано. Її автор усе ще бачить її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جواب چھپا دیا گیا۔ اس کا مصنف اسے اب بھی دیکھ سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ẩn trả lời. Tác giả của nó vẫn thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复已隐藏，其作者仍然可以看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆已隱藏。其作者仍看得到。"
          }
        }
      }
    },
