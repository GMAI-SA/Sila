            "state": "translated",
            "value": "Trop d’essais depuis votre connexion"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות מהחיבור שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कनेक्शन से बहुत ज़्यादा कोशिशें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja s tvoje veze"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok próbálkozás a kapcsolatodról"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan dari koneksimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi dalla tua connessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続からの試行が多すぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서 시도가 너무 많아요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കണക്ഷനിൽ നിന്ന് വളരെയധികം ശ്രമങ്ങൾ"
