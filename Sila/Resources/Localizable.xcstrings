        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading this profile"
          }
        }
      }
    },
    "profile.timeline.empty.subtitle": {
      "comment": "Empty profile timeline. %@ is the account's display name. Repeats the exclusion so an empty list is not read as an inactive account.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ %@ أي سلسلة بعد. الردود لا تُعرض هنا، لذلك لن تظهر محادثة شارك فيها فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't started a thread yet. Replies aren't shown here, so a conversation they only joined won't appear."
          }
        }
      }
    },
    "profile.timeline.empty.title": {
      "comment": "Empty profile timeline.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد منشورات بعد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No posts yet"
          }
        }
      }
    },
    "profile.timeline.end": {
      "comment": "Shown at the bottom of a fully-loaded timeline.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه كل المنشورات هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's every post here."
          }
        }
      }
    },
    "profile.timeline.error.title": {
      "comment": "Empty state when the timeline request failed.",
      "extractionState": "manual",
      "localizations": {
