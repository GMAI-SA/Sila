    "communities.visibility.private.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعضاء وحدهم يرون المنشورات والغرف ومن فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সদস্যরা পোস্ট, রুম এবং ভেতরে কারা আছে তা দেখতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els membres veuen les publicacions, les sales i qui en forma part."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky, místnosti i členy vidí jen členové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun medlemmer ser opslagene, rummene og hvem der er med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Mitglieder sehen die Beiträge, die Räume und wer dabei ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο τα μέλη βλέπουν τις αναρτήσεις, τις αίθουσες και ποιος είναι μέσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only members see the posts, the rooms and who is in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los miembros ven las publicaciones, las salas y quién forma parte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain jäsenet näkevät julkaisut, huoneet ja sen, ketkä siinä ovat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les membres voient les posts, les salons et qui en fait partie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חברים רואים את הפוסטים, את החדרים ואת מי שנמצא בה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट, रूम और सदस्य सिर्फ़ सदस्य देखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave, sobe i članove vide samo članovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzéseket, a szobákat és a tagokat csak a tagok látják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anggota yang melihat postingan, room, dan siapa saja di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i membri vedono i post, le stanze e chi ne fa parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿、ルーム、メンバーはメンバーだけが見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버만 게시물, 룸, 멤버 목록을 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റുകളും റൂമുകളും അംഗങ്ങളെയും അംഗങ്ങൾ മാത്രം കാണും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ahli melihat siaran, bilik dan siapa di dalamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare medlemmer ser innleggene, rommene og hvem som er med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen leden zien de berichten, de rooms en wie erin zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko członkowie widzą wpisy, pokoje i to, kto do niej należy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os membros veem os posts, as salas e quem faz parte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os membros veem as publicações, as salas e quem está nela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar membrii văd postările, camerele și cine face parte din ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты, комнаты и список участников видят только участники."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky, miestnosti aj členov vidia iba členovia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara medlemmar ser inläggen, rummen och vilka som är med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகைகள், அறைகள், உள்ளே இருப்பவர்களை உறுப்பினர்கள் மட்டுமே பார்ப்பார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సభ్యులు మాత్రమే పోస్ట్‌లను, రూమ్‌లను, అందులో ఎవరున్నారో చూడగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะสมาชิกที่เห็นโพสต์ ห้อง และรายชื่อสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileri, odaları ve kimlerin içinde olduğunu yalnızca üyeler görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дописи, кімнати та список учасників бачать лише учасники."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ارکان پوسٹس، رومز اور اندر کے لوگوں کو دیکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thành viên thấy bài đăng, phòng và ai ở trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有成员能看到帖子、房间和成员名单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有成員能看到貼文、聊天室和成員名單。"
          }
        }
      }
    },
