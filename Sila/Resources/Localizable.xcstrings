      "comment": "VoiceOver hint for signing out after a password change.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذه الجلسة لتتمكن من تسجيل الدخول بكلمة المرور الجديدة"
          }
        },
        "en": {
          "stringUnit": {
