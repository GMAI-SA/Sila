          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi jednu znamenku koda za potvrdu iz e-pošte"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg az e-mailben kapott megerősítő kód egy számjegyét"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan satu digit dari kode konfirmasi yang dikirim lewat email"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una cifra del codice di conferma ricevuto per email"
