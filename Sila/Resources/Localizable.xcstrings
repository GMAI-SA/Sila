    "profile.requests.silent": {
      "comment": "Footer of the follow-requests sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرفض صامت — لن يُخبَر الطالب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যাখ্যান নীরবে হয় — তাদের জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebutjar és silenciós: no ho saben."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmítnutí je tiché – nikdo se to nedozví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afvisning sker i stilhed – de får ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablehnen geschieht lautlos – die Person wird nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόρριψη είναι αθόρυβη — δεν ενημερώνονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declining is silent — they are not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazar es silencioso: no se les avisa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hylkääminen on äänetöntä – heille ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser se fait en silence — la personne n’en est pas informée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דחייה היא שקטה — הם לא מקבלים הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्वीकार करना चुपचाप होता है — उन्हें बताया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbijanje je tiho — nisu obaviješteni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elutasítás csendes – nem kapnak értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menolak berjalan diam-diam — mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutare è silenzioso: non vengono avvisati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否しても相手には知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절해도 상대방에게 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിരസിക്കുന്നത് നിശ്ശബ്ദമാണ് — അവരെ അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menolak dilakukan secara senyap — mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å avslå skjer i det stille. De får ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigeren gebeurt stil: ze krijgen geen bericht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucenie jest ciche — nikt nie jest o nim informowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusar é silencioso: a pessoa não é avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusar é silencioso — não são avisados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuzul este discret — ei nu sunt anunțați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонение происходит тихо — их не уведомляют."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmietnutie je tiché — nikto sa to nedozvie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att avslå sker i tysthet – de får inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறுப்பது அமைதியானது — அவர்களுக்குத் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తిరస్కరించడం నిశ్శబ్దంగా జరుగుతుంది — వారికి చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปฏิเสธเป็นไปอย่างเงียบๆ พวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddetmek sessizdir; kendilerine haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхилення безшумне — їх не повідомляють."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کرنا خاموش ہے — انہیں نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ chối là âm thầm — họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝是静默的，对方不会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕是無聲的，對方不會得知。"
          }
        }
      }
    },
