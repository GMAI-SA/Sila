    "rooms.notLiveYet.scheduled": {
      "comment": "Refusal for a room that has not started. %@ is when it is due.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ هذه الغرفة بعد. %@"
