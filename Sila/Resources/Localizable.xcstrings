    "auth.wall.unstarted.message": {
      "comment": "Wall body before verification is started.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معروف لا يقبل إلا أشخاصًا موثّقين. امسح هويتك الرسمية وأكمل فحصًا قصيرًا للتأكد من أنك أمام الكاميرا — يستغرق نحو ثلاث دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এ শুধু ভেরিফায়েড মানুষের প্রবেশ। আপনার সরকারি আইডি স্ক্যান করুন এবং একটি ছোট লাইভনেস চেক শেষ করুন — প্রায় তিন মিনিট লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known només admet persones verificades. Escaneja el teu document d'identitat oficial i completa una breu prova de vida: triga uns tres minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known přijímá jen ověřené lidi. Naskenuj svůj úřední doklad a proveď krátkou kontrolu živosti – zabere asi tři minuty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known lukker kun verificerede mennesker ind. Scan dit officielle id, og gennemfør en kort livlighedskontrol – det tager cirka tre minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known lässt nur verifizierte Menschen zu. Scanne deinen amtlichen Ausweis und absolviere eine kurze Lebenderkennung – das dauert etwa drei Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known δέχεται μόνο επαληθευμένους ανθρώπους. Σάρωσε την κρατική σου ταυτότητα και ολοκλήρωσε έναν σύντομο έλεγχο ζωντάνιας — διαρκεί περίπου τρία λεπτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known only admits verified humans. Scan your government ID and complete a short liveness check — it takes about three minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known solo admite a personas verificadas. Escanea tu documento de identidad oficial y completa una breve prueba de vida: lleva unos tres minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known päästää sisään vain vahvistettuja ihmisiä. Skannaa viranomaisen myöntämä henkilöllisyystodistuksesi ja tee lyhyt elävyystarkistus – siihen menee noin kolme minuuttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known n’admet que des humains vérifiés. Scannez votre pièce d’identité officielle et passez un court contrôle de présence — cela prend environ trois minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known מקבלת רק בני אדם מאומתים. סרוק את תעודת הזהות הממשלתית שלך והשלם בדיקת חיות קצרה — זה לוקח כשלוש דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known में केवल सत्यापित इंसानों को प्रवेश मिलता है। अपना सरकारी ID स्कैन करें और एक छोटी लाइवनेस जाँच पूरी करें — इसमें करीब तीन मिनट लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known prima samo potvrđene ljude. Skeniraj svoju osobnu ispravu i obavi kratku provjeru uživo — traje oko tri minute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Knownba csak hitelesített emberek léphetnek be. Szkenneld be a hivatalos azonosítódat, és végezz el egy rövid élőségi ellenőrzést – nagyjából három perc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known hanya menerima manusia terverifikasi. Pindai ID resmimu dan selesaikan pemeriksaan keaslian singkat — sekitar tiga menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ammette solo persone verificate. Scansiona il tuo documento d'identità e completa un breve controllo di presenza reale: ci vogliono circa tre minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownは認証済みの人だけが参加できます。政府発行のIDをスキャンし、短い生体確認を行ってください。所要時間は約3分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known은 인증된 사람만 받아요. 정부 발급 신분증을 스캔하고 간단한 생체 확인을 완료하세요. 약 3분 걸려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known പ്രവേശനം നൽകുന്നത് പരിശോധിച്ച മനുഷ്യർക്ക് മാത്രമാണ്. നിങ്ങളുടെ സർക്കാർ ഐഡി സ്കാൻ ചെയ്ത് ഒരു ചെറിയ ലൈവ്നെസ് പരിശോധന പൂർത്തിയാക്കുക — ഏകദേശം മൂന്ന് മിനിറ്റ് മതി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known hanya menerima manusia yang disahkan. Imbas ID kerajaan anda dan lengkapkan semakan kehadiran ringkas — ia mengambil masa kira-kira tiga minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known slipper bare inn verifiserte mennesker. Skann ID-en din og gjennomfør en kort levendekontroll. Det tar omtrent tre minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known laat alleen geverifieerde mensen toe. Scan je officiële identiteitsbewijs en doe een korte levendigheidscheck. Het duurt ongeveer drie minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known wpuszcza tylko zweryfikowanych ludzi. Zeskanuj dokument tożsamości i przejdź krótką kontrolę obecności — zajmie to około trzech minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known só admite pessoas verificadas. Escaneie seu documento oficial e faça uma rápida prova de vida. Leva cerca de três minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known só admite pessoas verificadas. Digitalize o seu documento de identificação oficial e conclua uma breve verificação de presença — demora cerca de três minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known primește doar oameni verificați. Scanează actul de identitate și fă o scurtă verificare de prezență — durează cam trei minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Known допускаются только проверенные люди. Отсканируйте удостоверение личности и пройдите короткую проверку «живости» — это займёт около трёх минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known púšťa dnu iba overených ľudí. Naskenuj svoj úradný doklad a absolvuj krátku kontrolu živosti — trvá to asi tri minúty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known släpper bara in verifierade människor. Skanna ditt statliga id och gör en kort livskontroll – det tar ungefär tre minuter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known சரிபார்க்கப்பட்ட மனிதர்களை மட்டுமே சேர்க்கும். உங்கள் அரசு அடையாள அட்டையை ஸ்கேன் செய்து சிறிய நேரடிச் சோதனையை முடியுங்கள் — சுமார் மூன்று நிமிடங்கள் ஆகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownలోకి ధృవీకరించబడిన మనుషులకు మాత్రమే ప్రవేశం. మీ ప్రభుత్వ IDని స్కాన్ చేసి, చిన్న లైవ్‌నెస్ తనిఖీ పూర్తి చేయండి — సుమారు మూడు నిమిషాలు పడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known รับเฉพาะคนจริงที่ยืนยันตัวตนแล้ว สแกนบัตรประจำตัวที่รัฐออกให้และทำการตรวจสอบความมีชีวิตสั้นๆ ใช้เวลาประมาณสามนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known yalnızca doğrulanmış insanları kabul eder. Resmi kimliğinizi tarayın ve kısa bir canlılık kontrolünü tamamlayın; yaklaşık üç dakika sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known приймає лише верифікованих людей. Відскануйте посвідчення особи та пройдіть коротку перевірку «живості» — це займе близько трьох хвилин."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known میں صرف تصدیق شدہ انسان داخل ہوتے ہیں۔ اپنا سرکاری شناختی کارڈ اسکین کریں اور مختصر لائیونیس چیک مکمل کریں — اس میں تقریباً تین منٹ لگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known chỉ chào đón những người thật đã xác minh. Quét giấy tờ tùy thân do chính phủ cấp và hoàn tất một bước kiểm tra người thật ngắn — mất khoảng ba phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 只接纳经过验证的真人。扫描你的政府签发证件并完成简短的活体检测，大约需要三分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 只接納經過驗證的真人。掃描你的政府核發證件並完成簡短的真人檢測，大約需要三分鐘。"
          }
        }
      }
    },
