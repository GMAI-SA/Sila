        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ hãy từ từ xoay đầu một vòng đầy đủ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在请慢慢转动头部，转一整圈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在請慢慢轉動頭部繞一圈"
