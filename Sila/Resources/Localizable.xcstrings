    "rooms.access.following.explanation": {
      "comment": "Access option detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمن تتابعهم الدخول، وكذلك من تدعوهم بالاسم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যাদের ফলো করেন তারা এবং আপনি নাম ধরে যাদের আমন্ত্রণ জানান তারা ঢুকতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les persones que segueixes hi poden entrar, i qualsevol que convidis pel nom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstoupit mohou lidé, které sleduješ, a kdokoli, koho pozveš jménem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De folk, du følger, kan komme ind, og alle, du inviterer ved navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Personen, denen du folgst, können hinein, und alle, die du namentlich einlädst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούν να μπουν τα άτομα που ακολουθείς και όποιον προσκαλέσεις ονομαστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The people you follow can come in, and anyone you invite by name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden entrar las personas a las que sigues y cualquiera que invites por su nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraamasi ihmiset pääsevät sisään, samoin kaikki, jotka kutsut nimeltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes que vous suivez peuvent entrer, ainsi que toute personne que vous invitez nommément."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האנשים שאתה עוקב אחריהם יכולים להיכנס, וכל מי שתזמין בשמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिन्हें फ़ॉलो करते हैं वे अंदर आ सकते हैं, और वे भी जिन्हें आप नाम लेकर आमंत्रित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudi koje pratiš mogu ući, kao i svatko koga pozoveš imenom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad követett emberek bejöhetnek, valamint bárki, akit név szerint meghívsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang kamu ikuti bisa masuk, dan siapa pun yang kamu undang dengan nama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possono entrare le persone che segui e chiunque inviti per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー中の人と、名前を指定して招待した人が入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 팔로우하는 사람과 이름으로 초대한 사람이 입장할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഫോളോ ചെയ്യുന്നവർക്കും നിങ്ങൾ പേരെടുത്ത് ക്ഷണിക്കുന്നവർക്കും പ്രവേശിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang anda ikuti boleh masuk, dan sesiapa yang anda jemput dengan nama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk du følger kan komme inn, og alle du inviterer ved navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen die je volgt kunnen binnenkomen, en iedereen die je bij naam uitnodigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wejść mogą osoby, które obserwujesz, oraz każdy, kogo zaprosisz po imieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas que você segue podem entrar, e qualquer pessoa que você convidar pelo nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas que segue podem entrar, e quem convidar pelo nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot intra oamenii pe care îi urmărești și oricine inviți pe nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Могут войти те, на кого вы подписаны, и все, кого вы пригласите по имени."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžu vstúpiť ľudia, ktorých sleduješ, a každý, koho pozveš menom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personerna du följer kan komma in, och alla du bjuder in vid namn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பின்தொடர்பவர்களும், நீங்கள் பெயர் சொல்லி அழைக்கும் எவரும் உள்ளே வரலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫాలో అయ్యేవారు, మీరు పేరుతో ఆహ్వానించిన వారెవరైనా లోపలికి రావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่คุณติดตามเข้าได้ และใครก็ตามที่คุณเชิญโดยระบุชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip ettiğiniz kişiler ve adıyla davet ettiğiniz herkes girebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заходити можуть люди, на яких ви підписані, і всі, кого ви запросите поіменно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جنہیں آپ فالو کرتے ہیں وہ اندر آ سکتے ہیں، اور جسے آپ نام لے کر مدعو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người bạn theo dõi có thể vào, và bất kỳ ai bạn mời đích danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你关注的人可以进入，你点名邀请的人也可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你追蹤的人可以進入，以及你指名邀請的任何人。"
          }
        }
      }
    },
