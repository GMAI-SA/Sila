          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মিউট করা অ্যাকাউন্ট দেখায়, প্রতিটির সাথে আনমিউট বোতাম"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els comptes que has silenciat, cadascun amb un botó per deixar de silenciar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, které jsi ztlumil, každý s tlačítkem zrušení ztlumení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser konti, du har gjort lydløse, hver med en knap til at slå lyd til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Konten, die du stummgeschaltet hast, jeweils mit einer Taste zum Aufheben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τους λογαριασμούς που έχεις βάλει σε σίγαση, καθένας με κουμπί άρσης σίγασης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows accounts you have muted, each with an unmute button"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las cuentas que has silenciado, cada una con un botón para dejar de silenciar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää mykistämäsi tilit, kullakin mykistyksen poistopainike"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les comptes que vous avez mis en sourdine, chacun avec un bouton pour réactiver"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג חשבונות שהשתקת, לכל אחד כפתור לביטול השתקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन अकाउंट को दिखाता है जिन्हें आपने म्यूट किया, हर एक के साथ अनम्यूट बटन"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje račune koje si utišao/la, svaki s gumbom za ukidanje utišavanja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A némított fiókjaidat mutatja, mindegyikhez némításfeloldó gombbal"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan akun yang kamu bisukan, masing-masing dengan tombol batal bisukan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli account che hai silenziato, ciascuno con un pulsante per riattivare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュートしたアカウントを、それぞれの解除ボタン付きで表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뮤트한 계정을 보여주며, 각 계정에 뮤트 해제 버튼이 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ മ്യൂട്ട് ചെയ്ത അക്കൗണ്ടുകൾ, ഓരോന്നിനും അൺമ്യൂട്ട് ബട്ടണോടെ കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan akaun yang anda senyapkan, masing-masing dengan butang nyahsenyap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kontoer du har dempet, hver med en knapp for å oppheve dempingen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont accounts die je hebt gedempt, elk met een knop om het dempen op te heffen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wyciszone konta, każde z przyciskiem cofnięcia wyciszenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as contas que você silenciou, cada uma com um botão para reativar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as contas que silenciou, cada uma com um botão para deixar de silenciar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată conturile dezactivate de tine, fiecare cu un buton de reactivare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает заглушённые вами аккаунты, у каждого есть кнопка включения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí účty, ktoré si stlmil, každý s tlačidlom zrušiť stlmenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar konton du har tystat, var och en med en knapp för att sluta tysta"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஒலியடக்கிய கணக்குகளை, ஒவ்வொன்றுக்கும் ஒலியடக்கம் நீக்கு பொத்தானுடன் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మ్యూట్ చేసిన ఖాతాలను, ప్రతిదానికి అన్‌మ్యూట్ బటన్‌తో చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบัญชีที่คุณปิดเสียง แต่ละบัญชีมีปุ่มเลิกปิดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessize aldığınız hesapları, her biri sesi aç düğmesiyle gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує облікові записи, які ви заглушили, кожен із кнопкою зняття заглушення"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے میوٹ کیے ہوئے اکاؤنٹس دکھاتا ہے، ہر ایک کے ساتھ ان میوٹ کا بٹن"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các tài khoản bạn đã ẩn, mỗi tài khoản có nút bỏ ẩn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你已静音的账户，每个都带有取消静音按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你靜音的帳號，每個都有取消靜音按鈕"
          }
        }
      }
    },
