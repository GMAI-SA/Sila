        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവർ ആരാണെന്ന് ചോദിക്കുകയും അവർക്ക് അയയ്ക്കാൻ ഒരു ലിങ്ക് നൽകുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertanya siapa mereka, kemudian memberi anda pautan untuk dihantar kepada mereka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør hvem de er, og gir deg deretter en lenke du kan sende dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt wie ze zijn en geeft je dan een link om naar hen te sturen"
