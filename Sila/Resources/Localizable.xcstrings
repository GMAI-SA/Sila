    "vouch.mine.verified.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّقت هويتك، فلا حاجة لك إلى تزكية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি পরিচয় ভেরিফাই করেছেন, তাই ভাউচের প্রয়োজন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has verificat la teva identitat, així que no necessites cap aval."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřil jsi svou totožnost, takže ručení nepotřebuješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har verificeret din identitet, så du behøver ikke en garanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Identität verifiziert, daher brauchst du keine Bürgschaft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαλήθευσες την ταυτότητά σου, οπότε δεν χρειάζεσαι εγγύηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You verified your identity, so you don't need a vouch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaste tu identidad, así que no necesitas un aval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistit henkilöllisyytesi, joten et tarvitse takuuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez vérifié votre identité, vous n’avez donc pas besoin de caution."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימתת את זהותך, ולכן אינך זקוק לערבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपनी पहचान सत्यापित कर ली है, इसलिए आपको वाउच की ज़रूरत नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdio/la si svoj identitet pa ti jamstvo ne treba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitelesítetted a személyazonosságodat, ezért nincs szükséged kezességre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memverifikasi identitasmu, jadi tidak butuh jaminan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai verificato la tua identità, quindi non ti serve una garanzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認が完了しているため、保証は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 인증했으므로 보증이 필요 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്തതിനാൽ വൗച്ച് ആവശ്യമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mengesahkan identiti anda, jadi anda tidak memerlukan jaminan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifiserte identiteten din, så du trenger ingen garanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je identiteit geverifieerd, dus je hebt geen garantie nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowałeś tożsamość, więc nie potrzebujesz poręczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você verificou sua identidade, então não precisa de um aval."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificou a sua identidade, por isso não precisa de aval."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ți-ai verificat identitatea, deci nu ai nevoie de garanție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прошли проверку личности, поэтому поручительство вам не нужно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overil si svoju totožnosť, takže ručenie nepotrebuješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifierade din identitet, så du behöver inget intygande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் அடையாளத்தைச் சரிபார்த்துவிட்டீர்கள், எனவே உறுதிமொழி தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ గుర్తింపును ధృవీకరించుకున్నారు, కాబట్టి మీకు హామీ అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันตัวตนแล้ว จึงไม่จำเป็นต้องมีผู้รับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi doğruladınız, bu yüzden kefilliğe ihtiyacınız yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви верифікували особу, тож поручительство вам не потрібне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اپنی شناخت کی تصدیق کر لی، اس لیے آپ کو ضمانت کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xác minh danh tính, nên không cần lời bảo chứng."
          }
        },
        "zh-Hans": {
