        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ovenfor, og åbn så et rum for den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle oben eine und öffne dann einen Raum dafür."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξε μία παραπάνω και μετά άνοιξε μια αίθουσα για αυτήν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one above, then open a room for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno arriba y luego abre una sala para él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee yksi yllä ja avaa sille huone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en un ci-dessus, puis ouvrez un salon pour lui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור אחת למעלה, ואז פתח עבורה חדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर एक बनाएँ, फिर उसके लिए रूम खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izradi je iznad, pa otvori sobu za nju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre egyet fent, majd nyiss hozzá szobát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat satu di atas, lalu buka room untuknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane uno qui sopra, poi apri una stanza per lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で作成して、そのグループ向けのルームを開きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 그룹을 만들고 룸을 열어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിൽ ഒന്ന് ഉണ്ടാക്കി, അതിനായി ഒരു റൂം തുറക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta satu di atas, kemudian buka bilik untuknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en ovenfor, og åpne deretter et rom for den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak hierboven een groep en open er dan een room voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz ją powyżej, a potem otwórz dla niej pokój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um acima e depois abra uma sala para ele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um acima e depois abra uma sala para ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează unul mai sus, apoi deschide o cameră pentru el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте её выше, а затем откройте для неё комнату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvor jednu vyššie a potom pre ňu otvor miestnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en ovan och öppna sedan ett rum för den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே ஒன்றை உருவாக்கி, அதற்காக ஓர் அறையைத் திறங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైన ఒకటి చేసి, దాని కోసం రూమ్ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างกลุ่มด้านบน แล้วเปิดห้องให้กลุ่มนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdan bir tane oluşturun, sonra onun için bir oda açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть її вище, а потім відкрийте для неї кімнату."
