    "document.submitting.message": {
      "comment": "Body while uploading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنقل صورك مشفّرة وتُحذف لحظة يقرر المراجع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ছবিগুলো এনক্রিপ্টেড অবস্থায় যায় এবং রিভিউয়ার সিদ্ধান্ত নেওয়ার মুহূর্তেই মুছে ফেলা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves fotos viatgen xifrades i s'eliminen en el moment en què un revisor decideix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé fotografie putují šifrovaně a smažou se v okamžiku, kdy posuzovatel rozhodne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos sendes krypteret og slettes i det øjeblik, en gennemgående afgør sagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos werden verschlüsselt übertragen und gelöscht, sobald ein Prüfer entscheidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες σου ταξιδεύουν κρυπτογραφημένες και διαγράφονται τη στιγμή που ένας ελεγκτής αποφασίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos travel encrypted and are deleted the moment a reviewer decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos viajan cifradas y se eliminan en cuanto un revisor decide."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvasi kulkevat salattuina ja poistetaan heti, kun tarkastaja tekee päätöksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos transitent chiffrées et sont supprimées dès qu’un vérificateur décide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות שלך עוברות מוצפנות ונמחקות ברגע שבודק מחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो एन्क्रिप्टेड पहुँचती हैं और समीक्षक के फ़ैसले करते ही हटा दी जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje fotografije putuju šifrirane i brišu se čim recenzent donese odluku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotóid titkosítva utaznak, és az elbírálás pillanatában törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotomu dikirim terenkripsi dan dihapus begitu peninjau memutuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto viaggiano cifrate e vengono eliminate nel momento in cui un revisore decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は暗号化されて送信され、審査担当者が判断した時点で削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
