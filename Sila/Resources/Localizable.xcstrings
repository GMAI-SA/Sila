        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle ima 3–20 znakova: slova, brojeva i podcrta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az @név 3–20 karakter lehet: betűk, számok és aláhúzás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle terdiri dari 3–20 karakter berupa huruf, angka, dan garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli handle sono lunghi da 3 a 20 caratteri tra lettere, numeri e trattini bassi."
          }
        },
        "ja": {
