    "document.submitting.keepOpen": {
      "comment": "Under 'Checking your documents…'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا عادةً بضع ثوانٍ. أبقِ «معروف» مفتوحًا حتى ينتهي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণত কয়েক সেকেন্ড লাগে। শেষ না হওয়া পর্যন্ত Known খোলা রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalment triga uns segons. Mantén Known obert fins que acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvykle to trvá několik sekund. Nech aplikaci Known otevřenou, dokud se to nedokončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tager som regel et par sekunder. Hold Known åben, til det er færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert meist ein paar Sekunden. Lass Known geöffnet, bis es fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνήθως παίρνει λίγα δευτερόλεπτα. Κράτα το Known ανοιχτό μέχρι να τελειώσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This usually takes a few seconds. Keep Known open until it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suele tardar unos segundos. Mantén Known abierta hasta que termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kestää yleensä muutaman sekunnin. Pidä Known auki, kunnes valmista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend généralement quelques secondes. Gardez Known ouverte jusqu’à la fin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה בדרך כלל לוקח כמה שניות. השאר את Known פתוחה עד שזה יסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें आमतौर पर कुछ सेकंड लगते हैं। पूरा होने तक Known खुला रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo obično traje nekoliko sekundi. Drži aplikaciju Known otvorenom dok se ne završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez általában néhány másodperc. Hagyd nyitva a Knownt, amíg végez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini biasanya butuh beberapa detik. Biarkan Known terbuka sampai selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito ci vogliono pochi secondi. Tieni Known aperta finché non finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は数秒で終わります。完了するまでKnownを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 몇 초 걸려요. 끝날 때까지 Known을 열어 두세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് സാധാരണ ഏതാനും സെക്കൻഡ് മതി. പൂർത്തിയാകുന്നതുവരെ Known തുറന്നുവയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini biasanya mengambil masa beberapa saat. Biarkan Known terbuka sehingga selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tar vanligvis noen sekunder. Hold Known åpen til det er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit duurt meestal een paar seconden. Houd Known open tot het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle trwa to kilka sekund. Nie zamykaj Known do końca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente leva alguns segundos. Mantenha o Known aberto até terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto costuma demorar alguns segundos. Mantenha a Known aberta até terminar."
          }
        },
        "ro": {
