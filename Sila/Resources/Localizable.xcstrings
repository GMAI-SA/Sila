        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 正在为你担保"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 正在為你擔保"
          }
        }
      }
    },
    "vouch.claim.unavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما انتهت صلاحيته أو استُخدم أو سُحب. اطلب من مرسله رابطًا جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর মেয়াদ শেষ হয়ে থাকতে পারে, আগেই ব্যবহার হয়ে থাকতে পারে, অথবা প্রত্যাহার করা হয়ে থাকতে পারে। যিনি পাঠিয়েছেন তাঁর কাছে নতুন একটি চান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot haver caducat, ja s'ha fet servir o s'ha retirat. Demana'n un de nou a qui te'l va enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možná vypršel, už byl použit nebo byl odvolán. Požádej osobu, která ti ho poslala, o nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er måske udløbet, allerede brugt eller trukket tilbage. Bed den, der sendte det, om et nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist möglicherweise abgelaufen, wurde bereits verwendet oder zurückgezogen. Bitte die Person, die ihn gesendet hat, um einen neuen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να έχει λήξει, να έχει ήδη χρησιμοποιηθεί ή να έχει ανακληθεί. Ζήτησε νέο από το άτομο που τον έστειλε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have expired, been used already, or been withdrawn. Ask the person who sent it for a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que haya caducado, que ya se haya usado o que se haya retirado. Pide uno nuevo a quien te lo envió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on voinut vanhentua, tulla jo käytetyksi tai peruutetuksi. Pyydä sen lähettäneeltä uusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a peut-être expiré, déjà été utilisé ou été retiré. Demandez-en un nouveau à la personne qui l’a envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שפג תוקפו, שכבר נעשה בו שימוש או שנמשך. בקש קישור חדש ממי ששלח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है यह समाप्त हो गया हो, पहले ही इस्तेमाल हो चुका हो, या वापस ले लिया गया हो। इसे भेजने वाले से नया माँगें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možda je istekla, već je iskorištena ili povučena. Zatraži novu od osobe koja ti ju je poslala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehet, hogy lejárt, már felhasználták, vagy visszavonták. Kérj újat attól, aki küldte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin sudah kedaluwarsa, sudah dipakai, atau ditarik. Minta tautan baru kepada orang yang mengirimnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere scaduto, già usato o ritirato. Chiedine uno nuovo a chi te l'ha inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効期限が切れた、すでに使用された、または取り消された可能性があります。送ってくれた人に新しいリンクを頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되었거나, 이미 사용되었거나, 철회되었을 수 있어요. 링크를 보낸 사람에게 새 링크를 요청하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലാവധി കഴിഞ്ഞിരിക്കാം, ഇതിനകം ഉപയോഗിച്ചിരിക്കാം, അല്ലെങ്കിൽ പിൻവലിച്ചിരിക്കാം. അയച്ചയാളോട് പുതിയത് ചോദിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia mungkin telah tamat tempoh, sudah digunakan, atau ditarik balik. Minta pautan baharu daripada orang yang menghantarnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ha utløpt, allerede være brukt eller være trukket tilbake. Be personen som sendte den, om en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij is mogelijk verlopen, al gebruikt of ingetrokken. Vraag de persoon die hem stuurde om een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogło wygasnąć, zostać już użyte lub wycofane. Poproś osobę, która je wysłała, o nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode ter expirado, já ter sido usado ou ter sido retirado. Peça um novo a quem o enviou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ter expirado, já ter sido usada ou ter sido retirada. Peça uma nova a quem a enviou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate a expirat, a fost deja folosit sau a fost retras. Cere un link nou persoanei care ți l-a trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, срок истёк, ссылка уже использована или отозвана. Попросите отправившего прислать новую."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohol vypršať, byť už použitý alebo stiahnutý. Požiadaj osobu, ktorá ho poslala, o nový."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ha gått ut, redan använts eller dragits tillbaka. Be personen som skickade det om ett nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது காலாவதியாகியிருக்கலாம், ஏற்கெனவே பயன்படுத்தப்பட்டிருக்கலாம் அல்லது திரும்பப் பெறப்பட்டிருக்கலாம். அனுப்பியவரிடம் புதிய இணைப்பைக் கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది గడువు ముగిసి ఉండవచ్చు, ఇప్పటికే వాడబడి ఉండవచ్చు లేదా ఉపసంహరించబడి ఉండవచ్చు. దీన్ని పంపిన వ్యక్తిని కొత్తది అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจหมดอายุ ถูกใช้ไปแล้ว หรือถูกถอน ขอลิงก์ใหม่จากคนที่ส่งให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süresi dolmuş, zaten kullanılmış veya geri çekilmiş olabilir. Bağlantıyı gönderen kişiden yenisini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, його термін минув, його вже використано або відкликано. Попросіть того, хто його надіслав, надіслати нове."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو سکتا ہے اس کی میعاد ختم ہو گئی ہو، یہ استعمال ہو چکا ہو، یا واپس لے لیا گیا ہو۔ بھیجنے والے سے نیا مانگیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể nó đã hết hạn, đã được dùng, hoặc đã bị rút lại. Hãy xin người đã gửi một liên kết mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已过期、已被使用，或已被撤回。请向发送者索要新的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已過期、已被使用，或已被撤回。請向傳送者索取新的連結。"
          }
        }
      }
    },
    "vouch.claim.unavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام رابط التزكية هذا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সুপারিশের লিংক ব্যবহার করা যাবে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest enllaç d'aval no es pot fer servir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento odkaz na ručení nelze použít"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette garantilink kan ikke bruges"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
