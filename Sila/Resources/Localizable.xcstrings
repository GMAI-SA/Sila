    "document.sweep.title": {
      "comment": "Sweep step title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "والآن أدر رأسك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এবার মাথা ঘোরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara gira el cap"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní otoč hlavu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej nu hovedet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt den Kopf drehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα γύρνα το κεφάλι σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now turn your head"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora gira la cabeza"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä nyt päätäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant, tournez la tête"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו סובב את הראש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब अपना सिर घुमाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada okreni glavu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most fordítsd el a fejed"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang putar kepalamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora gira la testa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭を回してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 고개를 돌리세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനി തല തിരിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang pusingkan kepala anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå snur du hodet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai nu je hoofd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz obróć głowę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora gire a cabeça"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vire a cabeça"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum întoarce capul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь поверните голову"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz otoč hlavu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid nu på huvudet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்கள் தலையைத் திருப்புங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
