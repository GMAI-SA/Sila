        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’en est pas informé. Known n’envoie aucune notification et ne lui montre aucun message à ce sujet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא מקבל הודעה. Known לא שולחת התראה ולא מציגה לו שום הודעה על כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को बताया नहीं जाता। Known कोई सूचना नहीं भेजता और उन्हें इस बारे में कोई संदेश नहीं दिखाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije obaviješten/a. Known ne šalje obavijest niti mu/joj prikazuje poruku o tome."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem kap értesítést. A Known nem küld értesítést, és nem mutat neki üzenetet erről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak diberi tahu. Known tidak mengirim notifikasi dan tidak menampilkan pesan apa pun tentang ini kepada mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non viene avvisato. Known non invia nessuna notifica né gli mostra alcun messaggio al riguardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には知らされません。Knownは通知を送らず、このことに関するメッセージも表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님에게는 알려지지 않아요. Known은 알림을 보내지 않고 이에 대한 메시지도 표시하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ അറിയിക്കില്ല. Known ഒരു അറിയിപ്പും അയയ്ക്കില്ല, ഇതേക്കുറിച്ച് സന്ദേശവും കാണിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak diberitahu. Known tidak menghantar pemberitahuan dan tidak menunjukkan sebarang mesej kepada mereka tentang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får ikke vite det. Known sender ikke noe varsel og viser dem ingen melding om dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ krijgt hier geen bericht van. Known stuurt geen melding en toont geen bericht hierover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownik %@ nie jest o tym informowany. Known nie wysyła żadnego powiadomienia ani komunikatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é avisado. O Known não envia nenhuma notificação nem mostra mensagem alguma a respeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é avisado. A Known não envia notificação nem mostra qualquer mensagem sobre isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu este anunțat. Known nu trimite nicio notificare și nu îi arată niciun mesaj despre asta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не будет уведомлён(а). Known не отправляет уведомлений и не показывает им никаких сообщений об этом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sa o tom nedozvie. Known nepošle žiadne upozornenie ani nezobrazí žiadnu správu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får inte veta det. Known skickar ingen avisering och visar dem inget meddelande om detta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்குத் தெரிவிக்கப்படாது. Known அறிவிப்பு எதுவும் அனுப்பாது, இது குறித்து எந்தச் செய்தியும் காட்டாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@కు చెప్పబడదు. Known ఎలాంటి నోటిఫికేషన్ పంపదు, దీని గురించి వారికి ఏ సందేశమూ చూపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ได้รับแจ้ง Known ไม่ส่งการแจ้งเตือนและไม่แสดงข้อความใดๆ ให้พวกเขาเกี่ยวกับเรื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisine haber verilmez. Known bildirim göndermez ve bu konuda onlara mesaj göstermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не повідомляють. Known не надсилає сповіщення й не показує їм жодного повідомлення про це."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو نہیں بتایا جاتا۔ Known کوئی اطلاع نہیں بھیجتا اور انہیں اس کے بارے میں کوئی پیغام نہیں دکھاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không được thông báo. Known không gửi thông báo và không hiển thị cho họ thông điệp nào về việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会通知 %@。Known 不会发送通知，也不会向对方显示任何相关消息。"
