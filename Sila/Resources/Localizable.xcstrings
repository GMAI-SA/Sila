    "rooms.create.group.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مجموعات لديك بعد. أنشئ واحدة لتفتح لها غرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার এখনও কোনো গ্রুপ নেই। এর জন্য রুম খুলতে একটি তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no tens cap grup. Crea'n un per obrir-li una sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nemáš žádné skupiny. Vytvoř jednu a otevři pro ni místnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ingen grupper endnu. Opret en for at åbne et rum for den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch keine Gruppen. Erstelle eine, um einen Raum dafür zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις ακόμα ομάδες. Φτιάξε μία για να ανοίξεις αίθουσα για αυτήν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no groups yet. Make one to open a room for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes grupos. Crea uno para abrirle una sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla ei ole vielä ryhmiä. Tee yksi avataksesi sille huoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas encore de groupe. Créez-en un pour lui ouvrir un salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין לך עדיין קבוצות. צור אחת כדי לפתוח עבורה חדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास अभी कोई ग्रुप नहीं है। उसके लिए रूम खोलने से पहले एक बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nemaš grupa. Izradi jednu da za nju otvoriš sobu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs csoportod. Hozz létre egyet, hogy szobát nyiss hozzá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum punya grup. Buat satu untuk membukakan room."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora gruppi. Creane uno per aprire una stanza per lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはまだありません。作成して、そのグループ向けのルームを開きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 그룹이 없어요. 그룹을 만들어 룸을 열어 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് ഇതുവരെ ഗ്രൂപ്പുകളില്ല. അതിനായി റൂം തുറക്കാൻ ഒന്ന് ഉണ്ടാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum mempunyai kumpulan. Cipta satu untuk membukakan bilik baginya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ingen grupper ennå. Lag en for å åpne et rom for den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog geen groepen. Maak er een om er een room voor te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze grup. Utwórz jedną, aby otworzyć dla niej pokój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não tem grupos. Crie um para abrir uma sala para ele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tem grupos. Crie um para abrir uma sala para ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ai grupuri. Creează unul ca să deschizi o cameră pentru el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас пока нет групп. Создайте группу, чтобы открыть для неё комнату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nemáš žiadne skupiny. Vytvor jednu a otvor pre ňu miestnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inga grupper än. Skapa en för att öppna ett rum för den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு இன்னும் குழுக்கள் இல்லை. அதற்காக அறை திறக்க ஒன்றை உருவாக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఇంకా గ్రూప్‌లు లేవు. దాని కోసం రూమ్ తెరవడానికి ఒకటి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่มีกลุ่ม สร้างกลุ่มเพื่อเปิดห้องให้กลุ่มนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz grubunuz yok. Bunun için oda açmak üzere bir tane oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас ще немає груп. Створіть одну, щоб відкрити для неї кімнату."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ابھی کوئی گروپ نہیں۔ اس کے لیے روم کھولنے کو ایک بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa có nhóm nào. Hãy tạo một nhóm để mở phòng cho nhóm đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有群组。创建一个，再为它开启房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還沒有群組。建立一個，才能為它開設聊天室。"
          }
        }
      }
    },
