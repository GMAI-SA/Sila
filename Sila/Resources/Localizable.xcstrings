    "guest.room.refusal.roomClosed.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتحها مضيفها للمدعوين أو المتابعين أو لمجموعة أو مجتمع — لا للزوار. انضم إلى «معروف» أو سجّل الدخول لترى إن كان بإمكانك الاستماع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর হোস্ট এটি আমন্ত্রিত মানুষ, ফলোয়ার, একটি গ্রুপ বা একটি কমিউনিটির জন্য খুলেছেন — অতিথিদের জন্য নয়। শুনতে পারবেন কি না দেখতে Known-এ যোগ দিন বা সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El seu amfitrió l'ha oberta a persones convidades, seguidors, un grup o una comunitat, no a convidats. Uneix-te a Known o inicia la sessió per veure si pots escoltar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostitel ji otevřel pozvaným lidem, sledujícím, skupině nebo komunitě – ne hostům. Připoj se k aplikaci Known nebo se přihlas a uvidíš, zda můžeš poslouchat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dets vært åbnede det for inviterede, følgere, en gruppe eller et fællesskab – ikke for gæster. Deltag i Known eller log ind for at se, om du kan lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Host hat ihn für eingeladene Personen, Follower, eine Gruppe oder eine Community geöffnet – nicht für Gäste. Tritt Known bei oder melde dich an, um zu sehen, ob du zuhören kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο οικοδεσπότης της την άνοιξε για προσκεκλημένους, ακολούθους, μια ομάδα ή μια κοινότητα — όχι για επισκέπτες. Γράψου στο Known ή συνδέσου για να δεις αν μπορείς να ακούσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its host opened it to invited people, followers, a group or a community — not to guests. Join Known or sign in to see whether you can listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su anfitrión la abrió a personas invitadas, seguidores, un grupo o una comunidad, no a invitados sin cuenta. Únete a Known o inicia sesión para ver si puedes escuchar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen isäntä avasi sen kutsutuille, seuraajille, ryhmälle tai yhteisölle – ei vieraille. Liity Knowniin tai kirjaudu sisään nähdäksesi, voitko kuunnella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son animateur l’a ouvert aux personnes invitées, aux abonnés, à un groupe ou à une communauté — pas aux invités. Rejoignez Known ou connectez-vous pour voir si vous pouvez écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המארח שלו פתח אותו למוזמנים, לעוקבים, לקבוצה או לקהילה — לא לאורחים. הצטרף ל-Known או התחבר כדי לראות אם אפשר להאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके होस्ट ने इसे आमंत्रित लोगों, फ़ॉलोअर, किसी ग्रुप या कम्युनिटी के लिए खोला है — मेहमानों के लिए नहीं। देखने के लिए कि आप सुन सकते हैं या नहीं, Known से जुड़ें या साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njezin domaćin otvorio ju je pozvanima, pratiteljima, grupi ili zajednici — ne gostima. Pridruži se aplikaciji Known ili se prijavi da vidiš možeš li slušati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A házigazdája meghívottaknak, követőknek, csoportnak vagy közösségnek nyitotta meg – nem vendégeknek. Csatlakozz a Knownhoz vagy jelentkezz be, hogy kiderüljön, hallgathatod-e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostnya membukanya untuk orang yang diundang, pengikut, grup, atau komunitas — bukan untuk tamu. Gabung Known atau masuk untuk melihat apakah kamu bisa mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo host l'ha aperta a persone invitate, follower, un gruppo o una community, non agli ospiti. Iscriviti a Known o accedi per vedere se puoi ascoltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストは、招待した人、フォロワー、グループ、コミュニティに向けて開いており、ゲストには開いていません。聴けるかどうかは、Knownに参加するかサインインして確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트가 초대된 사람, 팔로워, 그룹 또는 커뮤니티에게만 열었고 게스트에게는 열지 않았어요. 들을 수 있는지 확인하려면 Known에 가입하거나 로그인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന്റെ ഹോസ്റ്റ് ഇത് ക്ഷണിക്കപ്പെട്ടവർക്കോ ഫോളോവർമാർക്കോ ഒരു ഗ്രൂപ്പിനോ കമ്മ്യൂണിറ്റിക്കോ തുറന്നതാണ് — അതിഥികൾക്കല്ല. നിങ്ങൾക്ക് കേൾക്കാനാകുമോ എന്നറിയാൻ Known-ൽ ചേരുക അല്ലെങ്കിൽ സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosnya membukanya kepada orang yang dijemput, pengikut, kumpulan atau komuniti — bukan kepada tetamu. Sertai Known atau log masuk untuk melihat sama ada anda boleh mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verten åpnet det for inviterte, følgere, en gruppe eller et fellesskap, ikke for gjester. Bli med på Known eller logg inn for å se om du kan lytte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De host heeft hem geopend voor uitgenodigde mensen, volgers, een groep of een community, niet voor gasten. Meld je aan bij Known of log in om te zien of je kunt luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gospodarz otworzył go dla zaproszonych osób, obserwujących, grupy lub społeczności — nie dla gości. Dołącz do Known lub zaloguj się, aby sprawdzić, czy możesz słuchać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anfitrião a abriu para convidados, seguidores, um grupo ou uma comunidade, e não para visitantes. Entre no Known ou faça login para ver se você pode ouvir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anfitrião abriu-a a convidados, seguidores, um grupo ou uma comunidade — não a visitantes. Entre na Known ou inicie sessão para ver se pode ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gazda a deschis-o pentru persoane invitate, urmăritori, un grup sau o comunitate — nu pentru invitați. Alătură-te Known sau autentifică-te ca să vezi dacă poți asculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведущий открыл её для приглашённых, подписчиков, группы или сообщества — но не для гостей. Присоединитесь к Known или войдите, чтобы узнать, можете ли вы слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej hostiteľ ju otvoril pre pozvaných, sledovateľov, skupinu alebo komunitu — nie pre hostí. Pripoj sa k Known alebo sa prihlás a zisti, či môžeš počúvať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess värd öppnade det för inbjudna, följare, en grupp eller en community – inte för gäster. Gå med i Known eller logga in för att se om du kan lyssna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதன் நடத்துநர் அதை அழைக்கப்பட்டவர்கள், பின்தொடர்பவர்கள், ஒரு குழு அல்லது ஒரு சமூகத்துக்குத் திறந்துள்ளார் — விருந்தினர்களுக்கு அல்ல. நீங்கள் கேட்க முடியுமா என்று பார்க்க Known-இல் சேருங்கள் அல்லது உள்நுழையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని హోస్ట్ దీన్ని ఆహ్వానించిన వారికి, ఫాలోయర్లకు, ఒక గ్రూప్‌కు లేదా కమ్యూనిటీకి తెరిచారు — అతిథులకు కాదు. మీరు వినగలరో లేదో చూడటానికి Knownలో చేరండి లేదా సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจ้าของห้องเปิดให้ผู้ได้รับเชิญ ผู้ติดตาม กลุ่ม หรือชุมชน ไม่ใช่ผู้เยี่ยมชม เข้าร่วม Known หรือลงชื่อเข้าใช้เพื่อดูว่าคุณฟังได้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucusu bu odayı davetlilere, takipçilere, bir gruba veya topluluğa açtı; misafirlere değil. Dinleyip dinleyemeyeceğinizi görmek için Known'a katılın veya giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її ведучий відкрив її для запрошених людей, підписників, групи чи спільноти — не для гостей. Приєднайтеся до Known або увійдіть, щоб побачити, чи можете ви слухати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے میزبان نے اسے مدعو لوگوں، فالوورز، کسی گروپ یا کمیونٹی کے لیے کھولا ہے — مہمانوں کے لیے نہیں۔ دیکھنے کے لیے کہ آپ سن سکتے ہیں یا نہیں، Known میں شامل ہوں یا سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ phòng đã mở nó cho người được mời, người theo dõi, một nhóm hoặc một cộng đồng — không phải cho khách. Hãy tham gia Known hoặc đăng nhập để xem bạn có nghe được không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人只向受邀者、关注者、某个群组或社区开放，不对访客开放。加入 Known 或登录后，看看你是否可以收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人只向受邀者、追蹤者、群組或社群開放，未開放給訪客。請加入 Known 或登入，看看你是否能收聽。"
          }
        }
      }
    },
