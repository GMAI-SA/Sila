    "composer.scope.region.subtitle": {
      "comment": "What a regional audience means. %@ is the region's full name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للحسابات الموثّقة في %@ الرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ জুড়ে ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi poden respondre els comptes verificats de tot %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat mohou ověřené účty z oblasti %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificerede konti i hele %@ kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifizierte Konten in %@ können antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθευμένοι λογαριασμοί σε όλη την περιοχή %@ μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified accounts across %@ can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden responder las cuentas verificadas de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistetut tilit alueelta %@ voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes vérifiés de toute la zone %@ peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבונות מאומתים ברחבי %@ יכולים להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ भर के सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarati mogu potvrđeni računi iz regije: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő térség hitelesített fiókjai válaszolhatnak: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun terverifikasi di seluruh %@ bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possono rispondere gli account verificati di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の認証済みアカウントが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 전역의 인증된 계정이 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മേഖലയിലുടനീളമുള്ള പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മറുപടി നൽകാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun yang disahkan di seluruh %@ boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiserte kontoer i %@ kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerde accounts in %@ kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadać mogą zweryfikowane konta z: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas verificadas em %@ podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas verificadas de %@ podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conturile verificate din %@ pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечать могут проверенные аккаунты региона: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať môžu overené účty z regiónu %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifierade konton i %@ kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முழுவதும் உள்ள சரிபார்க்கப்பட்ட கணக்குகள் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అంతటా ధృవీకరించబడిన ఖాతాలు రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีที่ยืนยันตัวตนแล้วทั่ว %@ ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ genelinde doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідати можуть верифіковані облікові записи з регіону: %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بھر کے تصدیق شدہ اکاؤنٹ جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tài khoản đã xác minh trong %@ đều trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内已验证的账户都可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 各地已驗證的帳號都能回覆。"
          }
        }
      }
    },
    "composer.scope.row.a11yHint": {
      "comment": "VoiceOver hint for a selectable audience row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
