    "vouch.profile.row": {
      "comment": "Where a verified name would be. %1$@ is the voucher's handle, %2$@ a day and month.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوثّق هويته · بتزكية ⁦@%1$@⁩ منذ %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয় ভেরিফায়েড নয় · %2$@ থেকে @%1$@-এর ভাউচ পাওয়া"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense verificar la identitat · avalat per @%1$@ des del %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ověření totožnosti · ručí @%1$@ od %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke identitetsverificeret · garanteret af @%1$@ siden %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht identitätsverifiziert · Bürgschaft von @%1$@ seit %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς επαλήθευση ταυτότητας · με εγγύηση από τον/την @%1$@ από %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not identity‑verified · vouched for by @%1$@ since %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin identidad verificada · avalado por @%1$@ desde %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyyttä ei vahvistettu · käyttäjän @%1$@ takaama %2$@ lähtien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identité non vérifiée · sous la caution de @%1$@ depuis le %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהות לא מאומתת · נערב לו על ידי @%1$@ מאז %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान‑सत्यापित नहीं · @%1$@ ने %2$@ से वाउच किया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitet nije potvrđen · za njega jamči @%1$@ od: %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs személyazonosság-hitelesítve · @%1$@ kezeskedik érte ettől: %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identitas belum terverifikasi · dijamin oleh @%1$@ sejak %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Identità non verificata · garantito da @%1$@ dal %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認なし · %2$@から@%1$@が保証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원 미인증 · %2$@부터 @%1$@님이 보증"
