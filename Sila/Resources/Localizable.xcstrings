    "safety.menu.unmute.hint": {
      "comment": "VoiceOver hint for unmuting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد منشوراته للظهور لك. ولا يُبلَّغ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাদের পোস্ট আবার আপনার ফিডে আসতে দেয়। তাদের জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a deixar entrar les seves publicacions als teus canals. No ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí jeho příspěvky do tvých kanálů. Nedozví se to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader vedkommendes opslag komme tilbage i dine feeds. Vedkommende får ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die Beiträge wieder in deine Feeds. Die Person wird nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει ξανά τις αναρτήσεις του στις ροές σου. Δεν ενημερώνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets their posts back into your feeds. They are not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a mostrar sus publicaciones en tus feeds. No se le avisa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päästää heidän julkaisunsa takaisin syötteisiisi. Heille ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet ses posts dans vos fils. Il n’en est pas informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיר את הפוסטים שלו לפידים שלך. הוא לא מקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनकी पोस्ट को आपकी फ़ीड में वापस आने देता है। उन्हें बताया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća njihove objave u tvoje feedove. Nisu obaviješteni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra beengedi a bejegyzéseit a hírfolyamaidba. Nem kap értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan postingannya kembali ke feed-mu. Mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riammette i suoi post nei tuoi feed. Non viene avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿をフィードに再び表示します。相手には知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람의 게시물이 다시 내 피드에 나타나요. 상대방에게는 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരുടെ പോസ്റ്റുകൾ വീണ്ടും നിങ്ങളുടെ ഫീഡുകളിൽ കാണിക്കുന്നു. അവരെ അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan siaran mereka kembali ke suapan anda. Mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipper innleggene deres inn i feedene dine igjen. De får ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat hun berichten weer in je feeds toe. Ze worden niet op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca ich wpisy do Twoich kanałów. Nie są o tym informowani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz de volta os posts da pessoa aos seus feeds. Ela não é avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a permitir as publicações no seu feed. Não são avisados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Readuce postările lui în fluxurile tale. Nu este anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает посты в ваши ленты. Владелец аккаунта не узнает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti jeho príspevky do tvojich kanálov. Nedozvie sa o tom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpper tillbaka deras inlägg i dina flöden. De får inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் இடுகைகளை மீண்டும் உங்கள் ஊட்டங்களில் அனுமதிக்கும். அவர்களுக்குத் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారి పోస్ట్‌లను మీ ఫీడ్‌లలోకి తిరిగి అనుమతిస్తుంది. వారికి చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้โพสต์ของพวกเขากลับเข้าฟีดของคุณ พวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilerini akışlarınıza geri alır. Kendisine haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає їхні дописи у ваші стрічки. Їх не повідомляють."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کی پوسٹس کو آپ کی فیڈز میں واپس آنے دیتا ہے۔ انہیں نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho bài đăng của họ trở lại bảng tin của bạn. Họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让对方的帖子重新出现在你的信息流中。不会通知对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓對方的貼文重新出現在你的動態中，對方不會得知。"
          }
        }
      }
    },
    "safety.mute.effect": {
      "comment": "What muting actually does — and what it leaves alone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف منشوراته وردوده عن الظهور لك. وما زال بإمكانك فتح ملفه وقراءتها هناك، وما زال بإمكانه رؤيتك والرد عليك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাদের পোস্ট ও উত্তর আপনার ফিডে আসা বন্ধ হয়। আপনি এখনও তাদের প্রোফাইল খুলে সেখানে পড়তে পারেন, আর তারা এখনও আপনাকে দেখতে ও উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seves publicacions i respostes deixen d'aparèixer als teus canals. Encara pots obrir el seu perfil i llegir-les allà, i ells encara et poden veure i respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho příspěvky a odpovědi se přestanou zobrazovat ve tvých kanálech. Stále můžeš otevřít jeho profil a číst je tam a on tě stále vidí a může ti odpovídat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedkommendes opslag og svar holder op med at vise sig i dine feeds. Du kan stadig åbne vedkommendes profil og læse dem dér, og vedkommende kan stadig se og svare dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge und Antworten der Person erscheinen nicht mehr in deinen Feeds. Du kannst ihr Profil weiterhin öffnen und sie dort lesen, und sie kann dich weiterhin sehen und dir antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις και οι απαντήσεις του σταματούν να εμφανίζονται στις ροές σου. Μπορείς ακόμα να ανοίξεις το προφίλ του και να τις διαβάσεις εκεί, και εκείνος μπορεί ακόμα να σε βλέπει και να σου απαντά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their posts and replies stop appearing in your feeds. You can still open their profile and read them there, and they can still see and reply to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus publicaciones y respuestas dejan de aparecer en tus feeds. Aún puedes abrir su perfil y leerlas allí, y ellos aún pueden verte y responderte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heidän julkaisunsa ja vastauksensa lakkaavat näkymästä syötteissäsi. Voit yhä avata heidän profiilinsa ja lukea ne siellä, ja he voivat yhä nähdä sinut ja vastata sinulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses posts et réponses n’apparaissent plus dans vos fils. Vous pouvez toujours ouvrir son profil et les y lire, et il peut toujours vous voir et vous répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסטים והתגובות שלו מפסיקים להופיע בפידים שלך. אתה עדיין יכול לפתוח את הפרופיל שלו ולקרוא אותם שם, והוא עדיין יכול לראות אותך ולהגיב לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनकी पोस्ट और जवाब आपकी फ़ीड में दिखना बंद हो जाते हैं। आप फिर भी उनकी प्रोफ़ाइल खोलकर वहाँ पढ़ सकते हैं, और वे अब भी आपको देख सकते हैं और जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove objave i odgovori prestaju se pojavljivati u tvojim feedovima. I dalje možeš otvoriti njihov profil i tamo ih čitati, a oni i dalje mogu vidjeti tebe i odgovarati ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzései és válaszai nem jelennek meg a hírfolyamaidban. A profilját továbbra is megnyithatod és ott elolvashatod őket, ő pedig továbbra is láthat és válaszolhat neked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan dan balasannya berhenti muncul di feed-mu. Kamu masih bisa membuka profilnya dan membacanya di sana, dan mereka masih bisa melihat dan membalasmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi post e le sue risposte smettono di comparire nei tuoi feed. Puoi comunque aprire il suo profilo e leggerli lì, e può ancora vederti e risponderti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿と返信が、あなたのフィードに表示されなくなります。プロフィールを開いてそこで読むことはでき、相手はあなたを見ることも、あなたに返信することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람의 게시물과 답글이 내 피드에 나타나지 않아요. 프로필을 열어 거기서 읽을 수는 있고, 상대방은 여전히 나를 보고 내게 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരുടെ പോസ്റ്റുകളും മറുപടികളും നിങ്ങളുടെ ഫീഡുകളിൽ കാണില്ല. അവരുടെ പ്രൊഫൈൽ തുറന്ന് അവിടെ വായിക്കാം, അവർക്ക് ഇപ്പോഴും നിങ്ങളെ കാണാനും മറുപടി നൽകാനും കഴിയും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran dan balasan mereka berhenti muncul dalam suapan anda. Anda masih boleh membuka profil mereka dan membacanya di sana, dan mereka masih boleh melihat dan membalas anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innleggene og svarene deres slutter å vises i feedene dine. Du kan fortsatt åpne profilen deres og lese dem der, og de kan fortsatt se og svare deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun berichten en reacties verschijnen niet meer in je feeds. Je kunt nog steeds hun profiel openen en ze daar lezen, en zij kunnen jou nog zien en op je reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wpisy i odpowiedzi przestają pojawiać się w Twoich kanałach. Nadal możesz otworzyć ich profil i tam je czytać, a oni nadal mogą Cię widzieć i odpowiadać Ci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts e respostas da pessoa deixam de aparecer nos seus feeds. Você ainda pode abrir o perfil e lê-los lá, e ela ainda pode ver e responder a você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações e respostas desta conta deixam de aparecer nos seus feeds. Pode continuar a abrir o perfil e a lê-las aí, e a conta continua a poder ver e responder-lhe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările și răspunsurile lui nu mai apar în fluxurile tale. Îi poți deschide în continuare profilul și le poți citi acolo, iar el te poate vedea și îți poate răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты и ответы этого аккаунта перестают появляться в ваших лентах. Вы по-прежнему можете открыть его профиль и прочитать их там, а он(а) по-прежнему видит вас и может отвечать вам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho príspevky a odpovede sa prestanú zobrazovať v tvojich kanáloch. Jeho profil môžeš stále otvoriť a čítať ich tam a on ťa stále vidí a môže ti odpovedať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras inlägg och svar slutar visas i dina flöden. Du kan fortfarande öppna deras profil och läsa dem där, och de kan fortfarande se och svara dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் இடுகைகளும் பதில்களும் உங்கள் ஊட்டங்களில் தோன்றாது. நீங்கள் இன்னும் அவர்களின் சுயவிவரத்தைத் திறந்து அங்கே படிக்கலாம், அவர்களும் உங்களைப் பார்த்துப் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారి పోస్ట్‌లు, రిప్లైలు మీ ఫీడ్‌లలో కనిపించడం ఆగిపోతాయి. మీరు ఇంకా వారి ప్రొఫైల్‌ను తెరిచి అక్కడ చదవవచ్చు, వారు ఇంకా మిమ్మల్ని చూడవచ్చు, మీకు రిప్లై ఇవ్వవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์และคำตอบของพวกเขาจะไม่ปรากฏในฟีดของคุณ คุณยังเปิดโปรไฟล์และอ่านที่นั่นได้ และพวกเขายังเห็นและตอบกลับคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileri ve yanıtları akışlarınızda görünmez. Profilini yine açıp orada okuyabilirsiniz; onlar da sizi görebilir ve size yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їхні дописи й відповіді перестають з’являтися у ваших стрічках. Ви все ще можете відкрити їхній профіль і читати їх там, а вони й далі можуть бачити вас і відповідати вам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کی پوسٹس اور جوابات آپ کی فیڈز میں آنا بند ہو جاتے ہیں۔ آپ پھر بھی ان کا پروفائل کھول کر وہاں پڑھ سکتے ہیں، اور وہ اب بھی آپ کو دیکھ اور جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng và trả lời của họ không còn xuất hiện trong bảng tin của bạn. Bạn vẫn mở được hồ sơ của họ và đọc ở đó, và họ vẫn thấy và trả lời được bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的帖子和回复不会再出现在你的信息流中。你仍可打开其个人主页并在那里阅读，对方也仍能看到你并回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的貼文和回覆不會再出現在你的動態中。你仍可開啟其個人檔案並在那裡閱讀，對方仍可看到並回覆你。"
          }
        }
      }
    },
    "safety.mute.isSilent": {
      "comment": "The line that has to sit next to every mute control.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتم صامت. لا يُبلَّغ الطرف الآخر أبدًا، ولا يتغير عنده شيء، وتبقيان متابعين لبعضكما إن كنتما كذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিউট নীরবে হয়। অন্য ব্যক্তিকে কখনও জানানো হয় না, তার জন্য কিছুই বদলায় না, এবং আপনারা পরস্পরকে ফলো করলে তা-ই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar és silenciós. L'altra persona mai no ho sap, per a ella no canvia res, i continueu seguint-vos si ja ho feieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztlumení je tiché. Druhá osoba se to nikdy nedozví, pro ni se nic nemění a pokud jste se sledovali, sledujete se dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydløs sker i stilhed. Den anden person får aldrig besked, intet ændrer sig for dem, og I bliver ved med at følge hinanden, hvis I gjorde det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stummschalten geschieht lautlos. Die andere Person wird nie benachrichtigt, für sie ändert sich nichts, und ihr folgt euch weiterhin, falls ihr das getan habt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σίγαση είναι αθόρυβη. Το άλλο άτομο δεν ενημερώνεται ποτέ, τίποτα δεν αλλάζει για αυτό και συνεχίζετε να ακολουθείτε ο ένας τον άλλον αν το κάνατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muting is silent. The other person is never told, nothing changes for them, and you stay following each other if you did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar es silencioso. Nunca se avisa a la otra persona, nada cambia para ella y, si os seguíais, seguís haciéndolo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mykistäminen on äänetöntä. Toiselle ei kerrota, hänelle ei muutu mikään, ja jos seurasitte toisianne, seuraatte yhä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en sourdine est silencieuse. L’autre personne n’en est jamais informée, rien ne change pour elle, et vous restez abonnés l’un à l’autre si vous l’étiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתקה היא שקטה. האדם השני אף פעם לא מקבל הודעה, שום דבר לא משתנה אצלו, ואתם נשארים עוקבים זה אחרי זה אם הייתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "म्यूट करना चुपचाप होता है। दूसरे व्यक्ति को कभी नहीं बताया जाता, उनके लिए कुछ नहीं बदलता, और अगर आप एक-दूसरे को फ़ॉलो करते थे तो करते रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišavanje je tiho. Druga osoba nikada nije obaviještena, za nju se ništa ne mijenja, a ako ste se pratili, i dalje se pratite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A némítás csendes. A másik személy nem kap értesítést, számára semmi nem változik, és ha követtétek egymást, ez így is marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membisukan berjalan diam-diam. Orang itu tidak pernah diberi tahu, tidak ada yang berubah bagi mereka, dan kalian tetap saling mengikuti jika sebelumnya begitu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenziare è un'azione silenziosa. L'altra persona non viene mai avvisata, per lei non cambia nulla e, se vi seguivate, continuate a seguirvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュートは通知されません。相手には知らされず、相手側は何も変わらず、お互いにフォローしていた場合はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뮤트는 조용히 처리돼요. 상대방에게는 알려지지 않고 아무것도 달라지지 않으며, 서로 팔로우하고 있었다면 그대로 유지돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മ്യൂട്ട് ചെയ്യൽ നിശ്ശബ്ദമാണ്. മറ്റേയാളെ ഒരിക്കലും അറിയിക്കില്ല, അവർക്ക് ഒന്നും മാറില്ല, ഫോളോ ചെയ്തിരുന്നെങ്കിൽ അതു തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyenyapkan dilakukan secara senyap. Orang itu tidak pernah diberitahu, tiada apa berubah untuk mereka, dan anda kekal saling mengikut jika begitu sebelumnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Demping skjer i det stille. Den andre får aldri vite det, ingenting endres for dem, og dere fortsetter å følge hverandre hvis dere gjorde det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempen gebeurt stil. De ander krijgt geen bericht, er verandert niets voor hen, en jullie blijven elkaar volgen als dat al zo was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciszenie jest ciche. Druga osoba nigdy nie jest informowana, nic się dla niej nie zmienia, a jeśli się obserwowaliście, nadal się obserwujecie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar é silencioso. A outra pessoa nunca é avisada, nada muda para ela, e vocês continuam se seguindo, se já se seguiam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar é silencioso. A outra pessoa nunca é avisada, nada muda para ela, e continuam a seguir-se mutuamente, se já seguiam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivarea este discretă. Cealaltă persoană nu este anunțată, nimic nu se schimbă pentru ea și vă urmăriți în continuare dacă o făceați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглушение происходит тихо. Другой человек не узнает, для него ничего не меняется, а если вы были подписаны друг на друга, подписки сохраняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlmenie je tiché. Druhá osoba sa o ňom nedozvie, pre ňu sa nič nemení a ak ste sa sledovali, sledujete sa ďalej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att tysta sker i tysthet. Den andra personen får aldrig veta det, inget ändras för dem, och ni följer varandra kvar om ni gjorde det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியடக்குவது அமைதியானது. மற்றவருக்கு ஒருபோதும் தெரிவிக்கப்படாது, அவர்களுக்கு எதுவும் மாறாது, நீங்கள் பின்தொடர்ந்திருந்தால் ஒருவரையொருவர் தொடர்ந்து பின்தொடர்வீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మ్యూట్ చేయడం నిశ్శబ్దంగా జరుగుతుంది. అవతలి వ్యక్తికి ఎప్పుడూ చెప్పబడదు, వారికి ఏదీ మారదు, మీరు ఫాలో అవుతుంటే అలాగే ఫాలో అవుతూనే ఉంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเสียงเป็นไปอย่างเงียบๆ อีกฝ่ายไม่ได้รับแจ้ง ไม่มีอะไรเปลี่ยนสำหรับพวกเขา และหากติดตามกันอยู่ก็ยังติดตามกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessize alma sessizdir. Karşı tarafa asla haber verilmez, onlar için hiçbir şey değişmez ve takip ediyorsanız birbirinizi takip etmeye devam edersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглушення тихе. Іншу людину ніколи не повідомляють, для неї нічого не змінюється, а ви лишаєтеся підписаними одне на одного, якщо були."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میوٹ کرنا خاموش ہے۔ دوسرے شخص کو کبھی نہیں بتایا جاتا، ان کے لیے کچھ نہیں بدلتا، اور اگر آپ ایک دوسرے کو فالو کرتے تھے تو کرتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn là âm thầm. Người kia không bao giờ được thông báo, không có gì thay đổi với họ, và nếu hai bạn đang theo dõi nhau thì vẫn vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音是静默的。对方不会知道，对他们没有任何影响，如果你们互相关注，仍会保持关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音是無聲的。對方絕不會得知，對他們沒有任何改變，如果你們原本互相追蹤，也仍維持追蹤。"
          }
        }
      }
    },
    "safety.mute.toast": {
      "comment": "Toast after a mute. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتم %@. لن تظهر لك منشوراته. ولم يُبلَّغ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে মিউট করা হয়েছে। তাদের পোস্ট আপনার ফিডে আসবে না। তাদের জানানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has silenciat %@. Les seves publicacions no apareixeran als teus canals. No ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ je ztlumen. Jeho příspěvky se ve tvých kanálech nezobrazí. Nedozví se to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjorde %@ lydløs. Vedkommendes opslag vises ikke i dine feeds. Vedkommende får ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stummgeschaltet. Die Beiträge erscheinen nicht in deinen Feeds. Die Person wird nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε σίγαση ο/η %@. Οι αναρτήσεις του/της δεν θα εμφανίζονται στις ροές σου. Δεν ενημερώνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted %@. Their posts won't appear in your feeds. They are not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciaste a %@. Sus publicaciones no aparecerán en tus feeds. No se le avisó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mykistit käyttäjän %@. Hänen julkaisunsa eivät näy syötteissäsi. Hänelle ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en sourdine. Ses posts n’apparaîtront plus dans vos fils. Il n’en est pas informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הושתק. הפוסטים שלו לא יופיעו בפידים שלך. הוא לא מקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को म्यूट किया। उनकी पोस्ट आपकी फ़ीड में नहीं दिखेंगी। उन्हें बताया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišano: %@. Njihove objave neće se pojavljivati u tvojim feedovima. Nisu obaviješteni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ némítva. A bejegyzései nem jelennek meg a hírfolyamaidban. Nem kapott értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dibisukan. Postingannya tidak akan muncul di feed-mu. Mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silenziato. I suoi post non compariranno nei tuoi feed. Non viene avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をミュートしました。投稿はフィードに表示されません。相手には知らされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님을 뮤트했어요. 게시물이 내 피드에 나타나지 않아요. 상대방에게는 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ മ്യൂട്ട് ചെയ്തു. അവരുടെ പോസ്റ്റുകൾ നിങ്ങളുടെ ഫീഡുകളിൽ വരില്ല. അവരെ അറിയിച്ചിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disenyapkan. Siaran mereka tidak akan muncul dalam suapan anda. Mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempet %@. Innleggene deres vises ikke i feedene dine. De får ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gedempt. Hun berichten verschijnen niet in je feeds. Ze zijn hier niet van op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciszono: %@. Jego wpisy nie będą pojawiać się w Twoich kanałach. Nie jest o tym informowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silenciado. Os posts dessa pessoa não aparecerão nos seus feeds. Ela não foi avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silenciado. As publicações não aparecerão nos seus feeds. A conta não foi avisada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ai dezactivat pe %@. Postările lui nu vor apărea în fluxurile tale. Nu este anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заглушён(а). Посты не будут появляться в ваших лентах. Владелец аккаунта не уведомлён."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je stlmený. Jeho príspevky sa nebudú zobrazovať v tvojich kanáloch. Nedozvie sa o tom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tystade %@. Deras inlägg visas inte i dina flöden. De fick inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஒலியடக்கப்பட்டார். அவர்களின் இடுகைகள் உங்கள் ஊட்டங்களில் தோன்றாது. அவர்களுக்குத் தெரிவிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ను మ్యూట్ చేశారు. వారి పోస్ట్‌లు మీ ఫీడ్‌లలో కనిపించవు. వారికి చెప్పబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเสียง %@ แล้ว โพสต์ของพวกเขาจะไม่ปรากฏในฟีดของคุณ พวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sessize alındı. Gönderileri akışlarınızda görünmeyecek. Kendisine haber verilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заглушено. Їхні дописи не з’являтимуться у ваших стрічках. Їх не повідомляють."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو میوٹ کیا۔ ان کی پوسٹس آپ کی فیڈز میں نظر نہیں آئیں گی۔ انہیں نہیں بتایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ẩn %@. Bài đăng của họ sẽ không xuất hiện trong bảng tin của bạn. Họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已静音 %@。对方的帖子不会出现在你的信息流中，对方并不知情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將 %@ 靜音。對方的貼文不會出現在你的動態中，對方不會得知。"
          }
        }
      }
    },
    "safety.reason.harassment.detail": {
      "comment": "What the harassment reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إساءة موجّهة أو تهديدات أو تكتّل جماعي ضد شخص بعينه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কারও প্রতি লক্ষ্যভেদী গালিগালাজ, হুমকি বা দলবদ্ধ আক্রমণ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Abusos dirigits, amenaces o una allau de crítiques contra algú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cílené urážky, výhrůžky nebo hromadný útok na někoho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målrettet krænkelse, trusler eller en pøbelhær rettet mod nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezielte Beschimpfungen, Drohungen oder eine Hetzjagd gegen jemanden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στοχευμένη κακοποίηση, απειλές ή μαζική επίθεση εναντίον κάποιου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targeted abuse, threats or a pile-on aimed at someone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abusos dirigidos, amenazas o una avalancha de ataques contra alguien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdennettu haukkuminen, uhkailu tai ryöpytys jotakuta kohtaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insultes ciblées, menaces ou acharnement collectif visant quelqu’un."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התעללות ממוקדת, איומים או התנפלות המונית על מישהו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी को निशाना बनाकर गाली-गलौज, धमकियाँ या भीड़ का हमला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciljano zlostavljanje, prijetnje ili hajka usmjerena na nekoga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Célzott bántalmazás, fenyegetés vagy valaki ellen irányuló tömeges támadás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinaan yang menyasar, ancaman, atau keroyokan yang ditujukan pada seseorang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abusi mirati, minacce o un attacco di massa contro qualcuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の人への攻撃、脅し、集団での攻撃。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가를 겨냥한 욕설, 협박 또는 집단 공격."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരാളെ ലക്ഷ്യമിട്ടുള്ള അധിക്ഷേപം, ഭീഷണി, അല്ലെങ്കിൽ കൂട്ടമായ ആക്രമണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penderaan bersasar, ancaman atau serangan beramai-ramai ke atas seseorang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettet krenkelse, trusler eller en samlet hetsekampanje mot noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerichte beledigingen, bedreigingen of een groepsaanval op iemand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukierunkowane znęcanie się, groźby lub zmasowany atak na kogoś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abuso direcionado, ameaças ou um ataque em massa contra alguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abuso dirigido, ameaças ou uma investida coletiva contra alguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abuz țintit, amenințări sau atacuri în grup îndreptate împotriva cuiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целенаправленные оскорбления, угрозы или травля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cielené urážky, vyhrážky alebo hromadný útok na niekoho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Riktade övergrepp, hot eller en hetsjakt mot någon."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருவரை இலக்கு வைத்த வசைபாடல், மிரட்டல்கள் அல்லது கூட்டமாகத் தாக்குதல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకరిని లక్ష్యంగా చేసుకున్న దూషణ, బెదిరింపులు లేదా గుంపుగా దాడి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล่วงละเมิดที่พุ่งเป้า การขู่ หรือการรุมใส่ใครคนหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birine yönelik hedefli taciz, tehdit veya toplu saldırı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілеспрямовані образи, погрози або цькування, спрямовані на когось."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہدفی بدسلوکی، دھمکیاں یا کسی پر ٹوٹ پڑنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lạm dụng có chủ đích, đe dọa hoặc cả đám xúm vào nhắm vào ai đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对某人的辱骂、威胁或围攻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "針對性的辱罵、威脅，或對某人的群起圍攻。"
          }
        }
      }
    },
