    "preferences.discard.hint": {
      "comment": "VoiceOver hint for the discard button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاهل تغييراتك غير المحفوظة ويستعيد إعداداتك المخزّنة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throws away your unsaved changes and restores your stored settings"
          }
        }
      }
    },
    "preferences.disclosure.body": {
      "comment": "The plain-language statement of what the tagging is: automatic, sometimes wrong, never shown on the post, and used only for these settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُصنَّف كل منشور تلقائيًا حسب الموضوع بواسطة برنامج يعمل على خوادم سِلة، وهذا البرنامج يخطئ أحيانًا. ولا تظهر هذه التصنيفات على المنشور نفسه أبدًا — وهذه الإعدادات هي الاستخدام الوحيد لها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every post is automatically labelled by topic by software running on Sila's servers, and that software is sometimes wrong. The labels are never shown on the post itself — these settings are the only thing they are used for."
          }
        }
      }
    },
    "preferences.disclosure.title": {
      "comment": "Header above the explanation of how topics are assigned.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف تُحدَّد المواضيع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How topics are decided"
          }
        }
      }
    },
    "preferences.done.hint": {
      "comment": "VoiceOver hint for the sheet's Done button.",
