        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone can listen"
          }
        }
      }
    },
    "rooms.create.explanation": {
      "comment": "What creating a room means. Listening is open to everyone; the audience governs the microphone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لكل من في سِلة الاستماع إلى غرفتك. والجمهور الذي تختاره يحدد من يمكنه أخذ المايك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone on Sila can listen to your room. The audience you pick decides who may take the microphone."
          }
        }
      }
    },
    "rooms.create.scheduleButton": {
      "comment": "Button that schedules the room for later.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جدول الغرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule room"
          }
        }
      }
    },
    "rooms.create.scheduleButton.a11yHint": {
      "comment": "VoiceOver hint for the schedule-room button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع الغرفة في القائمة مع وقت بدء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the room on the list with a start time"
          }
        }
      }
    },
    "rooms.create.scheduleExplanation": {
      "comment": "What scheduling does, and what it does not — nobody can speak until the host opens it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك هذا موقفًا لفتح الغرفة الآن. وجدولتها تضعها في القائمة مع وقت بدء، ولا يمكن لأحد التحدث فيها حتى تفتحها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this off to open the room now. Scheduling it puts it on the list with a start time; nobody can speak in it until you open it."
          }
        }
      }
    },
    "rooms.create.scheduleToggle": {
      "comment": "Switch that turns a room into a scheduled one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
