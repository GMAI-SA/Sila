    "people.picker.choose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من الأشخاص الذين تعرفهم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চেনা মানুষদের মধ্য থেকে বেছে নিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria entre persones que coneixes"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrat z lidí, které znáš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg blandt folk, du kender"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Personen wählen, die du kennst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλογή από άτομα που γνωρίζεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from people you know"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir entre personas que conoces"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tuntemistasi ihmisistä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir parmi les personnes que vous connaissez"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר מבין אנשים שאתה מכיר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने जानने वालों में से चुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi među ljudima koje znaš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz az ismerőseid közül"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dari orang yang kamu kenal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra le persone che conosci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っている人から選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 사람 중에서 선택"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കറിയാവുന്നവരിൽ നിന്ന് തിരഞ്ഞെടുക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih daripada orang yang anda kenal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg blant folk du kjenner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies uit mensen die je kent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz spośród znajomych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher entre pessoas que você conhece"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher entre pessoas que conhece"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege dintre oamenii pe care îi cunoști"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать из знакомых"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrať z ľudí, ktorých poznáš"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bland personer du känner"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தெரிந்தவர்களிலிருந்து தேர்ந்தெடுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు తెలిసిన వ్యక్తుల నుండి ఎంచుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากคนที่คุณรู้จัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıdığınız kişilerden seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрати зі знайомих"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے جاننے والوں میں سے چنیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ những người bạn biết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你认识的人中选择"
          }
        },
        "zh-Hant": {
