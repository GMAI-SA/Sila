    "vouch.ended.next.again": {
      "comment": "What is left after a vouch ended, when another voucher may vouch today.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يزكّيك شخص آخر تعرفه، أو أن توثّق هويتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচিত অন্য কেউ আপনার জন্য ভাউচ করতে পারেন, অথবা আপনি পরিচয় ভেরিফাই করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una altra persona que coneixes et pot avalar, o pots verificar la teva identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za tebe může ručit někdo jiný, koho znáš, nebo můžeš ověřit svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden, du kender, kan gå i god for dig, eller du kan verificere din identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes, den du kennst, kann für dich bürgen, oder du verifizierst deine Identität."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος άλλος που γνωρίζεις μπορεί να εγγυηθεί για εσένα ή μπορείς να επαληθεύσεις την ταυτότητά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else you know can vouch for you, or verify your identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona que conozcas puede avalarte, o puedes verificar tu identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku toinen tuntemasi voi taata sinut, tai voit vahvistaa henkilöllisyytesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre personne que vous connaissez peut se porter garante de vous, ou vous pouvez vérifier votre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו אחר שאתה מכיר יכול לערוב לך, או שתוכל לאמת את זהותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई और जिसे आप जानते हैं आपके लिए वाउच कर सकता है, या आप अपनी पहचान सत्यापित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko drugi koga poznaješ može jamčiti za tebe, ili potvrdi svoj identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki más, akit ismersz, kezeskedhet érted, vagy hitelesítheted a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang lain yang kamu kenal bisa menjaminmu, atau verifikasi identitasmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra persona che conosci può garantire per te, oppure puoi verificare la tua identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知り合いの別の人に保証してもらうか、本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 다른 사람이 보증해 주거나, 직접 신원을 인증할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് അറിയാവുന്ന മറ്റൊരാൾക്ക് നിങ്ങൾക്കായി വൗച്ച് ചെയ്യാം, അല്ലെങ്കിൽ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang lain yang anda kenal boleh menjamin anda, atau sahkan identiti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen andre du kjenner kan garantere for deg, eller du kan verifisere identiteten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand anders die je kent kan voor je instaan, of je kunt je identiteit verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś inny, kogo znasz, może za Ciebie poręczyć albo możesz zweryfikować tożsamość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa que você conhece pode avalizar você, ou você pode verificar sua identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa que conheça pode dar-lhe aval, ou pode verificar a sua identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Altcineva pe care îl cunoști poate garanta pentru tine, sau poți să-ți verifici identitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За вас может поручиться кто-то другой из ваших знакомых — или вы можете пройти проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môže za teba ručiť niekto iný, koho poznáš, alebo si over svoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon annan du känner kan intyga för dig, eller så kan du verifiera din identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குத் தெரிந்த வேறொருவர் உங்களுக்காக உறுதியளிக்கலாம், அல்லது உங்கள் அடையாளத்தைச் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు తెలిసిన మరొకరు మీకు హామీ ఇవ్వవచ్చు, లేదా మీ గుర్తింపును ధృవీకరించుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนอื่นที่คุณรู้จักสามารถรับรองคุณได้ หรือคุณจะยืนยันตัวตนก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıdığınız başka biri size kefil olabilir veya kimliğinizi doğrulayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За вас може поручитися хтось інший, кого ви знаєте, або ви можете верифікувати особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا جاننے والا کوئی اور آپ کی ضمانت دے سکتا ہے، یا آپ اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người khác bạn quen có thể bảo chứng cho bạn, hoặc hãy xác minh danh tính của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你认识的其他人可以为你担保，或者你可以验证自己的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你認識的其他人可以為你擔保，或你也可以驗證自己的身分。"
          }
        }
      }
    },
    "vouch.ended.next.verify": {
      "comment": "What is left after a vouch ended, when no new vouch is possible now.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق هويتك للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যেতে আপনার পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la teva identitat per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování ověř svou totožnost."
          }
        },
        "da": {
