    "account.profile.verifiedName.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من التحقق من هويتك. لا يمكن تغييره، لكن يمكنك إخفاءه عن ملفك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয় যাচাই থেকে নেওয়া। এটি বদলানো যায় না, তবে প্রোফাইলে লুকিয়ে রাখতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prové de la teva comprovació d'identitat. No es pot canviar, però pots mantenir-lo fora del teu perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z ověření totožnosti. Nelze ho změnit, ale můžeš ho na profilu skrýt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra dit identitetstjek. Det kan ikke ændres, men du kan holde det væk fra din profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deiner Identitätsprüfung. Er lässt sich nicht ändern, aber du kannst ihn in deinem Profil ausblenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προέρχεται από τον έλεγχο ταυτότητάς σου. Δεν μπορεί να αλλάξει, αλλά μπορείς να το κρατήσεις μακριά από το προφίλ σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your identity check. It can't be changed, but you can keep it off your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procede de tu verificación de identidad. No se puede cambiar, pero puedes ocultarlo en tu perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyystarkistuksestasi. Sitä ei voi muuttaa, mutta voit pitää sen poissa profiilistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Issu de votre vérification d’identité. Il ne peut pas être modifié, mais vous pouvez ne pas l’afficher sur votre profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבדיקת הזהות שלך. אי אפשר לשנות אותו, אבל אפשר להשאיר אותו מחוץ לפרופיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी पहचान जाँच से है। इसे बदला नहीं जा सकता, पर आप इसे अपनी प्रोफ़ाइल से दूर रख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz tvoje provjere identiteta. Ne može se promijeniti, ali ga možeš zadržati izvan profila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A személyazonosság-ellenőrzésedből. Nem módosítható, de elrejtheted a profilodról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari pemeriksaan identitasmu. Tidak bisa diubah, tetapi kamu bisa tidak menampilkannya di profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deriva dalla tua verifica d'identità. Non si può cambiare, ma puoi tenerlo fuori dal tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認で登録された名前です。変更はできませんが、プロフィールに表示しないようにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원 확인에서 가져온 이름이에요. 변경할 수 없지만 프로필에서 숨길 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തിരിച്ചറിയൽ പരിശോധനയിൽ നിന്ന്. ഇത് മാറ്റാനാവില്ല, പക്ഷേ പ്രൊഫൈലിൽ നിന്ന് ഒഴിവാക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada semakan identiti anda. Ia tidak boleh diubah, tetapi anda boleh menyembunyikannya daripada profil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra identitetskontrollen din. Det kan ikke endres, men du kan holde det borte fra profilen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkomstig van je identiteitscontrole. Kan niet worden gewijzigd, maar je kunt hem van je profiel houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z weryfikacji tożsamości. Nie można go zmienić, ale możesz nie pokazywać go na profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem da sua verificação de identidade. Não pode ser alterado, mas você pode mantê-lo fora do perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem da sua verificação de identidade. Não pode ser alterado, mas pode mantê-lo fora do seu perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din verificarea identității. Nu poate fi schimbat, dar îl poți ține ascuns în profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взято из проверки личности. Его нельзя изменить, но можно не показывать в профиле."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tvojho overenia totožnosti. Nedá sa zmeniť, ale môžeš ho nechať mimo profilu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från din identitetskontroll. Det kan inte ändras, men du kan hålla det borta från din profil."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடையாளச் சரிபார்ப்பிலிருந்து வந்தது. இதை மாற்ற முடியாது, ஆனால் சுயவிவரத்தில் காட்டாமல் வைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపు తనిఖీ నుండి వచ్చింది. దీన్ని మార్చలేరు, కానీ మీ ప్రొఫైల్‌లో కనిపించకుండా ఉంచవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาจากการตรวจสอบตัวตนของคุณ เปลี่ยนไม่ได้ แต่คุณซ่อนไม่ให้แสดงในโปรไฟล์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik kontrolünüzden gelir. Değiştirilemez, ancak profilinizde gizleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З вашої перевірки особи. Його не можна змінити, але можна не показувати у профілі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی شناخت کی جانچ سے۔ اسے بدلا نہیں جا سکتا، لیکن آپ اسے اپنے پروفائل سے ہٹا کر رکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy từ bước kiểm tra danh tính. Không thể thay đổi, nhưng bạn có thể không hiển thị nó trên hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你的身份核验。无法更改，但你可以不在个人主页上显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自你的身分檢查。無法更改，但你可以不在個人檔案上顯示。"
          }
        }
      }
    },
