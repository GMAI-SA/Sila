    "events.create.placeHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم وعنوان فقط — لا دبوس خريطة أبدًا. مكان وجود شخص معروف أمر يخصّه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু একটি নাম ও ঠিকানা — কখনও ম্যাপ পিন নয়। কোনো নির্দিষ্ট মানুষ কোথায় থাকবেন তা জানানো তাঁর নিজের ব্যাপার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només un nom i una adreça, mai una ubicació al mapa. On serà una persona concreta ho decideix ella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen název a adresa – nikdy špendlík na mapě. Kde bude konkrétní člověk, je na něm, zda to sdílí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et navn og en adresse – aldrig en kortnål. Hvor en navngiven person befinder sig, er op til vedkommende at dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Name und Adresse – nie eine Kartenmarkierung. Wo sich eine bestimmte Person aufhält, entscheidet sie selbst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο όνομα και διεύθυνση — ποτέ καρφίτσα χάρτη. Το πού βρίσκεται ένα άτομο το μοιράζεται μόνο το ίδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name and an address only — never a map pin. Where a named person will be is theirs to share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un nombre y una dirección, nunca un punto en el mapa. Dónde estará una persona es algo que le corresponde compartir a ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain nimi ja osoite – ei koskaan karttamerkkiä. Missä nimetty henkilö on, on hänen jaettavissaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom et une adresse seulement — jamais une épingle sur la carte. Où se trouve une personne nommée, c’est à elle de le partager."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם וכתובת בלבד — אף פעם לא סיכת מפה. המיקום של אדם מסוים הוא שלו לשתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ नाम और पता — कभी मैप पिन नहीं। कोई नामित व्यक्ति कहाँ होगा, यह बताना उसका अपना अधिकार है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo naziv i adresa — nikada oznaka na karti. Gdje će imenovana osoba biti, ona sama odlučuje podijeliti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak név és cím – soha nem térképi jelölő. Hogy egy személy hol lesz, az az ő dolga megosztani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama dan alamat — tidak pernah titik peta. Keberadaan seseorang yang disebut namanya adalah hak mereka untuk dibagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un nome e un indirizzo, mai un segnaposto sulla mappa. Dove si troverà una persona è una cosa che spetta a lei condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と住所だけです。地図のピンは使いません。特定の人がどこにいるかは、その人が共有するものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 주소만 입력하세요. 지도 핀은 사용하지 않아요. 특정 사람의 위치는 그 사람이 직접 공유할 몫이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേരും വിലാസവും മാത്രം — ഒരിക്കലും മാപ്പ് പിൻ അല്ല. പേരുള്ള ഒരാൾ എവിടെയായിരിക്കുമെന്ന് പങ്കിടുന്നത് അവരുടെ തീരുമാനമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan alamat sahaja — tidak pernah pin peta. Di mana seseorang akan berada terpulang kepadanya untuk dikongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et navn og en adresse, aldri en kartnål. Hvor en navngitt person er, er opp til vedkommende å dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een naam en een adres, nooit een kaartpin. Waar iemand met naam zal zijn, deelt die persoon zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko nazwa i adres — nigdy pinezka na mapie. Gdzie przebywa dana osoba, to jej sprawa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas um nome e um endereço, nunca um ponto no mapa. Onde uma pessoa estará é ela quem decide compartilhar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas um nome e uma morada — nunca um ponto no mapa. Onde uma pessoa estará é ela que decide partilhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un nume și o adresă — niciodată un pin pe hartă. Unde se află o persoană anume rămâne la alegerea ei să împărtășească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только название и адрес — никогда не точка на карте. Где будет конкретный человек, решает он сам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba názov a adresa — nikdy špendlík na mape. Kde bude konkrétna osoba, je na nej, či to zdieľa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ett namn och en adress – aldrig en kartnål. Var en namngiven person befinner sig är upp till dem att dela."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெயரும் முகவரியும் மட்டுமே — வரைபடக் குறி ஒருபோதும் இல்லை. குறிப்பிட்ட நபர் எங்கு இருப்பார் என்பதைப் பகிர்வது அவருடைய உரிமை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేరు, చిరునామా మాత్రమే — మ్యాప్ పిన్ ఎప్పుడూ ఉండదు. పేరున్న వ్యక్తి ఎక్కడ ఉంటారో పంచుకోవడం వారి ఇష్టం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่แค่ชื่อและที่อยู่ ไม่มีหมุดแผนที่ ตำแหน่งที่คนมีชื่อจะอยู่เป็นสิ่งที่เจ้าตัวเลือกแชร์เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir ad ve adres; asla harita konumu. Adı geçen bir kişinin nerede olacağını paylaşmak onun kararıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише назва й адреса — ніколи позначка на мапі. Де буде конкретна людина — вирішує вона сама."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف نام اور پتا — نقشے کا پن کبھی نہیں۔ کوئی نامزد شخص کہاں ہوگا یہ بتانا اسی کا اختیار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tên và địa chỉ — không bao giờ có ghim bản đồ. Việc một người cụ thể ở đâu là do họ tự chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需名称和地址，绝不使用地图定位。具体某个人在哪里，由其本人自行决定是否分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有名稱和地址，絕不會有地圖標記。具名者在哪裡，由他們自己決定是否分享。"
          }
        }
      }
    },
