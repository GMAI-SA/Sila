          }
        }
      }
    },
    "error.nafathUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفاذ قادم قريبًا. تحقّق الآن بجواز سفر أو بطاقة هوية — يستغرق ذلك دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath শিগগিরই আসছে। আপাতত পাসপোর্ট বা আইডি কার্ড দিয়ে ভেরিফাই করুন — কয়েক মিনিট লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath arribarà aviat. De moment, verifica't amb un passaport o un document d'identitat: triga uns minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath brzy přijde. Zatím se ověř pasem nebo občanským průkazem – trvá to pár minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath kommer snart. Verificér indtil videre med et pas eller id-kort – det tager et par minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath kommt bald. Verifiziere dich vorerst mit Reisepass oder Ausweis – das dauert ein paar Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Nafath έρχεται σύντομα. Προς το παρόν, επαληθεύσου με διαβατήριο ή ταυτότητα — παίρνει λίγα λεπτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath is coming soon. For now, verify with a passport or ID card — it takes a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath llegará pronto. Por ahora, verifícate con un pasaporte o un documento de identidad: lleva unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath tulee pian. Vahvista toistaiseksi passilla tai henkilökortilla – se vie muutaman minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath arrive bientôt. Pour l’instant, vérifiez-vous avec un passeport ou une carte d’identité — cela prend quelques minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath יגיע בקרוב. לעת עתה, אמת עם דרכון או תעודת זהות — זה לוקח כמה דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath जल्द आ रहा है। फ़िलहाल पासपोर्ट या ID कार्ड से सत्यापित करें — इसमें कुछ मिनट लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath uskoro stiže. Za sada potvrdi putovnicom ili osobnom iskaznicom — traje nekoliko minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nafath hamarosan érkezik. Addig hitelesíts útlevéllel vagy személyi igazolvánnyal – néhány perc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath segera hadir. Untuk sekarang, verifikasi dengan paspor atau kartu identitas — hanya beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath arriverà presto. Per ora verificati con un passaporto o una carta d'identità: ci vogliono pochi minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafathは近日対応予定です。今のところは、パスポートまたはIDカードで認証してください。数分で完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath는 곧 제공돼요. 지금은 여권이나 신분증으로 인증하세요. 몇 분이면 돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ഉടൻ വരുന്നു. ഇപ്പോൾ പാസ്‌പോർട്ടോ ഐഡി കാർഡോ ഉപയോഗിച്ച് പരിശോധിക്കുക — ഏതാനും മിനിറ്റ് മതി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath akan hadir tidak lama lagi. Buat masa ini, sahkan dengan pasport atau kad pengenalan — ia mengambil masa beberapa minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath kommer snart. Foreløpig kan du verifisere deg med pass eller ID-kort. Det tar noen minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath komt binnenkort. Verifieer voorlopig met een paspoort of identiteitskaart. Het duurt een paar minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath pojawi się wkrótce. Na razie zweryfikuj się paszportem lub dowodem osobistym — zajmie to kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath chega em breve. Por enquanto, verifique-se com passaporte ou documento de identidade: leva poucos minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath estará disponível em breve. Por agora, verifique-se com um passaporte ou cartão de cidadão — demora alguns minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath vine în curând. Deocamdată, verifică-te cu un pașaport sau o carte de identitate — durează câteva minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath скоро появится. Пока подтвердите личность по паспорту или ID-карте — это займёт несколько минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath už čoskoro. Zatiaľ sa over pasom alebo občianskym preukazom — trvá to pár minút."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath kommer snart. Verifiera dig tills vidare med pass eller id-kort – det tar några minuter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath விரைவில் வருகிறது. இப்போதைக்கு பாஸ்போர்ட் அல்லது அடையாள அட்டை மூலம் சரிபாருங்கள் — சில நிமிடங்கள் ஆகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath త్వరలో వస్తుంది. ప్రస్తుతానికి పాస్‌పోర్ట్ లేదా ID కార్డ్‌తో ధృవీకరించండి — కొన్ని నిమిషాలు పడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath จะมาเร็วๆ นี้ ตอนนี้ให้ยืนยันด้วยหนังสือเดินทางหรือบัตรประจำตัว ใช้เวลาไม่กี่นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath yakında geliyor. Şimdilik pasaport veya kimlik kartıyla doğrulayın; birkaç dakika sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath незабаром буде доступний. Поки що верифікуйтеся за паспортом або ID-карткою — це займе кілька хвилин."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath جلد آ رہا ہے۔ فی الحال پاسپورٹ یا شناختی کارڈ سے تصدیق کریں — اس میں چند منٹ لگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath sắp ra mắt. Hiện tại, hãy xác minh bằng hộ chiếu hoặc thẻ căn cước — chỉ mất vài phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 即将推出。目前请用护照或身份证验证，只需几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 即將推出。目前請使用護照或身分證驗證，只需幾分鐘。"
          }
        }
      }
    },
    "error.nationalityMismatch": {
      "comment": "Server refused: proven nationality differs from the claim.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجنسية في هويتك لا تطابق الجنسية التي اخترتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয়ের জাতীয়তা আপনার বেছে নেওয়া জাতীয়তার সাথে মেলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La nacionalitat de la teva identitat no coincideix amb la que has seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Státní příslušnost na tvém dokladu se neshoduje s tou, kterou jsi vybral."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nationaliteten på dit id svarer ikke til den nationalitet, du valgte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Staatsangehörigkeit in deinem Ausweis stimmt nicht mit der von dir gewählten überein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηκοότητα στην ταυτότητά σου δεν ταιριάζει με αυτή που επέλεξες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nationality on your identity does not match the nationality you selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nacionalidad de tu identidad no coincide con la que seleccionaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyytesi kansalaisuus ei vastaa valitsemaasi kansalaisuutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nationalité figurant sur votre identité ne correspond pas à celle que vous avez sélectionnée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזרחות בזהות שלך אינה תואמת לאזרחות שבחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पहचान की राष्ट्रीयता आपकी चुनी हुई राष्ट्रीयता से मेल नहीं खाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Državljanstvo na tvojoj ispravi ne podudara se s državljanstvom koje si odabrao/odabrala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányodon szereplő állampolgárság nem egyezik a kiválasztottal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan pada identitasmu tidak cocok dengan kewarganegaraan yang kamu pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nazionalità sul tuo documento non corrisponde a quella che hai selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認書類の国籍が、選択された国籍と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증의 국적이 선택한 국적과 일치하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഐഡന്റിറ്റിയിലെ പൗരത്വം നിങ്ങൾ തിരഞ്ഞെടുത്ത പൗരത്വവുമായി ഒത്തുപോകുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewarganegaraan pada identiti anda tidak sepadan dengan kewarganegaraan yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasjonaliteten på identiteten din stemmer ikke med nasjonaliteten du valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nationaliteit op je identiteitsbewijs komt niet overeen met de nationaliteit die je hebt gekozen."
