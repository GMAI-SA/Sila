    "events.create.endBeforeStart": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تنتهي بعد أن تبدأ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর পরে শেষ হতে হবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha d'acabar després de començar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Musí skončit po začátku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den skal slutte efter start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es muss nach dem Beginn enden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να τελειώνει μετά την έναρξη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has to end after it starts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene que terminar después de empezar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen on päätyttävä alkamisen jälkeen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il doit se terminer après son début"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא חייב להסתיים אחרי שהוא מתחיל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे शुरू होने के बाद खत्म होना चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mora završiti nakon početka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A befejezésnek a kezdés után kell lennie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harus berakhir setelah dimulai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deve finire dopo l'inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了は開始より後にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간은 시작 시간 이후여야 해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് തുടങ്ങിയതിന് ശേഷം അവസാനിക്കണം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia mesti tamat selepas bermula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det må ende etter at det starter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het moet na de start eindigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musi skończyć się po rozpoczęciu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa terminar depois de começar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem de terminar depois de começar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebuie să se încheie după ce începe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окончание должно быть позже начала"
