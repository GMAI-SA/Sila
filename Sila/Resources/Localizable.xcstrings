    "post.detail.noReplies.subtitle": {
      "comment": "Empty replies list, when the viewer is allowed to reply.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كن أول إنسان موثّق يرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর দেওয়া প্রথম ভেরিফায়েড মানুষ হোন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigues la primera persona verificada a respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buď první ověřený člověk, který odpoví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær det første verificerede menneske, der svarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte als erster verifizierter Mensch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνε ο πρώτος επαληθευμένος άνθρωπος που απαντά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first verified human to reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé la primera persona verificada en responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole ensimmäinen vahvistettu ihminen, joka vastaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez le premier humain vérifié à répondre."
