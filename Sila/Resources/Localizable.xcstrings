        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ വിഷയം മറച്ചു. വീണ്ടും കാണാൻ മുൻഗണനകളിൽ മറവ് നീക്കുക."
