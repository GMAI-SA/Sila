    "feed.order.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرح كيف تُرتّب هذه الخلاصة ويتيح لك تغيير ذلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিড কীভাবে সাজানো তা ব্যাখ্যা করে এবং বদলাতে দেয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica com s'ordena aquest canal i et permet canviar-ho"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysvětlí, jak je tento kanál seřazen, a umožní to změnit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklarer, hvordan dette feed er sorteret, og lader dig ændre det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt, wie dieser Feed sortiert ist, und lässt dich das ändern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξηγεί πώς ταξινομείται αυτή η ροή και σου επιτρέπει να την αλλάξεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explains how this feed is ordered and lets you change it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica cómo se ordena este feed y te permite cambiarlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selittää, miten tämä syöte on järjestetty, ja antaa muuttaa sitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique comment ce fil est ordonné et vous permet de le changer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסביר איך הפיד הזה מסודר ומאפשר לשנות זאת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि यह फ़ीड किस क्रम में है और इसे बदलने देता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objašnjava kako je ovaj feed poredan i omogućuje ti da to promijeniš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elmagyarázza, hogyan van rendezve ez a hírfolyam, és lehetővé teszi a módosítását"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjelaskan bagaimana feed ini diurutkan dan memungkinkanmu mengubahnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega come è ordinato questo feed e ti permette di cambiarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィードの並び順を説明し、変更できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피드의 정렬 방식을 설명하고 변경할 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫീഡ് എങ്ങനെ ക്രമീകരിച്ചിരിക്കുന്നു എന്ന് വിശദീകരിക്കുകയും മാറ്റാൻ അനുവദിക്കുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerangkan cara suapan ini disusun dan membolehkan anda mengubahnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklarer hvordan denne feeden er sortert og lar deg endre det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt uit hoe deze feed is gesorteerd en laat je dat wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjaśnia, jak uporządkowany jest ten kanał, i pozwala to zmienić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica como este feed é ordenado e permite alterar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica como este feed é ordenado e permite alterá-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Explică cum este ordonat acest flux și îți permite să-l schimbi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объясняет, как упорядочена эта лента, и позволяет изменить порядок"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysvetľuje, ako je tento kanál zoradený, a umožňuje to zmeniť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förklarar hur det här flödet är sorterat och låter dig ändra det"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஊட்டம் எப்படி வரிசைப்படுத்தப்படுகிறது என்பதை விளக்கி மாற்ற அனுமதிக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫీడ్ ఎలా క్రమబద్ధీకరించబడిందో వివరించి, మార్చుకోనిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายว่าฟีดนี้เรียงอย่างไรและให้คุณเปลี่ยนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu akışın nasıl sıralandığını açıklar ve değiştirmenizi sağlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пояснює, як впорядкована ця стрічка, і дає змогу це змінити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتاتا ہے کہ یہ فیڈ کیسے ترتیب دی جاتی ہے اور اسے بدلنے دیتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích cách bảng tin này được sắp xếp và cho phép bạn thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明此信息流的排序方式，并可更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明此動態的排序方式，並讓你變更"
          }
        }
      }
    },
