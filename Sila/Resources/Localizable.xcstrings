    "vouch.list.declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفضت. لا يُحتسب ذلك عليك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যাখ্যান করা হয়েছে। আপনার বিরুদ্ধে কিছুই ধরা হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebutjat. No es té res en compte en contra teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmítnuto. Nic se ti nepočítá k tíži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afvist. Intet bliver holdt imod dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelehnt. Dir wird nichts angelastet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απορρίφθηκε. Τίποτα δεν μετράει εις βάρος σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined. Nothing is held against you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazado. No se te tiene nada en cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hylätty. Mitään ei lasketa sinua vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusé. Rien ne vous est reproché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדחה. שום דבר לא נזקף לחובתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्वीकार किया। आपके ख़िलाफ़ कुछ नहीं गिना जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbijeno. Ništa se ne uzima protiv tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elutasítva. Semmi nem róható fel neked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditolak. Tidak ada yang dianggap merugikanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutata. Nulla conta contro di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "却下しました。不利になることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절했어요. 불이익은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിരസിച്ചു. നിങ്ങൾക്കെതിരെ ഒന്നും ഉണ്ടാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditolak. Tiada apa dipersalahkan kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslått. Ingenting holdes mot deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweigerd. Er wordt je niets aangerekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucono. Nic nie jest stawiane Ci za zarzut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusado. Nada é usado contra você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusado. Nada conta contra si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuzat. Nimic nu este ținut împotriva ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонено. Вам это не вменяется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamietnuté. Nič sa ti nezráta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avböjt. Inget läggs dig till last."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிராகரிக்கப்பட்டது. உங்களுக்கு எதிராக எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తిరస్కరించబడింది. మీపై ఎలాంటి ప్రభావం ఉండదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิเสธแล้ว ไม่ส่งผลเสียต่อคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddedildi. Aleyhinize hiçbir şey kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхилено. Вам нічого не ставлять у провину."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کر دیا۔ آپ کے خلاف کچھ نہیں گنا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã từ chối. Không có gì bị tính lỗi với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝，对你没有任何不利影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕，不會對你有任何不利影響。"
          }
        }
      }
    },
    "vouch.list.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ رابطًا وأرسله إلى الشخص الذي تعرفه. يقبله، ثم تؤكّد أنه هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি লিংক তৈরি করে আপনার পরিচিত ব্যক্তিকে পাঠান। তিনি সেটি গ্রহণ করবেন, আর আপনি নিশ্চিত করবেন যে এটি তিনিই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un enllaç i envia'l a la persona que coneixes. L'accepta i tu confirmes que és ella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoř odkaz a pošli ho osobě, kterou znáš. Ona ho přijme a ty potvrdíš, že je to ona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret et link, og send det til den person, du kender. De accepterer det, og du bekræfter, at det er dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Link und sende ihn an die Person, die du kennst. Sie nimmt ihn an, und du bestätigst, dass sie es ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε έναν σύνδεσμο και στείλ' τον στο άτομο που γνωρίζεις. Το άτομο τον αποδέχεται και εσύ επιβεβαιώνεις ότι είναι αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a link and send it to the person you know. They accept it, and you confirm it's them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un enlace y envíaselo a la persona que conoces. Ella lo acepta y tú confirmas que es ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo linkki ja lähetä se tuntemallesi henkilölle. Hän hyväksyy sen, ja sinä vahvistat, että se on hän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un lien et envoyez-le à la personne que vous connaissez. Elle l’accepte, et vous confirmez que c’est elle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור קישור ושלח אותו לאדם שאתה מכיר. הוא מקבל אותו, ואתה מאשר שזה הוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लिंक बनाएँ और उसे उस व्यक्ति को भेजें जिसे आप जानते हैं। वे उसे स्वीकार करते हैं, और आप कन्फ़र्म करते हैं कि वही हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izradi poveznicu i pošalji je osobi koju poznaješ. Ona je prihvaća, a ti potvrđuješ da je to ona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozz létre egy hivatkozást, és küldd el az ismerősödnek. Ő elfogadja, te pedig megerősíted, hogy ő az."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat tautan dan kirim ke orang yang kamu kenal. Mereka menerimanya, dan kamu mengonfirmasi bahwa itu mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un link e invialo alla persona che conosci. Lei lo accetta e tu confermi che è lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを作成して、知っている人に送りましょう。相手が受け入れたら、あなたがその人本人であることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 만들어 아는 사람에게 보내세요. 상대방이 수락하면 내가 본인이 맞는지 확인해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ലിങ്ക് സൃഷ്ടിച്ച് നിങ്ങൾക്ക് അറിയാവുന്നയാൾക്ക് അയയ്ക്കുക. അവർ അത് സ്വീകരിക്കും, അത് അവരാണെന്ന് നിങ്ങൾ സ്ഥിരീകരിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta pautan dan hantar kepada orang yang anda kenal. Mereka menerimanya, dan anda mengesahkan itu mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en lenke og send den til personen du kjenner. De godtar den, og du bekrefter at det er dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een link en stuur hem naar de persoon die je kent. Die accepteert hem en jij bevestigt dat hij of zij het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz link i wyślij go osobie, którą znasz. Ona go przyjmie, a Ty potwierdzisz, że to ona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um link e envie à pessoa que você conhece. Ela aceita, e você confirma que é ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma ligação e envie-a à pessoa que conhece. Ela aceita e você confirma que é ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează un link și trimite-l persoanei pe care o cunoști. Ea îl acceptă, iar tu confirmi că este ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте ссылку и отправьте её знакомому. Он примет её, а вы подтвердите, что это он."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvor odkaz a pošli ho osobe, ktorú poznáš. Ona ho prijme a ty potvrdíš, že je to ona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en länk och skicka den till personen du känner. De godtar den, och du bekräftar att det är de."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பை உருவாக்கி, உங்களுக்குத் தெரிந்தவருக்கு அனுப்புங்கள். அவர் ஏற்பார்; அது அவர்தான் என நீங்கள் உறுதிப்படுத்துவீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లింక్ సృష్టించి, మీకు తెలిసిన వ్యక్తికి పంపండి. వారు అంగీకరిస్తారు, అది వారేనని మీరు నిర్ధారిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างลิงก์แล้วส่งให้คนที่คุณรู้จัก เขายอมรับ แล้วคุณยืนยันว่าเป็นเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı oluşturun ve tanıdığınız kişiye gönderin. O kabul eder, siz de onun olduğunu onaylarsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть посилання й надішліть людині, яку ви знаєте. Вона його прийме, а ви підтвердите, що це вона."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک بنائیں اور اپنے جاننے والے کو بھیجیں۔ وہ اسے قبول کرتے ہیں، اور آپ تصدیق کرتے ہیں کہ یہ وہی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
