    "notifications.empty.subtitle": {
      "comment": "Why an empty list is not a broken one. The second sentence is a privacy promise: reading a notification tells nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلك هنا المتابعات والإعجابات وإعادات النشر والردود والإشارات. ولا يُبلَّغ أحد عندما تقرأها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলো, লাইক, রিপোস্ট, উত্তর ও মেনশন এখানে আসে। আপনি পড়লে কাউকে জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí arriben els seguiments, m'agrada, republicacions, respostes i mencions. Ningú no sap quan les llegeixes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování, lajky, sdílení, odpovědi a zmínky přistanou tady. Nikdo se nedozví, kdy sis je přečetl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye følgere, likes, delinger, svar og omtaler lander her. Ingen får besked, når du læser dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows, Likes, Reposts, Antworten und Erwähnungen landen hier. Niemand erfährt, wann du sie liest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθήσεις, «μου αρέσει», αναδημοσιεύσεις, απαντήσεις και αναφορές καταλήγουν εδώ. Κανείς δεν ενημερώνεται όταν τις διαβάζεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows, likes, reposts, replies and mentions land here. Nobody is told when you read them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí llegan seguidores, me gusta, reposts, respuestas y menciones. A nadie se le avisa de que los lees."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraajat, tykkäykset, uudelleenjaot, vastaukset ja maininnat tulevat tänne. Kenellekään ei kerrota, kun luet ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements, mentions J’aime, republications, réponses et mentions arrivent ici. Personne n’est prévenu quand vous les lisez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוקבים, לייקים, שיתופים, תגובות ותיוגים מופיעים כאן. אף אחד לא מקבל הודעה כשאתה קורא אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो, पसंद, रीपोस्ट, जवाब और मेंशन यहाँ आते हैं। आपके पढ़ने पर किसी को नहीं बताया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje stižu praćenja, sviđanja, ponovne objave, odgovori i spominjanja. Nitko nije obaviješten kad ih pročitaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követések, kedvelések, újramegosztások, válaszok és említések itt jelennek meg. Senki nem tudja meg, mikor olvastad el őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengikut, suka, repost, balasan, dan sebutan masuk di sini. Tidak ada yang diberi tahu saat kamu membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow, mi piace, repost, risposte e menzioni arrivano qui. Nessuno sa quando le leggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー、いいね、リポスト、返信、メンションがここに届きます。あなたが読んだことは誰にも知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우, 좋아요, 리포스트, 답글, 멘션이 여기에 표시돼요. 읽어도 상대방에게 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോളോകൾ, ലൈക്കുകൾ, റീപോസ്റ്റുകൾ, മറുപടികൾ, പരാമർശങ്ങൾ ഇവിടെ വരും. നിങ്ങൾ വായിക്കുമ്പോൾ ആരെയും അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikutan, suka, siar semula, balasan dan sebutan tiba di sini. Tiada sesiapa diberitahu apabila anda membacanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følgere, likerklikk, repostinger, svar og omtaler havner her. Ingen får vite når du leser dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgers, likes, reposts, reacties en vermeldingen komen hier binnen. Niemand hoort wanneer je ze leest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwacje, polubienia, udostępnienia, odpowiedzi i wzmianki lądują tutaj. Nikt nie wie, kiedy je przeczytasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguidores, curtidas, reposts, respostas e menções chegam aqui. Ninguém é avisado quando você as lê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos seguidores, gostos, republicações, respostas e menções chegam aqui. Ninguém é avisado quando as lê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmăririle, aprecierile, repostările, răspunsurile și mențiunile ajung aici. Nimeni nu este anunțat când le citești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки, лайки, репосты, ответы и упоминания появляются здесь. Никто не узнает, что вы их прочитали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pristanú nové sledovania, páči sa mi, zdieľania ďalej, odpovede a spomenutia. Nikto sa nedozvie, že si ich čítal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nya följare, gillningar, delningar, svar och omnämnanden hamnar här. Ingen får veta när du läser dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்தொடர்தல்கள், விருப்பங்கள், மறுபகிர்வுகள், பதில்கள், குறிப்பிடல்கள் இங்கே வரும். நீங்கள் படிக்கும்போது யாருக்கும் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫాలోలు, లైక్‌లు, రీపోస్ట్‌లు, రిప్లైలు, ప్రస్తావనలు ఇక్కడకు వస్తాయి. మీరు వాటిని చదివినప్పుడు ఎవరికీ తెలియదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตาม ถูกใจ รีโพสต์ ตอบกลับ และการกล่าวถึงจะมาอยู่ที่นี่ ไม่มีใครรู้เมื่อคุณอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takipler, beğeniler, yeniden paylaşımlar, yanıtlar ve etiketlemeler burada görünür. Onları okuduğunuzda kimseye haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки, вподобання, репости, відповіді й згадки з’являться тут. Нікого не повідомляють, коли ви їх читаєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فالوز، لائکس، ری پوسٹس، جوابات اور ذکر یہاں آتے ہیں۔ جب آپ انہیں پڑھتے ہیں تو کسی کو نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt theo dõi, lượt thích, đăng lại, trả lời và nhắc đến sẽ về đây. Không ai được báo khi bạn đọc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注、点赞、转发、回复和提及会显示在这里。你查看时不会通知任何人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤、按讚、轉發、回覆和提及都會出現在這裡。你何時查看，沒有人會知道。"
          }
        }
      }
    },
