    "rooms.create.everyoneCanListen": {
      "comment": "The line under the audience header. Scope governs the microphone, never the door.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجميع يمكنهم الاستماع"
