    "notifications.kind.like.detail": {
      "comment": "What the like switch governs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعجاب شخص بأحد منشوراتك. وعادةً ما تكون الأكثر إزعاجًا بين الخمسة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার কোনো পোস্ট লাইক করলে। পাঁচটির মধ্যে সাধারণত এটিই সবচেয়ে বেশি আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú que dona m'agrada a una de les teves publicacions. Normalment el més sorollós dels cinc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo ocenil jeden z tvých příspěvků. Obvykle nejhlučnější z pěti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, der synes godt om et af dine opslag. Som regel den mest støjende af de fem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand liket einen deiner Beiträge. Meist die lauteste der fünf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος δηλώνει «μου αρέσει» σε μια ανάρτησή σου. Συνήθως η πιο θορυβώδης από τις πέντε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone liking one of your posts. Usually the noisiest of the five."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien que da me gusta a una de tus publicaciones. Normalmente la más ruidosa de las cinco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku tykkää julkaisustasi. Yleensä viidestä meluisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un qui aime un de vos posts. En général la plus bruyante des cinq."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו שאוהב אחד מהפוסטים שלך. בדרך כלל הרועשים מבין החמישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आपकी पोस्ट को पसंद कर रहा है। आमतौर पर इन पाँचों में सबसे ज़्यादा शोर वाली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko lajka jednu od tvojih objava. Obično najglasnije od njih pet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki kedveli az egyik bejegyzésedet. Általában az öt közül a leggyakoribb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang menyukai salah satu postinganmu. Biasanya yang paling berisik dari kelima jenis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno che mette mi piace a un tuo post. Di solito la più rumorosa delle cinque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたの投稿にいいねしたとき。5種類のうち、たいてい最も多くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내 게시물에 좋아요를 누를 때. 보통 다섯 가지 중 가장 알림이 많아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും നിങ്ങളുടെ പോസ്റ്റുകളിലൊന്ന് ലൈക്ക് ചെയ്യുന്നത്. സാധാരണ ഈ അഞ്ചിൽ ഏറ്റവും കൂടുതൽ ശബ്ദമുള്ളത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang menyukai salah satu siaran anda. Biasanya yang paling bising daripada lima."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen som liker ett av innleggene dine. Vanligvis den mest støyende av de fem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die een van je berichten liket. Meestal de drukste van de vijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś lubi jeden z Twoich wpisów. Zwykle najgłośniejsze z tych pięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém curtindo um dos seus posts. Em geral, a mais barulhenta das cinco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém a gostar de uma das suas publicações. Normalmente o mais ruidoso dos cinco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva apreciază una dintre postările tale. De obicei cea mai zgomotoasă din cele cinci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то ставит лайк вашему посту. Обычно самых шумных из пяти."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekomu sa páči jeden z tvojich príspevkov. Zvyčajne najviac upozornení z piatich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon som gillar ett av dina inlägg. Oftast den bullrigaste av de fem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது உங்கள் இடுகையை விரும்புகிறார். பொதுவாக ஐந்தில் மிக அதிகமாக வருவது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా మీ పోస్ట్‌లలో ఒకదాన్ని లైక్ చేసినప్పుడు. ఈ ఐదింటిలో సాధారణంగా ఎక్కువ శబ్దం చేసేది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนกดถูกใจโพสต์ของคุณ มักเป็นประเภทที่แจ้งเตือนบ่อยที่สุดในห้าประเภท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri gönderilerinizden birini beğendiğinde. Genellikle beşin en gürültülüsü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось вподобав один із ваших дописів. Зазвичай найчисленніші з п’яти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آپ کی پوسٹ کو لائک کرے۔ عموماً پانچوں میں سب سے زیادہ شور والا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đó thích một bài đăng của bạn. Thường là loại ồn ào nhất trong năm loại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人点赞了你的帖子。通常是这五类中最频繁的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人對你的貼文按讚。通常是五類中最吵的。"
          }
        }
      }
    },
