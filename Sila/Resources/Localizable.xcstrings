    "guest.join.profile.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك الموثّق، وبلدك، وكل ما كتبته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভেরিফায়েড নাম, আপনার দেশ এবং আপনার লেখা সবকিছু।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu nom verificat, el teu país i tot el que has escrit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé ověřené jméno, tvá země a vše, co jsi napsal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verificerede navn, dit land og alt, hvad du har skrevet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein verifizierter Name, dein Land und alles, was du geschrieben hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το επαληθευμένο όνομά σου, η χώρα σου και ό,τι έχεις γράψει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your verified name, your country, and everything you have written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre verificado, tu país y todo lo que has escrito."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistettu nimesi, maasi ja kaikki, mitä olet kirjoittanut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom vérifié, votre pays, et tout ce que vous avez écrit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם המאומת שלך, המדינה שלך, וכל מה שכתבת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सत्यापित नाम, आपका देश, और जो कुछ आपने लिखा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje potvrđeno ime, tvoja zemlja i sve što si napisao/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesített neved, az országod, és minden, amit írtál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama terverifikasimu, negaramu, dan semua yang pernah kamu tulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome verificato, il tuo paese e tutto ciò che hai scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証済みの名前、国、そしてあなたが書いたすべてのもの。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 이름, 국가, 그리고 내가 쓴 모든 글."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പരിശോധിച്ച പേര്, നിങ്ങളുടെ രാജ്യം, നിങ്ങൾ എഴുതിയതെല്ലാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama anda yang disahkan, negara anda, dan semua yang telah anda tulis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt verifiserte navn, landet ditt og alt du har skrevet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je geverifieerde naam, je land en alles wat je hebt geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zweryfikowane imię, kraj i wszystko, co napisałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome verificado, seu país e tudo o que você escreveu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu nome verificado, o seu país e tudo o que escreveu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele tău verificat, țara ta și tot ce ai scris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше проверенное имя, ваша страна и всё, что вы написали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje overené meno, krajina a všetko, čo si napísal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt verifierade namn, ditt land och allt du har skrivit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சரிபார்க்கப்பட்ட பெயர், உங்கள் நாடு, நீங்கள் எழுதிய அனைத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ధృవీకరించబడిన పేరు, మీ దేశం, మీరు రాసినదంతా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อที่ยืนยันแล้ว ประเทศ และทุกสิ่งที่คุณเขียนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış adınız, ülkeniz ve yazdığınız her şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше верифіковане ім’я, ваша країна і все, що ви написали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا تصدیق شدہ نام، آپ کا ملک، اور جو کچھ آپ نے لکھا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên đã xác minh, quốc gia của bạn, và mọi thứ bạn đã viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
