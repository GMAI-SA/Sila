    "voice.kind.question.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى دقيقة. اسأل سؤالًا يمكن للناس الإجابة عنه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ এক মিনিট। মানুষ উত্তর দিতে পারে এমন কিছু জিজ্ঞেস করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a un minut. Pregunta alguna cosa que la gent pugui respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až minutu. Zeptej se na něco, na co lidé mohou odpovědět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til et minut. Spørg om noget, folk kan svare på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu einer Minute. Frag etwas, das andere beantworten können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως ένα λεπτό. Ρώτα κάτι που μπορούν να απαντήσουν οι άλλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to a minute. Ask something people can answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta un minuto. Pregunta algo que la gente pueda responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään minuutti. Kysy jotain, mihin ihmiset voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à une minute. Posez quelque chose à quoi les gens peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד דקה. שאל משהו שאנשים יכולים לענות עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम एक मिनट। कुछ ऐसा पूछें जिसका लोग जवाब दे सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minute. Pitaj nešto na što ljudi mogu odgovoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb egy perc. Kérdezz valamit, amire az emberek válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga satu menit. Tanyakan sesuatu yang bisa dijawab orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a un minuto. Chiedi qualcosa a cui le persone possano rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長1分。みんなが答えられることを聞いてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 1분. 사람들이 답할 수 있는 질문을 해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മിനിറ്റ് വരെ. ആളുകൾക്ക് ഉത്തരം നൽകാവുന്ന ഒന്ന് ചോദിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga seminit. Tanya sesuatu yang boleh dijawab orang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil ett minutt. Spør om noe folk kan svare på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal een minuut. Vraag iets wat mensen kunnen beantwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minuty. Zapytaj o coś, na co ludzie mogą odpowiedzieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até um minuto. Pergunte algo que as pessoas possam responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até um minuto. Faça uma pergunta a que as pessoas possam responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la un minut. Întreabă ceva la care oamenii pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До минуты. Задайте то, на что люди смогут ответить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do minúty. Opýtaj sa na niečo, na čo môžu ľudia odpovedať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till en minut. Fråga något som folk kan svara på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நிமிடம் வரை. மக்கள் பதிலளிக்கக்கூடிய ஒன்றைக் கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నిమిషం వరకు. ప్రజలు సమాధానం చెప్పగలిగే ఏదైనా అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกินหนึ่งนาที ถามสิ่งที่คนตอบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla bir dakika. İnsanların yanıtlayabileceği bir şey sorun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До хвилини. Запитайте те, на що люди можуть відповісти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک منٹ تک۔ کچھ ایسا پوچھیں جس کا لوگ جواب دے سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa một phút. Hỏi điều gì đó mà mọi người có thể trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长一分钟。提一个大家能回答的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最長一分鐘。問一個大家可以回答的問題。"
          }
        }
      }
    },
