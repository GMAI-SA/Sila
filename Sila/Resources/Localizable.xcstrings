            "value": "అంతర్జాతీయం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นานาชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uluslararası"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міжнародний"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بین الاقوامی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc tế"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际"
          }
        },
        "zh-Hant": {
