    "verification.withdraw.confirm.button.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسحب الطلب ويحذف صوره"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জমা প্রত্যাহার করে এবং এর ছবিগুলো মুছে ফেলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira l'enviament i n'elimina les fotos"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne podání a smaže jeho fotografie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trækker indsendelsen tilbage og sletter dens fotos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht die Einreichung zurück und löscht ihre Fotos"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανακαλεί την υποβολή και διαγράφει τις φωτογραφίες της"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraws the submission and deletes its photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira el envío y elimina sus fotos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruu lähetyksen ja poistaa sen kuvat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire l’envoi et supprime ses photos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושך את ההגשה ומוחק את התמונות שלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबमिशन वापस लेता है और उसकी फ़ोटो हटा देता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlači prijavu i briše njezine fotografije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszavonja a beküldést, és törli a fotóit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menarik pengajuan dan menghapus fotonya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritira l'invio ed elimina le sue foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申請を取り下げ、写真を削除します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출을 철회하고 사진을 삭제해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമർപ്പണം പിൻവലിക്കുകയും അതിന്റെ ഫോട്ടോകൾ ഇല്ലാതാക്കുകയും ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menarik balik penghantaran dan memadam fotonya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekker tilbake innsendingen og sletter bildene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekt de aanvraag in en verwijdert de foto's"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofuje zgłoszenie i usuwa jego zdjęcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira o envio e exclui as fotos dele"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira o envio e elimina as respetivas fotos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrage dosarul și șterge fotografiile lui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзывает заявку и удаляет её фото"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne odoslanie a odstráni jeho fotky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drar tillbaka inskickningen och raderar dess bilder"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமர்ப்பிப்பைத் திரும்பப் பெற்று அதன் படங்களை நீக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమర్పణను ఉపసంహరించి, దాని ఫోటోలను తొలగిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถอนคำส่งและลบรูปของคำส่งนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderimi geri çeker ve fotoğraflarını siler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкликає заявку й видаляє її фото"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع کرائی گئی چیز واپس لیتا ہے اور اس کی تصاویر حذف کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rút lại hồ sơ và xóa các ảnh của nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回此提交并删除其照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回送件並刪除其照片"
          }
        }
      }
    },
    "verification.withdraw.confirm.message": {
      "comment": "What withdrawing does: the case is closed, its images deleted, and the next reviewer sees the withdrawn attempt in the history (contract v25).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يراجعه أحد، وستُحذف صوره الآن. يمكنك إرسال طلب جديد فورًا، وسيرى مراجع طلبك التالي أن هذا الطلب قد سُحب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ এটি পর্যালোচনা করবে না, আর এর ছবিগুলো এখনই মুছে ফেলা হবে। আপনি সঙ্গে সঙ্গে নতুন একটি পাঠাতে পারেন; আপনার পরের জমার রিভিউয়ার দেখবেন যে এটি প্রত্যাহার করা হয়েছিল।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú no el revisarà i les fotos s'eliminen ara. En pots enviar un de nou a l'instant; el revisor del teu proper enviament veurà que aquest es va retirar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo ho nebude posuzovat a jeho fotografie se hned smažou. Nové můžeš odeslat okamžitě; posuzovatel tvého dalšího podání uvidí, že toto bylo staženo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen vil gennemgå den, og dens fotos slettes nu. Du kan sende en ny med det samme; den, der gennemgår din næste indsendelse, vil kunne se, at denne blev trukket tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand wird sie prüfen, und ihre Fotos werden jetzt gelöscht. Du kannst sofort eine neue senden; der Prüfer deiner nächsten Einreichung sieht, dass diese zurückgezogen wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν θα την εξετάσει και οι φωτογραφίες της διαγράφονται τώρα. Μπορείς να στείλεις νέα αμέσως· ο ελεγκτής της επόμενης υποβολής σου θα δει ότι αυτή ανακλήθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody will review it, and its photos are deleted now. You can send a new one straight away; the reviewer of your next submission will see that this one was withdrawn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie lo revisará y sus fotos se eliminan ahora. Puedes enviar uno nuevo enseguida; el revisor de tu próximo envío verá que este se retiró."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei tarkasta sitä, ja sen kuvat poistetaan nyt. Voit lähettää uuden heti; seuraavan lähetyksesi tarkastaja näkee, että tämä peruttiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne l’examinera, et ses photos sont supprimées maintenant. Vous pouvez en envoyer un nouveau tout de suite ; le vérificateur de votre prochain envoi verra que celui-ci a été retiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד לא יבדוק אותה, והתמונות שלה נמחקות עכשיו. אפשר לשלוח חדשה מיד; הבודק של ההגשה הבאה שלך יראה שהקודמת נמשכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई इसकी समीक्षा नहीं करेगा, और इसकी फ़ोटो अभी हटा दी जाएँगी। आप तुरंत नया सबमिशन भेज सकते हैं; आपके अगले सबमिशन का समीक्षक देखेगा कि यह वापस लिया गया था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko je neće pregledati, a njezine fotografije se brišu sada. Novu možeš poslati odmah; recenzent tvoje sljedeće prijave vidjet će da je ova povučena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Senki nem fogja elbírálni, és a fotói most törlődnek. Azonnal küldhetsz újat; a következő beküldésed elbírálója látni fogja, hogy ezt visszavontad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak akan ada yang meninjaunya, dan fotonya dihapus sekarang. Kamu bisa langsung mengirim yang baru; peninjau pengajuan berikutnya akan melihat bahwa yang ini ditarik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno lo esaminerà e le sue foto vengono eliminate subito. Puoi inviarne uno nuovo subito; il revisore del prossimo invio vedrà che questo è stato ritirato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰も審査せず、写真はただちに削除されます。すぐに新しい申請を送れます。次の申請の審査担当者には、この申請が取り下げられたことが伝わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 검토하지 않으며 사진은 지금 삭제돼요. 바로 새로 제출할 수 있고, 다음 제출을 검토하는 사람은 이전 제출이 철회되었다는 것을 알게 돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരും ഇത് പരിശോധിക്കില്ല, ഇതിന്റെ ഫോട്ടോകൾ ഇപ്പോൾ ഇല്ലാതാക്കും. നിങ്ങൾക്ക് ഉടൻ പുതിയത് അയയ്ക്കാം; അടുത്ത സമർപ്പണം പരിശോധിക്കുന്നയാൾ ഇത് പിൻവലിച്ചതാണെന്ന് കാണും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa akan menyemaknya, dan fotonya dipadam sekarang. Anda boleh menghantar yang baharu serta-merta; penyemak penghantaran anda yang seterusnya akan melihat bahawa yang ini telah ditarik balik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen vil vurdere den, og bildene slettes nå. Du kan sende inn en ny med en gang. Den som vurderer neste innsending, ser at denne ble trukket tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand beoordeelt hem en de foto's worden nu verwijderd. Je kunt meteen een nieuwe versturen; de beoordelaar van je volgende aanvraag ziet dat deze is ingetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt go nie sprawdzi, a jego zdjęcia zostaną teraz usunięte. Możesz od razu wysłać nowe zgłoszenie; recenzent następnego zobaczy, że to poprzednie zostało wycofane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém vai analisá-lo, e as fotos são excluídas agora. Você pode enviar um novo de imediato; o analista do seu próximo envio verá que este foi retirado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém o vai rever, e as respetivas fotos são eliminadas agora. Pode enviar um novo de imediato; o revisor do seu próximo envio verá que este foi retirado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni nu îl va analiza, iar fotografiile lui sunt șterse acum. Poți trimite imediat unul nou; evaluatorul următorului dosar va vedea că acesta a fost retras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её никто не проверит, а фото будут удалены сейчас. Новую заявку можно отправить сразу; проверяющий вашей следующей заявки увидит, что эта была отозвана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto ho neposúdi a jeho fotky sa teraz odstránia. Nové môžeš poslať hneď; posudzovateľ tvojho ďalšieho odoslania uvidí, že toto bolo stiahnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kommer att granska den, och dess bilder raderas nu. Du kan skicka in en ny direkt; granskaren av din nästa inskickning ser att den här drogs tillbaka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாரும் இதை மதிப்பாய்வு செய்ய மாட்டார்கள்; இதன் படங்கள் இப்போதே நீக்கப்படும். உடனே புதிய ஒன்றை அனுப்பலாம்; உங்கள் அடுத்த சமர்ப்பிப்பை மதிப்பாய்வு செய்பவர், இது திரும்பப் பெறப்பட்டது என்பதைப் பார்ப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరూ దీన్ని సమీక్షించరు, దాని ఫోటోలు ఇప్పుడే తొలగించబడతాయి. మీరు వెంటనే కొత్తది పంపవచ్చు; మీ తదుపరి సమర్పణను చూసే సమీక్షకుడికి ఇది ఉపసంహరించబడిందని తెలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีใครตรวจสอบ และรูปจะถูกลบทันที คุณส่งใหม่ได้ทันที ผู้ตรวจสอบคำส่งครั้งถัดไปของคุณจะเห็นว่าครั้งนี้ถูกถอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimse incelemeyecek ve fotoğrafları şimdi silinecek. Hemen yenisini gönderebilirsiniz; bir sonraki gönderiminizi inceleyen kişi bunun geri çekildiğini görecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніхто її не розглядатиме, а її фото буде видалено зараз. Ви можете одразу надіслати нову; перевіряльник вашої наступної заявки побачить, що ця була відкликана."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اس کا جائزہ نہیں لے گا، اور اس کی تصاویر ابھی حذف ہو جاتی ہیں۔ آپ فوراً نئی بھیج سکتے ہیں؛ آپ کی اگلی جمع کرائی گئی چیز کا جائزہ لینے والا دیکھے گا کہ یہ واپس لی گئی تھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không ai xét duyệt nó, và các ảnh của nó bị xóa ngay. Bạn có thể gửi hồ sơ mới ngay lập tức; người xét duyệt hồ sơ tiếp theo của bạn sẽ thấy hồ sơ này đã bị rút lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会有人审核它，其照片会立即删除。你可以马上重新提交；审核你下一次提交的审核员会看到这一次已被撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人會審核它，其照片會立即刪除。你可以馬上送出新的；審核你下一次送件的人會看到這一次已被撤回。"
          }
        }
      }
    },
