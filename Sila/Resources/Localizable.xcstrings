    "groups.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ واحدة أعلاه، ثم افتح لها غرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরে একটি তৈরি করুন, তারপর এর জন্য একটি রুম খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea'n un a dalt i després obre-hi una sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoř ji výše a pak pro ni otevři místnost."
