    "nationality.picker.message": {
      "comment": "Explains what the choice is for.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الجنسية المدوّنة في وثيقة هويتك. يتحقق النظام منها مقابل الوثيقة — والوثيقة التي تخالفها تُرفض، فاختر ما يمكنك إثباته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচয়পত্রে থাকা জাতীয়তা বেছে নিন। ভেরিফিকেশনে নথির সাথে এটি মেলানো হয় — নথিতে অন্য কিছু লেখা থাকলে তা প্রত্যাখ্যাত হয়, তাই যেটি প্রমাণ করতে পারবেন সেটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria la nacionalitat del teu document d'identitat. La verificació la comprova amb el document: un document que digui una altra cosa es rebutja, així que tria la que puguis demostrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber státní příslušnost uvedenou na dokladu totožnosti. Ověření ji porovná s dokladem – doklad s jinou příslušností se odmítne, takže vyber tu, kterou můžeš prokázat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg den nationalitet, der står på dit id-dokument. Verificeringen tjekker den mod dokumentet – et dokument, der siger noget andet, afvises, så vælg den, du kan bevise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Staatsangehörigkeit aus deinem Ausweisdokument. Die Verifizierung gleicht sie mit dem Dokument ab – ein Dokument, das etwas anderes sagt, wird abgelehnt, wähle also die, die du belegen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε την υπηκοότητα που αναγράφεται στο έγγραφο ταυτότητάς σου. Η επαλήθευση την ελέγχει με το έγγραφο — ένα έγγραφο που λέει κάτι άλλο απορρίπτεται, γι' αυτό διάλεξε αυτήν που μπορείς να αποδείξεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the nationality on your identity document. Verification checks it against the document — a document that says otherwise is refused, so pick the one you can prove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la nacionalidad que figura en tu documento de identidad. La verificación la contrasta con el documento: uno que diga otra cosa se rechaza, así que elige la que puedas demostrar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse henkilöllisyysasiakirjasi kansalaisuus. Vahvistus tarkistaa sen asiakirjaa vasten – toisin sanova asiakirja hylätään, joten valitse se, jonka voit todistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la nationalité figurant sur votre pièce d’identité. La vérification la compare au document — un document qui indique autre chose est refusé, choisissez donc celle que vous pouvez prouver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את האזרחות שבמסמך הזהות שלך. האימות בודק אותה מול המסמך — מסמך שאומר אחרת נדחה, ולכן בחר את זו שאתה יכול להוכיח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पहचान दस्तावेज़ की राष्ट्रीयता चुनें। सत्यापन इसे दस्तावेज़ से मिलाता है — जो दस्तावेज़ कुछ और कहता है उसे अस्वीकार कर दिया जाता है, इसलिए वही चुनें जिसे आप साबित कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi državljanstvo s tvoje osobne isprave. Provjera ga uspoređuje s ispravom — isprava koja kaže drugačije se odbija, pa odaberi ono koje možeš dokazati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki az azonosító okmányodon szereplő állampolgárságot. A hitelesítés összeveti az okmánnyal – az ettől eltérő okmányt elutasítjuk, ezért azt válaszd, amelyet igazolni tudsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kewarganegaraan pada dokumen identitasmu. Verifikasi mencocokkannya dengan dokumen — dokumen yang menyebut lain ditolak, jadi pilih yang bisa kamu buktikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la nazionalità indicata sul tuo documento d'identità. La verifica la confronta con il documento: un documento che dice altro viene rifiutato, quindi scegli quella che puoi dimostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身分証明書に記載されている国籍を選んでください。認証では書類と照合され、異なる国籍の書類は受け付けられません。証明できるほうを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증에 기재된 국적을 선택하세요. 인증 시 문서와 대조하며, 다르게 적힌 문서는 거부되므로 증명할 수 있는 국적을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ തിരിച്ചറിയൽ രേഖയിലെ പൗരത്വം തിരഞ്ഞെടുക്കുക. പരിശോധന അത് രേഖയുമായി ഒത്തുനോക്കും — മറിച്ച് പറയുന്ന രേഖ നിരസിക്കപ്പെടും, അതിനാൽ നിങ്ങൾക്ക് തെളിയിക്കാവുന്നത് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kewarganegaraan pada dokumen identiti anda. Pengesahan menyemaknya dengan dokumen — dokumen yang menyatakan sebaliknya ditolak, jadi pilih yang boleh anda buktikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg nasjonaliteten på legitimasjonen din. Verifiseringen sjekker den mot dokumentet, og et dokument som sier noe annet, avvises, så velg den du kan bevise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de nationaliteit op je identiteitsbewijs. De verificatie controleert die aan de hand van het document: een document dat iets anders zegt wordt geweigerd, dus kies de nationaliteit die je kunt bewijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz obywatelstwo z dokumentu tożsamości. Weryfikacja porównuje je z dokumentem — dokument wskazujący inaczej zostaje odrzucony, więc wybierz to, które możesz udowodnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a nacionalidade que consta no seu documento de identidade. A verificação a confere com o documento; um documento que diga outra coisa é recusado, então escolha a que você consegue comprovar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a nacionalidade do seu documento de identificação. A verificação confronta-a com o documento — um documento que indique outra é recusado, por isso escolha a que consegue comprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cetățenia de pe actul tău de identitate. Verificarea o compară cu documentul — un document care spune altceva este refuzat, așa că alege-o pe cea pe care o poți dovedi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите гражданство, указанное в вашем документе. Проверка сверяет его с документом — документ с другим гражданством будет отклонён, поэтому выберите то, которое можете подтвердить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber štátnu príslušnosť uvedenú na tvojom doklade totožnosti. Overenie ju porovná s dokladom — doklad, ktorý uvádza niečo iné, sa odmietne, preto vyber tú, ktorú vieš preukázať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj nationaliteten på ditt id-dokument. Verifieringen kontrollerar den mot dokumentet – ett dokument som säger något annat avvisas, så välj den du kan bevisa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடையாள ஆவணத்தில் உள்ள குடியுரிமையைத் தேர்ந்தெடுங்கள். சரிபார்ப்பு அதை ஆவணத்துடன் ஒப்பிடும் — வேறு சொல்லும் ஆவணம் நிராகரிக்கப்படும், எனவே நீங்கள் நிரூபிக்கக்கூடியதைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గుర్తింపు పత్రంలోని జాతీయతను ఎంచుకోండి. ధృవీకరణ దాన్ని పత్రంతో సరిపోల్చి చూస్తుంది — పత్రం వేరుగా చెబితే తిరస్కరించబడుతుంది, కాబట్టి మీరు రుజువు చేయగలదాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสัญชาติที่ระบุบนเอกสารยืนยันตัวตนของคุณ การยืนยันจะตรวจเทียบกับเอกสาร หากเอกสารระบุเป็นอย่างอื่นจะถูกปฏิเสธ ดังนั้นเลือกสัญชาติที่คุณพิสูจน์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik belgenizdeki uyruğu seçin. Doğrulama bunu belgeyle karşılaştırır; aksini söyleyen bir belge reddedilir, bu yüzden kanıtlayabileceğinizi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть громадянство з вашого документа. Верифікація звіряє його з документом — документ, що вказує інше, відхиляється, тож виберіть те, яке можете підтвердити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے شناختی دستاویز پر درج قومیت چنیں۔ تصدیق اسے دستاویز سے ملا کر دیکھتی ہے — جو دستاویز کچھ اور کہے وہ رد ہو جاتا ہے، اس لیے وہی چنیں جو آپ ثابت کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn quốc tịch trên giấy tờ tùy thân của bạn. Xác minh đối chiếu nó với giấy tờ — giấy tờ ghi khác sẽ bị từ chối, nên hãy chọn quốc tịch bạn có thể chứng minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择身份证件上的国籍。验证会将其与证件核对，与证件不符的会被拒绝，所以请选择你能证明的那个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇你身分證件上的國籍。驗證時會與證件比對，不一致的證件會被拒絕，所以請選擇你能證明的那個。"
          }
        }
      }
    },
