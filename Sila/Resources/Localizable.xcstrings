    "safety.appeal.error.empty": {
      "comment": "Validation on an appeal with nothing in it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اذكر ما تعتقد أنه حدث — التظلّم الفارغ لا يعطي المراجع شيئًا يزنه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মতে কী ঘটেছে তা বলুন — খালি আপিলে রিভিউয়ারের বিবেচনা করার কিছু থাকে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica què creus que ha passat: una apel·lació buida no dona res al revisor per valorar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš, co se podle tebe stalo – prázdné odvolání nedává posuzovateli nic k zvážení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv, hvad du mener, der skete – en tom anke giver en gennemgående intet at veje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe, was deiner Meinung nach passiert ist – ein leerer Einspruch gibt dem Prüfer nichts zum Abwägen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες τι πιστεύεις ότι συνέβη — μια κενή ένσταση δεν δίνει στον ελεγκτή τίποτα να αξιολογήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what you think happened — an empty appeal gives a reviewer nothing to weigh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta qué crees que pasó: una apelación vacía no le da al revisor nada que valorar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, mitä mielestäsi tapahtui – tyhjä valitus ei anna tarkastajalle mitään punnittavaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ce que vous pensez qu’il s’est passé — un recours vide ne donne rien à examiner à un vérificateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתוב מה לדעתך קרה — ערעור ריק לא נותן לבודק דבר לשקול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताएँ कि आपको क्या हुआ लगता है — खाली अपील समीक्षक के तौलने के लिए कुछ नहीं देती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci što misliš da se dogodilo — prazna žalba recenzentu ne daje ništa za razmatranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg, szerinted mi történt – egy üres fellebbezés semmit nem ad az elbírálónak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang menurutmu terjadi — banding kosong tidak memberi peninjau apa pun untuk dipertimbangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' cosa pensi sia successo: un ricorso vuoto non dà a un revisore nulla da valutare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何があったと思うかを書いてください。空の異議申し立てでは、審査担当者が判断する材料がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무슨 일이 있었다고 생각하는지 적어 주세요. 비어 있는 이의 신청은 검토자가 판단할 근거가 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് സംഭവിച്ചതെന്ന് നിങ്ങൾ കരുതുന്നുവോ അത് പറയുക — ശൂന്യമായ അപ്പീൽ പരിശോധകന് വിലയിരുത്താൻ ഒന്നും നൽകുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyatakan apa yang anda rasa berlaku — rayuan kosong tidak memberi penyemak apa-apa untuk dipertimbangkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hva du tror skjedde. En tom anke gir den som vurderer, ingenting å veie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat je denkt dat er gebeurd is: een leeg bezwaar geeft een beoordelaar niets om te wegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz, co Twoim zdaniem się stało — puste odwołanie nie daje recenzentowi nic do rozważenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que você acha que aconteceu: uma contestação vazia não dá ao analista nada para avaliar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que acha que aconteceu — uma contestação vazia não dá nada a um revisor para avaliar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune ce crezi că s-a întâmplat — o contestație goală nu îi dă evaluatorului nimic de cântărit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, что, по-вашему, произошло, — пустая апелляция не даёт проверяющему ничего для оценки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš, čo sa podľa teba stalo — prázdne odvolanie dáva posudzovateľovi nič na zváženie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta vad du tror hände – ett tomt överklagande ger en granskare inget att väga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன நடந்தது என்று நீங்கள் நினைப்பதைச் சொல்லுங்கள் — வெற்று மேல்முறையீடு மதிப்பாய்வாளருக்கு எடைபோட எதுவும் தராது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏం జరిగిందని మీరు అనుకుంటున్నారో చెప్పండి — ఖాళీ అప్పీల్ సమీక్షకుడికి పరిశీలించడానికి ఏమీ ఇవ్వదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าคุณคิดว่าเกิดอะไรขึ้น คำอุทธรณ์ที่ว่างเปล่าไม่ให้อะไรผู้ตรวจสอบพิจารณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olduğunu düşündüğünüzü yazın; boş bir itiraz, inceleyiciye değerlendirecek bir şey vermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть, що, на вашу думку, сталося — порожня апеляція не дає перевіряльнику чого зважувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتائیں کہ آپ کے خیال میں کیا ہوا — خالی اپیل جائزہ لینے والے کو تولنے کے لیے کچھ نہیں دیتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói bạn nghĩ điều gì đã xảy ra — một khiếu nại trống không cho người xét duyệt gì để cân nhắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说明你认为发生了什么，空白的申诉让审核员无从判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說明你認為發生了什麼事，空白的申訴無法讓審核人員評估。"
          }
        }
      }
    },
