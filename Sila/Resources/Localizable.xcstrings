    "error.invalidReason": {
      "comment": "A report carried a reason the server no longer knows. Nothing was sent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت قائمة الأسباب في «معروف»، فلم يُرسَل شيء. أعد فتح هذا النموذج وأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এর কারণের তালিকা বদলেছে, তাই কিছুই পাঠানো হয়নি। এই ফর্ম আবার খুলে চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La llista de motius de Known ha canviat, així que no s'ha enviat res. Torna a obrir aquest formulari i prova-ho de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam důvodů v aplikaci Known se změnil, takže nic nebylo odesláno. Otevři tento formulář znovu a zkus to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns liste over årsager er ændret, så intet blev sendt. Åbn denne formular igen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste der Gründe bei Known hat sich geändert, daher wurde nichts gesendet. Öffne dieses Formular erneut und versuche es noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα λόγων του Known άλλαξε, οπότε δεν στάλθηκε τίποτα. Άνοιξε ξανά αυτή τη φόρμα και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known's list of reasons has changed, so nothing was sent. Reopen this form and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de motivos de Known ha cambiado, así que no se envió nada. Vuelve a abrir este formulario e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownin syyluettelo on muuttunut, joten mitään ei lähetetty. Avaa tämä lomake uudelleen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des motifs de Known a changé, rien n’a donc été envoyé. Rouvrez ce formulaire et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת הסיבות של Known השתנתה, ולכן שום דבר לא נשלח. פתח את הטופס מחדש ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known की कारणों की सूची बदल गई है, इसलिए कुछ भेजा नहीं गया। यह फ़ॉर्म दोबारा खोलकर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popis razloga aplikacije Known se promijenio pa ništa nije poslano. Ponovno otvori ovaj obrazac i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known okainak listája megváltozott, ezért nem küldtünk el semmit. Nyisd meg újra ezt az űrlapot, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar alasan Known telah berubah, jadi tidak ada yang terkirim. Buka lagi formulir ini dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dei motivi di Known è cambiato, quindi non è stato inviato nulla. Riapri questo modulo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownの理由の一覧が変更されたため、何も送信されていません。このフォームを開き直して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known의 사유 목록이 변경되어 아무것도 전송되지 않았어요. 이 양식을 다시 열고 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ന്റെ കാരണങ്ങളുടെ പട്ടിക മാറിയതിനാൽ ഒന്നും അയച്ചില്ല. ഈ ഫോം വീണ്ടും തുറന്ന് ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai sebab Known telah berubah, jadi tiada apa-apa dihantar. Buka semula borang ini dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns liste over årsaker er endret, så ingenting ble sendt. Åpne skjemaet på nytt og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst met redenen van Known is gewijzigd, dus er is niets verstuurd. Open dit formulier opnieuw en probeer het nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista powodów w Known się zmieniła, więc nic nie wysłano. Otwórz ten formularz ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de motivos do Known mudou, então nada foi enviado. Reabra este formulário e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de motivos da Known mudou, por isso nada foi enviado. Reabra este formulário e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de motive Known s-a schimbat, așa că nu s-a trimis nimic. Redeschide acest formular și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список причин в Known изменился, поэтому ничего не отправлено. Откройте форму снова и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam dôvodov v Known sa zmenil, takže sa nič neodoslalo. Otvor tento formulár znova a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns lista över orsaker har ändrats, så inget skickades. Öppna formuläret igen och försök på nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இன் காரணப் பட்டியல் மாறியுள்ளது, எனவே எதுவும் அனுப்பப்படவில்லை. இந்தப் படிவத்தை மீண்டும் திறந்து முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known కారణాల జాబితా మారింది, కాబట్టి ఏదీ పంపబడలేదు. ఈ ఫారమ్‌ను మళ్లీ తెరిచి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเหตุผลของ Known เปลี่ยนไป จึงไม่ได้ส่งอะไร เปิดแบบฟอร์มนี้ใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'un neden listesi değişti, bu yüzden hiçbir şey gönderilmedi. Bu formu yeniden açıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список причин у Known змінився, тож нічого не надіслано. Відкрийте цю форму знову й спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known کی وجوہات کی فہرست بدل گئی ہے، اس لیے کچھ نہیں بھیجا گیا۔ یہ فارم دوبارہ کھولیں اور پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách lý do của Known đã thay đổi nên chưa có gì được gửi. Hãy mở lại biểu mẫu này và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 的原因列表已更新，因此未发送任何内容。请重新打开此表单后重试。"
          }
