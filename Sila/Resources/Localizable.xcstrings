    "discover.needsReply.explainer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشورات من آخر ثلاثة أيام لم يرد عليها أحد بعد، ويمكنك الرد عليها. الأسئلة أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত তিন দিনের যেসব পোস্টের উত্তর কেউ দেয়নি এবং যেগুলোর উত্তর দেওয়ার অনুমতি আপনার আছে। প্রশ্ন আগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicacions dels últims tres dies que ningú no ha respost encara i a les quals pots respondre. Primer les preguntes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky z posledních tří dní, na které zatím nikdo neodpověděl a na které smíš odpovědět. Nejdřív otázky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag fra de seneste tre dage, som ingen har svaret på endnu, og som du må svare på. Spørgsmål først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge der letzten drei Tage, die noch niemand beantwortet hat und auf die du antworten darfst. Fragen zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναρτήσεις των τελευταίων τριών ημερών που κανείς δεν έχει απαντήσει ακόμα και στις οποίες επιτρέπεται να απαντήσεις. Πρώτα οι ερωτήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts from the last three days that nobody has answered yet, and that you are allowed to answer. Questions first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicaciones de los últimos tres días que nadie ha respondido todavía y que tú puedes responder. Primero las preguntas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolmen viime päivän julkaisut, joihin kukaan ei ole vielä vastannut ja joihin saat vastata. Kysymykset ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts des trois derniers jours auxquels personne n’a encore répondu et auxquels vous avez le droit de répondre. Les questions d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים משלושת הימים האחרונים שאיש עדיין לא השיב להם, ושמותר לך להשיב להם. שאלות קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले तीन दिनों की वे पोस्ट जिनका अभी तक किसी ने जवाब नहीं दिया, और जिनका जवाब देने की आपको अनुमति है। सवाल पहले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave iz posljednja tri dana na koje još nitko nije odgovorio i na koje smiješ odgovoriti. Prvo pitanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt három nap bejegyzései, amelyekre még senki nem válaszolt, és amelyekre te válaszolhatsz. Előbb a kérdések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan tiga hari terakhir yang belum dijawab siapa pun, dan boleh kamu jawab. Pertanyaan lebih dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Post degli ultimi tre giorni a cui nessuno ha ancora risposto e a cui puoi rispondere. Prima le domande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去3日間の投稿のうち、まだ誰も返信しておらず、あなたが返信できるものです。質問を優先して表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 3일 동안 아직 아무도 답하지 않았고 내가 답글을 달 수 있는 게시물이에요. 질문이 먼저 나와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ മൂന്ന് ദിവസത്തെ, ഇതുവരെ ആരും മറുപടി നൽകാത്തതും നിങ്ങൾക്ക് മറുപടി നൽകാൻ അനുവാദമുള്ളതുമായ പോസ്റ്റുകൾ. ചോദ്യങ്ങൾ ആദ്യം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran dalam tiga hari lepas yang belum dijawab sesiapa, dan yang anda dibenarkan menjawab. Soalan dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlegg fra de siste tre dagene som ingen har svart på ennå, og som du har lov til å svare på. Spørsmål først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten van de afgelopen drie dagen waarop nog niemand heeft gereageerd en waarop jij mag reageren. Vragen eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy z ostatnich trzech dni, na które nikt jeszcze nie odpowiedział i na które możesz odpowiedzieć. Najpierw pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts dos últimos três dias que ninguém respondeu ainda e que você pode responder. Perguntas primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicações dos últimos três dias a que ninguém respondeu ainda e a que pode responder. Perguntas primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postări din ultimele trei zile la care nimeni nu a răspuns încă și la care ai voie să răspunzi. Întâi întrebările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты за последние три дня, на которые пока никто не ответил и на которые вы можете ответить. Сначала вопросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky z posledných troch dní, na ktoré ešte nikto neodpovedal a na ktoré môžeš odpovedať ty. Najprv otázky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlägg från de senaste tre dagarna som ingen har svarat på än, och som du får svara på. Frågor först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த மூன்று நாட்களின் இடுகைகள், இன்னும் யாரும் பதிலளிக்காதவை, நீங்கள் பதிலளிக்க அனுமதிக்கப்பட்டவை. கேள்விகள் முதலில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత మూడు రోజుల్లో ఎవరూ ఇంకా సమాధానం ఇవ్వని, మీరు సమాధానం ఇవ్వడానికి అనుమతి ఉన్న పోస్ట్‌లు. ప్రశ్నలు ముందు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ในสามวันที่ผ่านมาที่ยังไม่มีใครตอบ และคุณมีสิทธิ์ตอบ คำถามมาก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son üç günün, henüz kimsenin yanıtlamadığı ve sizin yanıtlayabileceğiniz gönderileri. Önce sorular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дописи за останні три дні, на які ще ніхто не відповів і на які вам можна відповісти. Спершу запитання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلے تین دنوں کی وہ پوسٹس جن کا ابھی کسی نے جواب نہیں دیا، اور جن کا جواب دینے کی آپ کو اجازت ہے۔ پہلے سوالات۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài đăng trong ba ngày qua chưa ai trả lời và bạn được phép trả lời. Câu hỏi được xếp trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去三天内尚无人回复、且你有权回复的帖子。问题优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近三天內還沒有人回答、且你可以回答的貼文，問題優先。"
          }
        }
      }
    },
