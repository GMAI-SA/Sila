    "feed.profileOff.safety.detail": {
      "comment": "What the safety row contains. The last sentence is load-bearing: none of these tools notify the other person.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من حظرتهم ومن كتمتهم وما أبلغت عنه. لم يُبلَّغ أي منهم بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কাদের ব্লক করেছেন, কাদের মিউট করেছেন এবং কী রিপোর্ট করেছেন। তাদের কাউকে জানানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A qui has bloquejat, a qui has silenciat i què has denunciat. Cap d'ells no ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koho jsi zablokoval, koho ztlumil a co jsi nahlásil. Nikdo o tom nebyl informován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem du har blokeret, hvem du har gjort lydløse, og hvad du har anmeldt. Ingen af dem fik besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wen du blockiert, wen du stummgeschaltet und was du gemeldet hast. Niemand wurde benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιους έχεις αποκλείσει, ποιους έχεις βάλει σε σίγαση και τι έχεις αναφέρει. Κανείς δεν ενημερώθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who you've blocked, who you've muted, and what you've reported. None of them were told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A quién has bloqueado, a quién has silenciado y qué has denunciado. A ninguno se le avisó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketkä olet estänyt, ketkä mykistänyt ja mitä olet ilmiantanut. Kenellekään ei kerrottu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vous avez bloqué, qui vous avez mis en sourdine, et ce que vous avez signalé. Aucun n’en a été informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "את מי חסמת, את מי השתקת ועל מה דיווחת. אף אחד מהם לא קיבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने किसे ब्लॉक किया, किसे म्यूट किया, और क्या रिपोर्ट किया। इनमें से किसी को बताया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koga si blokirao/la, koga si utišao/la i što si prijavio/la. Nitko od njih nije obaviješten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiket tiltottál le, kiket némítottál, és mit jelentettél. Egyikük sem kapott értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang kamu blokir, siapa yang kamu bisukan, dan apa yang kamu laporkan. Tidak ada yang diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi hai bloccato, chi hai silenziato e cosa hai segnalato. Nessuno è stato avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックした人、ミュートした人、報告した内容。相手には知らされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 사람, 뮤트한 사람, 신고한 내용. 상대방에게는 알려지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ബ്ലോക്ക് ചെയ്തവർ, മ്യൂട്ട് ചെയ്തവർ, റിപ്പോർട്ട് ചെയ്തവ. ആരെയും അറിയിച്ചിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang anda sekat, siapa yang anda senyapkan, dan apa yang anda laporkan. Tiada seorang pun diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem du har blokkert, hvem du har dempet og hva du har rapportert. Ingen av dem fikk beskjed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie je hebt geblokkeerd, wie je hebt gedempt en wat je hebt gemeld. Niemand is op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kogo zablokowałeś, kogo wyciszyłeś i co zgłosiłeś. Nikt nie został o tym poinformowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem você bloqueou, quem você silenciou e o que você denunciou. Ninguém foi avisado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem bloqueou, quem silenciou e o que denunciou. Nenhum deles foi avisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe cine ai blocat, pe cine ai dezactivat și ce ai raportat. Niciunul nu a fost anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кого вы заблокировали, кого заглушили и на что пожаловались. Никого из них не уведомляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koho si zablokoval, koho si stlmil a čo si nahlásil. Nikomu z nich sa to nepovedalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem du har blockerat, vem du har tystat och vad du har rapporterat. Ingen av dem fick veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் யாரைத் தடுத்தீர்கள், யாரை ஒலியடக்கினீர்கள், எதைப் புகாரளித்தீர்கள். அவர்களில் யாருக்கும் தெரிவிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎవరిని బ్లాక్ చేశారు, ఎవరిని మ్యూట్ చేశారు, దేనిని రిపోర్ట్ చేశారు. వారిలో ఎవరికీ తెలియజేయబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่คุณบล็อก คนที่คุณปิดเสียง และสิ่งที่คุณรายงาน ไม่มีใครได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimleri engellediğiniz, kimleri sessize aldığınız ve neleri şikayet ettiğiniz. Hiçbirine haber verilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кого ви заблокували, кому вимкнули сповіщення і на що поскаржилися. Нікого з них не повідомили."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے کس کو بلاک کیا ہے، کس کو میوٹ کیا ہے، اور کس کی رپورٹ کی ہے۔ ان میں سے کسی کو نہیں بتایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ai bạn đã chặn, đã ẩn, và những gì bạn đã báo cáo. Không ai trong số họ được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你屏蔽了谁、静音了谁，以及你举报了什么。他们都不会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你封鎖了誰、將誰靜音，以及你檢舉了什麼。他們都不會被告知。"
          }
        }
      }
    },
    "feed.profileOff.safety.hint": {
      "comment": "VoiceOver hint for the safety row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الحسابات المحظورة والمكتومة، ويمكن التراجع عن كل منها هنا، إضافةً إلى بلاغاتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্লক ও মিউট করা অ্যাকাউন্ট, যার প্রতিটি সেখানেই ফেরানো যায়, এবং আপনার করা রিপোর্ট খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre els teus comptes bloquejats i silenciats, que es poden desfer des d'allà, i les denúncies que has fet"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře zablokované a ztlumené účty, každý lze vrátit na místě, a podaná nahlášení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner dine blokerede og lydløse konti, som hver kan fortrydes på stedet, og de anmeldelser, du har indgivet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet deine blockierten und stummgeschalteten Konten, jeweils direkt rückgängig zu machen, und die von dir eingereichten Meldungen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τους λογαριασμούς που έχεις αποκλείσει ή βάλει σε σίγαση, με δυνατότητα αναίρεσης επιτόπου, και τις αναφορές που έχεις υποβάλει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your blocked and muted accounts, each undoable in place, and the reports you have filed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tus cuentas bloqueadas y silenciadas, que se pueden deshacer ahí mismo, y las denuncias que has presentado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa estämäsi ja mykistämäsi tilit, jotka voi kumota paikan päällä, sekä tekemäsi ilmiannot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre vos comptes bloqués et en sourdine, chacun annulable sur place, et les signalements que vous avez faits"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את החשבונות החסומים והמושתקים שלך, שאפשר לבטל במקום, ואת הדיווחים שהגשת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ब्लॉक और म्यूट किए अकाउंट खोलता है, हर एक को वहीं पलटा जा सकता है, और आपकी दर्ज की रिपोर्टें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara tvoje blokirane i utišane račune, svaki se može vratiti na mjestu, te prijave koje si podnio/la"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a letiltott és némított fiókjaidat, amelyek helyben visszavonhatók, és a leadott jelentéseidet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka akun yang diblokir dan dibisukan, masing-masing bisa dibatalkan langsung, dan laporan yang kamu ajukan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre gli account bloccati e silenziati, ciascuno annullabile al momento, e le segnalazioni che hai inviato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックとミュートしたアカウント(その場で解除可能)と、これまでの報告を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 및 뮤트한 계정을 열어 그 자리에서 해제할 수 있고, 제출한 신고도 볼 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ബ്ലോക്ക് ചെയ്തതും മ്യൂട്ട് ചെയ്തതുമായ അക്കൗണ്ടുകൾ, ഓരോന്നും അവിടെത്തന്നെ പഴയപടിയാക്കാം, നിങ്ങൾ നൽകിയ റിപ്പോർട്ടുകൾ എന്നിവ തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka akaun yang anda sekat dan senyapkan, masing-masing boleh dibuat asal di tempat, dan laporan yang telah anda failkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner de blokkerte og dempede kontoene dine, som kan angres på stedet, og rapportene du har sendt inn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent je geblokkeerde en gedempte accounts, elk ter plekke ongedaan te maken, en de meldingen die je hebt ingediend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera zablokowane i wyciszone konta, z możliwością cofnięcia na miejscu, oraz złożone zgłoszenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre suas contas bloqueadas e silenciadas, cada uma com opção de desfazer ali mesmo, e as denúncias que você fez"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as suas contas bloqueadas e silenciadas, cada uma reversível ali mesmo, e as denúncias que apresentou"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide conturile blocate și dezactivate, fiecare reversibilă pe loc, și raportările depuse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает заблокированные и заглушённые аккаунты (каждое действие можно тут же отменить) и поданные вами жалобы"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí tvoje zablokované a stlmené účty, každé možno vrátiť priamo na mieste, a nahlásenia, ktoré si podal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar dina blockerade och tystade konton, som du kan ångra direkt, och rapporterna du har skickat"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தடுத்த மற்றும் ஒலியடக்கிய கணக்குகளை (ஒவ்வொன்றையும் அங்கேயே மாற்றலாம்) மற்றும் நீங்கள் அளித்த புகார்களைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు బ్లాక్ చేసిన, మ్యూట్ చేసిన ఖాతాలను (ప్రతిదీ అక్కడే రద్దు చేయవచ్చు), మీరు దాఖలు చేసిన రిపోర్ట్‌లను తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบัญชีที่บล็อกและปิดเสียง ซึ่งยกเลิกได้ทันที และรายงานที่คุณส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellediğiniz ve sessize aldığınız hesapları, her biri yerinde geri alınabilir şekilde, ve yaptığınız şikayetleri açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває ваші заблоковані облікові записи та облікові записи із вимкненими сповіщеннями, кожен можна скасувати на місці, і подані вами скарги"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بلاک اور میوٹ کیے گئے اکاؤنٹس کھولتا ہے، ہر ایک وہیں واپس ہو سکتا ہے، اور آپ کی کی ہوئی رپورٹس"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở các tài khoản bạn đã chặn và ẩn, có thể hoàn tác ngay tại chỗ, và các báo cáo bạn đã gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你已屏蔽和已静音的账户（均可就地撤销）以及你提交的举报"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟你封鎖和靜音的帳號（可就地復原）以及你提出的檢舉"
          }
        }
      }
    },
