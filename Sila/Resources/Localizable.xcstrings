        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter en kopi af alt, Known har om dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt eine Kopie von allem, was Known über dich speichert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατεβάζει αντίγραφο όλων όσων κρατά το Known για εσένα"
