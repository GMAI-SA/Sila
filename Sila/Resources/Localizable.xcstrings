    "document.send.message": {
      "comment": "Contract v34: body of the send step.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتملت صور وثيقتك والتحقق من وجهك. أرسلها للمراجعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নথি ও মুখ যাচাই সম্পন্ন। রিভিউয়ের জন্য পাঠিয়ে দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El document i la comprovació facial estan fets. Envia'ls perquè es revisin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklad i kontrola obličeje jsou hotové. Odešli je k posouzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit dokument og dit ansigtstjek er klar. Send dem til gennemgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Dokument und deine Gesichtsprüfung sind fertig. Sende sie zur Prüfung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το έγγραφό σου και ο έλεγχος προσώπου ολοκληρώθηκαν. Στείλ' τα για έλεγχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your document and your face check are done. Send them to be reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu documento y la comprobación facial están listos. Envíalos para que se revisen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjasi ja kasvotarkistuksesi on tehty. Lähetä ne tarkastettaviksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre document et votre contrôle du visage sont terminés. Envoyez-les pour examen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסמך שלך ובדיקת הפנים הושלמו. שלח אותם לבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दस्तावेज़ और चेहरे की जाँच पूरी हो गई। इन्हें समीक्षा के लिए भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja isprava i provjera lica su gotovi. Pošalji ih na pregled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányod és az arcellenőrzés kész. Küldd el őket elbírálásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen dan pemeriksaan wajahmu sudah selesai. Kirim untuk ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento e il controllo del volto sono completati. Inviali per la revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類と顔の確認が完了しました。審査のために送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서와 얼굴 확인이 끝났어요. 검토를 위해 보내세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖയും മുഖ പരിശോധനയും പൂർത്തിയായി. പരിശോധനയ്ക്കായി അയയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen dan semakan wajah anda telah selesai. Hantar untuk disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet og ansiktskontrollen din er ferdige. Send dem til gjennomgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je document en je gezichtscontrole zijn klaar. Verstuur ze ter beoordeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokument i kontrola twarzy są gotowe. Wyślij je do sprawdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu documento e a verificação do rosto estão prontos. Envie para análise."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu documento e a verificação facial estão concluídos. Envie-os para serem revistos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentul și verificarea feței sunt gata. Trimite-le la analiză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ и проверка лица пройдены. Отправьте их на проверку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj doklad a kontrola tváre sú hotové. Odošli ich na posúdenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt dokument och din ansiktskontroll är klara. Skicka dem för granskning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணமும் முகச் சோதனையும் முடிந்தன. மதிப்பாய்வுக்கு அனுப்புங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రం, ముఖ తనిఖీ పూర్తయ్యాయి. సమీక్ష కోసం వాటిని పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารและการตรวจใบหน้าของคุณเสร็จแล้ว ส่งเพื่อตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgeniz ve yüz kontrolünüz tamam. İncelenmek üzere gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш документ і перевірка обличчя завершені. Надішліть їх на розгляд."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا دستاویز اور چہرے کی جانچ مکمل ہو گئی۔ انہیں جائزے کے لیے بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy tờ và bước kiểm tra khuôn mặt của bạn đã xong. Hãy gửi để được xét duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的证件和人脸检查已完成。请发送以供审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的證件和臉部檢查都已完成。請送出以進行審核。"
          }
        }
      }
    },
