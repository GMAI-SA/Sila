    "search.field.clear.a11yHint": {
      "comment": "VoiceOver hint for the clear button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفرغ حقل البحث ويعرض الوسوم الأكثر تداولًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্চ ঘর খালি করে এবং ট্রেন্ডিং ট্যাগ দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Buida el camp de cerca i mostra les etiquetes en tendència"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdní pole hledání a zobrazí trendy štítky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømmer søgefeltet og viser populære tags"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert das Suchfeld und zeigt Trend-Tags"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αδειάζει το πεδίο αναζήτησης και εμφανίζει τις ετικέτες σε τάση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empties the search field and shows trending tags"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el campo de búsqueda y muestra las etiquetas del momento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää hakukentän ja näyttää nousevat tunnisteet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide le champ de recherche et affiche les tags tendance"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרוקן את שדה החיפוש ומציג תגיות פופולריות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज फ़ील्ड खाली करता है और ट्रेंडिंग टैग दिखाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazni polje za pretragu i prikazuje oznake u trendu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiüríti a keresőmezőt, és megmutatja a felkapott címkéket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengosongkan kolom pencarian dan menampilkan tag yang sedang tren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota il campo di ricerca e mostra i tag di tendenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索欄を空にして、トレンドのタグを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색란을 비우고 인기 태그를 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരയൽ ഫീൽഡ് ശൂന്യമാക്കി ട്രെൻഡിംഗ് ടാഗുകൾ കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengosongkan medan carian dan memaparkan teg yang sedang tren"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømmer søkefeltet og viser trendende emneknagger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt het zoekveld leeg en toont trending tags"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżnia pole wyszukiwania i pokazuje popularne tagi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia o campo de busca e mostra as tags em alta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazia o campo de pesquisa e mostra as etiquetas em alta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Golește câmpul de căutare și arată etichetele în tendințe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищает поле поиска и показывает популярные теги"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdni pole hľadania a zobrazí trendové značky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tömmer sökfältet och visar trendande taggar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் புலத்தை காலி செய்து டிரெண்டிங் குறிச்சொற்களைக் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శోధన ఫీల్డ్‌ను ఖాళీ చేసి ట్రెండింగ్ ట్యాగ్‌లను చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างช่องค้นหาและแสดงแท็กที่กำลังมาแรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama alanını boşaltır ve gündemdeki etiketleri gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищає поле пошуку й показує теги в тренді"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش کا خانہ خالی کرتا ہے اور ٹرینڈنگ ٹیگ دکھاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa trống ô tìm kiếm và hiển thị các thẻ thịnh hành"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空搜索框并显示热门标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空搜尋欄並顯示熱門標籤"
          }
        }
      }
