        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাউকে সরালে তা শুধু এই রুমে প্রযোজ্য। এটি ব্লক নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar algú s'aplica només a aquesta sala. No és un bloqueig."
          }
