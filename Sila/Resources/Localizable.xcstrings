        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా తిరిగి వచ్చింది. ఏదీ కోల్పోలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของคุณกลับมาแล้ว ไม่มีอะไรสูญหาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız geri geldi. Hiçbir şey kaybolmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш обліковий запис повернуто. Нічого не втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اکاؤنٹ واپس آ گیا۔ کچھ ضائع نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn đã trở lại. Không mất gì cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户已恢复，没有丢失任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號已恢復，沒有任何損失。"
          }
        }
