        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks who they are, then gives you a link to send them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta quién es y luego te da un enlace para enviárselo"
