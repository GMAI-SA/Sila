    "account.delete.effect.posts": {
      "comment": "Consequence 3: the posts and the profile disappear.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختفي منشوراتك من كل الصفحات ونتائج البحث والسلاسل، ويتوقف ملفك عن الظهور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পোস্ট সব ফিড, সব সার্চ ফলাফল ও সব থ্রেড থেকে চলে যায়, আর আপনার প্রোফাইল খোলা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves publicacions desapareixen de tots els canals, resultats de cerca i fils, i el teu perfil deixa de resoldre's."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé příspěvky zmizí ze všech kanálů, výsledků hledání i vláken a tvůj profil přestane být dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine opslag forsvinder fra alle feeds, alle søgeresultater og alle tråde, og din profil kan ikke længere findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beiträge verschwinden aus allen Feeds, Suchergebnissen und Threads, und dein Profil ist nicht mehr auffindbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις σου φεύγουν από κάθε ροή, κάθε αποτέλεσμα αναζήτησης και κάθε νήμα, και το προφίλ σου παύει να εμφανίζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts leave every feed, every search result and every thread, and your profile stops resolving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus publicaciones desaparecen de todos los feeds, búsquedas e hilos, y tu perfil deja de aparecer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaisusi poistuvat kaikista syötteistä, hakutuloksista ja keskusteluista, eikä profiilisi enää aukea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos posts disparaissent de tous les fils, de tous les résultats de recherche et de toutes les discussions, et votre profil n’est plus accessible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסטים שלך נעלמים מכל פיד, מכל תוצאות חיפוש ומכל שרשור, והפרופיל שלך מפסיק להיפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट हर फ़ीड, हर खोज नतीजे और हर थ्रेड से हट जाती हैं, और आपकी प्रोफ़ाइल खुलना बंद हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje objave nestaju iz svih feedova, rezultata pretraživanja i niti, a tvoj profil više se ne otvara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzéseid eltűnnek minden hírfolyamból, keresési találatból és szálból, és a profilod nem lesz elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postinganmu hilang dari semua feed, hasil pencarian, dan utas, dan profilmu tidak lagi bisa dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi post spariscono da ogni feed, risultato di ricerca e discussione, e il tuo profilo non è più raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿はすべてのフィード、検索結果、スレッドから消え、プロフィールも表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물이 모든 피드, 검색 결과, 스레드에서 사라지고 프로필도 더 이상 열리지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പോസ്റ്റുകൾ എല്ലാ ഫീഡുകളിൽ നിന്നും തിരയൽ ഫലങ്ങളിൽ നിന്നും ത്രെഡുകളിൽ നിന്നും അപ്രത്യക്ഷമാകും, നിങ്ങളുടെ പ്രൊഫൈൽ തുറക്കാനാവാതാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran anda hilang daripada setiap suapan, setiap hasil carian dan setiap utas, dan profil anda tidak lagi boleh dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innleggene dine forsvinner fra alle feeder, søkeresultater og tråder, og profilen din finnes ikke lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je berichten verdwijnen uit alle feeds, zoekresultaten en threads, en je profiel is niet meer vindbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wpisy znikną ze wszystkich kanałów, wyników wyszukiwania i wątków, a Twój profil przestanie być dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus posts saem de todos os feeds, de todos os resultados de busca e de todas as conversas, e seu perfil deixa de ser encontrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas publicações desaparecem de todos os feeds, resultados de pesquisa e conversas, e o seu perfil deixa de ser encontrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările tale dispar din toate fluxurile, rezultatele căutării și conversațiile, iar profilul tău nu mai poate fi găsit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши посты исчезнут из всех лент, результатов поиска и обсуждений, а профиль перестанет открываться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje príspevky zmiznú zo všetkých kanálov, výsledkov vyhľadávania aj vlákien a tvoj profil prestane fungovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inlägg försvinner från alla flöden, sökresultat och trådar, och din profil går inte längre att hitta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடுகைகள் எல்லா ஊட்டங்கள், தேடல் முடிவுகள், உரையாடல்களிலிருந்து மறையும்; உங்கள் சுயவிவரமும் காணப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పోస్ట్‌లు అన్ని ఫీడ్‌ల నుండి, శోధన ఫలితాల నుండి, థ్రెడ్‌ల నుండి మాయమవుతాయి, మీ ప్రొఫైల్ తెరుచుకోదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ของคุณจะหายไปจากทุกฟีด ผลการค้นหา และเธรด และโปรไฟล์ของคุณจะเปิดไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileriniz tüm akışlardan, arama sonuçlarından ve konuşmalardan kalkar; profiliniz de açılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дописи зникають з усіх стрічок, результатів пошуку та обговорень, а ваш профіль перестає відкриватися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پوسٹس ہر فیڈ، ہر سرچ نتیجے اور ہر تھریڈ سے غائب ہو جاتی ہیں، اور آپ کا پروفائل کھلنا بند ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng của bạn biến mất khỏi mọi bảng tin, mọi kết quả tìm kiếm và mọi chuỗi trả lời, và hồ sơ của bạn không còn truy cập được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帖子会从所有信息流、搜索结果和对话串中消失，你的个人主页也将无法访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貼文會從所有動態、搜尋結果和討論串中消失，你的個人檔案也將無法開啟。"
          }
        }
      }
    },
