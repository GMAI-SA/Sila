    "rooms.voice.connectFailed": {
      "comment": "Shown when the audio transport could not connect and gave no reason of its own.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على «معروف» الوصول إلى صوت الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known রুমের অডিওর সাথে সংযোগ করতে পারেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known no ha pogut accedir a l'àudio de la sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known se nemohla spojit se zvukem místnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known kunne ikke nå rummets lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known konnte das Audio des Raums nicht erreichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known δεν μπόρεσε να συνδεθεί με τον ήχο της αίθουσας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known couldn't reach the room's audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known no pudo acceder al audio de la sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ei saanut yhteyttä huoneen ääneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known n’a pas pu accéder à l’audio du salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known לא הצליחה להגיע לשמע של החדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known रूम के ऑडियो तक नहीं पहुँच सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known nije mogla doći do zvuka sobe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known nem érte el a szoba hangját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tidak bisa menjangkau audio room."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known non è riuscita a raggiungere l'audio della stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownがルームの音声に接続できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known이 룸의 오디오에 연결하지 못했어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
