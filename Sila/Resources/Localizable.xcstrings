    "vouch.error.alreadyVouched": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك من يزكّيك بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ ইতিমধ্যে আপনার জন্য ভাউচ করছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú ja t'avala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo za tebe už ručí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen går allerede i god for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand bürgt bereits für dich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος εγγυάται ήδη για εσένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone is already vouching for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien ya te está avalando."
