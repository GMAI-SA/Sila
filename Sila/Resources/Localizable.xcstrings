    "vouch.error.lifetimeReached": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زُكّيت مرتين — وثّق هويتك لتتابع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য দুবার ভাউচ করা হয়েছে — চালিয়ে যেতে আপনার পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'han avalat dues vegades: verifica la teva identitat per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už se za tebe dvakrát ručilo – pro pokračování ověř svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er gået i god for dig to gange – verificér din identitet for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dich wurde schon zweimal gebürgt – verifiziere deine Identität, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχουν εγγυηθεί για εσένα δύο φορές — επαλήθευσε την ταυτότητά σου για να συνεχίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been vouched for twice — verify your identity to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han avalado dos veces: verifica tu identidad para continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinut on taattu kaksi kertaa – vahvista henkilöllisyytesi jatkaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On s’est porté garant de vous deux fois — vérifiez votre identité pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר ערבו לך פעמיים — אמת את זהותך כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए दो बार वाउच हो चुका है — जारी रखने के लिए अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva puta se jamčilo za tebe — potvrdi svoj identitet da nastaviš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már kétszer kezeskedtek érted – a folytatáshoz hitelesítsd a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah dijamin dua kali — verifikasi identitasmu untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già avuto una garanzia due volte: verifica la tua identità per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証を2回受けています。続けるには本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 두 번 보증을 받았어요. 계속하려면 신원을 인증하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് രണ്ട് തവണ വൗച്ച് ലഭിച്ചു — തുടരാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah dijamin dua kali — sahkan identiti anda untuk meneruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er garantert for deg to ganger. Verifiser identiteten din for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is twee keer voor je ingestaan: verifieer je identiteit om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poręczono za Ciebie dwukrotnie — zweryfikuj tożsamość, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já foi avalizado duas vezes: verifique sua identidade para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já recebeu aval duas vezes — verifique a sua identidade para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai primit deja garanție de două ori — verifică-ți identitatea pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За вас уже поручались дважды — пройдите проверку личности, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručilo sa za teba dvakrát — na pokračovanie over svoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har fått intyg två gånger – verifiera din identitet för att fortsätta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்காக இரண்டு முறை உறுதியளிக்கப்பட்டுவிட்டது — தொடர உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు రెండుసార్లు హామీ ఇవ్వబడింది — కొనసాగడానికి మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้รับการรับรองครบสองครั้งแล้ว ยืนยันตัวตนเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size iki kez kefil olundu; devam etmek için kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За вас уже двічі ручалися — верифікуйте особу, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی دو بار ضمانت دی جا چکی ہے — جاری رکھنے کے لیے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã được bảo chứng hai lần — hãy xác minh danh tính để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已被担保过两次，请验证身份以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已被擔保兩次，請驗證你的身分以繼續。"
          }
        }
      }
    },
    "vouch.error.noSummons": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد ينتظر إجابة بشأن هذه التزكية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভাউচ নিয়ে কেউ উত্তরের অপেক্ষায় নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú no espera una resposta sobre aquest aval."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo nečeká na odpověď k tomuto ručení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen venter på et svar om denne garanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand wartet auf eine Antwort zu dieser Bürgschaft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν περιμένει απάντηση για αυτή την εγγύηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is waiting for an answer about this vouch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie espera una respuesta sobre este aval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei odota vastausta tästä takuusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’attend de réponse au sujet de cette caution."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד לא ממתין לתשובה על הערבות הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वाउच के बारे में किसी के जवाब का इंतज़ार नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko ne čeka odgovor o ovom jamstvu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Senki nem vár választ erre a kezességre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunggu jawaban tentang jaminan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno è in attesa di una risposta su questa garanzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保証について回答を待っている人はいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보증에 대한 답변을 기다리는 사람이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വൗച്ചിനെക്കുറിച്ചുള്ള മറുപടിക്കായി ആരും കാത്തിരിക്കുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa menunggu jawapan tentang jaminan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen venter på svar om denne garantien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand wacht op een antwoord over deze garantie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie czeka na odpowiedź w sprawie tego poręczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está aguardando uma resposta sobre este aval."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está à espera de uma resposta sobre este aval."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni nu așteaptă un răspuns despre această garanție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не ждёт ответа об этом поручительстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto nečaká na odpoveď o tomto ručení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen väntar på ett svar om det här intygandet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுதிமொழி குறித்த பதிலுக்காக யாரும் காத்திருக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ హామీ గురించి సమాధానం కోసం ఎవరూ వేచి ఉండలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครรอคำตอบเกี่ยวกับการรับรองนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kefillikle ilgili yanıt bekleyen kimse yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніхто не чекає на відповідь щодо цього поручительства."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ضمانت کے بارے میں کوئی جواب کا منتظر نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai đang chờ câu trả lời về lời bảo chứng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人在等待关于此担保的答复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人在等待關於這項擔保的回覆。"
          }
        }
      }
    },
    "vouch.error.notEligible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تزكية هذا الحساب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টের জন্য ভাউচ করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte no pot ser avalat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za tento účet nelze ručit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kan ikke gås i god for denne konto."
          }
        },
        "de": {
