        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsrom. Bare verifiserte kontoer i det landet kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Landroom. Alleen geverifieerde accounts in dat land kunnen spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój krajowy. Mówić mogą tylko zweryfikowane konta z tego kraju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala de país. Só contas verificadas nesse país podem falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala nacional. Só contas verificadas nesse país podem falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră de țară. Doar conturile verificate în acea țară pot vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комната страны. Говорить могут только проверенные аккаунты из этой страны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť krajiny. Hovoriť môžu iba overené účty z tejto krajiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsrum. Bara verifierade konton i det landet kan tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாட்டு அறை. அந்த நாட்டில் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేశ రూమ్. ఆ దేశంలో ధృవీకరించబడిన ఖాతాలు మాత్రమే మాట్లాడగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องระดับประเทศ เฉพาะบัญชีที่ยืนยันตัวตนแล้วในประเทศนั้นเท่านั้นที่พูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke odası. Yalnızca o ülkede doğrulanmış hesaplar konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімната країни. Говорити можуть лише верифіковані облікові записи в цій країні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملک کا روم۔ صرف اس ملک کے تصدیق شدہ اکاؤنٹ بول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng quốc gia. Chỉ tài khoản đã xác minh ở quốc gia đó mới phát biểu được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家房间。只有在该国验证的账户可以发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國家聊天室。只有在該國通過驗證的帳號能發言。"
          }
        }
      }
    },
    "post.scope.country.thread.accessibility": {
      "comment": "VoiceOver reading of a country thread's scope. %@ is the country name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلة محلية. لا يمكن الرد إلا للحسابات الموثّقة في %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেশের থ্রেড। শুধু %@-এ ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
