          "stringUnit": {
            "state": "translated",
            "value": "%@ ți-a acceptat garanția — confirmă că este persoana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принял(а) ваше поручительство — подтвердите, что это он(а)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prijal(a) tvoje ručenie — potvrď, že je to on(a)"
