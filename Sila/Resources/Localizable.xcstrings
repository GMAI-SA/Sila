        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka tetapan topik dan negara disenyapkan yang menapis suapan ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner innstillingene for emner og dempede land som filtrerer denne feeden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de instellingen voor onderwerpen en gedempte landen die deze feed filteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera ustawienia tematów i wyciszonych krajów, które filtrują ten kanał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os ajustes de tópicos e de países silenciados que filtram este feed"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as definições de tópicos e países silenciados que filtram este feed"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide setările de subiecte și țări dezactivate care filtrează acest flux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает настройки тем и скрытых стран, которые фильтруют эту ленту"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí nastavenia tém a stlmených krajín, ktoré filtrujú tento kanál"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar inställningarna för ämnen och tystade länder som filtrerar det här flödet"
