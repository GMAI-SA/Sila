    "biometrics.error.lockout": {
      "comment": "Too many failed biometric attempts; the device passcode must unlock it first.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقاييس الحيوية مقفلة. افتح جهازك برمز الدخول أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বায়োমেট্রিক লক হয়ে গেছে। আগে ডিভাইসের পাসকোড দিয়ে আনলক করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La biometria està bloquejada. Desbloqueja primer el dispositiu amb el codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrie je uzamčena. Nejdřív odemkni zařízení kódem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometri er låst. Lås først din enhed op med dens kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrie ist gesperrt. Entsperre zuerst dein Gerät mit dem Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βιομετρικά είναι κλειδωμένα. Ξεκλείδωσε πρώτα τη συσκευή με τον κωδικό της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrics are locked. Unlock your device with its passcode first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biometría está bloqueada. Primero desbloquea tu dispositivo con el código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometriset tunnistukset on lukittu. Avaa ensin laitteesi lukitus pääsykoodilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La biométrie est verrouillée. Déverrouillez d’abord votre appareil avec son code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביומטריה נעולה. בטל קודם את נעילת המכשיר באמצעות קוד הגישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बायोमेट्रिक्स लॉक हैं। पहले अपने डिवाइस को पासकोड से अनलॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrija je zaključana. Prvo otključaj uređaj šifrom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biometrikus azonosítás zárolva van. Először oldd fel az eszközt a jelkóddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrik terkunci. Buka kunci perangkatmu dengan kode sandinya dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati biometrici sono bloccati. Prima sblocca il dispositivo con il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生体認証がロックされています。先にデバイスのパスコードでロックを解除してください。"
