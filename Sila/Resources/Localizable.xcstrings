        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recorded"
          }
        }
      }
    },
    "rooms.create.audience.a11yLabel": {
      "comment": "VoiceOver label for the audience section.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يمكنه التحدث. الجميع يمكنهم الاستماع إلى الغرفة في الحالتين."
