    "error.nothingToWithdraw": {
      "comment": "409 nothing_to_withdraw: the submission was decided (or withdrawn) before the withdrawal arrived.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هناك طلب بانتظار المراجعة — ربما صدر فيه قرار بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিভিউয়ের অপেক্ষায় আর কোনো জমা নেই — সম্ভবত এর সিদ্ধান্ত হয়ে গেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja no hi ha cap enviament pendent de revisió; potser ja s'ha decidit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už nečeká žádné podání k posouzení – možná se o něm už rozhodlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke længere nogen indsendelse, der venter på gennemgang – den er måske allerede afgjort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wartet keine Einreichung mehr auf Prüfung – möglicherweise wurde bereits entschieden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει πια υποβολή που να περιμένει έλεγχο — μπορεί να έχει ήδη αποφασιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no submission waiting for review any more — it may already have been decided."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no hay ningún envío pendiente de revisión; puede que ya se haya decidido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastusta odottavaa lähetystä ei enää ole – siitä on ehkä jo päätetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun envoi n’est plus en attente d’examen — une décision a peut-être déjà été prise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עוד הגשה שממתינה לבדיקה — ייתכן שכבר התקבלה החלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के लिए अब कोई सबमिशन बाकी नहीं है — शायद उस पर फ़ैसला हो चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više nema prijave koja čeka pregled — možda je već donesena odluka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már nincs elbírálásra váró beküldés – lehet, hogy már döntöttek róla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada lagi pengajuan yang menunggu tinjauan — mungkin sudah diputuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è più nessun invio in attesa di revisione: potrebbe essere già stato deciso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査待ちの申請はもうありません。すでに判断が出た可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 검토를 기다리는 제출이 없어요. 이미 결정되었을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധനയ്ക്ക് കാത്തിരിക്കുന്ന സമർപ്പണം ഇപ്പോഴില്ല — ഒരുപക്ഷേ തീരുമാനമായിക്കഴിഞ്ഞു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada lagi penghantaran yang menunggu semakan — ia mungkin sudah diputuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen innsending som venter på gjennomgang lenger. Den kan allerede være avgjort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht geen aanvraag meer op beoordeling. Er is mogelijk al over beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma już zgłoszenia oczekującego na sprawdzenie — mogło zostać już rozstrzygnięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais nenhum envio aguardando análise: ele pode já ter sido decidido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não há nenhum envio à espera de revisão — pode já ter sido decidido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai există niciun dosar în așteptarea analizei — poate s-a luat deja o decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявки, ожидающей проверки, больше нет — возможно, по ней уже принято решение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už nečaká žiadna žiadosť na posúdenie — možno sa o nej už rozhodlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen inskickning som väntar på granskning längre – den kan redan ha avgjorts."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறுஆய்வுக்காகக் காத்திருக்கும் சமர்ப்பிப்பு இனி இல்லை — ஏற்கெனவே முடிவு எடுக்கப்பட்டிருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష కోసం వేచి ఉన్న సమర్పణ ఇక లేదు — దానిపై ఇప్పటికే నిర్ణయం తీసుకుని ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีคำส่งที่รอตรวจสอบอีกแล้ว อาจมีการตัดสินไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme bekleyen bir gönderim kalmadı; zaten karara bağlanmış olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявки, що очікувала б розгляду, більше немає — можливо, рішення вже ухвалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب جائزے کے منتظر کوئی جمع کرائی گئی چیز نہیں — ہو سکتا ہے اس کا فیصلہ ہو چکا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không còn hồ sơ nào đang chờ xét duyệt — có thể đã có quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已没有等待审核的提交，可能已经作出决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已沒有等待審核的送件，可能已經作出決定。"
          }
        }
      }
    },
    "error.oneDoor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للغرفة نوع واحد من الأبواب: مجموعة، أو دعوات، أو من تتابعهم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি রুমের প্রবেশের একটিই ধরন থাকে: একটি গ্রুপ, আমন্ত্রণ, অথবা আপনি যাদের ফলো করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sala té un sol tipus d'accés: un grup, invitacions o les persones que segueixes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost má jeden druh vstupu: skupinu, pozvánky, nebo lidi, které sleduješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rum har én slags adgang: en gruppe, invitationer eller de folk, du følger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Raum hat nur eine Art von Zugang: eine Gruppe, Einladungen oder die Personen, denen du folgst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αίθουσα έχει έναν τύπο πρόσβασης: μια ομάδα, προσκλήσεις ή άτομα που ακολουθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room has one kind of door: a group, invitations, or the people you follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sala tiene un solo tipo de acceso: un grupo, invitaciones o las personas que sigues."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huoneella on yksi oventyyppi: ryhmä, kutsut tai seuraamasi ihmiset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salon n’a qu’un seul type d’accès : un groupe, des invitations ou les personnes que vous suivez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחדר יש סוג אחד של דלת: קבוצה, הזמנות, או האנשים שאתה עוקב אחריהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम का दरवाज़ा एक ही तरह का होता है: ग्रुप, आमंत्रण, या वे लोग जिन्हें आप फ़ॉलो करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba ima jednu vrstu ulaza: grupu, pozivnice ili ljude koje pratiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy szobának egyféle bejárata van: csoport, meghívók, vagy az általad követett emberek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah room punya satu jenis pintu: grup, undangan, atau orang yang kamu ikuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stanza ha un solo tipo di accesso: un gruppo, degli inviti o le persone che segui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームの入口は1種類です。グループ、招待、またはフォロー中の人のいずれかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸은 그룹, 초대, 내가 팔로우하는 사람 중 한 가지 방식으로만 열 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു റൂമിന് ഒരു തരം പ്രവേശന വാതിൽ മാത്രം: ഒരു ഗ്രൂപ്പ്, ക്ഷണങ്ങൾ, അല്ലെങ്കിൽ നിങ്ങൾ ഫോളോ ചെയ്യുന്നവർ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesebuah bilik mempunyai satu jenis pintu: kumpulan, jemputan, atau orang yang anda ikuti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rom har én type dør: en gruppe, invitasjoner eller folk du følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een room heeft één soort toegang: een groep, uitnodigingen of de mensen die je volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój ma jeden rodzaj wejścia: grupa, zaproszenia albo osoby, które obserwujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala tem um só tipo de acesso: um grupo, convites ou as pessoas que você segue."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sala tem um só tipo de porta: um grupo, convites ou as pessoas que segue."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cameră are un singur fel de intrare: un grup, invitații sau persoanele pe care le urmărești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У комнаты один тип входа: группа, приглашения или те, на кого вы подписаны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť má jeden druh dverí: skupinu, pozvánky alebo ľudí, ktorých sleduješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rum har en sorts dörr: en grupp, inbjudningar eller de du följer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஓர் அறைக்கு ஒரே வகை நுழைவாயில்: குழு, அழைப்புகள் அல்லது நீங்கள் பின்தொடர்பவர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక రూమ్‌కు ఒకే రకమైన ద్వారం ఉంటుంది: గ్రూప్, ఆహ్వానాలు, లేదా మీరు ఫాలో అయ్యేవారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องมีประตูได้ประเภทเดียว: กลุ่ม คำเชิญ หรือคนที่คุณติดตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir odanın tek tür kapısı vardır: bir grup, davetler veya takip ettiğiniz kişiler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кімнати може бути лише один вид входу: група, запрошення або люди, на яких ви підписані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم کا ایک ہی طرح کا دروازہ ہوتا ہے: کوئی گروپ، دعوتیں، یا وہ لوگ جنہیں آپ فالو کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phòng chỉ có một kiểu cửa: một nhóm, lời mời, hoặc những người bạn theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个房间只能有一种准入方式：群组、邀请，或你关注的人。"
          }
