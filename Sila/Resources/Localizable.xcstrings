    "notifications.kind.event.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن الفعاليات التي دُعيت إليها أو ستحضرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে আমন্ত্রণ জানানো বা আপনি যাচ্ছেন এমন ইভেন্ট নিয়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre esdeveniments als quals ets convidat o hi vas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O událostech, na které jsi pozván nebo kam jdeš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om begivenheder, du er inviteret til eller kommer til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Events, zu denen du eingeladen bist oder zusagst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για εκδηλώσεις στις οποίες έχεις προσκληθεί ή πηγαίνεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About events you're invited to or going to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre eventos a los que estás invitado o vas a asistir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumista, joihin olet kutsuttu tai joihin olet menossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos des événements auxquels vous êtes invité ou participez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על אירועים שהוזמנת אליהם או שאתה מגיע אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको जिन इवेंट में बुलाया गया है या आप जा रहे हैं, उनके बारे में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "O događajima na koje si pozvan/a ili na koje dolaziš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azokról az eseményekről, amelyekre meghívtak, vagy amelyekre mész."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentang acara yang mengundangmu atau yang akan kamu hadiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugli eventi a cui sei invitato o a cui partecipi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待された、または参加予定のイベントについて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대받았거나 참석하는 이벤트에 관한 알림."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളെ ക്ഷണിച്ചതോ നിങ്ങൾ പങ്കെടുക്കുന്നതോ ആയ ഇവന്റുകളെക്കുറിച്ച്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentang acara yang anda dijemput atau akan hadiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om arrangementer du er invitert til eller skal på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Over evenementen waarvoor je bent uitgenodigd of waar je naartoe gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O wydarzeniach, na które jesteś zaproszony lub się wybierasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre eventos para os quais você foi convidado ou em que vai participar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre eventos para que foi convidado ou a que vai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Despre evenimentele la care ești invitat sau la care participi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О событиях, на которые вы приглашены или идёте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O udalostiach, na ktoré si pozvaný alebo ideš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om evenemang du är inbjuden till eller ska gå på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அழைக்கப்பட்ட அல்லது கலந்துகொள்ளும் நிகழ்வுகள் பற்றி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆహ్వానించబడిన లేదా వెళ్తున్న ఈవెంట్‌ల గురించి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกี่ยวกับกิจกรรมที่คุณได้รับเชิญหรือจะไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet edildiğiniz veya katıldığınız etkinlikler hakkında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про події, на які вас запрошено або на які ви йдете."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان ایونٹس کے بارے میں جن میں آپ مدعو ہیں یا جا رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Về các sự kiện bạn được mời hoặc sẽ tham dự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于你受邀或将参加的活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於你受邀或將參加的活動。"
          }
        }
      }
    },
