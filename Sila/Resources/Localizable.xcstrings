    "push.vouch_verified": {
      "comment": "Push notification body, shown from the loc-key alone: it names nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّقت هويتك — اسمك الآن يحمل كلمتك أنت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি পরিচয় যাচাই করেছেন — এখন আপনার নামের পেছনে আপনার নিজের কথাই আছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has verificat la teva identitat: ara el teu nom es sosté amb la teva pròpia paraula"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřil ses – tvé jméno nyní nese tvé vlastní slovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verificerede din identitet – dit navn bærer nu dit eget ord"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Identität verifiziert – dein Name trägt jetzt dein eigenes Wort"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθεύτηκες — το όνομά σου φέρει πλέον τον δικό σου λόγο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You verified your identity — your name now carries your own word"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaste tu identidad: ahora tu nombre cuenta con tu propia palabra"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistit henkilöllisyytesi – nimesi takana on nyt oma sanasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez vérifié votre identité — votre nom repose désormais sur votre propre parole"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימתת את זהותך — השם שלך נושא עכשיו את המילה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपनी पहचान सत्यापित कर ली — अब आपका नाम आपके अपने वचन पर टिका है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdio/la si svoj identitet — tvoje ime sada nosi tvoju vlastitu riječ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitelesítetted a személyazonosságodat – a neved mostantól a saját szavadat hordozza"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memverifikasi identitasmu — namamu kini dibawa oleh kata-katamu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai verificato la tua identità: ora il tuo nome si regge sulla tua parola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認が完了しました。あなたの名前は、あなた自身の言葉で裏付けられています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 인증했어요. 이제 내 이름은 내 자신의 말로 뒷받침돼요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഐഡന്റിറ്റി പരിശോധിച്ചു — ഇനി നിങ്ങളുടെ പേര് നിങ്ങളുടെ സ്വന്തം വാക്കിൽ നിൽക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mengesahkan identiti anda — nama anda kini bergantung pada kata-kata anda sendiri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifiserte identiteten din. Navnet ditt står nå på ditt eget ord"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je identiteit geverifieerd: je naam draagt nu je eigen woord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowałeś tożsamość — Twoje imię opiera się teraz na Twoim własnym słowie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você verificou sua identidade: agora seu nome vale pela sua própria palavra"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificou a sua identidade — o seu nome passa a valer pela sua própria palavra"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ți-ai verificat identitatea — numele tău poartă acum propria ta vorbă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прошли проверку личности — теперь ваше имя подкреплено вашим собственным словом"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overil si svoju identitu — tvoje meno teraz stojí na tvojom vlastnom slove"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verifierade din identitet – ditt namn bär nu ditt eget ord"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உங்கள் அடையாளத்தைச் சரிபார்த்தீர்கள் — இப்போது உங்கள் பெயர் உங்கள் சொந்த வாக்கைக் கொண்டுள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ గుర్తింపును ధృవీకరించుకున్నారు — ఇప్పుడు మీ పేరు మీ స్వంత మాటను కలిగి ఉంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันตัวตนแล้ว ตอนนี้ชื่อของคุณมีคำรับรองของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi doğruladınız; adınız artık kendi sözünüzü taşıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви верифікували особу — тепер ваше ім’я тримається на вашому власному слові"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اپنی شناخت کی تصدیق کر لی — اب آپ کے نام کے پیچھے آپ کی اپنی بات ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xác minh danh tính — tên của bạn giờ tự mang lời của chính bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已验证身份，你的名字现在由你自己担保"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已驗證身分，你的名字現在以你自己的信用為憑"
          }
        }
      }
    },
