    "safety.report.outcome": {
      "comment": "What Sila will and will not promise. Both halves matter: every report is reviewed, and not every report leads to a removal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع سِلة كل بلاغ. ولا يؤدي كل بلاغ إلى إزالة شيء، ولن تُبلَّغ دائمًا بما حدث."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila reviews every report. Not every report leads to something being removed, and you will not always be told what happened."
          }
        }
      }
    },
    "safety.report.reason.a11yLabel": {
