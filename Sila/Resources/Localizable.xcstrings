    "composer.scope.region.a11yLabel": {
      "comment": "VoiceOver label for a selectable regional row. %@ is the region's full name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. يمكن للحسابات الموثّقة في المنطقة الرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। পুরো অঞ্চলের ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Hi poden respondre els comptes verificats de tota la regió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Odpovídat mohou ověřené účty z celého regionu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verificerede konti i hele regionen kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verifizierte Konten der gesamten Region können antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Επαληθευμένοι λογαριασμοί σε όλη την περιοχή μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verified accounts across the region can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pueden responder las cuentas verificadas de toda la región."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Vahvistetut tilit koko alueelta voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Les comptes vérifiés de toute la région peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. חשבונות מאומתים ברחבי האזור יכולים להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। पूरे क्षेत्र के सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Odgovarati mogu potvrđeni računi iz cijele regije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. A régió hitelesített fiókjai válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Akun terverifikasi di seluruh kawasan bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Possono rispondere gli account verificati di tutta la regione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。地域内の認証済みアカウントが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 지역 전체의 인증된 계정이 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. മേഖലയിലുടനീളമുള്ള പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മറുപടി നൽകാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Akaun yang disahkan di seluruh rantau boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verifiserte kontoer i hele regionen kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Geverifieerde accounts in de hele regio kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Odpowiadać mogą zweryfikowane konta z całego regionu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Contas verificadas de toda a região podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Contas verificadas de toda a região podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Conturile verificate din toată regiunea pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Отвечать могут проверенные аккаунты из всего региона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Odpovedať môžu overené účty z celého regiónu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verifierade konton i hela regionen kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. பிராந்தியம் முழுவதும் உள்ள சரிபார்க்கப்பட்ட கணக்குகள் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ప్రాంతమంతటా ధృవీకరించబడిన ఖాతాలు రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ บัญชีที่ยืนยันตัวตนแล้วทั่วภูมิภาคตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bölgedeki doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Відповідати можуть верифіковані облікові записи з усього регіону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@۔ پورے خطے کے تصدیق شدہ اکاؤنٹ جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Các tài khoản đã xác minh trong khu vực đều trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。该地区内已验证的账户都可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。整個地區已驗證的帳號都能回覆。"
          }
        }
      }
    },
