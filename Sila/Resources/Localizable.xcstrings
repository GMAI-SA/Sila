      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليم الكل كمقروء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark all read"
          }
        }
      }
    },
    "notifications.markAll.confirmation": {
      "comment": "Confirmation after marking all read. %lld is how many the server says it flipped — zero is a different sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عُلّمت %lld إشعارات كمقروءة."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عُلّم %lld إشعارًا كمقروء."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عُلّم إشعار واحد كمقروء."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عُلّم %lld إشعار كمقروء."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "عُلّم إشعاران كمقروءين."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يوجد ما يُعلَّم."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notification marked as read."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notifications marked as read."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nothing left to mark."
                }
              }
            }
          }
        }
      }
    },
    "notifications.markAll.hint": {
      "comment": "VoiceOver hint for Mark all read. Says it notifies nobody and cannot be undone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلّم كل الإشعارات كمقروءة. لا يُبلَّغ أحد بذلك، ولا يمكن التراجع عنه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks every notification as read. Nobody is told, and it cannot be undone."
          }
        }
      }
    },
