    "safety.tab.reports.hint": {
      "comment": "VoiceOver hint for the reports tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كل ما أبلغت عنه وما وصل إليه كل بلاغ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিপোর্ট করা সবকিছু এবং প্রতিটি কতদূর এগিয়েছে দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tot el que has denunciat i en quin punt és cada cas"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí vše, co jsi nahlásil, a kde to každé je"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alt, du har anmeldt, og hvor langt hver sag er nået"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt alles, was du gemeldet hast, und wie weit jede Meldung ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει όλα όσα έχεις αναφέρει και πού βρίσκεται το καθένα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows everything you have reported and where each one has got to"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todo lo que has denunciado y en qué punto está cada denuncia"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kaiken ilmiantamasi ja sen, missä vaiheessa kukin on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche tout ce que vous avez signalé et où en est chaque signalement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את כל מה שדיווחת עליו ולאן כל אחד הגיע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कुछ रिपोर्ट किया और हर एक अब कहाँ तक पहुँचा, सब दिखाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje sve što si prijavio/la i dokle je svaka stigla"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindent mutat, amit jelentettél, és hogy hol tart mindegyik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan semua yang pernah kamu laporkan dan sampai di mana masing-masing"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutto ciò che hai segnalato e a che punto è ciascuna segnalazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでに報告したすべてと、それぞれの状況を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고한 모든 내용과 각각의 진행 상황을 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ റിപ്പോർട്ട് ചെയ്തതെല്ലാം, ഓരോന്നും എവിടെ എത്തി എന്നതും കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan semua yang telah anda laporkan dan perkembangan setiap satu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alt du har rapportert og hvor hver enkelt har kommet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alles wat je hebt gemeld en hoe ver elke melding is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wszystko, co zgłosiłeś, i na jakim etapie jest każde zgłoszenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tudo o que você denunciou e em que pé está cada denúncia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tudo o que denunciou e em que ponto está cada denúncia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată tot ce ai raportat și unde a ajuns fiecare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает всё, на что вы пожаловались, и на каком этапе каждая жалоба"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí všetko, čo si nahlásil, a v akom stave to je"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar allt du har rapporterat och hur långt varje ärende har kommit"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் புகாரளித்த அனைத்தையும், ஒவ்வொன்றும் எந்த நிலையில் உள்ளது என்பதையும் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రిపోర్ట్ చేసిన ప్రతిదాన్ని, ప్రతిదాని ప్రస్తుత స్థితిని చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงทุกอย่างที่คุณรายงานและความคืบหน้าของแต่ละเรื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şikayet ettiğiniz her şeyi ve her birinin geldiği noktayı gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує все, на що ви поскаржилися, і на якому етапі кожна скарга"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کی ہوئی ہر رپورٹ دکھاتا ہے اور یہ کہ ہر ایک کہاں تک پہنچی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị mọi thứ bạn đã báo cáo và mỗi báo cáo đã đến đâu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你举报过的所有内容以及每一项的处理进度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你檢舉過的所有內容及每一項的進度"
          }
        }
      }
    },
    "safety.unblock.hint": {
      "comment": "VoiceOver hint for unblocking. Says what unblocking does not restore, because assuming a follow came back loses somebody an account they cared about.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لكما رؤية بعضكما مجددًا. ولا يعيد أي متابعة أُزيلت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাদের আবার পরস্পরকে দেখতে দেয়। ছিন্ন হওয়া কোনো ফলো ফিরিয়ে আনে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que us torneu a veure. No restaura cap seguiment que s'hagi tallat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní vám znovu se vidět. Neobnoví žádné přerušené sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader jer se hinanden igen. Det genskaber ingen afbrudt følgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt euch einander wieder sehen. Ein getrenntes Follow wird nicht wiederhergestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σας επιτρέπει να βλέπεστε ξανά. Δεν επαναφέρει καμία ακολούθηση που διακόπηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you see each other again. It does not restore any follow that was severed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que volváis a veros. No restablece ningún seguimiento cortado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa teidän nähdä toisenne taas. Se ei palauta katkaistuja seuraamisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous permet de vous revoir. Cela ne rétablit aucun abonnement rompu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר לכם לראות זה את זה שוב. זה לא משחזר מעקב שנותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दोनों को फिर एक-दूसरे को देखने देता है। यह कटा हुआ कोई फ़ॉलो वापस नहीं लाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje vam da se ponovno vidite. Ne vraća prekinuto praćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra láthatjátok egymást. A megszüntetett követéseket nem állítja vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan kalian saling melihat lagi. Tidak memulihkan hubungan mengikuti yang diputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi permette di vedervi di nuovo. Non ripristina i follow che erano stati interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お互いを再び見られるようにします。解除されたフォローは元に戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로를 다시 볼 수 있게 해요. 끊어진 팔로우는 복원되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടും പരസ്പരം കാണാൻ അനുവദിക്കുന്നു. ഇല്ലാതായ ഫോളോ തിരികെ വരില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membolehkan anda saling melihat semula. Ia tidak memulihkan sebarang ikutan yang telah diputuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar dere se hverandre igjen. Det gjenoppretter ingen følging som ble avbrutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat jullie elkaar weer zien. Het herstelt geen verbroken volgrelatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala Wam znów się widzieć. Nie przywraca przerwanego obserwowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que vocês se vejam de novo. Não restaura nenhum vínculo de seguir que tenha sido desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que voltem a ver-se. Não repõe nenhum seguimento que tenha sido cortado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă lasă să vă vedeți din nou. Nu readuce urmăririle întrerupte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет вам снова видеть друг друга. Разорванные подписки не восстанавливаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní vám znova sa vidieť. Neobnoví žiadne zrušené sledovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter er se varandra igen. Det återställer ingen följning som bröts."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இருவரும் மீண்டும் ஒருவரையொருவர் பார்க்கலாம். துண்டிக்கப்பட்ட பின்தொடர்தல் மீண்டும் வராது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఒకరినొకరు మళ్లీ చూడగలరు. తెగిపోయిన ఫాలో తిరిగి రాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คุณเห็นกันและกันอีกครั้ง ไม่ได้คืนการติดตามที่ถูกตัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirinizi yeniden görmenizi sağlar. Kesilen takipleri geri getirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє вам знову бачити одне одного. Не відновлює жодної розірваної підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو ایک دوسرے کو دوبارہ دیکھنے دیتا ہے۔ ختم کیا گیا کوئی فالو بحال نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để hai bên thấy nhau trở lại. Không khôi phục lượt theo dõi đã bị cắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你们重新看到对方。不会恢复已被切断的关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓你們能再次看到彼此，但不會恢復被切斷的追蹤。"
          }
        }
      }
    },
    "safety.unblock.toast": {
      "comment": "Toast after an unblock. Says what did not come back, so nobody assumes a follow was restored. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي حظر %@. ولم تُستعد المتابعة — تابعه من جديد إن أردت عودة منشوراته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে আনব্লক করা হয়েছে। ফলো ফিরে আসেনি — তাদের পোস্ট ফিরে পেতে চাইলে আবার ফলো করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has desbloquejat %@. El seguiment no es restaura: torna'l a seguir si vols veure de nou les seves publicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ je odblokován. Sledování se neobnovilo – sleduj ho znovu, pokud chceš jeho příspěvky zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernede blokeringen af %@. Følgning genskabes ikke – følg vedkommende igen, hvis du vil have opslagene tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entblockt. Das Folgen wird nicht wiederhergestellt – folge der Person erneut, wenn du ihre Beiträge wieder sehen möchtest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άρθηκε ο αποκλεισμός του/της %@. Η ακολούθηση δεν επανέρχεται — ακολούθησέ τον/την ξανά αν θέλεις τις αναρτήσεις του/της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblocked %@. Following is not restored — follow them again if you want their posts back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueaste a %@. El seguimiento no se restablece: vuelve a seguirlo si quieres recuperar sus publicaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto poistettu: %@. Seuraamista ei palauteta – seuraa heitä uudelleen, jos haluat heidän julkaisunsa takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est débloqué. L’abonnement n’est pas rétabli — suivez-le à nouveau si vous voulez revoir ses posts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החסימה של %@ בוטלה. המעקב לא משוחזר — עקוב אחריו שוב אם אתה רוצה את הפוסטים שלו בחזרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अनब्लॉक किया। फ़ॉलो वापस नहीं आया — उनकी पोस्ट फिर चाहिए तो उन्हें दोबारा फ़ॉलो करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokirano: %@. Praćenje nije vraćeno — pratite ga ponovno ako želiš njegove objave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ feloldva. A követés nem áll vissza – kövesd újra, ha újra látni szeretnéd a bejegyzéseit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir %@ dibuka. Hubungan mengikuti tidak dipulihkan — ikuti mereka lagi jika ingin postingannya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sbloccato. Il follow non viene ripristinato: seguilo di nuovo se rivuoi i suoi post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のブロックを解除しました。フォローは元に戻りません。投稿をまた見たい場合は、もう一度フォローしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님의 차단을 해제했어요. 팔로우는 복원되지 않아요. 게시물을 다시 보려면 다시 팔로우하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ അൺബ്ലോക്ക് ചെയ്തു. ഫോളോ തിരികെ വരില്ല — അവരുടെ പോസ്റ്റുകൾ വേണമെങ്കിൽ വീണ്ടും ഫോളോ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dinyahsekat. Ikutan tidak dipulihkan — ikut mereka semula jika anda mahu siaran mereka kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opphevet blokkeringen av %@. Følging gjenopprettes ikke. Følg dem igjen hvis du vil ha innleggene deres tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gedeblokkeerd. Volgen wordt niet hersteld: volg ze opnieuw als je hun berichten terug wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowano: %@. Obserwowanie nie zostaje przywrócone — obserwuj ponownie, jeśli chcesz widzieć jego wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desbloqueado. O vínculo de seguir não é restaurado: siga a pessoa de novo se quiser os posts dela de volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desbloqueado. O seguimento não é reposto — siga novamente se quiser voltar a ver as publicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ai deblocat pe %@. Urmărirea nu este restabilită — urmărește-l din nou dacă vrei postările lui înapoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разблокирован(а). Подписка не восстановлена — подпишитесь снова, если хотите видеть посты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je odblokovaný. Sledovanie sa neobnovilo — sleduj ho znova, ak chceš jeho príspevky späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avblockerade %@. Följningen återställs inte – följ dem igen om du vill ha deras inlägg tillbaka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் தடை நீக்கப்பட்டது. பின்தொடர்தல் மீட்கப்படவில்லை — அவர்களின் இடுகைகள் வேண்டுமெனில் மீண்டும் பின்தொடருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అన్‌బ్లాక్ చేయబడ్డారు. ఫాలో తిరిగి రాలేదు — వారి పోస్ట్‌లు కావాలంటే మళ్లీ ఫాలో చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกบล็อก %@ แล้ว การติดตามไม่ถูกคืน ติดตามพวกเขาอีกครั้งหากต้องการโพสต์ของพวกเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin engeli kaldırıldı. Takip geri gelmez; gönderilerini yeniden görmek istiyorsanız yeniden takip edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ розблоковано. Підписка не відновлюється — підпишіться знову, якщо хочете бачити їхні дописи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو ان بلاک کیا۔ فالو بحال نہیں ہوتا — ان کی پوسٹس واپس چاہیں تو انہیں دوبارہ فالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ chặn %@. Việc theo dõi không được khôi phục — hãy theo dõi lại nếu bạn muốn xem bài đăng của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消屏蔽 %@。关注不会恢复，如果想重新看到对方的帖子，请再次关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已解除封鎖 %@。追蹤不會恢復，若想再看到對方的貼文，請重新追蹤。"
          }
        }
      }
    },
    "safety.unmute.toast": {
      "comment": "Toast after an unmute. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي كتم %@. ويمكن أن تظهر لك منشوراته من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে আনমিউট করা হয়েছে। তাদের পোস্ট আবার আপনার ফিডে আসতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has deixat de silenciar %@. Les seves publicacions poden tornar a aparèixer als teus canals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztlumení uživatele %@ zrušeno. Jeho příspěvky se mohou ve tvých kanálech znovu objevit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slog lyd til for %@. Vedkommendes opslag kan igen vises i dine feeds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stummschaltung von %@ aufgehoben. Die Beiträge können wieder in deinen Feeds erscheinen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άρθηκε η σίγαση του/της %@. Οι αναρτήσεις του/της μπορούν να εμφανίζονται ξανά στις ροές σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmuted %@. Their posts can appear in your feeds again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaste de silenciar a %@. Sus publicaciones pueden volver a aparecer en tus feeds."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mykistys poistettu: %@. Heidän julkaisunsa voivat taas näkyä syötteissäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est plus en sourdine. Ses posts peuvent de nouveau apparaître dans vos fils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשתקה של %@ בוטלה. הפוסטים שלו יכולים להופיע שוב בפידים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अनम्यूट किया। उनकी पोस्ट आपकी फ़ीड में फिर दिख सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukinuto utišavanje: %@. Njihove objave opet se mogu pojaviti u tvojim feedovima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ némítása feloldva. A bejegyzései újra megjelenhetnek a hírfolyamaidban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak dibisukan lagi. Postingannya bisa muncul di feed-mu lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ riattivato. I suoi post possono tornare a comparire nei tuoi feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のミュートを解除しました。投稿がフィードに再び表示されるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님의 뮤트를 해제했어요. 이제 게시물이 내 피드에 다시 나타날 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ അൺമ്യൂട്ട് ചെയ്തു. അവരുടെ പോസ്റ്റുകൾ വീണ്ടും നിങ്ങളുടെ ഫീഡുകളിൽ വരാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dinyahsenyapkan. Siaran mereka boleh muncul dalam suapan anda semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opphevet dempingen av %@. Innleggene deres kan vises i feedene dine igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempen van %@ opgeheven. Hun berichten kunnen weer in je feeds verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnięto wyciszenie: %@. Jego wpisy mogą znów pojawiać się w Twoich kanałach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reativado. Os posts dessa pessoa podem voltar a aparecer nos seus feeds."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deixou de estar silenciado. As publicações podem voltar a aparecer nos seus feeds."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ai reactivat pe %@. Postările lui pot apărea din nou în fluxurile tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ снова включён(а). Посты могут снова появляться в ваших лентах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlmenie %@ je zrušené. Jeho príspevky sa môžu v tvojich kanáloch opäť zobrazovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutade tysta %@. Deras inlägg kan visas i dina flöden igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் ஒலியடக்கம் நீக்கப்பட்டது. அவர்களின் இடுகைகள் உங்கள் ஊட்டங்களில் மீண்டும் தோன்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ అన్‌మ్యూట్ చేయబడ్డారు. వారి పోస్ట్‌లు మీ ఫీడ్‌లలో మళ్లీ కనిపించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกปิดเสียง %@ แล้ว โพสต์ของพวกเขาปรากฏในฟีดของคุณได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin sesi açıldı. Gönderileri akışlarınızda yeniden görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З %@ знято заглушення. Їхні дописи знову можуть з’являтися у ваших стрічках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو ان میوٹ کیا۔ ان کی پوسٹس پھر آپ کی فیڈز میں آ سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ ẩn %@. Bài đăng của họ có thể xuất hiện lại trong bảng tin của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消静音 %@。对方的帖子可以再次出现在你的信息流中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消靜音 %@。對方的貼文可以再次出現在你的動態中。"
          }
        }
      }
    },
    "saved.empty.subtitle": {
      "comment": "Empty state body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أيقونة الحفظ في أي منشور ليظهر هنا. أنت وحدك من يرى هذه القائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে রাখতে যেকোনো পোস্টের বুকমার্কে ট্যাপ করুন। এই তালিকা শুধু আপনি দেখতে পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el marcador de qualsevol publicació per conservar-la aquí. Només tu pots veure aquesta llista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na záložku u kteréhokoli příspěvku si ho tu uložíš. Tento seznam vidíš jen ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på bogmærket på et opslag for at beholde det her. Kun du kan se denne liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Beitrag auf das Lesezeichen, um ihn hier zu behalten. Nur du siehst diese Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε τον σελιδοδείκτη σε οποιαδήποτε ανάρτηση για να την κρατήσεις εδώ. Μόνο εσύ βλέπεις αυτή τη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the bookmark on any post to keep it here. Only you can see this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el marcador de cualquier publicación para guardarla aquí. Solo tú ves esta lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta mitä tahansa julkaisua kirjanmerkillä säilyttääksesi sen täällä. Vain sinä näet tämän listan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le favori sur n’importe quel post pour le garder ici. Vous seul voyez cette liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על הסימנייה בכל פוסט כדי לשמור אותו כאן. רק אתה יכול לראות את הרשימה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी पोस्ट पर बुकमार्क टैप करके उसे यहाँ रखें। यह सूची सिर्फ़ आप देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni oznaku na bilo kojoj objavi da je ovdje zadržiš. Ovaj popis vidiš samo ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármely bejegyzés könyvjelzőjére, hogy itt megőrizd. Ezt a listát csak te látod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk markah pada postingan mana pun untuk menyimpannya di sini. Hanya kamu yang bisa melihat daftar ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il segnalibro su qualsiasi post per tenerlo qui. Solo tu puoi vedere questo elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの投稿でもブックマークをタップすると、ここに保存されます。このリストはあなただけに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물의 북마크를 탭하면 여기에 보관돼요. 이 목록은 나만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏതെങ്കിലും പോസ്റ്റിലെ ബുക്ക്‌മാർക്കിൽ ടാപ്പ് ചെയ്ത് ഇവിടെ സൂക്ഷിക്കുക. ഈ പട്ടിക നിങ്ങൾക്ക് മാത്രമേ കാണാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik penanda buku pada mana-mana siaran untuk menyimpannya di sini. Hanya anda boleh melihat senarai ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bokmerket på et innlegg for å beholde det her. Bare du kan se denne listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de bladwijzer bij een bericht om het hier te bewaren. Alleen jij ziet deze lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zakładkę przy dowolnym wpisie, aby zachować go tutaj. Tę listę widzisz tylko Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no marcador de qualquer post para guardá-lo aqui. Só você vê esta lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no marcador de qualquer publicação para a guardar aqui. Só você vê esta lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge marcajul de pe orice postare ca s-o păstrezi aici. Doar tu vezi această listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь закладки на любом посте, чтобы сохранить его здесь. Этот список видите только вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na záložku pri ľubovoľnom príspevku ho uložíš sem. Tento zoznam vidíš iba ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på bokmärket på ett inlägg för att spara det här. Bara du kan se den här listan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த இடுகையிலும் புக்மார்க்கைத் தட்டினால் அது இங்கே சேமிக்கப்படும். இந்தப் பட்டியலை நீங்கள் மட்டுமே பார்க்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా పోస్ట్‌పై బుక్‌మార్క్‌ను నొక్కితే అది ఇక్కడ ఉంటుంది. ఈ జాబితాను మీరు మాత్రమే చూడగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะบุ๊กมาร์กบนโพสต์ใดก็ได้เพื่อเก็บไว้ที่นี่ เห็นรายการนี้ได้เฉพาะคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada tutmak için herhangi bir gönderideki yer imine dokunun. Bu listeyi yalnızca siz görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться закладки на будь-якому дописі, щоб зберегти його тут. Цей список бачите лише ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی پوسٹ پر بک مارک پر ٹیپ کریں تاکہ وہ یہاں رہے۔ یہ فہرست صرف آپ دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào dấu trang trên bất kỳ bài đăng nào để giữ nó ở đây. Chỉ bạn thấy danh sách này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点任何帖子上的书签，即可保存在这里。只有你能看到此列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點任何貼文上的書籤即可保存在這裡。只有你看得到這份清單。"
          }
        }
      }
    },
