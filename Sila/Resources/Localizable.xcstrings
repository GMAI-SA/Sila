        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move so your face fills the circle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete para que tu rostro llene el círculo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry niin, että kasvosi täyttävät ympyrän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez-vous pour que votre visage remplisse le cercle"
