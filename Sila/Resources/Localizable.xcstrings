    "account.profile.save.hint": {
      "comment": "VoiceOver hint for the profile save button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل اسمك ومعرّفك ونبذتك إلى «معروف»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নাম, হ্যান্ডেল ও বায়ো Known-এ পাঠায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia el teu nom, identificador i biografia a Known"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle tvé jméno, handle a bio do aplikace Known"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dit navn, handle og bio til Known"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Name, Handle und Bio an Known"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει το όνομα, το handle και το βιογραφικό σου στο Known"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your name, handle and bio to Known"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu nombre, identificador y biografía a Known"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää nimesi, käyttäjätunnuksesi ja esittelysi Knownille"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie votre nom, votre identifiant et votre bio à Known"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח ל-Known את השם, שם המשתמש והתיאור שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नाम, हैंडल और बायो Known को भेजता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje tvoje ime, handle i bio aplikaciji Known"
