    "rooms.host.cannotDemoteHost": {
      "comment": "Refusal when a host tries to move themselves off their own stage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت المضيف. لإنهاء دورك أنهِ الغرفة — لا توجد طريقة لتنزل عن منصتك بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি হোস্ট। রুম শেষ করে দিয়েই রুম হস্তান্তর করুন — নিজের মঞ্চ থেকে নামার কোনো উপায় নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ets l'amfitrió. Per cedir la sala, acaba-la: no hi ha manera de baixar del teu propi escenari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsi hostitel. Místnost předáš jejím ukončením – z vlastního pódia sestoupit nelze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er værten. Giv rummet fra dig ved at afslutte det – du kan ikke træde af din egen scene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der Host. Gib den Raum ab, indem du ihn beendest – du kannst nicht einfach deine eigene Bühne verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είσαι ο οικοδεσπότης. Παράδωσε την αίθουσα τερματίζοντάς την — δεν υπάρχει τρόπος να φύγεις από τη δική σου σκηνή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the host. Hand the room over by ending it — there is no way to step off your own stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el anfitrión. Cede la sala terminándola: no hay forma de bajar de tu propio escenario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet isäntä. Luovuta huone päättämällä se – omalta lavaltasi ei voi astua pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes l’animateur. Pour passer la main, terminez le salon — il n’y a aucun moyen de quitter votre propre scène."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה המארח. כדי למסור את החדר סיים אותו — אין דרך לרדת מהבמה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप होस्ट हैं। रूम खत्म करके ही उसे किसी और को सौंपा जा सकता है — अपने ही स्टेज से उतरने का कोई तरीका नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti si domaćin. Sobu predaješ tako da je završiš — ne možeš sići sa svoje pozornice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vagy a házigazda. A szoba átadásához fejezd be – a saját színpadodról nem lehet leszállni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hostnya. Serahkan room dengan mengakhirinya — tidak ada cara turun dari panggungmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei l'host. Per cedere la stanza devi chiuderla: non c'è modo di scendere dal tuo stesso palco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはホストです。ルームを手放すには終了してください。自分のステージから降りる方法はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 호스트예요. 룸을 넘기려면 룸을 종료하세요. 자신의 무대에서 내려올 방법은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളാണ് ഹോസ്റ്റ്. റൂം അവസാനിപ്പിച്ച് ഏൽപ്പിക്കാം — സ്വന്തം സ്റ്റേജിൽ നിന്ന് ഇറങ്ങാൻ വഴിയില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ialah hos. Serahkan bilik dengan menamatkannya — tiada cara untuk turun dari pentas anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er verten. Overlat rommet ved å avslutte det. Det finnes ingen måte å gå av din egen scene på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bent de host. Draag de room over door hem te beëindigen: je kunt niet van je eigen podium stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś gospodarzem. Przekaż pokój, kończąc go — nie można zejść z własnej sceny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o anfitrião. Para passar a sala adiante, encerre-a: não há como sair do seu próprio palco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É o anfitrião. Passe a sala a outra pessoa terminando-a — não há forma de sair do seu próprio palco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești gazda. Predai camera încheind-o — nu există cale de a părăsi propria scenă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ведущий. Передать комнату можно, только завершив её, — сойти с собственной сцены нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hostiteľ. Miestnosť odovzdáš jej ukončením — z vlastného pódia sa zísť nedá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är värd. Lämna över rummet genom att avsluta det – det går inte att kliva av din egen scen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள்தான் நடத்துநர். அறையை முடிப்பதன் மூலம் அதை ஒப்படையுங்கள் — உங்கள் சொந்த மேடையிலிருந்து இறங்க வழி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరే హోస్ట్. రూమ్‌ను ముగించడం ద్వారా దాన్ని అప్పగించండి — మీ స్వంత వేదిక నుండి దిగే మార్గం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคือเจ้าของห้อง ส่งต่อห้องโดยการจบห้อง ไม่มีวิธีก้าวลงจากเวทีของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu sizsiniz. Odayı sonlandırarak devredebilirsiniz; kendi sahnenizden inmenin bir yolu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ведучий. Передати кімнату можна лише завершивши її — зійти з власної сцени не можна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ میزبان ہیں۔ روم کو ختم کر کے ہی اسے چھوڑا جا سکتا ہے — اپنے اسٹیج سے اترنے کا کوئی طریقہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là chủ phòng. Hãy bàn giao phòng bằng cách kết thúc nó — không có cách nào rời khỏi sân khấu của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是主持人。想交出房间，只能结束它，无法从自己的发言台上下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是主持人。要交出聊天室只能結束它，無法離開你自己的舞台。"
          }
        }
      }
    },
    "rooms.host.demotedToast": {
      "comment": "Toast after moving a speaker back. Says explicitly that they were not removed. %@ is their name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد %@ إلى الاستماع. ولم يُخرج من الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আবার শুনছেন। তাকে সরানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ torna a escoltar. No ha estat expulsat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ zase poslouchá. Nebyl odebrán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lytter igen. Vedkommende blev ikke fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hört wieder zu. Die Person wurde nicht entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ ακούει ξανά. Δεν αφαιρέθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is listening again. They were not removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a escuchar. No fue expulsado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuuntelee taas. Häntä ei poistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est de nouveau à l’écoute. Il n’a pas été retiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מאזין שוב. הוא לא הוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फिर से सुन रहे हैं। उन्हें हटाया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ponovno sluša. Nije uklonjen/a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ újra hallgat. Nem lett eltávolítva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mendengarkan lagi. Mereka tidak dikeluarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è di nuovo in ascolto. Non è stato rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は再び聴く側になりました。削除はされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 다시 듣고 있어요. 내보내지는 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വീണ്ടും കേൾക്കുകയാണ്. അവരെ നീക്കം ചെയ്തിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mendengar semula. Mereka tidak dialih keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lytter igjen. Vedkommende ble ikke fjernet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ luistert weer. Diegene is niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ znów słucha. Nie został(a) usunięty(-a)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltou a ouvir. A pessoa não foi removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está novamente a ouvir. Não foi removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ascultă din nou. Nu a fost scos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ снова слушает. Его(её) не удаляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opäť počúva. Nebol(a) odstránený(á)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lyssnar igen. De togs inte bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மீண்டும் கேட்கிறார். அவர் நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మళ్లీ వింటున్నారు. వారిని తొలగించలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กลับมาฟังอีกครั้ง ไม่ได้ถูกนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yeniden dinliyor. Odadan çıkarılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ знову слухає. Його(її) не вилучено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پھر سن رہے ہیں۔ انہیں ہٹایا نہیں گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lại đang nghe. Họ không bị xóa khỏi phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回到收听状态，并未被移出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回到收聽。對方沒有被移出。"
          }
        }
      }
    },
    "rooms.host.dismissHand": {
      "comment": "Host: dismiss a hand.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خفض يدهم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাদের হাত নামান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixa-li la mà"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustit jeho ruku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sænk deres hånd"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand senken lassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατέβασμα του χεριού του"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower their hand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar su mano"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske hänen kätensä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser sa main"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורד את היד שלהם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनका हाथ नीचे करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusti im ruku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezének leengedése"
          }
