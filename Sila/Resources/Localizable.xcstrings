        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrik dikunci. Buka kunci peranti anda dengan kod laluannya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometri er låst. Lås opp enheten med tilgangskoden først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrie is vergrendeld. Ontgrendel eerst je apparaat met de toegangscode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
