    "rooms.search.a11yHint": {
      "comment": "VoiceOver hint for the rooms search field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث في عناوين الغرف ومواضيعها، المباشرة والمجدولة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ ও নির্ধারিত রুমের শিরোনাম ও বিষয় খোঁজে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per títols i temes de sales, en directe i programades"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledá v názvech a tématech místností, živých i naplánovaných"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søger i rumtitler og emner, live og planlagte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht Titel und Themen von Räumen, laufenden und geplanten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητά τίτλους και θέματα αιθουσών, ζωντανών και προγραμματισμένων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches room titles and topics, live and scheduled"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en los títulos y temas de las salas, en directo y programadas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakee huoneiden otsikoita ja aiheita, livenä ja ajastettuja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche dans les titres et sujets des salons, en direct et programmés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחפש בכותרות ובנושאים של חדרים, בשידור ומתוזמנים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम के शीर्षक और टॉपिक में खोजता है, लाइव और शेड्यूल दोनों"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretražuje naslove i teme soba, uživo i zakazane"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szobacímek és témák keresése, élőben és ütemezve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari judul dan topik room, yang langsung dan terjadwal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca tra titoli e argomenti delle stanze, in diretta e programmate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ中と予定のルームのタイトルとトピックを検索します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 및 예약된 룸의 제목과 주제를 검색해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ്, ഷെഡ്യൂൾ ചെയ്ത റൂമുകളുടെ തലക്കെട്ടുകളും വിഷയങ്ങളും തിരയുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari tajuk dan topik bilik, langsung dan dijadualkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker i romtitler og emner, live og planlagte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt in roomtitels en onderwerpen, live en gepland"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuje tytuły i tematy pokoi, na żywo i zaplanowanych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca títulos e temas de salas, ao vivo e agendadas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa títulos e tópicos de salas, em direto e agendadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută în titlurile și subiectele camerelor, live și programate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет по названиям и темам комнат — идущих и запланированных"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadá v názvoch a témach miestností, živých aj naplánovaných"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker i rumstitlar och ämnen, live och schemalagda"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலை மற்றும் திட்டமிட்ட அறைகளின் தலைப்புகளையும் பொருள்களையும் தேடும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్, షెడ్యూల్ చేసిన రూమ్‌ల శీర్షికలను, అంశాలను వెతుకుతుంది"
          }
        },
