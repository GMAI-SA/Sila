        }
      }
    },
    "vouch.refusal.tooNew": {
      "comment": "%1$@ is a number of days, %2$@ a date.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تزكية الآخرين بعد %1$@ يومًا من توثيق هويتك — ابتداءً من %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভেরিফাই করার %1$@ দিন পর আপনি অন্যদের জন্য ভাউচ করতে পারবেন — %2$@ থেকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots avalar persones %1$@ dies després de verificar-te: a partir del %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručit za lidi můžeš %1$@ dní po ověření – od %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gå i god for andre %1$@ dage efter, at du er verificeret – fra %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %1$@ Tage nach deiner Verifizierung für Personen bürgen – ab %2$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να εγγυάσαι για άλλους %1$@ ημέρες μετά την επαλήθευσή σου — από %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can vouch for people %1$@ days after verifying — from %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes avalar a otras personas %1$@ días después de verificarte, a partir del %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit taata ihmisiä %1$@ päivää vahvistuksen jälkeen – alkaen %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez vous porter garant de personnes %1$@ jours après votre vérification — à partir du %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לערוב לאנשים %1$@ ימים אחרי האימות — החל מ-%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापन के %1$@ दिन बाद आप लोगों के लिए वाउच कर सकते हैं — %2$@ से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ljude možeš jamčiti %1$@ dana nakon potvrde — od: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesítés után %1$@ nappal kezeskedhetsz másokért – ettől: %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menjamin orang %1$@ hari setelah verifikasi — mulai %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi garantire per altre persone %1$@ giorni dopo la tua verifica, cioè dal %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証から%1$@日後(%2$@から)に、他の人を保証できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 후 %1$@일이 지나야 다른 사람을 보증할 수 있어요. %2$@부터 가능해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വെരിഫൈ ചെയ്ത് %1$@ ദിവസം കഴിഞ്ഞാൽ നിങ്ങൾക്ക് മറ്റുള്ളവർക്ക് വൗച്ച് ചെയ്യാം — %2$@ മുതൽ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menjamin orang %1$@ hari selepas mengesahkan — mulai %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan garantere for folk %1$@ dager etter at du er verifisert, fra %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt voor mensen instaan %1$@ dagen na je verificatie, vanaf %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz poręczać za ludzi %1$@ dni po weryfikacji — od: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode avalizar pessoas %1$@ dias depois de se verificar, a partir de %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode dar aval %1$@ dias depois de se verificar — a partir de %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți garanta pentru alții la %1$@ zile după verificare — din %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручаться за людей можно через %1$@ дней после проверки — с %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ľudí môžeš ručiť %1$@ dní po overení — od %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan intyga för andra %1$@ dagar efter att du verifierat dig – från %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்த்த %1$@ நாட்களுக்குப் பிறகு — %2$@ முதல் — பிறருக்கு உறுதியளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధృవీకరించిన %1$@ రోజుల తర్వాత మీరు ఇతరులకు హామీ ఇవ్వవచ్చు — %2$@ నుండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรับรองผู้อื่นได้หลังยืนยันตัวตน %1$@ วัน คือตั้งแต่ %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğruladıktan %1$@ gün sonra insanlara kefil olabilirsiniz; %2$@ tarihinden itibaren."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручатися за людей можна через %1$@ днів після верифікації — з %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ تصدیق کے %1$@ دن بعد لوگوں کی ضمانت دے سکتے ہیں — %2$@ سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể bảo chứng cho người khác %1$@ ngày sau khi xác minh — từ %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份 %1$@ 天后才能为他人担保，即从 %2$@ 起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證 %1$@ 天後才能為別人擔保，從 %2$@ 起。"
          }
        }
      }
    },
