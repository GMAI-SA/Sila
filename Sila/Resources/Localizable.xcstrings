    "vouch.list.intro.message": {
      "comment": "A number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تزكّي شخصًا، يستطيع النشر للعالم لمدة %@ يومًا واسمك مقرون باسمه، ريثما يوثّق هويته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ভাউচ করলে, আপনার নাম করা ব্যক্তি নিজের পরিচয় ভেরিফাই করার সময় আপনার নামসহ %@ দিন আন্তর্জাতিকভাবে পোস্ট করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan avales, la persona que anomenes pot publicar internacionalment durant %@ dies amb el teu nom al seu costat, mentre verifica la seva pròpia identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když ručíš, osoba, kterou uvedeš, může %@ dní psát mezinárodně s tvým jménem vedle svého, zatímco ověřuje vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du går i god for nogen, kan den person, du nævner, slå op internationalt i %@ dage med dit navn på sit, mens vedkommende verificerer sin egen identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bürgst, kann die von dir genannte Person %@ Tage lang mit deinem Namen hinter dem eigenen international posten, während sie die eigene Identität verifiziert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν εγγυάσαι, το άτομο που ονομάζεις μπορεί να δημοσιεύει διεθνώς για %@ ημέρες με το όνομά σου δίπλα στο δικό του, όσο επαληθεύει την ταυτότητά του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you vouch, the person you name can post internationally for %@ days with your name on theirs, while they verify their own identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando avalas, la persona que nombras puede publicar a nivel internacional durante %@ días con tu nombre junto al suyo, mientras verifica su propia identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun takaat, nimeämäsi henkilö voi julkaista kansainvälisesti %@ päivää nimesi ollessa hänen nimensä vieressä, kun hän vahvistaa oman henkilöllisyytensä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous vous portez garant, la personne que vous nommez peut publier à l’international pendant %@ jours avec votre nom à côté du sien, le temps qu’elle vérifie sa propre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאתה ערב, האדם שציינת יכול לפרסם בינלאומית במשך %@ ימים עם שמך על שמו, בזמן שהוא מאמת את זהותו בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप वाउच करते हैं, तो आपका बताया व्यक्ति अपनी पहचान खुद सत्यापित करने के दौरान आपके नाम के साथ %@ दिन तक अंतरराष्ट्रीय स्तर पर पोस्ट कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad jamčiš, osoba koju imenuješ može objavljivati međunarodno %@ dana s tvojim imenom uz svoje, dok potvrđuje svoj identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor kezeskedsz, a megnevezett személy %@ napig írhat nemzetközileg a te neveddel a sajátja mellett, amíg hitelesíti a saját személyazonosságát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu menjamin, orang yang kamu sebut bisa memposting secara internasional selama %@ hari dengan namamu di samping namanya, selagi ia memverifikasi identitasnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando garantisci, la persona che indichi può pubblicare a livello internazionale per %@ giorni con il tuo nome accanto al suo, mentre verifica la propria identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証すると、あなたが指名した人は、本人確認を進める間、あなたの名前が添えられた状態で%@日間、国際的に投稿できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증하면 지정한 사람이 직접 신원을 인증하는 동안 %@일 동안 내 이름을 걸고 국제 게시를 할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വൗച്ച് ചെയ്യുമ്പോൾ, നിങ്ങൾ പേര് പറയുന്ന വ്യക്തിക്ക് സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുന്നതിനിടെ നിങ്ങളുടെ പേരോടൊപ്പം %@ ദിവസം അന്താരാഷ്ട്രതലത്തിൽ പോസ്റ്റ് ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menjamin, orang yang anda namakan boleh menyiar secara antarabangsa selama %@ hari dengan nama anda pada namanya, semasa dia mengesahkan identitinya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du garanterer, kan personen du nevner, publisere internasjonalt i %@ dager med navnet ditt på sitt, mens de verifiserer sin egen identitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je instaat voor iemand, kan die persoon %@ dagen internationaal posten met jouw naam op de zijne of hare, terwijl diegene de eigen identiteit verifieert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy poręczasz, wskazana osoba może publikować międzynarodowo przez %@ dni z Twoim imieniem obok swojego, dopóki nie zweryfikuje własnej tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você avaliza, a pessoa que você indicar pode postar internacionalmente por %@ dias com o seu nome junto ao dela, enquanto verifica a própria identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dá um aval, a pessoa que indicar pode publicar internacionalmente durante %@ dias com o seu nome associado ao dela, enquanto verifica a própria identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când garantezi, persoana numită poate posta internațional timp de %@ zile cu numele tău lângă al ei, cât timp își verifică propria identitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы поручаетесь, названный вами человек может публиковать международные посты в течение %@ дней с вашим именем рядом со своим, пока проходит собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď ručíš, osoba, ktorú uvedieš, môže %@ dní zverejňovať príspevky medzinárodne s tvojím menom pri svojom, kým si overuje vlastnú totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du intygar kan personen du nämner publicera internationellt i %@ dagar med ditt namn på sitt, medan de verifierar sin egen identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உறுதியளிக்கும்போது, நீங்கள் குறிப்பிடும் நபர் தன் அடையாளத்தைச் சரிபார்க்கும் வரை, உங்கள் பெயருடன் %@ நாட்களுக்கு சர்வதேச அளவில் இடுகையிடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు హామీ ఇచ్చినప్పుడు, మీరు పేర్కొన్న వ్యక్తి తమ గుర్తింపును ధృవీకరించుకునే వరకు, మీ పేరుతో %@ రోజులు అంతర్జాతీయంగా పోస్ట్ చేయగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณรับรอง คนที่คุณระบุจะโพสต์ระดับนานาชาติได้ %@ วันโดยมีชื่อของคุณกำกับ ระหว่างที่เขายืนยันตัวตนของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olduğunuzda, adını verdiğiniz kişi kendi kimliğini doğrularken, sizin adınız kendi adının yanında %@ gün boyunca uluslararası gönderi paylaşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви ручаєтеся, названа вами людина може публікувати на міжнародному рівні протягом %@ днів з вашим іменем поруч зі своїм, поки верифікує власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ ضمانت دیتے ہیں تو آپ کا نام لیا ہوا شخص آپ کے نام کے ساتھ %@ دن تک بین الاقوامی سطح پر پوسٹ کر سکتا ہے، جب تک وہ اپنی شناخت کی تصدیق کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn bảo chứng, người bạn nêu tên có thể đăng bài quốc tế trong %@ ngày với tên của bạn gắn trên tên họ, trong lúc họ tự xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你担保某人后，你指定的这个人可以在 %@ 天内发布国际帖子，名字旁带有你的名字，期间他们可以验证自己的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你擔保時，你指名的人可以在 %@ 天內以你的名義背書進行國際發文，期間他們可驗證自己的身分。"
          }
        }
      }
    },
    "vouch.list.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قف خلف شخص تعرفه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিচিত কারও পাশে দাঁড়ান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon per algú que coneixes"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postav se za někoho, koho znáš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå inde for en, du kender"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jemanden einstehen, den du kennst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στήριξε κάποιον που γνωρίζεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand behind someone you know"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respalda a alguien que conoces"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaa tuntemasi ihminen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutenez quelqu’un que vous connaissez"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמוד מאחורי מישהו שאתה מכיר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी जानने वाले के पीछे खड़े हों"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stani iza nekoga koga poznaješ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeskedj valakiért, akit ismersz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di belakang orang yang kamu kenal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantisci per qualcuno che conosci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っている人の後ろ盾になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 사람을 보증하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
