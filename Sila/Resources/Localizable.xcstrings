            "state": "translated",
            "value": "That post is no longer available."
          }
        }
      }
    },
    "error.queryTooShort": {
      "comment": "The search query is under the minimum length. The count is the minimum.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب %lld أحرف على الأقل للبحث."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب %lld حرفًا على الأقل للبحث."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب حرفًا واحدًا على الأقل للبحث."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب %lld حرف على الأقل للبحث."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب حرفين على الأقل للبحث."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتب شيئًا للبحث."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type at least %lld character to search."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type at least %lld characters to search."
                }
              }
            }
          }
        }
      }
    },
    "error.rateLimited": {
      "comment": "The caller is being throttled by the server.",
