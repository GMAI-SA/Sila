        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre subito la stanza e ti ci porta dentro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームをすぐに開き、中に入ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 룸을 열고 입장해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം ഇപ്പോൾ തുറന്ന് നിങ്ങളെ അതിലേക്ക് കൊണ്ടുപോകുന്നു"
