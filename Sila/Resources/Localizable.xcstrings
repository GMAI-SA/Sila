    "vouch.error.inviteClosed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتطابق البيانات ثلاث مرات، فأُغلق هذا الرابط. اطلب رابطًا جديدًا."
