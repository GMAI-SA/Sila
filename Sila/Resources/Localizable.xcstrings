    "rooms.link.listen.hint": {
      "comment": "VoiceOver hint for Listen on a linked room's card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ الاستماع إلى الغرفة دون حساب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট ছাড়াই রুম শোনা শুরু করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença a escoltar la sala sense compte"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne poslouchat místnost bez účtu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynder at lytte til rummet uden en konto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört dem Raum ohne Konto zu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχίζει να ακούει την αίθουσα χωρίς λογαριασμό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts listening to the room without an account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a escuchar la sala sin cuenta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkaa kuunnella huonetta ilman tiliä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à écouter le salon sans compte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחיל להאזין לחדר בלי חשבון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना अकाउंट के रूम सुनना शुरू करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počinje slušati sobu bez računa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiók nélkül elkezdi hallgatni a szobát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai mendengarkan room tanpa akun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia ad ascoltare la stanza senza un account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしでルームを聴き始めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 룸 듣기를 시작해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ട് ഇല്ലാതെ റൂം കേൾക്കാൻ തുടങ്ങുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula mendengar bilik tanpa akaun"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynner å lytte til rommet uten konto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begint zonder account naar de room te luisteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna słuchać pokoju bez konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a ouvir a sala sem conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a ouvir a sala sem conta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe să asculți camera fără cont"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинает слушать комнату без аккаунта"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne počúvať miestnosť bez účtu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar lyssna på rummet utan konto"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு இல்லாமல் அறையைக் கேட்கத் தொடங்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా లేకుండానే రూమ్‌ను వినడం ప్రారంభిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มฟังห้องโดยไม่ต้องมีบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap olmadan odayı dinlemeye başlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починає слухати кімнату без облікового запису"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ کے بغیر روم سننا شروع کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu nghe phòng mà không cần tài khoản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户即可开始收听房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需帳號即可開始收聽聊天室"
          }
        }
      }
    },
    "rooms.link.listen.note": {
      "comment": "Under a linked room's card, signed out: why nothing has happened yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبدأ الاستماع بعد. اضغط «استمع» لتسمع الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও শুনছেন না। রুম শুনতে শুনুন-এ ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no estàs escoltant. Toca Escolta per sentir la sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím neposloucháš. Klepnutím na Poslouchat místnost uslyšíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter ikke endnu. Tryk på Lyt for at høre rummet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst noch nicht zu. Tippe auf Zuhören, um den Raum zu hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ακούς ακόμα. Πάτησε Ακρόαση για να ακούσεις την αίθουσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You aren't listening yet. Tap Listen to hear the room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no estás escuchando. Toca Escuchar para oír la sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et vielä kuuntele. Napauta Kuuntele kuullaksesi huoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’écoutez pas encore. Touchez Écouter pour entendre le salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה עדיין לא מאזין. הקש על האזן כדי לשמוע את החדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी सुन नहीं रहे। रूम सुनने के लिए \"सुनें\" टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ne slušaš. Dodirni Slušaj da čuješ sobu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem hallgatsz. Koppints a Hallgatás gombra a szoba meghallgatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum mendengarkan. Ketuk Dengarkan untuk mendengar room."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non stai ancora ascoltando. Tocca Ascolta per sentire la stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ聴いていません。「聴く」をタップするとルームが聞こえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 듣고 있지 않아요. 듣기를 탭하면 룸을 들을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ കേൾക്കുന്നില്ല. റൂം കേൾക്കാൻ കേൾക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum mendengar. Ketik Dengar untuk mendengar bilik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter ikke ennå. Trykk på Lytt for å høre rommet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je luistert nog niet. Tik op Luisteren om de room te horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie słuchasz. Stuknij Słuchaj, aby usłyszeć pokój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não está ouvindo. Toque em Ouvir para escutar a sala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não está a ouvir. Toque em Ouvir para ouvir a sala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu asculți. Atinge Ascultă ca să auzi camera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ещё не слушаете. Нажмите «Слушать», чтобы услышать комнату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ešte nepočúvaš. Ťuknutím na Počúvať miestnosť začuješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lyssnar inte än. Tryck på Lyssna för att höra rummet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இன்னும் கேட்கவில்லை. அறையைக் கேட்க கேள் என்பதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా వినడం లేదు. రూమ్ వినడానికి వినండి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้ฟัง แตะฟังเพื่อฟังห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz dinlemiyorsunuz. Odayı duymak için Dinle'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ще не слухаєте. Торкніться «Слухати», щоб почути кімнату."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ابھی نہیں سن رہے۔ روم سننے کے لیے سنیں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa đang nghe. Chạm Nghe để nghe phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有在收听。轻点“收听”即可听到房间内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未開始收聽。點「收聽」即可聽到聊天室。"
          }
        }
      }
    },
