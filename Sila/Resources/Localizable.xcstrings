        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovania, páči sa mi, zdieľania ďalej, odpovede a spomenutia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följare, gillningar, delningar, svar och omnämnanden"
