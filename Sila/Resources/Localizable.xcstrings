    "preferences.topicFilter.noOpinion.hint": {
      "comment": "VoiceOver hint for the No-opinion topic filter.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المواضيع التي لا رأي لك فيها فقط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু যে বিষয়ে আপনার কোনো মত নেই তা দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra només els temes sobre els quals no tens opinió"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí jen témata, k nimž nemáš názor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kun emner, du ikke har nogen holdning til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt nur Themen, zu denen du keine Meinung hast"
