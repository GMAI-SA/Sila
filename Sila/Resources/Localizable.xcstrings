    "search.trending.section.a11yLabel": {
      "comment": "VoiceOver label for the trending section. Says what the ranking is counted over.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأكثر تداولًا الآن، محسوبة على المنشورات الحديثة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন ট্রেন্ডিং, সাম্প্রতিক পোস্ট জুড়ে গোনা"
          }
        },
        "ca": {
          "stringUnit": {
