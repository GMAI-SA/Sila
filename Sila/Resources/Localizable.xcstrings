    "account.password.error.tooLong": {
      "comment": "Validation on a long password. %lld is the maximum length.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تتجاوز %lld أحرف."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تتجاوز %lld حرفًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تتجاوز حرفًا واحدًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تتجاوز %lld حرف."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تتجاوز حرفين."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا يمكن أن تكون بهذا الطول."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passwords are at most %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passwords are at most %lld characters."
                }
              }
            }
          }
        }
      }
    },
    "account.password.error.tooShort": {
      "comment": "Validation on a short password. %lld is the minimum length.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تقل عن %lld أحرف."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تقل عن %lld حرفًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تقل عن حرف واحد."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تقل عن %lld حرف."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا تقل عن حرفين."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كلمة المرور لا يمكن أن تكون فارغة."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passwords are at least %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passwords are at least %lld characters."
                }
              }
            }
          }
        }
      }
    },
    "account.password.intro": {
      "comment": "Says the sign-out is the point, not a side effect.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير كلمة المرور يسجّل الخروج من كل الأجهزة — وهذا الجهاز منها. وهذا هو المقصود: تغيير كلمة المرور هو ما تفعله عندما تشك أن جلسة ما ليست لك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your password signs every device out — this one included. That is the point: a password change is what you do when you think a session isn't yours."
          }
        }
      }
    },
    "account.password.new.hint": {
      "comment": "VoiceOver hint for the new-password field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور التي تريدها من الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password you want from now on"
          }
        }
      }
    },
    "account.password.new.label": {
      "comment": "Label above the new-password field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الجديدة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New password"
          }
        }
      }
    },
    "account.password.new.placeholder": {
      "comment": "Placeholder in the new-password field. %lld is the minimum length.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا تقل عن %lld أحرف"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا تقل عن %lld حرفًا"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "حرف واحد على الأقل"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا تقل عن %lld حرف"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "حرفان على الأقل"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يقل عن %lld حرف"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "At least %lld character"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "At least %lld characters"
                }
              }
            }
          }
        }
      }
    },
    "account.password.outcome": {
      "comment": "What a password change did, including to this device.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت كلمة مرورك. وسُجّل الخروج من كل الأجهزة — بما فيها هذا الجهاز، الذي سيطلب كلمة مرورك الجديدة عند تحديث الجلسة القادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is changed. Every signed-in device was signed out — including this one, which will ask for your new password the next time it refreshes the session."
          }
        }
      }
    },
    "account.password.repeat.hint": {
      "comment": "VoiceOver hint for the repeat-password field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب مرتين حتى لا يقفل عليك خطأ مطبعي حسابك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed twice so a slip does not lock you out"
          }
        }
      }
    },
    "account.password.repeat.label": {
      "comment": "Label above the repeat-password field.",
      "extractionState": "manual",
      "localizations": {
