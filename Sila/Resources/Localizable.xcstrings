    "safety.appeal.send.hint": {
      "comment": "VoiceOver hint for the send-appeal button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل تظلّمك إلى مراجع من البشر. ولك تظلّم واحد لكل إيقاف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আপিল একজন মানুষ রিভিউয়ারের কাছে পাঠায়। প্রতি স্থগিতাদেশে একটি পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia la teva apel·lació a un revisor humà. En tens una per suspensió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle tvé odvolání lidskému posuzovateli. Na každé pozastavení máš jedno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender din anke til en menneskelig gennemgående. Du får én pr. suspension."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet deinen Einspruch an einen menschlichen Prüfer. Du hast einen pro Sperre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει την ένστασή σου σε ανθρώπινο ελεγκτή. Έχεις μία ανά αναστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your appeal to a human reviewer. You get one per suspension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu apelación a una persona que la revisará. Tienes una por suspensión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää valituksesi ihmistarkastajalle. Saat yhden jäädytystä kohden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie votre recours à un vérificateur humain. Vous en avez un par suspension."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את הערעור שלך לבודק אנושי. יש לך אחד לכל השעיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपील एक मानव समीक्षक को भेजता है। हर निलंबन पर आपको एक मिलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje tvoju žalbu recenzentu. Imaš jednu po suspenziji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi a fellebbezésedet egy emberi elbírálónak. Felfüggesztésenként egy van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim bandingmu ke peninjau manusia. Kamu mendapat satu per penangguhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il tuo ricorso a un revisore umano. Ne hai uno per sospensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異議を人の審査担当者に送信します。停止1回につき1回です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람 검토자에게 이의 신청을 보내요. 정지 1건당 한 번만 가능해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അപ്പീൽ ഒരു മനുഷ്യ പരിശോധകന് അയയ്ക്കുന്നു. ഒരു സസ്പെൻഷന് ഒന്ന് മാത്രം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar rayuan anda kepada penyemak manusia. Anda mendapat satu bagi setiap penggantungan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender anken din til en menneskelig vurderer. Du får én per suspensjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt je bezwaar naar een menselijke beoordelaar. Je hebt er één per schorsing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła odwołanie do recenzenta. Masz jedno na zawieszenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia sua contestação a um analista. Você tem uma por suspensão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a sua contestação a um revisor humano. Tem direito a uma por suspensão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite contestația unui evaluator uman. Ai una per suspendare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет апелляцию проверяющему-человеку. На одну блокировку — одна апелляция."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odošle tvoje odvolanie ľudskému posudzovateľovi. Na pozastavenie máš jedno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar ditt överklagande till en mänsklig granskare. Du får ett per avstängning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மேல்முறையீட்டை ஒரு மனித மதிப்பாய்வாளருக்கு அனுப்பும். ஒரு இடைநிறுத்தத்துக்கு ஒன்று மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అప్పీల్‌ను మనిషి సమీక్షకుడికి పంపుతుంది. ప్రతి సస్పెన్షన్‌కు ఒకటే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำอุทธรณ์ของคุณให้ผู้ตรวจสอบที่เป็นคน คุณมีได้หนึ่งครั้งต่อการระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtirazınızı bir insan inceleyiciye gönderir. Askıya alma başına bir hakkınız var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає вашу апеляцію живому перевіряльнику. На кожне призупинення — одна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپیل ایک انسانی جائزہ لینے والے کو بھیجتا ہے۔ ہر معطلی پر ایک ملتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi khiếu nại của bạn đến một người xét duyệt. Bạn có một lần cho mỗi lần đình chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的申诉发送给真人审核员。每次封禁只有一次机会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的申訴送交真人審核人員。每次停權只有一次機會。"
          }
        }
      }
    },
