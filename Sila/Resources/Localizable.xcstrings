    "feed.empty.international.subtitle": {
      "comment": "Empty International feed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا السلاسل المفتوحة للحسابات الموثّقة حول العالم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্বজুড়ে ভেরিফায়েড অ্যাকাউন্টদের জন্য খোলা থ্রেড এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí apareixeran els fils oberts als comptes verificats de tot el món."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se objeví vlákna otevřená ověřeným účtům po celém světě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tråde, der er åbne for verificerede konti verden over, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Threads, die für verifizierte Konten weltweit offen sind, erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νήματα ανοιχτά σε επαληθευμένους λογαριασμούς παγκοσμίως θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threads open to verified accounts worldwide will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecerán los hilos abiertos a cuentas verificadas de todo el mundo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkialla maailmassa vahvistetuille tileille avoimet ketjut näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions ouvertes aux comptes vérifiés du monde entier apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרשורים הפתוחים לחשבונות מאומתים בכל העולם יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया भर के सत्यापित अकाउंट के लिए खुले थ्रेड यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se pojaviti niti otvorene potvrđenim računima diljem svijeta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg a világszerte hitelesített fiókok előtt nyitott szálak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas yang terbuka untuk akun terverifikasi di seluruh dunia akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compariranno le discussioni aperte agli account verificati di tutto il mondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界中の認証済みアカウントに開かれたスレッドが、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계 인증된 계정에 열려 있는 스레드가 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോകമെമ്പാടുമുള്ള പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് തുറന്ന ത്രെഡുകൾ ഇവിടെ വരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas yang terbuka kepada akaun yang disahkan di seluruh dunia akan muncul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tråder åpne for verifiserte kontoer over hele verden vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threads die openstaan voor geverifieerde accounts wereldwijd verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się wątki otwarte dla zweryfikowanych kont na całym świecie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fios abertos a contas verificadas do mundo todo aparecerão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas abertas a contas verificadas de todo o mundo aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversațiile deschise conturilor verificate din toată lumea vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся обсуждения, открытые для проверенных аккаунтов по всему миру."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlákna otvorené pre overené účty z celého sveta sa zobrazia tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trådar som är öppna för verifierade konton över hela världen visas här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலகெங்கும் உள்ள சரிபார்க்கப்பட்ட கணக்குகளுக்குத் திறந்த உரையாடல்கள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రపంచవ్యాప్తంగా ధృవీకరించబడిన ఖాతాలకు తెరిచి ఉన్న థ్రెడ్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เธรดที่เปิดให้บัญชีที่ยืนยันตัวตนแล้วทั่วโลกจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya genelinde doğrulanmış hesaplara açık konuşmalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являтимуться обговорення, відкриті для верифікованих облікових записів з усього світу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دنیا بھر کے تصدیق شدہ اکاؤنٹس کے لیے کھلے تھریڈز یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chuỗi mở cho tài khoản đã xác minh trên toàn thế giới sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向全球已验证账户开放的对话串会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開放給全球已驗證帳號的串文會顯示在這裡。"
          }
        }
      }
    },
