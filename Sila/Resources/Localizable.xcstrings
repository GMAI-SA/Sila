        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These details don't match what the person who sent the link entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos no coinciden con lo que introdujo quien envió el enlace."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä tiedot eivät täsmää siihen, mitä linkin lähettänyt antoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations ne correspondent pas à ce qu’a saisi la personne qui a envoyé le lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרטים האלה לא תואמים למה שהאדם ששלח את הקישור הזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विवरण लिंक भेजने वाले के दर्ज किए विवरण से मेल नहीं खाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti se podaci ne podudaraju s onim što je unijela osoba koja je poslala poveznicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek az adatok nem egyeznek azzal, amit a hivatkozás küldője megadott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail ini tidak cocok dengan yang dimasukkan orang yang mengirim tautan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dati non corrispondono a ciò che ha inserito la persona che ha inviato il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの詳細が、リンクを送った人が入力した内容と一致しません。"
