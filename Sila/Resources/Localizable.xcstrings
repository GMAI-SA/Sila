    "vouch.limited.rooms": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستمع. وثّق هويتك لتتحدث أو تدردش أو تطرح سؤالًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি শুনছেন। মাইক্রোফোন নিতে, চ্যাট করতে বা প্রশ্ন করতে আপনার পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estàs escoltant. Verifica la teva identitat per agafar el micròfon, xatejar o fer una pregunta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posloucháš. Pro mikrofon, chat nebo otázku ověř svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter. Verificér din identitet for at tage mikrofonen, chatte eller stille et spørgsmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst zu. Verifiziere deine Identität, um das Mikrofon zu nehmen, zu chatten oder eine Frage zu stellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούς. Επαλήθευσε την ταυτότητά σου για να πάρεις το μικρόφωνο, να συνομιλήσεις ή να κάνεις ερώτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're listening. Verify your identity to take the microphone, chat or ask a question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás escuchando. Verifica tu identidad para tomar el micrófono, chatear o hacer una pregunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelet. Vahvista henkilöllisyytesi ottaaksesi mikrofonin, keskustellaksesi tai esittääksesi kysymyksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous écoutez. Vérifiez votre identité pour prendre le micro, discuter ou poser une question."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מאזין. אמת את זהותך כדי לקחת את המיקרופון, לשוחח או לשאול שאלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सुन रहे हैं। माइक्रोफ़ोन लेने, चैट करने या सवाल पूछने के लिए अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slušaš. Potvrdi svoj identitet da uzmeš mikrofon, čavrljaš ili postaviš pitanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallgatsz. A mikrofon használatához, csevegéshez vagy kérdezéshez hitelesítsd a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mendengarkan. Verifikasi identitasmu untuk memegang mikrofon, mengobrol, atau bertanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai ascoltando. Verifica la tua identità per prendere il microfono, chattare o fare una domanda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴くことができます。マイクを使う、チャットする、質問するには、本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣는 중이에요. 마이크를 잡거나 채팅 또는 질문을 하려면 신원을 인증하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കേൾക്കുകയാണ്. മൈക്രോഫോൺ എടുക്കാനോ ചാറ്റ് ചെയ്യാനോ ചോദ്യം ചോദിക്കാനോ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang mendengar. Sahkan identiti anda untuk mengambil mikrofon, berbual atau bertanya soalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter. Verifiser identiteten din for å ta mikrofonen, chatte eller stille et spørsmål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je luistert. Verifieer je identiteit om de microfoon te nemen, te chatten of een vraag te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchasz. Zweryfikuj tożsamość, aby zabrać mikrofon, czatować lub zadać pytanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está ouvindo. Verifique sua identidade para usar o microfone, conversar ou fazer uma pergunta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a ouvir. Verifique a sua identidade para usar o microfone, conversar ou fazer uma pergunta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asculți. Verifică-ți identitatea pentru a lua microfonul, a scrie în chat sau a pune o întrebare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы слушаете. Пройдите проверку личности, чтобы взять микрофон, писать в чат или задавать вопросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počúvaš. Ak chceš hovoriť, chatovať alebo sa pýtať, over svoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lyssnar. Verifiera din identitet för att ta mikrofonen, chatta eller ställa en fråga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கேட்கிறீர்கள். மைக்ரோஃபோனை எடுக்க, அரட்டையடிக்க அல்லது கேள்வி கேட்க உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వింటున్నారు. మైక్రోఫోన్ తీసుకోవడానికి, చాట్ చేయడానికి లేదా ప్రశ్న అడగడానికి మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกำลังฟังอยู่ ยืนยันตัวตนเพื่อใช้ไมโครโฟน แชต หรือถามคำถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinliyorsunuz. Mikrofonu almak, sohbet etmek veya soru sormak için kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви слухаєте. Верифікуйте особу, щоб узяти мікрофон, писати в чат чи ставити запитання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سن رہے ہیں۔ مائیکروفون لینے، چیٹ کرنے یا سوال پوچھنے کے لیے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang nghe. Hãy xác minh danh tính để dùng micro, trò chuyện hoặc đặt câu hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在收听。验证身份后才能使用麦克风、聊天或提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在收聽。驗證你的身分才能使用麥克風、聊天或提問。"
          }
        }
      }
    },
