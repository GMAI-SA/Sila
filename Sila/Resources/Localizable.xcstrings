    "app.offline.banner": {
      "comment": "Strip across the top when the app opened on this device's copy of the account because the server could not be reached (no connection, or the server failing). It goes by itself once the server answers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى «معروف» الآن، لذا قد لا يكون ما تراه محدّثًا. سيعيد الاتصال تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন Known-এর সাথে সংযোগ করা যাচ্ছে না, তাই এটি পুরোনো হতে পারে। নিজে থেকেই আবার সংযুক্ত হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix no es pot arribar a Known, així que això pot estar desactualitzat. Es tornarà a connectar sol."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known teď není dostupná, takže údaje mohou být zastaralé. Připojí se sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå Known lige nu, så dette kan være forældet. Forbindelsen genoprettes af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ist gerade nicht erreichbar, daher ist dies möglicherweise veraltet. Die Verbindung wird automatisch wiederhergestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η σύνδεση με το Known αυτή τη στιγμή, οπότε αυτό μπορεί να μην είναι ενημερωμένο. Θα επανασυνδεθεί αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach Known right now, so this may be out of date. It will reconnect by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con Known ahora, así que esto puede estar desactualizado. Se reconectará solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowniin ei saada yhteyttä juuri nyt, joten tiedot voivat olla vanhentuneita. Yhteys palaa itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Known pour le moment, ces informations peuvent donc être périmées. La reconnexion se fera automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להתחבר ל-Known כרגע, ולכן ייתכן שהמידע לא עדכני. החיבור יתחדש מעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी Known तक नहीं पहुँच पा रहे, इसलिए यह पुराना हो सकता है। यह अपने-आप दोबारा जुड़ जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known trenutačno nije dostupna pa ovo može biti zastarjelo. Povezat će se sama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known jelenleg nem érhető el, ezért ez az információ elavult lehet. Magától újra csatlakozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tidak bisa dijangkau saat ini, jadi ini mungkin sudah usang. Akan tersambung kembali dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non riesco a raggiungere Known, quindi i contenuti potrebbero non essere aggiornati. La connessione si ripristinerà da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在Knownに接続できないため、表示が古い可能性があります。自動的に再接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Known에 연결할 수 없어 최신 내용이 아닐 수 있어요. 자동으로 다시 연결돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ Known-മായി ബന്ധപ്പെടാനാകുന്നില്ല, അതിനാൽ ഇത് പഴയതാകാം. ഇത് സ്വയം വീണ്ടും കണക്ട് ചെയ്യും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi Known sekarang, jadi ini mungkin sudah lapuk. Ia akan bersambung semula dengan sendirinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Får ikke kontakt med Known akkurat nå, så dette kan være utdatert. Appen kobler til igjen av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known is nu niet bereikbaar, dus dit kan verouderd zijn. De verbinding wordt vanzelf hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz połączyć się z Known, więc te dane mogą być nieaktualne. Połączenie zostanie nawiązane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o Known agora, então isto pode estar desatualizado. A reconexão será automática."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ligar à Known neste momento, por isso isto pode estar desatualizado. Voltará a ligar-se automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mă pot conecta la Known acum, deci informațiile pot fi vechi. Se va reconecta singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет связи с Known, поэтому данные могут быть устаревшими. Подключение восстановится само."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known sa momentálne nedá dosiahnuť, takže údaje môžu byť neaktuálne. Pripojí sa sama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known kan inte nås just nu, så det här kan vara inaktuellt. Anslutningen återupptas av sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது Known-ஐ அடைய முடியவில்லை, எனவே இது பழையதாக இருக்கலாம். தானாகவே மீண்டும் இணையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు Knownను చేరుకోలేకపోతున్నాం, కాబట్టి ఇది పాతదై ఉండవచ్చు. ఇది దానంతట అదే మళ్లీ కనెక్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เชื่อมต่อ Known ไม่ได้ ข้อมูลนี้อาจไม่ใช่ล่าสุด แอปจะเชื่อมต่อใหม่เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda Known'a ulaşılamıyor, bu yüzden bu bilgi güncel olmayabilir. Kendiliğinden yeniden bağlanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі не вдається зʼєднатися із Known, тож дані можуть бути застарілими. Зʼєднання відновиться саме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی Known تک رسائی نہیں ہو رہی، اس لیے یہ پرانا ہو سکتا ہے۔ یہ خود دوبارہ جڑ جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không kết nối được với Known nên nội dung có thể đã cũ. Ứng dụng sẽ tự kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法连接 Known，所以内容可能不是最新的。它会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連線到 Known，內容可能不是最新的。稍後會自動重新連線。"
          }
        }
      }
    },
