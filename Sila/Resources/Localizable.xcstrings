    "auth.otp.digit.hint": {
      "comment": "VoiceOver hint for one box of the code field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رقمًا واحدًا من رمز التأكيد المرسل إلى بريدك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেইলে পাওয়া নিশ্চিতকরণ কোডের একটি সংখ্যা লিখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix un dígit del codi de confirmació que has rebut per correu"
