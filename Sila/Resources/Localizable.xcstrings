            "value": "@%@ heeft niet op tijd bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nie potwierdził(a) na czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não confirmou a tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ não confirmou a tempo."
          }
        },
        "ro": {
