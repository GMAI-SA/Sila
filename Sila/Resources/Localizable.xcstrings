    "discover.needsReply.cta": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ردود بعد — كن أول من يرد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো উত্তর নেই — প্রথম হোন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha respostes: sigues el primer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím bez odpovědí – buď první"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen svar endnu – vær den første"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Antworten – sei die erste"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία απάντηση ακόμα — γίνε ο πρώτος"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No replies yet — be the first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin respuestas: sé el primero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä vastauksia – ole ensimmäinen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse pour l’instant — soyez le premier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תגובות עדיין — היה הראשון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई जवाब नहीं — पहले आप दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema odgovora — budi prvi/a"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs válasz – légy te az első"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada balasan — jadilah yang pertama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna risposta: sii il primo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ返信なし。最初に返信しよう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 답글이 없어요. 첫 답글을 남겨 보세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ മറുപടികളില്ല — ആദ്യത്തെയാളാകൂ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada balasan — jadilah yang pertama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen svar ennå. Bli den første"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen reacties: wees de eerste"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odpowiedzi — bądź pierwszy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem respostas ainda: seja o primeiro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem respostas — seja o primeiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă niciun răspuns — fii primul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответов пока нет — станьте первым"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne odpovede — buď prvý"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga svar än – bli först"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் பதில் இல்லை — முதலில் பதிலளியுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా రిప్లైలు లేవు — మొదట మీరే ఇవ్వండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีคนตอบ เป็นคนแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yanıt yok; ilk siz olun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідей ще немає — будьте першим"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی جواب نہیں — پہلے آپ دیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trả lời — hãy là người đầu tiên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有回复，来做第一个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有回覆，搶先回覆吧"
