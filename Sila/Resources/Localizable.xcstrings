    "notifications.kind.communityAccepted.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين يقبلك مجتمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো কমিউনিটি আপনাকে ঢুকতে দিলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan una comunitat et deixa entrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tě komunita vpustí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et fællesskab lukker dig ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Community dich aufnimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μια κοινότητα σε δέχεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a community lets you in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una comunidad te admite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun yhteisö päästää sinut sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une communauté vous accepte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשקהילה מקבלת אותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई कम्युनिटी आपको अंदर आने दे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad te zajednica primi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy közösség beenged."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sebuah komunitas menerimamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una community ti accoglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティへの参加が承認されたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티가 가입을 승인했을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു കമ്മ്യൂണിറ്റി നിങ്ങളെ ചേർക്കുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila sebuah komuniti membenarkan anda masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et fellesskap slipper deg inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een community je toelaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy społeczność Cię przyjmie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma comunidade aceita você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma comunidade o aceita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când o comunitate te primește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда сообщество принимает вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď ťa komunita prijme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en community släpper in dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சமூகம் உங்களை உள்ளே சேர்க்கும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక కమ్యూనిటీ మిమ్మల్ని లోపలికి అనుమతించినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
