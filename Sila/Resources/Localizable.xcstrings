          "stringUnit": {
            "state": "translated",
            "value": "Không tải được phần bảo chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "担保未能加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擔保未能載入"
          }
        }
      }
    },
    "vouch.list.gone": {
