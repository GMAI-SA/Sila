    "notifications.kind.repost.detail": {
      "comment": "What the repost switch governs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة شخص نشر منشورك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার পোস্ট রিপোস্ট করলে।"
