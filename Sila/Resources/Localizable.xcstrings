          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva les meves fotos del document i el selfie al meu fitxer de verificació mentre existeixi el meu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechat fotografie mého dokladu a selfie v mém ověřovacím souboru, dokud můj účet existuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold mine id-fotos og selfie i min verificeringsfil, så længe min konto findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Ausweisfotos und mein Selfie in meiner Verifizierungsakte aufbewahren, solange mein Konto besteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να διατηρηθούν οι φωτογραφίες της ταυτότητάς μου και η selfie στον φάκελο επαλήθευσής μου όσο υπάρχει ο λογαριασμός μου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep my ID photos and selfie in my verification file while my account exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar las fotos de mi documento y mi selfie en mi expediente de verificación mientras exista mi cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä henkilöllisyystodistuksen kuvat ja selfie vahvistustiedostossani niin kauan kuin tilini on olemassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver mes photos d’identité et mon selfie dans mon dossier de vérification tant que mon compte existe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את תמונות תעודת הזהות והסלפי שלי בתיק האימות שלי כל עוד החשבון שלי קיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक मेरा अकाउंट है, मेरी ID की फ़ोटो और सेल्फ़ी मेरी सत्यापन फ़ाइल में रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadrži moje fotografije osobne i selfie u mojoj datoteci za provjeru dok moj račun postoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Őrizzék meg az azonosítóm fotóit és a szelfimet a hitelesítési aktámban, amíg a fiókom létezik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan foto ID dan selfie-ku di berkas verifikasiku selama akunku ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva le foto del mio documento e il selfie nel mio fascicolo di verifica finché il mio account esiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントがある間、ID写真と自撮りを認証ファイルに保管する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 존재하는 동안 신분증 사진과 셀카를 인증 파일에 보관합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ അക്കൗണ്ട് നിലവിലുള്ളിടത്തോളം എന്റെ ഐഡി ഫോട്ടോകളും സെൽഫിയും എന്റെ പരിശോധനാ ഫയലിൽ സൂക്ഷിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan foto ID dan swafoto saya dalam fail pengesahan saya selagi akaun saya wujud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold ID-bildene og selfien min i verifiseringsmappen min så lenge kontoen min finnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar mijn identiteitsfoto's en selfie in mijn verificatiedossier zolang mijn account bestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj moje zdjęcia dokumentu i selfie w mojej teczce weryfikacyjnej, dopóki istnieje moje konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as fotos do meu documento e a selfie no meu arquivo de verificação enquanto minha conta existir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as fotos do meu documento e a selfie no meu ficheiro de verificação enquanto a minha conta existir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează fotografiile actului și selfie-ul în dosarul meu de verificare cât timp există contul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранить фото документа и селфи в моём файле проверки, пока существует мой аккаунт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovať moje fotky dokladu a selfie v mojom overovacom spise, kým môj účet existuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll mina id-bilder och min selfie i min verifieringsfil så länge mitt konto finns."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் கணக்கு இருக்கும் வரை என் அடையாளப் புகைப்படங்களையும் செல்ஃபியையும் என் சரிபார்ப்புக் கோப்பில் வைத்திரு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా ఖాతా ఉన్నంత కాలం నా ID ఫోటోలను, సెల్ఫీని నా ధృవీకరణ ఫైల్‌లో ఉంచు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บรูปบัตรและเซลฟีของฉันไว้ในแฟ้มยืนยันตัวตนตราบเท่าที่บัญชีของฉันยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabım var olduğu sürece kimlik fotoğraflarımı ve selfie'mi doğrulama dosyamda sakla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати фото мого документа та селфі у файлі верифікації, поки існує мій обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک میرا اکاؤنٹ موجود ہے، میرے شناختی کارڈ کی تصاویر اور سیلفی میری تصدیقی فائل میں رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ ảnh giấy tờ và ảnh selfie của tôi trong hồ sơ xác minh khi tài khoản của tôi còn tồn tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的账户存续期间，将我的证件照片和自拍保存在验证档案中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的帳號存在期間，將我的證件照片和自拍保留在我的驗證檔案中。"
          }
        }
      }
    },
