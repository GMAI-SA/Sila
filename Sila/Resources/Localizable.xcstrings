    "notifications.kind.vouch.voucher.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن الأشخاص الذين تزكّيهم والروابط التي ترسلها."
