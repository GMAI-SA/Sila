    "communities.join.open.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطة واحدة وينضم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক ট্যাপেই তারা ভেতরে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toc i ja són dins."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klepnutí a jsou uvnitř."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk, og de er med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen, und sie sind dabei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πάτημα και μπαίνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap and they are in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque y están dentro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus ja he ovat sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui et ils sont dedans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה אחת והם בפנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप और वे अंदर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan dodir i unutra su."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás, és bent vannak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali ketuk, langsung masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco e sono dentro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 바로 가입돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ടാപ്പ് മതി, അവർ അകത്ത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan dan mereka masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk, så er de inne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik en ze zijn erbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie i są w środku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque e a pessoa entra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque e entram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singur tap și sunt înăuntru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно касание — и они внутри."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno ťuknutie a sú dnu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck och de är med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தட்டலில் உள்ளே வந்துவிடுவார்கள்."
