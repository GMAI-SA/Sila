    "account.recovery.signOut.note": {
      "comment": "Says the deletion completes on its own if that is what was intended.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كنت تقصد المغادرة، فلا شيء آخر عليك فعله. الحذف يكتمل من تلقاء نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি চলে যেতে চাইলে আর কিছু করার নেই। মুছে ফেলা নিজে থেকেই শেষ হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si volies marxar, no cal fer res més. L'eliminació s'acaba per si sola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jsi chtěl odejít, nemusíš dělat nic dalšího. Smazání se dokončí samo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ville forlade Known, er der ikke mere at gøre. Sletningen gennemføres af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du gehen wolltest, musst du nichts weiter tun. Die Löschung wird von selbst abgeschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ήθελες να φύγεις, δεν χρειάζεται να κάνεις τίποτα άλλο. Η διαγραφή ολοκληρώνεται μόνη της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you meant to leave, there is nothing more to do. The deletion finishes on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si querías irte, no hay nada más que hacer. La eliminación termina sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos aioit poistua, sinun ei tarvitse tehdä enempää. Poisto valmistuu itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous souhaitiez partir, il n’y a plus rien à faire. La suppression se terminera d’elle-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם התכוונת לעזוב, אין מה לעשות יותר. המחיקה תסתיים מעצמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप जाना ही चाहते थे, तो अब कुछ करने की ज़रूरत नहीं। डिलीट अपने-आप पूरा हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako si htio/htjela otići, ne moraš ništa više napraviti. Brisanje će se završiti samo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha el akartál menni, nincs több teendőd. A törlés magától befejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu memang ingin pergi, tidak ada lagi yang perlu dilakukan. Penghapusan selesai dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volevi andartene, non devi fare altro. L'eliminazione si completa da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退会するつもりなら、これ以上の操作は不要です。削除は自動的に完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠날 생각이라면 더 할 일은 없어요. 삭제는 저절로 완료돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോകാൻ തന്നെയായിരുന്നു ഉദ്ദേശ്യമെങ്കിൽ ഇനി ഒന്നും ചെയ്യാനില്ല. ഇല്ലാതാക്കൽ സ്വയം പൂർത്തിയാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda memang mahu pergi, tiada apa-apa lagi perlu dilakukan. Pemadaman selesai dengan sendirinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du mente å slutte, er det ikke noe mer å gjøre. Slettingen fullføres av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je weg wilde gaan, hoef je niets meer te doen. De verwijdering wordt vanzelf voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli chciał(a)eś odejść, nie musisz robić nic więcej. Usunięcie zakończy się samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você quis ir embora, não há mais nada a fazer. A exclusão termina sozinha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queria sair, não há mais nada a fazer. A eliminação termina por si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ai vrut să pleci, nu mai ai nimic de făcut. Ștergerea se finalizează singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы хотели уйти, больше ничего делать не нужно. Удаление завершится само."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcel odísť, nemusíš robiť nič viac. Odstránenie sa dokončí samo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du menade att lämna behöver du inte göra något mer. Raderingen slutförs av sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் வெளியேற விரும்பினால் வேறு எதுவும் செய்ய வேண்டாம். நீக்கம் தானாகவே முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వెళ్లిపోవాలనుకుంటే, ఇంకేమీ చేయాల్సిన పనిలేదు. తొలగింపు దానంతట అదే పూర్తవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณตั้งใจจะออกไป ไม่ต้องทำอะไรเพิ่ม การลบจะเสร็จสิ้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrılmak istediyseniz yapmanız gereken başka bir şey yok. Silme işlemi kendiliğinden tamamlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви хотіли піти, більше нічого робити не потрібно. Видалення завершиться саме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ جانا ہی چاہتے تھے تو مزید کچھ کرنے کی ضرورت نہیں۔ حذف کرنے کا عمل خود مکمل ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn muốn rời đi, không cần làm gì thêm. Việc xóa sẽ tự hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你就是想离开，无需再做任何事。删除会自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你本來就想離開，就不需要再做任何事。刪除會自動完成。"
          }
        }
      }
    },
