        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుర్తింపు ధృవీకరించబడలేదు · %2$@ నుండి @%1$@ హామీ ఇచ్చారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
