    "auth.wall.rejected.message": {
      "comment": "Wall body after a rejection.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من توثيق هويتك بناءً على ما أرسلته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জমা দেওয়া তথ্য থেকে আপনার পরিচয় যাচাই করা যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut verificar la teva identitat amb el que has enviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z toho, co jsi odeslal, jsme tvou totožnost nemohli ověřit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke verificere din identitet ud fra det, du sendte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhand deiner Angaben konnten wir deine Identität nicht verifizieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να επαληθεύσουμε την ταυτότητά σου από όσα υπέβαλες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify your identity from what you submitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu identidad con lo que enviaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöllisyyttäsi ei voitu vahvistaa lähettämiesi tietojen perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier votre identité à partir de ce que vous avez envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לאמת את זהותך ממה ששלחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सबमिट किए से हम आपकी पहचान सत्यापित नहीं कर सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli potvrditi tvoj identitet na temelju onoga što si poslao/poslala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beküldött adatokból nem tudtuk hitelesíteni a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa memverifikasi identitasmu dari yang kamu kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a verificare la tua identità da quanto hai inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信された内容では、本人確認ができませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출하신 내용으로는 신원을 확인하지 못했어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സമർപ്പിച്ചതിൽ നിന്ന് നിങ്ങളുടെ ഐഡന്റിറ്റി പരിശോധിക്കാനായില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat mengesahkan identiti anda daripada apa yang anda hantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke verifisere identiteten din ut fra det du sendte inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je identiteit niet verifiëren met wat je hebt ingediend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie przesłanych danych nie udało się zweryfikować Twojej tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar sua identidade com o que você enviou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar a sua identidade com o que enviou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ți-am putut verifica identitatea din ce ai trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам не удалось подтвердить вашу личность по отправленным данным."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z toho, čo si odoslal, sa nám nepodarilo overiť tvoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte verifiera din identitet utifrån det du skickade in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சமர்ப்பித்தவற்றிலிருந்து உங்கள் அடையாளத்தைச் சரிபார்க்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమర్పించిన దాని నుండి మీ గుర్తింపును ధృవీకరించలేకపోయాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรายืนยันตัวตนของคุณจากสิ่งที่คุณส่งมาไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiklerinizden kimliğinizi doğrulayamadık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам не вдалося верифікувати вашу особу за надісланими даними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جمع کرائی ہوئی چیزوں سے ہم آپ کی شناخت کی تصدیق نہیں کر سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không xác minh được danh tính của bạn từ những gì bạn đã gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法根据你提交的内容验证你的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們無法根據你送出的資料驗證你的身分。"
          }
        }
      }
    },
