    "post.scope.international.room.accessibility": {
      "comment": "VoiceOver reading of the international scope chip on a voice room. Scope governs speaking; everyone may listen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غرفة دولية. أي حساب موثّق يمكنه التحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আন্তর্জাতিক রুম। যেকোনো ভেরিফায়েড অ্যাকাউন্ট কথা বলতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala internacional. Qualsevol compte verificat hi pot parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezinárodní místnost. Mluvit může jakýkoli ověřený účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationalt rum. Enhver verificeret konto kan tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationaler Raum. Jedes verifizierte Konto kann sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διεθνής αίθουσα. Οποιοσδήποτε επαληθευμένος λογαριασμός μπορεί να μιλήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "International room. Any verified account can speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala internacional. Cualquier cuenta verificada puede hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansainvälinen huone. Mikä tahansa vahvistettu tili voi puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon international. Tout compte vérifié peut parler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר בינלאומי. כל חשבון מאומת יכול לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतरराष्ट्रीय रूम। कोई भी सत्यापित अकाउंट बोल सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Međunarodna soba. Govoriti može bilo koji potvrđeni račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemzetközi szoba. Bármely hitelesített fiók megszólalhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room internasional. Akun terverifikasi mana pun bisa berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanza internazionale. Qualsiasi account verificato può parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国際ルーム。どの認証済みアカウントでも発言できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국제 룸. 인증된 계정이면 누구나 말할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അന്താരാഷ്ട്ര റൂം. പരിശോധിച്ച ഏതൊരു അക്കൗണ്ടിനും സംസാരിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik antarabangsa. Mana-mana akaun yang disahkan boleh bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Internasjonalt rom. Alle verifiserte kontoer kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationale room. Elk geverifieerd account kan spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój międzynarodowy. Mówić może każde zweryfikowane konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala internacional. Qualquer conta verificada pode falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala internacional. Qualquer conta verificada pode falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră internațională. Orice cont verificat poate vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Международная комната. Говорить может любой проверенный аккаунт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzinárodná miestnosť. Hovoriť môže každý overený účet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Internationellt rum. Alla verifierade konton kan tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சர்வதேச அறை. சரிபார்க்கப்பட்ட எந்தக் கணக்கும் பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతర్జాతీయ రూమ్. ధృవీకరించబడిన ఏ ఖాతా అయినా మాట్లాడగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนานาชาติ บัญชีที่ยืนยันตัวตนแล้วใดก็พูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uluslararası oda. Doğrulanmış her hesap konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міжнародна кімната. Говорити може будь-який верифікований обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بین الاقوامی روم۔ کوئی بھی تصدیق شدہ اکاؤنٹ بول سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng quốc tế. Mọi tài khoản đã xác minh đều phát biểu được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国际房间。任何已验证的账户都可以发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國際聊天室。任何已驗證的帳號都能發言。"
          }
        }
      }
    },
