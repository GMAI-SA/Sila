        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 보낸 사람이 입력한 정보와 일치하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വിവരങ്ങൾ ലിങ്ക് അയച്ചയാൾ നൽകിയതുമായി ഒത്തുപോകുന്നില്ല."
