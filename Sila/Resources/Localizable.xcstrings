    "account.recovery.countdown.today": {
      "comment": "Countdown on the day the purge runs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنفَّذ الحذف اليوم. الإلغاء ما زال ممكنًا الآن، لكن ليس لوقت طويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলার কাজ আজই হবে। এখনও বাতিল করা যায়, তবে আর বেশি সময় নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminació s'executa avui. Cancel·lar ara encara funciona, però ja no per gaire temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazání proběhne dnes. Zrušení teď ještě funguje, ale už ne nadlouho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletningen sker i dag. Det virker stadig at annullere nu, men ikke ret meget længere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung läuft heute. Abbrechen funktioniert jetzt noch, aber nicht mehr lange."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή εκτελείται σήμερα. Η ακύρωση τώρα λειτουργεί ακόμα, αλλά όχι για πολύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion runs today. Cancelling now still works, but not for much longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación se ejecuta hoy. Cancelarla ahora aún funciona, pero por poco tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisto suoritetaan tänään. Peruminen onnistuu vielä, mutta ei enää kauan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression a lieu aujourd’hui. Vous pouvez encore annuler, mais plus pour très longtemps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחיקה מתבצעת היום. ביטול עכשיו עדיין אפשרי, אבל לא לאורך זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीट आज होगा। अभी रद्द करना काम करेगा, पर ज़्यादा देर नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisanje se izvršava danas. Otkazivanje sada još radi, ali ne još dugo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törlés ma lefut. A visszavonás most még működik, de már nem sokáig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan berjalan hari ini. Membatalkan sekarang masih bisa, tetapi tidak lama lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione avviene oggi. Annullarla ora funziona ancora, ma non per molto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除は今日実行されます。今ならまだ取り消せますが、時間はあまり残っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 삭제가 실행돼요. 지금은 취소할 수 있지만 오래 남지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കൽ ഇന്ന് നടക്കും. ഇപ്പോഴും റദ്ദാക്കാം, പക്ഷേ അധികനേരം കഴിയില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemadaman berjalan hari ini. Membatalkan sekarang masih boleh, tetapi tidak lama lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettingen skjer i dag. Det går fortsatt an å avbryte nå, men ikke så mye lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwijdering vindt vandaag plaats. Annuleren kan nu nog, maar niet lang meer."
