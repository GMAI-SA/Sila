    "safety.suspended.scope": {
      "comment": "What is and is not reachable while suspended.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء آخر في «معروف» يعمل ما دام هذا قائمًا. منشوراتك مخفية، وهذه الشاشة والتظلّم هما الشيئان الوحيدان اللذان يمكنك الوصول إليهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি চালু থাকা অবস্থায় Known-এর আর কিছুই কাজ করে না। আপনার পোস্ট লুকানো, আর এই স্ক্রিন ও আপিলই একমাত্র যা আপনি খুলতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre això estigui en vigor, la resta de Known no funciona. Les teves publicacions estan amagades, i aquesta pantalla i l'apel·lació són l'únic a què pots accedir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud toto platí, nic jiného v aplikaci Known nefunguje. Tvé příspěvky jsou skryté a jen tato obrazovka a odvolání jsou dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet andet på Known virker, mens dette gælder. Dine opslag er skjult, og denne skærm og anken er det eneste, du kan komme til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dies gilt, funktioniert nichts anderes auf Known. Deine Beiträge sind ausgeblendet, und dieser Bildschirm sowie der Einspruch sind das Einzige, was du erreichen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα άλλο στο Known δεν λειτουργεί όσο ισχύει αυτό. Οι αναρτήσεις σου είναι κρυμμένες και αυτή η οθόνη και η ένσταση είναι τα μόνα που μπορείς να δεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else on Known works while this is in place. Your posts are hidden, and this screen and the appeal are the only things you can reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada más en Known funciona mientras esto está en vigor. Tus publicaciones están ocultas, y esta pantalla y la apelación son lo único a lo que puedes acceder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään muu Knownissa ei toimi, kun tämä on voimassa. Julkaisusi on piilotettu, ja tämä näkymä ja valitus ovat ainoat, joihin pääset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’autre ne fonctionne sur Known tant que cela dure. Vos posts sont masqués, et cet écran et le recours sont les seules choses accessibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר אחר ב-Known לא פועל כל עוד זה בתוקף. הפוסטים שלך מוסתרים, והמסך הזה והערעור הם הדברים היחידים שאפשר להגיע אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लागू रहते Known पर और कुछ काम नहीं करता। आपकी पोस्ट छिपी हैं, और यह स्क्रीन व अपील ही एकमात्र चीज़ें हैं जहाँ आप पहुँच सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok je ovo na snazi, ništa drugo u aplikaciji Known ne radi. Tvoje objave su skrivene, a ovaj zaslon i žalba jedino su do čega možeš doći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg ez érvényben van, a Knownban semmi más nem működik. A bejegyzéseid el vannak rejtve, és csak ez a képernyő és a fellebbezés érhető el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hal lain di Known yang berfungsi selama ini berlaku. Postinganmu disembunyikan, dan layar ini serta banding adalah satu-satunya yang bisa kamu akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché è in vigore, nient'altro su Known funziona. I tuoi post sono nascosti, e questa schermata e il ricorso sono le uniche cose che puoi raggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中は、Knownの他の機能は使えません。投稿は非表示になり、この画面と異議申し立てだけが利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정지 중에는 Known의 다른 기능을 쓸 수 없어요. 게시물은 숨겨지며, 이 화면과 이의 신청만 이용할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിലവിലുള്ളപ്പോൾ Known-ൽ മറ്റൊന്നും പ്രവർത്തിക്കില്ല. നിങ്ങളുടെ പോസ്റ്റുകൾ മറച്ചിരിക്കുന്നു, ഈ സ്ക്രീനും അപ്പീലും മാത്രമേ ലഭ്യമാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa lagi di Known berfungsi semasa ini berkuat kuasa. Siaran anda disembunyikan, dan skrin ini serta rayuan ialah satu-satunya yang boleh anda capai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting annet på Known fungerer mens dette gjelder. Innleggene dine er skjult, og denne skjermen og anken er det eneste du kommer til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang dit geldt werkt niets anders op Known. Je berichten zijn verborgen en dit scherm en het bezwaar zijn het enige dat je kunt bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki zawieszenie trwa, nic innego w Known nie działa. Twoje wpisy są ukryte, a dostępny jest tylko ten ekran i odwołanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais no Known funciona enquanto isto estiver em vigor. Seus posts estão ocultos, e esta tela e a contestação são as únicas coisas que você pode acessar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais na Known funciona enquanto isto estiver em vigor. As suas publicações estão ocultas, e este ecrã e a contestação são as únicas coisas a que tem acesso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic altceva pe Known nu funcționează cât timp aceasta este în vigoare. Postările tale sunt ascunse, iar acest ecran și contestația sunt singurele lucruri la care ai acces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока блокировка действует, остальные функции Known недоступны. Ваши посты скрыты, и доступны только этот экран и апелляция."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým toto platí, nič iné na Known nefunguje. Tvoje príspevky sú skryté a táto obrazovka a odvolanie sú jediné, čo môžeš otvoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget annat på Known fungerar medan detta gäller. Dina inlägg är dolda, och den här skärmen och överklagandet är det enda du kommer åt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நடைமுறையில் இருக்கும்போது Known-இல் வேறெதுவும் செயல்படாது. உங்கள் இடுகைகள் மறைக்கப்பட்டுள்ளன; இந்தத் திரையும் மேல்முறையீடும் மட்டுமே உங்களுக்குக் கிடைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది అమలులో ఉన్నంత వరకు Known లో మరేదీ పని చేయదు. మీ పోస్ట్‌లు దాచబడ్డాయి, ఈ స్క్రీన్ మరియు అప్పీల్ మాత్రమే మీరు ఉపయోగించగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่การระงับมีผล ส่วนอื่นๆ ของ Known จะใช้งานไม่ได้ โพสต์ของคุณถูกซ่อน และหน้านี้กับการอุทธรณ์คือสิ่งเดียวที่คุณเข้าถึงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerliyken Known'da başka hiçbir şey çalışmaz. Gönderileriniz gizlendi ve ulaşabildiğiniz tek şeyler bu ekran ve itiraz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки це діє, більше нічого в Known не працює. Ваші дописи приховані, а цей екран та апеляція — єдине, що вам доступне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے نافذ رہنے تک Known پر اور کچھ کام نہیں کرتا۔ آپ کی پوسٹس چھپی ہوئی ہیں، اور یہ اسکرین اور اپیل ہی واحد چیزیں ہیں جن تک آپ پہنچ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì khác trên Known hoạt động khi việc này còn hiệu lực. Bài đăng của bạn bị ẩn, và màn hình này cùng khiếu nại là những thứ duy nhất bạn vào được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此期间，Known 的其他功能都无法使用。你的帖子已被隐藏，你只能访问此页面和申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此狀態下，Known 的其他功能都無法使用。你的貼文已被隱藏，你只能進入此畫面和申訴頁面。"
          }
        }
      }
    },
    "safety.suspended.signOut.note": {
      "comment": "Says signing out changes nothing about the suspension.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج لا يغيّر شيئًا في الإيقاف. سيظل قائمًا عندما تعود وتسجّل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন আউট করলে স্থগিতাদেশে কিছুই বদলায় না। আবার সাইন ইন করলে এটি এখানেই থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tancar la sessió no canvia res de la suspensió. Continuarà aquí quan tornis a iniciar la sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení na pozastavení nic nemění. Až se znovu přihlásíš, bude tu stále."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ændrer intet ved suspensionen, at du logger ud. Den er der stadig, når du logger ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abmelden ändert nichts an der Sperre. Sie ist weiterhin da, wenn du dich wieder anmeldest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποσύνδεση δεν αλλάζει τίποτα στην αναστολή. Θα είναι ακόμα εδώ όταν συνδεθείς ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out changes nothing about the suspension. It will still be here when you sign back in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión no cambia nada de la suspensión. Seguirá aquí cuando vuelvas a iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloskirjautuminen ei muuta jäädytystä mitenkään. Se on yhä voimassa, kun kirjaudut takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter ne change rien à la suspension. Elle sera toujours là à votre reconnexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקות לא משנה דבר בהשעיה. היא עדיין תהיה כאן כשתתחבר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट करने से निलंबन पर कोई असर नहीं पड़ता। दोबारा साइन इन करने पर यह यहीं मिलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava ništa ne mijenja u suspenziji. Bit će i dalje ovdje kad se ponovno prijaviš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelentkezés semmit nem változtat a felfüggesztésen. Amikor újra bejelentkezel, még itt lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar tidak mengubah apa pun tentang penangguhan. Penangguhan akan tetap ada saat kamu masuk kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire non cambia nulla della sospensione. Sarà ancora qui quando accederai di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしても、停止の状態は変わりません。再びサインインしたときも、そのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃해도 정지에는 아무 영향이 없어요. 다시 로그인하면 그대로 남아 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈൻ ഔട്ട് ചെയ്താൽ സസ്പെൻഷന് മാറ്റമൊന്നും വരില്ല. തിരികെ സൈൻ ഇൻ ചെയ്യുമ്പോഴും ഇത് ഇവിടെ ഉണ്ടാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log keluar tidak mengubah apa-apa tentang penggantungan. Ia masih ada apabila anda log masuk semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å logge ut endrer ingenting ved suspensjonen. Den vil fortsatt være her når du logger inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitloggen verandert niets aan de schorsing. Ze is er nog als je weer inlogt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie nic nie zmienia w zawieszeniu. Nadal będzie tu, gdy się ponownie zalogujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair não muda nada na suspensão. Ela continuará aqui quando você entrar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar sessão não altera nada na suspensão. Continuará aqui quando voltar a iniciar sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea nu schimbă nimic la suspendare. Va fi tot aici când te autentifici din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход ничего не меняет в блокировке. Она останется, когда вы снова войдёте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie na pozastavení nič nemení. Bude tu aj po tvojom opätovnom prihlásení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att logga ut ändrar ingenting i avstängningen. Den finns kvar när du loggar in igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியேறுவதால் இடைநீக்கத்தில் எந்த மாற்றமும் ஏற்படாது. மீண்டும் உள்நுழையும்போதும் இது இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైన్ అవుట్ చేసినా సస్పెన్షన్ మారదు. మీరు మళ్లీ సైన్ ఇన్ చేసినప్పుడు కూడా ఇది ఇక్కడే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกจากระบบไม่เปลี่ยนอะไรเกี่ยวกับการระงับ การระงับจะยังอยู่เมื่อคุณลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yapmak askıya almayı değiştirmez. Yeniden giriş yaptığınızda yine burada olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід нічого не змінює щодо призупинення. Воно залишиться, коли ви увійдете знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن آؤٹ کرنے سے معطلی میں کچھ نہیں بدلتا۔ آپ کے دوبارہ سائن اِن کرنے پر یہ یہیں ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất không thay đổi gì về việc đình chỉ. Nó vẫn ở đây khi bạn đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录不会改变封禁状态。你重新登录时它仍然存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出不會改變停權狀態。你再次登入時，它仍然在這裡。"
          }
        }
      }
    },
