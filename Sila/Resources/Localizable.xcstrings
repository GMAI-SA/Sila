    "vouch.new.responsibility": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تضع اسمك الموثّق خلف اسمهم. إن تبيّن أنهم ليسوا من قلت، تفقد حق التزكية — وقد يُعلَّق حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আপনার নিজের ভেরিফায়েড নাম তাঁর নামের পেছনে রাখছেন। আপনি যা বলেছিলেন তিনি সেই ব্যক্তি না হলে আপনি ভাউচ করার অধিকার হারাবেন — এবং আপনার অ্যাকাউন্ট স্থগিত হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Poses el teu propi nom verificat al costat del seu. Si resulta que no és qui deies, perds el dret d'avalar, i el teu compte pot ser suspès."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavíš své vlastní ověřené jméno za jejich. Pokud se ukáže, že to není ten, za koho jsi ručil, ztratíš právo ručit – a tvůj účet může být pozastaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sætter dit eget verificerede navn bag deres. Viser det sig, at de ikke er den, du sagde, mister du retten til at gå i god for andre – og din konto kan blive suspenderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du stellst deinen eigenen verifizierten Namen hinter den der Person. Stellt sich heraus, dass sie nicht ist, wer du gesagt hast, verlierst du das Recht zu bürgen – und dein Konto kann gesperrt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάζεις το δικό σου επαληθευμένο όνομα πίσω από το δικό τους. Αν αποδειχθεί ότι δεν είναι αυτός/ή που είπες, χάνεις το δικαίωμα να εγγυάσαι — και ο λογαριασμός σου μπορεί να τεθεί σε αναστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are putting your own verified name behind theirs. If they turn out not to be who you said, you lose the right to vouch — and your account can be suspended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pones tu propio nombre verificado respaldando el suyo. Si resulta no ser quien dijiste, pierdes el derecho a avalar y tu cuenta puede ser suspendida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitat oman vahvistetun nimesi heidän nimensä taakse. Jos käy ilmi, ettei hän ole se, joksi sanoit, menetät takaamisoikeuden – ja tilisi voidaan jäädyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous engagez votre propre nom vérifié à côté du sien. S’il s’avère ne pas être celui que vous avez annoncé, vous perdez le droit de vous porter garant — et votre compte peut être suspendu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה שם את שמך המאומת מאחורי שמם. אם יתברר שהם לא מי שאמרת, תאבד את הזכות לערוב — והחשבון שלך עלול להיות מושעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपना सत्यापित नाम उनके नाम के पीछे लगा रहे हैं। अगर वे वह नहीं निकले जो आपने कहा, तो आप वाउच करने का अधिकार खो देंगे — और आपका अकाउंट निलंबित हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svojim potvrđenim imenom stojiš iza njihova. Ako se pokaže da nisu osoba koju si naveo/la, gubiš pravo na jamčenje — a tvoj račun može biti suspendiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját hitelesített nevedet állítod az övé mögé. Ha kiderül, hogy nem az, akit mondtál, elveszíted a kezeskedés jogát – és a fiókodat fel lehet függeszteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menaruh nama terverifikasimu sendiri di belakang nama mereka. Jika ternyata mereka bukan orang yang kamu sebut, kamu kehilangan hak menjamin — dan akunmu bisa ditangguhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il tuo nome verificato accanto al suo. Se risulta non essere chi hai detto, perdi il diritto di garantire e il tuo account può essere sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは、認証済みのご自身の名前を、相手の名前の後ろ盾にします。保証した人物と別人だと判明した場合、あなたは保証する権利を失い、アカウントが停止されることもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 내 이름을 상대방의 이름 뒤에 걸게 돼요. 내가 말한 사람이 아닌 것으로 밝혀지면 보증 자격을 잃고 계정이 정지될 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വെരിഫൈ ചെയ്ത സ്വന്തം പേര് അവരുടെ പേരിന് പിന്നിൽ വയ്ക്കുകയാണ്. നിങ്ങൾ പറഞ്ഞ ആളല്ല അവരെന്ന് തെളിഞ്ഞാൽ, വൗച്ച് ചെയ്യാനുള്ള അവകാശം നിങ്ങൾക്ക് നഷ്ടമാകും — നിങ്ങളുടെ അക്കൗണ്ടും സസ്പെൻഡ് ചെയ്യപ്പെടാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda meletakkan nama anda yang disahkan di belakang nama mereka. Jika ternyata mereka bukan orang yang anda nyatakan, anda kehilangan hak untuk menjamin — dan akaun anda boleh digantung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du setter ditt eget verifiserte navn bak deres. Hvis det viser seg at de ikke er den du sa, mister du retten til å garantere, og kontoen din kan bli suspendert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zet je eigen geverifieerde naam achter die van de ander. Als blijkt dat diegene niet is wie je zei, verlies je het recht om in te staan en kan je account worden geschorst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stawiasz własne zweryfikowane imię obok jej imienia. Jeśli okaże się, że to nie ta osoba, którą wskazałeś, tracisz prawo do poręczania — a Twoje konto może zostać zawieszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está colocando seu próprio nome verificado junto ao da pessoa. Se ela não for quem você disse, você perde o direito de avalizar, e sua conta pode ser suspensa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a associar o seu nome verificado ao dela. Se se vier a verificar que não é quem disse, perde o direito de avalizar — e a sua conta pode ser suspensa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pui propriul tău nume verificat lângă al lor. Dacă se dovedește că nu sunt cine ai spus, pierzi dreptul de a garanta — iar contul tău poate fi suspendat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ставите своё проверенное имя рядом с чужим. Если окажется, что это не тот человек, о котором вы говорили, вы потеряете право поручаться, а ваш аккаунт могут заблокировать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavíš svoje vlastné overené meno za jej. Ak sa ukáže, že nie je tým, kým si uviedol, stratíš právo ručiť — a tvoj účet môže byť pozastavený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ställer ditt eget verifierade namn bakom deras. Om det visar sig att de inte är den du sa förlorar du rätten att intyga – och ditt konto kan stängas av."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சரிபார்க்கப்பட்ட பெயரை அவர்கள் பெயருக்குப் பின்னால் நிறுத்துகிறீர்கள். நீங்கள் கூறிய நபர் அவர் அல்ல எனத் தெரிந்தால், உறுதியளிக்கும் உரிமையை இழப்பீர்கள் — உங்கள் கணக்கும் இடைநிறுத்தப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ స్వంత ధృవీకరించబడిన పేరును వారి పేరు వెనుక ఉంచుతున్నారు. వారు మీరు చెప్పిన వ్యక్తి కాదని తేలితే, మీరు హామీ ఇచ్చే హక్కును కోల్పోతారు — మీ ఖాతా సస్పెండ్ కూడా కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกำลังใช้ชื่อที่ยืนยันแล้วของคุณรับรองเขา หากเขาไม่ใช่คนที่คุณระบุ คุณจะเสียสิทธิ์ในการรับรอง และบัญชีของคุณอาจถูกระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi doğrulanmış adınızı onun adının arkasına koyuyorsunuz. Söylediğiniz kişi olmadığı anlaşılırsa kefil olma hakkınızı kaybedersiniz ve hesabınız askıya alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ставите власне верифіковане ім’я за їхнє. Якщо виявиться, що це не та людина, про яку ви казали, ви втратите право ручатися — а ваш обліковий запис можуть призупинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنا تصدیق شدہ نام ان کے نام کے پیچھے رکھ رہے ہیں۔ اگر وہ وہ نہ نکلے جو آپ نے بتایا، تو آپ ضمانت دینے کا حق کھو دیں گے — اور آپ کا اکاؤنٹ معطل ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang đặt tên đã xác minh của chính mình đứng sau tên họ. Nếu họ không phải người bạn đã nói, bạn mất quyền bảo chứng — và tài khoản của bạn có thể bị đình chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在把自己已验证的名字放在对方名字之后。如果对方并非你所说的人，你会失去担保资格，你的账户也可能被封禁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是以自己已驗證的名字為對方背書。如果對方並非你所說的人，你會失去擔保資格，你的帳號也可能被停權。"
          }
        }
      }
    },
