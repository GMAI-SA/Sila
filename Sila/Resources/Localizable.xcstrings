            "state": "translated",
            "value": "Νήμα χώρας. Μόνο επαληθευμένοι λογαριασμοί στη χώρα %@ μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country thread. Only verified accounts in %@ can reply."
