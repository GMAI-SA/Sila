        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스레드에서 이 게시물을 삭제해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പോസ്റ്റ് ത്രെഡിൽ നിന്ന് ഇല്ലാതാക്കുന്നു"
