        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kansainvälinen-syötteesi näyttää vain julkaisut %lld valitsemastasi aiheesta; julkaisut, joita ei ole vielä luokiteltu, piilotetaan."
