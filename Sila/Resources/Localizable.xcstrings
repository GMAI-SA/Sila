    "verification.method.document.detail": {
      "comment": "Option detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أي دولة عدا السعودية. صوّر الوثيقة، والتقط سيلفي قصيرًا، ويراجعها مراجع — عادةً خلال يوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সৌদি আরব ছাড়া যেকোনো দেশ। নথির ছবি তুলুন, একটি ছোট সেলফি তুলুন, আর একজন রিভিউয়ার যাচাই করেন — সাধারণত একদিনের মধ্যে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol país excepte l'Aràbia Saudita. Fotografia el document, fes un selfie breu i un revisor ho comprova, normalment en un dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakákoli země kromě Saúdské Arábie. Vyfotografuj doklad, pořiď krátké selfie a posuzovatel to zkontroluje – obvykle do jednoho dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle lande undtagen Saudi-Arabien. Fotografér dokumentet, tag en kort selfie, så tjekker en gennemgående det – som regel inden for et døgn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Land außer Saudi-Arabien. Fotografiere das Dokument, nimm ein kurzes Selfie auf, und ein Prüfer sieht es sich an – meist innerhalb eines Tages."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οποιαδήποτε χώρα εκτός της Σαουδικής Αραβίας. Φωτογράφισε το έγγραφο, τράβηξε μια σύντομη selfie και ένας ελεγκτής το ελέγχει — συνήθως μέσα σε μία ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any country except Saudi Arabia. Photograph the document, take a short selfie, and a reviewer checks it — usually within a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier país salvo Arabia Saudí. Fotografía el documento, hazte un selfie breve y un revisor lo comprueba, normalmente en un día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tahansa maa paitsi Saudi-Arabia. Kuvaa asiakirja, ota lyhyt selfie, ja tarkastaja tarkistaa sen – yleensä vuorokaudessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quel pays sauf l’Arabie saoudite. Photographiez le document, prenez un court selfie, et un vérificateur le contrôle — généralement sous un jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מדינה חוץ מערב הסעודית. צלם את המסמך, צלם סלפי קצר, ובודק בודק אותו — בדרך כלל תוך יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सऊदी अरब को छोड़कर कोई भी देश। दस्तावेज़ की फ़ोटो लें, एक छोटी सेल्फ़ी लें, और एक समीक्षक उसे जाँचता है — आमतौर पर एक दिन में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo koja zemlja osim Saudijske Arabije. Fotografiraj ispravu, snimi kratki selfie, a recenzent to provjerava — obično unutar dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely ország, Szaúd-Arábia kivételével. Fényképezd le az okmányt, készíts egy rövid szelfit, és egy elbíráló ellenőrzi – általában egy napon belül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Negara mana pun kecuali Arab Saudi. Foto dokumennya, ambil selfie singkat, dan seorang peninjau memeriksanya — biasanya dalam sehari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi paese tranne l'Arabia Saudita. Fotografa il documento, scatta un breve selfie e un revisore lo controlla, di solito entro un giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウジアラビア以外のどの国でも可。書類を撮影し、短い自撮りを撮ると、審査担当者が確認します。通常は1日以内です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사우디아라비아를 제외한 모든 국가. 문서를 촬영하고 짧은 셀카를 찍으면 검토자가 확인해요. 보통 하루 안에 끝나요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗദി അറേബ്യ ഒഴികെ ഏത് രാജ്യവും. രേഖയുടെ ഫോട്ടോ എടുക്കുക, ഒരു ചെറിയ സെൽഫി എടുക്കുക, ഒരു പരിശോധകൻ പരിശോധിക്കും — സാധാരണയായി ഒരു ദിവസത്തിനുള്ളിൽ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mana-mana negara kecuali Arab Saudi. Potret dokumen, ambil swafoto ringkas, dan penyemak menyemaknya — biasanya dalam masa sehari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle land unntatt Saudi-Arabia. Ta bilde av dokumentet, ta en kort selfie, så sjekker en vurderer det, vanligvis i løpet av et døgn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk land behalve Saoedi-Arabië. Fotografeer het document, maak een korte selfie en een beoordelaar controleert het, meestal binnen een dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolny kraj poza Arabią Saudyjską. Sfotografuj dokument, zrób krótkie selfie, a recenzent to sprawdzi — zwykle w ciągu doby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer país, exceto a Arábia Saudita. Fotografe o documento, tire uma selfie rápida e um analista confere, normalmente em um dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer país exceto a Arábia Saudita. Fotografe o documento, tire uma selfie rápida e um revisor verifica — normalmente em menos de um dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice țară în afară de Arabia Saudită. Fotografiezi documentul, faci un scurt selfie, iar un evaluator îl verifică — de obicei într-o zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая страна, кроме Саудовской Аравии. Сфотографируйте документ, сделайте короткое селфи, и проверяющий всё проверит — обычно в течение суток."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktorákoľvek krajina okrem Saudskej Arábie. Odfoť doklad, urob krátke selfie a posudzovateľ ho skontroluje — zvyčajne do jedného dňa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket land som helst utom Saudiarabien. Fotografera dokumentet, ta en kort selfie så granskar en människa det – vanligtvis inom ett dygn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சவூதி அரேபியா தவிர எந்த நாடும். ஆவணத்தைப் படம் எடுங்கள், ஒரு சிறிய செல்ஃபி எடுங்கள்; மதிப்பாய்வாளர் சரிபார்ப்பார் — பொதுவாக ஒரு நாளுக்குள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సౌదీ అరేబియా తప్ప ఏ దేశమైనా. పత్రాన్ని ఫోటో తీసి, చిన్న సెల్ఫీ తీసుకోండి, ఒక సమీక్షకుడు పరిశీలిస్తారు — సాధారణంగా ఒక రోజులో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเทศใดก็ได้ยกเว้นซาอุดีอาระเบีย ถ่ายรูปเอกสาร ถ่ายเซลฟีสั้นๆ แล้วผู้ตรวจสอบจะตรวจสอบ โดยปกติภายในหนึ่งวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suudi Arabistan dışındaki herhangi bir ülke. Belgeyi fotoğraflayın, kısa bir selfie çekin; bir inceleyici kontrol eder, genellikle bir gün içinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-яка країна, крім Саудівської Аравії. Сфотографуйте документ, зробіть коротке селфі, і перевіряльник перевірить — зазвичай протягом доби."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سعودی عرب کے علاوہ کوئی بھی ملک۔ دستاویز کی تصویر لیں، مختصر سیلفی لیں، اور ایک جائزہ لینے والا جانچتا ہے — عموماً ایک دن کے اندر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quốc gia trừ Ả Rập Xê Út. Chụp giấy tờ, quay một ảnh selfie ngắn, và một người xét duyệt sẽ kiểm tra — thường trong vòng một ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙特阿拉伯以外的任何国家。拍摄证件、自拍一张，由审核员核查，通常在一天之内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙烏地阿拉伯以外的任何國家。拍攝證件、錄製簡短自拍，由審核人員檢查，通常在一天內完成。"
          }
        }
      }
    },
