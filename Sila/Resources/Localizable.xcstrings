    "rooms.create.scheduleExplanation": {
      "comment": "What scheduling does, and what it does not — nobody can speak until the host opens it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك هذا موقفًا لفتح الغرفة الآن. وجدولتها تضعها في القائمة مع وقت بدء، ولا يمكن لأحد التحدث فيها حتى تفتحها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই রুম খুলতে এটি বন্ধ রাখুন। নির্ধারণ করলে এটি শুরুর সময়সহ তালিকায় ওঠে; আপনি না খোলা পর্যন্ত কেউ এতে কথা বলতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa-ho desactivat per obrir la sala ara. Programar-la la posa a la llista amb una hora d'inici; ningú hi pot parlar fins que l'obris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech vypnuté, aby se místnost otevřela hned. Naplánováním se zařadí do seznamu s časem začátku; nikdo v ní nemůže mluvit, dokud ji neotevřeš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad den være slået fra for at åbne rummet nu. Hvis du planlægger det, kommer det på listen med et starttidspunkt; ingen kan tale i det, før du åbner det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dies aus, um den Raum jetzt zu öffnen. Beim Planen kommt er mit einer Startzeit auf die Liste; niemand kann darin sprechen, bis du ihn öffnest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άφησέ το απενεργοποιημένο για να ανοίξεις την αίθουσα τώρα. Ο προγραμματισμός τη βάζει στη λίστα με ώρα έναρξης· κανείς δεν μπορεί να μιλήσει σε αυτήν μέχρι να την ανοίξεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this off to open the room now. Scheduling it puts it on the list with a start time; nobody can speak in it until you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo desactivado para abrir la sala ahora. Al programarla, aparece en la lista con una hora de inicio; nadie puede hablar en ella hasta que la abras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä tämä pois päältä avataksesi huoneen nyt. Ajastaminen lisää sen luetteloon alkamisajan kanssa; kukaan ei voi puhua siinä, ennen kuin avaat sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez désactivé pour ouvrir le salon maintenant. En le programmant, vous le placez dans la liste avec une heure de début ; personne ne peut y parler tant que vous ne l’avez pas ouvert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר כבוי כדי לפתוח את החדר עכשיו. תזמון מוסיף אותו לרשימה עם שעת התחלה; אף אחד לא יכול לדבר בו עד שתפתח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम अभी खोलने के लिए इसे बंद रखें। शेड्यूल करने पर वह शुरू होने के समय के साथ सूची में आ जाता है; जब तक आप उसे खोलें नहीं, उसमें कोई बोल नहीं सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi ovo da sobu otvoriš odmah. Zakazivanjem se stavlja na popis s vremenom početka; nitko u njoj ne može govoriti dok je ne otvoriš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd kikapcsolva, ha most nyitod a szobát. Az ütemezés kezdési időponttal felteszi a listára; addig senki nem szólalhat meg benne, amíg meg nem nyitod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan mati untuk membuka room sekarang. Menjadwalkannya menaruhnya di daftar dengan waktu mulai; tidak ada yang bisa berbicara di dalamnya sampai kamu membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia disattivato per aprire la stanza ora. Programmarla la mette nell'elenco con un orario di inizio; nessuno può parlarvi finché non la apri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのままにすると、ルームをすぐに開きます。予約すると開始時刻付きでリストに載り、あなたが開くまで誰も発言できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 룸을 열려면 이 옵션을 꺼 두세요. 예약하면 시작 시간과 함께 목록에 올라가며, 내가 열기 전에는 아무도 말할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം ഇപ്പോൾ തുറക്കാൻ ഇത് ഓഫായി വിടുക. ഷെഡ്യൂൾ ചെയ്താൽ തുടങ്ങുന്ന സമയത്തോടെ പട്ടികയിൽ വരും; നിങ്ങൾ തുറക്കുന്നതുവരെ ആർക്കും അതിൽ സംസാരിക്കാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan ini dimatikan untuk membuka bilik sekarang. Menjadualkannya meletakkannya dalam senarai dengan masa mula; tiada sesiapa boleh bercakap di dalamnya sehingga anda membukanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La dette stå av for å åpne rommet nå. Hvis du planlegger det, settes det på listen med et starttidspunkt. Ingen kan snakke i det før du åpner det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat dit uit om de room nu te openen. Als je hem plant, komt hij met een starttijd op de lijst; niemand kan erin spreken tot jij hem opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw to wyłączone, aby otworzyć pokój teraz. Zaplanowanie umieszcza go na liście z godziną rozpoczęcia; nikt nie może w nim mówić, dopóki go nie otworzysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe desativado para abrir a sala agora. Agendá-la a coloca na lista com um horário de início; ninguém pode falar nela até você abri-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe desativado para abrir a sala agora. Agendá-la coloca-a na lista com uma hora de início; ninguém pode falar nela até a abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă dezactivat pentru a deschide camera acum. Programarea o pune în listă cu o oră de început; nimeni nu poate vorbi în ea până n-o deschizi tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте выключенным, чтобы открыть комнату сейчас. Если запланировать, она появится в списке с временем начала; говорить в ней никто не сможет, пока вы её не откроете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj to vypnuté, ak chceš miestnosť otvoriť hneď. Naplánovaním sa pridá do zoznamu s časom začiatku; kým ju neotvoríš, nikto v nej nemôže hovoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna detta av för att öppna rummet nu. Om du schemalägger det hamnar det i listan med en starttid; ingen kan tala i det förrän du öppnar det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போதே அறையைத் திறக்க இதை அணைத்தே வைத்திருங்கள். திட்டமிட்டால் தொடக்க நேரத்துடன் பட்டியலில் இடம்பெறும்; நீங்கள் திறக்கும் வரை யாரும் அதில் பேச முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌ను ఇప్పుడే తెరవడానికి దీన్ని ఆఫ్‌లో ఉంచండి. షెడ్యూల్ చేస్తే అది ప్రారంభ సమయంతో జాబితాలో ఉంటుంది; మీరు తెరిచే వరకు అందులో ఎవరూ మాట్లాడలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไว้เพื่อเปิดห้องตอนนี้ การกำหนดเวลาจะใส่ห้องในรายการพร้อมเวลาเริ่ม ไม่มีใครพูดในห้องได้จนกว่าคุณจะเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odayı şimdi açmak için bunu kapalı bırakın. Planlamak, odayı bir başlangıç saatiyle listeye koyar; siz açana kadar kimse içinde konuşamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште вимкненим, щоб відкрити кімнату зараз. Планування додає її до списку із часом початку; ніхто не може говорити в ній, доки ви її не відкриєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم ابھی کھولنے کے لیے اسے بند رکھیں۔ طے کرنے سے وہ آغاز کے وقت کے ساتھ فہرست میں آ جاتا ہے؛ جب تک آپ اسے نہ کھولیں کوئی اس میں بول نہیں سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tắt mục này để mở phòng ngay. Lên lịch sẽ đưa phòng vào danh sách với giờ bắt đầu; không ai phát biểu được cho đến khi bạn mở phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项则立即开启房间。安排房间会将其连同开始时间放入列表；在你开启之前，没有人能在其中发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此選項即可立即開設聊天室。排程會將它連同開始時間放上列表；在你開啟之前，沒有人能在其中發言。"
          }
        }
      }
    },
