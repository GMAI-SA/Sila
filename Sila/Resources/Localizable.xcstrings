                }
              }
            }
          }
        }
      }
    },
    "error.rateLimited": {
      "comment": "The caller is being throttled by the server.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا. انتظر لحظة وأعد المحاولة."
