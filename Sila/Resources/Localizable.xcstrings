    "feed.noCountry.subtitle": {
      "comment": "Says where the country flag comes from, and where it never comes from.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض «بلدي» منشورات مواطنيك الموثّقين. علم بلدك يأتي من هويتك الموثّقة — لا من عنوان الإنترنت الخاص بك أبدًا — لذلك يظهر بعد اكتمال التوثيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার দেশ আপনার ভেরিফায়েড স্বদেশিদের পোস্ট দেখায়। আপনার দেশের পতাকা আসে আপনার ভেরিফায়েড পরিচয় থেকে — কখনও আপনার IP ঠিকানা থেকে নয় — তাই ভেরিফিকেশন শেষ হলে এটি দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu país mostra publicacions dels teus compatriotes verificats. La bandera del teu país prové de la teva identitat verificada, mai de la teva adreça IP, així que apareix quan s'acaba la verificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Má země zobrazuje příspěvky tvých ověřených krajanů. Vlajka tvé země pochází z ověřené totožnosti – nikdy z tvé IP adresy – takže se objeví po dokončení ověření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit land viser opslag fra dine verificerede landsmænd. Dit landeflag kommer fra din verificerede identitet – aldrig fra din IP-adresse – så det vises, når verificeringen er gennemført."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Land zeigt Beiträge deiner verifizierten Landsleute. Deine Landesflagge stammt aus deiner verifizierten Identität – nie aus deiner IP-Adresse –, daher erscheint sie, sobald die Verifizierung abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Η χώρα μου εμφανίζει αναρτήσεις από τους επαληθευμένους συμπατριώτες σου. Η σημαία της χώρας σου προέρχεται από την επαληθευμένη ταυτότητά σου — ποτέ από τη διεύθυνση IP σου — οπότε εμφανίζεται μόλις ολοκληρωθεί η επαλήθευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Country shows posts from your verified compatriots. Your country flag comes from your verified identity — never from your IP address — so it appears once verification completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi país muestra publicaciones de tus compatriotas verificados. La bandera de tu país procede de tu identidad verificada, nunca de tu dirección IP, así que aparece cuando se completa la verificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma maa näyttää vahvistettujen maanmiestesi julkaisut. Maasi lippu tulee vahvistetusta henkilöllisyydestäsi – ei koskaan IP-osoitteestasi – joten se ilmestyy vahvistuksen valmistuttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon pays affiche les posts de vos compatriotes vérifiés. Le drapeau de votre pays provient de votre identité vérifiée — jamais de votre adresse IP — il apparaît donc une fois la vérification terminée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדינה שלי מציגה פוסטים מבני ארצך המאומתים. דגל המדינה שלך מגיע מהזהות המאומתת שלך — אף פעם לא מכתובת ה-IP שלך — ולכן הוא מופיע כשהאימות מסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"मेरा देश\" में आपके सत्यापित हमवतनों की पोस्ट दिखती हैं। आपके देश का झंडा आपकी सत्यापित पहचान से आता है — आपके IP पते से कभी नहीं — इसलिए यह सत्यापन पूरा होने पर दिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moja zemlja prikazuje objave tvojih potvrđenih sunarodnjaka. Zastava tvoje zemlje dolazi iz tvog potvrđenog identiteta — nikada iz tvoje IP adrese — pa se pojavljuje kad se provjera završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Saját ország a hitelesített honfitársaid bejegyzéseit mutatja. Az országzászlód a hitelesített személyazonosságodból származik – soha nem az IP-címedből –, így a hitelesítés befejezése után jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Negaraku menampilkan postingan sesama warga negaramu yang terverifikasi. Bendera negaramu berasal dari identitas terverifikasimu — bukan dari alamat IP — jadi muncul setelah verifikasi selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio paese mostra i post dei tuoi connazionali verificati. La bandiera del tuo paese deriva dalla tua identità verificata, mai dal tuo indirizzo IP, quindi compare quando la verifica è completata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自分の国」には、認証済みの同国の人の投稿が表示されます。国旗は認証済みの本人情報から決まり、IPアドレスからは決まりません。認証が完了すると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 국가에는 같은 나라의 인증된 사람들의 게시물이 표시돼요. 국가 깃발은 IP 주소가 아니라 인증된 신원에서 가져오므로 인증이 완료되면 나타나요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ രാജ്യം നിങ്ങളുടെ പരിശോധിച്ച നാട്ടുകാരുടെ പോസ്റ്റുകൾ കാണിക്കുന്നു. നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാക ലഭിക്കുന്നത് നിങ്ങളുടെ പരിശോധിച്ച ഐഡന്റിറ്റിയിൽ നിന്നാണ് — ഒരിക്കലും IP വിലാസത്തിൽ നിന്നല്ല — അതിനാൽ പരിശോധന പൂർത്തിയായാൽ ഇത് ദൃശ്യമാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Negara Saya memaparkan siaran daripada rakan senegara anda yang disahkan. Bendera negara anda datang daripada identiti anda yang disahkan — tidak pernah daripada alamat IP anda — jadi ia muncul setelah pengesahan selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitt land viser innlegg fra dine verifiserte landsmenn. Landsflagget ditt kommer fra den verifiserte identiteten din, aldri fra IP-adressen din, så det vises når verifiseringen er fullført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn land toont berichten van je geverifieerde landgenoten. Je landvlag komt van je geverifieerde identiteit, nooit van je IP-adres, dus hij verschijnt zodra de verificatie is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mój kraj pokazuje wpisy Twoich zweryfikowanych rodaków. Flaga Twojego kraju pochodzi z zweryfikowanej tożsamości — nigdy z adresu IP — więc pojawi się po zakończeniu weryfikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu país mostra posts dos seus compatriotas verificados. A bandeira do seu país vem da sua identidade verificada, nunca do seu endereço IP, então ela aparece quando a verificação for concluída."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O meu país mostra publicações dos seus compatriotas verificados. A bandeira do seu país vem da sua identidade verificada — nunca do seu endereço IP — por isso aparece quando a verificação estiver concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țara mea arată postările compatrioților tăi verificați. Steagul țării tale provine din identitatea ta verificată — niciodată din adresa IP — așa că apare după finalizarea verificării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Моя страна» показывает посты проверенных соотечественников. Флаг вашей страны берётся из проверенной личности — а не из IP-адреса, — поэтому он появится после завершения проверки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Moja krajina zobrazuje príspevky tvojich overených krajanov. Vlajka tvojej krajiny pochádza z tvojej overenej totožnosti — nikdy z tvojej IP adresy — takže sa zobrazí po dokončení overenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitt land visar inlägg från dina verifierade landsmän. Flaggan för ditt land kommer från din verifierade identitet – aldrig från din IP-adress – så den visas när verifieringen är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் நாடு உங்கள் சரிபார்க்கப்பட்ட நாட்டவரின் இடுகைகளைக் காட்டும். உங்கள் நாட்டுக் கொடி உங்கள் சரிபார்க்கப்பட்ட அடையாளத்திலிருந்து வருகிறது — உங்கள் IP முகவரியிலிருந்து ஒருபோதும் அல்ல — எனவே சரிபார்ப்பு முடிந்ததும் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా దేశం మీ ధృవీకరించబడిన దేశస్థుల పోస్ట్‌లను చూపుతుంది. మీ దేశ జెండా మీ ధృవీకరించబడిన గుర్తింపు నుండి వస్తుంది — మీ IP చిరునామా నుండి ఎప్పుడూ కాదు — కాబట్టి ధృవీకరణ పూర్తయ్యాక అది కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเทศของฉันแสดงโพสต์จากเพื่อนร่วมชาติที่ยืนยันตัวตนแล้ว ธงประเทศของคุณมาจากตัวตนที่ยืนยันแล้ว ไม่ใช่จากที่อยู่ IP ของคุณ จึงปรากฏเมื่อการยืนยันเสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülkem, doğrulanmış yurttaşlarınızın gönderilerini gösterir. Ülke bayrağınız, IP adresinizden asla değil, doğrulanmış kimliğinizden gelir; bu yüzden doğrulama tamamlanınca görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Моя країна» показує дописи ваших верифікованих співвітчизників. Прапор вашої країни походить із вашої верифікованої особи — ніколи не з вашої IP-адреси — тому він з’явиться після завершення верифікації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرا ملک آپ کے تصدیق شدہ ہم وطنوں کی پوسٹس دکھاتا ہے۔ آپ کے ملک کا جھنڈا آپ کی تصدیق شدہ شناخت سے آتا ہے — آپ کے IP ایڈریس سے کبھی نہیں — اس لیے یہ تصدیق مکمل ہونے پر ظاہر ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc gia của tôi hiển thị bài đăng của đồng hương đã xác minh. Cờ quốc gia của bạn đến từ danh tính đã xác minh — không bao giờ từ địa chỉ IP — nên nó xuất hiện khi xác minh hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我的国家”显示已验证的同国人发布的帖子。你的国家旗帜来自你已验证的身份，而不是你的 IP 地址，因此验证完成后才会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「我的國家」會顯示已驗證的同鄉貼文。你的國家旗幟來自已驗證的身分，絕不是來自你的 IP 位址，因此完成驗證後才會出現。"
          }
        }
      }
    },
    "feed.noCountry.title": {
      "comment": "The documented 409 on My Country. An explainer, not a failure.",
      "extractionState": "manual",
      "localizations": {
