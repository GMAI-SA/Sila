          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionato. Tocca di nuovo per deselezionarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中。もう一度タップすると解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택됨. 다시 탭하면 해제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്തു. ഒഴിവാക്കാൻ വീണ്ടും ടാപ്പ് ചെയ്യുക."
