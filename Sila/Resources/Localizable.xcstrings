        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje meno, používateľské meno, obrázok, e-mail, heslo — a ako si všetko stiahnuť alebo odstrániť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt namn, användarnamn, din bild, e-post, ditt lösenord – och hur du laddar ner eller raderar allt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பெயர், ஹேண்டில், படம், மின்னஞ்சல், கடவுச்சொல் — மேலும் அனைத்தையும் பதிவிறக்குவது அல்லது நீக்குவது எப்படி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పేరు, హ్యాండిల్, చిత్రం, ఈమెయిల్, పాస్‌వర్డ్ — అలాగే అంతా డౌన్‌లోడ్ చేయడం లేదా తొలగించడం ఎలా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อ แฮนเดิล รูป อีเมล รหัสผ่านของคุณ และวิธีดาวน์โหลดหรือลบทุกอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız, kullanıcı adınız, fotoğrafınız, e-postanız, şifreniz; ayrıca her şeyi nasıl indirebileceğiniz veya silebileceğiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше ім’я, @ім’я, фото, пошта, пароль — і як завантажити або видалити все."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نام، ہینڈل، تصویر، ای میل، پاس ورڈ — اور ہر چیز ڈاؤن لوڈ یا حذف کرنے کا طریقہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên, tên người dùng, ảnh, email, mật khẩu của bạn — và cách tải xuống hoặc xóa mọi thứ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名称、用户名、头像、邮箱、密码，以及如何下载或删除全部数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名稱、代號、照片、電子郵件、密碼，以及如何下載或刪除所有資料。"
          }
        }
      }
    },
    "feed.profileOff.account.hint": {
      "comment": "VoiceOver hint for the account row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تفاصيل ملفك وبيانات دخولك وتصدير البيانات وحذف الحساب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইলের তথ্য, সাইন-ইনের তথ্য, ডেটা এক্সপোর্ট ও অ্যাকাউন্ট মোছা খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre les dades del perfil, les credencials d'inici de sessió, l'exportació de dades i l'eliminació del compte"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře údaje profilu, přihlašovací údaje, export dat a smazání účtu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner dine profiloplysninger, loginoplysninger, dataeksport og kontosletning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet deine Profilangaben, Anmeldedaten, den Datenexport und die Kontolöschung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τα στοιχεία προφίλ, τα διαπιστευτήρια σύνδεσης, την εξαγωγή δεδομένων και τη διαγραφή λογαριασμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your profile details, sign-in credentials, data export and account deletion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los datos de tu perfil, tus credenciales de acceso, la exportación de datos y la eliminación de cuenta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa profiilitietosi, kirjautumistunnuksesi, tietojen viennin ja tilin poiston"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les informations de votre profil, vos identifiants de connexion, l’export de données et la suppression du compte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את פרטי הפרופיל, פרטי ההתחברות, ייצוא הנתונים ומחיקת החשבון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रोफ़ाइल का विवरण, साइन-इन क्रेडेंशियल, डेटा एक्सपोर्ट और अकाउंट डिलीट खोलता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara podatke tvog profila, vjerodajnice za prijavu, izvoz podataka i brisanje računa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a profiladataidat, a bejelentkezési adataidat, az adatexportot és a fiók törlését"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka detail profil, kredensial masuk, ekspor data, dan penghapusan akun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre i dati del profilo, le credenziali di accesso, l'esportazione dei dati e l'eliminazione dell'account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールの詳細、サインイン情報、データのエクスポート、アカウントの削除を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 정보, 로그인 정보, 데이터 내보내기, 계정 삭제를 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പ്രൊഫൈൽ വിവരങ്ങൾ, സൈൻ ഇൻ വിവരങ്ങൾ, ഡാറ്റ എക്സ്പോർട്ട്, അക്കൗണ്ട് ഇല്ലാതാക്കൽ എന്നിവ തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka butiran profil, bukti kelayakan log masuk, eksport data dan pemadaman akaun anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner profilopplysningene, påloggingsopplysningene, dataeksporten og slettingen av kontoen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent je profielgegevens, inloggegevens, gegevensexport en accountverwijdering"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera dane profilu, dane logowania, eksport danych i usunięcie konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os dados do perfil, as credenciais de acesso, a exportação de dados e a exclusão da conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre os dados do seu perfil, credenciais de início de sessão, exportação de dados e eliminação da conta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide detaliile profilului, datele de autentificare, exportul datelor și ștergerea contului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает данные профиля, учётные данные для входа, экспорт данных и удаление аккаунта"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí údaje tvojho profilu, prihlasovacie údaje, export údajov a odstránenie účtu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar dina profiluppgifter, inloggningsuppgifter, dataexport och radering av konto"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சுயவிவர விவரங்கள், உள்நுழைவு விவரங்கள், தரவு ஏற்றுமதி, கணக்கு நீக்கத்தைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రొఫైల్ వివరాలు, సైన్-ఇన్ ఆధారాలు, డేటా ఎగుమతి, ఖాతా తొలగింపును తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดรายละเอียดโปรไฟล์ ข้อมูลลงชื่อเข้าใช้ การส่งออกข้อมูล และการลบบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil bilgilerinizi, giriş bilgilerinizi, veri dışa aktarımını ve hesap silmeyi açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває дані профілю, облікові дані для входу, експорт даних і видалення облікового запису"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پروفائل کی تفصیلات، سائن اِن کی معلومات، ڈیٹا ایکسپورٹ اور اکاؤنٹ حذف کرنا کھولتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thông tin hồ sơ, thông tin đăng nhập, xuất dữ liệu và xóa tài khoản của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你的个人资料详情、登录凭据、数据导出和账户删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟你的個人資料、登入憑證、資料匯出和帳號刪除"
          }
        }
      }
    },
