          "stringUnit": {
            "state": "translated",
            "value": "Mencipta akaun anda dan mengemel kod enam digit kepada anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppretter kontoen din og sender deg en sekssifret kode på e-post"
