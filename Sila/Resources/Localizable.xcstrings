        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ không xác nhận kịp thời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ 没有及时确认。"
