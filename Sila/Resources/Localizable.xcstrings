    "voice.micDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الميكروفون متوقف. فعّله من الإعدادات لتسجّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোনের অনুমতি বন্ধ। রেকর্ড করতে সেটিংসে চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accés al micròfon està desactivat. Activa'l a Ajustos per gravar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu je vypnutý. Pro nahrávání ho zapni v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen er slået fra. Slå den til i Indstillinger for at optage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist aus. Aktiviere ihn in den Einstellungen, um aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο μικρόφωνο είναι απενεργοποιημένη. Ενεργοποίησέ την στις Ρυθμίσεις για να ηχογραφήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off. Turn it on in Settings to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado. Actívalo en Ajustes para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttö on pois päältä. Ota se käyttöön Asetuksissa nauhoittaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est désactivé. Activez-le dans les Réglages pour enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למיקרופון כבויה. הפעל אותה בהגדרות כדי להקליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन का एक्सेस बंद है। रिकॉर्ड करने के लिए इसे सेटिंग्स में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup mikrofonu je isključen. Uključi ga u Postavkama da snimaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhozzáférés ki van kapcsolva. A felvételhez kapcsold be a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon mati. Nyalakan di Pengaturan untuk merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è disattivato. Attivalo in Impostazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフです。録音するには設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 꺼져 있어요. 녹음하려면 설정에서 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൈക്രോഫോൺ ആക്സസ് ഓഫാണ്. റെക്കോർഡ് ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ ഓണാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dimatikan. Hidupkannya dalam Tetapan untuk merakam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilgang er av. Slå den på i Innstillinger for å ta opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon staat uit. Zet hem aan in Instellingen om op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony. Włącz go w Ustawieniach, aby nagrywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Ative em Ajustes para gravar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Ative-o nas Definições para gravar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon este oprit. Activează-l în Setări pentru a înregistra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону выключен. Включите его в настройках, чтобы записывать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu je vypnutý. Na nahrávanie ho zapni v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomsten är av. Slå på den i Inställningar för att spela in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோன் அனுமதி அணைக்கப்பட்டுள்ளது. பதிவு செய்ய அமைப்புகளில் இயக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మైక్రోఫోన్ యాక్సెస్ ఆఫ్‌లో ఉంది. రికార్డ్ చేయడానికి సెట్టింగ్‌లలో ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงไมโครโฟนปิดอยู่ เปิดในการตั้งค่าเพื่ออัดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimi kapalı. Kayıt için Ayarlar'dan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона вимкнено. Увімкніть його в Налаштуваннях, щоб записувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون کی رسائی بند ہے۔ ریکارڈ کرنے کے لیے سیٹنگز میں آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập micro đang tắt. Hãy bật trong Cài đặt để ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限已关闭。请在“设置”中开启后再录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風存取權限已關閉。請在「設定」中開啟才能錄音。"
          }
        }
      }
