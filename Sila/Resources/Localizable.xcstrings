        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber deg bekrefte før noe trekkes tilbake"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt om bevestiging voordat er iets wordt ingetrokken"
