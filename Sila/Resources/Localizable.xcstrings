    "vouch.error.tooSoon": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قبول تزكية أخرى بعد 14 يومًا من انتهاء آخر تزكية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শেষ ভাউচ শেষ হওয়ার ১৪ দিন পর আপনি আরেকটি ভাউচ গ্রহণ করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots acceptar un altre aval 14 dies després que acabi l'últim."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další ručení můžeš přijmout 14 dní po skončení posledního."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan acceptere en ny garanti 14 dage efter, at din forrige ophørte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst eine weitere Bürgschaft 14 Tage nach dem Ende deiner letzten annehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να αποδεχτείς άλλη εγγύηση 14 ημέρες αφότου έληξε η τελευταία σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can accept another vouch 14 days after your last one ended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes aceptar otro aval 14 días después de que terminara el último."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit hyväksyä uuden takuun 14 päivän kuluttua edellisen päättymisestä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez accepter une autre caution 14 jours après la fin de la précédente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לקבל ערבות נוספת 14 ימים אחרי שהקודמת הסתיימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला वाउच खत्म होने के 14 दिन बाद ही आप दूसरा वाउच स्वीकार कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš prihvatiti novo jamstvo 14 dana nakon što je prethodno završilo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újabb kezességet az előző megszűnése után 14 nappal fogadhatsz el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menerima jaminan lain 14 hari setelah jaminan terakhirmu berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi accettare un'altra garanzia 14 giorni dopo la fine dell'ultima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の保証が終了してから14日後に、別の保証を受け入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 보증이 종료된 지 14일이 지난 후에 다른 보증을 수락할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കഴിഞ്ഞ വൗച്ച് അവസാനിച്ച് 14 ദിവസം കഴിഞ്ഞാൽ മറ്റൊരു വൗച്ച് സ്വീകരിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menerima jaminan lain 14 hari selepas jaminan terakhir anda berakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan godta en ny garanti 14 dager etter at den forrige ble avsluttet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt een nieuwe garantie accepteren 14 dagen nadat je vorige is beëindigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przyjąć kolejne poręczenie 14 dni po zakończeniu poprzedniego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode aceitar outro aval 14 dias depois do fim do último."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode aceitar outro aval 14 dias depois de o último ter terminado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți accepta o altă garanție la 14 zile după încheierea ultimei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять другое поручительство можно через 14 дней после окончания последнего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšie ručenie môžeš prijať 14 dní po skončení posledného."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan godta ett nytt intygande 14 dagar efter att ditt senaste avslutades."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடைசி உறுதிமொழி முடிந்த 14 நாட்களுக்குப் பிறகு இன்னொன்றை ஏற்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చివరి హామీ ముగిసిన 14 రోజుల తర్వాత మరో హామీని అంగీకరించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรับการรับรองครั้งใหม่ได้ 14 วันหลังจากครั้งล่าสุดสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kefilliğiniz bittikten 14 gün sonra başka bir kefilliği kabul edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прийняти інше поручительство можна через 14 днів після завершення попереднього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنی پچھلی ضمانت ختم ہونے کے 14 دن بعد دوسری ضمانت قبول کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chấp nhận lời bảo chứng khác 14 ngày sau khi lời trước kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你上一个担保结束 14 天后，才能接受新的担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你上一項擔保結束 14 天後，才能接受另一項擔保。"
