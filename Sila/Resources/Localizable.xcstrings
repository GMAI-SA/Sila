          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরুন যাতে আপনার মুখ বৃত্ত ভরে যায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou-te perquè la teva cara ompli el cercle"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuň se, aby tvůj obličej vyplnil kruh"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt dig, så dit ansigt fylder cirklen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege dich so, dass dein Gesicht den Kreis füllt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήσου ώστε το πρόσωπό σου να γεμίσει τον κύκλο"
