    "vouch.selfVerify.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا متاح لمن وثّقوا هويتهم بأنفسهم. يستغرق التوثيق دقائق، ثم يحمل اسمك كلمتك أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি তাঁদের জন্য খোলা যাঁরা নিজের পরিচয় ভেরিফাই করেছেন। এতে কয়েক মিনিট লাগে, আর এরপর আপনার নাম আপনার নিজের কথায় চলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Està obert als membres que han verificat la seva pròpia identitat. Triga uns minuts, i després el teu nom es sosté amb la teva pròpia paraula."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je otevřeno členům, kteří ověřili vlastní totožnost. Trvá to několik minut a tvé jméno pak nese tvé vlastní slovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er åbent for medlemmer, der selv har verificeret deres identitet. Det tager et par minutter, og dit navn bærer så dit eget ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das steht Mitgliedern offen, die ihre eigene Identität verifiziert haben. Es dauert ein paar Minuten, und dein Name trägt dann dein eigenes Wort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ανοιχτό σε μέλη που επαλήθευσαν την ταυτότητά τους. Παίρνει λίγα λεπτά και μετά το όνομά σου φέρει τον δικό σου λόγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's open to members who verified their own identity. It takes a few minutes, and your name then carries your own word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está abierto a los miembros que verificaron su propia identidad. Lleva unos minutos y, después, tu nombre cuenta con tu propia palabra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on avoin jäsenille, jotka ovat vahvistaneet oman henkilöllisyytensä. Se vie muutaman minuutin, ja nimesi takana on sen jälkeen oma sanasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ouvert aux membres qui ont vérifié leur propre identité. Cela prend quelques minutes, et votre nom repose ensuite sur votre propre parole."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה פתוח לחברים שאימתו את זהותם בעצמם. זה לוקח כמה דקות, ואז השם שלך נושא את המילה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उन सदस्यों के लिए खुला है जिन्होंने अपनी पहचान खुद सत्यापित की है। इसमें कुछ मिनट लगते हैं, और फिर आपका नाम आपके अपने वचन पर टिकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvoreno je za članove koji su sami potvrdili svoj identitet. Traje nekoliko minuta, a tvoje ime tada nosi tvoju vlastitu riječ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azoknak a tagoknak nyitott, akik saját maguk hitelesítették a személyazonosságukat. Pár perc, és a neved ezután a saját szavadat hordozza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbuka untuk anggota yang memverifikasi identitasnya sendiri. Hanya beberapa menit, dan namamu lalu dibawa oleh kata-katamu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È aperto ai membri che hanno verificato la propria identità. Ci vogliono pochi minuti, e poi il tuo nome si regge sulla tua parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で本人確認をしたメンバーが利用できます。数分で完了し、あなたの名前はあなた自身の言葉で裏付けられるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 신원을 인증한 멤버에게 열려 있어요. 몇 분이면 되고, 인증하면 내 이름이 내 자신의 말로 뒷받침돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്ത അംഗങ്ങൾക്ക് ഇത് തുറന്നിരിക്കുന്നു. കുറച്ച് മിനിറ്റ് മതി, തുടർന്ന് നിങ്ങളുടെ പേര് നിങ്ങളുടെ സ്വന്തം വാക്ക് വഹിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia terbuka kepada ahli yang mengesahkan identitinya sendiri. Ia mengambil masa beberapa minit, dan nama anda kemudian bergantung pada kata-kata anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er åpent for medlemmer som har verifisert sin egen identitet. Det tar noen minutter, og navnet ditt står da på ditt eget ord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het staat open voor leden die hun eigen identiteit hebben geverifieerd. Het duurt een paar minuten, en daarna draagt je naam je eigen woord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest otwarte dla członków, którzy zweryfikowali własną tożsamość. Zajmuje to kilka minut, a Twoje imię opiera się wtedy na Twoim własnym słowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está aberto a membros que verificaram a própria identidade. Leva poucos minutos, e seu nome passa a valer pela sua própria palavra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está aberto aos membros que verificaram a própria identidade. Demora alguns minutos e depois o seu nome passa a valer pela sua própria palavra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este deschisă membrilor care și-au verificat propria identitate. Durează câteva minute, iar apoi numele tău poartă propriul tău cuvânt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это доступно участникам, прошедшим собственную проверку личности. Она занимает несколько минут, и после неё ваше имя подкреплено вашим собственным словом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je otvorené členom, ktorí si overili vlastnú totožnosť. Trvá to pár minút a tvoje meno potom nesie tvoje vlastné slovo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är öppet för medlemmar som verifierat sin egen identitet. Det tar några minuter, och sedan bär ditt namn ditt eget ord."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது தங்கள் அடையாளத்தைத் தாங்களே சரிபார்த்த உறுப்பினர்களுக்குத் திறந்திருக்கும். சில நிமிடங்களே ஆகும்; பிறகு உங்கள் பெயர் உங்கள் சொந்த வாக்கைத் தாங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది తమ గుర్తింపును స్వయంగా ధృవీకరించుకున్న సభ్యులకు తెరిచి ఉంటుంది. దీనికి కొన్ని నిమిషాలు పడుతుంది, ఆ తర్వాత మీ పేరు మీ స్వంత మాటను మోస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดให้สมาชิกที่ยืนยันตัวตนด้วยตัวเองเท่านั้น ใช้เวลาไม่กี่นาที และชื่อของคุณจะมีคำรับรองของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi kimliğini doğrulayan üyelere açık. Birkaç dakika sürer ve sonra adınız kendi sözünüzü taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відкрите для учасників, які верифікували власну особу. Це займає кілька хвилин, і тоді ваше ім’я тримається на вашому власному слові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ان ارکان کے لیے کھلا ہے جنہوں نے اپنی شناخت کی خود تصدیق کی ہو۔ اس میں چند منٹ لگتے ہیں، اور پھر آپ کے نام کے پیچھے آپ کی اپنی بات ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho thành viên đã tự xác minh danh tính. Chỉ mất vài phút, và tên của bạn sẽ mang lời của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限自行验证过身份的成员使用。只需几分钟，之后你的名字就由你自己担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這項功能開放給已自行驗證身分的成員。只需幾分鐘，之後你的名字就以你自己的信用為憑。"
          }
        }
      }
    },
