        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlákno krajiny. Odpovedať môžu iba overené účty z krajiny %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landstråd. Bara verifierade konton i %@ kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாட்டு உரையாடல். %@ இல் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేశ థ్రెడ్. %@లో ధృవీకరించబడిన ఖాతాలు మాత్రమే రిప్లై ఇవ్వగలవు."
          }
