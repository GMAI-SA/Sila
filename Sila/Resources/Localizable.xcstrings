    "verification.approved.continue.hint": {
      "comment": "A11y hint on the approved CTA.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّث حسابك وينقلك إلى «معروف»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট রিফ্রেশ করে Known-এ নিয়ে যায়"
          }
        },
