    "notifications.sentence.identityImpostor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون حساب آخر يدّعي أنه أنت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি অ্যাকাউন্ট নিজেকে আপনি বলে দাবি করতে পারে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altre compte pot estar fent-se passar per tu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiný účet se může vydávat za tebe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden konto udgiver sig muligvis for at være dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Konto gibt sich möglicherweise als du aus"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άλλος λογαριασμός μπορεί να παριστάνει εσένα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account may be claiming to be you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra cuenta puede estar haciéndose pasar por ti"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen tili voi esiintyä sinuna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte prétend peut-être être vous"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון אחר אולי מתחזה לך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है कोई दूसरा अकाउंट आपका होने का दावा कर रहा हो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi račun možda se izdaje za tebe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik fiók esetleg a nevedben lép fel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun lain mungkin mengaku sebagai kamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro account potrebbe spacciarsi per te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントがあなたになりすましている可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정이 나를 사칭하고 있을 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു അക്കൗണ്ട് നിങ്ങളാണെന്ന് അവകാശപ്പെടുന്നുണ്ടാകാം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun lain mungkin mengaku sebagai anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen konto utgir seg kanskje for å være deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander account doet zich mogelijk als jou voor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne konto może podawać się za Ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta pode estar se passando por você"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta pode estar a fazer-se passar por si"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt cont ar putea pretinde că ești tu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой аккаунт, возможно, выдаёт себя за вас"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za teba sa môže vydávať iný účet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat konto kan utge sig för att vara du"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறொரு கணக்கு நீங்கள் என்று கூறிக்கொள்ளக்கூடும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో ఖాతా మీరని చెప్పుకుంటూ ఉండవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจมีบัญชีอื่นแอบอ้างเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir hesap sizmişsiniz gibi davranıyor olabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший обліковий запис, можливо, видає себе за вас"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو سکتا ہے کوئی دوسرا اکاؤنٹ آپ ہونے کا دعویٰ کر رہا ہو"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tài khoản khác có thể đang mạo danh bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有其他账户可能在冒充你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他帳號可能冒充你"
          }
        }
      }
    },
