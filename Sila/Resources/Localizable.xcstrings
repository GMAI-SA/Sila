    "preferences.topics.chooseHint": {
      "extractionState": "manual",
      "comment": "Above the topic tiles: what tapping one does to the feed.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موضوعًا ليظهر المزيد منه في خلاصتك فورًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি বিষয় বেছে নিন, আপনার ফিড তা আরও বেশি দেখাতে শুরু করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un tema i el teu canal començarà a mostrar-ne més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber téma a tvůj kanál ho začne zobrazovat víc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et emne, så begynder dit feed at vise mere af det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Thema, und dein Feed zeigt mehr davon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε ένα θέμα και η ροή σου αρχίζει να δείχνει περισσότερα από αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a subject and your feed starts showing more of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tema y tu feed empezará a mostrar más de él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse aihe, niin syötteesi alkaa näyttää sitä enemmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un sujet et votre fil commencera à en montrer davantage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר נושא והפיד שלך יתחיל להציג ממנו יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विषय चुनें और आपकी फ़ीड उसे ज़्यादा दिखाने लगेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi temu i tvoj feed će početi prikazivati više nje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy témát, és a hírfolyamod többet mutat belőle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sebuah topik dan feed-mu mulai menampilkan lebih banyak tentangnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un argomento e il tuo feed inizierà a mostrarne di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分野を選ぶと、フィードにその分野がより多く表示されるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제를 고르면 피드에 그 주제가 더 많이 나와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു വിഷയം തിരഞ്ഞെടുക്കുക, നിങ്ങളുടെ ഫീഡ് അതിൽ കൂടുതൽ കാണിച്ചുതുടങ്ങും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih subjek dan suapan anda mula memaparkan lebih banyak tentangnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et tema, så begynner feeden din å vise mer av det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een onderwerp en je feed gaat er meer van tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz temat, a Twój kanał zacznie pokazywać go częściej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um assunto e seu feed passa a mostrar mais dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um assunto e o seu feed passa a mostrar mais sobre ele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un subiect și fluxul tău începe să arate mai mult din el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тему, и лента начнёт показывать больше такого."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber tému a tvoj kanál ti začne ukazovať viac z nej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett ämne så börjar ditt flöde visa mer av det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தலைப்பைத் தேர்ந்தெடுங்கள், உங்கள் ஊட்டம் அதை அதிகம் காட்டத் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక అంశాన్ని ఎంచుకోండి, మీ ఫీడ్ దానిలో ఎక్కువ చూపడం మొదలుపెడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเรื่องหนึ่ง แล้วฟีดของคุณจะเริ่มแสดงเรื่องนั้นมากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir konu seçin, akışınız ondan daha fazla göstermeye başlasın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть тему, і ваша стрічка почне показувати її більше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی موضوع چنیں اور آپ کی فیڈ اس کا مزید دکھانا شروع کر دے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một chủ đề và bảng tin của bạn bắt đầu hiển thị nhiều hơn về nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个主题，你的信息流就会显示更多相关内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個主題，你的動態就會顯示更多相關內容。"
          }
        }
      }
    },
    "preferences.topics.emptySlice": {
      "comment": "Shown when the chosen topic filter matches no rows.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مواضيع في هذه القائمة بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই তালিকায় এখনও কোনো বিষয় নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha temes en aquesta llista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto seznamu zatím nejsou žádná témata."
