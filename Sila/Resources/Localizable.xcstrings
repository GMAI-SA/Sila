    "account.delete.effect.sessions": {
      "comment": "Consequence 2: every session ends, and signing back in is the undo.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل الخروج من كل الجلسات، على هذا الجهاز وعلى غيره. وتسجيل الدخول من جديد هو ما تفعله للتراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস ও অন্য সব ডিভাইসের সব সেশন সাইন আউট হয়ে যায়। এটি ফেরাতে চাইলে আবার সাইন ইন করতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tanquen totes les sessions, en aquest dispositiu i en tots els altres. Per desfer-ho, només cal que tornis a iniciar la sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna přihlášení se odhlásí, na tomto i na všech ostatních zařízeních. Zpět to vrátíš novým přihlášením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sessioner logges ud, på denne enhed og alle andre. Du fortryder ved at logge ind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sitzungen werden abgemeldet, auf diesem und auf jedem anderen Gerät. Um das rückgängig zu machen, meldest du dich einfach wieder an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνεται αποσύνδεση από κάθε συνεδρία, σε αυτή και σε κάθε άλλη συσκευή. Για να το αναιρέσεις, απλώς συνδέεσαι ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session is signed out, on this device and every other one. Signing back in is what you would do to undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierran todas las sesiones, en este dispositivo y en los demás. Para deshacerlo, solo tienes que volver a iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki istunnot kirjataan ulos, tällä laitteella ja kaikilla muilla. Takaisin kirjautuminen on tapa perua tämä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les sessions sont déconnectées, sur cet appareil et sur les autres. Pour annuler, il suffit de vous reconnecter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההתחברויות מנותקות, במכשיר הזה ובכל מכשיר אחר. התחברות מחדש היא הדרך לבטל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस और बाकी सभी डिवाइस पर हर सेशन साइन आउट हो जाता है। इसे पलटने के लिए आपको दोबारा साइन इन करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve sesije se odjavljuju, na ovom i na svim ostalim uređajima. Ponovna prijava je ono što bi napravio/la da ovo poništiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden munkamenetből kijelentkeztetünk, ezen az eszközön és az összes többin is. A visszavonáshoz csak újra be kell jelentkezned."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sesi dikeluarkan, di perangkat ini dan semua perangkat lain. Masuk kembali adalah cara untuk membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le sessioni vengono chiuse, su questo dispositivo e su tutti gli altri. Per annullare basta accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを含め、すべてのセッションがサインアウトされます。取り消すには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기와 다른 모든 기기에서 로그아웃돼요. 다시 로그인하면 되돌릴 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിലും മറ്റെല്ലാ ഉപകരണങ്ങളിലും എല്ലാ സെഷനുകളും സൈൻ ഔട്ട് ആകും. ഇത് തിരുത്താൻ വീണ്ടും സൈൻ ഇൻ ചെയ്താൽ മതി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap sesi dilog keluar, pada peranti ini dan semua peranti lain. Log masuk semula ialah cara untuk membatalkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle økter logges ut, på denne enheten og alle andre. Å logge inn igjen er måten å angre dette på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sessies worden uitgelogd, op dit apparaat en op alle andere. Opnieuw inloggen is hoe je dit ongedaan maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie sesje zostaną wylogowane — na tym urządzeniu i na każdym innym. Ponowne zalogowanie to sposób, by to cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as sessões são encerradas, neste e em todos os outros dispositivos. Entrar novamente é o que desfaz isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as sessões são terminadas, neste dispositivo e em todos os outros. Para anular isto, basta iniciar sessão novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate sesiunile sunt deconectate, pe acest dispozitiv și pe toate celelalte. Pentru a anula, te autentifici din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сеансы будут завершены — на этом устройстве и на всех остальных. Чтобы отменить это, достаточно снова войти."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky relácie sa odhlásia, na tomto zariadení aj na všetkých ostatných. Opätovné prihlásenie je spôsob, ako to vrátiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla sessioner loggas ut, på den här enheten och på alla andra. Att logga in igen är sättet att ångra det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனம் உட்பட எல்லாச் சாதனங்களிலும் உள்ள அமர்வுகள் வெளியேற்றப்படும். இதை மாற்ற மீண்டும் உள்நுழைவதே வழி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో, ఇతర అన్ని పరికరాల్లో ప్రతి సెషన్ సైన్ అవుట్ అవుతుంది. దీన్ని రద్దు చేయాలంటే తిరిగి సైన్ ఇన్ చేయడమే మార్గం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเซสชันจะถูกออกจากระบบ ทั้งบนอุปกรณ์เครื่องนี้และเครื่องอื่น การลงชื่อเข้าใช้อีกครั้งคือวิธีที่คุณจะยกเลิกการลบนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki ve diğer tüm cihazlardaki oturumlar kapatılır. Bunu geri almak için yeniden giriş yapmanız yeterlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі сеанси завершуються — на цьому та на всіх інших пристроях. Щоб це скасувати, достатньо знову увійти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس اور ہر دوسری ڈیوائس پر تمام سیشن سائن آؤٹ ہو جاتے ہیں۔ اسے واپس کرنے کے لیے آپ کو بس دوبارہ سائن اِن کرنا ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phiên đăng nhập đều bị đăng xuất, trên thiết bị này và mọi thiết bị khác. Đăng nhập lại chính là cách để hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有会话都会退出登录，包括本设备和其他设备。想要撤销，重新登录即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本裝置和所有其他裝置都會登出。若想復原，重新登入即可。"
          }
        }
      }
    },
    "account.delete.exportFirst": {
      "comment": "Urges a data export before deletion, because it cannot be requested afterwards.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل نسخة من بياناتك أولًا إن أردت الاحتفاظ بها. الأمر لا يستغرق سوى لحظات، ولا يمكنك طلبها بعد الحذف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাখতে চাইলে আগে আপনার ডেটার একটি কপি ডাউনলোড করুন। এতে অল্প সময় লাগে, আর পরে এটি চাওয়া যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega primer una còpia de les teves dades si vols conservar-les. Només triga un moment i després ja no la podràs demanar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud si chceš data ponechat, nejdřív si stáhni jejich kopii. Chvíli to trvá a později už o ni požádat nepůjde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en kopi af dine data først, hvis du vil beholde dem. Det tager et øjeblik, og du kan ikke bede om det bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade zuerst eine Kopie deiner Daten herunter, wenn du sie behalten möchtest. Das dauert einen Moment und ist danach nicht mehr möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατέβασε πρώτα ένα αντίγραφο των δεδομένων σου αν θέλεις να τα κρατήσεις. Παίρνει λίγο χρόνο και δεν μπορείς να το ζητήσεις μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a copy of your data first if you want to keep it. It takes a moment and you cannot ask for it afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga antes una copia de tus datos si quieres conservarla. Tarda un momento y después ya no podrás pedirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa ensin kopio tiedoistasi, jos haluat säilyttää ne. Se vie hetken, eikä sitä voi pyytää jälkikäteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez d’abord une copie de vos données si vous voulez les conserver. Cela prend un instant et vous ne pourrez plus la demander ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורד קודם עותק של הנתונים שלך אם אתה רוצה לשמור אותם. זה לוקח רגע, ואי אפשר לבקש אותם אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर अपना डेटा रखना चाहते हैं तो पहले उसकी कॉपी डाउनलोड कर लें। इसमें बस कुछ पल लगते हैं, और बाद में आप इसे माँग नहीं सकेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako želiš zadržati svoje podatke, prvo preuzmi njihovu kopiju. Traje samo trenutak, a poslije je više ne možeš zatražiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha meg szeretnéd őrizni az adataidat, előbb töltsd le a másolatukat. Egy pillanat az egész, és utólag már nem kérheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh salinan datamu dulu jika ingin menyimpannya. Hanya butuh sebentar dan tidak bisa diminta setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica prima una copia dei tuoi dati se vuoi conservarli. Ci vuole un attimo e dopo non potrai richiederla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを残したい場合は、先にコピーをダウンロードしてください。少し時間がかかります。削除後は請求できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 보관하고 싶다면 먼저 사본을 내려받으세요. 잠깐이면 되고, 삭제 후에는 요청할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂക്ഷിക്കണമെങ്കിൽ ആദ്യം നിങ്ങളുടെ ഡാറ്റയുടെ ഒരു പകർപ്പ് ഡൗൺലോഡ് ചെയ്യുക. ഇതിന് ഒരു നിമിഷം മതി; പിന്നീട് ഇത് ആവശ്യപ്പെടാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun salinan data anda dahulu jika anda mahu menyimpannya. Ia hanya ambil sekejap dan anda tidak boleh memintanya selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned en kopi av dataene dine først hvis du vil beholde dem. Det tar et øyeblikk, og du kan ikke be om det etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download eerst een kopie van je gegevens als je die wilt bewaren. Het duurt even en achteraf kan het niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli chcesz zachować swoje dane, najpierw pobierz ich kopię. To chwilę trwa, a potem nie będzie już można o nią poprosić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe antes uma cópia dos seus dados, se quiser guardá-los. É rápido, e não será possível pedir depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quiser guardar os seus dados, transfira primeiro uma cópia. Demora um instante e não poderá pedi-la depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă mai întâi o copie a datelor tale, dacă vrei să le păstrezi. Durează puțin și nu o vei mai putea cere după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если хотите сохранить свои данные, сначала скачайте их копию. Это быстро, а потом запросить её будет нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš svoje údaje zachovať, najprv si stiahni ich kópiu. Trvá to chvíľu a potom už oň požiadať nemôžeš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner en kopia av dina data först om du vill behålla dem. Det går snabbt, och du kan inte begära dem efteråt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்துக்கொள்ள விரும்பினால் முதலில் உங்கள் தரவின் நகலைப் பதிவிறக்குங்கள். சிறிது நேரம் ஆகும்; பிறகு அதைக் கேட்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డేటాను ఉంచుకోవాలంటే ముందు దాని కాపీని డౌన్‌లోడ్ చేసుకోండి. దీనికి కొద్ది సమయం పడుతుంది, తర్వాత దాన్ని అడగలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเก็บข้อมูลไว้ ให้ดาวน์โหลดสำเนาข้อมูลของคุณก่อน ใช้เวลาไม่นาน และคุณจะขอได้อีกไม่ได้ในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklamak istiyorsanız önce verilerinizin bir kopyasını indirin. Birkaç saniye sürer ve sonradan isteyemezsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу завантажте копію своїх даних, якщо хочете їх зберегти. Це займе хвилину, а потім вимагати її вже не вийде."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اپنا ڈیٹا رکھنا چاہتے ہیں تو پہلے اس کی کاپی ڈاؤن لوڈ کریں۔ اس میں تھوڑی دیر لگتی ہے اور بعد میں آپ اسے مانگ نہیں سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tải bản sao dữ liệu của bạn trước nếu muốn giữ lại. Chỉ mất một lúc và bạn không thể yêu cầu sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果想保留数据，请先下载一份副本。这只需片刻，之后将无法再申请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若想保留資料，請先下載一份副本。只需片刻，之後就無法再申請。"
          }
        }
      }
    },
