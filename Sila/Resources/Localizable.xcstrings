    "feed.delete.confirm.message": {
      "comment": "States exactly what a delete destroys. There is no undo on the server.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف من كل الصفحات والسلاسل ونتائج البحث. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সব ফিড, থ্রেড ও সার্চ ফলাফল থেকে সরিয়ে দেয়। এটি আর ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això l'elimina de tots els canals, fils i resultats de cerca. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odstraní ze všech kanálů, vláken i výsledků hledání. Nelze to vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fjerner det fra alle feeds, tråde og søgeresultater. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird er aus allen Feeds, Threads und Suchergebnissen entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό την αφαιρεί από κάθε ροή, νήμα και αποτέλεσμα αναζήτησης. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes it from every feed, thread and search result. It cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto la quita de todos los feeds, hilos y resultados de búsqueda. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa sen kaikista syötteistä, ketjuista ja hakutuloksista. Sitä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela le retire de tous les fils, discussions et résultats de recherche. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מסיר אותו מכל פיד, שרשור ותוצאת חיפוש. אי אפשר לבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इसे हर फ़ीड, थ्रेड और खोज नतीजे से हटा देता है। इसे वापस नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je uklanja iz svakog feeda, niti i rezultata pretraživanja. Ne može se poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel minden hírfolyamból, szálból és keresési találatból eltűnik. Nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapusnya dari semua feed, utas, dan hasil pencarian. Tidak bisa dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso da ogni feed, discussione e risultato di ricerca. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフィード、スレッド、検索結果から削除されます。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 피드, 스레드, 검색 결과에서 사라져요. 되돌릴 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് എല്ലാ ഫീഡുകളിൽ നിന്നും ത്രെഡുകളിൽ നിന്നും തിരയൽ ഫലങ്ങളിൽ നിന്നും നീക്കം ചെയ്യും. ഇത് തിരിച്ചെടുക്കാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengalih keluarnya daripada setiap suapan, utas dan hasil carian. Ia tidak boleh dibuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner det fra alle feeder, tråder og søkeresultater. Det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert het uit alle feeds, threads en zoekresultaten. Het kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis zniknie ze wszystkich kanałów, wątków i wyników wyszukiwania. Tego nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso o remove de todos os feeds, fios e resultados de busca. Não pode ser desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove-a de todos os feeds, conversas e resultados de pesquisa. Não pode ser anulado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta o elimină din toate fluxurile, conversațiile și rezultatele căutării. Nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост исчезнет из всех лент, веток и результатов поиска. Это нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni sa zo všetkých kanálov, vlákien a výsledkov vyhľadávania. Nedá sa to vrátiť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tas bort från alla flöden, trådar och sökresultat. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது எல்லா ஊட்டங்கள், உரையாடல்கள், தேடல் முடிவுகளிலிருந்து இதை நீக்கும். திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది దీన్ని ప్రతి ఫీడ్, థ్రెడ్, శోధన ఫలితం నుండి తొలగిస్తుంది. దీన్ని వెనక్కి తీసుకోలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบจะนำโพสต์ออกจากทุกฟีด เธรด และผลการค้นหา และไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, gönderiyi tüm akışlardan, konuşmalardan ve arama sonuçlarından kaldırır. Geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це прибере його з усіх стрічок, обговорень і результатів пошуку. Це неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اسے ہر فیڈ، تھریڈ اور سرچ نتیجے سے ہٹا دیتا ہے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này xóa bài khỏi mọi bảng tin, chuỗi trả lời và kết quả tìm kiếm. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将其从所有信息流、对话串和搜索结果中移除，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將它從所有動態、串文和搜尋結果中移除，且無法復原。"
          }
        }
      }
    },
