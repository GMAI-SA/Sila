          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliği doğrulanmamış · %2$@ tarihinden beri @%1$@ kefil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Особу не верифіковано · за нього(неї) ручається @%1$@ з %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شناخت کی تصدیق نہیں · %2$@ سے @%1$@ کی ضمانت یافتہ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh danh tính · được @%1$@ bảo chứng từ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
