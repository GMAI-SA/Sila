    "push.vouch_claimed": {
      "comment": "Push notification body, shown from the loc-key alone: it names nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل أحدهم تزكيتك — أكّد أنه هو"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার সুপারিশ গ্রহণ করেছে — নিশ্চিত করুন যে এটি সেই ব্যক্তিই"
