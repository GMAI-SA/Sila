    "safety.menu.block.hint": {
      "comment": "VoiceOver hint for the block item, which opens a confirmation rather than blocking.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب تأكيدك أولًا، ويوضّح ما الذي يزيله الحظر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে নিশ্চিত করতে বলে, এবং ব্লক কী কী সরায় তা জানায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer et demana confirmació i diu què elimina un bloqueig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se zeptá na potvrzení a řekne, co blokace odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beder dig først om at bekræfte og siger, hvad en blokering fjerner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt zuerst nach einer Bestätigung und sagt, was eine Blockierung entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητά πρώτα επιβεβαίωση και εξηγεί τι αφαιρεί ένας αποκλεισμός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks you to confirm first, and says what a block removes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pide confirmación primero y explica qué elimina un bloqueo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyytää ensin vahvistusta ja kertoo, mitä esto poistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande d’abord confirmation, et indique ce que retire un blocage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבקש אישור קודם, ואומר מה חסימה מסירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले पुष्टि माँगता है, और बताता है कि ब्लॉक क्या हटाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo traži potvrdu i kaže što blokada uklanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először megerősítést kér, és elmondja, mit távolít el a letiltás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta konfirmasimu dulu, dan menjelaskan apa yang dihapus oleh pemblokiran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ti chiede conferma e dice cosa rimuove un blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に確認が表示され、ブロックで何が除かれるかを説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 확인을 요청하고 차단하면 무엇이 사라지는지 알려줘요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം സ്ഥിരീകരണം ചോദിക്കുകയും ബ്ലോക്ക് എന്തെല്ലാം ഇല്ലാതാക്കുമെന്ന് പറയുകയും ചെയ്യുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta anda mengesahkan dahulu, dan menyatakan apa yang dialih keluar oleh sekatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber deg bekrefte først, og sier hva en blokkering fjerner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt eerst om bevestiging en zegt wat een blokkade verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw prosi o potwierdzenie i mówi, co usuwa blokada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede sua confirmação antes e diz o que um bloqueio remove."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede confirmação primeiro e diz o que um bloqueio remove."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți cere mai întâi confirmarea și spune ce elimină o blocare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала попросит подтверждения и объяснит, что убирает блокировка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv sa opýta na potvrdenie a povie, čo blokovanie odstráni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber dig bekräfta först och säger vad en blockering tar bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் உறுதிப்படுத்தக் கேட்கும், தடை எதை நீக்கும் என்பதையும் சொல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందు నిర్ధారించమని అడుగుతుంది, బ్లాక్ ఏమి తొలగిస్తుందో చెబుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้คุณยืนยันก่อน และบอกว่าการบล็อกลบอะไรบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce onay ister ve bir engelin neleri kaldırdığını söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу просить підтвердження й пояснює, що прибирає блокування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے آپ سے تصدیق مانگتا ہے، اور بتاتا ہے کہ بلاک کیا ہٹاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu bạn xác nhận trước, và cho biết chặn sẽ loại bỏ điều gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先请你确认，并说明屏蔽会移除什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會先請你確認，並說明封鎖會移除什麼。"
          }
        }
      }
    },
    "safety.menu.button.a11yHint": {
      "comment": "VoiceOver hint for the safety menu button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ عن هذا الحساب أو كتمه أو حظره"
