    "document.consent.line1": {
      "comment": "Contract v34 §7.2 consent card. Line 1.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن وضعت علامة في المربع، تبقى صور هويتك وصورتك الذاتية مشفّرةً في ملف التحقق الخاص بك بعد القرار، إلى جانب البيانات المقروءة من هويتك التي نحتفظ بها في كل تحقق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাক্সে টিক দিলে সিদ্ধান্তের পরও আপনার আইডির ছবি ও সেলফি এনক্রিপ্টেড অবস্থায় আপনার ভেরিফিকেশন ফাইলে থাকে, প্রতিটি ভেরিফিকেশনের জন্য আমরা আপনার আইডি থেকে পড়া যে তথ্য রাখি তার পাশে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si marques la casella, les fotos del document i el selfie es conserven al teu fitxer de verificació després de la decisió, xifrades, al costat de les dades llegides del teu document que conservem en cada verificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud políčko zaškrtneš, fotografie tvého dokladu a selfie zůstanou po rozhodnutí v ověřovacím souboru, šifrované, vedle údajů přečtených z dokladu, které uchováváme při každém ověření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du sætter kryds, bliver dine id-fotos og selfie i din verificeringsfil efter afgørelsen, krypteret, sammen med de oplysninger, der er læst fra dit id, og som vi gemmer ved enhver verificering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Kästchen anhakst, bleiben deine Ausweisfotos und dein Selfie nach der Entscheidung verschlüsselt in deiner Verifizierungsakte, neben den aus deinem Ausweis gelesenen Angaben, die wir bei jeder Verifizierung aufbewahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν επιλέξεις το πλαίσιο, οι φωτογραφίες της ταυτότητάς σου και η selfie παραμένουν στον φάκελο επαλήθευσής σου μετά την απόφαση, κρυπτογραφημένες, μαζί με τα στοιχεία που διαβάστηκαν από την ταυτότητά σου και κρατάμε σε κάθε επαλήθευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you tick the box, your ID photos and selfie stay in your verification file after the decision, encrypted, next to the details read from your ID that we keep for every verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si marcas la casilla, las fotos de tu documento y tu selfie permanecen en tu expediente de verificación tras la decisión, cifradas, junto a los datos leídos de tu documento que guardamos en cada verificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos valitset ruudun, henkilöllisyystodistuksen kuvat ja selfie jäävät vahvistustiedostoosi päätöksen jälkeen salattuina, henkilöllisyystodistuksesta luettujen tietojen viereen, joita säilytämme jokaisesta vahvistuksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous cochez la case, vos photos d’identité et votre selfie restent dans votre dossier de vérification après la décision, chiffrés, à côté des informations lues sur votre pièce d’identité que nous conservons pour chaque vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תסמן את התיבה, תמונות תעודת הזהות והסלפי שלך יישארו בתיק האימות שלך אחרי ההחלטה, מוצפנות, לצד הפרטים שנקראו מתעודת הזהות שאנחנו שומרים בכל אימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप बॉक्स टिक करते हैं, तो फ़ैसले के बाद आपकी ID की फ़ोटो और सेल्फ़ी आपकी सत्यापन फ़ाइल में एन्क्रिप्टेड रखी जाती हैं, उन जानकारियों के साथ जो हम हर सत्यापन के लिए आपकी ID से पढ़कर रखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako označiš okvir, fotografije tvoje isprave i selfie ostaju u tvojoj datoteci za provjeru nakon odluke, šifrirani, uz podatke pročitane s tvoje isprave koje čuvamo za svaku provjeru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bejelölöd a négyzetet, az azonosítód fotói és a szelfid a döntés után is titkosítva a hitelesítési aktádban maradnak, az azonosítódból beolvasott adatok mellett, amelyeket minden hitelesítésnél megőrzünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu mencentang kotaknya, foto ID dan selfie-mu tetap ada di berkas verifikasimu setelah keputusan, terenkripsi, di samping detail yang dibaca dari ID-mu yang kami simpan untuk setiap verifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se selezioni la casella, le foto del documento e il selfie restano nel tuo fascicolo di verifica dopo la decisione, cifrati, accanto ai dati letti dal tuo documento che conserviamo per ogni verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックを入れると、ID写真と自撮りは、判断後も暗号化された状態で認証ファイルに保管されます。IDから読み取った詳細情報(すべての認証で保管されるもの)とともに保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크하면 결정이 내려진 후에도 신분증 사진과 셀카가 암호화되어 인증 파일에 남아요. 모든 인증에서 보관하는, 신분증에서 읽은 정보와 함께 보관돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോക്സ് ടിക്ക് ചെയ്താൽ, തീരുമാനത്തിന് ശേഷവും നിങ്ങളുടെ ഐഡി ഫോട്ടോകളും സെൽഫിയും, ഓരോ പരിശോധനയ്ക്കും ഞങ്ങൾ സൂക്ഷിക്കുന്ന ഐഡിയിൽ നിന്ന് വായിച്ച വിവരങ്ങൾക്കൊപ്പം, എൻക്രിപ്റ്റ് ചെയ്ത് നിങ്ങളുടെ പരിശോധനാ ഫയലിൽ സൂക്ഷിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menanda kotak itu, foto ID dan swafoto anda kekal dalam fail pengesahan anda selepas keputusan, disulitkan, bersama butiran yang dibaca daripada ID anda yang kami simpan untuk setiap pengesahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du krysser av, blir ID-bildene og selfien din liggende i verifiseringsmappen din etter avgjørelsen, kryptert, ved siden av opplysningene lest fra ID-en din som vi lagrer for hver verifisering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het vakje aanvinkt, blijven je identiteitsfoto's en selfie na de beslissing versleuteld in je verificatiedossier staan, naast de gegevens uit je identiteitsbewijs die we bij elke verificatie bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zaznaczysz to pole, zdjęcia dokumentu i selfie pozostaną w Twojej teczce weryfikacyjnej po podjęciu decyzji, zaszyfrowane, obok danych odczytanych z dokumentu, które przechowujemy przy każdej weryfikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você marcar a caixa, as fotos do seu documento e a selfie ficam no seu arquivo de verificação depois da decisão, criptografadas, junto com os dados lidos do seu documento que guardamos em toda verificação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se selecionar a caixa, as fotos do seu documento e a selfie ficam no seu ficheiro de verificação depois da decisão, cifradas, junto dos dados lidos do seu documento que guardamos em todas as verificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă bifezi caseta, fotografiile actului și selfie-ul rămân în dosarul tău de verificare după decizie, criptate, alături de datele citite din act pe care le păstrăm la fiecare verificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если поставите галочку, фото документа и селфи останутся в вашем файле проверки после принятия решения — в зашифрованном виде, рядом с данными, считанными с документа, которые мы храним при каждой проверке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak políčko zaškrtneš, fotky tvojho dokladu a selfie zostanú po rozhodnutí v tvojom overovacom spise, zašifrované, spolu s údajmi prečítanými z tvojho dokladu, ktoré uchovávame pri každom overení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du kryssar i rutan ligger dina id-bilder och din selfie kvar i din verifieringsfil efter beslutet, krypterade, bredvid uppgifterna som lästs från ditt id och som vi sparar för varje verifiering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெட்டியைக் குறித்தால், முடிவுக்குப் பிறகும் உங்கள் அடையாளப் புகைப்படங்களும் செல்ஃபியும் ஒவ்வொரு சரிபார்ப்புக்கும் நாங்கள் வைக்கும் உங்கள் அடையாள அட்டையிலிருந்து படித்த விவரங்களுடன் குறியாக்கம் செய்யப்பட்டு உங்கள் சரிபார்ப்புக் கோப்பில் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు బాక్స్‌ను టిక్ చేస్తే, నిర్ణయం తర్వాత కూడా మీ ID ఫోటోలు, సెల్ఫీ ఎన్‌క్రిప్ట్ చేయబడి మీ ధృవీకరణ ఫైల్‌లో ఉంటాయి, ప్రతి ధృవీకరణకు మేము ఉంచే మీ ID నుండి చదివిన వివరాల పక్కనే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณติ๊กช่องนี้ รูปบัตรและเซลฟีของคุณจะอยู่ในแฟ้มยืนยันตัวตนหลังการตัดสิน โดยเข้ารหัสไว้ ควบคู่กับรายละเอียดที่อ่านจากบัตรของคุณซึ่งเราเก็บไว้ในทุกการยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuyu işaretlerseniz kimlik fotoğraflarınız ve selfie'niz, karardan sonra da şifreli olarak doğrulama dosyanızda kalır; her doğrulama için sakladığımız, kimliğinizden okunan bilgilerin yanında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви позначите цей прапорець, фото вашого документа та селфі залишаться у вашому файлі верифікації після ухвалення рішення в зашифрованому вигляді, поруч із даними з вашого документа, які ми зберігаємо для кожної верифікації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ خانے پر نشان لگائیں تو فیصلے کے بعد بھی آپ کے شناختی کارڈ کی تصاویر اور سیلفی آپ کی تصدیقی فائل میں انکرپٹڈ رہتی ہیں، ان تفصیلات کے ساتھ جو ہم ہر تصدیق کے لیے آپ کے شناختی کارڈ سے پڑھ کر رکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đánh dấu ô này, ảnh giấy tờ và ảnh selfie của bạn sẽ ở lại trong hồ sơ xác minh sau khi có quyết định, được mã hóa, cạnh các thông tin đọc từ giấy tờ mà chúng tôi giữ cho mọi lần xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你勾选此框，在作出决定后，你的证件照片和自拍会加密保存在你的验证档案中，与我们在每次验证时保存的、从证件读取的详细信息放在一起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你勾選此選項，在作出決定後，你的證件照片和自拍會加密保留在你的驗證檔案中，與我們每次驗證都會保存的、從證件讀取的資料放在一起。"
          }
        }
      }
    },
    "document.consent.line2": {
      "comment": "Contract v34 §7.2 consent card. Line 2.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطّلع على ملفك إلا موظفو «معروف» الموثَّقون، ويُسجَّل كل اطّلاع. نستخدمه فقط للتحقق من هويتك ولمنع الحسابات المزيّفة والمكرّرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু Known-এর যাচাইকৃত কর্মীরা আপনার ফাইল খুলতে পারেন, এবং প্রতিবার খোলার তথ্য নথিভুক্ত হয়। আমরা এটি কেবল আপনার পরিচয় যাচাই এবং ভুয়া ও একই ব্যক্তির একাধিক অ্যাকাউন্ট ঠেকাতে ব্যবহার করি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només el personal verificat de Known pot obrir el teu fitxer, i cada vegada que ho fa queda registrat. Només el fem servir per comprovar la teva identitat i evitar comptes falsos i duplicats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor může otevřít jen ověřený personál aplikace Known a pokaždé se to zaznamená. Používáme ho jen k ověření tvé totožnosti a k zamezení falešných a duplicitních účtů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Knowns verificerede medarbejdere kan åbne din fil, og hver gang de gør det, bliver det registreret. Vi bruger den kun til at kontrollere din identitet og til at stoppe falske konti og dubletter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verifizierte Mitarbeitende von Known können deine Akte öffnen, und jedes Öffnen wird protokolliert. Wir nutzen sie ausschließlich, um deine Identität zu prüfen und gefälschte und doppelte Konten zu verhindern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο το εξουσιοδοτημένο προσωπικό του Known μπορεί να ανοίξει τον φάκελό σου και κάθε φορά που το κάνει καταγράφεται. Τον χρησιμοποιούμε μόνο για να ελέγξουμε την ταυτότητά σου και να αποτρέψουμε ψεύτικους και διπλούς λογαριασμούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Known's verified staff can open your file, and every time they do is recorded. We use it only to check your identity and to stop fake and duplicate accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el personal verificado de Known puede abrir tu expediente, y cada vez que lo hace queda registrado. Lo usamos únicamente para comprobar tu identidad y evitar cuentas falsas y duplicadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain Knownin vahvistettu henkilökunta voi avata tiedostosi, ja jokainen avaus kirjataan. Käytämme sitä vain henkilöllisyytesi tarkistamiseen sekä väärien ja kaksoistilien estämiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le personnel vérifié de Known peut ouvrir votre dossier, et chaque ouverture est enregistrée. Nous l’utilisons uniquement pour vérifier votre identité et empêcher les faux comptes et les doublons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק צוות מאומת של Known יכול לפתוח את התיק שלך, וכל פעם שהוא עושה זאת היא נרשמת. אנחנו משתמשים בו רק כדי לבדוק את זהותך ולעצור חשבונות מזויפים וכפולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ाइल केवल Known के सत्यापित स्टाफ़ खोल सकते हैं, और हर बार खोलना दर्ज होता है। हम इसका उपयोग सिर्फ़ आपकी पहचान जाँचने और नकली व डुप्लिकेट अकाउंट रोकने के लिए करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoju datoteku mogu otvoriti samo provjereni djelatnici aplikacije Known, a svako otvaranje se bilježi. Koristimo je samo za provjeru tvog identiteta i sprječavanje lažnih i dvostrukih računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktádat csak a Known hitelesített munkatársai nyithatják meg, és minden megnyitás naplózva van. Kizárólag a személyazonosságod ellenőrzésére, valamint hamis és duplikált fiókok megakadályozására használjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya staf terverifikasi Known yang bisa membuka berkasmu, dan setiap pembukaan dicatat. Kami memakainya hanya untuk memeriksa identitasmu dan mencegah akun palsu dan ganda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il personale verificato di Known può aprire il tuo fascicolo, e ogni accesso viene registrato. Lo usiamo solo per verificare la tua identità e per fermare account falsi e duplicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開けるのはKnownの認証済みスタッフだけで、開くたびに記録されます。本人確認と、偽アカウントや重複アカウントの防止にのみ使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known의 인증된 직원만 내 파일을 열 수 있고, 열 때마다 기록이 남아요. 신원 확인과 가짜 계정 및 중복 계정 방지에만 사용해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ന്റെ പരിശോധിച്ച ജീവനക്കാർക്ക് മാത്രമേ നിങ്ങളുടെ ഫയൽ തുറക്കാനാകൂ, ഓരോ തവണ തുറക്കുന്നതും രേഖപ്പെടുത്തും. നിങ്ങളുടെ ഐഡന്റിറ്റി പരിശോധിക്കാനും വ്യാജ, ഇരട്ട അക്കൗണ്ടുകൾ തടയാനും മാത്രമേ ഇത് ഉപയോഗിക്കൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kakitangan Known yang disahkan boleh membuka fail anda, dan setiap kali mereka berbuat demikian ia direkodkan. Kami hanya menggunakannya untuk menyemak identiti anda dan menghalang akaun palsu dan pendua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare Knowns verifiserte ansatte kan åpne mappen din, og hver gang de gjør det, loggføres det. Vi bruker den bare til å kontrollere identiteten din og stoppe falske kontoer og duplikatkontoer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geverifieerd personeel van Known kan je dossier openen, en elke keer dat ze dat doen wordt vastgelegd. We gebruiken het alleen om je identiteit te controleren en nep- en dubbele accounts tegen te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko zweryfikowani pracownicy Known mogą otworzyć Twoją teczkę, a każde otwarcie jest rejestrowane. Używamy jej wyłącznie do sprawdzenia Twojej tożsamości oraz przeciwdziałania fałszywym i zdublowanym kontom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a equipe autorizada do Known pode abrir seu arquivo, e cada acesso fica registrado. Usamos o arquivo apenas para conferir sua identidade e impedir contas falsas e duplicadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o pessoal verificado da Known pode abrir o seu ficheiro, e cada abertura fica registada. Usamo-lo apenas para verificar a sua identidade e impedir contas falsas e duplicadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar personalul verificat al Known îți poate deschide dosarul, iar fiecare deschidere este înregistrată. Îl folosim doar pentru a-ți verifica identitatea și a opri conturile false și duplicate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть ваш файл могут только проверенные сотрудники Known, и каждое открытие записывается. Мы используем его только для проверки личности и борьбы с поддельными и дублирующими аккаунтами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj spis môžu otvoriť iba overení zamestnanci Known a každé otvorenie sa zaznamenáva. Používame ho iba na overenie tvojej totožnosti a na zabránenie falošným a duplicitným účtom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara Knowns verifierade personal kan öppna din fil, och varje gång de gör det loggas det. Vi använder den bara för att kontrollera din identitet och stoppa falska konton och dubbletter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இன் சரிபார்க்கப்பட்ட பணியாளர்கள் மட்டுமே உங்கள் கோப்பைத் திறக்க முடியும், ஒவ்வொரு முறையும் அது பதிவு செய்யப்படும். உங்கள் அடையாளத்தைச் சரிபார்க்கவும் போலி, நகல் கணக்குகளைத் தடுக்கவும் மட்டுமே இதைப் பயன்படுத்துகிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known యొక్క ధృవీకరించబడిన సిబ్బంది మాత్రమే మీ ఫైల్‌ను తెరవగలరు, వారు తెరిచిన ప్రతిసారీ నమోదు చేయబడుతుంది. మేము దీన్ని మీ గుర్తింపును తనిఖీ చేయడానికి, నకిలీ మరియు డూప్లికేట్ ఖాతాలను ఆపడానికి మాత్రమే ఉపయోగిస్తాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเจ้าหน้าที่ที่ได้รับการยืนยันของ Known เท่านั้นที่เปิดแฟ้มของคุณได้ และทุกครั้งที่เปิดจะมีการบันทึกไว้ เราใช้เพื่อตรวจสอบตัวตนของคุณและป้องกันบัญชีปลอมและบัญชีซ้ำเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanızı yalnızca Known'un doğrulanmış personeli açabilir ve her açışları kaydedilir. Dosyayı yalnızca kimliğinizi kontrol etmek ve sahte ve mükerrer hesapları durdurmak için kullanırız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити ваш файл можуть лише верифіковані співробітники Known, і кожне таке відкриття фіксується. Ми використовуємо його лише для перевірки вашої особи та для боротьби з фальшивими й дубльованими обліковими записами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی فائل صرف Known کا تصدیق شدہ عملہ کھول سکتا ہے، اور جب بھی وہ کھولتے ہیں اس کا ریکارڈ رکھا جاتا ہے۔ ہم اسے صرف آپ کی شناخت جانچنے اور جعلی اور دہرے اکاؤنٹ روکنے کے لیے استعمال کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhân viên đã được xác minh của Known mới mở được hồ sơ của bạn, và mỗi lần mở đều được ghi lại. Chúng tôi chỉ dùng nó để kiểm tra danh tính của bạn và ngăn tài khoản giả và trùng lặp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Known 经过验证的工作人员可以打开你的档案，每次打开都会有记录。我们仅将其用于核实你的身份，以及阻止虚假和重复的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Known 經過驗證的工作人員能開啟你的檔案，且每次開啟都會留下紀錄。我們僅將其用於核對你的身分，以及防止偽造和重複的帳號。"
          }
        }
      }
    },
    "document.consent.line3": {
      "comment": "Contract v34 §7.2 consent card. Line 3, the transfer-stated wording (true today). Gate G3: if the model moves to the Kingdom, replace with the in-Kingdom wording from the contract before release.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص الصورَ أولًا نظامٌ آلي على جهاز يديره «معروف» في كندا؛ تصل إليه مشفّرةً ولا تُحفظ هناك. ولا تُرسَل أبدًا إلى ذكاء اصطناعي لأي شركة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কানাডায় Known-এর চালানো একটি কম্পিউটারে স্বয়ংক্রিয় যাচাই প্রথমে ছবিগুলো দেখে; সেগুলো এনক্রিপ্টেড অবস্থায় সেখানে যায় এবং সেখানে রাখা হয় না। সেগুলো কখনও অন্য কোনো কোম্পানির AI-তে পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprovació automàtica en un ordinador que Known gestiona al Canadà mira primer les fotos; hi viatgen xifrades i no s'hi conserven. Mai s'envien a la IA d'una altra empresa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografie nejdřív prověří automatická kontrola na počítači, který Known provozuje v Kanadě; putují tam šifrovaně a neuchovávají se tam. Nikdy se neposílají AI jiné společnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatisk kontrol på en computer, som Known driver i Canada, ser først på fotoene. De sendes derhen krypteret og gemmes ikke der. De sendes aldrig til et andet firmas AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine automatische Prüfung auf einem Rechner, den Known in Kanada betreibt, sieht sich die Fotos zuerst an; sie werden verschlüsselt dorthin übertragen und dort nicht gespeichert. Sie werden nie an die KI eines anderen Unternehmens gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας αυτόματος έλεγχος σε υπολογιστή που λειτουργεί το Known στον Καναδά εξετάζει πρώτα τις φωτογραφίες· ταξιδεύουν εκεί κρυπτογραφημένες και δεν διατηρούνται εκεί. Δεν στέλνονται ποτέ στην τεχνητή νοημοσύνη άλλης εταιρείας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An automatic check on a computer Known runs in Canada looks at the photos first; they travel there encrypted and are not kept there. They are never sent to another company's AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación automática en un ordenador que Known gestiona en Canadá examina primero las fotos; viajan cifradas hasta allí y no se conservan. Nunca se envían a la IA de otra empresa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen tarkistus Knownin ylläpitämällä tietokoneella Kanadassa katsoo kuvat ensin; ne kulkevat sinne salattuina eikä niitä säilytetä siellä. Niitä ei koskaan lähetetä toisen yrityksen tekoälylle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contrôle automatique, sur un ordinateur exploité par Known au Canada, examine d’abord les photos ; elles y transitent chiffrées et n’y sont pas conservées. Elles ne sont jamais envoyées à l’IA d’une autre entreprise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקה אוטומטית במחשב ש-Known מפעילה בקנדה בוחנת את התמונות קודם; הן עוברות לשם מוצפנות ולא נשמרות שם. הן אף פעם לא נשלחות לבינה מלאכותית של חברה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनाडा में Known के चलाए कंप्यूटर पर एक स्वचालित जाँच पहले फ़ोटो देखती है; वे वहाँ एन्क्रिप्टेड पहुँचती हैं और वहाँ रखी नहीं जातीं। उन्हें किसी दूसरी कंपनी के AI को कभी नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatska provjera na računalu koje Known pokreće u Kanadi prva pregledava fotografije; one tamo putuju šifrirane i ne zadržavaju se. Nikada se ne šalju umjetnoj inteligenciji druge tvrtke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotókat előbb egy Kanadában üzemeltetett, a Known által futtatott számítógépen végzett automatikus ellenőrzés vizsgálja; titkosítva jutnak oda, és nem maradnak ott. Más cég mesterséges intelligenciájának soha nem küldjük el őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan otomatis di komputer yang dijalankan Known di Kanada melihat foto lebih dulu; foto dikirim ke sana terenkripsi dan tidak disimpan di sana. Foto tidak pernah dikirim ke AI perusahaan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un controllo automatico su un computer gestito da Known in Canada esamina prima le foto; vi arrivano cifrate e lì non vengono conservate. Non vengono mai inviate all'IA di un'altra azienda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownがカナダで運用するコンピューターによる自動チェックが、まず写真を確認します。写真は暗号化されて送られ、そこには保管されません。他社のAIに送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 먼저 Known이 캐나다에서 운영하는 컴퓨터의 자동 확인을 거쳐요. 암호화되어 전송되며 그곳에는 보관되지 않아요. 다른 회사의 AI로는 절대 보내지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം Known കാനഡയിൽ നടത്തുന്ന ഒരു കമ്പ്യൂട്ടറിലെ ഓട്ടോമാറ്റിക് പരിശോധന ഫോട്ടോകൾ നോക്കും; അവ എൻക്രിപ്റ്റ് ചെയ്താണ് അവിടെ എത്തുന്നത്, അവിടെ സൂക്ഷിക്കില്ല. അവ മറ്റൊരു കമ്പനിയുടെ AI-ക്ക് ഒരിക്കലും അയയ്ക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan automatik pada komputer yang dikendalikan Known di Kanada melihat foto itu dahulu; ia dihantar ke sana dalam keadaan disulitkan dan tidak disimpan di sana. Ia tidak pernah dihantar kepada AI syarikat lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatisk kontroll på en datamaskin som Known driver i Canada, ser på bildene først. De sendes dit kryptert og lagres ikke der. De sendes aldri til et annet selskaps KI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een automatische controle op een computer die Known in Canada beheert, bekijkt eerst de foto's; ze worden versleuteld daarheen gestuurd en worden daar niet bewaard. Ze worden nooit naar de AI van een ander bedrijf gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zdjęcia analizuje automatyczna kontrola na komputerze prowadzonym przez Known w Kanadzie; trafiają tam zaszyfrowane i nie są tam przechowywane. Nigdy nie są wysyłane do sztucznej inteligencji innej firmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação automática, em um computador que o Known opera no Canadá, analisa as fotos primeiro; elas viajam até lá criptografadas e não ficam guardadas lá. Elas nunca são enviadas à IA de outra empresa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação automática, num computador que a Known gere no Canadá, analisa primeiro as fotos; estas seguem para lá cifradas e não são lá guardadas. Nunca são enviadas para a IA de outra empresa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai întâi, o verificare automată pe un computer rulat de Known în Canada analizează fotografiile; ele ajung acolo criptate și nu sunt păstrate. Nu sunt trimise niciodată către IA-ul altei companii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала фото проверяет автоматическая система на компьютере Known в Канаде; они передаются туда в зашифрованном виде и там не хранятся. Они никогда не отправляются в ИИ другой компании."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky najprv posúdi automatická kontrola na počítači, ktorý Known prevádzkuje v Kanade; putujú tam zašifrované a neuchovávajú sa tam. Nikdy sa neposielajú AI inej spoločnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatisk kontroll på en dator som Known driver i Kanada tittar först på bilderna; de skickas dit krypterade och sparas inte där. De skickas aldrig till något annat företags AI."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில், கனடாவில் Known இயக்கும் கணினியில் தானியங்கிச் சோதனை புகைப்படங்களைப் பார்க்கும்; அவை குறியாக்கத்துடன் அங்கு செல்லும், அங்கு சேமிக்கப்படாது. அவை வேறொரு நிறுவனத்தின் AI-க்கு ஒருபோதும் அனுப்பப்படுவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కెనడాలో Known నడిపే కంప్యూటర్‌లో ఆటోమేటిక్ తనిఖీ ముందుగా ఫోటోలను చూస్తుంది; అవి ఎన్‌క్రిప్ట్ అయి అక్కడికి వెళ్తాయి, అక్కడ నిల్వ ఉండవు. వాటిని మరే కంపెనీ AIకు పంపరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบอัตโนมัติบนคอมพิวเตอร์ที่ Known ดูแลในแคนาดาจะดูรูปก่อน รูปจะถูกส่งไปที่นั่นแบบเข้ารหัสและไม่ถูกเก็บไว้ที่นั่น และจะไม่ถูกส่งให้ AI ของบริษัทอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflara önce Known'un Kanada'da çalıştırdığı bir bilgisayardaki otomatik bir kontrol bakar; oraya şifreli olarak gider ve orada saklanmaz. Başka bir şirketin yapay zekasına asla gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу фото перевіряє автоматична перевірка на комп’ютері, яким Known керує в Канаді; вони передаються туди зашифрованими й там не зберігаються. Їх ніколи не надсилають до ШІ іншої компанії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known کے کینیڈا میں چلنے والے کمپیوٹر پر ایک خودکار جانچ پہلے تصاویر دیکھتی ہے؛ وہ انکرپٹڈ حالت میں وہاں جاتی ہیں اور وہاں رکھی نہیں جاتیں۔ انہیں کسی دوسری کمپنی کے AI کو کبھی نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bước kiểm tra tự động trên máy tính do Known vận hành ở Canada xem các ảnh trước; ảnh được truyền đến đó đã mã hóa và không được giữ lại ở đó. Ảnh không bao giờ được gửi cho AI của công ty khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会先由 Known 在加拿大运行的一台计算机进行自动检查；照片加密传输，且不会保留在那里。照片绝不会发送给其他公司的 AI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會先由 Known 在加拿大營運的電腦進行自動檢查；照片會加密傳送到該處，且不會保留在那裡。照片絕不會傳送給其他公司的 AI。"
          }
        }
      }
    },
    "document.consent.line4": {
      "comment": "Contract v34 §7.2 consent card. Line 4.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمر متروك لك: يمكن توثيقك دون العلامة، وتُحذف صورك عند البتّ في طلبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিদ্ধান্ত আপনার: টিক না দিলেও আপনি ভেরিফায়েড হতে পারবেন, এবং ভেরিফিকেশনের সিদ্ধান্ত হলে আপনার ছবিগুলো মুছে ফেলা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Depèn de tu: sense la marca també et pots verificar, i les teves fotos s'eliminen quan es decideix la verificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to na tobě: bez zaškrtnutí se můžeš ověřit také a fotografie se po rozhodnutí o ověření smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er op til dig: Uden kryds kan du stadig blive verificeret, og dine fotos slettes, så snart din verificering er afgjort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entscheidest du: Auch ohne Haken kannst du verifiziert werden, und deine Fotos werden gelöscht, sobald über deine Verifizierung entschieden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαρτάται από εσένα: χωρίς την επιλογή μπορείς πάλι να επαληθευτείς και οι φωτογραφίες σου διαγράφονται μόλις ληφθεί απόφαση για την επαλήθευσή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's up to you: without the tick you can still be verified, and your photos are deleted once your verification is decided."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depende de ti: sin marcar la casilla igualmente puedes verificarte, y tus fotos se eliminan en cuanto se decide tu verificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinta on sinun: ilman rastia voit silti tulla vahvistetuksi, ja kuvasi poistetaan, kun vahvistuksesi on ratkaistu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est vous qui décidez : sans cocher, vous pouvez quand même être vérifié, et vos photos sont supprimées dès que votre vérification est décidée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה תלוי בך: גם בלי הסימון אפשר להיות מאומת, והתמונות שלך נמחקות ברגע שהאימות שלך הוכרע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी मर्ज़ी है: टिक किए बिना भी आप सत्यापित हो सकते हैं, और आपके सत्यापन का फ़ैसला होते ही आपकी फ़ोटो हटा दी जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odluka je tvoja: bez oznake i dalje možeš biti potvrđen/a, a tvoje fotografije se brišu čim se odluči o tvojoj provjeri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te döntésed: pipa nélkül is hitelesíthetnek, és a fotóid a hitelesítésed elbírálása után törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terserah kamu: tanpa centang kamu tetap bisa diverifikasi, dan fotomu dihapus begitu verifikasimu diputuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta a te: senza la selezione puoi comunque essere verificato, e le tue foto vengono eliminate non appena la verifica è decisa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選ぶのはあなたです。チェックを入れなくても認証は受けられ、写真は認証の判断が出た時点で削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택은 내 몫이에요. 체크하지 않아도 인증받을 수 있으며, 인증 결정이 나면 사진은 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീരുമാനം നിങ്ങളുടേതാണ്: ടിക്ക് ചെയ്യാതെയും പരിശോധിക്കപ്പെടാം, പരിശോധനയിൽ തീരുമാനമായാലുടൻ നിങ്ങളുടെ ഫോട്ടോകൾ ഇല്ലാതാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpulang kepada anda: tanpa tanda itu anda masih boleh disahkan, dan foto anda dipadam sebaik sahaja pengesahan anda diputuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er opp til deg: uten avkryssingen kan du fortsatt bli verifisert, og bildene dine slettes når verifiseringen er avgjort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is aan jou: zonder vinkje kun je nog steeds worden geverifieerd, en je foto's worden verwijderd zodra over je verificatie is beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decyzja należy do Ciebie: bez zaznaczenia nadal możesz zostać zweryfikowany, a Twoje zdjęcia zostaną usunięte po rozstrzygnięciu weryfikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escolha é sua: sem marcar, você ainda pode ser verificado, e suas fotos são excluídas assim que sua verificação for decidida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A decisão é sua: sem a seleção, pode na mesma ser verificado, e as suas fotos são eliminadas assim que a verificação for decidida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Depinde de tine: fără bifă poți fi totuși verificat, iar fotografiile tale sunt șterse imediat ce verificarea este decisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решать вам: без галочки вас всё равно можно проверить, а фото удаляются, как только по проверке принято решение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to na tebe: bez zaškrtnutia sa môžeš stále overiť a tvoje fotky sa po rozhodnutí o overení odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är upp till dig: utan krysset kan du ändå verifieras, och dina bilder raderas när beslutet om din verifiering har fattats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்கள் விருப்பம்: குறிக்காவிட்டாலும் சரிபார்க்கப்படலாம், உங்கள் சரிபார்ப்பு முடிவானதும் உங்கள் புகைப்படங்கள் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీ ఇష్టం: టిక్ చేయకపోయినా మీరు ధృవీకరించబడవచ్చు, మీ ధృవీకరణపై నిర్ణయం వచ్చాక మీ ఫోటోలు తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้นอยู่กับคุณ: หากไม่ติ๊ก คุณก็ยังยืนยันตัวตนได้ และรูปของคุณจะถูกลบเมื่อมีการตัดสินการยืนยันของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar sizin: işaret koymazsanız da doğrulanabilirsiniz ve doğrulamanız karara bağlandığında fotoğraflarınız silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це на ваш розсуд: без позначки вас усе одно можна верифікувати, а ваші фото видаляються після ухвалення рішення про верифікацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فیصلہ آپ کا ہے: نشان کے بغیر بھی آپ کی تصدیق ہو سکتی ہے، اور آپ کی تصدیق کا فیصلہ ہوتے ہی آپ کی تصاویر حذف ہو جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy bạn quyết định: không đánh dấu bạn vẫn được xác minh, và ảnh của bạn bị xóa ngay khi có quyết định xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你决定：不勾选也可以完成验证，你的照片会在验证作出决定后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由你決定：不勾選也能通過驗證，且在驗證結果出爐後，你的照片就會被刪除。"
          }
        }
      }
    },
    "document.consent.line5": {
      "comment": "Consent card line 5 (contract v34 §7.2), iPhone wording: %@ is the route to the Verification photos row built from the app's own labels (Profile › Account › Privacy › Verification photos). iOS has no screen named Settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت رأيك؟ اسحب موافقتك في أي وقت من %@، فتُحذف الصور المحفوظة. وتُحذف كذلك عند حذف حسابك، أو فورًا إن سحبت هذا الطلب قبل القرار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মত বদলেছে? যেকোনো সময় %@-এ প্রত্যাহার করুন, রাখা ছবিগুলো মুছে ফেলা হবে। আপনার অ্যাকাউন্ট মুছলেও সেগুলো মুছে যায়, অথবা সিদ্ধান্তের আগে এই জমা প্রত্যাহার করলে সঙ্গে সঙ্গে মুছে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has canviat d'opinió? Retira-ho en qualsevol moment a %@ i les fotos conservades s'eliminen. També s'eliminen quan s'elimina el teu compte, o a l'instant si retires aquest enviament abans d'una decisió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmyslel ses? Kdykoli to odvolej v %@ a uchované fotografie se smažou. Smažou se také při smazání účtu, nebo okamžitě, pokud podání stáhneš před rozhodnutím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du ombestemt dig? Træk samtykket tilbage når som helst i %@, så slettes de gemte fotos. De slettes også, når din konto slettes, eller med det samme, hvis du trækker denne indsendelse tilbage før en afgørelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meinung geändert? Widerrufe jederzeit unter %@, dann werden die gespeicherten Fotos gelöscht. Sie werden auch gelöscht, wenn dein Konto gelöscht wird, oder sofort, wenn du diese Einreichung vor einer Entscheidung zurückziehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξες γνώμη; Ανάκλησε οποτεδήποτε στις %@ και οι φωτογραφίες που κρατήθηκαν διαγράφονται. Διαγράφονται επίσης όταν διαγραφεί ο λογαριασμός σου ή αμέσως αν ανακαλέσεις αυτή την υποβολή πριν από την απόφαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed your mind? Withdraw any time in %@, and the kept photos are deleted. They are also deleted when your account is deleted, or at once if you withdraw this submission before a decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has cambiado de idea? Retira tu consentimiento cuando quieras en %@ y las fotos guardadas se eliminan. También se eliminan al borrar tu cuenta, o al instante si retiras este envío antes de que se decida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutitko mieltäsi? Peru milloin tahansa kohdassa %@, niin säilytetyt kuvat poistetaan. Ne poistetaan myös, kun tilisi poistetaan, tai heti, jos peruutat tämän lähetyksen ennen päätöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez changé d’avis ? Retirez votre accord à tout moment dans %@, et les photos conservées sont supprimées. Elles le sont aussi à la suppression de votre compte, ou immédiatement si vous retirez cet envoi avant une décision."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינית את דעתך? אפשר לבטל בכל עת ב-%@, והתמונות השמורות יימחקו. הן נמחקות גם כשהחשבון נמחק, או מיד אם אתה מושך את ההגשה הזו לפני החלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मन बदल गया? %@ में कभी भी वापस ले लें, और रखी गई फ़ोटो हटा दी जाएँगी। अकाउंट हटाने पर भी वे हट जाती हैं, या फ़ैसले से पहले यह सबमिशन वापस लेने पर तुरंत।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predomislio/la si se? Povuci suglasnost bilo kada u: %@, a zadržane fotografije bit će izbrisane. Brišu se i kad se izbriše tvoj račun, ili odmah ako povučeš ovu prijavu prije odluke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meggondoltad magad? Bármikor visszavonhatod itt: %@, és a megőrzött fotók törlődnek. A fiókod törlésekor is törlődnek, illetve azonnal, ha a beküldést az elbírálás előtt visszavonod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berubah pikiran? Tarik persetujuan kapan saja di %@, dan foto yang disimpan akan dihapus. Foto juga dihapus saat akunmu dihapus, atau seketika jika kamu menarik pengajuan ini sebelum diputuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai cambiato idea? Revoca quando vuoi in %@, e le foto conservate vengono eliminate. Vengono eliminate anche quando elimini il tuo account, o subito se ritiri questo invio prima di una decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気が変わったら、%@でいつでも撤回でき、保管された写真は削除されます。アカウントを削除したときにも削除されます。判断が出る前にこの申請を取り下げた場合は、ただちに削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음이 바뀌었나요? %@에서 언제든 철회할 수 있고, 보관된 사진은 삭제돼요. 계정을 삭제하거나 결정 전에 이 제출을 철회하면 사진은 즉시 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മനസ്സ് മാറിയോ? %@-ൽ എപ്പോൾ വേണമെങ്കിലും പിൻവലിക്കാം, സൂക്ഷിച്ച ഫോട്ടോകൾ ഇല്ലാതാക്കും. നിങ്ങളുടെ അക്കൗണ്ട് ഇല്ലാതാക്കുമ്പോഴും അവ ഇല്ലാതാക്കും; തീരുമാനത്തിന് മുമ്പ് ഈ സമർപ്പണം പിൻവലിച്ചാൽ ഉടൻ ഇല്ലാതാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berubah fikiran? Tarik balik pada bila-bila masa dalam %@, dan foto yang disimpan dipadam. Ia juga dipadam apabila akaun anda dipadam, atau serta-merta jika anda menarik balik penghantaran ini sebelum keputusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombestemt deg? Trekk tilbake når som helst i %@, så slettes de lagrede bildene. De slettes også når kontoen din slettes, eller umiddelbart hvis du trekker tilbake denne innsendingen før en avgjørelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedacht je je? Trek je toestemming op elk moment in bij %@, en de bewaarde foto's worden verwijderd. Ze worden ook verwijderd als je account wordt verwijderd, of direct als je deze aanvraag intrekt voordat er is beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniłeś zdanie? Wycofaj zgodę w dowolnym momencie w: %@, a zachowane zdjęcia zostaną usunięte. Zostaną też usunięte wraz z kontem lub od razu, jeśli wycofasz zgłoszenie przed decyzją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou de ideia? Retire o consentimento a qualquer momento em %@, e as fotos guardadas serão excluídas. Elas também são excluídas quando sua conta é excluída, ou imediatamente se você retirar este envio antes de uma decisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou de ideias? Retire o consentimento em qualquer altura em %@, e as fotos guardadas são eliminadas. Também são eliminadas quando a sua conta for eliminada, ou de imediato se retirar este envio antes de uma decisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te-ai răzgândit? Retrage-ți acordul oricând în %@, iar fotografiile păstrate sunt șterse. Sunt șterse și când contul îți este șters, sau imediat dacă retragi acest dosar înainte de decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передумали? Отзовите согласие в любой момент в разделе «%@» — сохранённые фото будут удалены. Они также удаляются при удалении аккаунта или сразу, если вы отзовёте заявку до решения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmyslel si sa? Kedykoľvek to odvolaj v %@ a uchované fotky sa odstránia. Odstránia sa aj pri odstránení tvojho účtu, alebo okamžite, ak odvoláš túto žiadosť pred rozhodnutím."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ångrar du dig? Dra tillbaka samtycket när som helst i %@, så raderas de sparade bilderna. De raderas också när ditt konto raderas, eller direkt om du drar tillbaka inskickningen innan beslut har fattats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மனம் மாறியதா? %@ இல் எப்போது வேண்டுமானாலும் திரும்பப் பெறலாம், வைத்திருந்த புகைப்படங்கள் நீக்கப்படும். உங்கள் கணக்கை நீக்கும்போதும், முடிவுக்கு முன் இந்தச் சமர்ப்பிப்பை நீங்கள் திரும்பப் பெற்றால் உடனேயும் அவை நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మనసు మారిందా? %@లో ఎప్పుడైనా ఉపసంహరించుకోవచ్చు, ఉంచిన ఫోటోలు తొలగించబడతాయి. మీ ఖాతా తొలగించినప్పుడు కూడా అవి తొలగించబడతాయి, లేదా నిర్ణయానికి ముందే ఈ సమర్పణను ఉపసంహరిస్తే వెంటనే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนใจ? ถอนความยินยอมได้ทุกเมื่อใน%@ แล้วรูปที่เก็บไว้จะถูกลบ รูปจะถูกลบเมื่อบัญชีของคุณถูกลบ หรือทันทีหากคุณถอนการส่งนี้ก่อนมีการตัดสิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikrinizi mi değiştirdiniz? %@ bölümünden istediğiniz zaman geri çekebilirsiniz; saklanan fotoğraflar silinir. Hesabınız silindiğinde de silinirler; bu gönderimi karar verilmeden geri çekerseniz hemen silinirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передумали? Відкличте згоду будь-коли в розділі %@, і збережені фото буде видалено. Їх також видаляють разом з обліковим записом або одразу, якщо ви відкличете цю заявку до ухвалення рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ارادہ بدل گیا؟ کسی بھی وقت %@ میں واپس لے لیں، اور رکھی ہوئی تصاویر حذف ہو جاتی ہیں۔ آپ کا اکاؤنٹ حذف ہونے پر بھی وہ حذف ہو جاتی ہیں، یا فیصلے سے پہلے یہ جمع کرائی گئی چیز واپس لینے پر فوراً۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ý? Bạn có thể rút lại bất cứ lúc nào trong %@, và các ảnh đã giữ sẽ bị xóa. Chúng cũng bị xóa khi tài khoản của bạn bị xóa, hoặc xóa ngay nếu bạn rút hồ sơ này trước khi có quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变主意了？随时可在%@中撤回，已保存的照片将被删除。账户被删除时，照片也会被删除；如果你在作出决定前撤回此次提交，则会立即删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變心意了嗎？隨時可以在%@中撤回，已保留的照片會被刪除。帳號刪除時，或你在決定前撤回此次送件時，照片也會立即刪除。"
          }
        }
      }
    },
