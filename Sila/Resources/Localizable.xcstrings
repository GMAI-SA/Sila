    "post.scope.country.room.accessibility": {
      "comment": "VoiceOver reading of a country room's scope. %@ is the country name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غرفة محلية. لا يمكن التحدث إلا للحسابات الموثّقة في %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেশের রুম। শুধু %@-এ ভেরিফায়েড অ্যাকাউন্টরা কথা বলতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala de país. Només hi poden parlar els comptes verificats a %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost země. Mluvit mohou jen ověřené účty v zemi: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Landerum. Kun verificerede konti i %@ kan tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länderraum. Nur verifizierte Konten in %@ können sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αίθουσα χώρας. Μόνο επαληθευμένοι λογαριασμοί στη χώρα %@ μπορούν να μιλήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country room. Only verified accounts in %@ can speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala de país. Solo pueden hablar las cuentas verificadas en %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maahuone. Vain maassa %@ vahvistetut tilit voivat puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon de pays. Seuls les comptes vérifiés en %@ peuvent parler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדר מדינה. רק חשבונות מאומתים ב-%@ יכולים לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देश का रूम। केवल %@ के सत्यापित अकाउंट बोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba zemlje. Govoriti mogu samo potvrđeni računi u zemlji: %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Országszoba. Csak a(z) %@ országban hitelesített fiókok szólalhatnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room negara. Hanya akun terverifikasi di %@ yang bisa berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanza del paese. Solo gli account verificati in %@ possono parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国のルーム。%@で認証されたアカウントだけが発言できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 룸. %@에서 인증된 계정만 말할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രാജ്യ റൂം. %@-ൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ സംസാരിക്കാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik negara. Hanya akaun yang disahkan di %@ boleh bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsrom. Bare verifiserte kontoer i %@ kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Landroom. Alleen geverifieerde accounts in %@ kunnen spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój krajowy. Mówić mogą tylko zweryfikowane konta w kraju: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala de país. Só contas verificadas em %@ podem falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala nacional. Só contas verificadas em %@ podem falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră de țară. Doar conturile verificate în %@ pot vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комната страны. Говорить могут только проверенные аккаунты в стране: %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť krajiny. Hovoriť môžu iba overené účty z krajiny %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsrum. Bara verifierade konton i %@ kan tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாட்டு அறை. %@ இல் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దేశ రూమ్. %@లో ధృవీకరించబడిన ఖాతాలు మాత్రమే మాట్లాడగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องระดับประเทศ เฉพาะบัญชีที่ยืนยันตัวตนแล้วใน %@ เท่านั้นที่พูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke odası. Yalnızca %@ ülkesinde doğrulanmış hesaplar konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімната країни. Говорити можуть лише верифіковані облікові записи в країні %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملک کا روم۔ صرف %@ کے تصدیق شدہ اکاؤنٹ بول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng quốc gia. Chỉ tài khoản đã xác minh ở %@ mới phát biểu được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家房间。只有在 %@ 验证的账户可以发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國家聊天室。只有在 %@ 通過驗證的帳號能發言。"
          }
        }
      }
    },
