    "account.recovery.toast.restored": {
      "comment": "Toast after cancelling a deletion.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد حسابك. ولم يُفقد شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট ফিরে এসেছে। কিছুই হারায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu compte ha tornat. No s'ha perdut res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj účet je zpět. Nic se neztratilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto er tilbage. Intet gik tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist zurück. Nichts ging verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σου επανήλθε. Δεν χάθηκε τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is back. Nothing was lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta ha vuelto. No se perdió nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi on palautettu. Mitään ei menetetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est de retour. Rien n’a été perdu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון שלך חזר. שום דבר לא אבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अकाउंट वापस आ गया। कुछ भी नहीं खोया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj račun je vraćen. Ništa nije izgubljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókod visszatért. Semmi nem veszett el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akunmu kembali. Tidak ada yang hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è tornato. Non è stato perso nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが戻りました。失われたものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 돌아왔어요. 잃은 것은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ട് തിരിച്ചെത്തി. ഒന്നും നഷ്ടപ്പെട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun anda telah kembali. Tiada apa-apa yang hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din er tilbake. Ingenting gikk tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is terug. Er is niets verloren gegaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto wróciło. Nic nie zostało utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta voltou. Nada foi perdido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta voltou. Nada se perdeu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul tău a revenit. Nu s-a pierdut nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт восстановлен. Ничего не потеряно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj účet je späť. Nič sa nestratilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto är tillbaka. Inget gick förlorat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கு மீண்டும் வந்துவிட்டது. எதுவும் இழக்கப்படவில்லை."
