    "safety.lists.blocked.row.hint": {
      "comment": "VoiceOver hint on an unblock button. %@ is the account's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك ولـ%@ رؤية بعضكما مجددًا. ولا يعيد أي متابعة قُطعت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে ও %@-কে আবার পরস্পরকে দেখতে দেয়। ছিন্ন হওয়া কোনো ফলো ফিরিয়ে আনে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que tu i %@ us torneu a veure. No restaura cap seguiment que s'hagi tallat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní tobě a uživateli %@ znovu se vidět. Neobnoví žádné přerušené sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader dig og %@ se hinanden igen. Det genskaber ingen afbrudt følgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt dich und %@ einander wieder sehen. Ein getrenntes Follow wird nicht wiederhergestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει σε εσένα και τον/την %@ να βλέπεστε ξανά. Δεν επαναφέρει καμία ακολούθηση που διακόπηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you and %@ see each other again. It does not restore any follow that was severed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tú y %@ volváis a veros. No restablece ningún seguimiento cortado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa sinun ja käyttäjän %@ nähdä toisenne taas. Se ei palauta katkaistuja seuraamisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à vous et %@ de vous revoir. Cela ne rétablit aucun abonnement rompu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר לך ול-%@ לראות זה את זה שוב. זה לא משחזר מעקב שנותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको और %@ को फिर एक-दूसरे को देखने देता है। यह कटा हुआ कोई फ़ॉलो वापस नहीं लाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje tebi i korisniku %@ da se ponovno vidite. Ne vraća prekinuto praćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra láthatjátok egymást %@ felhasználóval. A megszüntetett követéseket nem állítja vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan kamu dan %@ saling melihat lagi. Tidak memulihkan hubungan mengikuti yang diputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette a te e a %@ di vedervi di nuovo. Non ripristina i follow che erano stati interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたと%@が、お互いを再び見られるようにします。解除されたフォローは元に戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나와 %@님이 서로 다시 볼 수 있게 해요. 끊어진 팔로우는 복원되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കും %@ എന്നയാൾക്കും വീണ്ടും പരസ്പരം കാണാൻ അനുവദിക്കുന്നു. ഇല്ലാതായ ഫോളോ തിരികെ വരില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membolehkan anda dan %@ saling melihat semula. Ia tidak memulihkan sebarang ikutan yang telah diputuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg og %@ se hverandre igjen. Det gjenoppretter ingen følging som ble avbrutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat jou en %@ elkaar weer zien. Het herstelt geen verbroken volgrelatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala Tobie i użytkownikowi %@ znów się widzieć. Nie przywraca przerwanego obserwowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que você e %@ se vejam de novo. Não restaura nenhum vínculo de seguir que tenha sido desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que você e %@ se voltem a ver. Não repõe nenhum seguimento que tenha sido cortado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă lasă pe tine și pe %@ să vă vedeți din nou. Nu readuce urmăririle întrerupte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет вам и %@ снова видеть друг друга. Разорванные подписки не восстанавливаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní vám s používateľom %@ znova sa vidieť. Neobnoví žiadne zrušené sledovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter dig och %@ se varandra igen. Det återställer ingen följning som bröts."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்களும் %@ உம் ஒருவரையொருவர் மீண்டும் பார்க்க அனுமதிக்கும். துண்டிக்கப்பட்ட பின்தொடர்தல் எதையும் மீட்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు, %@ ఒకరినొకరు మళ్లీ చూడనిస్తుంది. తెగిపోయిన ఫాలోలేవీ పునరుద్ధరించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คุณและ %@ เห็นกันและกันอีกครั้ง ไม่ได้คืนการติดตามที่ถูกตัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin ve %@ kişisinin birbirinizi yeniden görmenizi sağlar. Kesilen takipleri geri getirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє вам і %@ знову бачити одне одного. Не відновлює жодної розірваної підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اور %@ کو ایک دوسرے کو دوبارہ دیکھنے دیتا ہے۔ ختم کیا گیا کوئی فالو بحال نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để bạn và %@ thấy nhau trở lại. Không khôi phục lượt theo dõi đã bị cắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你和 %@ 重新看到对方。不会恢复已被切断的关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓你和 %@ 能再次看到彼此，但不會恢復被切斷的追蹤。"
          }
        }
      }
    },
    "safety.lists.done.hint": {
      "comment": "VoiceOver hint for the Done button on the safety lists.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق قوائم الأمان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিরাপত্তার তালিকা বন্ধ করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca les teves llistes de seguretat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavře tvé seznamy bezpečí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukker dine sikkerhedslister"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt deine Sicherheitslisten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείνει τις λίστες ασφαλείας σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes your safety lists"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra tus listas de seguridad"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulkee turvallisuuslistasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme vos listes de sécurité"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוגר את רשימות הבטיחות שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सुरक्षा सूचियाँ बंद करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvara tvoje popise sigurnosti"
          }
