    "auth.otp.a11yLabel": {
      "comment": "VoiceOver label for the code screen header. %lld is the digit count, %@ the masked address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا من %1$lld أرقام إلى %2$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا من %1$lld رقمًا إلى %2$@."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا من رقم واحد إلى %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا من %1$lld رقم إلى %2$@."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا من رقمين إلى %2$@."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أدخل الرمز. أرسلنا رمزًا إلى %2$@."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enter your code. We sent a %lld digit code to %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
