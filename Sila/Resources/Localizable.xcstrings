          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信をこの範囲の人に限定します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글을 이 대상으로 제한해요"
