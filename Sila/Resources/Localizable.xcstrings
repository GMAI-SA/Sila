    "auth.register.submit.hint": {
      "comment": "VoiceOver hint for the registration submit button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ حسابك ويرسل إلى بريدك رمزًا من ستة أرقام"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট তৈরি করে এবং ছয় সংখ্যার একটি কোড ইমেইল করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el teu compte i t'envia per correu un codi de sis dígits"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoří tvůj účet a pošle ti e-mailem šestimístný kód"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter din konto og sender dig en sekscifret kode på e-mail"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt dein Konto und sendet dir einen sechsstelligen Code per E-Mail"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργεί τον λογαριασμό σου και σου στέλνει εξαψήφιο κωδικό με email"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates your account and emails you a six digit code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu cuenta y te envía por correo un código de seis dígitos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo tilisi ja lähettää sinulle kuusinumeroisen koodin sähköpostiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée votre compte et vous envoie un code à six chiffres par e-mail"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצר את החשבון שלך ושולח לדוא״ל שלך קוד בן שש ספרות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अकाउंट बनाता है और आपको छह अंकों का कोड ईमेल करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrađuje tvoj račun i šalje ti e-poštom šesteroznamenkasti kod"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Létrehozza a fiókodat, és hatjegyű kódot küld e-mailben"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat akunmu dan mengirim kode enam digit lewat email"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea il tuo account e ti invia per email un codice di sei cifre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成し、6桁のコードをメールで送ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
