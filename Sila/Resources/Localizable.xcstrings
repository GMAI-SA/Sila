    "guest.join.message.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسائل بين شخصين موثّقين، ولا أحد غيرهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেসেজ শুধু দুজন ভেরিফায়েড মানুষের মধ্যে, আর কারও নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els missatges són entre dues persones verificades i ningú més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zprávy jsou jen mezi dvěma ověřenými lidmi a nikým jiným."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskeder går mellem to verificerede mennesker og ingen andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten gehen nur zwischen zwei verifizierten Menschen, sonst niemandem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μηνύματα είναι ανάμεσα σε δύο επαληθευμένα άτομα και κανέναν άλλον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages are between two verified people, and nobody else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes son entre dos personas verificadas, y nadie más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestit ovat kahden vahvistetun ihmisen välisiä, eikä kenenkään muun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages se font entre deux personnes vérifiées, et personne d’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעות הן בין שני אנשים מאומתים, ואף אחד אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश सिर्फ़ दो सत्यापित लोगों के बीच होते हैं, और किसी के बीच नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruke su samo između dvije potvrđene osobe i nikoga drugog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenetek két hitelesített ember között zajlanak, senki más nem látja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan hanya antara dua orang terverifikasi, tidak ada yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi sono tra due persone verificate, e nessun altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは認証済みの2人の間だけで交わされ、ほかの誰にも見られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 인증된 두 사람 사이에서만 오가요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സന്ദേശങ്ങൾ പരിശോധിച്ച രണ്ടുപേർക്കിടയിൽ മാത്രമാണ്, മറ്റാർക്കുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej hanya antara dua orang yang disahkan, dan tiada orang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger går mellom to verifiserte mennesker, og ingen andre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten zijn tussen twee geverifieerde mensen, en niemand anders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości są tylko między dwiema zweryfikowanymi osobami, nikt inny ich nie widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens são entre duas pessoas verificadas, e de mais ninguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens são entre duas pessoas verificadas, e mais ninguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajele sunt între două persoane verificate și nimeni altcineva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения идут между двумя проверенными людьми — и больше никто их не видит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správy sú len medzi dvoma overenými ľuďmi a nikým iným."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden går mellan två verifierade personer, och ingen annan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செய்திகள் சரிபார்க்கப்பட்ட இருவருக்கு இடையே மட்டுமே, வேறு யாருக்கும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సందేశాలు ఇద్దరు ధృవీకరించబడిన వ్యక్తుల మధ్యే ఉంటాయి, మరెవరికీ కనిపించవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความอยู่ระหว่างคนที่ยืนยันตัวตนแล้วสองคน ไม่มีใครอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar iki doğrulanmış kişi arasındadır, başkası göremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення — лише між двома верифікованими людьми, і більше ні для кого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیغامات دو تصدیق شدہ لوگوں کے درمیان ہوتے ہیں، کسی اور کے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn chỉ giữa hai người đã xác minh, không ai khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私信只发生在两位已验证的人之间，没有其他人参与。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息只在兩位已驗證的人之間，沒有其他人。"
          }
        }
      }
    },
