    "safety.report.submit.hint": {
      "comment": "VoiceOver hint for the submit button. %@ is the reported account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل هذا إلى مراجع في «معروف». ولا يُبلَّغ %@ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একজন Known রিভিউয়ারের কাছে পাঠায়। %@-কে জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho envia a un revisor de Known. %@ no n'és informat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle to posuzovateli aplikace Known. Uživatel %@ se to nedozví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dette til en Known-gennemgående. %@ får ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet dies an einen Prüfer von Known. %@ wird nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στέλνει σε ελεγκτή του Known. Ο/Η %@ δεν ενημερώνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends this to a Known reviewer. %@ is not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía esto a un revisor de Known. No se avisa a %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää tämän Knownin tarkastajalle. Käyttäjälle %@ ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ceci à un vérificateur de Known. %@ n’en est pas informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את זה לבודק של Known. %@ לא מקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे Known के समीक्षक को भेजता है। %@ को बताया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje ovo recenzentu aplikacije Known. %@ nije obaviješten/a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi ezt egy Known-elbírálónak. %@ nem kap értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim ini ke peninjau Known. %@ tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo invia a un revisore di Known. %@ non viene avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをKnownの審査担当者に送信します。%@には知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 검토자에게 보내요. %@님에게는 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഒരു Known പരിശോധകന് അയയ്ക്കുന്നു. %@ എന്നയാളെ അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar ini kepada penyemak Known. %@ tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dette til en Known-vurderer. %@ får ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt dit naar een beoordelaar van Known. %@ krijgt hier geen bericht van."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła to do recenzenta Known. Użytkownik %@ nie jest o tym informowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia isto a um analista do Known. %@ não é avisado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia isto a um revisor da Known. %@ não é avisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite asta unui evaluator Known. %@ nu este anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет жалобу проверяющему Known. %@ не узнает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odošle toto posudzovateľovi Known. %@ sa o tom nedozvie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar detta till en Known-granskare. %@ får inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை Known மதிப்பாய்வாளருக்கு அனுப்பும். %@ க்குத் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని Known సమీక్షకుడికి పంపుతుంది. %@కు చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเรื่องนี้ให้ผู้ตรวจสอบของ Known %@ ไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bir Known inceleyicisine gönderir. %@ kişisine haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає це перевіряльнику Known. %@ не повідомляють."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Known کے جائزہ لینے والے کو بھیجتا ہے۔ %@ کو نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi báo cáo này đến một người xét duyệt của Known. %@ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此发送给 Known 审核员。不会通知 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此檢舉送交 Known 審核人員。%@ 不會得知。"
          }
        }
      }
    },
    "safety.support.call.a11yLabel": {
      "comment": "VoiceOver label for a support resource's phone link. %1$@ is the resource's name, %2$@ the number.",
      "extractionState": "manual",
