    "auth.signIn.forgotPassword.hint": {
      "comment": "VoiceOver hint for the forgot-password link.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل رمزًا من ستة أرقام لإعادة تعيين كلمة المرور"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ড রিসেট করতে ছয় সংখ্যার একটি কোড পাঠায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia un codi de sis dígits perquè puguis restablir la contrasenya"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle šestimístný kód, abys mohl obnovit heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en sekscifret kode, så du kan nulstille din adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen sechsstelligen Code, damit du dein Passwort zurücksetzen kannst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει έναν εξαψήφιο κωδικό για να επαναφέρεις τον κωδικό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a six digit code so you can reset your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un código de seis dígitos para que restablezcas tu contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää kuusinumeroisen koodin, jolla voit palauttaa salasanasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un code à six chiffres pour réinitialiser votre mot de passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח קוד בן שש ספרות כדי שתוכל לאפס את הסיסמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छह अंकों का कोड भेजता है ताकि आप अपना पासवर्ड रीसेट कर सकें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje šesteroznamenkasti kod za poništavanje lozinke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatjegyű kódot küld a jelszavad visszaállításához"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim kode enam digit agar kamu bisa mereset kata sandi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un codice di sei cifre per reimpostare la password"
