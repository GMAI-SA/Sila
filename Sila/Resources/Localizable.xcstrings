    "rooms.polls.error.open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك استطلاع مفتوح — أغلقه أولًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পোল ইতিমধ্যে খোলা আছে — আগে সেটি বন্ধ করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja hi ha una enquesta oberta: tanca-la primer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anketa už je otevřená – nejdřív ji uzavři"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afstemning er allerede åben – luk den først"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Umfrage läuft bereits – beende sie zuerst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια δημοσκόπηση είναι ήδη ανοιχτή — κλείσε την πρώτα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A poll is already open — close it first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una encuesta abierta: ciérrala primero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysely on jo auki – sulje se ensin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sondage est déjà ouvert — clôturez-le d’abord"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקר כבר פתוח — סגור אותו קודם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पोल पहले से खुला है — पहले उसे बंद करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anketa je već otvorena — prvo je zatvori"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már van nyitott szavazás – előbb zárd le"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah jajak pendapat sudah terbuka — tutup dulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sondaggio è già aperto: chiudilo prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに開いている投票があります。先に終了してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
