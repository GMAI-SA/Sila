    "voice.kind.thought.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 30 ثانية. قل ما يدور في بالك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ ৩০ সেকেন্ড। মনে যা আছে বলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a 30 segons. Digues el que penses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až 30 sekund. Řekni, co ti leží na mysli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til 30 sekunder. Sig, hvad du tænker på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 30 Sekunden. Sag, was dir durch den Kopf geht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως 30 δευτερόλεπτα. Πες τι σκέφτεσαι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 30 seconds. Say what's on your mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 30 segundos. Di lo que tienes en mente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään 30 sekuntia. Sano, mitä mielessäsi on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 30 secondes. Dites ce que vous avez en tête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד 30 שניות. אמור מה עובר לך בראש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम 30 सेकंड। जो मन में है वह कहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 30 sekundi. Reci što ti je na umu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb 30 másodperc. Mondd el, mi jár a fejedben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga 30 detik. Katakan apa yang ada di benakmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 30 secondi. Di' quello che hai in mente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長30秒。思っていることを話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 30초. 마음속 이야기를 말해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "30 സെക്കൻഡ് വരെ. മനസ്സിലുള്ളത് പറയൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga 30 saat. Katakan apa yang ada di fikiran anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil 30 sekunder. Si det du tenker på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 30 seconden. Zeg wat je bezighoudt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 30 sekund. Powiedz, co masz na myśli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 30 segundos. Diga o que está pensando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 30 segundos. Diga o que lhe vai na cabeça."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la 30 de secunde. Spune ce ai pe suflet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 30 секунд. Скажите, что у вас на уме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 30 sekúnd. Povedz, čo ti behá hlavou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till 30 sekunder. Säg vad du tänker på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "30 வினாடிகள் வரை. உங்கள் மனதில் இருப்பதைச் சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "30 సెకన్ల వరకు. మీ మనసులో ఉన్నది చెప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกิน 30 วินาที พูดสิ่งที่อยู่ในใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 30 saniye. Aklınızdakini söyleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До 30 секунд. Скажіть, що у вас на думці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "30 سیکنڈ تک۔ جو دل میں ہے کہہ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa 30 giây. Nói điều bạn đang nghĩ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长 30 秒。说说你心里在想什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最長 30 秒。說出你心裡所想。"
          }
        }
      }
    },
