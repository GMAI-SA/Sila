    "error.noCountry": {
      "comment": "The My Country feed was opened by an account with no verified country.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علم بلدك يأتي من التحقق من الهوية. أكمل التوثيق لفتح بلدي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেশের পতাকা পরিচয় যাচাই থেকে আসে। আমার দেশ চালু করতে ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera del teu país prové de la verificació d'identitat. Verifica't per desbloquejar El meu país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvé země pochází z ověření totožnosti. Ověř se, abys odemkl Mou zemi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit landeflag kommer fra identitetsverificeringen. Verificér for at låse Mit land op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Landesflagge stammt aus der Identitätsprüfung. Verifiziere dich, um Mein Land freizuschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημαία της χώρας σου προέρχεται από την επαλήθευση ταυτότητας. Επαληθεύσου για να ξεκλειδώσεις το Η χώρα μου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country flag comes from identity verification. Verify to unlock My Country."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera de tu país procede de la verificación de identidad. Verifícate para desbloquear Mi país."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maasi lippu tulee henkilöllisyyden vahvistuksesta. Vahvista avataksesi Oma maa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drapeau de votre pays provient de la vérification d’identité. Vérifiez-vous pour débloquer Mon pays."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דגל המדינה שלך מגיע מאימות הזהות. אמת כדי לפתוח את המדינה שלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके देश का झंडा पहचान सत्यापन से आता है। \"मेरा देश\" खोलने के लिए सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastava tvoje zemlje dolazi iz provjere identiteta. Potvrdi se da bi otključao/la Moju zemlju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az országzászlód a személyazonosság-hitelesítésből származik. Hitelesíts a Saját ország feloldásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negaramu berasal dari verifikasi identitas. Verifikasi untuk membuka Negaraku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandiera del tuo paese deriva dalla verifica d'identità. Verificati per sbloccare Il mio paese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗は本人確認によって決まります。認証すると「自分の国」が使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 깃발은 신원 인증에서 가져와요. 인증하면 내 국가를 사용할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാക ഐഡന്റിറ്റി പരിശോധനയിൽ നിന്നാണ് ലഭിക്കുന്നത്. എന്റെ രാജ്യം തുറക്കാൻ പരിശോധിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara anda datang daripada pengesahan identiti. Sahkan untuk membuka Negara Saya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsflagget ditt kommer fra identitetsverifiseringen. Verifiser deg for å låse opp Mitt land."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je landvlag komt van de identiteitsverificatie. Verifieer om Mijn land te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaga Twojego kraju pochodzi z weryfikacji tożsamości. Zweryfikuj się, aby odblokować Mój kraj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país vem da verificação de identidade. Verifique-se para liberar Meu país."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país vem da verificação de identidade. Verifique-se para desbloquear O meu país."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steagul țării tale provine din verificarea identității. Verifică-te pentru a debloca Țara mea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Флаг вашей страны берётся из проверки личности. Пройдите проверку, чтобы открыть «Моя страна»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvojej krajiny pochádza z overenia totožnosti. Over sa a odomkni Moja krajina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaggan för ditt land kommer från identitetsverifieringen. Verifiera dig för att låsa upp Mitt land."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்டுக் கொடி அடையாளச் சரிபார்ப்பிலிருந்து வருகிறது. என் நாடு ஐத் திறக்க சரிபாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దేశ జెండా గుర్తింపు ధృవీకరణ నుండి వస్తుంది. నా దేశాన్ని అన్‌లాక్ చేయడానికి ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธงประเทศของคุณมาจากการยืนยันตัวตน ยืนยันตัวตนเพื่อปลดล็อกประเทศของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke bayrağınız kimlik doğrulamasından gelir. Ülkem'in kilidini açmak için doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапор вашої країни походить із верифікації особи. Пройдіть верифікацію, щоб розблокувати «Моя країна»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ملک کا جھنڈا شناخت کی تصدیق سے آتا ہے۔ میرا ملک کھولنے کے لیے تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ quốc gia của bạn đến từ xác minh danh tính. Hãy xác minh để mở khóa Quốc gia của tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的国家旗帜来自身份验证。完成验证即可解锁“我的国家”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的國家旗幟來自身分驗證。完成驗證即可使用「我的國家」。"
          }
