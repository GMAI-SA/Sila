        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli bir hesabın sizi kabul etmesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватний обліковий запис приймає вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی نجی اکاؤنٹ آپ کو اندر آنے دے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tài khoản riêng tư cho bạn vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密账户接纳了你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私人帳號准許你追蹤。"
          }
        }
      }
