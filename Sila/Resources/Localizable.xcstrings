    "feed.tab.rooms.hint": {
      "comment": "VoiceOver hint for the rooms tab. Listening is open to everyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غرف صوتية مباشرة. يمكن لأي شخص الاستماع إلى أي غرفة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ ভয়েস রুম। যে কেউ যেকোনো রুম শুনতে পারে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sales de veu en directe. Tothom pot escoltar qualsevol sala"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé hlasové místnosti. Každý může poslouchat jakoukoli místnost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Levende lydrum. Alle kan lytte til ethvert rum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Sprachräume. Jeder kann jedem Raum zuhören"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζωντανές φωνητικές αίθουσες. Ο καθένας μπορεί να ακούσει οποιαδήποτε αίθουσα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live voice rooms. Anyone can listen to any room"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salas de voz en directo. Cualquiera puede escuchar cualquier sala"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-äänihuoneet. Kuka tahansa voi kuunnella mitä tahansa huonetta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salons vocaux en direct. Tout le monde peut écouter n’importe quel salon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרי קול חיים. כל אחד יכול להאזין לכל חדר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव वॉइस रूम। कोई भी किसी भी रूम को सुन सकता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovne sobe uživo. Svatko može slušati bilo koju sobu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élő hangszobák. Bárki hallgathat bármelyik szobát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room suara langsung. Siapa pun bisa mendengarkan room mana pun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanze vocali dal vivo. Chiunque può ascoltare qualsiasi stanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ音声ルーム。どのルームも誰でも聴けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 음성 룸. 누구나 어떤 룸이든 들을 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് വോയ്‌സ് റൂമുകൾ. ഏത് റൂമും ആർക്കും കേൾക്കാം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik suara langsung. Sesiapa boleh mendengar mana-mana bilik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktesendte taleromm. Alle kan lytte til alle rom"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live spraakrooms. Iedereen kan naar elke room luisteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje głosowe na żywo. Każdy może słuchać każdego pokoju"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salas de voz ao vivo. Qualquer pessoa pode ouvir qualquer sala"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salas de voz em direto. Qualquer pessoa pode ouvir qualquer sala"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camere vocale live. Oricine poate asculta orice cameră"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живые голосовые комнаты. Слушать можно любую"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasové miestnosti naživo. Ktokoľvek môže počúvať ktorúkoľvek miestnosť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstrum live. Alla kan lyssna på alla rum"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலைக் குரல் அறைகள். எந்த அறையையும் யார் வேண்டுமானாலும் கேட்கலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ వాయిస్ రూమ్‌లు. ఏ రూమ్‌నైనా ఎవరైనా వినవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องเสียงสด ทุกคนฟังได้ทุกห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı sesli odalar. Herkes her odayı dinleyebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосові кімнати наживо. Будь-хто може слухати будь-яку кімнату"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو وائس رومز۔ کوئی بھی کسی بھی روم کو سن سکتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng giọng nói trực tiếp. Ai cũng nghe được mọi phòng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时语音房间。任何人都可以收听任何房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時語音聊天室。任何人都能收聽任何聊天室"
          }
        }
      }
    },
