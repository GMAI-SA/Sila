        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godtog ditt intygande – bekräfta att det är personen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உங்கள் உத்தரவாதத்தை ஏற்றார் — அவர்தான் என்பதை உறுதிசெய்யுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మీ హామీని అంగీకరించారు — వారేనని నిర్ధారించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ รับการยืนยันให้ของคุณ ยืนยันว่าเป็นคนนั้น"
