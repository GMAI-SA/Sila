    "rooms.create.starterQuestion.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر على البطاقة ومثبّتًا في الأعلى. السؤال يجذب الناس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডে দেখানো হয় এবং উপরে পিন করা থাকে। একটি প্রশ্ন মানুষকে ভেতরে আনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostra a la targeta i es fixa a dalt. Una pregunta fa venir la gent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se na kartě a připne nahoře. Otázka přiláká lidi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises på kortet og fastgøres øverst. Et spørgsmål får folk ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf der Karte angezeigt und oben angeheftet. Eine Frage holt Leute herein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται στην κάρτα και καρφιτσώνεται στην κορυφή. Μια ερώτηση φέρνει κόσμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on the card and pinned at the top. A question gets people in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra en la tarjeta y se fija arriba. Una pregunta atrae a la gente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään kortissa ja kiinnitetään ylös. Kysymys saa ihmiset sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichée sur la carte et épinglée en haut. Une question attire les gens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצגת בכרטיס ומוצמדת למעלה. שאלה מכניסה אנשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड पर दिखता है और सबसे ऊपर पिन रहता है। एक सवाल लोगों को अंदर लाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje se na kartici i prikvačeno je na vrhu. Pitanje privlači ljude."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenik a kártyán és kitűzve a tetején. Egy kérdés behozza az embereket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan di kartu dan disematkan di atas. Pertanyaan menarik orang masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrata sulla scheda e fissata in alto. Una domanda fa entrare le persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードに表示され、上部に固定されます。質問があると人が集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드에 표시되고 맨 위에 고정돼요. 질문이 사람들을 불러 모아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാർഡിൽ കാണിക്കുകയും മുകളിൽ പിൻ ചെയ്യുകയും ചെയ്യും. ഒരു ചോദ്യം ആളുകളെ കൊണ്ടുവരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipaparkan pada kad dan disemat di atas. Soalan menarik orang masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises på kortet og festes øverst. Et spørsmål får folk inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getoond op de kaart en bovenaan vastgezet. Een vraag trekt mensen binnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazywane na karcie i przypięte u góry. Pytanie przyciąga ludzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no cartão e fica fixada no topo. Uma pergunta atrai gente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrada no cartão e fixada no topo. Uma pergunta atrai pessoas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișată pe card și fixată sus. O întrebare aduce oameni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается на карточке и закрепляется вверху. Вопрос привлекает людей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí sa na karte a pripne sa hore. Otázka prilákať ľudí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas på kortet och fästs överst. En fråga får folk att komma in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அட்டையில் காட்டப்பட்டு மேலே பொருத்தப்படும். ஒரு கேள்வி மக்களை உள்ளே கொண்டுவரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కార్డ్‌పై చూపబడుతుంది, పైన పిన్ చేయబడుతుంది. ఒక ప్రశ్న ప్రజలను లోపలికి తెస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงบนการ์ดและปักหมุดไว้ด้านบน คำถามช่วยดึงคนเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartta gösterilir ve en üste sabitlenir. Bir soru insanları içeri çeker."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показується на картці й закріплюється вгорі. Запитання залучає людей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ پر دکھایا جاتا ہے اور سب سے اوپر پن ہوتا ہے۔ سوال لوگوں کو اندر لاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trên thẻ và ghim ở trên cùng. Một câu hỏi thu hút mọi người vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在卡片上并置顶。一个问题能吸引人进来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在卡片上並釘選在頂端。一個問題能吸引人進來。"
          }
        }
      }
    },
