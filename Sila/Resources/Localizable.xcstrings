    "account.recovery.countdown.days": {
      "comment": "Countdown with days remaining. %lld is the number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا لـ%lld أيام أخرى. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا لـ%lld يومًا آخر. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا ليوم واحد آخر. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا لـ%lld يوم آخر. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا ليومين آخرين. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "كل شيء ما زال موجودًا اليوم. ألغِ أدناه وتعود منشوراتك ومتابعاتك وإعداداتك كما كانت تمامًا."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Everything is still here for another %lld day. Cancel below and your posts, follows and settings come back exactly as they were."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Everything is still here for another %lld days. Cancel below and your posts, follows and settings come back exactly as they were."
                }
              }
            }
          }
        }
      }
    },
