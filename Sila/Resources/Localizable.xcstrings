    "rooms.create.startButton.a11yHint": {
      "comment": "VoiceOver hint for the start-room button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الغرفة الآن ويدخلك إليها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই রুম খুলে আপনাকে ভেতরে নিয়ে যায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la sala ara i t'hi fa entrar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře místnost hned a vezme tě do ní"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner rummet nu og tager dig ind i det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Raum jetzt und bringt dich hinein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει την αίθουσα τώρα και σε μεταφέρει μέσα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the room now and takes you into it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la sala ahora y te lleva a ella"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa huoneen nyt ja vie sinut sinne"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le salon maintenant et vous y emmène"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את החדר עכשיו ומכניס אותך אליו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम अभी खोलता है और आपको उसमें ले जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmah otvara sobu i vodi te u nju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most megnyitja a szobát, és beléptet oda"
          }
        },
        "id": {
