            "value": "Повторювані, автоматизовані або небажані дописи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بار بار، خودکار یا ناپسندیدہ پوسٹنگ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng bài lặp lại, tự động hoặc không được yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复、自动化或未经请求的发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複、自動化或未經請求的發文。"
          }
