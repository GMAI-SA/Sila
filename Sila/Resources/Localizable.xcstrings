        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לטעון את %@. נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम %@ लोड नहीं कर सके। कृपया बाद में फिर कोशिश करें।"
