    "auth.rejected.appeal.prompt": {
      "comment": "Above the appeal form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرنا لماذا ترى أن هذا القرار خاطئ. سيقرأه مشرف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেন মনে করেন সিদ্ধান্তটি ভুল তা আমাদের জানান। একজন মডারেটর এটি পড়বেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica'ns per què creus que aquesta decisió és errònia. Un moderador la llegirà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš nám, proč si myslíš, že je rozhodnutí chybné. Přečte si to moderátor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl os, hvorfor du mener, at afgørelsen er forkert. En moderator læser den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, warum du diese Entscheidung für falsch hältst. Ein Moderator liest es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες μας γιατί πιστεύεις ότι η απόφαση είναι λάθος. Ένας συντονιστής θα τη διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us why you think this decision is wrong. A moderator will read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos por qué crees que esta decisión es errónea. Un moderador la leerá."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, miksi päätös on mielestäsi väärä. Moderaattori lukee viestin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous pourquoi vous pensez que cette décision est erronée. Un modérateur la lira."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספר לנו למה לדעתך ההחלטה שגויה. מנהל תוכן יקרא את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताएँ कि आपको यह फ़ैसला ग़लत क्यों लगता है। एक मॉडरेटर इसे पढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci nam zašto misliš da je ova odluka pogrešna. Pročitat će je moderator."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg, miért gondolod, hogy a döntés téves. Egy moderátor el fogja olvasni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan mengapa kamu merasa keputusan ini keliru. Moderator akan membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegaci perché pensi che questa decisione sia sbagliata. Un moderatore la leggerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この判断が誤りだと考える理由を教えてください。モデレーターが読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결정이 잘못되었다고 생각하는 이유를 알려 주세요. 모더레이터가 읽어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ തീരുമാനം തെറ്റാണെന്ന് നിങ്ങൾ കരുതുന്നത് എന്തുകൊണ്ടാണെന്ന് ഞങ്ങളോട് പറയുക. ഒരു മോഡറേറ്റർ അത് വായിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beritahu kami mengapa anda rasa keputusan ini salah. Seorang moderator akan membacanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell oss hvorfor du mener avgjørelsen er feil. En moderator leser det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel ons waarom je denkt dat deze beslissing niet klopt. Een moderator leest het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz, dlaczego uważasz, że ta decyzja jest błędna. Przeczyta to moderator."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte por que você acha que esta decisão está errada. Um moderador vai ler."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga-nos porque acha que esta decisão está errada. Um moderador vai lê-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-ne de ce crezi că decizia este greșită. Un moderator o va citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объясните, почему вы считаете решение неверным. Его прочтёт модератор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš nám, prečo si myslíš, že rozhodnutie je nesprávne. Prečíta si to moderátor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta varför du tycker att beslutet är fel. En moderator läser det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த முடிவு தவறு என்று ஏன் நினைக்கிறீர்கள் என்று சொல்லுங்கள். ஒரு மதிப்பீட்டாளர் அதைப் படிப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నిర్ణయం ఎందుకు తప్పని మీరు భావిస్తున్నారో చెప్పండి. మోడరేటర్ దాన్ని చదువుతారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกเราว่าทำไมคุณคิดว่าการตัดสินนี้ไม่ถูกต้อง ผู้ดูแลจะอ่านข้อความนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kararın neden yanlış olduğunu düşündüğünüzü bize anlatın. Bir moderatör okuyacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкажіть, чому, на вашу думку, це рішення помилкове. Його прочитає модератор."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیں بتائیں کہ آپ کے خیال میں یہ فیصلہ غلط کیوں ہے۔ ایک ماڈریٹر اسے پڑھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho chúng tôi biết vì sao bạn cho rằng quyết định này sai. Một người kiểm duyệt sẽ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们你为什么认为这个决定有误。版主会阅读你的申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請告訴我們你為什麼認為這個決定有誤。版主會閱讀你的說明。"
          }
        }
      }
    },
