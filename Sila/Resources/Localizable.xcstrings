    "preferences.summary.unknownTopics": {
      "comment": "Warns that stored choices reference topics the server no longer lists. %lld is how many.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هناك %lld خيارات مواضيع مخزّنة لم تعد موجودة في قائمة مواضيع سِلة، لذلك لا تظهر هنا وستُحذف عند الحفظ القادم."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هناك %lld خيارًا مخزّنًا لم يعد موجودًا في قائمة مواضيع سِلة، لذلك لا يظهر هنا وسيُحذف عند الحفظ القادم."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هناك خيار موضوع مخزّن واحد لم يعد موجودًا في قائمة مواضيع سِلة، لذلك لا يظهر هنا وسيُحذف عند الحفظ القادم."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هناك %lld خيار مخزّن لم يعد موجودًا في قائمة مواضيع سِلة، لذلك لا يظهر هنا وسيُحذف عند الحفظ القادم."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هناك خيارا موضوعين مخزّنان لم يعودا موجودين في قائمة مواضيع سِلة، لذلك لا يظهران هنا وسيُحذفان عند الحفظ القادم."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا توجد خيارات مواضيع مخزّنة مفقودة."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stored topic choice no longer exists in Sila's topic list, so it is not shown here and will be dropped the next time you save."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stored topic choices no longer exist in Sila's topic list, so they are not shown here and will be dropped the next time you save."
                }
              }
            }
          }
        }
      }
    },
    "preferences.summary.unusedFilterWarning": {
      "comment": "Shown when the filter switch is on but no topic is marked Interested, so it is doing nothing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الخيار مفعّل، لكنك لم تحدد أي موضوع كـ«مهتم» — لذلك لا تجري أي تصفية وما زالت صفحتك الدولية تعرض كل شيء. حدّد موضوعًا واحدًا على الأقل كـ«مهتم» أدناه، أو أوقف هذا الخيار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This switch is on, but you haven't marked any topic as Interested — so nothing is being filtered and your International feed still shows everything. Mark at least one topic Interested below, or turn this off."
          }
        }
      }
    },
