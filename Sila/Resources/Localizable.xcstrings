        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ అనేది %2$@లో లేదు, %3$@ థ్రెడ్‌కు ప్రాంతం లోపల నుండి మాత్రమే రిప్లై ఇవ్వగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ไม่ได้อยู่ใน %2$@ และเธรด %3$@ ตอบกลับได้เฉพาะจากภายในภูมิภาคเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ içinde değil ve %3$@ konuşmasına yalnızca bölgenin içinden yanıt verilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не входить до регіону %2$@, а відповідати на обговорення «%3$@» можна лише з цього регіону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ میں نہیں ہے، اور %3$@ تھریڈ کا جواب صرف خطے کے اندر سے دیا جا سکتا ہے۔"
