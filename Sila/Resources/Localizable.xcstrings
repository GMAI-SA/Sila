    "verification.withdraw.action.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب تأكيدك قبل سحب أي شيء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু প্রত্যাহারের আগে নিশ্চিত করতে বলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et demana confirmació abans de retirar res"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před stažením se zeptá na potvrzení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beder dig bekræfte, før noget trækkes tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach einer Bestätigung, bevor etwas zurückgezogen wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζητά επιβεβαίωση πριν ανακληθεί οτιδήποτε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks you to confirm before anything is withdrawn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pide confirmación antes de retirar nada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyytää vahvistuksesi ennen kuin mitään perutaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande confirmation avant de retirer quoi que ce soit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבקש אישור לפני שמשהו נמשך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी वापस लेने से पहले पुष्टि माँगता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traži potvrdu prije povlačenja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megerősítést kér, mielőtt bármit visszavonna"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta konfirmasimu sebelum apa pun ditarik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti chiede conferma prima di ritirare qualsiasi cosa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り下げる前に確認が表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철회하기 전에 확인을 요청해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തെങ്കിലും പിൻവലിക്കുന്നതിന് മുമ്പ് സ്ഥിരീകരണം ചോദിക്കുന്നു"
