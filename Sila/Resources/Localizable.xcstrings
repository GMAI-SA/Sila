    "safety.reason.selfHarm.detail": {
      "comment": "What the self-harm reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شخص قد يكون على وشك إيذاء نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ হয়তো নিজেকে আঘাত করতে যাচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú pot estar a punt de fer-se mal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo se může chystat ublížit sám sobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen er måske ved at gøre skade på sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand will sich möglicherweise etwas antun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος μπορεί να είναι έτοιμος να κάνει κακό στον εαυτό του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone may be about to hurt themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien podría estar a punto de hacerse daño."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku voi olla satuttamassa itseään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un est peut-être sur le point de se faire du mal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו אולי עומד לפגוע בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद कोई खुद को नुकसान पहुँचाने वाला है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko bi se mogao ozlijediti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki esetleg önmagában tesz kárt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang mungkin akan menyakiti dirinya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno potrebbe stare per farsi del male."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが自分を傷つけようとしている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 스스로를 해치려 할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും സ്വയം മുറിവേൽപ്പിക്കാൻ പോകുകയായിരിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang mungkin hendak mencederakan dirinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen er kanskje i ferd med å skade seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand staat mogelijk op het punt zichzelf iets aan te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś może być bliski zrobienia sobie krzywdy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém pode estar prestes a se machucar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém pode estar prestes a magoar-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva ar putea fi pe cale să-și facă rău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек, возможно, собирается причинить себе вред."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto sa možno chystá ublížiť si."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon kan vara på väg att skada sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருவர் தனக்குத் தானே தீங்கு செய்துகொள்ளக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా తమను తాము బాధపెట్టుకోబోతూ ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครบางคนอาจกำลังจะทำร้ายตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi kendine zarar vermek üzere olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось, можливо, збирається заподіяти собі шкоду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہو سکتا ہے کوئی خود کو نقصان پہنچانے والا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đó có thể sắp làm hại bản thân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人可能即将伤害自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人可能即將傷害自己。"
          }
        }
      }
    },
    "safety.reason.selfHarm.title": {
      "comment": "Report reason. This one routes to the care-first path.",
      "extractionState": "manual",
      "localizations": {
