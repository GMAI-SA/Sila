        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เธรดระดับประเทศ เฉพาะบัญชีที่ยืนยันตัวตนแล้วใน %@ เท่านั้นที่ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke konuşması. Yalnızca %@ ülkesinde doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обговорення країни. Відповідати можуть лише верифіковані облікові записи в країні %@."
