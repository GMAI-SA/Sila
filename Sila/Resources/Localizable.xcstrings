        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un dígito del código de confirmación que te enviamos por correo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna yksi numero sähköpostitse saadusta vahvistuskoodista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un chiffre de votre code de confirmation reçu par e-mail"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן ספרה אחת מקוד האישור שנשלח אליך בדוא״ל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
