    "rooms.recap.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام فقط. لم يُسجَّل شيء مما قاله أحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সংখ্যা। কারও বলা কিছুই রেকর্ড করা হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només números. No es va enregistrar res del que va dir ningú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen čísla. Nic, co kdo řekl, se nenahrávalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tal. Intet af det, nogen sagde, blev optaget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zahlen. Nichts, was jemand gesagt hat, wurde aufgezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αριθμοί. Τίποτα από όσα ειπώθηκαν δεν ηχογραφήθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers only. Nothing anybody said was recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cifras. No se grabó nada de lo que dijo nadie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain lukuja. Mitään, mitä kukaan sanoi, ei tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement des chiffres. Rien de ce qui a été dit n’a été enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספרים בלבד. שום דבר ממה שנאמר לא הוקלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ संख्याएँ। किसी ने जो कहा वह रिकॉर्ड नहीं हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo brojevi. Ništa što je itko rekao nije snimljeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak számok. Semmi, amit bárki mondott, nem lett rögzítve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka. Tidak ada yang dikatakan siapa pun yang direkam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo numeri. Nulla di ciò che è stato detto è stato registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字だけです。誰かが話した内容は録音されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자만 표시돼요. 누가 한 말도 녹음되지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്കുകൾ മാത്രം. ആരും പറഞ്ഞതൊന്നും റെക്കോർഡ് ചെയ്തിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor sahaja. Tiada apa yang dikatakan sesiapa dirakam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare tall. Ingenting noen sa, ble tatt opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen cijfers. Wat iemand zei is niet opgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko liczby. Nic, co ktokolwiek powiedział, nie zostało nagrane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas números. Nada do que foi dito foi gravado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas números. Nada do que alguém disse foi gravado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar cifre. Nimic din ce a spus cineva nu a fost înregistrat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только цифры. Ничего из сказанного не записывалось."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba čísla. Nič, čo kto povedal, sa nenahrávalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara siffror. Inget som någon sa spelades in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்கள் மட்டுமே. யாரும் பேசியது எதுவும் பதிவு செய்யப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంఖ్యలు మాత్రమే. ఎవరు చెప్పినదీ రికార్డ్ చేయబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขเท่านั้น ไม่มีการบันทึกสิ่งที่ใครพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sayılar. Kimsenin söylediği hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише цифри. Нічого, що хтось сказав, не записувалося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اعداد۔ کسی کی کہی ہوئی کوئی بات ریکارڈ نہیں ہوئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có số liệu. Không có lời nào của ai được ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅有数字。没有录制任何人说的话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅有數字，沒有錄下任何人說的話。"
          }
        }
      }
    },
