    },
    "account.profile.private.goingPublic": {
      "comment": "Warning shown when the switch is being turned off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحويل إلى حساب عام يقبل كل الطلبات المعلّقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাবলিক করলে অপেক্ষমাণ সব অনুরোধ অনুমোদিত হয়ে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a públic aprova totes les sol·licituds pendents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnutím na veřejný se schválí všechny čekající žádosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skifter til offentlig, godkendes alle ventende anmodninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel zu öffentlich werden alle offenen Anfragen angenommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή σε δημόσιο εγκρίνει όλα τα εκκρεμή αιτήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to public approves every pending request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pasar a público se aprueban todas las solicitudes pendientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkiseksi vaihtaminen hyväksyy kaikki odottavat pyynnöt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer en public approuve toutes les demandes en attente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעבר לציבורי מאשר את כל הבקשות הממתינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पब्लिक करने पर सभी लंबित अनुरोध मंज़ूर हो जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebacivanjem na javni račun odobravaju se svi zahtjevi na čekanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyilvánosra váltáskor minden függőben lévő kérés jóváhagyásra kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih ke publik akan menyetujui semua permintaan yang tertunda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passando a pubblico approvi tutte le richieste in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開に切り替えると、保留中のリクエストはすべて承認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개로 전환하면 대기 중인 모든 요청이 승인돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പബ്ലിക് ആക്കിയാൽ തീർപ്പാക്കാത്ത എല്ലാ അഭ്യർഥനകളും അംഗീകരിക്കപ്പെടും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertukar kepada awam akan meluluskan semua permintaan yang belum selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bytter til offentlig, godkjennes alle ventende forespørsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschakelen naar openbaar keurt alle openstaande verzoeken goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejście na konto publiczne zatwierdza wszystkie oczekujące prośby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tornar a conta pública, todas as solicitações pendentes são aprovadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a público aprova todos os pedidos pendentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trecerea la public aprobă toate cererile în așteptare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход на открытый профиль одобрит все ожидающие запросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepnutím na verejný profil sa schvália všetky čakajúce žiadosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du byter till offentligt godkänns alla väntande förfrågningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொதுவுக்கு மாற்றினால் நிலுவையில் உள்ள எல்லாக் கோரிக்கைகளும் ஏற்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పబ్లిక్‌కు మారిస్తే పెండింగ్‌లో ఉన్న ప్రతి అభ్యర్థన ఆమోదించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนเป็นสาธารณะจะอนุมัติคำขอที่รออยู่ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkese açık yapmak, bekleyen tüm istekleri onaylar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перехід на публічний профіль схвалює всі запити, що очікують."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پبلک پر جانے سے ہر زیر التوا درخواست منظور ہو جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang công khai sẽ chấp thuận mọi yêu cầu đang chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换为公开会批准所有待处理的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換為公開後，所有待處理的請求都會通過。"
          }
        }
      }
    },
    "account.profile.private.hint": {
      "comment": "Explanation under the private-account switch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى منشوراتك إلا المتابعون الذين توافق عليهم. يبقى اسمك ومعرّفك ونبذتك ظاهرة ليتمكن الناس من العثور عليك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অনুমোদন করা ফলোয়াররাই শুধু আপনার পোস্ট দেখতে পাবে। মানুষ যাতে আপনাকে খুঁজে পায় সেজন্য নাম, হ্যান্ডেল ও বায়ো দৃশ্যমান থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els seguidors que aprovis poden veure les teves publicacions. El teu nom, identificador i biografia continuen visibles perquè la gent et trobi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé příspěvky uvidí jen schválení sledující. Jméno, handle a bio zůstanou viditelné, aby tě lidé našli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun følgere, du godkender, kan se dine opslag. Dit navn, handle og bio forbliver synlige, så folk kan finde dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Follower, die du bestätigst, sehen deine Beiträge. Name, Handle und Bio bleiben sichtbar, damit andere dich finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο οι ακόλουθοι που εγκρίνεις βλέπουν τις αναρτήσεις σου. Το όνομα, το handle και το βιογραφικό σου παραμένουν ορατά ώστε να σε βρίσκουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only followers you approve can see your posts. Your name, handle and bio stay visible so people can find you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los seguidores que apruebes pueden ver tus publicaciones. Tu nombre, identificador y biografía siguen visibles para que te encuentren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain hyväksymäsi seuraajat näkevät julkaisusi. Nimesi, käyttäjätunnuksesi ja esittelysi pysyvät näkyvissä, jotta ihmiset löytävät sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les abonnés que vous approuvez peuvent voir vos posts. Votre nom, votre identifiant et votre bio restent visibles pour que l’on puisse vous trouver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק עוקבים שאישרת יכולים לראות את הפוסטים שלך. השם, שם המשתמש והתיאור שלך נשארים גלויים כדי שאנשים יוכלו למצוא אותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट सिर्फ़ वही फ़ॉलोअर देख सकते हैं जिन्हें आप मंज़ूर करें। आपका नाम, हैंडल और बायो दिखता रहता है ताकि लोग आपको ढूँढ सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo pratitelji koje odobriš mogu vidjeti tvoje objave. Tvoje ime, handle i bio ostaju vidljivi kako bi te ljudi mogli pronaći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az általad jóváhagyott követők láthatják a bejegyzéseidet. A neved, az @neved és a bemutatkozásod látható marad, hogy megtaláljanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengikut yang kamu setujui yang bisa melihat postinganmu. Nama, handle, dan bio-mu tetap terlihat agar orang bisa menemukanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i follower che approvi possono vedere i tuoi post. Nome, handle e bio restano visibili così le persone possono trovarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認したフォロワーだけが投稿を見られます。名前、ハンドル、自己紹介は、見つけてもらえるよう表示されたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 승인한 팔로워만 게시물을 볼 수 있어요. 이름, 핸들, 소개는 다른 사람이 나를 찾을 수 있도록 계속 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അംഗീകരിക്കുന്ന ഫോളോവർമാർക്ക് മാത്രമേ നിങ്ങളുടെ പോസ്റ്റുകൾ കാണാനാകൂ. ആളുകൾക്ക് നിങ്ങളെ കണ്ടെത്താൻ നിങ്ങളുടെ പേര്, ഹാൻഡിൽ, ബയോ എന്നിവ കാണാവുന്നതായി തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengikut yang anda luluskan boleh melihat siaran anda. Nama, nama pengendali dan bio anda kekal kelihatan supaya orang dapat mencari anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare følgere du godkjenner, kan se innleggene dine. Navnet, brukernavnet og biografien din forblir synlige slik at folk kan finne deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen volgers die je goedkeurt kunnen je berichten zien. Je naam, handle en bio blijven zichtbaar zodat mensen je kunnen vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wpisy widzą tylko zatwierdzeni obserwujący. Imię, uchwyt i opis pozostają widoczne, aby ludzie mogli Cię znaleźć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os seguidores que você aprovar podem ver seus posts. Seu nome, @usuário e bio continuam visíveis para que as pessoas possam encontrar você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os seguidores que aprovar podem ver as suas publicações. O seu nome, identificador e bio continuam visíveis para que as pessoas o encontrem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar urmăritorii aprobați de tine îți pot vedea postările. Numele, handle-ul și bio rămân vizibile ca oamenii să te găsească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши посты видят только одобренные вами подписчики. Имя, @имя и описание остаются видимыми, чтобы вас могли найти."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje príspevky uvidia iba sledovatelia, ktorých schváliš. Tvoje meno, používateľské meno a opis zostanú viditeľné, aby ťa ľudia mohli nájsť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara följare som du godkänner kan se dina inlägg. Ditt namn, användarnamn och din presentation förblir synliga så att folk kan hitta dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கும் பின்தொடர்பவர்கள் மட்டுமே உங்கள் இடுகைகளைப் பார்க்கலாம். மக்கள் உங்களைக் கண்டுபிடிக்க உங்கள் பெயர், ஹேண்டில், அறிமுகம் தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆమోదించిన ఫాలోయర్లు మాత్రమే మీ పోస్ట్‌లను చూడగలరు. ప్రజలు మిమ్మల్ని కనుగొనగలిగేలా మీ పేరు, హ్యాండిల్, బయో కనిపిస్తూనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ติดตามที่คุณอนุมัติเท่านั้นที่เห็นโพสต์ของคุณ ชื่อ แฮนเดิล และประวัติย่อยังมองเห็นได้เพื่อให้คนค้นหาคุณเจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilerinizi yalnızca onayladığınız takipçiler görebilir. Adınız, kullanıcı adınız ve biyografiniz, insanlar sizi bulabilsin diye görünür kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дописи бачать лише підписники, яких ви схвалили. Ім’я, @ім’я та опис про себе залишаються видимими, щоб люди могли вас знайти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ کے منظور کردہ فالوورز آپ کی پوسٹس دیکھ سکتے ہیں۔ آپ کا نام، ہینڈل اور تعارف نظر آتے رہتے ہیں تاکہ لوگ آپ کو ڈھونڈ سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người theo dõi bạn chấp thuận mới xem được bài đăng của bạn. Tên, tên người dùng và tiểu sử vẫn hiển thị để mọi người tìm thấy bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你批准的关注者才能看到你的帖子。你的名称、用户名和个人简介仍然可见，方便别人找到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你核准的追蹤者能看到你的貼文。你的名稱、代號和自我介紹仍可被看見，以便別人找到你。"
          }
        }
      }
    },
