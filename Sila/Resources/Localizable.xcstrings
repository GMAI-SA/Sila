    "document.submitted.message": {
      "comment": "Body after submission.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقارن مراجعٌ السيلفي بالوثيقة، عادةً خلال يوم. وإن تعذّر استخدام الصور أصلًا فستعرف خلال دقائق. تظهر النتيجة هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একজন রিভিউয়ার আপনার সেলফির সাথে নথি মিলিয়ে দেখবেন, সাধারণত একদিনের মধ্যে। ছবিগুলো একেবারেই ব্যবহারযোগ্য না হলে কয়েক মিনিটের মধ্যেই জানতে পারবেন। ফলাফল এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor compararà el teu selfie amb el document, normalment en un dia. Si les fotos no es poden fer servir, ho sabràs en pocs minuts. El resultat es mostra aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuzovatel porovná tvé selfie s dokladem, obvykle do jednoho dne. Pokud nelze fotografie použít vůbec, budeš to vědět do několika minut. Výsledek se zobrazí zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gennemgående sammenligner din selfie med dokumentet, som regel inden for et døgn. Hvis fotoene slet ikke kan bruges, ved du det inden for få minutter. Resultatet vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prüfer vergleicht dein Selfie mit dem Dokument, meist innerhalb eines Tages. Wenn die Fotos gar nicht verwendet werden können, weißt du es innerhalb von Minuten. Das Ergebnis erscheint hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ελεγκτής θα συγκρίνει τη selfie σου με το έγγραφο, συνήθως μέσα σε μία ημέρα. Αν οι φωτογραφίες δεν μπορούν να χρησιμοποιηθούν καθόλου, θα το μάθεις μέσα σε λίγα λεπτά. Το αποτέλεσμα εμφανίζεται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reviewer will compare your selfie with the document, usually within a day. If the photos can't be used at all, you'll know within minutes. The result shows here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisor comparará tu selfie con el documento, normalmente en un día. Si las fotos no sirven en absoluto, lo sabrás en minutos. El resultado se muestra aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastaja vertaa selfiesi asiakirjaan yleensä vuorokauden sisällä. Jos kuvia ei voi käyttää lainkaan, saat tietää minuuteissa. Tulos näkyy täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vérificateur comparera votre selfie au document, généralement sous un jour. Si les photos sont totalement inutilisables, vous le saurez en quelques minutes. Le résultat s’affiche ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק ישווה את הסלפי שלך למסמך, בדרך כלל תוך יום. אם אי אפשר להשתמש בתמונות כלל, תדע תוך דקות. התוצאה מוצגת כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समीक्षक आपकी सेल्फ़ी को दस्तावेज़ से मिलाएगा, आमतौर पर एक दिन के भीतर। अगर फ़ोटो बिलकुल इस्तेमाल नहीं हो सकतीं, तो आपको कुछ ही मिनटों में पता चल जाएगा। नतीजा यहीं दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenzent će usporediti tvoj selfie s ispravom, obično unutar dana. Ako se fotografije uopće ne mogu upotrijebiti, saznat ćeš u nekoliko minuta. Rezultat se prikazuje ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy elbíráló összeveti a szelfidet az okmánnyal, általában egy napon belül. Ha a fotók egyáltalán nem használhatók, percek alatt megtudod. Az eredmény itt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang peninjau akan membandingkan selfie-mu dengan dokumen, biasanya dalam sehari. Jika foto sama sekali tidak bisa dipakai, kamu akan tahu dalam hitungan menit. Hasilnya tampil di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un revisore confronterà il tuo selfie con il documento, di solito entro un giorno. Se le foto non sono utilizzabili, lo saprai in pochi minuti. Il risultato compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査担当者が自撮りと書類を照合します。通常は1日以内です。写真がまったく使用できない場合は、数分以内にお知らせします。結果はここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토자가 셀카와 문서를 비교하며, 보통 하루 안에 끝나요. 사진을 전혀 사용할 수 없는 경우에는 몇 분 안에 알 수 있어요. 결과는 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു റിവ്യൂവർ നിങ്ങളുടെ സെൽഫി രേഖയുമായി താരതമ്യം ചെയ്യും, സാധാരണ ഒരു ദിവസത്തിനുള്ളിൽ. ഫോട്ടോകൾ ഒട്ടും ഉപയോഗിക്കാനാവില്ലെങ്കിൽ മിനിറ്റുകൾക്കുള്ളിൽ അറിയാം. ഫലം ഇവിടെ കാണിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang penyemak akan membandingkan swafoto anda dengan dokumen, biasanya dalam masa sehari. Jika foto langsung tidak boleh digunakan, anda akan tahu dalam beberapa minit. Keputusan dipaparkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator sammenligner selfien din med dokumentet, vanligvis i løpet av et døgn. Hvis bildene ikke kan brukes i det hele tatt, får du vite det innen minutter. Resultatet vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beoordelaar vergelijkt je selfie met het document, meestal binnen een dag. Als de foto's helemaal niet bruikbaar zijn, weet je dat binnen enkele minuten. Het resultaat zie je hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenzent porówna Twoje selfie z dokumentem, zwykle w ciągu doby. Jeśli zdjęć w ogóle nie da się użyć, dowiesz się w ciągu kilku minut. Wynik pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um analista vai comparar sua selfie com o documento, normalmente em um dia. Se as fotos não puderem ser usadas, você saberá em minutos. O resultado aparece aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um revisor vai comparar a sua selfie com o documento, normalmente em menos de um dia. Se as fotos não puderem ser usadas de todo, saberá em minutos. O resultado aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evaluator îți va compara selfie-ul cu documentul, de obicei în cel mult o zi. Dacă fotografiile nu pot fi folosite deloc, vei afla în câteva minute. Rezultatul apare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяющий сравнит ваше селфи с документом, обычно в течение суток. Если фото вообще нельзя использовать, вы узнаете об этом через несколько минут. Результат появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posudzovateľ porovná tvoje selfie s dokladom, zvyčajne do jedného dňa. Ak sa fotky vôbec nedajú použiť, dozvieš sa to do pár minút. Výsledok sa zobrazí tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En granskare jämför din selfie med dokumentet, vanligtvis inom ett dygn. Om bilderna inte alls går att använda får du veta det inom några minuter. Resultatet visas här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மதிப்பாய்வாளர் உங்கள் செல்ஃபியை ஆவணத்துடன் ஒப்பிடுவார், பொதுவாக ஒரு நாளுக்குள். புகைப்படங்களைப் பயன்படுத்தவே முடியாவிட்டால் சில நிமிடங்களில் தெரியும். முடிவு இங்கே காட்டப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్షకుడు మీ సెల్ఫీని పత్రంతో పోల్చి చూస్తారు, సాధారణంగా ఒక రోజులో. ఫోటోలను అసలు ఉపయోగించలేకపోతే, నిమిషాల్లోనే మీకు తెలుస్తుంది. ఫలితం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ตรวจสอบจะเทียบเซลฟีของคุณกับเอกสาร โดยปกติภายในหนึ่งวัน หากใช้รูปไม่ได้เลย คุณจะทราบภายในไม่กี่นาที ผลจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir inceleyici selfie'nizi belgeyle karşılaştıracak, genellikle bir gün içinde. Fotoğraflar hiç kullanılamıyorsa dakikalar içinde öğrenirsiniz. Sonuç burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряльник порівняє ваше селфі з документом, зазвичай протягом доби. Якщо фото взагалі не можна використати, ви дізнаєтеся за кілька хвилин. Результат показується тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک جائزہ لینے والا آپ کی سیلفی کا دستاویز سے موازنہ کرے گا، عموماً ایک دن کے اندر۔ اگر تصاویر بالکل استعمال کے قابل نہ ہوں تو آپ کو چند منٹ میں پتا چل جائے گا۔ نتیجہ یہاں دکھایا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người xét duyệt sẽ so sánh ảnh selfie với giấy tờ, thường trong vòng một ngày. Nếu ảnh hoàn toàn không dùng được, bạn sẽ biết trong vài phút. Kết quả hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核员会将你的自拍与证件进行比对，通常在一天之内。如果照片完全无法使用，你会在几分钟内得知。结果会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審核人員會將你的自拍與證件比對，通常在一天內完成。如果照片完全無法使用，幾分鐘內你就會知道。結果會顯示在這裡。"
          }
        }
      }
    },
    "document.submitted.received": {
      "comment": "Top of the under-review screen: the submission arrived.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلمنا وثائقك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার নথি পেয়েছি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem rebut els teus documents"
          }
        },
        "cs": {
