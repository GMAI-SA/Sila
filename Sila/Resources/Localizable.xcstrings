          "stringUnit": {
            "state": "translated",
            "value": "سنرسل إلى بريدك رمزًا من ستة أرقام لتأكيد العنوان. ثم يأتي توثيق الهوية بعد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিকানা নিশ্চিত করতে আমরা আপনাকে ছয় সংখ্যার একটি কোড ইমেইল করব। এরপর আসবে পরিচয় যাচাই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'enviarem per correu un codi de sis dígits per confirmar l'adreça. Després, la verificació d'identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleme ti e-mailem šestimístný kód pro potvrzení adresy. Poté následuje ověření totožnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender dig en sekscifret kode på e-mail for at bekræfte adressen. Identitetsverificering kommer bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden dir einen sechsstelligen Code, um die Adresse zu bestätigen. Danach folgt die Identitätsprüfung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα σου στείλουμε έναν εξαψήφιο κωδικό με email για να επιβεβαιώσουμε τη διεύθυνση. Ακολουθεί η επαλήθευση ταυτότητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll email you a six-digit code to confirm the address. Identity verification comes next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviaremos por correo un código de seis dígitos para confirmar la dirección. Después viene la verificación de identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetämme sinulle kuusinumeroisen koodin osoitteen vahvistamiseksi. Henkilöllisyyden vahvistus tulee seuraavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous enverrons un code à six chiffres pour confirmer l’adresse. La vérification d’identité vient ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח לך בדוא״ל קוד בן שש ספרות לאישור הכתובת. אימות זהות יבוא אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पते की पुष्टि के लिए हम आपको छह अंकों का कोड ईमेल करेंगे। इसके बाद पहचान सत्यापन होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslat ćemo ti šesteroznamenkasti kod za potvrdu adrese. Slijedi provjera identiteta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatjegyű kódot küldünk e-mailben a cím megerősítéséhez. Ezután jön a személyazonosság hitelesítése."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengirim kode enam digit lewat email untuk mengonfirmasi alamat. Verifikasi identitas menyusul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti invieremo per email un codice di sei cifre per confermare l'indirizzo. La verifica dell'identità viene dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを確認するため、6桁のコードをメールでお送りします。次は本人確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 확인할 수 있도록 6자리 코드를 이메일로 보내드려요. 다음은 신원 인증이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിലാസം സ്ഥിരീകരിക്കാൻ ഞങ്ങൾ ആറക്ക കോഡ് ഇമെയിൽ ചെയ്യും. അടുത്തത് ഐഡന്റിറ്റി പരിശോധനയാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengemel kod enam digit kepada anda untuk mengesahkan alamat. Pengesahan identiti menyusul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender deg en sekssifret kode på e-post for å bekrefte adressen. Identitetsverifisering kommer etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We mailen je een zescijferige code om het adres te bevestigen. Daarna volgt de identiteitsverificatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy Ci e-mailem sześciocyfrowy kod, by potwierdzić adres. Weryfikacja tożsamości będzie następnym krokiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código de seis dígitos por e-mail para confirmar o endereço. A verificação de identidade vem em seguida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código de seis dígitos por email para confirmar o endereço. A verificação de identidade vem a seguir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți vom trimite un cod din șase cifre pentru a confirma adresa. Urmează verificarea identității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправим шестизначный код, чтобы подтвердить адрес. Следующий шаг — проверка личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleme ti e-mailom šesťmiestny kód na potvrdenie adresy. Potom príde overenie totožnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skickar en sexsiffrig kod för att bekräfta adressen. Identitetsverifiering kommer härnäst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகவரியை உறுதிசெய்ய ஆறு இலக்கக் குறியீட்டை மின்னஞ்சல் செய்வோம். அடுத்து அடையாளச் சரிபார்ப்பு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిరునామాను నిర్ధారించడానికి ఆరు అంకెల కోడ్‌ను ఈమెయిల్ చేస్తాం. తర్వాత గుర్తింపు ధృవీకరణ ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะส่งรหัสหกหลักทางอีเมลเพื่อยืนยันที่อยู่ จากนั้นจะเป็นการยืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi onaylamak için size altı haneli bir kod e-postayla göndereceğiz. Sonra kimlik doğrulaması gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надішлемо вам шестизначний код, щоб підтвердити адресу. Далі — верифікація особи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پتے کی تصدیق کے لیے ہم آپ کو چھ ہندسوں کا کوڈ ای میل کریں گے۔ اس کے بعد شناخت کی تصدیق ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi email cho bạn mã sáu chữ số để xác nhận địa chỉ. Xác minh danh tính là bước tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会向你发送一个六位验证码来确认邮箱。接下来是身份验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會寄六位數驗證碼給你以確認信箱。接下來是身分驗證。"
          }
        }
      }
    },
