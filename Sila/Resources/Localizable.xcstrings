    "notifications.kind.reply.detail": {
      "comment": "What the reply switch governs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رد شخص على سلسلة كتبتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লেখা কোনো থ্রেডে কেউ উত্তর দিলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú que respon a un fil que has escrit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo odpověděl na vlákno, které jsi napsal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, der svarer på en tråd, du har skrevet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand antwortet auf einen Thread von dir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος απαντά σε νήμα που έγραψες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone replying to a thread you wrote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien que responde a un hilo que escribiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku vastaa kirjoittamaasi ketjuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un qui répond à une discussion que vous avez écrite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו שמגיב לשרשור שכתבת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आपके लिखे थ्रेड पर जवाब दे रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko odgovara na nit koju si napisao/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki válaszol egy általad írt szálra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang membalas utas yang kamu tulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno che risponde a una discussione che hai scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのスレッドに返信したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내가 쓴 스레드에 답글을 달 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ എഴുതിയ ത്രെഡിന് ആരെങ്കിലും മറുപടി നൽകുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang membalas utas yang anda tulis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen som svarer på en tråd du skrev."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die reageert op een thread die jij hebt geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś odpowiada w wątku, który napisałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém respondendo a um fio que você escreveu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém a responder a uma conversa que escreveu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva răspunde la o conversație scrisă de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то отвечает в ветке, которую вы начали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto odpovedal na vlákno, ktoré si napísal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon som svarar i en tråd du skrivit."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எழுதிய உரையாடலுக்கு யாராவது பதிலளிக்கிறார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రాసిన థ్రెడ్‌కు ఎవరైనా రిప్లై ఇచ్చినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนตอบกลับเธรดที่คุณเขียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri yazdığınız bir konuşmayı yanıtladığında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось відповідає на обговорення, яке ви написали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آپ کے لکھے ہوئے تھریڈ کا جواب دے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đó trả lời một chuỗi bạn viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人回复了你写的对话串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人回覆你寫的串文。"
          }
        }
      }
    },
