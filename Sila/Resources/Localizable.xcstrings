          "stringUnit": {
            "state": "translated",
            "value": "آپ کی حفاظتی فہرستیں لوڈ ہو رہی ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải danh sách an toàn của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载你的安全列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入你的安全列表"
          }
        }
      }
    },
    "safety.lists.muted.empty.title": {
      "comment": "Empty muted list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
