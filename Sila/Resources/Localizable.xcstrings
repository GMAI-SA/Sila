    "vouch.limited.host": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء التزكية يمكنك الاستماع في الغرف. وثّق هويتك لتستضيف غرفة أو فعالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাউচ পাওয়া অবস্থায় আপনি রুমে শুনতে পারবেন। রুম বা ইভেন্ট হোস্ট করতে আপনার পরিচয় ভেরিফাই করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre estiguis avalat, pots escoltar a les sales. Verifica la teva identitat per organitzar una sala o un esdeveniment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud za tebe někdo ručí, můžeš v místnostech poslouchat. Pro vedení místnosti nebo události ověř svou totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens der går i god for dig, kan du lytte i rum. Verificér din identitet for at være vært for et rum eller en begivenhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange für dich gebürgt wird, kannst du in Räumen zuhören. Verifiziere deine Identität, um einen Raum oder ein Event zu hosten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο έχεις εγγύηση, μπορείς να ακούς σε αίθουσες. Επαλήθευσε την ταυτότητά σου για να διοργανώσεις αίθουσα ή εκδήλωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're vouched for, you can listen in rooms. Verify your identity to host a room or an event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras estés avalado, puedes escuchar en las salas. Verifica tu identidad para organizar una sala o un evento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun sinut on taattu, voit kuunnella huoneita. Vahvista henkilöllisyytesi isännöidäksesi huonetta tai tapahtumaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous êtes sous caution, vous pouvez écouter dans les salons. Vérifiez votre identité pour animer un salon ou un événement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן שערבו לך, אתה יכול להאזין בחדרים. אמת את זהותך כדי לארח חדר או אירוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आपके लिए वाउच है, आप रूम में सुन सकते हैं। रूम या इवेंट होस्ट करने के लिए अपनी पहचान सत्यापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok za tebe jamče, možeš slušati u sobama. Potvrdi svoj identitet da vodiš sobu ili događaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg kezességgel támogatnak, szobákban hallgathatsz. Szoba vagy esemény vezetéséhez hitelesítsd a személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi kamu dijamin, kamu bisa mendengarkan di room. Verifikasi identitasmu untuk menjadi host room atau acara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché hai una garanzia, puoi ascoltare nelle stanze. Verifica la tua identità per ospitare una stanza o un evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証を受けている間は、ルームを聴くことができます。ルームやイベントのホストになるには本人確認をしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증받은 동안에는 룸을 들을 수 있어요. 룸이나 이벤트를 호스트하려면 신원을 인증하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൗച്ച് ലഭിച്ചിരിക്കുമ്പോൾ നിങ്ങൾക്ക് റൂമുകളിൽ കേൾക്കാം. റൂമോ ഇവന്റോ ഹോസ്റ്റ് ചെയ്യാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda dijamin, anda boleh mendengar dalam bilik. Sahkan identiti anda untuk menghos bilik atau acara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens det er garantert for deg, kan du lytte i rom. Verifiser identiteten din for å være vert for et rom eller et arrangement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang er voor je wordt ingestaan, kun je luisteren in rooms. Verifieer je identiteit om een room of evenement te hosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki ktoś za Ciebie ręczy, możesz słuchać w pokojach. Zweryfikuj tożsamość, aby prowadzić pokój lub wydarzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto você é avalizado, pode ouvir as salas. Verifique sua identidade para apresentar uma sala ou um evento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto tiver aval, pode ouvir nas salas. Verifique a sua identidade para ser anfitrião de uma sala ou evento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp ai garanție, poți asculta în camere. Verifică-ți identitatea pentru a găzdui o cameră sau un eveniment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока за вас поручаются, вы можете слушать комнаты. Пройдите проверку личности, чтобы вести комнату или событие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým za teba niekto ručí, môžeš v miestnostiach počúvať. Ak chceš viesť miestnosť alebo udalosť, over svoju totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan du har intyg kan du lyssna i rum. Verifiera din identitet för att vara värd för ett rum eller ett evenemang."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிமொழி பெற்றிருக்கும் வரை அறைகளில் கேட்கலாம். அறை அல்லது நிகழ்வை நடத்த உங்கள் அடையாளத்தைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు హామీ ఉన్నప్పుడు, రూమ్‌లలో వినవచ్చు. రూమ్ లేదా ఈవెంట్ హోస్ట్ చేయడానికి మీ గుర్తింపును ధృవీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่ได้รับการรับรอง คุณฟังในห้องได้ ยืนยันตัวตนเพื่อเป็นเจ้าของห้องหรืออีเวนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olunduğunuz sürece odalarda dinleyebilirsiniz. Oda veya etkinlik düzenlemek için kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки за вас ручаються, ви можете слухати кімнати. Верифікуйте особу, щоб вести кімнату чи подію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ کی ضمانت دی گئی ہے آپ رومز میں سن سکتے ہیں۔ روم یا ایونٹ کی میزبانی کے لیے اپنی شناخت کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn được bảo chứng, bạn có thể nghe trong các phòng. Hãy xác minh danh tính để làm chủ một phòng hoặc sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在获得担保期间，你可以在房间中收听。验证身份后才能主持房间或活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在受到擔保期間，你可以在聊天室收聽。驗證你的身分才能主持聊天室或活動。"
          }
        }
      }
    },
    "vouch.limited.messages.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء التزكية لا يمكنك إرسال الرسائل أو استقبالها. وثّق هويتك لتُفتح رسائلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাউচ পাওয়া অবস্থায় আপনি মেসেজ পাঠাতে বা পেতে পারবেন না। পরিচয় ভেরিফাই করলে আপনার ইনবক্স খুলে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre estiguis avalat, no pots enviar ni rebre missatges. Verifica la teva identitat i s'obrirà la safata d'entrada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud za tebe někdo ručí, nemůžeš zprávy posílat ani přijímat. Ověř svou totožnost a doručené se ti otevřou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens der går i god for dig, kan du hverken sende eller modtage beskeder. Verificér din identitet, så åbner din indbakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange für dich gebürgt wird, kannst du keine Nachrichten senden oder empfangen. Verifiziere deine Identität, und dein Posteingang öffnet sich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο έχεις εγγύηση, δεν μπορείς να στέλνεις ή να λαμβάνεις μηνύματα. Επαλήθευσε την ταυτότητά σου και τα εισερχόμενά σου ανοίγουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're vouched for, you can't send or receive messages. Verify your identity and your inbox opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras estés avalado, no puedes enviar ni recibir mensajes. Verifica tu identidad y se abrirá tu bandeja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun sinut on taattu, et voi lähettää etkä vastaanottaa viestejä. Vahvista henkilöllisyytesi, niin saapuneet avautuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous êtes sous caution, vous ne pouvez ni envoyer ni recevoir de messages. Vérifiez votre identité et votre boîte de réception s’ouvre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן שערבו לך, אינך יכול לשלוח או לקבל הודעות. אמת את זהותך ותיבת הדואר שלך תיפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आपके लिए वाउच है, आप संदेश भेज या पा नहीं सकते। अपनी पहचान सत्यापित करें और आपका इनबॉक्स खुल जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok za tebe jamče, ne možeš slati ni primati poruke. Potvrdi svoj identitet i tvoja pristigla pošta se otvara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg kezességgel támogatnak, nem küldhetsz és nem fogadhatsz üzeneteket. Hitelesítsd a személyazonosságodat, és megnyílik a postaládád."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi kamu dijamin, kamu tidak bisa mengirim atau menerima pesan. Verifikasi identitasmu dan kotak masukmu terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché hai una garanzia, non puoi inviare né ricevere messaggi. Verifica la tua identità e la tua posta in arrivo si apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証を受けている間は、メッセージの送受信ができません。本人確認をすると、受信箱が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증받은 동안에는 메시지를 보내거나 받을 수 없어요. 신원을 인증하면 받은 메시지함이 열려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൗച്ച് ലഭിച്ചിരിക്കുമ്പോൾ സന്ദേശങ്ങൾ അയയ്ക്കാനോ സ്വീകരിക്കാനോ കഴിയില്ല. ഐഡന്റിറ്റി വെരിഫൈ ചെയ്താൽ നിങ്ങളുടെ ഇൻബോക്സ് തുറക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda dijamin, anda tidak boleh menghantar atau menerima mesej. Sahkan identiti anda dan peti masuk anda terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens det er garantert for deg, kan du ikke sende eller motta meldinger. Verifiser identiteten din, så åpnes innboksen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang er voor je wordt ingestaan, kun je geen berichten sturen of ontvangen. Verifieer je identiteit en je inbox gaat open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki ktoś za Ciebie ręczy, nie możesz wysyłać ani odbierać wiadomości. Zweryfikuj tożsamość, a Twoja skrzynka się otworzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto você é avalizado, não pode enviar nem receber mensagens. Verifique sua identidade e sua caixa de entrada abre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto tiver aval, não pode enviar nem receber mensagens. Verifique a sua identidade e a sua caixa de entrada abre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp ai garanție, nu poți trimite sau primi mesaje. Verifică-ți identitatea și inboxul se deschide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока за вас поручаются, вы не можете отправлять и получать сообщения. Пройдите проверку личности, и ваши входящие откроются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým za teba niekto ručí, nemôžeš posielať ani prijímať správy. Over svoju totožnosť a tvoja schránka sa otvorí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan du har intyg kan du inte skicka eller ta emot meddelanden. Verifiera din identitet så öppnas din inkorg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிமொழி பெற்றிருக்கும் வரை செய்திகளை அனுப்பவோ பெறவோ முடியாது. அடையாளத்தைச் சரிபார்த்தால் உங்கள் இன்பாக்ஸ் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు హామీ ఉన్నప్పుడు మెసేజ్‌లు పంపలేరు, అందుకోలేరు. మీ గుర్తింపును ధృవీకరిస్తే మీ ఇన్‌బాక్స్ తెరుచుకుంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่ได้รับการรับรอง คุณส่งหรือรับข้อความไม่ได้ ยืนยันตัวตนแล้วกล่องข้อความจะเปิดให้ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olunduğunuz sürece mesaj gönderemez veya alamazsınız. Kimliğinizi doğrulayın, gelen kutunuz açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки за вас ручаються, ви не можете надсилати чи отримувати повідомлення. Верифікуйте особу, і ваші вхідні відкриються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ کی ضمانت دی گئی ہے آپ پیغامات بھیج یا وصول نہیں کر سکتے۔ اپنی شناخت کی تصدیق کریں تو آپ کا ان باکس کھل جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn được bảo chứng, bạn không thể gửi hoặc nhận tin nhắn. Hãy xác minh danh tính và hộp thư của bạn sẽ mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在获得担保期间，你无法发送或接收私信。验证身份后即可使用你的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在受到擔保期間，你無法傳送或接收訊息。驗證你的身分後，收件匣就會開啟。"
          }
        }
      }
    },
