    "document.sweep.message": {
      "comment": "Sweep step body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر إلى الكاميرا، ثم أدر رأسك ببطء دورة كاملة حتى تمتلئ الحلقة. هذا يثبت أن شخصًا يحمل الهاتف، لا صورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরার দিকে তাকান, তারপর বৃত্ত না ভরা পর্যন্ত ধীরে ধীরে মাথা পুরো ঘুরিয়ে নিন। এতে প্রমাণ হয় যে ফোন ধরে আছে একজন মানুষ, কোনো ছবি নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la càmera i després gira el cap lentament fins a fer la volta completa, fins que s'ompli l'anell. Això demostra que una persona subjecta el telèfon, no una foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívej se do fotoaparátu a pak pomalu otoč hlavu celým kruhem, až se kruh zaplní. Tím se prokáže, že telefon drží člověk, ne fotka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på kameraet, og drej derefter langsomt hovedet hele vejen rundt, til ringen er fyldt. Det beviser, at et menneske holder telefonen og ikke et foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh in die Kamera und drehe dann den Kopf langsam einmal ganz herum, bis der Ring voll ist. Das beweist, dass ein Mensch das Telefon hält und kein Foto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοίτα την κάμερα και μετά γύρνα αργά το κεφάλι σου ολόκληρο κύκλο μέχρι να γεμίσει ο δακτύλιος. Αυτό αποδεικνύει ότι ένας άνθρωπος κρατά το τηλέφωνο, όχι μια φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the camera, then turn your head slowly all the way round until the ring fills. This proves a person is holding the phone, not a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira a la cámara y gira la cabeza despacio dando toda la vuelta hasta que se llene el anillo. Así se comprueba que una persona sostiene el teléfono, no una foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso kameraan ja käännä sitten päätäsi hitaasti kokonaan ympäri, kunnes rengas täyttyy. Tämä todistaa, että puhelinta pitää ihminen eikä valokuva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez l’appareil photo, puis tournez lentement la tête en faisant un tour complet jusqu’à ce que l’anneau soit plein. Cela prouve qu’une personne tient le téléphone, et non une photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבט אל המצלמה, ואז סובב את הראש לאט עד הסוף עד שהטבעת מתמלאת. זה מוכיח שאדם מחזיק את הטלפון, ולא תמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की ओर देखें, फिर रिंग भरने तक अपना सिर धीरे-धीरे पूरा घुमाएँ। इससे साबित होता है कि फ़ोन कोई व्यक्ति पकड़े है, फ़ोटो नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledaj u kameru, a zatim polako okreći glavu u cijelom krugu dok se prsten ne napuni. Tako se dokazuje da telefon drži osoba, a ne fotografija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézz a kamerába, majd lassan fordítsd körbe a fejed, amíg a gyűrű meg nem telik. Ez bizonyítja, hogy egy ember tartja a telefont, nem egy fénykép."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat ke kamera, lalu putar kepalamu perlahan satu putaran penuh sampai cincin terisi. Ini membuktikan ada orang yang memegang ponsel, bukan foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la fotocamera, poi gira lentamente la testa tutto intorno finché l'anello non si riempie. Dimostra che a tenere il telefono è una persona, non una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを見たあと、リングが埋まるまで頭をゆっくりと一周させてください。写真ではなく、人が端末を持っていることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 본 다음, 링이 채워질 때까지 고개를 천천히 한 바퀴 돌리세요. 사진이 아니라 실제 사람이 휴대폰을 들고 있다는 것을 확인하는 과정이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്യാമറയിലേക്ക് നോക്കി, വളയം നിറയുന്നതുവരെ തല പതുക്കെ ചുറ്റും തിരിക്കുക. ഫോൺ പിടിച്ചിരിക്കുന്നത് ഒരു ഫോട്ടോയല്ല, ഒരു വ്യക്തിയാണെന്ന് ഇത് തെളിയിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pandang kamera, kemudian pusingkan kepala anda perlahan-lahan sepenuhnya sehingga cincin terisi. Ini membuktikan seorang manusia memegang telefon, bukan foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på kameraet, og snu deretter hodet sakte hele veien rundt til ringen er full. Dette beviser at et menneske holder telefonen, ikke et bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk in de camera en draai dan langzaam je hoofd helemaal rond tot de ring vol is. Dit bewijst dat een persoon de telefoon vasthoudt en geen foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spójrz w aparat, a potem powoli obróć głowę dookoła, aż okrąg się wypełni. To dowodzi, że telefon trzyma człowiek, a nie zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe para a câmera e depois gire a cabeça devagar, dando a volta toda, até o anel se preencher. Isso prova que uma pessoa está segurando o celular, e não uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe para a câmara e depois vire lentamente a cabeça todo à volta até o anel encher. Isto prova que uma pessoa segura o telemóvel, e não uma foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Privește în cameră, apoi întoarce capul încet, complet, până se umple inelul. Asta dovedește că un om ține telefonul, nu o fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите в камеру, затем медленно поверните голову по кругу, пока кольцо не заполнится. Так подтверждается, что телефон держит человек, а не фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozri sa do fotoaparátu a potom pomaly otáčaj hlavu dokola, kým sa prstenec nenaplní. Tým sa preukáže, že telefón drží človek, nie fotka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på kameran och vrid sedan huvudet långsamt hela varvet tills ringen fylls. Det visar att en person håller i telefonen, inte ett foto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேமராவைப் பாருங்கள், பின்னர் வளையம் நிரம்பும் வரை தலையை மெதுவாக முழுவதும் சுற்றித் திருப்புங்கள். தொலைபேசியைப் பிடித்திருப்பது புகைப்படம் அல்ல, ஒரு மனிதர் என்பதை இது நிரூபிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కెమెరా వైపు చూసి, వలయం నిండే వరకు మీ తలను నెమ్మదిగా పూర్తిగా తిప్పండి. ఫోన్‌ను పట్టుకున్నది ఫోటో కాదు, ఒక మనిషి అని ఇది నిరూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองที่กล้อง แล้วหันศีรษะช้าๆ ให้รอบจนวงแหวนเต็ม เพื่อพิสูจน์ว่าเป็นคนถือโทรศัพท์ ไม่ใช่รูปถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraya bakın, sonra halka dolana kadar başınızı yavaşça tam bir tur çevirin. Bu, telefonu bir fotoğrafın değil bir insanın tuttuğunu kanıtlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подивіться в камеру, а потім повільно повертайте голову по колу, доки кільце не заповниться. Це доводить, що телефон тримає людина, а не фотографія."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرے کی طرف دیکھیں، پھر اپنا سر آہستہ آہستہ پورا گھمائیں جب تک دائرہ بھر نہ جائے۔ اس سے ثابت ہوتا ہے کہ فون ایک شخص نے پکڑا ہے، کسی تصویر نے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn vào camera, rồi từ từ xoay đầu một vòng đầy đủ cho đến khi vòng tròn đầy. Việc này chứng minh một người thật đang cầm điện thoại, không phải một bức ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看向相机，然后慢慢转动头部转一整圈，直到圆环填满。这能证明拿着手机的是真人，而不是照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看著相機，然後慢慢轉動頭部繞一圈，直到圓環填滿。這能證明握著手機的是真人，而不是照片。"
          }
        }
      }
    },
    "document.sweep.restarted": {
      "comment": "Prompt after a restart.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقدناك — انظر مباشرة إلى الكاميرا وابدأ من جديد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে হারিয়ে ফেলেছি — সোজা ক্যামেরার দিকে তাকিয়ে আবার শুরু করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'hem perdut: mira directament a la càmera i torna a començar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztratili jsme tě – dívej se přímo do fotoaparátu a začni znovu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi mistede dig – se lige ind i kameraet, og start forfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben dich verloren – sieh geradeaus in die Kamera und beginne von vorn"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε χάσαμε — κοίτα κατευθείαν την κάμερα και ξεκίνα ξανά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost you — look straight at the camera and start again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te perdimos: mira directamente a la cámara y empieza de nuevo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetin sinut – katso suoraan kameraan ja aloita alusta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous avons perdu — regardez droit vers l’appareil photo et recommencez"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איבדנו אותך — הבט ישר אל המצלמה והתחל שוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको खो दिया — सीधे कैमरे की ओर देखें और फिर शुरू करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubili smo te — gledaj ravno u kameru i počni ponovno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elvesztettünk – nézz egyenesen a kamerába, és kezdd újra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hilang dari pandangan — lihat lurus ke kamera dan mulai lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ho perso: guarda dritto nella fotocamera e ricomincia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見失いました。カメラをまっすぐ見て、最初からやり直してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴을 놓쳤어요. 카메라를 똑바로 보고 다시 시작하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളെ കാണാതായി — ക്യാമറയിലേക്ക് നേരെ നോക്കി വീണ്ടും തുടങ്ങുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hilang dari pandangan — pandang terus ke kamera dan mulakan semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet deg. Se rett på kameraet og start på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent uit beeld: kijk recht in de camera en begin opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straciłem Cię z oczu — patrz prosto w aparat i zacznij od nowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdemos você. Olhe direto para a câmera e comece de novo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdemo-lo de vista — olhe diretamente para a câmara e recomece"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te-am pierdut — privește drept în cameră și începe din nou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас потеряли — смотрите прямо в камеру и начните заново"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stratil som ťa — pozeraj priamo do fotoaparátu a začni znova"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tappade bort dig – titta rakt in i kameran och börja om"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களைத் தவறவிட்டோம் — கேமராவை நேராகப் பார்த்து மீண்டும் தொடங்குங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిమ్మల్ని కోల్పోయాం — కెమెరా వైపు నేరుగా చూసి మళ్లీ ప్రారంభించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เห็นคุณ มองตรงไปที่กล้องแล้วเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi kaybettik; doğrudan kameraya bakın ve yeniden başlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми вас загубили — дивіться прямо в камеру й почніть знову"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نظر سے اوجھل ہو گئے — سیدھا کیمرے کی طرف دیکھیں اور دوبارہ شروع کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất dấu bạn — hãy nhìn thẳng vào camera và bắt đầu lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟丢了，请正对相机重新开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測不到你，請直視相機並重新開始"
          }
        }
      }
    },
    "document.sweep.start.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ الكاميرا ودوران الرأس"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা ও মাথা ঘোরানো শুরু করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la càmera i el gir del cap"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí fotoaparát a otáčení hlavy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter kameraet og hoveddrejningen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Kamera und die Kopfdrehung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά την κάμερα και τη στροφή του κεφαλιού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the camera and the head-turn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la cámara y el giro de cabeza"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistää kameran ja pään kääntämisen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre l’appareil photo et la rotation de la tête"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל את המצלמה ואת סיבוב הראש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा और सिर घुमाना शुरू करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
