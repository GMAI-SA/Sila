          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện hoặc ẩn %@ trong danh sách thông báo của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通知列表中显示或隐藏%@"
          }
        },
        "zh-Hant": {
