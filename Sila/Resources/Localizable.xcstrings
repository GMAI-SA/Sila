            "state": "translated",
            "value": "Hilo de país. Solo pueden responder las cuentas verificadas en %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaketju. Vain maassa %@ vahvistetut tilit voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion de pays. Seuls les comptes vérifiés en %@ peuvent répondre."
