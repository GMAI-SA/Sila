    "safety.block.consequence.follows": {
      "comment": "Block consequence 2 of 4: the follows it severs, in both directions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقطع أي متابعة بينكما في الاتجاهين. وإن كنتما تتابعان بعضكما، تُزال المتابعتان معًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাদের মধ্যকার যেকোনো ফলো দুদিক থেকেই ছিন্ন হয়। আপনারা পরস্পরকে ফলো করলে দুটি ফলোই সরে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol seguiment entre vosaltres es talla, en ambdós sentits. Si us seguiu mútuament, s'eliminen els dos seguiments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veškeré sledování mezi vámi se přeruší, oběma směry. Pokud se sledujete navzájem, obě sledování se odeberou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver følgning mellem jer afbrydes, begge veje. Hvis I følger hinanden, fjernes begge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Follow zwischen euch wird in beide Richtungen getrennt. Wenn ihr euch gegenseitig folgt, werden beide Follows entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ακολούθηση μεταξύ σας διακόπτεται, και προς τις δύο κατευθύνσεις. Αν ακολουθείτε ο ένας τον άλλον, αφαιρούνται και οι δύο ακολουθήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any follow between you is severed, both ways. If you follow each other, both follows are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se corta cualquier seguimiento entre vosotros, en ambos sentidos. Si os seguíais mutuamente, se eliminan los dos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki välillänne olevat seuraamiset katkaistaan molempiin suuntiin. Jos seuraatte toisianne, molemmat seuraamiset poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout abonnement entre vous est rompu, dans les deux sens. Si vous vous suivez mutuellement, les deux abonnements sont supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מעקב ביניכם מנותק, בשני הכיוונים. אם אתם עוקבים זה אחרי זה, שני המעקבים מוסרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बीच कोई भी फ़ॉलो दोनों तरफ़ से कट जाता है। अगर आप एक-दूसरे को फ़ॉलो करते हैं, तो दोनों फ़ॉलो हट जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako praćenje među vama prekida se, u oba smjera. Ako pratite jedno drugo, oba praćenja se uklanjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A köztetek lévő követések mindkét irányban megszűnnek. Ha követitek egymást, mindkettő törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua hubungan mengikuti di antara kalian diputus, dua arah. Jika kalian saling mengikuti, kedua-duanya dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni follow tra voi viene interrotto, in entrambe le direzioni. Se vi seguite a vicenda, entrambi i follow vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人の間のフォローは、双方向とも解除されます。お互いにフォローしている場合は、両方が解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 사이의 팔로우가 양방향으로 끊어져요. 서로 팔로우하고 있었다면 두 팔로우가 모두 해제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കിടയിലെ ഏത് ഫോളോയും ഇരുവശത്തും ഇല്ലാതാകും. പരസ്പരം ഫോളോ ചെയ്യുന്നുണ്ടെങ്കിൽ രണ്ടും നീക്കം ചെയ്യും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebarang ikutan antara anda diputuskan, kedua-dua hala. Jika anda saling mengikut, kedua-dua ikutan dialih keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "All følging mellom dere avbrytes, begge veier. Hvis dere følger hverandre, fjernes begge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke volgrelatie tussen jullie wordt in beide richtingen verbroken. Als jullie elkaar volgen, worden beide verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszelkie obserwowanie między Wami zostaje przerwane w obie strony. Jeśli obserwujecie się nawzajem, oba obserwowania są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer vínculo de seguir entre vocês é desfeito, nos dois sentidos. Se vocês se seguem, os dois vínculos são removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer seguimento entre vocês é cortado, nos dois sentidos. Se se seguem mutuamente, ambos os seguimentos são removidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice urmărire dintre voi este întreruptă, în ambele sensuri. Dacă vă urmăriți reciproc, ambele urmăriri sunt eliminate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все подписки между вами разрываются в обе стороны. Если вы подписаны друг на друга, обе подписки удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akékoľvek sledovanie medzi vami sa zruší na oboch stranách. Ak sa sledujete navzájom, odstránia sa obe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "All följning mellan er bryts, åt båda håll. Om ni följer varandra tas båda bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கிடையிலான பின்தொடர்தல்கள் இரு திசையிலும் துண்டிக்கப்படும். நீங்கள் ஒருவரையொருவர் பின்தொடர்ந்தால் இரண்டும் அகற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మధ్య ఉన్న ఏ ఫాలో అయినా రెండు వైపులా తెగిపోతుంది. మీరు ఒకరినొకరు ఫాలో అయితే, రెండు ఫాలోలు తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตามระหว่างกันจะถูกตัดทั้งสองทาง หากติดตามกันอยู่ ทั้งสองการติดตามจะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aranızdaki takipler iki yönlü olarak kesilir. Birbirinizi takip ediyorsanız ikisi de kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-яка підписка між вами розривається в обидва боки. Якщо ви підписані одне на одного, обидві підписки видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے درمیان کوئی بھی فالو دونوں طرف سے ختم ہو جاتا ہے۔ اگر آپ ایک دوسرے کو فالو کرتے ہیں تو دونوں فالو ہٹ جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi lượt theo dõi giữa hai bên bị cắt, theo cả hai chiều. Nếu hai bạn theo dõi nhau, cả hai đều bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们之间的任何关注都会被双向切断。如果你们互相关注，两个关注都会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們之間的任何追蹤關係都會雙向切斷。如果你們互相追蹤，兩邊的追蹤都會移除。"
          }
        }
      }
    },
    "safety.block.consequence.notRestored": {
      "comment": "Block consequence 3 of 4: unblocking does not put the follows back. The one people do not expect, and the reason this is a dialog.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الحظر لاحقًا لا يعيدها. فلن يعود أي منكما متابعًا للآخر، وسيحتاج كل منكما إلى المتابعة من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরে আনব্লক করলে তাদের ফিরিয়ে আনা হয় না। আপনারা কেউ আর কাউকে ফলো করবেন না; প্রত্যেককে নতুন করে ফলো করতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquejar més tard no els restaura. Cap dels dos no tornaria a seguir l'altre; cadascú hauria de tornar a seguir des de zero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozdější odblokování je nevrátí. Ani jeden z vás by druhého nesledoval; museli byste začít sledovat znovu od nuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du fjerner blokeringen senere, kommer de ikke tilbage. Ingen af jer ville følge den anden igen; I skulle følge hinanden forfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du später entblockst, wird das nicht rückgängig gemacht. Keiner von euch folgt dem anderen wieder; ihr müsstet beide von vorn folgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η άρση αποκλεισμού αργότερα δεν τους επαναφέρει. Κανείς από τους δύο δεν θα ακολουθεί ξανά τον άλλον· θα πρέπει να ακολουθήσετε ξανά από την αρχή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblocking later does not put them back. Neither of you would be following the other again; you would each have to follow again from scratch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear más tarde no los restablece. Ninguno de los dos volvería a seguir al otro; tendríais que volver a seguiros desde cero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eston poistaminen myöhemmin ei palauta niitä. Kumpikaan ei seuraisi toista; teidän kummankin olisi aloitettava seuraaminen alusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquer plus tard ne les rétablit pas. Aucun de vous ne suivrait à nouveau l’autre ; chacun devrait se réabonner depuis le début."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול החסימה מאוחר יותר לא מחזיר אותם. אף אחד מכם לא יעקוב שוב אחרי השני; כל אחד יצטרך לעקוב מחדש מההתחלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद में अनब्लॉक करने से वे वापस नहीं आते। आप में से कोई भी दूसरे को फ़ॉलो नहीं कर रहा होगा; आपको दोनों को शुरू से फिर फ़ॉलो करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasnije odblokiranje ne vraća ih. Nitko od vas više ne bi pratio drugoga; svatko bi morao ponovno pratiti ispočetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A későbbi feloldás nem állítja vissza őket. Egyikőtök sem követné újra a másikat; mindketten előröl kellene kezdenetek a követést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka blokir nanti tidak mengembalikan mereka. Tidak ada di antara kalian yang kembali mengikuti yang lain; masing-masing harus mengikuti lagi dari awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbloccare più tardi non li ripristina. Nessuno dei due seguirebbe di nuovo l'altro; dovreste seguirvi di nuovo da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとでブロックを解除しても、元には戻りません。お互いにフォローし直した状態にはならず、それぞれ最初からフォローし直す必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 차단을 해제해도 복원되지 않아요. 서로 다시 팔로우하는 상태가 되지 않으며, 각자 처음부터 다시 팔로우해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിന്നീട് അൺബ്ലോക്ക് ചെയ്താലും അവ തിരികെ വരില്ല. ഇരുവരും പരസ്പരം വീണ്ടും ഫോളോ ചെയ്യില്ല; ആദ്യം മുതൽ വീണ്ടും ഫോളോ ചെയ്യണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyahsekat kemudian tidak mengembalikan mereka. Tiada seorang pun daripada anda akan mengikut yang lain semula; masing-masing perlu mengikut semula dari awal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å oppheve blokkeringen senere setter dem ikke tilbake. Ingen av dere følger den andre igjen. Dere må begge følge på nytt fra bunnen av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Later deblokkeren zet ze niet terug. Jullie volgen elkaar dan niet meer; jullie moeten elkaar allebei opnieuw volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Późniejsze odblokowanie ich nie przywraca. Żadne z Was nie będzie znów obserwować drugiego; każde musiałoby zacząć obserwować od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear depois não os restaura. Nenhum dos dois voltaria a seguir o outro; cada um teria de seguir de novo do zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear mais tarde não os repõe. Nenhum de vocês voltaria a seguir o outro; teriam de voltar a seguir do zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocarea ulterioară nu le readuce. Niciunul dintre voi nu l-ar mai urmări pe celălalt; ar trebui să vă urmăriți din nou de la zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировка позже их не вернёт. Вы больше не будете подписаны друг на друга; подписываться придётся заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neskoršie odblokovanie ich nevráti. Nikto z vás by už nesledoval toho druhého; museli by ste sa znova začať sledovať odznova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att avblockera senare ger inte tillbaka dem. Ingen av er skulle följa den andra igen; ni måste var och en följa på nytt från början."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னர் தடையை நீக்கினாலும் அவை திரும்பாது. உங்களில் யாரும் மற்றவரைப் பின்தொடர மாட்டீர்கள்; ஒவ்வொருவரும் புதிதாகப் பின்தொடர வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తర్వాత అన్‌బ్లాక్ చేసినా వారిని తిరిగి తేదు. మీలో ఎవరూ మళ్లీ మరొకరిని ఫాలో అవ్వరు; మీరిద్దరూ మొదటి నుండి మళ్లీ ఫాలో అవ్వాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลิกบล็อกภายหลังไม่ได้นำพวกเขากลับมา ทั้งสองฝ่ายจะไม่ได้ติดตามกันอีก และต้องติดตามใหม่ตั้งแต่ต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engeli sonradan kaldırmak onları geri getirmez. Hiçbiriniz diğerini yeniden takip etmiyor olur; her biriniz sıfırdan yeniden takip etmelisiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подальше розблокування не повертає їх. Жоден із вас не буде підписаний на іншого; кожному доведеться підписатися знову з нуля."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد میں ان بلاک کرنے سے وہ واپس نہیں آتے۔ آپ میں سے کوئی بھی دوسرے کو دوبارہ فالو نہیں کر رہا ہوگا؛ ہر ایک کو نئے سرے سے فالو کرنا ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ chặn sau này không khôi phục lại. Hai bên sẽ không theo dõi nhau nữa; mỗi người phải theo dõi lại từ đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后取消屏蔽不会恢复关注。你们谁都不会再关注对方，需要各自重新关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後解除封鎖不會恢復追蹤。你們都不會再追蹤對方，必須各自重新追蹤。"
          }
        }
      }
    },
    "safety.block.consequence.silent": {
      "comment": "Block consequence 4 of 4: the other person is not told. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُبلَّغ %@ بذلك. لا يرسل معروف أي إشعار ولا يعرض عليه أي رسالة بهذا الشأن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে জানানো হয় না। Known কোনো বিজ্ঞপ্তি পাঠায় না এবং এ নিয়ে তাদের কোনো বার্তা দেখায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no n'és informat. Known no envia cap notificació ni li mostra cap missatge sobre això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ se to nedozví. Known neposílá žádné oznámení ani zprávu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får ikke besked. Known sender ingen notifikation og viser ingen besked om dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird nicht benachrichtigt. Known sendet dazu keine Mitteilung und zeigt der Person keine Nachricht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ δεν ενημερώνεται. Το Known δεν στέλνει ειδοποίηση ούτε εμφανίζει μήνυμα σχετικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not told. Known sends no notification and shows them no message about this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se avisa a %@. Known no envía ninguna notificación ni le muestra ningún mensaje sobre esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjälle %@ ei kerrota. Known ei lähetä ilmoitusta eikä näytä hänelle viestiä tästä."
