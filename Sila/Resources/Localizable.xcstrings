            "value": "விவரங்களைச் சரிபாருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వివరాలను తనిఖీ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรายละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgileri kontrol edin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте дані"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تفصیلات جانچیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra thông tin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对详细信息"
          }
