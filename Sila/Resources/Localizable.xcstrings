    "rooms.chat.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقل شيء بعد. والاستماع جيد أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কিছু বলা হয়নি। শুধু শুনলেও চলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no s'ha dit res. Escoltar també està bé."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nic nepadlo. Poslouchat také stačí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet sagt endnu. Det er også fint bare at lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gesagt. Zuhören ist auch in Ordnung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει ειπωθεί τίποτα ακόμα. Το να ακούς είναι εντάξει κι αυτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing said yet. Listening is fine too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha dicho nada. Escuchar también está bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä sanottu mitään. Kuunteleminenkin käy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a encore été dit. Écouter, c’est bien aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נאמר דבר. גם להאזין זה בסדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ नहीं कहा गया। सुनना भी ठीक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa nije rečeno. I slušanje je u redu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem hangzott el semmi. A hallgatás is rendben van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang bicara. Mendengarkan saja juga tidak apa-apa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nulla di detto. Anche ascoltare va bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰も話していません。聴くだけでも大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무 말도 없어요. 듣기만 해도 좋아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ഒന്നും പറഞ്ഞിട്ടില്ല. കേൾക്കുന്നതും നല്ലതാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dikatakan. Mendengar pun tidak mengapa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting sagt ennå. Det er greit å bare lytte også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets gezegd. Luisteren is ook prima."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic nie powiedziano. Słuchanie też jest w porządku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada dito ainda. Só ouvir também vale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada foi dito. Ouvir também está bem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu s-a spus nimic. Și ascultatul e în regulă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не сказано. Можно и просто слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nič nepovedané. Počúvať je tiež v poriadku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget sagt än. Det går bra att bara lyssna också."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் யாரும் பேசவில்லை. கேட்டுக்கொண்டிருப்பதும் சரிதான்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఎవరూ ఏమీ అనలేదు. వింటూ ఉండటం కూడా సరే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีใครพูด ฟังเฉยๆ ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey söylenmedi. Dinlemek de olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого не сказано. Просто слухати теж нормально."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کچھ نہیں کہا گیا۔ سننا بھی ٹھیک ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ai nói gì. Chỉ nghe cũng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有人发言。只听也很好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有人發言。只聽也沒關係。"
          }
        }
      }
    },
