    "profile.timeline.scope": {
      "comment": "Says the timeline is top-level posts only — replies are neither listed nor counted. Shown even when the list is empty, because the exclusion is a fact about the list, not about today's rows.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشورات الأصلية فقط. تبقى الردود في السلاسل التي تنتمي إليها، فلا تُعرض هنا ولا تُحتسب في العدد أعلاه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top-level posts only. Replies stay in the threads they belong to, so they are not listed here and are not counted above."
          }
        }
      }
    },
    "profile.unavailable.handleFallback": {
      "comment": "Stands in for the handle when there is none to name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المعرّف"
