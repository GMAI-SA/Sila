    "rooms.mic.takeHint": {
      "comment": "What unmuting does, including that iOS will ask for permission — said before the dialog appears, because an unannounced prompt is one people deny by reflex.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل الميكروفون ليسمعك من في الغرفة. وسيطلب iOS إذن الميكروفون في المرة الأولى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মাইক্রোফোন চালু করে যাতে রুম আপনাকে শুনতে পায়। প্রথমবার iOS মাইক্রোফোনের অনুমতি চায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encén el teu micròfon perquè la sala et senti. iOS et demana permís per al micròfon la primera vegada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne tvůj mikrofon, aby tě místnost slyšela. iOS se na oprávnění k mikrofonu zeptá poprvé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænder din mikrofon, så rummet kan høre dig. iOS beder om mikrofontilladelse første gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet dein Mikrofon ein, damit der Raum dich hören kann. iOS fragt beim ersten Mal nach der Mikrofonberechtigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιεί το μικρόφωνό σου ώστε η αίθουσα να σε ακούει. Το iOS ζητά άδεια μικροφώνου την πρώτη φορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns your microphone on so the room can hear you. iOS asks for microphone permission the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende tu micrófono para que la sala pueda oírte. iOS pide permiso para el micrófono la primera vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytkee mikrofonisi päälle, jotta huone kuulee sinut. iOS pyytää mikrofonin käyttöoikeutta ensimmäisellä kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active votre micro pour que le salon vous entende. iOS demande l’autorisation du micro la première fois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל את המיקרופון שלך כדי שהחדר ישמע אותך. iOS מבקשת הרשאת מיקרופון בפעם הראשונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका माइक्रोफ़ोन चालू करता है ताकि रूम आपको सुन सके। पहली बार iOS माइक्रोफ़ोन की अनुमति माँगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključuje tvoj mikrofon da te soba čuje. iOS prvi put traži dopuštenje za mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolja a mikrofonodat, hogy a szoba hallhasson. Az iOS először mikrofonengedélyt kér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan mikrofonmu agar room bisa mendengarmu. iOS meminta izin mikrofon saat pertama kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accende il tuo microfono così la stanza può sentirti. iOS chiede il permesso del microfono la prima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをオンにして、ルームにあなたの声が聞こえるようにします。初回はiOSがマイクの許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 켜서 룸에서 내 목소리가 들리게 해요. 처음에는 iOS가 마이크 권한을 요청해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമിന് കേൾക്കാൻ നിങ്ങളുടെ മൈക്രോഫോൺ ഓണാക്കുന്നു. ആദ്യ തവണ iOS മൈക്രോഫോൺ അനുമതി ചോദിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan mikrofon anda supaya bilik dapat mendengar anda. iOS meminta kebenaran mikrofon pada kali pertama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på mikrofonen din slik at rommet kan høre deg. iOS ber om tillatelse til mikrofonen første gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je microfoon aan zodat de room je kan horen. iOS vraagt de eerste keer om toestemming voor de microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza Twój mikrofon, aby pokój mógł Cię słyszeć. iOS prosi o zgodę na mikrofon przy pierwszym użyciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga seu microfone para que a sala ouça você. O iOS pede permissão de microfone na primeira vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga o seu microfone para que a sala o ouça. O iOS pede permissão para o microfone na primeira vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește microfonul ca să te audă camera. iOS cere permisiunea pentru microfon prima dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает ваш микрофон, чтобы комната вас слышала. В первый раз iOS запросит разрешение на доступ к микрофону."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne tvoj mikrofón, aby ťa miestnosť počula. iOS si pri prvom použití vyžiada povolenie k mikrofónu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på din mikrofon så att rummet kan höra dig. iOS ber om mikrofontillstånd första gången."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறை உங்களைக் கேட்கும்படி மைக்ரோஃபோனை இயக்கும். முதல் முறை iOS மைக்ரோஃபோன் அனுமதி கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌కు వినిపించేలా మీ మైక్రోఫోన్‌ను ఆన్ చేస్తుంది. మొదటిసారి iOS మైక్రోఫోన్ అనుమతి అడుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไมโครโฟนของคุณเพื่อให้ห้องได้ยินคุณ iOS จะขออนุญาตใช้ไมโครโฟนในครั้งแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odanın sizi duyması için mikrofonunuzu açar. iOS ilk seferde mikrofon izni ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає ваш мікрофон, щоб кімната вас чула. iOS запитає дозвіл на мікрофон уперше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مائیکروفون آن کرتا ہے تاکہ روم آپ کو سن سکے۔ iOS پہلی بار مائیکروفون کی اجازت مانگتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật micro để phòng nghe được bạn. iOS sẽ xin quyền dùng micro lần đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你的麦克风，让房间听到你。iOS 会在首次使用时请求麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟你的麥克風，讓聊天室聽到你。iOS 第一次會詢問麥克風權限。"
          }
        }
      }
    },
