        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஊட்டத்தை வடிகட்டும் தலைப்பு மற்றும் ஒலியடக்கிய நாட்டு அமைப்புகளைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫీడ్‌ను ఫిల్టర్ చేసే అంశం, మ్యూట్ చేసిన దేశం సెట్టింగ్‌లను తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่าหัวข้อและประเทศที่ปิดเสียงซึ่งกรองฟีดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu akışı filtreleyen konu ve sessize alınmış ülke ayarlarını açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває налаштування тем і країн із вимкненими сповіщеннями, які фільтрують цю стрічку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فیڈ کو فلٹر کرنے والی موضوع اور میوٹ ممالک کی سیٹنگز کھولتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cài đặt chủ đề và quốc gia đã ẩn dùng để lọc bảng tin này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开用于筛选此信息流的话题和已静音国家设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟用來篩選此動態的主題與靜音國家設定"
          }
        }
      }
