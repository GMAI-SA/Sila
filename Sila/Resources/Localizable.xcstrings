    "vouch.wall.pending.message": {
      "comment": "%1$@ is the voucher's handle, %2$@ a date and time.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمام ⁦@%1$@⁩ حتى %2$@ ليؤكّد. يمكنك توثيق هويتك في الأثناء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করতে @%1$@-এর হাতে %2$@ পর্যন্ত সময় আছে। ইতিমধ্যে আপনি নিজের পরিচয় ভেরিফাই করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ té fins al %2$@ per confirmar. Mentrestant pots verificar la teva pròpia identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ má čas do %2$@ na potvrzení. Mezitím můžeš ověřit vlastní totožnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ har frist til %2$@ til at bekræfte. Du kan i mellemtiden verificere din egen identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ hat bis %2$@ Zeit zu bestätigen. Du kannst in der Zwischenzeit deine eigene Identität verifizieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%1$@ έχει προθεσμία έως %2$@ για να επιβεβαιώσει. Στο μεταξύ μπορείς να επαληθεύσεις την ταυτότητά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ has until %2$@ to confirm. You can verify your own identity meanwhile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ tiene hasta el %2$@ para confirmar. Mientras tanto, puedes verificar tu propia identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjällä @%1$@ on aikaa %2$@ asti vahvistaa. Voit sillä välin vahvistaa oman henkilöllisyytesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ a jusqu’au %2$@ pour confirmer. Vous pouvez vérifier votre propre identité en attendant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-@%1$@ יש עד %2$@ לאשר. בינתיים אפשר לאמת את זהותך בעצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ के पास %2$@ तक कन्फ़र्म करने का समय है। इस बीच आप अपनी पहचान खुद सत्यापित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ima vremena do %2$@ da potvrdi. U međuvremenu možeš potvrditi vlastiti identitet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ennyi ideig erősítheti meg: %2$@. Közben hitelesítheted a saját személyazonosságodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ punya waktu sampai %2$@ untuk mengonfirmasi. Sementara itu kamu bisa memverifikasi identitasmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ha tempo fino al %2$@ per confermare. Nel frattempo puoi verificare la tua identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@の確認期限は%2$@です。その間にご自身で本人確認をすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@님은 %2$@까지 확인해야 해요. 그동안 직접 신원을 인증할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരീകരിക്കാൻ @%1$@ ന് %2$@ വരെ സമയമുണ്ട്. അതിനിടെ നിങ്ങൾക്ക് സ്വന്തം ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ mempunyai sehingga %2$@ untuk mengesahkan. Anda boleh mengesahkan identiti anda sendiri sementara itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ har frem til %2$@ på å bekrefte. Du kan verifisere din egen identitet i mellomtiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ heeft tot %2$@ om te bevestigen. Intussen kun je je eigen identiteit verifiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ ma czas do %2$@ na potwierdzenie. W międzyczasie możesz zweryfikować własną tożsamość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ tem até %2$@ para confirmar. Enquanto isso, você pode verificar sua própria identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ tem até %2$@ para confirmar. Entretanto, pode verificar a sua própria identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ are timp până la %2$@ să confirme. Între timp îți poți verifica propria identitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У @%1$@ есть время до %2$@, чтобы подтвердить. Тем временем вы можете пройти собственную проверку личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ má čas do %2$@ na potvrdenie. Medzitým si môžeš overiť vlastnú totožnosť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ har till %2$@ på sig att bekräfta. Du kan verifiera din egen identitet under tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிப்படுத்த @%1$@ க்கு %2$@ வரை அவகாசம் உள்ளது. அதற்குள் நீங்கள் உங்கள் அடையாளத்தைச் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిర్ధారించడానికి @%1$@ కు %2$@ వరకు సమయం ఉంది. ఈలోగా మీరు మీ స్వంత గుర్తింపును ధృవీకరించుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ มีเวลาถึง %2$@ เพื่อยืนยัน ระหว่างนี้คุณยืนยันตัวตนของตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ kişisinin onaylaması için %2$@ tarihine kadar süresi var. Bu arada kendi kimliğinizi doğrulayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ має час до %2$@, щоб підтвердити. Тим часом ви можете верифікувати власну особу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ کے پاس تصدیق کرنے کے لیے %2$@ تک کا وقت ہے۔ اس دوران آپ اپنی شناخت کی تصدیق کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ có đến %2$@ để xác nhận. Trong lúc đó bạn có thể tự xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 需在 %2$@ 前确认。在此期间你也可以验证自己的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 須在 %2$@ 前確認。在此期間你也可以驗證自己的身分。"
          }
        }
      }
    },
    "vouch.wall.pending.messageNoDate": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
