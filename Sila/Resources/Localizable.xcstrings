    "vouch.banner.detail": {
      "comment": "%@ is how long is left.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — وثّق هويتك لتواصل النشر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — পোস্ট করা চালিয়ে যেতে পরিচয় যাচাই করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verifica la teva identitat per continuar publicant"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – ověř svou totožnost, abys mohl dál psát"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – verificér din identitet for at kunne blive ved med at slå op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – verifiziere deine Identität, um weiter zu posten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — επαλήθευσε την ταυτότητά σου για να συνεχίσεις να δημοσιεύεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — verify your identity to keep posting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verifica tu identidad para seguir publicando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – vahvista henkilöllisyytesi jatkaaksesi julkaisemista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — vérifiez votre identité pour continuer à publier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — אמת את זהותך כדי להמשיך לפרסם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — पोस्ट करते रहने के लिए अपनी पहचान सत्यापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — potvrdi svoj identitet da nastaviš objavljivati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – hitelesítsd a személyazonosságodat, hogy továbbra is írhass"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — verifikasi identitasmu agar tetap bisa memposting"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verifica la tua identità per continuare a pubblicare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。投稿を続けるには本人確認をしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 계속 게시하려면 신원을 인증하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — പോസ്റ്റ് ചെയ്യുന്നത് തുടരാൻ നിങ്ങളുടെ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — sahkan identiti anda untuk terus menyiar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Verifiser identiteten din for å fortsette å publisere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verifieer je identiteit om te kunnen blijven posten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — zweryfikuj tożsamość, aby dalej publikować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verifique sua identidade para continuar postando"
          }
        },
        "pt-PT": {
