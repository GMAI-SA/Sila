    "rooms.create.closed.note": {
      "comment": "Note under a closed access choice.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمع هذه الغرفة إلا من تسمح لهم بالدخول. أما من يتحدث فيحدده الجمهور أعلاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার ঢুকতে দেওয়া মানুষেরা এই রুম শুনতে পারে। কে কথা বলতে পারবে তা এখনও উপরের শ্রোতা ঠিক করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només les persones que deixis entrar poden sentir aquesta sala. Qui pot parlar ho continua decidint l'audiència de dalt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto místnost uslyší jen lidé, které vpustíš. O tom, kdo smí mluvit, rozhoduje stále publikum výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de folk, du lukker ind, kan høre dette rum. Hvem der må tale, afgøres stadig af målgruppen ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Personen, die du hineinlässt, können diesen Raum hören. Wer sprechen darf, entscheidet weiterhin die Zielgruppe oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο τα άτομα που αφήνεις να μπουν μπορούν να ακούσουν αυτή την αίθουσα. Το ποιος μπορεί να μιλήσει εξακολουθεί να καθορίζεται από το κοινό παραπάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the people you let in can hear this room. Who may speak is still decided by the audience above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas a las que dejes entrar pueden oír esta sala. Quién puede hablar lo sigue decidiendo la audiencia de arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sisään päästämäsi ihmiset kuulevat tämän huoneen. Kuka saa puhua, päätetään yhä yllä olevalla yleisöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les personnes que vous faites entrer peuvent entendre ce salon. Qui peut parler reste décidé par l’audience ci-dessus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק האנשים שאתה מכניס יכולים לשמוע את החדר הזה. מי רשאי לדבר עדיין נקבע לפי הקהל שלמעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे लोग इस रूम को सुन सकते हैं जिन्हें आप अंदर आने दें। कौन बोल सकता है, यह ऊपर की ऑडियंस ही तय करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu sobu mogu čuti samo ljudi koje pustiš unutra. Tko smije govoriti i dalje određuje publika iznad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a szobát csak azok hallhatják, akiket beengedsz. Hogy ki szólalhat meg, azt továbbra is a fenti közönség dönti el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang yang kamu izinkan masuk yang bisa mendengar room ini. Siapa yang boleh berbicara tetap ditentukan oleh audiens di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone che fai entrare possono ascoltare questa stanza. Chi può parlare lo decide comunque il pubblico qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが入れた人だけがこのルームを聴けます。発言できる人は、上の範囲で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 입장시킨 사람만 이 룸을 들을 수 있어요. 말할 수 있는 사람은 위의 대상이 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അകത്തുകയറ്റുന്നവർക്ക് മാത്രമേ ഈ റൂം കേൾക്കാനാകൂ. ആർക്ക് സംസാരിക്കാമെന്നത് ഇപ്പോഴും മുകളിലെ പ്രേക്ഷകരാണ് തീരുമാനിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang yang anda benarkan masuk boleh mendengar bilik ini. Siapa yang boleh bercakap masih ditentukan oleh khalayak di atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare de du slipper inn, kan høre dette rommet. Hvem som kan snakke, avgjøres fortsatt av målgruppen ovenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de mensen die je toelaat kunnen deze room horen. Wie mag spreken wordt nog steeds bepaald door het publiek hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten pokój mogą usłyszeć tylko osoby, które wpuścisz. O tym, kto może mówić, nadal decyduje powyższa grupa odbiorców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as pessoas que você deixar entrar podem ouvir esta sala. Quem pode falar continua sendo definido pelo público acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as pessoas que deixar entrar podem ouvir esta sala. Quem pode falar continua a ser decidido pelo público acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar oamenii pe care îi lași să intre pot auzi această cameră. Cine poate vorbi este decis tot de publicul de mai sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту комнату слышат только те, кого вы впустили. Кто может говорить, по-прежнему решает аудитория выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto miestnosť môžu počuť iba ľudia, ktorých pustíš dnu. O tom, kto môže hovoriť, stále rozhoduje publikum vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara de du släpper in kan höra det här rummet. Vem som får tala avgörs fortfarande av målgruppen ovan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனுமதிப்பவர்கள் மட்டுமே இந்த அறையைக் கேட்க முடியும். யார் பேசலாம் என்பதை மேலுள்ள பார்வையாளர்களே இன்னும் தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు లోపలికి అనుమతించిన వారు మాత్రమే ఈ రూమ్‌ను వినగలరు. ఎవరు మాట్లాడవచ్చో పై ప్రేక్షకులే నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนที่คุณให้เข้าเท่านั้นที่ได้ยินห้องนี้ ใครพูดได้ยังกำหนดโดยกลุ่มผู้ชมด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odayı yalnızca içeri aldığınız kişiler duyabilir. Kimin konuşabileceğine yine yukarıdaki kitle karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю кімнату чують лише ті, кого ви впустили. Хто може говорити, як і раніше, визначає аудиторія вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس روم کو صرف وہی لوگ سن سکتے ہیں جنہیں آپ اندر آنے دیں۔ کون بول سکتا ہے یہ اب بھی اوپر کے ناظرین طے کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người bạn cho vào mới nghe được phòng này. Ai được phát biểu vẫn do đối tượng ở trên quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你放行的人才能听到此房间。谁可以发言仍由上方的受众决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你放行的人能聽到此聊天室。誰能發言仍由上方的對象範圍決定。"
          }
        }
      }
    },
    "rooms.create.community": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "داخل مجتمع"
          }
        },
        "bn": {
