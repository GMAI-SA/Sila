    "safety.lists.muted.row.hint": {
      "comment": "VoiceOver hint on an unmute button. %@ is the account's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد منشورات %@ للظهور لك. ولا يُبلَّغ في الحالتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর পোস্ট আবার আপনার ফিডে আসতে দেয়। কোনো পক্ষেই তাদের জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a deixar entrar les publicacions de %@ als teus canals. En cap cas no ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí příspěvky uživatele %@ do tvých kanálů. V obou případech se to nedozví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader opslag fra %@ komme tilbage i dine feeds. Vedkommende får ikke besked i begge tilfælde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die Beiträge von %@ wieder in deine Feeds. In keinem Fall wird die Person benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει ξανά τις αναρτήσεις του/της %@ στις ροές σου. Δεν ενημερώνεται σε καμία περίπτωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets %@'s posts back into your feeds. They are not told either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a mostrar las publicaciones de %@ en tus feeds. No se le avisa en ningún caso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päästää käyttäjän %@ julkaisut takaisin syötteisiisi. Hänelle ei kerrota kumpaakaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet les posts de %@ dans vos fils. Il n’en est informé dans aucun cas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיר את הפוסטים של %@ לפידים שלך. הוא לא מקבל הודעה בשני המקרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की पोस्ट को आपकी फ़ीड में वापस आने देता है। दोनों में से किसी तरह उन्हें बताया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća objave korisnika %@ u tvoje feedove. Ni u jednom slučaju nije obaviješten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra beengedi %@ bejegyzéseit a hírfolyamaidba. Egyik esetben sem kap értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan postingan %@ kembali ke feed-mu. Mereka tidak diberi tahu dalam kedua kasus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riammette i post di %@ nei tuoi feed. In entrambi i casi non viene avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の投稿をフィードに再び表示します。どちらの場合も相手には知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님의 게시물이 다시 내 피드에 나타나요. 어느 쪽이든 상대방에게는 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളുടെ പോസ്റ്റുകൾ വീണ്ടും നിങ്ങളുടെ ഫീഡുകളിൽ കാണിക്കുന്നു. ഏതായാലും അവരെ അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan siaran %@ kembali ke suapan anda. Mereka tidak diberitahu dalam kedua-dua keadaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipper innleggene til %@ inn i feedene dine igjen. De får ikke vite det uansett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de berichten van %@ weer in je feeds toe. Ze worden in beide gevallen niet op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca wpisy: %@ do Twoich kanałów. W obu przypadkach nie jest informowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz de volta os posts de %@ aos seus feeds. A pessoa não é avisada em nenhum dos casos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a permitir as publicações de %@ nos seus feeds. Em nenhum dos casos são avisados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Readuce postările lui %@ în fluxurile tale. Nu este anunțat în niciun caz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает посты %@ в ваши ленты. В обоих случаях он(а) не узнает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti príspevky používateľa %@ do tvojich kanálov. V oboch prípadoch sa o tom nedozvie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpper tillbaka %@s inlägg i dina flöden. De får inte veta det, vare sig det ena eller andra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் இடுகைகளை மீண்டும் உங்கள் ஊட்டங்களில் அனுமதிக்கும். எப்படியும் அவர்களுக்குத் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ పోస్ట్‌లను మీ ఫీడ్‌లలోకి తిరిగి అనుమతిస్తుంది. ఎలాగైనా వారికి చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้โพสต์ของ %@ กลับเข้าฟีดของคุณ ไม่ว่าทางใดพวกเขาก็ไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin gönderilerini akışlarınıza geri alır. Her iki durumda da kendisine haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає дописи %@ у ваші стрічки. Нікого не повідомляють в обох випадках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کی پوسٹس کو آپ کی فیڈز میں واپس آنے دیتا ہے۔ دونوں صورتوں میں انہیں نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho bài đăng của %@ trở lại bảng tin của bạn. Họ không được thông báo dù thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 %@ 的帖子重新出现在你的信息流中。无论哪种操作，对方都不会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 %@ 的貼文重新出現在你的動態中。無論哪種情況對方都不會得知。"
          }
        }
      }
    },
