        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वाउच आपको क्या करने देता है, और कैसे सत्यापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što ti jamstvo omogućuje i kako se potvrditi"
