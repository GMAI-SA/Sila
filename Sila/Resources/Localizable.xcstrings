        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও কাউকে ফলো করছেন না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no segueixes ningú"
          }
        },
        "cs": {
          "stringUnit": {
