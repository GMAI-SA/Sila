    "composer.cancel.a11yHintDiscard": {
      "comment": "VoiceOver hint for Cancel when there is a draft to lose.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسألك إن كنت تريد تجاهل هذه المسودة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই খসড়া বাতিল করবেন কি না জিজ্ঞেস করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta si vols descartar aquest esborrany"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptá se, zda zahodit tento koncept"
