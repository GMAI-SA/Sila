        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt. Trykk igjen for å fjerne valget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerd. Tik opnieuw om te wissen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrano. Stuknij ponownie, aby wyczyścić."
