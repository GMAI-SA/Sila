    "rooms.create.topicsFailed": {
      "comment": "Shown when the topic list could not be loaded. A topic is optional.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحمَّل قائمة مواضيع «معروف». يمكنك فتح الغرفة بدون موضوع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এর বিষয়ের তালিকা লোড হয়নি। বিষয় ছাড়াই রুম খুলতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha carregat la llista de temes de Known. Pots obrir la sala sense tema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam témat aplikace Known se nenačetl. Místnost můžeš otevřít i bez něj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns emneliste blev ikke indlæst. Du kan åbne rummet uden et emne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Themenliste von Known wurde nicht geladen. Du kannst den Raum auch ohne Thema öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λίστα θεμάτων του Known δεν φορτώθηκε. Μπορείς να ανοίξεις την αίθουσα χωρίς θέμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known's topic list didn't load. You can open the room without one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cargó la lista de temas de Known. Puedes abrir la sala sin tema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownin aiheluetteloa ei ladattu. Voit avata huoneen ilman aihetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des sujets de Known ne s’est pas chargée. Vous pouvez ouvrir le salon sans sujet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת הנושאים של Known לא נטענה. אפשר לפתוח את החדר גם בלי נושא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known की टॉपिक सूची लोड नहीं हुई। आप बिना टॉपिक के भी रूम खोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popis tema aplikacije Known nije se učitao. Sobu možeš otvoriti i bez teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known témalistája nem töltődött be. A szobát téma nélkül is megnyithatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar topik Known tidak termuat. Kamu bisa membuka room tanpa topik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco degli argomenti di Known non si è caricato. Puoi aprire la stanza senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownのトピック一覧を読み込めませんでした。トピックなしでルームを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known의 주제 목록을 불러오지 못했어요. 주제 없이 룸을 열 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ന്റെ വിഷയ പട്ടിക ലോഡ് ചെയ്തില്ല. വിഷയമില്ലാതെ റൂം തുറക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai topik Known tidak dimuatkan. Anda boleh membuka bilik tanpanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns emneliste ble ikke lastet. Du kan åpne rommet uten emne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onderwerpenlijst van Known is niet geladen. Je kunt de room ook zonder onderwerp openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista tematów Known się nie wczytała. Możesz otworzyć pokój bez tematu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de temas do Known não carregou. Você pode abrir a sala sem um."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de tópicos da Known não carregou. Pode abrir a sala sem um."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de subiecte Known nu s-a încărcat. Poți deschide camera fără subiect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список тем Known не загрузился. Комнату можно открыть и без темы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam tém Known sa nenačítal. Miestnosť môžeš otvoriť aj bez témy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowns ämneslista lästes inte in. Du kan öppna rummet utan ämne."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இன் தலைப்புப் பட்டியல் ஏற்றப்படவில்லை. தலைப்பு இல்லாமலும் அறையைத் திறக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known అంశాల జాబితా లోడ్ కాలేదు. అది లేకుండానే రూమ్ తెరవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดรายการหัวข้อของ Known ไม่สำเร็จ คุณเปิดห้องโดยไม่มีหัวข้อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'un konu listesi yüklenmedi. Odayı konu olmadan açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список тем Known не завантажився. Ви можете відкрити кімнату без теми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known کے موضوعات کی فہرست لوڈ نہیں ہوئی۔ آپ بغیر موضوع کے روم کھول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách chủ đề của Known không tải được. Bạn vẫn có thể mở phòng mà không cần chủ đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 的话题列表未能加载。你可以不选话题直接开启房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 的主題清單未能載入。你可以不選主題直接開設聊天室。"
          }
        }
      }
    },
