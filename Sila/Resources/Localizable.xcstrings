    "vouch.summons.explain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل بكلماتك إن كنت تتمسّك بتزكيتك أو كنت مخطئًا. يقرأ المشرف إجابتك قبل أن يقرّر أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি আপনার ভাউচে অটল আছেন, নাকি ভুল করেছিলেন, তা নিজের ভাষায় লিখুন। কিছু সিদ্ধান্ত নেওয়ার আগে একজন মডারেটর এটি পড়বেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Digues amb les teves paraules si mantens el teu aval o t'havies equivocat. Un moderador ho llegeix abans de decidir res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekni vlastními slovy, zda za svým ručením stojíš, nebo ses spletl. Moderátor si to přečte, než cokoli rozhodne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv med dine egne ord, om du står ved din garanti, eller om du tog fejl. En moderator læser det, før der afgøres noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag in eigenen Worten, ob du zu deiner Bürgschaft stehst oder dich geirrt hast. Ein Moderator liest es, bevor er etwas entscheidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες με δικά σου λόγια αν στηρίζεις την εγγύησή σου ή έκανες λάθος. Ένας συντονιστής τη διαβάζει πριν αποφασίσει οτιδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say in your own words whether you stand by your vouch or were wrong. A moderator reads it before deciding anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di con tus propias palabras si mantienes tu aval o te equivocaste. Un moderador lo lee antes de decidir nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro omin sanoin, seisotko takuusi takana vai erehdyitkö. Moderaattori lukee sen ennen kuin päättää mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites avec vos propres mots si vous maintenez votre caution ou si vous vous êtes trompé. Un modérateur le lit avant de décider quoi que ce soit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתוב במילים שלך אם אתה עומד מאחורי הערבות שלך או שטעית. מנהל תוכן קורא את זה לפני שיחליט דבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शब्दों में बताएँ कि आप अपने वाउच पर कायम हैं या आप ग़लत थे। कुछ भी तय करने से पहले एक मॉडरेटर इसे पढ़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svojim riječima reci stojiš li iza svog jamstva ili si pogriješio/la. Moderator to čita prije nego išta odluči."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le a saját szavaiddal, kiállsz-e a kezességed mellett, vagy tévedtél. Egy moderátor elolvassa, mielőtt bármit eldönt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakan dengan kata-katamu sendiri apakah kamu tetap pada jaminanmu atau keliru. Moderator membacanya sebelum memutuskan apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' con parole tue se confermi la tua garanzia o se ti sei sbagliato. Un moderatore la legge prima di decidere qualsiasi cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証を維持するのか、誤りだったのかを、ご自身の言葉で書いてください。モデレーターが読んだうえで判断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증을 유지할지, 잘못되었는지 직접 말해 주세요. 모더레이터가 읽은 후에 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വൗച്ചിൽ ഉറച്ചുനിൽക്കുന്നുവോ അതോ തെറ്റുപറ്റിയോ എന്ന് സ്വന്തം വാക്കുകളിൽ പറയുക. എന്തെങ്കിലും തീരുമാനിക്കുന്നതിന് മുമ്പ് ഒരു മോഡറേറ്റർ ഇത് വായിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyatakan dalam kata-kata anda sendiri sama ada anda berpegang pada jaminan anda atau tersilap. Seorang moderator membacanya sebelum memutuskan apa-apa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si med egne ord om du står ved garantien din eller tok feil. En moderator leser det før noe avgjøres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg in je eigen woorden of je achter je garantie staat of ernaast zat. Een moderator leest het voordat er iets wordt beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz własnymi słowami, czy podtrzymujesz swoje poręczenie, czy się myliłeś. Moderator przeczyta to, zanim cokolwiek zdecyduje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga com suas palavras se você mantém seu aval ou se errou. Um moderador lê antes de decidir qualquer coisa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga por palavras suas se mantém o seu aval ou se errou. Um moderador lê antes de decidir o que quer que seja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune cu cuvintele tale dacă te menții pe garanție sau ai greșit. Un moderator o citește înainte să decidă ceva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своими словами скажите, подтверждаете ли вы своё поручительство или ошиблись. Модератор прочтёт это, прежде чем что-либо решать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastnými slovami napíš, či si za svojím ručením stojíš, alebo si sa mýlil. Moderátor si to prečíta, skôr než čokoľvek rozhodne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta med dina egna ord om du står fast vid ditt intygande eller hade fel. En moderator läser det innan något beslutas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உறுதிமொழியில் நீங்கள் உறுதியாக இருக்கிறீர்களா அல்லது தவறு செய்தீர்களா என்பதை உங்கள் சொற்களில் சொல்லுங்கள். எதையும் முடிவு செய்யும் முன் மதிப்பாளர் இதைப் படிப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హామీకి కట్టుబడి ఉన్నారా లేదా పొరపాటు చేశారా అనేది మీ స్వంత మాటల్లో చెప్పండి. ఏదైనా నిర్ణయించే ముందు మోడరేటర్ దాన్ని చదువుతారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกด้วยคำพูดของคุณว่ายังยืนยันการรับรองของคุณ หรือคุณคิดผิด ผู้ดูแลจะอ่านก่อนตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefilliğinizin arkasında durup durmadığınızı veya yanılıp yanılmadığınızı kendi sözlerinizle yazın. Bir moderatör, herhangi bir karar vermeden önce okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть своїми словами, чи підтримуєте ви своє поручительство, чи помилилися. Модератор прочитає це, перш ніж щось вирішувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے الفاظ میں بتائیں کہ آپ اپنی ضمانت پر قائم ہیں یا غلط تھے۔ کوئی بھی فیصلہ کرنے سے پہلے ایک ماڈریٹر اسے پڑھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói bằng lời của bạn rằng bạn giữ lời bảo chứng hay bạn đã sai. Một người kiểm duyệt đọc nó trước khi quyết định bất cứ điều gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用你自己的话说明，你是坚持自己的担保，还是弄错了。版主会先阅读，再作任何决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用你自己的話說明你是否仍支持你的擔保，還是擔保有誤。版主會先閱讀，再作出任何決定。"
          }
        }
      }
    },
