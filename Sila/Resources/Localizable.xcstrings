    "rooms.create.titleMissing": {
      "comment": "Validation when the room has no title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ الغرفة عنوانًا ليعرف الناس إلى ماذا ينضمون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমের একটি শিরোনাম দিন যাতে মানুষ জানে কীতে যোগ দিচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa un títol a la sala perquè la gent sàpiga a què s'uneix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dej místnosti název, aby lidé věděli, k čemu se připojují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv rummet en titel, så folk ved, hvad de deltager i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dem Raum einen Titel, damit die Leute wissen, wo sie beitreten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε έναν τίτλο στην αίθουσα ώστε οι άλλοι να ξέρουν σε τι μπαίνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the room a title so people know what they're joining."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un título a la sala para que la gente sepa a qué se une."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna huoneelle otsikko, jotta ihmiset tietävät mihin liittyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un titre au salon pour que les gens sachent ce qu’ils rejoignent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תן לחדר כותרת כדי שאנשים ידעו להצטרף למה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम को एक शीर्षक दें ताकि लोग जानें कि वे किसमें जुड़ रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj sobi naslov da ljudi znaju čemu se pridružuju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj címet a szobának, hogy az emberek tudják, mihez csatlakoznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri room judul agar orang tahu apa yang mereka ikuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un titolo alla stanza così le persone sanno a cosa si uniscono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加する人が内容をわかるよう、ルームにタイトルを付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 무엇에 참여하는지 알 수 있도록 룸 제목을 입력하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആളുകൾക്ക് എന്തിലാണ് ചേരുന്നതെന്ന് അറിയാൻ റൂമിന് ഒരു തലക്കെട്ട് നൽകുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri bilik tajuk supaya orang tahu apa yang mereka sertai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi rommet en tittel slik at folk vet hva de blir med i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de room een titel zodat mensen weten waaraan ze meedoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj pokojowi tytuł, aby ludzie wiedzieli, do czego dołączają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um título à sala para que as pessoas saibam em que estão entrando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um título à sala para que as pessoas saibam em que vão entrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dă camerei un titlu, ca oamenii să știe la ce se alătură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите комнату, чтобы люди знали, куда они заходят."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj miestnosti názov, aby ľudia vedeli, kam sa pripájajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge rummet en titel så att folk vet vad de går med i."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்கள் எதில் சேர்கிறார்கள் என்று அறிய அறைக்கு ஒரு தலைப்பு கொடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రజలు దేనిలో చేరుతున్నారో తెలిసేలా రూమ్‌కు శీర్షిక ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อห้องเพื่อให้คนรู้ว่ากำลังเข้าร่วมอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar neye katıldıklarını bilsin diye odaya bir başlık verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте кімнаті назву, щоб люди знали, до чого приєднуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم کو عنوان دیں تاکہ لوگوں کو پتا ہو کہ وہ کس میں شامل ہو رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đặt tiêu đề cho phòng để mọi người biết mình tham gia gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请给房间起个标题，让大家知道要加入的是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為聊天室取個標題，讓大家知道要加入什麼。"
          }
        }
      }
    },
    "rooms.create.titlePlaceholder": {
      "comment": "Placeholder in the room title field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
