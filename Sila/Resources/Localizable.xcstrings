        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라와 고개 돌리기를 시작해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്യാമറയും തല തിരിക്കലും തുടങ്ങുന്നു"
