    "error.accountDeactivated": {
      "comment": "Last-resort copy if a pending-deletion account reaches a normal screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب مجدول للحذف. ألغِ الحذف لاستخدامه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্ট মুছে ফেলার জন্য নির্ধারিত। আবার ব্যবহার করতে মুছে ফেলা বাতিল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte està programat per eliminar. Cancel·la l'eliminació per tornar-lo a fer servir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet je naplánován ke smazání. Zruš smazání, abys ho mohl znovu používat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto er planlagt til sletning. Annuller sletningen for at bruge den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist zur Löschung vorgemerkt. Brich die Löschung ab, um es wieder zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός είναι προγραμματισμένος για διαγραφή. Ακύρωσε τη διαγραφή για να τον χρησιμοποιήσεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion. Cancel the deletion to use it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta tiene la eliminación programada. Cancela la eliminación para volver a usarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tili on ajastettu poistettavaksi. Peru poisto käyttääksesi sitä taas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de ce compte est programmée. Annulez-la pour l’utiliser à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון הזה מתוזמן למחיקה. בטל את המחיקה כדי להשתמש בו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अकाउंट हटाने के लिए शेड्यूल है। इसे फिर इस्तेमाल करने के लिए डिलीट रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj račun zakazan je za brisanje. Otkaži brisanje da bi ga ponovno koristio/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fiók törlésre van ütemezve. A használatához vond vissza a törlést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini dijadwalkan untuk dihapus. Batalkan penghapusan untuk memakainya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account è in programma per l'eliminazione. Annulla l'eliminazione per usarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは削除予定です。再び使うには削除を取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 삭제 예약 상태예요. 다시 사용하려면 삭제를 취소하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ട് ഇല്ലാതാക്കാൻ ഷെഡ്യൂൾ ചെയ്തിരിക്കുന്നു. വീണ്ടും ഉപയോഗിക്കാൻ ഇല്ലാതാക്കൽ റദ്ദാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini dijadualkan untuk dipadam. Batalkan pemadaman untuk menggunakannya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen er planlagt slettet. Avbryt slettingen for å bruke den igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account is gepland voor verwijdering. Annuleer de verwijdering om het weer te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto jest zaplanowane do usunięcia. Anuluj usunięcie, aby znów z niego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta está agendada para exclusão. Cancele a exclusão para usá-la novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta está agendada para eliminação. Cancele a eliminação para voltar a usá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont este programat pentru ștergere. Anulează ștergerea ca să îl folosești din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта запланировано удаление. Отмените удаление, чтобы снова им пользоваться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet je naplánovaný na odstránenie. Zruš odstránenie, aby si ho mohol znova používať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot är schemalagt för radering. Avbryt raderingen för att använda det igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கு நீக்கத்துக்குத் திட்டமிடப்பட்டுள்ளது. மீண்டும் பயன்படுத்த நீக்கத்தை ரத்து செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతా తొలగింపునకు షెడ్యూల్ చేయబడింది. మళ్లీ వాడాలంటే తొలగింపును రద్దు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ถูกกำหนดให้ลบ ยกเลิกการลบเพื่อใช้งานอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap silinmek üzere planlandı. Yeniden kullanmak için silmeyi iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис заплановано до видалення. Скасуйте видалення, щоб користуватися ним знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اکاؤنٹ حذف کرنے کے لیے طے شدہ ہے۔ دوبارہ استعمال کرنے کے لیے حذف کرنا منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này đã được hẹn xóa. Hãy hủy việc xóa để dùng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已安排删除。取消删除后才能再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號已排定刪除。取消刪除後才能再次使用。"
          }
        }
      }
    },
