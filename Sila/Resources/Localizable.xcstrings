        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilit on kytketty pois"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils sont désactivés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופילים כבויים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल बंद हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili su isključeni"
          }
        },
        "hu": {
          "stringUnit": {
