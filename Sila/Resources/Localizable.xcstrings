      }
    },
    "rooms.create.startsLabel": {
      "comment": "Label above the scheduled start time picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts"
          }
        }
      }
    },
    "rooms.create.title": {
      "comment": "Title of the create-room sheet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ غرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a room"
          }
        }
      }
    },
    "rooms.create.titleField.a11yHint": {
      "comment": "VoiceOver hint for the room title field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمّي الغرفة. الناس يقررون الانضمام بناءً عليه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names the room. People decide whether to join from this."
          }
        }
      }
    },
    "rooms.create.titleFieldLabel": {
      "comment": "Label above the room title field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        }
      }
    },
    "rooms.create.titleMissing": {
      "comment": "Validation when the room has no title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ الغرفة عنوانًا ليعرف الناس إلى ماذا ينضمون."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the room a title so people know what they're joining."
          }
        }
      }
    },
    "rooms.create.titlePlaceholder": {
      "comment": "Placeholder in the room title field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن ماذا هذه الغرفة؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is this room about?"
          }
        }
      }
    },
    "rooms.create.titleTooLong": {
      "comment": "Validation when the title is over the limit. %lld is how many characters over.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان يزيد %lld أحرف عن الحد المسموح."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان يزيد %lld حرفًا عن الحد المسموح."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان يزيد حرفًا واحدًا عن الحد المسموح."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان يزيد %lld حرف عن الحد المسموح."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان يزيد حرفين عن الحد المسموح."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "العنوان ضمن الحد المسموح."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "That title is %lld character over the limit."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "That title is %lld characters over the limit."
                }
              }
            }
          }
        }
      }
    },
    "rooms.create.topicHeader": {
      "comment": "Section header above the topic picker. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموضوع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TOPIC"
          }
        }
      }
    },
    "rooms.create.topicsFailed": {
      "comment": "Shown when the topic list could not be loaded. A topic is optional.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحمَّل قائمة مواضيع سِلة. يمكنك فتح الغرفة بدون موضوع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila's topic list didn't load. You can open the room without one."
          }
        }
      }
    },
    "rooms.create.whoCanSpeak": {
      "comment": "Section header above the audience picker. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يمكنه التحدث"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO CAN SPEAK"
          }
        }
      }
    },
    "rooms.empty.live.subtitle": {
      "comment": "Explains what a room is. Says listening is open to anyone and only speaking depends on the audience.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرفة محادثة مباشرة بين أشخاص موثّقين. يمكن لأي شخص الاستماع إلى أي غرفة، أما من يتحدث فيحدده جمهور الغرفة. ابدأ غرفة وشوف من يحضر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room is a live conversation between verified people. Anyone can listen to any room; who may speak depends on the room's audience. Start one and see who turns up."
          }
        }
      }
    },
    "rooms.empty.live.title": {
      "comment": "Empty state when no room is open.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد غرف مباشرة الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rooms live right now"
          }
        }
      }
    },
    "rooms.empty.scheduled.title": {
      "comment": "Empty state when nothing is scheduled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد غرف مجدولة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing scheduled"
          }
        }
      }
    },
    "rooms.empty.search.subtitle": {
      "comment": "No matching rooms. %@ is the query, inside quote marks. Says what is searched.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد غرفة مباشرة أو مجدولة تطابق «%@». البحث يشمل العناوين والمواضيع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing live or scheduled matches “%@”. Titles and topics are what get searched."
          }
        }
      }
    },
    "rooms.empty.search.title": {
      "comment": "Empty state when a room search matched nothing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد غرف مطابقة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rooms matched"
          }
        }
      }
    },
    "rooms.end.warning": {
      "comment": "The confirmation in front of ending a room.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُقطع الاتصال عن الجميع فورًا ولا يمكن إعادة فتح الغرفة. ولم يُسجَّل شيء، فلا يوجد ما يمكن الاحتفاظ به."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everybody is disconnected straight away and the room can't be reopened. Nothing was recorded, so there is nothing to keep."
          }
        }
      }
    },
    "rooms.ended.body": {
      "comment": "A room that is over. Repeats that nothing was recorded, so there is nothing to catch up on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت هذه الغرفة. لم يُسجَّل شيء، فلا يوجد ما يمكن الرجوع إليه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This room has ended. Nothing was recorded, so there's nothing to catch up on."
          }
        }
      }
    },
    "rooms.error.retry": {
      "comment": "Retry action on the rooms error state.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "rooms.error.title": {
      "comment": "Empty state when the rooms list failed to load.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الغرف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load rooms"
          }
        }
      }
    },
    "rooms.host.cannotDemoteHost": {
      "comment": "Refusal when a host tries to move themselves off their own stage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت المضيف. لإنهاء دورك أنهِ الغرفة — لا توجد طريقة لتنزل عن منصتك بنفسك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the host. Hand the room over by ending it — there is no way to step off your own stage."
          }
        }
      }
    },
    "rooms.host.demotedToast": {
      "comment": "Toast after moving a speaker back. Says explicitly that they were not removed. %@ is their name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد %@ إلى الاستماع. ولم يُخرج من الغرفة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is listening again. They were not removed."
          }
        }
      }
    },
    "rooms.host.inviteToMic": {
      "comment": "Host menu: move a listener onto the stage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوة للتحدث"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite to speak"
          }
        }
      }
    },
    "rooms.host.invitedToast": {
      "comment": "Toast after inviting somebody to speak. %@ is their name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ%@ التحدث الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can speak now."
          }
        }
      }
    },
    "rooms.host.stageFull": {
      "comment": "Refusal when the stage has as many speakers as it will hold.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنصة ممتلئة. انقل أحدهم إلى المستمعين أولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stage is full. Move somebody to listeners first."
          }
        }
      }
    },
    "rooms.host.takeMicBack": {
      "comment": "Host menu: move a speaker back to the audience. Not a removal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل إلى المستمعين"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to listeners"
          }
        }
      }
    },
    "rooms.join.unverifiedCannotOpen": {
      "comment": "Refusal when an unverified account tries to host. Listening is open to everyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الغرف متاح للموثّقين فقط. والاستماع متاح للجميع — أكمل توثيق هويتك لتستضيف غرفة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only verified humans can open a room. Everyone can listen to one — finish identity verification to host."
          }
        }
      }
    },
    "rooms.leave.hint": {
      "comment": "VoiceOver hint for the leave button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغادر الغرفة ويقطع صوتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves the room and disconnects your audio."
          }
        }
      }
    },
    "rooms.listening.subtitle": {
      "comment": "What listening means, said without apology. Names the fact that no microphone is involved, which is why Sila never asks a listener for one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمع كل شيء. الميكروفون غير مستخدم، وسِلة لم تطلبه أصلًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hear everything. Your microphone is not in use and Sila hasn't asked for it."
          }
        }
      }
    },
    "rooms.listening.title": {
      "comment": "Heading of the listener state.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تستمع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're listening"
          }
        }
      }
    },
    "rooms.live.audience.empty": {
      "comment": "Shown when nobody is listening.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يستمع بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is listening yet."
          }
        }
      }
    },
    "rooms.live.audience.header": {
      "comment": "Header above the listeners.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستمعون"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening"
          }
        }
      }
    },
    "rooms.live.end": {
      "comment": "The host's end-room button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        }
      }
    },
    "rooms.live.end.a11yHint": {
      "comment": "VoiceOver hint for the end-room button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي الغرفة للجميع. ولا يمكن إعادة فتحها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the room for everybody. It cannot be reopened."
          }
        }
      }
    },
    "rooms.live.end.cancelButton": {
      "comment": "Cancel button on the end-room confirmation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقها مفتوحة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it open"
          }
        }
      }
    },
    "rooms.live.end.confirmButton": {
      "comment": "Destructive button on the end-room confirmation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ الغرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End room"
          }
        }
      }
    },
    "rooms.live.end.confirmTitle": {
      "comment": "Title of the end-room confirmation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء هذه الغرفة؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this room?"
          }
        }
      }
    },
    "rooms.live.hostMenu.a11yHint": {
      "comment": "VoiceOver hint for the host menu.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوة للتحدث، أو نقل إلى المستمعين، أو إخراج من هذه الغرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite to speak, move to listeners, or remove from this room"
          }
        }
      }
    },
    "rooms.live.hostMenu.a11yLabel": {
      "comment": "VoiceOver label for the host menu. %@ is the participant's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدوات المضيف لـ%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host controls for %@"
          }
        }
      }
    },
    "rooms.live.hostMenu.header": {
      "comment": "Header on the host menu. States the scope of a removal so it is not mistaken for a block.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخراج شخص يخص هذه الغرفة وحدها. وليس حظرًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing someone applies to this room only. It isn't a block."
          }
        }
      }
    },
    "rooms.live.hostMenu.remove": {
      "comment": "Host menu: remove somebody from this room.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخراج من هذه الغرفة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this room"
          }
        }
      }
    },
    "rooms.live.leave": {
      "comment": "Button that leaves a room without ending it.",
