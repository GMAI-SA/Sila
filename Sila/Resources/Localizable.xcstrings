    "feed.subject.tooMany": {
      "comment": "Shown when somebody taps an eleventh subject. %lld is the limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تثبيت %lld مواضيع في وقت واحد. أزل واحدًا لإضافة آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একসাথে %lld টি বিষয় পিন করতে পারেন। আরেকটি যোগ করতে একটি সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots fixar %lld temes alhora. Elimina'n un per afegir-ne un altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžeš mít připnuto najednou nejvýše %lld témat. Odeber jedno, abys přidal další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fastgøre %lld emner ad gangen. Fjern ét for at tilføje et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst %lld Themen gleichzeitig anheften. Entferne eines, um ein anderes hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να καρφιτσώσεις %lld θέματα ταυτόχρονα. Αφαίρεσε ένα για να προσθέσεις άλλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pin %lld subjects at once. Remove one to add another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes fijar %lld temas a la vez. Quita uno para añadir otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kiinnittää %lld aihetta kerrallaan. Poista yksi lisätäksesi toisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez épingler %lld sujets à la fois. Retirez-en un pour en ajouter un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להצמיד %lld נושאים בו-זמנית. הסר אחד כדי להוסיף אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक बार में %lld विषय पिन कर सकते हैं। दूसरा जोड़ने के लिए एक हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš prikvačiti %lld tema odjednom. Ukloni jednu da dodaš drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre %lld témát rögzíthetsz. Távolíts el egyet egy újabb hozzáadásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menyematkan %lld topik sekaligus. Hapus satu untuk menambah yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi fissare %lld argomenti alla volta. Rimuovine uno per aggiungerne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定できる分野は一度に%lld個までです。別の分野を追加するには、1つ外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제는 한 번에 %lld개까지 고정할 수 있어요. 하나를 해제하고 다른 것을 추가하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരേസമയം %lld വിഷയങ്ങൾ പിൻ ചെയ്യാം. മറ്റൊന്ന് ചേർക്കാൻ ഒന്ന് നീക്കം ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyemat %lld subjek pada satu masa. Alih keluar satu untuk menambah yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan feste %lld temaer om gangen. Fjern ett for å legge til et annet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt %lld onderwerpen tegelijk vastzetten. Verwijder er een om een ander toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przypiąć naraz %lld tematów. Usuń jeden, aby dodać kolejny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode fixar %lld assuntos ao mesmo tempo. Remova um para adicionar outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode fixar %lld assuntos de cada vez. Remova um para adicionar outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți fixa %lld subiecte simultan. Elimină unul ca să adaugi altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно можно закрепить тем: %lld. Уберите одну, чтобы добавить другую."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naraz môžeš pripnúť %lld tém. Odstráň jednu, aby si mohol pridať ďalšiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fästa %lld ämnen samtidigt. Ta bort ett för att lägga till ett annat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நேரத்தில் %lld தலைப்புகளை முள்ளிடலாம். மற்றொன்றைச் சேர்க்க ஒன்றை அகற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఒకేసారి %lld అంశాలను పిన్ చేయవచ్చు. మరొకటి జోడించడానికి ఒకదాన్ని తొలగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณปักหมุดได้ครั้งละ %lld เรื่อง ลบหนึ่งเรื่องเพื่อเพิ่มเรื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda %lld konu sabitleyebilirsiniz. Başka birini eklemek için birini kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна закріпити одночасно %lld тем. Видаліть одну, щоб додати іншу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ایک وقت میں %lld موضوعات پن کر سکتے ہیں۔ دوسرا شامل کرنے کے لیے ایک ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể ghim %lld chủ đề cùng lúc. Hãy xóa một chủ đề để thêm chủ đề khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可同时固定 %lld 个主题。请移除一个后再添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最多能同時釘選 %lld 個主題。請移除一個再新增。"
          }
        }
      }
    },
    "feed.tab.explore.hint": {
      "comment": "VoiceOver hint for the Explore tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في المنشورات والأشخاص، وتابع الأكثر تداولًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্ট ও মানুষ খুঁজুন এবং কী ট্রেন্ড করছে দেখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca publicacions i persones, i mira què és tendència"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledej příspěvky a lidi a zjisti, co je trendy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg efter opslag og personer, og se hvad der er populært"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge und Personen suchen und sehen, was im Trend liegt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση αναρτήσεων και ατόμων, και δες τι είναι σε τάση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search posts and people, and see what is trending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca publicaciones y personas, y mira qué es tendencia"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae julkaisuja ja ihmisiä ja katso, mikä on nousussa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez des posts et des personnes, et voyez ce qui est tendance"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש פוסטים ואנשים, וראה מה פופולרי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट और लोग खोजें, और देखें कि क्या ट्रेंड कर रहा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretraži objave i ljude te vidi što je u trendu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejegyzések és emberek keresése, és a felkapott témák"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari postingan dan orang, dan lihat apa yang sedang tren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca post e persone, e guarda cosa è di tendenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿とユーザーを検索し、トレンドを見ます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물과 사람을 검색하고 인기 글을 확인해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റുകളും ആളുകളെയും തിരയുക, എന്താണ് ട്രെൻഡിങ് എന്ന് കാണുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari siaran dan orang, dan lihat apa yang sedang tren"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk etter innlegg og folk, og se hva som trender"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek berichten en mensen, en zie wat trending is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuj wpisy i osoby oraz zobacz, co jest popularne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque posts e pessoas e veja o que está em alta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise publicações e pessoas, e veja o que está em alta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută postări și oameni și vezi ce este în tendințe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск постов и людей, а также то, что в тренде"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadaj príspevky a ľudí a pozri, čo je v trende"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök inlägg och personer, och se vad som trendar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகைகளையும் மக்களையும் தேடி, டிரெண்டிங்கைப் பாருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్‌లను, వ్యక్తులను వెతకండి, ఏది ట్రెండింగ్‌లో ఉందో చూడండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาโพสต์และผู้คน และดูสิ่งที่กำลังมาแรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilerde ve kişilerde arayın, gündemi görün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук дописів і людей, а також що в тренді"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسٹس اور لوگوں کو تلاش کریں، اور دیکھیں کہ کیا ٹرینڈنگ ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
