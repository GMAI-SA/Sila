    "preferences.country.error.notACountry": {
      "comment": "Validation when the code is not a country.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رمز دولة. استخدم حرفين، مثل SA أو JP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি দেশের কোড নয়। দুটি অক্ষর ব্যবহার করুন, যেমন SA বা JP।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això no és un codi de país. Fes servir dues lletres, com SA o JP."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To není kód země. Použij dvě písmena, například SA nebo JP."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en landekode. Brug to bogstaver, f.eks. SA eller JP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Ländercode. Verwende zwei Buchstaben, z. B. SA oder JP."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν είναι κωδικός χώρας. Χρησιμοποίησε δύο γράμματα, όπως SA ή JP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a country code. Use two letters, like SA or JP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un código de país. Usa dos letras, como SA o JP."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole maatunnus. Käytä kahta kirjainta, kuten SA tai JP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code pays. Utilisez deux lettres, comme SA ou JP."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא קוד מדינה. השתמש בשתי אותיות, כמו SA או JP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह देश कोड नहीं है। दो अक्षर इस्तेमाल करें, जैसे SA या JP।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To nije kod zemlje. Koristi dva slova, na primjer SA ili JP."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem országkód. Két betűt használj, például SA vagy JP."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu bukan kode negara. Pakai dua huruf, seperti SA atau JP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è un codice paese. Usa due lettere, come SA o JP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国コードではありません。SAやJPのような2文字で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 코드가 아니에요. SA, JP처럼 두 글자를 사용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അത് ഒരു രാജ്യ കോഡ് അല്ല. SA അല്ലെങ്കിൽ JP പോലെ രണ്ട് അക്ഷരം ഉപയോഗിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu bukan kod negara. Gunakan dua huruf, seperti SA atau JP."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en landskode. Bruk to bokstaver, som SA eller JP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is geen landcode. Gebruik twee letters, zoals SA of JP."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest kod kraju. Użyj dwóch liter, np. SA lub JP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um código de país. Use duas letras, como SA ou JP."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um código de país. Use duas letras, como PT ou JP."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta nu este un cod de țară. Folosește două litere, ca SA sau JP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не код страны. Используйте две буквы, например SA или JP."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nie je kód krajiny. Použi dve písmená, napríklad SA alebo JP."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ingen landskod. Använd två bokstäver, som SA eller JP."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது நாட்டுக் குறியீடு அல்ல. SA அல்லது JP போல இரண்டு எழுத்துகளைப் பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది దేశ కోడ్ కాదు. SA లేదా JP లాగా రెండు అక్షరాలు వాడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่นไม่ใช่รหัสประเทศ ใช้สองตัวอักษร เช่น SA หรือ JP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir ülke kodu değil. SA veya JP gibi iki harf kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не код країни. Використайте дві літери, як-от SA або JP."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ملک کا کوڈ نہیں۔ دو حروف استعمال کریں، جیسے SA یا JP۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không phải mã quốc gia. Dùng hai chữ cái, như SA hoặc JP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是国家代码。请使用两个字母，例如 SA 或 JP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是國家代碼。請使用兩個字母，例如 SA 或 JP。"
          }
        }
      }
