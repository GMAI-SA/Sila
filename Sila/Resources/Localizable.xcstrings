    "preferences.untagged.detail": {
      "comment": "Why unlabelled posts exist at all.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدث التصنيف بعد نشر المنشور، لذلك قد لا يكون للمنشور الجديد موضوع بعد. وهذا الخيار يقرر ما إذا كانت تلك المنشورات ستصلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেবেল দেওয়া হয় পোস্ট প্রকাশের পরে, তাই নতুন পোস্টে এখনও কোনো বিষয় নাও থাকতে পারে। এটি ঠিক করে সেই পোস্টগুলো তবু আপনার কাছে পৌঁছাবে কি না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etiquetatge es fa després de publicar una publicació, així que una publicació nova pot no tenir tema encara. Això decideix si aquestes publicacions et continuen arribant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označování probíhá po zveřejnění příspěvku, takže nový příspěvek zatím nemusí mít téma. Toto rozhoduje, zda se k tobě i tak dostane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærkningen sker, efter et opslag er udgivet, så et nyt opslag har måske endnu intet emne. Dette afgør, om de opslag stadig når dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Labeln geschieht nach der Veröffentlichung eines Beitrags, daher hat ein neuer Beitrag vielleicht noch kein Thema. Das entscheidet, ob solche Beiträge dich trotzdem erreichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επισήμανση γίνεται αφού δημοσιευτεί μια ανάρτηση, οπότε μια νέα ανάρτηση μπορεί να μην έχει ακόμα θέμα. Αυτό αποφασίζει αν αυτές οι αναρτήσεις θα σε φτάνουν παρ' όλα αυτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labelling happens after a post is published, so a new post may have no topic yet. This decides whether those posts still reach you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El etiquetado ocurre después de publicar, así que una publicación nueva puede no tener tema todavía. Esto decide si esas publicaciones te siguen llegando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luokittelu tapahtuu julkaisun julkaisemisen jälkeen, joten uudella julkaisulla ei välttämättä ole vielä aihetta. Tämä päättää, tavoittavatko ne silti sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étiquetage a lieu après la publication d’un post, un nouveau post peut donc n’avoir encore aucun sujet. Ce réglage décide si ces posts vous parviennent quand même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיוג מתבצע אחרי שפוסט מתפרסם, ולכן לפוסט חדש עשוי עוד לא להיות נושא. זה קובע אם פוסטים כאלה עדיין יגיעו אליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेबल पोस्ट प्रकाशित होने के बाद लगता है, इसलिए नई पोस्ट पर अभी कोई टॉपिक न हो सकता है। यह तय करता है कि वे पोस्ट फिर भी आप तक पहुँचें या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označavanje se događa nakon objave, pa nova objava možda još nema temu. Ovo određuje hoće li takve objave ipak stići do tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címkézés a bejegyzés közzététele után történik, ezért egy új bejegyzésnek még nem biztos, hogy van témája. Ez dönti el, hogy az ilyen bejegyzések eljutnak-e hozzád."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelabelan terjadi setelah postingan diterbitkan, jadi postingan baru mungkin belum punya topik. Ini menentukan apakah postingan itu tetap sampai kepadamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etichettatura avviene dopo la pubblicazione di un post, quindi un post nuovo può non avere ancora un argomento. Questo decide se quei post ti raggiungono comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベル付けは投稿の公開後に行われるため、新しい投稿にはまだトピックがないことがあります。そのような投稿を引き続き表示するかどうかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨은 게시물이 올라온 후에 붙기 때문에 새 게시물에는 아직 주제가 없을 수 있어요. 그런 게시물을 계속 받을지 여기서 정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റ് പ്രസിദ്ധീകരിച്ച ശേഷമാണ് ലേബൽ ചെയ്യുന്നത്, അതിനാൽ പുതിയ പോസ്റ്റിന് ഇതുവരെ വിഷയം ഉണ്ടാകണമെന്നില്ല. ആ പോസ്റ്റുകൾ നിങ്ങളിലെത്തണോ എന്ന് ഇത് തീരുമാനിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelabelan berlaku selepas siaran diterbitkan, jadi siaran baharu mungkin belum mempunyai topik. Ini menentukan sama ada siaran itu masih sampai kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merking skjer etter at et innlegg er publisert, så et nytt innlegg kan mangle emne ennå. Dette avgjør om slike innlegg fortsatt når deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labelen gebeurt nadat een bericht is geplaatst, dus een nieuw bericht heeft mogelijk nog geen onderwerp. Dit bepaalt of die berichten je toch bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczanie następuje po opublikowaniu wpisu, więc nowy wpis może jeszcze nie mieć tematu. To decyduje, czy takie wpisy nadal do Ciebie docierają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rotulagem acontece depois que um post é publicado, então um post novo pode ainda não ter tópico. Isto decide se esses posts ainda chegam até você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiquetagem acontece depois de a publicação ser publicada, por isso uma publicação nova pode ainda não ter tópico. Isto decide se essas publicações continuam a chegar até si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Etichetarea are loc după publicarea unei postări, deci o postare nouă poate să nu aibă încă subiect. Aceasta decide dacă acele postări ajung totuși la tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки ставятся после публикации поста, поэтому у нового поста темы может ещё не быть. Этот параметр решает, будут ли такие посты доходить до вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označovanie prebieha po zverejnení príspevku, takže nový príspevok nemusí mať zatiaľ tému. Toto rozhoduje, či sa k tebe takéto príspevky stále dostanú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketteringen sker efter att ett inlägg har publicerats, så ett nytt inlägg kan sakna ämne än. Det här avgör om sådana inlägg ändå når dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகை வெளியான பிறகே லேபிளிடல் நடக்கும், எனவே புதிய இடுகைக்கு இன்னும் தலைப்பு இல்லாமல் இருக்கலாம். அவை உங்களை வந்தடையுமா என்பதை இது தீர்மானிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్ ప్రచురించబడిన తర్వాత లేబుల్ వేయడం జరుగుతుంది, కాబట్టి కొత్త పోస్ట్‌కు ఇంకా అంశం ఉండకపోవచ్చు. ఆ పోస్ట్‌లు ఇంకా మీకు చేరాలా వద్దా అనేది ఇది నిర్ణయిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดป้ายเกิดขึ้นหลังเผยแพร่โพสต์ โพสต์ใหม่จึงอาจยังไม่มีหัวข้อ ตัวเลือกนี้กำหนดว่าโพสต์เหล่านั้นจะยังมาถึงคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketleme gönderi yayınlandıktan sonra yapılır, bu yüzden yeni bir gönderinin henüz konusu olmayabilir. Bu, o gönderilerin yine de size ulaşıp ulaşmayacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначення відбувається після публікації допису, тож новий допис може ще не мати теми. Це визначає, чи такі дописи все ж доходять до вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لیبل پوسٹ شائع ہونے کے بعد لگتا ہے، اس لیے نئی پوسٹ پر ابھی کوئی موضوع نہ ہو سکتا ہے۔ یہ طے کرتا ہے کہ ایسی پوسٹس پھر بھی آپ تک پہنچیں یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gắn nhãn diễn ra sau khi bài đăng được đăng, nên bài mới có thể chưa có chủ đề. Mục này quyết định những bài đó có còn đến với bạn hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是在帖子发布之后才打上的，所以新帖子可能暂时没有话题。这个设置决定这些帖子是否仍会送达你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示是在貼文發布後才進行，所以新貼文可能還沒有主題。這決定那些貼文是否仍會送達你。"
          }
        }
      }
    },
    "preferences.untagged.detail.noEffect": {
      "comment": "Appended when nothing is currently narrowing the feed, so the switch changes nothing today.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولا يغيّر شيئًا الآن، لأنه لا يوجد ما يضيّق صفحتك الدولية على المواضيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন এটি কিছুই বদলায় না, কারণ কিছুই আপনার আন্তর্জাতিক ফিডকে বিষয়ে সীমিত করছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix no canvia res, perquè no hi ha res que limiti el teu canal Internacional a temes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď to nic nemění, protože nic nezužuje tvůj Mezinárodní kanál na témata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ændrer intet lige nu, fordi intet indsnævrer dit internationale feed til emner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment ändert das nichts, weil nichts deinen internationalen Feed auf Themen beschränkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αλλάζει τίποτα αυτή τη στιγμή, γιατί τίποτα δεν περιορίζει τη Διεθνή ροή σου σε θέματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changes nothing right now, because nothing is narrowing your International feed to topics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no cambia nada, porque nada restringe tu feed Internacional a temas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei muuta nyt mitään, koska mikään ei rajaa Kansainvälinen-syötettäsi aiheisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne change rien pour l’instant, car rien ne restreint votre fil International à des sujets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא משנה דבר כרגע, כי שום דבר לא מצמצם את הפיד הבינלאומי שלך לנושאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी इससे कुछ नहीं बदलता, क्योंकि कुछ भी आपकी अंतरराष्ट्रीय फ़ीड को टॉपिक तक सीमित नहीं कर रहा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno ništa ne mijenja jer ništa ne sužava tvoj međunarodni feed na teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most semmit nem változtat, mert a Nemzetközi hírfolyamodat semmi nem szűkíti témákra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak mengubah apa pun saat ini, karena tidak ada yang mempersempit feed Internasionalmu ke topik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora non cambia nulla, perché niente restringe il tuo feed Internazionale agli argomenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国際フィードがトピックで絞り込まれていないため、今は何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 국제 피드를 주제로 좁히는 것이 없어서 아무것도 바뀌지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ ഇത് ഒന്നും മാറ്റുന്നില്ല, കാരണം ഒന്നും നിങ്ങളുടെ അന്താരാഷ്ട്ര ഫീഡിനെ വിഷയങ്ങളിലേക്ക് ചുരുക്കുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak mengubah apa-apa sekarang, kerana tiada apa mempersempitkan suapan Antarabangsa anda kepada topik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det endrer ingenting akkurat nå, fordi ingenting snevrer inn den internasjonale feeden din til emner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verandert nu niets, omdat niets je internationale feed tot onderwerpen beperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie nic to nie zmienia, ponieważ nic nie zawęża Twojego kanału międzynarodowego do tematów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não muda nada agora, porque nada está restringindo seu feed Internacional a tópicos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não muda nada neste momento, porque nada está a restringir o seu feed Internacional a tópicos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu schimbă nimic acum, pentru că nimic nu restrânge fluxul tău Internațional la subiecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас это ничего не меняет, потому что ничто не сужает вашу международную ленту до тем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nič nemení, pretože nič nezužuje tvoj medzinárodný kanál na témy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ändrar ingenting just nu, eftersom inget begränsar ditt internationella flöde till ämnen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது இது எதையும் மாற்றாது, ஏனெனில் உங்கள் சர்வதேச ஊட்டத்தைத் தலைப்புகளுக்குக் குறுக்கும் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అంతర్జాతీయ ఫీడ్‌ను ఏదీ అంశాలకు కుదించడం లేదు కాబట్టి ఇప్పుడు ఇది ఏదీ మార్చదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่เปลี่ยนอะไร เพราะไม่มีอะไรจำกัดฟีดนานาชาติของคุณให้เหลือเฉพาะหัวข้อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda hiçbir şeyi değiştirmez, çünkü Uluslararası akışınızı konulara daraltan bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз це нічого не змінює, бо ніщо не звужує вашу стрічку «Світ» до тем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے ابھی کچھ نہیں بدلتا، کیونکہ کچھ بھی آپ کی بین الاقوامی فیڈ کو موضوعات تک محدود نہیں کر رہا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại nó không thay đổi gì, vì không có gì đang thu hẹp bảng tin Quốc tế của bạn theo chủ đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前它不会改变任何内容，因为没有任何设置在把你的国际信息流缩小到特定话题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前這不會造成任何改變，因為沒有任何設定將你的「國際」動態縮小到特定主題。"
          }
        }
      }
    },
    "preferences.untagged.hint": {
      "comment": "VoiceOver hint for the unlabelled-posts switch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي المنشورات غير المصنّفة ضمن صفحتك الدولية المصفّاة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়ের লেবেল ছাড়া পোস্ট আপনার ফিল্টার করা আন্তর্জাতিক ফিডে রাখে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva les publicacions sense etiqueta de tema al teu canal Internacional filtrat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechá příspěvky bez štítku tématu ve tvém filtrovaném Mezinárodním kanálu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder opslag uden emnemærke i dit filtrerede internationale feed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält Beiträge ohne Themenlabel in deinem gefilterten internationalen Feed"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατά αναρτήσεις χωρίς ετικέτα θέματος στη φιλτραρισμένη Διεθνή ροή σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps posts with no topic label in your filtered International feed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las publicaciones sin etiqueta de tema en tu feed Internacional filtrado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää aihetunnisteettomat julkaisut suodatetussa Kansainvälinen-syötteessäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les posts sans étiquette de sujet dans votre fil International filtré"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משאיר פוסטים בלי תווית נושא בפיד הבינלאומי המסונן שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना टॉपिक लेबल वाली पोस्ट को आपकी फ़िल्टर की गई अंतरराष्ट्रीय फ़ीड में रखता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava objave bez oznake teme u tvom filtriranom međunarodnom feedu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A téma nélküli bejegyzéseket megtartja a szűrt Nemzetközi hírfolyamodban"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan postingan tanpa label topik di feed Internasionalmu yang tersaring"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene i post senza etichetta di argomento nel tuo feed Internazionale filtrato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックのラベルがない投稿を、絞り込んだ国際フィードに残します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제 라벨이 없는 게시물을 필터링된 국제 피드에 유지해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഷയ ലേബൽ ഇല്ലാത്ത പോസ്റ്റുകൾ ഫിൽട്ടർ ചെയ്ത അന്താരാഷ്ട്ര ഫീഡിൽ നിലനിർത്തുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan siaran tanpa label topik dalam suapan Antarabangsa anda yang ditapis"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder innlegg uten emnemerke i den filtrerte internasjonale feeden din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt berichten zonder onderwerplabel in je gefilterde internationale feed"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje wpisy bez etykiety tematu w filtrowanym kanale międzynarodowym"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém posts sem rótulo de tópico no seu feed Internacional filtrado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém as publicações sem etiqueta de tópico no seu feed Internacional filtrado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează postările fără etichetă de subiect în fluxul tău Internațional filtrat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет посты без метки темы в вашей отфильтрованной международной ленте"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechá príspevky bez označenia témy vo filtrovanom medzinárodnom kanáli"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller inlägg utan ämnesetikett i ditt filtrerade internationella flöde"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்பு லேபிள் இல்லாத இடுகைகளை உங்கள் வடிகட்டிய சர்வதேச ஊட்டத்தில் வைத்திருக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశం లేబుల్ లేని పోస్ట్‌లను మీ ఫిల్టర్ చేసిన అంతర్జాతీయ ఫీడ్‌లో ఉంచుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บโพสต์ที่ไม่มีป้ายหัวข้อไว้ในฟีดนานาชาติที่กรองแล้วของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu etiketi olmayan gönderileri filtrelenmiş Uluslararası akışınızda tutar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає дописи без позначки теми у вашій відфільтрованій стрічці «Світ»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موضوع کے لیبل کے بغیر پوسٹس آپ کی فلٹر شدہ بین الاقوامی فیڈ میں رکھتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ các bài đăng không có nhãn chủ đề trong bảng tin Quốc tế đã lọc của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在筛选后的国际信息流中保留没有话题标签的帖子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在已篩選的「國際」動態中保留沒有主題標籤的貼文"
          }
        }
      }
    },
