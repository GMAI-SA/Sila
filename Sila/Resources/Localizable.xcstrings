    "vouch.profile.entry.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قف خلف شخص لم يوثّق هويته بعد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যিনি এখনও ভেরিফাই করেননি তাঁর পাশে দাঁড়ান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon per algú que encara no s'ha verificat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postav se za někoho, kdo se ještě neověřil"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå inde for en, der ikke har verificeret endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jemanden einstehen, der noch nicht verifiziert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στήριξε κάποιον που δεν έχει επαληθευτεί ακόμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand behind someone who hasn't verified yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respalda a alguien que aún no se ha verificado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaa joku, joka ei ole vielä vahvistanut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutenez quelqu’un qui ne s’est pas encore vérifié"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמוד מאחורי מי שעדיין לא אימת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसने अभी सत्यापित नहीं किया उसके पीछे खड़े हों"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stani iza nekoga tko se još nije potvrdio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeskedj valakiért, aki még nem hitelesített"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di belakang orang yang belum terverifikasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantisci per qualcuno che non si è ancora verificato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ認証していない人の後ろ盾になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 인증하지 않은 사람을 보증하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ വെരിഫൈ ചെയ്തിട്ടില്ലാത്ത ഒരാളെ പിന്തുണയ്ക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di belakang seseorang yang belum mengesahkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå bak noen som ikke har verifisert seg ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta in voor iemand die nog niet is geverifieerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poręcz za kogoś, kto jeszcze się nie zweryfikował"
          }
