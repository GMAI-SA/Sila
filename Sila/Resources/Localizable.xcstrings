          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் சேமிக்கப்பட்ட Known உள்நுழைவு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో సేవ్ చేసిన Known సైన్-ఇన్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการลงชื่อเข้าใช้ Known ที่บันทึกไว้บนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kayıtlı Known girişi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає збереженого входу в Known."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر Known کا کوئی محفوظ سائن اِن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thông tin đăng nhập Known nào được lưu trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上没有已保存的 Known 登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上沒有已儲存的 Known 登入資訊。"
          }
        }
      }
    },
    "auth.biometric.error.sessionExpired": {
      "comment": "Error when the saved biometric session has expired.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلستك المحفوظة. سجّل الدخول بكلمة المرور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংরক্ষিত সেশনের মেয়াদ শেষ। পাসওয়ার্ড দিয়ে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessió desada ha caducat. Inicia la sessió amb la contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená relace vypršela. Přihlas se heslem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gemte session er udløbet. Log ind med din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherte Sitzung ist abgelaufen. Melde dich mit deinem Passwort an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθηκευμένη συνεδρία σου έληξε. Συνδέσου με τον κωδικό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved session has expired. Sign in with your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión guardada ha caducado. Inicia sesión con tu contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu istuntosi on vanhentunut. Kirjaudu sisään salasanalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session enregistrée a expiré. Connectez-vous avec votre mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות השמורה שלך פגה. התחבר עם הסיסמה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सहेजा हुआ सेशन खत्म हो गया है। अपने पासवर्ड से साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja spremljena sesija je istekla. Prijavi se lozinkom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett munkamenet lejárt. Jelentkezz be a jelszavaddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi tersimpanmu sudah kedaluwarsa. Masuk dengan kata sandimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione salvata è scaduta. Accedi con la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたセッションの有効期限が切れました。パスワードでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 세션이 만료되었어요. 비밀번호로 로그인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്ത സെഷൻ കാലഹരണപ്പെട്ടു. പാസ്‌വേഡ് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi tersimpan anda telah tamat tempoh. Log masuk dengan kata laluan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede økten din har utløpt. Logg inn med passordet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen sessie is verlopen. Log in met je wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana sesja wygasła. Zaloguj się hasłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão salva expirou. Entre com sua senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua sessão guardada expirou. Inicie sessão com a sua palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea salvată a expirat. Autentifică-te cu parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый сеанс истёк. Войдите с паролем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja uložená relácia vypršala. Prihlás sa heslom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sparade session har gått ut. Logga in med ditt lösenord."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிக்கப்பட்ட உங்கள் அமர்வு காலாவதியானது. கடவுச்சொல்லுடன் உள்நுழையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సేవ్ చేసిన సెషన్ గడువు ముగిసింది. మీ పాస్‌వర్డ్‌తో సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันที่บันทึกไว้หมดอายุแล้ว ลงชื่อเข้าใช้ด้วยรหัสผ่านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı oturumunuzun süresi doldu. Şifrenizle giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений сеанс закінчився. Увійдіть за допомогою пароля."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا محفوظ سیشن ختم ہو گیا ہے۔ اپنے پاس ورڈ سے سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đã lưu của bạn đã hết hạn. Hãy đăng nhập bằng mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你保存的会话已过期。请使用密码登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你儲存的工作階段已過期，請使用密碼登入。"
          }
        }
      }
    },
