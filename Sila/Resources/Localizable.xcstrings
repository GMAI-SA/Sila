    "rooms.create.ama.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت الضيف: قائمة الأسئلة هي واجهة الغرفة الرئيسية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনিই অতিথি: প্রশ্নের সারিই রুমের মূল অংশ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ets el convidat: la cua de preguntes és la part principal de la sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty jsi host: fronta otázek je hlavní částí místnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er gæsten: Spørgsmålskøen er rummets hovedflade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der Gast: Die Fragenliste ist die Hauptfläche des Raums."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσύ είσαι ο καλεσμένος: η ουρά ερωτήσεων είναι η κύρια επιφάνεια της αίθουσας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the guest: the question queue is the room's main surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú eres el invitado: la cola de preguntas es lo principal de la sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä olet vieras: kysymysjono on huoneen pääsisältö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes l’invité : la file de questions est l’élément principal du salon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה האורח: תור השאלות הוא המסך המרכזי של החדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप मेहमान हैं: सवालों की कतार रूम का मुख्य हिस्सा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti si gost: red pitanja je glavni dio sobe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vagy a vendég: a kérdéssor a szoba fő felülete."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tamunya: antrean pertanyaan adalah bagian utama room."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ospite sei tu: la coda delle domande è la parte principale della stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがゲストです。質問の待ち行列がルームの中心になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 게스트예요. 질문 대기열이 룸의 중심 화면이 돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളാണ് അതിഥി: ചോദ്യ ക്യൂവാണ് റൂമിന്റെ പ്രധാന ഭാഗം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ialah tetamu: giliran soalan ialah paparan utama bilik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er gjesten: spørsmålskøen er rommets hovedflate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bent de gast: de vragenrij is het belangrijkste deel van de room."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty jesteś gościem: kolejka pytań jest główną częścią pokoju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o convidado: a fila de perguntas é a parte principal da sala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o convidado: a fila de perguntas é a parte principal da sala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ești invitatul: coada de întrebări este suprafața principală a camerei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы — гость: очередь вопросов становится главным в комнате."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hosť: hlavnou časťou miestnosti je rad otázok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är gästen: frågekön är rummets huvudyta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள்தான் விருந்தினர்: கேள்வி வரிசையே அறையின் முதன்மைப் பகுதி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరే అతిథి: ప్రశ్నల వరుస రూమ్‌లో ప్రధాన భాగం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคือแขกรับเชิญ คิวคำถามเป็นส่วนหลักของห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuk sizsiniz: soru kuyruğu odanın ana alanıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гість — це ви: черга запитань стає головною частиною кімнати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ مہمان ہیں: سوالات کی قطار روم کی بنیادی سطح ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là khách mời: hàng đợi câu hỏi là phần chính của phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是嘉宾：提问队列是房间的主要内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是來賓：提問佇列是聊天室的主要畫面。"
          }
        }
      }
    },
    "rooms.create.audience.a11yLabel": {
      "comment": "VoiceOver label for the audience section.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يمكنه التحدث. الجميع يمكنهم الاستماع إلى الغرفة في الحالتين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে কথা বলতে পারবে। যেভাবেই হোক সবাই রুম শুনতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui pot parlar. En qualsevol cas, tothom pot escoltar la sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo může mluvit. Místnost může poslouchat každý v každém případě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan tale. Alle kan under alle omstændigheder lytte til rummet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer sprechen kann. Alle können dem Raum in jedem Fall zuhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιος μπορεί να μιλήσει. Όλοι μπορούν να ακούσουν την αίθουσα σε κάθε περίπτωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can speak. Everyone can listen to the room either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién puede hablar. De todos modos, todos pueden escuchar la sala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka voi puhua. Kaikki voivat kuunnella huonetta joka tapauksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut parler. Tout le monde peut écouter le salon dans tous les cas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי יכול לדבר. כולם יכולים להאזין לחדר בכל מקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन बोल सकता है। रूम को कोई भी सुन सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tko može govoriti. Svatko može slušati sobu u svakom slučaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki szólalhat meg. A szobát így is, úgy is mindenki hallgathatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang bisa berbicara. Semua orang bisa mendengarkan room apa pun pilihannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi può parlare. In ogni caso tutti possono ascoltare la stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発言できる人。どちらの場合も、ルームは誰でも聴けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말할 수 있는 사람. 어느 쪽이든 누구나 룸을 들을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആർക്ക് സംസാരിക്കാം. ഏതായാലും എല്ലാവർക്കും റൂം കേൾക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa boleh bercakap. Semua orang boleh mendengar bilik dalam apa jua keadaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem kan snakke. Alle kan lytte til rommet uansett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie kan spreken. Iedereen kan hoe dan ook naar de room luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto może mówić. Każdy może słuchać pokoju tak czy inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode falar. De qualquer forma, todos podem ouvir a sala."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode falar. Todos podem ouvir a sala de qualquer forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine poate vorbi. Oricine poate asculta camera în ambele cazuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто может говорить. Слушать комнату может любой в любом случае."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto môže hovoriť. Miestnosť môže počúvať každý v oboch prípadoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem som kan tala. Alla kan lyssna på rummet oavsett."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யார் பேசலாம். எப்படியும் எல்லோரும் அறையைக் கேட்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరు మాట్లాడగలరు. ఎలాగైనా రూమ్‌ను ఎవరైనా వినవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครพูดได้ ไม่ว่าอย่างไรทุกคนก็ฟังห้องได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimler konuşabilir. Odayı her durumda herkes dinleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто може говорити. Слухати кімнату може кожен у будь-якому разі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون بول سکتا ہے۔ روم کو ہر صورت میں سب سن سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai được phát biểu. Dù thế nào ai cũng nghe được phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁可以发言。无论如何，所有人都能收听房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誰可以發言。無論如何，所有人都能收聽聊天室。"
          }
        }
      }
    },
    "rooms.create.audienceUnavailable": {
      "comment": "Toast when an audience is chosen that the account cannot use, and the server named no reason.",
