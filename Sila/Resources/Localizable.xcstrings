    "safety.support.privacy": {
      "comment": "The reassurance under the care-first outcome.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشخص الذي أبلغت عنه لا يُبلَّغ بأنك أبلغت عنه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যাকে রিপোর্ট করেছেন তাকে জানানো হয় না যে আপনি রিপোর্ট করেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona que has denunciat no sap que l'has denunciada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, kterou jsi nahlásil, se nedozví, že jsi ji nahlásil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den person, du anmeldte, får ikke at vide, at du anmeldte vedkommende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gemeldete Person erfährt nicht, dass du sie gemeldet hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άτομο που ανέφερες δεν ενημερώνεται ότι το ανέφερες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person you reported is not told that you reported them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la persona que denunciaste no se le avisa de que la denunciaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmiantamallesi henkilölle ei kerrota, että ilmiannoit hänet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne que vous avez signalée n’est pas informée que vous l’avez signalée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האדם שדיווחת עליו לא מקבל הודעה שדיווחת עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे आपने रिपोर्ट किया उसे नहीं बताया जाता कि आपने उसे रिपोर्ट किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba koju si prijavio/la nije obaviještena da si je prijavio/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentett személy nem tudja meg, hogy jelentetted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang kamu laporkan tidak diberi tahu bahwa kamu melaporkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona che hai segnalato non viene avvisata della tua segnalazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告された人に、あなたが報告したことは知らされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고당한 사람에게는 내가 신고했다는 사실이 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ റിപ്പോർട്ട് ചെയ്ത വ്യക്തിയെ അക്കാര്യം അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang anda laporkan tidak diberitahu bahawa anda melaporkan mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen du rapporterte, får ikke vite at du rapporterte vedkommende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De persoon die je hebt gemeld hoort niet dat jij hem of haar hebt gemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, którą zgłosiłeś, nie jest informowana o zgłoszeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa que você denunciou não é avisada de que você a denunciou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa que denunciou não é avisada de que a denunciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoana raportată nu este anunțată că ai raportat-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек, на которого вы пожаловались, не узнает об этом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, ktorú si nahlásil, sa nedozvie, že si ju nahlásil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen du rapporterade får inte veta att du rapporterade dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் புகாரளித்த நபருக்கு, நீங்கள் புகாரளித்தது தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రిపోర్ట్ చేసిన వ్యక్తికి, మీరు రిపోర్ట్ చేశారని చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่คุณรายงานจะไม่ได้รับแจ้งว่าคุณรายงานเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şikayet ettiğiniz kişiye, onu şikayet ettiğiniz söylenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Людину, на яку ви поскаржилися, не повідомляють про вашу скаргу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس شخص کی آپ نے رپورٹ کی اسے نہیں بتایا جاتا کہ آپ نے رپورٹ کی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bạn báo cáo không được cho biết là bạn đã báo cáo họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你举报的人不会知道是你举报了他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你檢舉的對象不會得知是你檢舉的。"
          }
        }
      }
    },
    "safety.support.title": {
      "comment": "Heading on the care-first outcome, shown for a self-harm report.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لإخبارنا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের জানানোর জন্য ধন্যবাদ"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies per dir-nos-ho"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkujeme, že jsi nám to řekl"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, fordi du fortalte os det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du uns Bescheid gesagt hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που μας το είπες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for telling us"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por decírnoslo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos, että kerroit meille"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de nous l’avoir dit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה ששיתפת אותנו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें बताने के लिए धन्यवाद"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala što si nam rekao/la"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük, hogy szóltál"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih sudah memberi tahu kami"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per avercelo detto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お知らせいただきありがとうございます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려 주셔서 감사해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങളെ അറിയിച്ചതിന് നന്ദി"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih kerana memberitahu kami"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du sa fra"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je het ons vertelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za informację"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por nos contar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por nos ter contado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți mulțumim că ne-ai spus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что сообщили"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďakujeme, že si nám to povedal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du berättade"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்களிடம் தெரிவித்ததற்கு நன்றி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాకు తెలియజేసినందుకు ధన్యవాదాలు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่บอกเรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize söylediğiniz için teşekkürler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо, що повідомили нам"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمیں بتانے کا شکریہ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã cho chúng tôi biết"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你告诉我们"
          }
        },
