    "profile.badge.muted.accessibilityLabel": {
      "comment": "VoiceOver reading of the muted badge. Muting is silent and the other person is never told.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد كتمت هذا الحساب. منشوراته مخفية عنك. ولم يُبلَّغ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই অ্যাকাউন্ট মিউট করেছেন। তাদের পোস্ট আপনার ফিড থেকে লুকানো। তাদের জানানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has silenciat aquest compte. Les seves publicacions estan amagades dels teus canals. No ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet jsi ztlumil. Jeho příspěvky jsou skryté z tvých kanálů. Nebyl o tom informován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har gjort denne konto lydløs. Dens opslag er skjult fra dine feeds. Den fik ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dieses Konto stummgeschaltet. Seine Beiträge sind in deinen Feeds ausgeblendet. Die Person wurde nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις βάλει αυτόν τον λογαριασμό σε σίγαση. Οι αναρτήσεις του κρύβονται από τις ροές σου. Δεν ενημερώθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have muted this account. Their posts are hidden from your feeds. They were not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has silenciado esta cuenta. Sus publicaciones están ocultas en tus feeds. No se le avisó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet mykistänyt tämän tilin. Heidän julkaisunsa on piilotettu syötteistäsi. Heille ei kerrottu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez mis ce compte en sourdine. Ses posts sont masqués de vos fils. Il n’en a pas été informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתקת את החשבון הזה. הפוסטים שלו מוסתרים מהפידים שלך. הוא לא קיבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस अकाउंट को म्यूट किया है। इनकी पोस्ट आपकी फ़ीड से छिपी हैं। इन्हें बताया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utišao/la si ovaj račun. Njegove objave skrivene su iz tvojih feedova. Nije obaviješten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Némítottad ezt a fiókot. A bejegyzései el vannak rejtve a hírfolyamaidból. Nem értesítettük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membisukan akun ini. Postingannya disembunyikan dari feed-mu. Mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai silenziato questo account. I suoi post sono nascosti dai tuoi feed. Non è stato avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントをミュートしています。投稿はフィードに表示されません。相手には知らされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정을 뮤트했어요. 이 계정의 게시물이 피드에서 숨겨져요. 상대방에게는 알려지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ അക്കൗണ്ട് മ്യൂട്ട് ചെയ്തു. അവരുടെ പോസ്റ്റുകൾ നിങ്ങളുടെ ഫീഡുകളിൽ നിന്ന് മറച്ചിരിക്കുന്നു. അവരെ അറിയിച്ചിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menyenyapkan akaun ini. Siaran mereka disembunyikan daripada suapan anda. Mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har dempet denne kontoen. Innleggene deres er skjult fra feedene dine. De fikk ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt dit account gedempt. Hun berichten zijn verborgen in je feeds. Ze zijn hier niet van op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciszyłeś to konto. Jego wpisy są ukryte w Twoich kanałach. Nie zostało o tym poinformowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você silenciou esta conta. Os posts dela estão ocultos dos seus feeds. A pessoa não foi avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciou esta conta. As publicações dela estão ocultas dos seus feeds. Não foi avisada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai dezactivat acest cont. Postările lui sunt ascunse din fluxurile tale. Nu a fost anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы заглушили этот аккаунт. Его посты скрыты из ваших лент. Его владельца не уведомляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet si stlmil. Jeho príspevky sú skryté z tvojich kanálov. Nebolo mu to oznámené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har tystat det här kontot. Deras inlägg är dolda från dina flöden. De fick inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இந்தக் கணக்கை ஒலியடக்கியுள்ளீர்கள். அவர்களின் இடுகைகள் உங்கள் ஊட்டங்களிலிருந்து மறைக்கப்பட்டுள்ளன. அவர்களுக்குத் தெரிவிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈ ఖాతాను మ్యూట్ చేశారు. వారి పోస్ట్‌లు మీ ఫీడ్‌ల నుండి దాచబడ్డాయి. వారికి చెప్పబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณปิดเสียงบัญชีนี้ โพสต์ของพวกเขาถูกซ่อนจากฟีดของคุณ พวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabı sessize aldınız. Gönderileri akışlarınızdan gizlenir. Kendilerine söylenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви заглушили цей обліковий запис. Його дописи приховано з ваших стрічок. Його власника не повідомили."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے یہ اکاؤنٹ میوٹ کیا ہے۔ اس کی پوسٹس آپ کی فیڈز سے چھپی ہیں۔ انہیں نہیں بتایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã ẩn tài khoản này. Bài đăng của họ bị ẩn khỏi bảng tin của bạn. Họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已将此账户静音。他们的帖子已从你的信息流中隐藏。对方并不知情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已將此帳號靜音。其貼文已從你的動態中隱藏。對方不會得知。"
          }
        }
      }
    },
    "profile.blocked.subtitle": {
      "comment": "What the block did. Names the severed follow and the silence, both of which the user consented to.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأي منكما رؤية منشورات الآخر، وأُزيلت أي متابعة بينكما. ولم يُبلَّغ بذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনারা কেউ কারও পোস্ট দেখতে পারবেন না, এবং আপনাদের মধ্যকার যেকোনো ফলো সরিয়ে দেওয়া হয়েছে। তাদের জানানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap dels dos no pot veure les publicacions de l'altre, i s'ha eliminat qualsevol seguiment entre vosaltres. No ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ani jeden z vás nevidí příspěvky toho druhého a veškeré sledování mezi vámi bylo odstraněno. Nebyl o tom informován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af jer kan se den andens opslag, og enhver følgning mellem jer er fjernet. De fik ikke besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner von euch sieht die Beiträge des anderen, und jedes Follow zwischen euch wurde entfernt. Die Person wurde nicht benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς από τους δύο δεν βλέπει τις αναρτήσεις του άλλου και κάθε ακολούθηση μεταξύ σας αφαιρέθηκε. Δεν ενημερώθηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither of you can see the other's posts, and any follow between you was removed. They were not told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno de los dos puede ver las publicaciones del otro y se eliminó cualquier seguimiento entre vosotros. No se le avisó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpikaan teistä ei näe toisen julkaisuja, ja kaikki välillänne olleet seuraamiset poistettiin. Heille ei kerrottu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun de vous deux ne peut voir les posts de l’autre, et tout abonnement entre vous a été supprimé. Il n’en a pas été informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד מכם לא יכול לראות את הפוסטים של האחר, וכל מעקב ביניכם הוסר. הוא לא קיבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दोनों में से कोई एक-दूसरे की पोस्ट नहीं देख सकता, और आपके बीच का कोई भी फ़ॉलो हटा दिया गया। इन्हें बताया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko od vas ne vidi objave onog drugog, a svako praćenje među vama je uklonjeno. Nije obaviješten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyikőtök sem látja a másik bejegyzéseit, és a köztetek lévő követések megszűntek. Nem értesítettük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalian berdua tidak bisa melihat postingan satu sama lain, dan semua hubungan mengikuti di antara kalian dihapus. Mereka tidak diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno dei due può vedere i post dell'altro e ogni follow tra voi è stato rimosso. Non è stato avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お互いの投稿が見えなくなり、2人の間のフォローは解除されました。相手には知らされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로의 게시물을 볼 수 없으며 둘 사이의 팔로우는 모두 해제되었어요. 상대방에게는 알려지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രണ്ടുപേർക്കും പരസ്പരം പോസ്റ്റുകൾ കാണാനാവില്ല, നിങ്ങൾക്കിടയിലുള്ള ഫോളോ ഇല്ലാതാക്കി. അവരെ അറിയിച്ചിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada seorang pun daripada anda boleh melihat siaran yang lain, dan sebarang ikutan antara anda telah dialih keluar. Mereka tidak diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av dere kan se den andres innlegg, og alle følginger mellom dere ble fjernet. De fikk ikke vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie kunnen elkaars berichten niet zien en elke volgrelatie tussen jullie is verwijderd. Ze zijn hier niet van op de hoogte gesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne z Was nie widzi wpisów drugiej strony, a wszelkie obserwowanie między Wami zostało usunięte. Nie zostali o tym poinformowani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dos dois pode ver os posts do outro, e qualquer vínculo de seguir entre vocês foi removido. A pessoa não foi avisada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum de vocês consegue ver as publicações do outro, e qualquer seguimento entre vocês foi removido. Não foi avisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciunul dintre voi nu vede postările celuilalt, iar orice urmărire dintre voi a fost eliminată. Nu a fost anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не видите посты друг друга, а все подписки между вами удалены. Его владельца не уведомляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto z vás nevidí príspevky toho druhého a akékoľvek sledovanie medzi vami bolo odstránené. Nebolo mu to oznámené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av er kan se den andras inlägg, och eventuell följning mellan er har tagits bort. De fick inte veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இருவரில் யாரும் மற்றவரின் இடுகைகளைப் பார்க்க முடியாது, உங்களுக்கிடையிலான பின்தொடர்தல்களும் அகற்றப்பட்டன. அவர்களுக்குத் தெரிவிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీలో ఎవరూ మరొకరి పోస్ట్‌లను చూడలేరు, మీ మధ్య ఉన్న ఫాలో ఏదైనా తొలగించబడింది. వారికి చెప్పబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครเห็นโพสต์ของอีกฝ่าย และการติดตามระหว่างกันถูกลบแล้ว พวกเขาไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkiniz de birbirinizin gönderilerini göremezsiniz ve aranızdaki takipler kaldırıldı. Kendilerine söylenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніхто з вас не бачить дописів одне одного, а будь-яку підписку між вами скасовано. Його власника не повідомили."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ میں سے کوئی بھی دوسرے کی پوسٹس نہیں دیکھ سکتا، اور آپ کے درمیان کوئی بھی فالو ہٹا دیا گیا۔ انہیں نہیں بتایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai bên không thấy bài đăng của nhau, và mọi lượt theo dõi giữa hai bạn đã bị xóa. Họ không được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们彼此都看不到对方的帖子，你们之间的任何关注也已移除。对方并不知情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們雙方都看不到對方的貼文，且你們之間的追蹤關係已移除。對方不會得知。"
          }
        }
      }
    },
