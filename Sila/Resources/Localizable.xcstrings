        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse opplysningene stemmer ikke med det personen som sendte lenken, skrev inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gegevens komen niet overeen met wat de persoon die de link stuurde heeft ingevoerd."
