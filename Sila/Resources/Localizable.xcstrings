    "account.password.submit.hint": {
      "comment": "VoiceOver hint for the change-password button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل كلمة مرورك ويسجّل الخروج من كل الأجهزة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসওয়ার্ড বদলে প্রতিটি ডিভাইস সাইন আউট করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitueix la teva contrasenya i tanca la sessió a tots els dispositius"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradí tvé heslo a odhlásí všechna zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatter din adgangskode og logger alle enheder ud"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt dein Passwort und meldet alle Geräte ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντικαθιστά τον κωδικό σου και αποσυνδέει κάθε συσκευή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces your password and signs every device out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye tu contraseña y cierra la sesión en todos los dispositivos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa salasanasi ja kirjaa kaikki laitteet ulos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace votre mot de passe et déconnecte tous les appareils"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף את הסיסמה שלך ומנתק את כל המכשירים"
