    "communities.private.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشوراته وغرفه وأعضاؤه لمن فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর পোস্ট, রুম ও সদস্যরা শুধু এর ভেতরের মানুষদের জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions, sales i membres són per a les persones que en formen part."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Její příspěvky, místnosti a členové jsou jen pro lidi uvnitř."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dets opslag, rum og medlemmer er for dem, der er med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge, Räume und Mitglieder sind nur für die Personen darin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις, οι αίθουσες και τα μέλη της είναι για όσους ανήκουν σε αυτήν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its posts, rooms and members are for the people in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus publicaciones, salas y miembros son solo para quienes forman parte de ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen julkaisut, huoneet ja jäsenet ovat vain siinä oleville."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses posts, ses salons et ses membres sont réservés aux personnes qui en font partie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסטים, החדרים והחברים שלה מיועדים לאנשים שבתוכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी पोस्ट, रूम और सदस्य केवल इसमें मौजूद लोगों के लिए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njezine objave, sobe i članovi namijenjeni su ljudima u njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzések, szobák és tagok csak a közösség tagjainak szólnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan, room, dan anggotanya hanya untuk orang di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi post, le sue stanze e i suoi membri sono per chi ne fa parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿、ルーム、メンバーは、参加している人だけのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물, 룸, 멤버는 커뮤니티 안에 있는 사람들만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിലെ പോസ്റ്റുകളും റൂമുകളും അംഗങ്ങളും ഇതിലുള്ളവർക്ക് മാത്രമുള്ളതാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran, bilik dan ahlinya hanya untuk orang di dalamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innleggene, rommene og medlemmene er for dem som er med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De berichten, rooms en leden zijn voor de mensen die erin zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy, pokoje i członkowie są tylko dla osób, które do niej należą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts, as salas e os membros são só para quem faz parte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações, salas e membros são só para quem pertence a ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările, camerele și membrii ei sunt doar pentru cei din comunitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты, комнаты и участники видны только тем, кто в сообществе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej príspevky, miestnosti a členovia sú pre ľudí v nej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess inlägg, rum och medlemmar är till för dem som är med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதன் இடுகைகள், அறைகள், உறுப்பினர்கள் உள்ளே இருப்பவர்களுக்கு மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని పోస్ట్‌లు, రూమ్‌లు, సభ్యులు అందులో ఉన్నవారి కోసం మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ ห้อง และสมาชิกของชุมชนนี้สำหรับคนที่อยู่ในชุมชนเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileri, odaları ve üyeleri yalnızca içindekiler içindir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Її дописи, кімнати та учасники — лише для тих, хто в ній."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی پوسٹس، رومز اور ارکان اسی میں شامل لوگوں کے لیے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng, phòng và thành viên chỉ dành cho những người trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的帖子、房间和成员只对社区内的人可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其貼文、聊天室和成員僅限社群內的人查看。"
          }
        }
      }
    },
