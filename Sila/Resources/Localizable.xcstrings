        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användarnamn är %1$@–%2$@ tecken med bokstäver, siffror och understreck."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஹேண்டில்கள் %1$@–%2$@ எழுத்துகள் கொண்டவை; எழுத்துகள், எண்கள், அடிக்கோடுகள் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హ్యాండిల్‌లు %1$@–%2$@ అక్షరాలు ఉండాలి, అందులో అక్షరాలు, అంకెలు, అండర్‌స్కోర్‌లు మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แฮนเดิลมี %1$@–%2$@ ตัวอักษร ประกอบด้วยตัวอักษร ตัวเลข และขีดล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adları %1$@–%2$@ karakterden oluşur; harf, rakam ve alt çizgi içerebilir."
