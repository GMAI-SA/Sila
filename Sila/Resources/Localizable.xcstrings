    "auth.rejected.retake.hint": {
      "comment": "Accessibility hint.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الكاميرا لتصوير وثيقتك أو رفعها من جديد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নথির ছবি আবার তুলতে বা আপলোড করতে ক্যামেরা খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la càmera per fotografiar o pujar de nou el teu document"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře fotoaparát pro nové vyfotografování nebo nahrání dokladu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner kameraet, så du kan fotografere eller uploade dit dokument igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Kamera, um dein Dokument erneut zu fotografieren oder hochzuladen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει την κάμερα για να φωτογραφίσεις ή να ανεβάσεις ξανά το έγγραφό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the camera to photograph or upload your document again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cámara para fotografiar o subir de nuevo tu documento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kameran asiakirjan kuvaamista tai lataamista varten uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’appareil photo pour photographier ou envoyer à nouveau votre document"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את המצלמה לצילום או להעלאה מחדש של המסמך שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दस्तावेज़ फिर से फ़ोटो लेने या अपलोड करने के लिए कैमरा खोलता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara kameru za ponovno fotografiranje ili prijenos isprave"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a kamerát az okmány újrafényképezéséhez vagy feltöltéséhez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kamera untuk memotret atau mengunggah dokumenmu lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la fotocamera per fotografare o caricare di nuovo il documento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを開いて、書類を撮り直すかアップロードし直します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 열어 문서를 다시 촬영하거나 업로드해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖ വീണ്ടും ഫോട്ടോ എടുക്കാനോ അപ്‌ലോഡ് ചെയ്യാനോ ക്യാമറ തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kamera untuk memotret atau memuat naik dokumen anda semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner kameraet for å ta bilde av eller laste opp dokumentet på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de camera om je document opnieuw te fotograferen of te uploaden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera aparat, aby ponownie sfotografować lub przesłać dokument"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a câmera para fotografar ou enviar seu documento novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a câmara para fotografar ou carregar novamente o seu documento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide camera pentru a fotografia sau încărca din nou documentul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает камеру, чтобы снова сфотографировать или загрузить документ"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí fotoaparát na odfotenie alebo nahratie dokladu znova"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar kameran för att fotografera eller ladda upp ditt dokument igen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்தை மீண்டும் படம் எடுக்க அல்லது பதிவேற்ற கேமராவைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రాన్ని మళ్లీ ఫోటో తీయడానికి లేదా అప్‌లోడ్ చేయడానికి కెమెరాను తెరుస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดกล้องเพื่อถ่ายหรืออัปโหลดเอกสารของคุณอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenizi yeniden fotoğraflamak veya yüklemek için kamerayı açar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває камеру, щоб знову сфотографувати або завантажити документ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا دستاویز دوبارہ کھینچنے یا اپ لوڈ کرنے کے لیے کیمرا کھولتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở camera để chụp hoặc tải lên lại giấy tờ của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开相机，重新拍摄或上传你的证件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟相機，重新拍攝或上傳你的證件"
          }
        }
      }
    },
    "auth.rejected.revoked.message": {
      "comment": "Body when a moderator withdrew the badge.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب مشرف التوثيق من هذا الحساب، لذا فهو مغلق. إن كنت ترى أن هذا خطأ، يمكنك التظلم هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একজন মডারেটর এই অ্যাকাউন্টের ভেরিফিকেশন প্রত্যাহার করেছেন, তাই এটি বন্ধ করা হয়েছে। ভুল মনে হলে এখানে আপিল করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderador ha retirat la verificació d'aquest compte, de manera que està tancat. Si creus que és un error, pots apel·lar aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderátor stáhl ověření tohoto účtu, proto je uzavřen. Pokud si myslíš, že je to chyba, můžeš se zde odvolat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator har trukket verificeringen af denne konto tilbage, så den er lukket. Hvis du mener, det er forkert, kan du anke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Moderator hat die Verifizierung dieses Kontos zurückgezogen, daher ist es geschlossen. Wenn du glaubst, dass das falsch ist, kannst du hier Einspruch einlegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας συντονιστής ανακάλεσε την επαλήθευση αυτού του λογαριασμού, γι' αυτό έχει κλείσει. Αν πιστεύεις ότι είναι λάθος, μπορείς να υποβάλεις ένσταση εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moderator has withdrawn the verification of this account, so it is closed. If you believe this is wrong, you can appeal here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderador ha retirado la verificación de esta cuenta, por lo que está cerrada. Si crees que es un error, puedes apelar aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderaattori on peruuttanut tämän tilin vahvistuksen, joten tili on suljettu. Jos uskot tämän olevan väärin, voit valittaa täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modérateur a retiré la vérification de ce compte, il est donc fermé. Si vous pensez que c’est une erreur, vous pouvez faire un recours ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהל תוכן ביטל את אימות החשבון הזה, ולכן הוא סגור. אם אתה סבור שזו טעות, אפשר לערער כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मॉडरेटर ने इस अकाउंट का सत्यापन वापस ले लिया है, इसलिए यह बंद है। अगर आपको लगता है कि यह ग़लत है, तो आप यहाँ अपील कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator je povukao provjeru ovog računa pa je zatvoren. Ako smatraš da je to pogrešno, ovdje se možeš žaliti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy moderátor visszavonta ennek a fióknak a hitelesítését, ezért le van zárva. Ha szerinted ez tévedés, itt fellebbezhetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang moderator telah mencabut verifikasi akun ini, jadi akun ditutup. Jika kamu merasa ini keliru, kamu bisa mengajukan banding di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderatore ha revocato la verifica di questo account, quindi è chiuso. Se pensi sia un errore, puoi fare ricorso qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデレーターがこのアカウントの認証を取り消したため、アカウントは閉鎖されました。誤りだと思われる場合は、ここから異議を申し立てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모더레이터가 이 계정의 인증을 철회하여 계정이 닫혔어요. 잘못되었다고 생각하면 여기서 이의를 신청할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മോഡറേറ്റർ ഈ അക്കൗണ്ടിന്റെ പരിശോധന പിൻവലിച്ചു, അതിനാൽ ഇത് അടച്ചിരിക്കുന്നു. ഇത് തെറ്റാണെന്ന് തോന്നുന്നെങ്കിൽ ഇവിടെ അപ്പീൽ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seorang moderator telah menarik balik pengesahan akaun ini, jadi ia ditutup. Jika anda percaya ini salah, anda boleh merayu di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator har trukket tilbake verifiseringen av denne kontoen, så den er stengt. Hvis du tror det er feil, kan du anke her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een moderator heeft de verificatie van dit account ingetrokken, dus het is gesloten. Denk je dat dit niet klopt, dan kun je hier bezwaar maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderator wycofał weryfikację tego konta, więc zostało ono zamknięte. Jeśli uważasz, że to błąd, możesz się tutaj odwołać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um moderador retirou a verificação desta conta, por isso ela foi encerrada. Se acha que isso está errado, você pode contestar aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um moderador retirou a verificação desta conta, por isso está encerrada. Se acha que é um erro, pode contestar aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moderator a retras verificarea acestui cont, așa că este închis. Dacă crezi că este o greșeală, poți contesta aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модератор отозвал проверку этого аккаунта, поэтому он закрыт. Если считаете это ошибкой, подайте апелляцию здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderátor stiahol overenie tohto účtu, preto je uzavretý. Ak si myslíš, že je to nesprávne, môžeš sa tu odvolať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En moderator har återkallat verifieringen av det här kontot, så det är stängt. Om du tror att det är fel kan du överklaga här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மதிப்பீட்டாளர் இந்தக் கணக்கின் சரிபார்ப்பைத் திரும்பப் பெற்றுள்ளார், எனவே இது மூடப்பட்டுள்ளது. இது தவறு என்று நினைத்தால் இங்கே மேல்முறையீடு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోడరేటర్ ఈ ఖాతా ధృవీకరణను ఉపసంహరించారు, కాబట్టి ఇది మూసివేయబడింది. ఇది తప్పని మీరు భావిస్తే, ఇక్కడ అప్పీల్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ดูแลได้เพิกถอนการยืนยันบัญชีนี้ บัญชีจึงถูกปิด หากคุณคิดว่าไม่ถูกต้อง คุณอุทธรณ์ได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir moderatör bu hesabın doğrulamasını geri çekti, bu yüzden hesap kapatıldı. Bunun yanlış olduğunu düşünüyorsanız buradan itiraz edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модератор скасував верифікацію цього облікового запису, тому його закрито. Якщо ви вважаєте, що це помилка, ви можете оскаржити рішення тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ماڈریٹر نے اس اکاؤنٹ کی تصدیق واپس لے لی ہے، اس لیے یہ بند ہے۔ اگر آپ کو لگتا ہے کہ یہ غلط ہے تو آپ یہاں اپیل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người kiểm duyệt đã thu hồi xác minh của tài khoản này nên tài khoản bị đóng. Nếu bạn cho rằng điều này sai, bạn có thể khiếu nại tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版主已撤销此账户的验证，因此账户已关闭。如果你认为这是错误的，可以在此申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版主已撤銷此帳號的驗證，因此帳號已關閉。若你認為有誤，可以在此申訴。"
          }
        }
      }
    },
