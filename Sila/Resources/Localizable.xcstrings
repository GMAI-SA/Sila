        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളുടെ പോസ്റ്റുകൾ നിങ്ങളുടെ ഫോളോ ഫീഡിൽ കാണിക്കുന്നു"
