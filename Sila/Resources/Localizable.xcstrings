        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личность не проверена · поручился(-лась) @%1$@ с %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Totožnosť neoverená · za túto osobu ručí @%1$@ od %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte identitetsverifierad · intygad av @%1$@ sedan %2$@"
