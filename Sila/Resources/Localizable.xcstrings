    "post.views.count": {
      "comment": "View counter under a post. Argument 1 is the raw count and picks the plural; argument 2 is the abbreviated number that is shown.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$@ مشاهدات"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$@ مشاهدة"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "مشاهدة واحدة"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$@ مشاهدة"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "مشاهدتان"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "لا مشاهدات"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$@ view"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$@ views"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "preferences.countries.add": {
