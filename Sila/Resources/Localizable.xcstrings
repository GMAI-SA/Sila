    "messages.request.banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا طلب. الرد عليه يقبله وينقله إلى الوارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি অনুরোধ। উত্তর দিলে এটি গ্রহণ হয়ে আপনার ইনবক্সে চলে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això és una sol·licitud. Si respons, l'acceptes i es mou a la safata d'entrada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je žádost. Odpovědí ji přijmeš a přesune se do doručených."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en anmodning. Hvis du svarer, accepterer du den og flytter den til din indbakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Anfrage. Wenn du antwortest, nimmst du sie an und sie wandert in deinen Posteingang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό είναι αίτημα. Η απάντηση το αποδέχεται και το μεταφέρει στα εισερχόμενά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a request. Replying accepts it and moves it to your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es una solicitud. Al responder, la aceptas y pasa a tu bandeja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on pyyntö. Vastaaminen hyväksyy sen ja siirtää sen saapuneisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une demande. Répondre l’accepte et la déplace dans votre boîte de réception."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו בקשה. תגובה מקבלת אותה ומעבירה אותה לתיבת הדואר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक अनुरोध है। जवाब देने पर यह स्वीकार हो जाता है और आपके इनबॉक्स में चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je zahtjev. Odgovor ga prihvaća i premješta u tvoju pristiglu poštu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy kérés. A válaszolás elfogadja, és áthelyezi a beérkezettek közé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini permintaan. Membalas berarti menerimanya dan memindahkannya ke kotak masukmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una richiesta. Rispondere la accetta e la sposta in arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはリクエストです。返信すると承認され、受信箱に移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 요청이에요. 답장하면 수락되어 받은 메시지로 이동해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതൊരു അഭ്യർഥനയാണ്. മറുപടി നൽകിയാൽ ഇത് സ്വീകരിച്ച് ഇൻബോക്സിലേക്ക് മാറ്റും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah permintaan. Membalas menerimanya dan memindahkannya ke peti masuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en forespørsel. Hvis du svarer, godtar du den og flytter den til innboksen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een verzoek. Reageren accepteert het en verplaatst het naar je inbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To prośba. Odpowiedź ją akceptuje i przenosi do Odebranych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma solicitação. Responder a aceita e a move para a sua caixa de entrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é um pedido. Responder aceita-o e move-o para a sua caixa de entrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este o cerere. Răspunsul o acceptă și o mută în inbox."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запрос. Ответ принимает его и переносит во входящие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je žiadosť. Odpoveďou ju prijmeš a presunie sa do doručených."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en förfrågan. Om du svarar godtas den och flyttas till din inkorg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒரு கோரிக்கை. பதிலளித்தால் அது ஏற்கப்பட்டு உங்கள் இன்பாக்ஸுக்கு நகரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఒక అభ్యర్థన. రిప్లై ఇస్తే అది ఆమోదించబడి మీ ఇన్‌బాక్స్‌కు తరలుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือคำขอ การตอบกลับจะเป็นการรับและย้ายไปที่กล่องข้อความของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir istek. Yanıtlamak onu kabul eder ve gelen kutunuza taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запит. Відповідь приймає його й переміщує до ваших вхідних."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایک درخواست ہے۔ جواب دینے سے یہ قبول ہو جاتی ہے اور آپ کے ان باکس میں چلی جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là một yêu cầu. Trả lời sẽ chấp nhận nó và chuyển vào hộp thư của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一条请求。回复即表示接受，并会移到你的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一則請求。回覆即表示接受，並會移到你的收件匣。"
          }
        }
      }
    },
    "messages.requests.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه أول رسالة من أشخاص لا تتابعهم. لا يمكنهم معرفة ما إذا قرأتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো আপনি ফলো করেন না এমন মানুষের প্রথম মেসেজ। আপনি পড়েছেন কি না তারা দেখতে পায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquests són primers missatges de persones que no segueixes. No poden veure si els has llegit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto jsou první zprávy od lidí, které nesleduješ. Nevidí, zda jsi je přečetl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er første beskeder fra folk, du ikke følger. De kan ikke se, om du har læst dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind erste Nachrichten von Personen, denen du nicht folgst. Sie können nicht sehen, ob du sie gelesen hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά είναι πρώτα μηνύματα από άτομα που δεν ακολουθείς. Δεν μπορούν να δουν αν τα έχεις διαβάσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are first messages from people you do not follow. They cannot see whether you have read them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son primeros mensajes de personas a las que no sigues. No pueden saber si los has leído."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat ensimmäisiä viestejä ihmisiltä, joita et seuraa. He eivät näe, oletko lukenut ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des premiers messages de personnes que vous ne suivez pas. Elles ne peuvent pas voir si vous les avez lus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה הודעות ראשונות מאנשים שאתה לא עוקב אחריהם. הם לא יכולים לראות אם קראת אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये उन लोगों के पहले संदेश हैं जिन्हें आप फ़ॉलो नहीं करते। वे यह नहीं देख सकते कि आपने इन्हें पढ़ा या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo su prve poruke od ljudi koje ne pratiš. Ne mogu vidjeti jesi li ih pročitao/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek az általad nem követett emberek első üzenetei. Nem láthatják, hogy elolvastad-e őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini pesan pertama dari orang yang tidak kamu ikuti. Mereka tidak bisa melihat apakah kamu sudah membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono primi messaggi di persone che non segui. Non possono vedere se li hai letti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローしていない人からの最初のメッセージです。あなたが読んだかどうかは相手に表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우하지 않는 사람의 첫 메시지예요. 상대방은 내가 읽었는지 알 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഫോളോ ചെയ്യാത്തവരുടെ ആദ്യ സന്ദേശങ്ങളാണിവ. നിങ്ങൾ വായിച്ചോ എന്ന് അവർക്ക് കാണാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah mesej pertama daripada orang yang tidak anda ikuti. Mereka tidak dapat melihat sama ada anda telah membacanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er første meldinger fra folk du ikke følger. De kan ikke se om du har lest dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn eerste berichten van mensen die je niet volgt. Zij kunnen niet zien of je ze hebt gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To pierwsze wiadomości od osób, których nie obserwujesz. Nie widzą, czy je przeczytałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são primeiras mensagens de pessoas que você não segue. Elas não podem ver se você as leu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são primeiras mensagens de pessoas que não segue. Elas não conseguem ver se as leu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt primele mesaje de la oameni pe care nu îi urmărești. Ei nu pot vedea dacă le-ai citit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это первые сообщения от людей, на которых вы не подписаны. Они не видят, прочитали ли вы их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sú prvé správy od ľudí, ktorých nesleduješ. Nevidia, či si ich prečítal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är första meddelanden från personer du inte följer. De kan inte se om du har läst dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவை நீங்கள் பின்தொடராதவர்களின் முதல் செய்திகள். நீங்கள் படித்தீர்களா என்பதை அவர்களால் பார்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇవి మీరు ఫాలో అవ్వని వారి నుండి వచ్చిన మొదటి సందేశాలు. మీరు వాటిని చదివారో లేదో వారు చూడలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือข้อความแรกจากคนที่คุณไม่ได้ติดตาม พวกเขาไม่เห็นว่าคุณอ่านแล้วหรือยัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar takip etmediğiniz kişilerden gelen ilk mesajlar. Onları okuyup okumadığınızı göremezler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це перші повідомлення від людей, на яких ви не підписані. Вони не можуть бачити, чи ви їх прочитали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ان لوگوں کے پہلے پیغامات ہیں جنہیں آپ فالو نہیں کرتے۔ وہ نہیں دیکھ سکتے کہ آپ نے انہیں پڑھا یا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là tin nhắn đầu tiên từ những người bạn không theo dõi. Họ không thấy được bạn đã đọc hay chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是来自你未关注的人的第一条消息。对方看不到你是否已读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是你未追蹤的人傳來的第一則訊息。對方看不到你是否已讀。"
          }
        }
      }
    },
