        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %1$@ слухачів одночасно, усього %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک وقت میں زیادہ سے زیادہ %1$@ سن رہے تھے، کل %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa %1$@ người nghe cùng lúc, tổng cộng %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时最多 %1$@ 人收听，共 %2$@ 人"
