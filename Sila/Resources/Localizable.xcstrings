            "value": "Algú que et republica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo tě sdílel dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, der deler dig videre."
          }
