        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה יכול להאזין לחדר הזה, אבל בגלל הקהל שלו אינך יכול לדבר בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस रूम को सुन सकते हैं, पर इसकी ऑडियंस के कारण आप इसमें बोल नहीं सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš slušati ovu sobu, ali zbog njezine publike ne možeš govoriti u njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallgathatod ezt a szobát, de a közönsége miatt nem szólalhatsz meg benne."
