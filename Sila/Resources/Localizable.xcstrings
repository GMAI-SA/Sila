    "account.recovery.currentState.posts": {
      "comment": "Current state: the posts and profile are hidden.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشوراتك مخفية من كل الصفحات ونتائج البحث والسلاسل، وملفك لا يظهر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পোস্ট সব ফিড, সার্চ ফলাফল ও থ্রেড থেকে লুকানো, আর আপনার প্রোফাইল খোলা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves publicacions estan amagades de tots els canals, resultats de cerca i fils, i el teu perfil no es resol."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé příspěvky jsou skryté ze všech kanálů, výsledků hledání i vláken a tvůj profil není dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine opslag er skjult fra alle feeds, søgeresultater og tråde, og din profil kan ikke findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beiträge sind in allen Feeds, Suchergebnissen und Threads ausgeblendet, und dein Profil ist nicht auffindbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις σου είναι κρυμμένες από κάθε ροή, αποτέλεσμα αναζήτησης και νήμα, και το προφίλ σου δεν εμφανίζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts are hidden from every feed, search result and thread, and your profile does not resolve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus publicaciones están ocultas en todos los feeds, búsquedas e hilos, y tu perfil no aparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaisusi on piilotettu kaikista syötteistä, hakutuloksista ja keskusteluista, eikä profiilisi aukea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos posts sont masqués de tous les fils, résultats de recherche et discussions, et votre profil n’est plus accessible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסטים שלך מוסתרים מכל פיד, תוצאת חיפוש ושרשור, והפרופיל שלך לא נפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट हर फ़ीड, खोज नतीजे और थ्रेड से छिपी हैं, और आपकी प्रोफ़ाइल खुलती नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje objave skrivene su iz svih feedova, rezultata pretraživanja i niti, a tvoj profil se ne otvara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzéseid el vannak rejtve minden hírfolyamból, keresési találatból és szálból, és a profilod nem érhető el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postinganmu disembunyikan dari semua feed, hasil pencarian, dan utas, dan profilmu tidak bisa dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi post sono nascosti da ogni feed, risultato di ricerca e discussione, e il tuo profilo non è raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿はすべてのフィード、検索結果、スレッドから非表示になり、プロフィールも表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물이 모든 피드, 검색 결과, 스레드에서 숨겨져 있고 프로필도 열리지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പോസ്റ്റുകൾ എല്ലാ ഫീഡുകളിൽ നിന്നും തിരയൽ ഫലങ്ങളിൽ നിന്നും ത്രെഡുകളിൽ നിന്നും മറച്ചിരിക്കുന്നു, നിങ്ങളുടെ പ്രൊഫൈൽ തുറക്കാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran anda disembunyikan daripada setiap suapan, hasil carian dan utas, dan profil anda tidak boleh dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innleggene dine er skjult fra alle feeder, søkeresultater og tråder, og profilen din finnes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je berichten zijn verborgen uit alle feeds, zoekresultaten en threads, en je profiel is niet vindbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wpisy są ukryte we wszystkich kanałach, wynikach wyszukiwania i wątkach, a Twój profil jest niedostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus posts estão ocultos de todos os feeds, resultados de busca e conversas, e seu perfil não é encontrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas publicações estão ocultas de todos os feeds, resultados de pesquisa e conversas, e o seu perfil não é encontrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările tale sunt ascunse din toate fluxurile, rezultatele căutării și conversațiile, iar profilul tău nu mai poate fi găsit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши посты скрыты из всех лент, результатов поиска и обсуждений, а профиль не открывается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje príspevky sú skryté zo všetkých kanálov, výsledkov vyhľadávania aj vlákien a tvoj profil nie je dostupný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inlägg är dolda från alla flöden, sökresultat och trådar, och din profil går inte att hitta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடுகைகள் எல்லா ஊட்டங்கள், தேடல் முடிவுகள், உரையாடல்களிலிருந்தும் மறைக்கப்பட்டுள்ளன; உங்கள் சுயவிவரமும் காணப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పోస్ట్‌లు అన్ని ఫీడ్‌లు, శోధన ఫలితాలు, థ్రెడ్‌ల నుండి దాచబడ్డాయి, మీ ప్రొఫైల్ తెరుచుకోదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ของคุณถูกซ่อนจากทุกฟีด ผลการค้นหา และเธรด และโปรไฟล์ของคุณเปิดไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileriniz tüm akışlardan, arama sonuçlarından ve konuşmalardan gizlendi; profiliniz de açılmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дописи приховані з усіх стрічок, результатів пошуку та обговорень, а ваш профіль не відкривається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پوسٹس ہر فیڈ، سرچ نتیجے اور تھریڈ سے چھپی ہوئی ہیں، اور آپ کا پروفائل نہیں کھلتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng của bạn bị ẩn khỏi mọi bảng tin, kết quả tìm kiếm và chuỗi trả lời, và hồ sơ của bạn không truy cập được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帖子已从所有信息流、搜索结果和对话串中隐藏，你的个人主页也无法访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貼文已從所有動態、搜尋結果和討論串中隱藏，你的個人檔案也無法開啟。"
          }
        }
      }
    },
    "account.recovery.currentState.reversible": {
      "comment": "Current state: nothing has been destroyed yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُتلف شيء. والإلغاء يستعيد كل ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই নষ্ট হয়নি। বাতিল করলে সবকিছু ফিরে আসবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha destruït res. Si cancel·les, ho recuperes tot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nezničilo. Zrušením se vše obnoví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er blevet ødelagt. Hvis du annullerer, bliver det hele gendannet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde zerstört. Mit dem Abbrechen wird alles wiederhergestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν έχει καταστραφεί. Η ακύρωση τα επαναφέρει όλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been destroyed. Cancelling restores all of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha destruido nada. Al cancelar se restaura todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole tuhottu. Peruminen palauttaa kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été détruit. Annuler rétablit tout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נהרס. ביטול משחזר את הכול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी नष्ट नहीं हुआ है। रद्द करने पर सब बहाल हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije uništeno. Otkazivanjem se sve vraća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem semmisült meg. A visszavonás mindent visszaállít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dihancurkan. Membatalkan memulihkan semuanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato distrutto nulla. Annullando, torna tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されていません。取り消すと、すべて復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제되지 않았어요. 취소하면 모두 복원돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും നശിപ്പിച്ചിട്ടില്ല. റദ്ദാക്കിയാൽ എല്ലാം പുനഃസ്ഥാപിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dimusnahkan. Membatalkan memulihkan semuanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er ødelagt. Hvis du avbryter, gjenopprettes alt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets vernietigd. Annuleren herstelt alles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało zniszczone. Anulowanie przywraca wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi destruído. Cancelar restaura tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi destruído. Cancelar restaura tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu a fost distrus. Anularea restabilește totul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не уничтожено. Отмена вернёт всё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nebolo zničené. Zrušením sa všetko obnoví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har förstörts. Om du avbryter återställs allt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் அழிக்கப்படவில்லை. ரத்து செய்தால் அனைத்தும் மீளும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ నాశనం కాలేదు. రద్దు చేస్తే అంతా పునరుద్ధరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรถูกทำลาย การยกเลิกจะกู้คืนทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey yok edilmedi. İptal etmek hepsini geri yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не знищено. Скасування відновить усе."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی ختم نہیں ہوا۔ منسوخ کرنے سے سب بحال ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì bị phá hủy. Hủy xóa sẽ khôi phục tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何内容被销毁。取消后会全部恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何內容被銷毀。取消後即可全部恢復。"
          }
        }
      }
    },
    "account.recovery.currentState.scope": {
      "comment": "Current state: this is the only reachable screen, and why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء آخر في «معروف» يعمل ما دام هذا معلقًا — ولهذا فهذه هي الشاشة الوحيدة التي يمكنك الوصول إليها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অপেক্ষমাণ থাকা অবস্থায় Known-এর আর কিছুই কাজ করে না — তাই এটিই একমাত্র স্ক্রিন যা আপনি খুলতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre això estigui pendent, la resta de Known no funciona: per això aquesta és l'única pantalla a què pots accedir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud smazání čeká, nic jiného v aplikaci Known nefunguje – proto je to jediná obrazovka, na kterou se dostaneš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet andet på Known virker, mens dette er under behandling – derfor er det den eneste skærm, du kan komme til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Löschung aussteht, funktioniert nichts anderes auf Known – deshalb ist dies der einzige Bildschirm, den du erreichen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα άλλο στο Known δεν λειτουργεί όσο αυτό εκκρεμεί — γι' αυτό είναι η μόνη οθόνη που μπορείς να δεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else on Known works while this is pending — that is why this is the only screen you can reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada más en Known funciona mientras esto está pendiente; por eso esta es la única pantalla a la que puedes acceder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään muu Knownissa ei toimi, kun tämä on vireillä – siksi tämä on ainoa näkymä, johon pääset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’autre ne fonctionne sur Known tant que c’est en attente — c’est pourquoi c’est le seul écran accessible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר אחר ב-Known לא פועל כל עוד זה ממתין — לכן זה המסך היחיד שאפשר להגיע אליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लंबित रहते Known पर और कुछ काम नहीं करता — इसीलिए यही एकमात्र स्क्रीन है जहाँ आप पहुँच सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok je brisanje na čekanju, ništa drugo u aplikaciji Known ne radi — zato je ovo jedini zaslon do kojeg možeš doći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg ez függőben van, a Knownban semmi más nem működik – ezért ez az egyetlen elérhető képernyő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hal lain di Known yang berfungsi selama ini tertunda — itulah sebabnya ini satu-satunya layar yang bisa kamu buka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché è in sospeso, nient'altro su Known funziona: per questo è l'unica schermata che puoi raggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中は、Knownの他の機能は使えません。そのため、この画面だけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청이 대기 중인 동안에는 Known의 다른 기능을 쓸 수 없어요. 그래서 이 화면만 열 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് തീർപ്പാകുന്നതുവരെ Known-ൽ മറ്റൊന്നും പ്രവർത്തിക്കില്ല — അതുകൊണ്ടാണ് ഇത് മാത്രമാണ് നിങ്ങൾക്ക് തുറക്കാവുന്ന സ്ക്രീൻ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa lagi di Known berfungsi semasa ini belum selesai — itulah sebabnya ini satu-satunya skrin yang boleh anda capai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting annet på Known fungerer mens dette venter. Det er derfor dette er den eneste skjermen du kommer til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets anders op Known werkt zolang dit loopt. Daarom is dit het enige scherm dat je kunt bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic innego w Known nie działa, dopóki trwa to oczekiwanie — dlatego to jedyny ekran, do którego masz dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais no Known funciona enquanto isso estiver pendente. Por isso esta é a única tela que você pode acessar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais na Known funciona enquanto isto estiver pendente — por isso este é o único ecrã a que consegue aceder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic altceva pe Known nu funcționează cât timp ștergerea este în așteptare — de aceea acesta este singurul ecran la care ai acces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока удаление ожидает, остальные функции Known недоступны — поэтому открыт только этот экран."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým je odstránenie v pláne, nič iné na Known nefunguje — preto je toto jediná obrazovka, ktorú môžeš otvoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget annat på Known fungerar medan detta väntar – därför är det här den enda skärmen du kommer åt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நிலுவையில் இருக்கும்போது Known-இல் வேறெதுவும் இயங்காது — அதனால்தான் நீங்கள் அணுகக்கூடிய ஒரே திரை இதுவே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది పెండింగ్‌లో ఉన్నంత వరకు Knownలో మరేదీ పని చేయదు — అందుకే మీరు చేరగలిగే ఏకైక స్క్రీన్ ఇదే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่รออยู่ ส่วนอื่นๆ ของ Known จะใช้งานไม่ได้ นี่คือเหตุผลที่หน้านี้เป็นหน้าเดียวที่คุณเข้าถึงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem beklerken Known'da başka hiçbir şey çalışmaz; ulaşabildiğiniz tek ekranın bu olmasının nedeni budur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки це очікує, більше нічого в Known не працює — тому це єдиний екран, доступний вам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے زیر التوا ہونے تک Known پر اور کچھ کام نہیں کرتا — اسی لیے یہی واحد اسکرین ہے جس تک آپ پہنچ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì khác trên Known hoạt động khi việc này đang chờ — vì vậy đây là màn hình duy nhất bạn vào được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此状态下，Known 的其他功能都无法使用，所以这是你唯一能进入的页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在等待處理期間，Known 的其他功能都無法使用，所以這是你唯一能進入的畫面。"
          }
        }
      }
    },
    "account.recovery.signOut.hint": {
      "comment": "VoiceOver hint for signing out of a pending deletion.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغادر التطبيق. ويبقى الحذف مجدولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ থেকে বেরিয়ে যায়। মুছে ফেলা নির্ধারিতই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
