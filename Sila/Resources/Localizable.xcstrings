            "value": "אמור משהו עליו…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बारे में कुछ कहें…"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci nešto o njoj…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írj róla valamit…"
          }
        },
        "id": {
