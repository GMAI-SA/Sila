        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹാൻഡിലുകൾ 3–20 അക്ഷരങ്ങൾ, അക്കങ്ങൾ, അണ്ടർസ്കോറുകൾ ചേർന്നതാണ്."
