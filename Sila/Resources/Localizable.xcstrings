            "value": "ประเทศของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülkem"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моя країна"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرا ملک"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc gia của tôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的国家"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的國家"
          }
        }
      }
    },
    "composer.scope.myCountry.unavailableReason": {
      "comment": "Why my-country is unavailable before verification. Says where the flag comes from.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علم بلدك يأتي من توثيق الهوية. بعد توثيق هويتك، يمكنك فتح سلاسل لا يرد عليها إلا مواطنوك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেশের পতাকা পরিচয় যাচাই থেকে আসে। আইডি ভেরিফাই হলে আপনি এমন থ্রেড খুলতে পারবেন যেখানে শুধু আপনার দেশের মানুষ উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera del teu país prové de la verificació d'identitat. Quan el teu document estigui verificat, podràs obrir fils als quals només puguin respondre els teus compatriotes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvé země pochází z ověření totožnosti. Po ověření dokladu můžeš zakládat vlákna, na která odpoví jen tvoji krajané."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit landeflag kommer fra identitetsverificeringen. Når dit id er verificeret, kan du åbne tråde, som kun dine landsmænd kan svare på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Landesflagge stammt aus der Identitätsprüfung. Sobald dein Ausweis verifiziert ist, kannst du Threads eröffnen, auf die nur deine Landsleute antworten können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημαία της χώρας σου προέρχεται από την επαλήθευση ταυτότητας. Μόλις επαληθευτεί η ταυτότητά σου, μπορείς να ανοίγεις νήματα στα οποία απαντούν μόνο οι συμπατριώτες σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country flag comes from identity verification. Once your ID is verified, you can open threads only your compatriots can reply to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandera de tu país procede de la verificación de identidad. Cuando tu documento esté verificado, podrás abrir hilos a los que solo respondan tus compatriotas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maasi lippu tulee henkilöllisyyden vahvistuksesta. Kun henkilöllisyystodistuksesi on vahvistettu, voit aloittaa ketjuja, joihin vain maanmiehesi voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drapeau de votre pays provient de la vérification d’identité. Une fois votre pièce d’identité vérifiée, vous pourrez ouvrir des discussions auxquelles seuls vos compatriotes peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דגל המדינה שלך מגיע מאימות הזהות. אחרי שתעודת הזהות שלך תאומת, תוכל לפתוח שרשורים שרק בני ארצך יכולים להגיב להם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके देश का झंडा पहचान सत्यापन से आता है। आपकी ID सत्यापित होने के बाद आप ऐसे थ्रेड खोल सकेंगे जिन पर सिर्फ़ आपके हमवतन जवाब दे सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastava tvoje zemlje dolazi iz provjere identiteta. Kad ti se isprava potvrdi, moći ćeš otvarati niti na koje mogu odgovarati samo tvoji sunarodnjaci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az országzászlód a személyazonosság-hitelesítésből származik. Miután az azonosítód hitelesítve van, olyan szálakat nyithatsz, amelyekre csak honfitársaid válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negaramu berasal dari verifikasi identitas. Setelah identitasmu terverifikasi, kamu bisa membuka utas yang hanya bisa dibalas sesama warga negaramu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandiera del tuo paese deriva dalla verifica d'identità. Quando il tuo documento sarà verificato, potrai aprire discussioni a cui possono rispondere solo i tuoi connazionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国旗は本人確認によって決まります。IDが認証されると、同じ国の人だけが返信できるスレッドを開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가 깃발은 신원 인증에서 가져와요. 신분증이 인증되면 같은 나라 사람만 답글을 달 수 있는 스레드를 열 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാക ഐഡന്റിറ്റി പരിശോധനയിൽ നിന്നാണ് ലഭിക്കുന്നത്. ഐഡി പരിശോധിച്ചാൽ, നിങ്ങളുടെ നാട്ടുകാർക്ക് മാത്രം മറുപടി നൽകാവുന്ന ത്രെഡുകൾ തുടങ്ങാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendera negara anda datang daripada pengesahan identiti. Setelah ID anda disahkan, anda boleh membuka utas yang hanya boleh dibalas oleh rakan senegara anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Landsflagget ditt kommer fra identitetsverifiseringen. Når ID-en din er verifisert, kan du starte tråder som bare landsmenn kan svare på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je landvlag komt van de identiteitsverificatie. Zodra je identiteitsbewijs is geverifieerd, kun je threads openen waarop alleen je landgenoten kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaga Twojego kraju pochodzi z weryfikacji tożsamości. Gdy Twój dokument zostanie zweryfikowany, będziesz mógł zakładać wątki, w których odpowiadać mogą tylko rodacy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país vem da verificação de identidade. Depois que seu documento for verificado, você poderá abrir fios que só seus compatriotas podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeira do seu país vem da verificação de identidade. Quando o seu documento for verificado, poderá abrir conversas a que só os seus compatriotas podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steagul țării tale provine din verificarea identității. După ce actul îți este verificat, poți deschide conversații la care pot răspunde doar compatrioții tăi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Флаг вашей страны берётся из проверки личности. Когда ваш документ будет проверен, вы сможете начинать обсуждения, где отвечают только ваши соотечественники."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlajka tvojej krajiny pochádza z overenia totožnosti. Keď bude tvoj doklad overený, budeš môcť otvárať vlákna, na ktoré môžu odpovedať iba tvoji krajania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaggan för ditt land kommer från identitetsverifieringen. När ditt id är verifierat kan du öppna trådar som bara dina landsmän kan svara på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்டுக் கொடி அடையாளச் சரிபார்ப்பிலிருந்து வருகிறது. உங்கள் அடையாளம் சரிபார்க்கப்பட்டதும், உங்கள் நாட்டவர் மட்டுமே பதிலளிக்கக்கூடிய உரையாடல்களைத் தொடங்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దేశ జెండా గుర్తింపు ధృవీకరణ నుండి వస్తుంది. మీ ID ధృవీకరించబడిన తర్వాత, మీ దేశస్థులు మాత్రమే రిప్లై ఇవ్వగల థ్రెడ్‌లను ప్రారంభించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธงประเทศของคุณมาจากการยืนยันตัวตน เมื่อบัตรของคุณได้รับการยืนยัน คุณจะเปิดเธรดที่ให้เฉพาะคนร่วมชาติตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke bayrağınız kimlik doğrulamasından gelir. Kimliğiniz doğrulandığında, yalnızca vatandaşlarınızın yanıt verebileceği konuşmalar açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прапор вашої країни походить із верифікації особи. Щойно ваш документ буде верифіковано, ви зможете відкривати обговорення, де відповідати можуть лише ваші співвітчизники."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ملک کا جھنڈا شناخت کی تصدیق سے آتا ہے۔ آپ کا شناختی کارڈ تصدیق ہونے کے بعد آپ ایسے تھریڈ کھول سکیں گے جن کا جواب صرف آپ کے ہم وطن دے سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ quốc gia của bạn đến từ xác minh danh tính. Khi giấy tờ của bạn được xác minh, bạn có thể mở các chuỗi chỉ đồng hương mới trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的国家旗帜来自身份验证。证件通过验证后，你就可以发起只有同国人才能回复的对话串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的國家旗幟來自身分驗證。證件通過驗證後，你就能開啟只有同鄉能回覆的串文。"
          }
        }
      }
    },
