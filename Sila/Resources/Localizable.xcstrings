    "guest.room.refusal.roomNotLive.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُد عندما تبدأ — الغرف لا تُسجَّل أبدًا. ويستطيع الأعضاء طلب تذكير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ হলে আবার আসুন — রুম কখনও রেকর্ড করা হয় না। সদস্যরা রিমাইন্ডার চাইতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna quan sigui en directe: les sales no s'enregistren mai. Els membres poden demanar un recordatori."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrať se, až bude živě – místnosti se nikdy nenahrávají. Členové si mohou nechat připomenout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbage, når det er live – rum bliver aldrig optaget. Medlemmer kan bede om en påmindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm wieder, wenn er live ist – Räume werden nie aufgezeichnet. Mitglieder können sich erinnern lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλα ξανά όταν είναι ζωντανή — οι αίθουσες δεν ηχογραφούνται ποτέ. Τα μέλη μπορούν να ζητήσουν υπενθύμιση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back when it's live — rooms are never recorded. Members can ask for a reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve cuando esté en directo: las salas nunca se graban. Los miembros pueden pedir un recordatorio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa, kun se on live – huoneita ei koskaan tallenneta. Jäsenet voivat pyytää muistutuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez quand il sera en direct — les salons ne sont jamais enregistrés. Les membres peuvent demander un rappel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזור כשהוא בשידור — חדרים לעולם לא מוקלטים. חברים יכולים לבקש תזכורת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव होने पर लौटें — रूम कभी रिकॉर्ड नहीं होते। सदस्य रिमाइंडर माँग सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrati se kad bude uživo — sobe se nikada ne snimaju. Članovi mogu zatražiti podsjetnik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyere vissza, amikor élő – a szobákat soha nem rögzítjük. A tagok emlékeztetőt kérhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali saat sudah langsung — room tidak pernah direkam. Anggota bisa meminta pengingat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna quando è in diretta: le stanze non vengono mai registrate. I membri possono chiedere un promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブになったらまた来てください。ルームは録音されません。メンバーはリマインダーを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브가 시작되면 다시 오세요. 룸은 녹음되지 않아요. 멤버는 알림을 요청할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് ആകുമ്പോൾ തിരികെ വരൂ — റൂമുകൾ ഒരിക്കലും റെക്കോർഡ് ചെയ്യില്ല. അംഗങ്ങൾക്ക് ഓർമപ്പെടുത്തൽ ആവശ്യപ്പെടാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Datang semula apabila ia langsung — bilik tidak pernah dirakam. Ahli boleh meminta peringatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbake når det er live. Rom tas aldri opp. Medlemmer kan be om en påminnelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom terug als hij live is: rooms worden nooit opgenomen. Leden kunnen om een herinnering vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć, gdy ruszy na żywo — pokoje nigdy nie są nagrywane. Członkowie mogą poprosić o przypomnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte quando ela estiver ao vivo; as salas nunca são gravadas. Os membros podem pedir um lembrete."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte quando estiver em direto — as salas nunca são gravadas. Os membros podem pedir um lembrete."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Revino când este live — camerele nu sunt înregistrate niciodată. Membrii pot cere o reamintire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь, когда она начнётся: комнаты никогда не записываются. Участники могут попросить напоминание."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráť sa, keď bude naživo — miestnosti sa nikdy nenahrávajú. Členovia si môžu nastaviť pripomienku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tillbaka när det är live – rum spelas aldrig in. Medlemmar kan be om en påminnelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலை ஆனதும் வாருங்கள் — அறைகள் ஒருபோதும் பதிவு செய்யப்படுவதில்லை. உறுப்பினர்கள் நினைவூட்டல் கேட்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది లైవ్‌లోకి వచ్చాక రండి — రూమ్‌లు ఎప్పుడూ రికార్డ్ చేయబడవు. సభ్యులు రిమైండర్ అడగవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาเมื่อห้องเริ่ม ห้องไม่เคยถูกบันทึกเสียง สมาชิกขอให้เตือนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı olduğunda tekrar gelin; odalar asla kaydedilmez. Üyeler hatırlatma isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніться, коли вона буде наживо — кімнати ніколи не записуються. Учасники можуть попросити нагадування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب یہ لائیو ہو تب واپس آئیں — رومز کبھی ریکارڈ نہیں ہوتے۔ ارکان یاد دہانی مانگ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy quay lại khi phòng diễn ra — phòng không bao giờ được ghi âm. Thành viên có thể yêu cầu nhắc nhở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等它开始后再来，房间从不录音。成员可以设置提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始直播時再回來吧，聊天室絕不會被錄音。成員可以要求提醒。"
          }
        }
      }
    },
