    "rooms.link.unlisted.status": {
      "comment": "Status line on a linked room's card when nothing is known about the room yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «استمع» لتعرف إن كانت متاحة لك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য খোলা কি না দেখতে শুনুন-এ ট্যাপ করুন"
