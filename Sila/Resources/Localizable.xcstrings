    "rooms.mic.dropHint": {
      "comment": "What muting does.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الميكروفون. ولن يعود من في الغرفة يسمعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মাইক্রোফোন বন্ধ করে। রুম আর আপনাকে শুনতে পাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga el teu micròfon. La sala ja no et pot sentir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypne tvůj mikrofon. Místnost tě už neslyší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slukker din mikrofon. Rummet kan ikke længere høre dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet dein Mikrofon aus. Der Raum kann dich nicht mehr hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιεί το μικρόφωνό σου. Η αίθουσα δεν σε ακούει πια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns your microphone off. The room can no longer hear you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga tu micrófono. La sala ya no puede oírte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytkee mikrofonisi pois. Huone ei enää kuule sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe votre micro. Le salon ne peut plus vous entendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכבה את המיקרופון שלך. החדר כבר לא שומע אותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका माइक्रोफ़ोन बंद करता है। रूम अब आपको नहीं सुन सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključuje tvoj mikrofon. Soba te više ne čuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolja a mikrofonodat. A szoba már nem hall téged."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan mikrofonmu. Room tidak bisa lagi mendengarmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegne il tuo microfono. La stanza non può più sentirti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをオフにします。ルームにあなたの声が聞こえなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 꺼요. 룸에서 내 목소리가 더 이상 들리지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മൈക്രോഫോൺ ഓഫാക്കുന്നു. റൂമിന് ഇനി നിങ്ങളെ കേൾക്കാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan mikrofon anda. Bilik tidak lagi dapat mendengar anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår av mikrofonen din. Rommet kan ikke lenger høre deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je microfoon uit. De room kan je niet meer horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącza Twój mikrofon. Pokój przestaje Cię słyszeć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga seu microfone. A sala não ouve mais você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga o seu microfone. A sala deixa de o ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește microfonul. Camera nu te mai poate auzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключает ваш микрофон. Комната вас больше не слышит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypne tvoj mikrofón. Miestnosť ťa už nepočuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stänger av din mikrofon. Rummet kan inte längre höra dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மைக்ரோஃபோனை அணைக்கும். அறையால் இனி உங்களைக் கேட்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మైక్రోఫోన్‌ను ఆఫ్ చేస్తుంది. రూమ్‌కు ఇక మీరు వినిపించరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไมโครโฟนของคุณ ห้องจะไม่ได้ยินคุณอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonunuzu kapatır. Oda artık sizi duyamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимикає ваш мікрофон. Кімната більше не чує вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مائیکروفون بند کرتا ہے۔ روم آپ کو اب نہیں سن سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt micro của bạn. Phòng không còn nghe được bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭你的麦克风，房间将听不到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉你的麥克風。聊天室將聽不到你。"
          }
        }
      }
    },
