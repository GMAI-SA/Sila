    "feed.tab.international.hint": {
      "comment": "VoiceOver hint for the International tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المنشورات المفتوحة للحسابات الموثّقة حول العالم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্বজুড়ে ভেরিফায়েড অ্যাকাউন্টদের জন্য খোলা পোস্ট দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les publicacions obertes als comptes verificats de tot el món"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příspěvky otevřené ověřeným účtům po celém světě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opslag, der er åbne for verificerede konti verden over"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Beiträge, die für verifizierte Konten weltweit offen sind"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει αναρτήσεις ανοιχτές σε επαληθευμένους λογαριασμούς παγκοσμίως"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows posts open to verified accounts worldwide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra publicaciones abiertas a cuentas verificadas de todo el mundo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kaikkialla maailmassa vahvistetuille tileille avoimet julkaisut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les posts ouverts aux comptes vérifiés du monde entier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג פוסטים הפתוחים לחשבונות מאומתים בכל העולם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया भर के सत्यापित अकाउंट के लिए खुली पोस्ट दिखाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje objave otvorene potvrđenim računima diljem svijeta"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A világszerte hitelesített fiókok előtt nyitott bejegyzéseket mutatja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan postingan yang terbuka untuk akun terverifikasi di seluruh dunia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i post aperti agli account verificati di tutto il mondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界中の認証済みアカウントに開かれた投稿を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계 인증된 계정에 열린 게시물을 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോകമെമ്പാടുമുള്ള പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് തുറന്ന പോസ്റ്റുകൾ കാണിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaparkan siaran yang terbuka kepada akaun yang disahkan di seluruh dunia"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser innlegg åpne for verifiserte kontoer over hele verden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont berichten die openstaan voor geverifieerde accounts wereldwijd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wpisy otwarte dla zweryfikowanych kont na całym świecie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra posts abertos a contas verificadas do mundo todo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra publicações abertas a contas verificadas de todo o mundo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată postările deschise conturilor verificate din toată lumea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает посты, открытые для проверенных аккаунтов по всему миру"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí príspevky otvorené pre overené účty z celého sveta"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar inlägg öppna för verifierade konton över hela världen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலகெங்கும் உள்ள சரிபார்க்கப்பட்ட கணக்குகளுக்குத் திறந்த இடுகைகளைக் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రపంచవ్యాప్తంగా ధృవీకరించబడిన ఖాతాలకు తెరిచి ఉన్న పోస్ట్‌లను చూపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงโพสต์ที่เปิดให้บัญชีที่ยืนยันตัวตนแล้วทั่วโลก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya genelinde doğrulanmış hesaplara açık gönderileri gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує дописи, відкриті для верифікованих облікових записів з усього світу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دنیا بھر کے تصدیق شدہ اکاؤنٹس کے لیے کھلی پوسٹس دکھاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bài đăng mở cho tài khoản đã xác minh trên toàn thế giới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示向全球已验证账户开放的帖子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示開放給全球已驗證帳號的貼文"
