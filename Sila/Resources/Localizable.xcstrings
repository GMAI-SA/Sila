            "state": "translated",
            "value": "仅限模拟器：使用占位图片继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限模擬器：以預留圖片繼續"
          }
        }
      }
    },
