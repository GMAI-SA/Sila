    "people.picker.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع أشخاصًا أو دعهم يتابعونك ليظهروا هنا. ما زال بإمكانك البحث بالاسم أو المعرّف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানুষকে ফলো করুন, বা তাদের আপনাকে ফলো করতে দিন, তাহলে তারা এখানে আসবে। তবু নাম বা হ্যান্ডেল দিয়ে খুঁজতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix persones, o deixa que et segueixin, i apareixeran aquí. Encara pots cercar per nom o identificador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj lidi, nebo nech lidi sledovat tebe, a objeví se tady. Stále můžeš hledat podle jména nebo handlu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg folk, eller lad dem følge dig, så dukker de op her. Du kan stadig søge efter navn eller handle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge Personen oder lass sie dir folgen, dann erscheinen sie hier. Du kannst weiterhin nach Name oder Handle suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολούθησε άτομα ή άσε τα να σε ακολουθήσουν και θα εμφανιστούν εδώ. Μπορείς πάντα να αναζητήσεις με όνομα ή handle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow people, or let them follow you, and they'll appear here. You can still search by name or handle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a personas, o deja que te sigan, y aparecerán aquí. Aún puedes buscar por nombre o identificador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa ihmisiä tai anna heidän seurata sinua, niin he näkyvät täällä. Voit yhä hakea nimellä tai käyttäjätunnuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des personnes, ou laissez-les vous suivre, et elles apparaîtront ici. Vous pouvez toujours chercher par nom ou identifiant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחרי אנשים, או תן להם לעקוב אחריך, והם יופיעו כאן. אפשר עדיין לחפש לפי שם או שם משתמש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगों को फ़ॉलो करें, या उन्हें खुद को फ़ॉलो करने दें, और वे यहाँ दिखेंगे। आप फिर भी नाम या हैंडल से खोज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati ljude ili neka oni prate tebe, pa će se pojaviti ovdje. I dalje možeš tražiti po imenu ili handleu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövess embereket, vagy hagyd, hogy kövessenek, és itt megjelennek. Név vagy @név alapján továbbra is kereshetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti orang, atau biarkan mereka mengikutimu, dan mereka akan muncul di sini. Kamu tetap bisa mencari berdasarkan nama atau handle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui le persone, o lascia che ti seguano, e compariranno qui. Puoi comunque cercare per nome o handle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かをフォローするか、フォローされると、ここに表示されます。名前やハンドルでの検索もできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들을 팔로우하거나 그들이 나를 팔로우하면 여기에 표시돼요. 이름이나 핸들로 검색할 수도 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആളുകളെ ഫോളോ ചെയ്യുക, അല്ലെങ്കിൽ അവർ നിങ്ങളെ ഫോളോ ചെയ്യട്ടെ, അവർ ഇവിടെ വരും. പേരോ ഹാൻഡിലോ ഉപയോഗിച്ച് ഇപ്പോഴും തിരയാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut orang, atau biarkan mereka mengikut anda, dan mereka akan muncul di sini. Anda masih boleh mencari dengan nama atau nama pengendali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg folk, eller la dem følge deg, så vises de her. Du kan fortsatt søke etter navn eller brukernavn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg mensen, of laat ze jou volgen, en ze verschijnen hier. Je kunt nog steeds zoeken op naam of handle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj osoby lub pozwól im obserwować Ciebie, a pojawią się tutaj. Nadal możesz szukać po imieniu lub uchwycie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga pessoas, ou deixe que elas sigam você, e elas aparecerão aqui. Você ainda pode buscar por nome ou @usuário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga pessoas, ou deixe que o sigam, e aparecerão aqui. Pode sempre pesquisar por nome ou identificador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește oameni sau lasă-i să te urmărească și vor apărea aici. Tot poți căuta după nume sau handle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишитесь на людей или дайте им подписаться на вас, и они появятся здесь. Искать по имени или @имени всё равно можно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj ľudí alebo nech oni sledujú teba a objavia sa tu. Stále môžeš hľadať podľa mena alebo používateľského mena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ personer, eller låt dem följa dig, så visas de här. Du kan fortfarande söka efter namn eller användarnamn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்களைப் பின்தொடருங்கள் அல்லது அவர்கள் உங்களைப் பின்தொடரட்டும், அவர்கள் இங்கே தோன்றுவார்கள். பெயர் அல்லது ஹேண்டில் மூலம் இன்னும் தேடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తులను ఫాలో అవ్వండి, లేదా వారు మిమ్మల్ని ఫాలో అవ్వనివ్వండి, వారు ఇక్కడ కనిపిస్తారు. పేరు లేదా హ్యాండిల్‌తో ఇంకా వెతకవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามผู้คน หรือให้พวกเขาติดตามคุณ แล้วจะปรากฏที่นี่ คุณยังค้นหาด้วยชื่อหรือแฮนเดิลได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanları takip edin veya sizi takip etmelerine izin verin, burada görünürler. Yine de ad veya kullanıcı adıyla arayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться на людей або дозвольте їм підписатися на вас, і вони з’являться тут. Ви все ще можете шукати за іменем або @іменем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوگوں کو فالو کریں، یا انہیں اپنے آپ کو فالو کرنے دیں، تو وہ یہاں نظر آئیں گے۔ آپ پھر بھی نام یا ہینڈل سے تلاش کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy theo dõi mọi người, hoặc để họ theo dõi bạn, và họ sẽ xuất hiện ở đây. Bạn vẫn có thể tìm theo tên hoặc tên người dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注他人，或让他们关注你，他们就会出现在这里。你仍可按姓名或用户名搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤別人，或讓別人追蹤你，他們就會出現在這裡。你仍可依名稱或代號搜尋。"
          }
        }
      }
    },
