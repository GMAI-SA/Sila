    "vouch.list.withdraw.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال الوسم فورًا. السحب قبل أن ينشر أي شيء لا يُحتسب عليك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাগটি সঙ্গে সঙ্গে সরে যায়। তিনি কিছু পোস্ট করার আগে প্রত্যাহার করলে আপনার বিরুদ্ধে কিছু ধরা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etiqueta desapareix a l'instant. Retirar abans que publiquin res mai es té en compte en contra teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek zmizí okamžitě. Stažení dřív, než něco napíší, se ti nikdy nepočítá k tíži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærket forsvinder med det samme. At trække tilbage, før de har slået noget op, bliver aldrig holdt imod dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tag verschwindet sofort. Ein Zurückziehen, bevor die Person etwas postet, wird dir nie angelastet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ετικέτα αφαιρείται αμέσως. Η ανάκληση πριν δημοσιεύσουν οτιδήποτε δεν μετράει ποτέ εις βάρος σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag comes off at once. Withdrawing before they post anything is never held against you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta se quita al instante. Retirar antes de que publique nada nunca se te tiene en cuenta en contra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkki poistuu heti. Peruminen ennen kuin he julkaisevat mitään ei koskaan lasketa sinua vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étiquette disparaît aussitôt. Retirer avant qu’elle ne publie quoi que ce soit ne vous est jamais reproché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התג יורד מיד. משיכה לפני שהם מפרסמים משהו אף פעם לא נזקפת לחובתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग तुरंत हट जाता है। उनके कुछ पोस्ट करने से पहले वापस लेना कभी आपके ख़िलाफ़ नहीं गिना जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaka se skida odmah. Povlačenje prije nego išta objave nikada se ne uzima protiv tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címke azonnal lekerül. A visszavonás, mielőtt bármit írna, soha nem róható fel neked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag langsung dilepas. Menarik sebelum mereka memposting apa pun tidak pernah dianggap merugikanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etichetta viene tolta subito. Ritirare prima che pubblichi qualcosa non conta mai contro di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはすぐに外れます。相手が何かを投稿する前に取り下げた場合、不利になることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그가 즉시 사라져요. 상대방이 게시하기 전에 철회하는 것은 절대 불이익이 되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടാഗ് ഉടൻ നീങ്ങും. അവർ ഒന്നും പോസ്റ്റ് ചെയ്യുന്നതിന് മുമ്പ് പിൻവലിച്ചാൽ അത് ഒരിക്കലും നിങ്ങൾക്കെതിരെ ഉപയോഗിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teg itu ditanggalkan serta-merta. Menarik balik sebelum mereka menyiar apa-apa tidak pernah dipersalahkan kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merket forsvinner umiddelbart. Å trekke tilbake før de har publisert noe, holdes aldri mot deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tag verdwijnt meteen. Intrekken voordat ze iets plaatsen wordt je nooit aangerekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczenie znika od razu. Wycofanie przed opublikowaniem czegokolwiek przez tę osobę nigdy nie jest stawiane Ci za zarzut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta sai na hora. Retirar antes de a pessoa postar qualquer coisa nunca é usado contra você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta sai de imediato. Retirar antes de a pessoa publicar alguma coisa nunca conta contra si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eticheta dispare imediat. Retragerea înainte ca persoana să posteze ceva nu este niciodată ținută împotriva ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка исчезнет сразу. Отзыв до того, как человек что-либо опубликует, никогда не ставится вам в вину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Značka sa odstráni okamžite. Stiahnutie skôr, než niečo zverejní, sa ti nikdy nezráta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten försvinner direkt. Att återta innan de publicerat något läggs aldrig dig till last."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறி உடனே நீங்கிவிடும். அவர்கள் எதையும் இடுகையிடும் முன் திரும்பப் பெற்றால் அது உங்களுக்கு எதிராக ஒருபோதும் கணக்கில் கொள்ளப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్యాగ్ వెంటనే తొలగిపోతుంది. వారు ఏదైనా పోస్ట్ చేయకముందే ఉపసంహరిస్తే అది మీపై ఎప్పుడూ ప్రభావం చూపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้ายจะถูกนำออกทันที การถอนก่อนที่เขาจะโพสต์อะไรจะไม่ส่งผลเสียต่อคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket hemen kalkar. Bir şey paylaşmadan önce geri çekmek asla aleyhinize kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка зникає одразу. Відкликання до того, як людина щось опублікує, ніколи не ставиться вам у провину."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگ فوراً ہٹ جاتا ہے۔ ان کے کچھ پوسٹ کرنے سے پہلے واپس لینا کبھی آپ کے خلاف نہیں گنا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ được gỡ ngay lập tức. Rút lại trước khi họ đăng gì không bao giờ bị tính lỗi với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签会立即撤下。在对方发布任何内容之前撤回，绝不会对你产生不利影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤會立即移除。在對方發文之前撤回，絕不會對你不利。"
          }
        }
      }
    },
    "vouch.list.withdraw.title": {
      "comment": "%@ is the person's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب تزكيتك لـ ⁦@%@⁩؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@-এর জন্য আপনার ভাউচ প্রত্যাহার করবেন?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar el teu aval a @%@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout ručení za @%@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk din garanti for @%@ tilbage?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bürgschaft für @%@ zurückziehen?"
          }
        },
        "el": {
