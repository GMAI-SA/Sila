    "notifications.kind.threadReply.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يرد أحد في عمق سلسلة بدأتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শুরু করা থ্রেডের গভীরে কেউ উত্তর দিলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú respon més endins d'un fil que has iniciat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někdo odpoví hlouběji ve vláknu, které jsi založil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen svarer dybere nede i en tråd, du startede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand tiefer in einem Thread antwortet, den du begonnen hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος απαντά βαθύτερα σε νήμα που ξεκίνησες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone replies deeper in a thread you started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien responde más abajo en un hilo que iniciaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku vastaa syvemmällä aloittamassasi ketjussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un répond plus loin dans une discussion que vous avez lancée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו מגיב עמוק יותר בשרשור שפתחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके शुरू किए थ्रेड में और नीचे जवाब दे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad netko odgovori dublje u niti koju si započeo/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor valaki mélyebben válaszol egy általad indított szálban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat seseorang membalas lebih dalam di utas yang kamu mulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando qualcuno risponde più in profondità in un thread che hai iniziato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが始めたスレッドの深い階層に誰かが返信したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내가 시작한 스레드의 더 깊은 곳에 답글을 달 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തുടങ്ങിയ ത്രെഡിൽ ആഴത്തിൽ ആരെങ്കിലും മറുപടി നൽകുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seseorang membalas lebih dalam dalam utas yang anda mulakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen svarer dypere i en tråd du startet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer iemand dieper in een thread reageert die jij hebt gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś odpowiada głębiej w wątku, który zacząłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém responde mais fundo em um fio que você começou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém responde mais abaixo numa conversa que iniciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când cineva răspunde mai în profunzime într-o conversație începută de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кто-то отвечает глубже в ветке, которую вы начали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekto odpovie hlbšie vo vlákne, ktoré si začal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon svarar djupare i en tråd du startat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தொடங்கிய உரையாடலில் ஆழமாக யாராவது பதிலளிக்கும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ప్రారంభించిన థ్రెడ్‌లో లోతుగా ఎవరైనా రిప్లై ఇచ్చినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนตอบกลับลึกลงไปในเธรดที่คุณเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri başlattığınız bir konuşmanın daha derininde yanıt verdiğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли хтось відповідає глибше в обговоренні, яке ви почали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی آپ کے شروع کیے ہوئے تھریڈ میں گہرائی میں جواب دے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó trả lời sâu hơn trong một chuỗi bạn bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在你发起的对话串更深处回复时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在你發起的串文深處回覆時。"
          }
        }
      }
    },
