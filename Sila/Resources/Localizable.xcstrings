    "guest.room.refusal.guestsNotAllowed.detail": {
      "comment": "What that means, and what the guest can do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستماع إلى هذه الغرفة للأعضاء فقط حاليًا. انضم إلى «معروف» أو سجّل الدخول لتستمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন শুধু সদস্যরা এই রুম শুনতে পারেন। শুনতে Known-এ যোগ দিন বা সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix només els membres poden escoltar aquesta sala. Uneix-te a Known o inicia la sessió per escoltar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto místnost mohou teď poslouchat jen členové. Připoj se k aplikaci Known nebo se přihlas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige nu kan kun medlemmer lytte til dette rum. Deltag i Known eller log ind for at lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Raum können im Moment nur Mitglieder zuhören. Tritt Known bei oder melde dich an, um zuzuhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προς το παρόν μόνο τα μέλη μπορούν να ακούσουν αυτή την αίθουσα. Γράψου στο Known ή συνδέσου για να ακούσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only members can listen to this room right now. Join Known or sign in to listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo solo los miembros pueden escuchar esta sala. Únete a Known o inicia sesión para escuchar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain jäsenet voivat kuunnella tätä huonetta juuri nyt. Liity Knowniin tai kirjaudu sisään kuunnellaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les membres peuvent écouter ce salon pour le moment. Rejoignez Known ou connectez-vous pour écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע רק חברים יכולים להאזין לחדר הזה. הצטרף ל-Known או התחבר כדי להאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी इस रूम को केवल सदस्य सुन सकते हैं। सुनने के लिए Known से जुड़ें या साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovu sobu trenutačno mogu slušati samo članovi. Pridruži se aplikaciji Known ili se prijavi da slušaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a szobát jelenleg csak tagok hallgathatják. A hallgatáshoz csatlakozz a Knownhoz, vagy jelentkezz be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini hanya anggota yang bisa mendengarkan room ini. Gabung Known atau masuk untuk mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento solo i membri possono ascoltare questa stanza. Iscriviti a Known o accedi per ascoltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在このルームを聴けるのはメンバーだけです。聴くにはKnownに参加するかサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 멤버만 이 룸을 들을 수 있어요. 듣으려면 Known에 가입하거나 로그인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ അംഗങ്ങൾക്ക് മാത്രമേ ഈ റൂം കേൾക്കാനാകൂ. കേൾക്കാൻ Known-ൽ ചേരുക അല്ലെങ്കിൽ സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ahli boleh mendengar bilik ini sekarang. Sertai Known atau log masuk untuk mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkurat nå kan bare medlemmer lytte til dette rommet. Bli med på Known eller logg inn for å lytte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen leden kunnen nu naar deze room luisteren. Meld je aan bij Known of log in om te luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie tego pokoju mogą słuchać tylko członkowie. Dołącz do Known lub zaloguj się, aby słuchać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento, só membros podem ouvir esta sala. Entre no Known ou faça login para ouvir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento, só os membros podem ouvir esta sala. Entre na Known ou inicie sessão para ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum doar membrii pot asculta această cameră. Alătură-te Known sau autentifică-te pentru a asculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас эту комнату могут слушать только участники. Присоединитесь к Known или войдите, чтобы слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto miestnosť môžu práve teraz počúvať iba členovia. Pripoj sa k Known alebo sa prihlás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu kan bara medlemmar lyssna på det här rummet. Gå med i Known eller logga in för att lyssna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உறுப்பினர்கள் மட்டுமே இந்த அறையைக் கேட்கலாம். கேட்க Known-இல் சேருங்கள் அல்லது உள்நுழையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం సభ్యులు మాత్రమే ఈ రూమ్‌ను వినగలరు. వినడానికి Knownలో చేరండి లేదా సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เฉพาะสมาชิกเท่านั้นที่ฟังห้องนี้ได้ เข้าร่วม Known หรือลงชื่อเข้าใช้เพื่อฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu odayı şu anda yalnızca üyeler dinleyebilir. Dinlemek için Known'a katılın veya giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі цю кімнату можуть слухати лише учасники. Приєднайтеся до Known або увійдіть, щоб слухати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی اس روم کو صرف ارکان سن سکتے ہیں۔ سننے کے لیے Known میں شامل ہوں یا سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chỉ thành viên mới nghe được phòng này. Hãy tham gia Known hoặc đăng nhập để nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有成员可以收听此房间。加入 Known 或登录后即可收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有成員能收聽此聊天室。請加入 Known 或登入後收聽。"
          }
        }
      }
    },
    "guest.room.refusal.guestsNotAllowed.title": {
      "comment": "Why a guest is not listening to a room (contract v31).",
      "extractionState": "manual",
      "localizations": {
