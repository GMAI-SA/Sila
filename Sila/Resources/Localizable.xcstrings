        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên tắc đã thay đổi trong lúc bạn đọc — vui lòng đọc lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你阅读期间准则有更新，请重新阅读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你閱讀期間社群規範已更新，請重新閱讀"
