    "profile.savedPosts.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشورات التي حفظتها. لا يراها أحد غيرك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বুকমার্ক করা পোস্ট। শুধু আপনি দেখতে পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicacions que has desat als marcadors. Només tu les pots veure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příspěvky, které jsi uložil do záložek. Vidíš je jen ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag, du har sat bogmærke ved. Kun du kan se dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge, die du mit einem Lesezeichen versehen hast. Nur du kannst sie sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναρτήσεις που έβαλες σε σελιδοδείκτες. Μόνο εσύ μπορείς να τις δεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts you bookmarked. Only you can see them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicaciones que guardaste como marcador. Solo tú puedes verlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjanmerkitsemäsi julkaisut. Vain sinä näet ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts que vous avez mis en favoris. Vous seul pouvez les voir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים ששמרת בסימניות. רק אתה יכול לראות אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बुकमार्क की हुई पोस्ट। केवल आप इन्हें देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objave koje si spremio/la. Vidiš ih samo ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvjelzőzött bejegyzéseid. Csak te látod őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan yang kamu markah. Hanya kamu yang bisa melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post che hai messo nei segnalibri. Solo tu puoi vederli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークした投稿です。あなただけに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크한 게시물이에요. 나만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ബുക്ക്മാർക്ക് ചെയ്ത പോസ്റ്റുകൾ. നിങ്ങൾക്ക് മാത്രമേ കാണാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran yang anda tandakan. Hanya anda yang boleh melihatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innlegg du har bokmerket. Bare du kan se dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten die je een bladwijzer hebt gegeven. Alleen jij kunt ze zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy, które dodałeś do zakładek. Widzisz je tylko Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts que você salvou. Só você pode vê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações que guardou. Só você as vê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postările pe care le-ai marcat. Doar tu le poți vedea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты, которые вы добавили в закладки. Видны только вам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky, ktoré si uložil do záložiek. Vidíš ich iba ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlägg du satt bokmärke på. Bara du kan se dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் புக்மார்க் செய்த இடுகைகள். உங்களுக்கு மட்டுமே தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు బుక్‌మార్క్ చేసిన పోస్ట్‌లు. మీకు మాత్రమే కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ที่คุณบุ๊กมาร์กไว้ เห็นได้เฉพาะคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer imi eklediğiniz gönderiler. Yalnızca siz görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дописи, які ви додали до закладок. Їх бачите лише ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ پوسٹس جنہیں آپ نے بک مارک کیا۔ صرف آپ انہیں دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài đăng bạn đã đánh dấu. Chỉ bạn thấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你加了书签的帖子，仅你自己可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你加入書籤的貼文，只有你看得到。"
          }
        }
      }
    },
