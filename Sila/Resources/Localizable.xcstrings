    "onboarding.people.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أشخاص موثّقون يكتبون عمّا اخترته. تابع من شئت — يمكنك إلغاء المتابعة في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া বিষয় নিয়ে লেখেন এমন ভেরিফায়েড মানুষ। যত খুশি ফলো করুন — যেকোনো সময় আনফলো করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Persones verificades que escriuen sobre el que has triat. Segueix-ne tantes com vulguis; en qualsevol moment les pots deixar de seguir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření lidé píšící o tom, co sis vybral. Sleduj, kolik chceš – kdykoli to můžeš zrušit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificerede folk, der skriver om det, du valgte. Følg så mange, du vil – du kan til enhver tid stoppe med at følge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifizierte Menschen, die über deine Auswahl schreiben. Folge so vielen, wie du möchtest – du kannst jederzeit entfolgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαληθευμένα άτομα που γράφουν για όσα επέλεξες. Ακολούθησε όσα θέλεις — μπορείς να σταματήσεις οποτεδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified people writing about what you chose. Follow as many as you like — you can unfollow any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas verificadas que escriben sobre lo que elegiste. Sigue a cuantas quieras; puedes dejar de seguirlas cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistettuja ihmisiä, jotka kirjoittavat valitsemistasi aiheista. Seuraa niin monia kuin haluat – voit lopettaa seuraamisen milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des personnes vérifiées qui écrivent sur ce que vous avez choisi. Suivez-en autant que vous voulez — vous pourrez vous désabonner à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנשים מאומתים שכותבים על מה שבחרת. עקוב אחרי כמה שתרצה — אפשר להפסיק לעקוב בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने विषयों पर लिखने वाले सत्यापित लोग। जितनों को चाहें फ़ॉलो करें — कभी भी अनफ़ॉलो कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrđeni ljudi koji pišu o onome što si odabrao/la. Prati koliko želiš — možeš prestati pratiti bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitelesített emberek, akik a választott témákról írnak. Annyit követhetsz, amennyit szeretnél – bármikor visszavonhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang terverifikasi yang menulis tentang pilihanmu. Ikuti sebanyak yang kamu mau — kamu bisa berhenti mengikuti kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone verificate che scrivono di ciò che hai scelto. Segui quante ne vuoi: puoi smettere quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ分野について書いている認証済みの人たちです。好きなだけフォローできます。フォローはいつでも解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 고른 주제에 대해 글을 쓰는 인증된 사람들이에요. 원하는 만큼 팔로우하세요. 언제든 팔로우를 취소할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുത്ത കാര്യങ്ങളെക്കുറിച്ച് എഴുതുന്ന പരിശോധിച്ച ആളുകൾ. ഇഷ്ടംപോലെ ഫോളോ ചെയ്യാം — എപ്പോൾ വേണമെങ്കിലും അൺഫോളോ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang disahkan menulis tentang apa yang anda pilih. Ikut seramai yang anda suka — anda boleh berhenti mengikut bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiserte folk som skriver om det du valgte. Følg så mange du vil. Du kan slutte å følge når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerde mensen die schrijven over wat je hebt gekozen. Volg er zoveel als je wilt: je kunt altijd ontvolgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowane osoby piszące o tym, co wybrałeś. Obserwuj, ile chcesz — w każdej chwili możesz przestać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas verificadas que escrevem sobre o que você escolheu. Siga quantas quiser; você pode deixar de seguir a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas verificadas a escrever sobre o que escolheu. Siga quantas quiser — pode deixar de seguir em qualquer altura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oameni verificați care scriu despre ce ai ales. Urmărește câți vrei — poți renunța oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенные люди, пишущие о выбранном вами. Подписывайтесь на сколько угодно — отписаться можно в любой момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overení ľudia, ktorí píšu o tom, čo si vybral. Sleduj, koľko chceš — kedykoľvek môžeš sledovanie zrušiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifierade personer som skriver om det du valde. Följ så många du vill – du kan sluta följa när som helst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்தவற்றைப் பற்றி எழுதும் சரிபார்க்கப்பட்ட மக்கள். விரும்பும் அளவு பின்தொடருங்கள் — எப்போது வேண்டுமானாலும் பின்தொடர்வதை நிறுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న వాటి గురించి రాసే ధృవీకరించబడిన వ్యక్తులు. మీకు నచ్చినంత మందిని ఫాలో అవ్వండి — ఎప్పుడైనా అన్‌ఫాలో చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนที่ยืนยันตัวตนแล้วซึ่งเขียนเรื่องที่คุณเลือก ติดตามกี่คนก็ได้ และเลิกติดตามได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz konularda yazan doğrulanmış kişiler. İstediğiniz kadar takip edin; istediğiniz zaman takibi bırakabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верифіковані люди, що пишуть про обране вами. Підписуйтеся на скількох завгодно — відписатися можна будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق شدہ لوگ جو آپ کے چنے ہوئے موضوعات پر لکھتے ہیں۔ جتنوں کو چاہیں فالو کریں — کسی بھی وقت ان فالو کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người đã xác minh viết về điều bạn chọn. Theo dõi bao nhiêu tùy thích — bạn có thể bỏ theo dõi bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写你所选主题的已验证用户。想关注多少都可以，随时可以取消关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫你所選主題的已驗證用戶。想追蹤多少都可以，隨時都能取消追蹤。"
          }
        }
      }
    },
