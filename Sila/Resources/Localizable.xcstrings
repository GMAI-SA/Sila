    "feed.tab.myCountry.hint": {
      "comment": "VoiceOver hint for the My Country tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض منشورات الحسابات الموثّقة في بلدك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দেশের ভেরিফায়েড অ্যাকাউন্টদের পোস্ট দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les publicacions dels comptes verificats del teu país"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příspěvky z ověřených účtů v tvé zemi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser opslag fra verificerede konti i dit land"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Beiträge verifizierter Konten aus deinem Land"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει αναρτήσεις από επαληθευμένους λογαριασμούς της χώρας σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows posts from verified accounts in your country"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra publicaciones de cuentas verificadas de tu país"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää maasi vahvistettujen tilien julkaisut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les posts des comptes vérifiés de votre pays"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג פוסטים מחשבונות מאומתים במדינה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके देश के सत्यापित अकाउंट की पोस्ट दिखाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje objave potvrđenih računa iz tvoje zemlje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az országodban hitelesített fiókok bejegyzéseit mutatja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan postingan dari akun terverifikasi di negaramu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i post degli account verificati del tuo paese"
          }
