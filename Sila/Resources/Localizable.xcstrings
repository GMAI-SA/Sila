    "notifications.kind.followAccepted.detail": {
      "comment": "What the accepted-request kind covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب خاص قبل طلبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো প্রাইভেট অ্যাকাউন্ট আপনাকে ঢুকতে দিলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte privat que et deixa entrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromý účet tě vpustil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat konto, der lukker dig ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein privates Konto nimmt dich auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ιδιωτικός λογαριασμός σε δέχεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private account letting you in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta privada que te admite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityinen tili päästää sinut sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte privé qui vous accepte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון פרטי שמקבל אותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई प्राइवेट अकाउंट आपको अंदर आने दे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatni račun koji te prima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy privát fiók beenged."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun privat menerimamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account privato che ti accetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開アカウントがあなたを承認したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 계정이 나를 승인했을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പ്രൈവറ്റ് അക്കൗണ്ട് നിങ്ങളെ ചേർക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun peribadi membenarkan anda masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat konto som slipper deg inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een privéaccount dat je toelaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto prywatne Cię przyjmuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta privada aceitando você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta privada a aceitá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cont privat te primește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый аккаунт принимает вашу заявку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromný účet ťa prijal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett privat konto som släpper in dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தனிப்பட்ட கணக்கு உங்களை உள்ளே சேர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ప్రైవేట్ ఖాతా మిమ్మల్ని లోపలికి అనుమతించినప్పుడు."
