    "verification.withdraw.action": {
      "comment": "Button on the verification wall and the under-review screen while a document submission waits for review (contract v25).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الطلب وابدأ من جديد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যাহার করে আবার শুরু করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira i torna a començar"
          }
