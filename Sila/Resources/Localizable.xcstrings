    "communities.join.approval.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب الناس، ويقرّر المشرف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানুষ অনুরোধ করে, আর একজন অ্যাডমিন সিদ্ধান্ত নেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La gent ho sol·licita i un administrador decideix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé o vstup žádají a správce rozhoduje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk anmoder, og en admin afgør det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen fragen an, und ein Admin entscheidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άλλοι κάνουν αίτημα και ένας διαχειριστής αποφασίζει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People ask, and an admin decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gente lo solicita y un administrador decide."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmiset pyytävät, ja ylläpitäjä päättää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gens demandent, et un admin décide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנשים מבקשים, ומנהל מחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोग अनुरोध करते हैं, और एडमिन तय करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudi traže, a administrator odlučuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emberek kérnek, egy adminisztrátor dönt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang mengajukan, dan admin memutuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone chiedono e un admin decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加を希望する人が申請し、管理者が決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 요청하면 관리자가 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആളുകൾ അഭ്യർഥിക്കും, ഒരു അഡ്മിൻ തീരുമാനിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang memohon, dan admin memutuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk spør, og en admin avgjør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen vragen toegang en een beheerder beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ludzie proszą o dołączenie, a administrator decyduje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas pedem, e um administrador decide."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas pedem e um administrador decide."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oamenii cer, iar un administrator decide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди подают заявку, а администратор решает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ľudia požiadajú a správca rozhodne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk ansöker, och en admin avgör."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்கள் கேட்கிறார்கள், நிர்வாகி முடிவு செய்கிறார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రజలు అడుగుతారు, అడ్మిన్ నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนขอเข้าร่วม และแอดมินเป็นผู้ตัดสิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar ister, bir yönetici karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди просяться, а адміністратор вирішує."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوگ درخواست کرتے ہیں، اور ایڈمن فیصلہ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người xin tham gia, và quản trị viên quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人们提出申请，由管理员决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大家提出申請，由管理員決定。"
          }
        }
      }
    },
