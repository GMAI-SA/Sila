    "vouch.refusal.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك تزكية أحد حاليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে আপনি কারও জন্য ভাউচ করতে পারবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix no pots avalar ningú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď za nikoho ručit nemůžeš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke gå i god for nogen lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst im Moment für niemanden bürgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείς να εγγυηθείς για κανέναν αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't vouch for anyone right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes avalar a nadie ahora mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi taata ketään juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez vous porter garant de personne pour le moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינך יכול לערוב לאף אחד כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी किसी के लिए वाउच नहीं कर सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno ne možeš jamčiti ni za koga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg nem kezeskedhetsz senkiért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tidak bisa menjamin siapa pun saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non puoi garantire per nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、誰も保証できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 누구도 보증할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിങ്ങൾക്ക് ആർക്കും വൗച്ച് ചെയ്യാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak boleh menjamin sesiapa sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke garantere for noen akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu voor niemand instaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nie możesz za nikogo poręczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode avalizar ninguém agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não pode dar aval a ninguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum nu poți garanta pentru nimeni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас вы не можете ни за кого ручаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve teraz nemôžeš za nikoho ručiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte intyga för någon just nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்களால் யாருக்கும் உறுதியளிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం మీరు ఎవరికీ హామీ ఇవ్వలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณรับรองใครไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kimseye kefil olamazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз ви не можете ні за кого ручатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ابھی کسی کی ضمانت نہیں دے سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện bạn không thể bảo chứng cho ai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前无法为任何人担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前無法為任何人擔保。"
          }
        }
      }
    },
