    "account.handle.keep.hint": {
      "comment": "VoiceOver hint for 'Keep @user… for now'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتابع بالمعرّف الذي أُعطيته. يمكنك تغييره لاحقًا من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে দেওয়া হ্যান্ডেল নিয়েই এগিয়ে যায়। পরে সেটিংসে বদলাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua amb l'identificador que se't va assignar. El pots canviar més endavant a Ajustos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračuje s přiděleným handlem. Později ho změníš v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsætter med det handle, du har fået. Du kan ændre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht mit dem Handle weiter, das du erhalten hast. Du kannst es später in den Einstellungen ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζει με το handle που σου δόθηκε. Μπορείς να το αλλάξεις αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes on with the handle you were given. You can change it later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa con el identificador que se te asignó. Puedes cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkaa saamallasi käyttäjätunnuksella. Voit vaihtaa sen myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue avec l’identifiant qui vous a été attribué. Vous pourrez le changer plus tard dans les Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממשיך עם שם המשתמש שקיבלת. אפשר לשנות אותו בהמשך בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो हैंडल आपको मिला था उसी के साथ आगे बढ़ता है। आप इसे बाद में सेटिंग्स में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavlja s handleom koji si dobio/la. Možeš ga promijeniti kasnije u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatja a kapott @névvel. Később a Beállításokban módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjut dengan handle yang kamu terima. Kamu bisa mengubahnya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosegui con l'handle che ti è stato assegnato. Potrai cambiarlo più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当てられたハンドルのまま進みます。あとで設定から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부여된 핸들로 계속해요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭിച്ച ഹാൻഡിലുമായി തുടരുന്നു. ക്രമീകരണങ്ങളിൽ പിന്നീട് മാറ്റാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan dengan nama pengendali yang diberikan kepada anda. Anda boleh menukarnya kemudian dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Går videre med brukernavnet du fikk. Du kan endre det senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat verder met de handle die je hebt gekregen. Je kunt hem later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuje z przyznanym uchwytem. Możesz go zmienić później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua com o @usuário que você recebeu. Você pode mudar depois em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua com o identificador que lhe foi atribuído. Pode alterá-lo mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă cu handle-ul primit. Îl poți schimba mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить с выданным вам именем. Позже его можно изменить в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračuje s pridelenou používateľským menom. Neskôr ho môžeš zmeniť v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter med användarnamnet du fick. Du kan ändra det senare i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு வழங்கப்பட்ட ஹேண்டிலுடன் தொடரும். பிறகு அமைப்புகளில் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఇచ్చిన హ్యాండిల్‌తో కొనసాగుతుంది. తర్వాత సెట్టింగ్‌లలో మార్చుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปต่อด้วยแฮนเดิลที่ได้รับ คุณเปลี่ยนภายหลังได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size verilen kullanıcı adıyla devam eder. Daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжує з @ім’ям, яке вам дали. Пізніше його можна змінити в Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیے گئے ہینڈل کے ساتھ آگے بڑھتا ہے۔ آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục với tên người dùng được cấp. Bạn có thể đổi sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用分配给你的用户名。之后可以在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用你獲得的代號。之後可在「設定」中更改。"
          }
        }
      }
    },
    "account.handle.reason.invalid": {
      "comment": "Under the handle field: breaks the 3–20 a–z 0–9 _ rule.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 3 إلى 20 حرفًا لاتينيًا (a–z) أو أرقامًا أو شرطة سفلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৩–২০টি অক্ষর (a–z), সংখ্যা বা আন্ডারস্কোর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 20 lletres (a–z), números o guions baixos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 písmen (a–z), číslic nebo podtržítek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 bogstaver (a–z), tal eller understregninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 Buchstaben (a–z), Ziffern oder Unterstriche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 γράμματα (a–z), αριθμοί ή κάτω παύλες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 letters (a–z), numbers or underscores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 20 letras (a–z), números o guiones bajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 kirjainta (a–z), numeroa tai alaviivaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 20 lettres (a–z), chiffres ou tirets bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 אותיות (a–z), ספרות או קווים תחתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 अक्षर (a–z), संख्याएँ या अंडरस्कोर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "3–20 slova (a–z), brojeva ili podcrta."
          }
        },
