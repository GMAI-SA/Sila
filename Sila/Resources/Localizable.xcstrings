    "rooms.empty.search.subtitle": {
      "comment": "No matching rooms. %@ is the query, inside quote marks. Says what is searched.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد غرفة مباشرة أو مجدولة تطابق «%@». البحث يشمل العناوين والمواضيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”-এর সাথে লাইভ বা নির্ধারিত কিছু মেলেনি। শিরোনাম ও বিষয়ের মধ্যে খোঁজা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Res en directe ni programat coincideix amb «%@». Es cerca per títols i temes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic živého ani naplánovaného neodpovídá „%@“. Hledá se v názvech a tématech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet live eller planlagt matcher “%@”. Der søges i titler og emner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Laufendes oder Geplantes passt zu „%@“. Durchsucht werden Titel und Themen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα ζωντανό ή προγραμματισμένο δεν ταιριάζει με «%@». Αναζητούνται οι τίτλοι και τα θέματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing live or scheduled matches “%@”. Titles and topics are what get searched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en directo ni programado coincide con «%@». Se buscan los títulos y los temas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään livenä tai ajastettuna ei täsmää hakuun “%@”. Haku kohdistuu otsikoihin ja aiheisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun salon en direct ou programmé ne correspond à « %@ ». La recherche porte sur les titres et les sujets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר בשידור או מתוזמן לא תואם ל-״%@״. מחפשים בכותרות ובנושאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” से कुछ भी लाइव या शेड्यूल मेल नहीं खाता। शीर्षक और टॉपिक में खोजा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa uživo ni zakazano ne odgovara upitu „%@”. Pretražuju se naslovi i teme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen élő vagy ütemezett szoba sem egyezik ezzel: „%@”. A címek és témák között keresünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang langsung atau terjadwal yang cocok dengan “%@”. Judul dan topik yang dicari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla in diretta o in programma corrisponde a “%@”. Si cercano titoli e argomenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致するライブ中または予定のルームはありません。検索の対象はタイトルとトピックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와(과) 일치하는 라이브 또는 예약된 룸이 없어요. 제목과 주제를 검색해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” എന്നതിനോട് ഒത്തുപോകുന്ന ലൈവോ ഷെഡ്യൂൾ ചെയ്തതോ ആയ ഒന്നുമില്ല. തലക്കെട്ടുകളും വിഷയങ്ങളുമാണ് തിരയുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada yang langsung atau dijadualkan sepadan dengan “%@”. Tajuk dan topik yang dicari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting som er live eller planlagt, samsvarer med «%@». Det er titler og emner som søkes i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets live of gepland komt overeen met “%@”. Er wordt gezocht op titels en onderwerpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na żywo ani zaplanowanego nie pasuje do „%@”. Przeszukiwane są tytuły i tematy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ao vivo ou agendado corresponde a “%@”. A busca considera títulos e temas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em direto ou agendado corresponde a “%@”. A pesquisa incide nos títulos e tópicos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic live sau programat nu se potrivește cu „%@”. Se caută în titluri și subiecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из идущего или запланированного не совпало с «%@». Поиск идёт по названиям и темам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič naživo ani naplánované nezodpovedá „%@“. Hľadá sa v názvoch a témach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget live eller schemalagt matchar ”%@”. Det är titlar och ämnen som söks."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” க்குப் பொருந்தும் நேரலை அல்லது திட்டமிட்டவை இல்லை. தலைப்புகளும் பொருள்களும் மட்டுமே தேடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”కు సరిపోయే లైవ్ లేదా షెడ్యూల్ చేసినవి ఏవీ లేవు. శీర్షికలు, అంశాలే వెతకబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีห้องสดหรือที่กำหนดเวลาไว้ที่ตรงกับ “%@” ระบบค้นหาจากชื่อและหัวข้อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ile eşleşen canlı veya planlanmış bir şey yok. Başlıklar ve konular aranır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо наживо чи заплановане не відповідає «%@». Шукаються назви й теми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” سے کوئی لائیو یا طے شدہ روم نہیں ملتا۔ عنوانات اور موضوعات تلاش کیے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có phòng nào đang diễn ra hoặc đã lên lịch khớp với “%@”. Tìm kiếm áp dụng cho tiêu đề và chủ đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有进行中或已安排的房间与“%@”匹配。搜索的是标题和话题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有直播中或已排程的內容符合「%@」。搜尋範圍是標題和主題。"
          }
        }
      }
    },
