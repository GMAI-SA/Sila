    "vouch.refusal.firstSlot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يوثّق أول من زكّيته هويته قبل أن تزكّي مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার ভাউচ করার আগে আপনার প্রথম ভাউচ পাওয়া ব্যক্তিকে তাঁর পরিচয় ভেরিফাই করতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera persona que avalis ha de verificar la seva identitat abans que puguis tornar a avalar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé první ručení musí ověřit svou totožnost, než budeš moci ručit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din første garanti skal verificere sin identitet, før du kan gå i god for flere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine erste Bürgschaft muss ihre Identität verifizieren, bevor du erneut bürgen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρώτη σου εγγύηση πρέπει να επαληθεύσει την ταυτότητά της πριν μπορέσεις να εγγυηθείς ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first vouch has to verify their identity before you can vouch again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primer avalado tiene que verificar su identidad antes de que puedas avalar de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäisen takaamasi on vahvistettava henkilöllisyytensä, ennen kuin voit taata uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre première caution doit vérifier son identité avant que vous puissiez vous porter garant à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערבות הראשונה שלך חייבת לאמת את זהותה לפני שתוכל לערוב שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पहला वाउच अपनी पहचान सत्यापित करे, तभी आप फिर वाउच कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje prvo jamstvo mora potvrditi identitet prije nego što možeš ponovno jamčiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első kezességednek hitelesítenie kell a személyazonosságát, mielőtt újra kezeskedhetnél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang pertama yang kamu jamin harus memverifikasi identitasnya sebelum kamu bisa menjamin lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prima garanzia deve verificare la propria identità prima che tu possa garantire di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に保証した人が本人確認をするまで、次の保証はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 보증하려면 첫 번째로 보증한 사람이 신원을 인증해야 해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടും വൗച്ച് ചെയ്യുന്നതിന് മുമ്പ് നിങ്ങളുടെ ആദ്യ വൗച്ച് ലഭിച്ചയാൾ ഐഡന്റിറ്റി വെരിഫൈ ചെയ്യണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang pertama yang anda jamin mesti mengesahkan identitinya sebelum anda boleh menjamin lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første du garanterte for, må verifisere identiteten sin før du kan garantere igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerste garantie moet de identiteit verifiëren voordat je opnieuw kunt instaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja pierwsza poręczona osoba musi zweryfikować tożsamość, zanim będziesz mógł poręczyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira pessoa que você avalizou precisa verificar a identidade antes que você possa avalizar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu primeiro aval tem de verificar a identidade antes de poder dar outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ta garanție trebuie să-și verifice identitatea înainte să mai poți garanta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш первый подопечный должен пройти проверку личности, прежде чем вы сможете поручиться снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba, za ktorú si ručil prvýkrát, si musí overiť totožnosť, skôr než budeš môcť ručiť znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den första du intygade för måste verifiera sin identitet innan du kan intyga igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் உறுதியளிக்கும் முன், உங்கள் முதல் உறுதிமொழி பெற்றவர் தன் அடையாளத்தைச் சரிபார்க்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మళ్లీ హామీ ఇవ్వడానికి ముందు, మీ మొదటి హామీ వ్యక్తి తన గుర్తింపును ధృవీకరించుకోవాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนแรกที่คุณรับรองต้องยืนยันตัวตนก่อน คุณจึงรับรองคนต่อไปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kefil olabilmeniz için ilk kefil olduğunuz kişinin kimliğini doğrulaması gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Першій людині, за яку ви поручилися, потрібно верифікувати особу, перш ніж ви зможете ручатися знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ ضمانت دینے سے پہلے آپ کے پہلے ضمانت یافتہ کو اپنی شناخت کی تصدیق کرنی ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người đầu tiên bạn bảo chứng phải xác minh danh tính trước khi bạn bảo chứng tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的第一个被担保人必须先验证身份，你才能再次担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的第一位被擔保者必須先驗證身分，你才能再次擔保。"
          }
        }
      }
    },
