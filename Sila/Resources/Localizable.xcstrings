        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a number, or remove the one on file."
          }
        }
      }
    },
    "account.phone.error.notE164": {
      "comment": "Validation when the number is not E.164. %@ is an example number, which is never translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الصيغة الدولية، تبدأ بعلامة زائد ثم رمز الدولة — مثل %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use international format, starting with a plus and a country code — for example %@."
          }
        }
      }
    },
    "account.phone.field.hint": {
