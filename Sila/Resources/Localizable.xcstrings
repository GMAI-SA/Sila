    "rooms.guests.allow.private": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب المضيف خاص، لذلك لا يمكن للزوار الاستماع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোস্টের অ্যাকাউন্ট প্রাইভেট, তাই অতিথিরা শুনতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El compte de l'amfitrió és privat, així que els convidats no poden escoltar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet hostitele je soukromý, takže hosté poslouchat nemohou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værtens konto er privat, så gæster kan ikke lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto des Hosts ist privat, daher können Gäste nicht zuhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός του οικοδεσπότη είναι ιδιωτικός, γι' αυτό οι επισκέπτες δεν μπορούν να ακούσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host's account is private, so guests can't listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta del anfitrión es privada, así que los invitados no pueden escuchar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isännän tili on yksityinen, joten vieraat eivät voi kuunnella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte de l’animateur est privé, les invités ne peuvent donc pas écouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון של המארח פרטי, ולכן אורחים לא יכולים להאזין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्ट का अकाउंट प्राइवेट है, इसलिए मेहमान नहीं सुन सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun domaćina je privatan pa gosti ne mogu slušati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A házigazda fiókja privát, ezért a vendégek nem hallgathatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun host privat, jadi tamu tidak bisa mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'account dell'host è privato, quindi gli ospiti non possono ascoltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストのアカウントが非公開のため、ゲストは聴けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트의 계정이 비공개라서 게스트는 들을 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹോസ്റ്റിന്റെ അക്കൗണ്ട് പ്രൈവറ്റ് ആണ്, അതിനാൽ അതിഥികൾക്ക് കേൾക്കാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun hos ini peribadi, jadi tetamu tidak boleh mendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertens konto er privat, så gjester kan ikke lytte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het account van de host is privé, dus gasten kunnen niet luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto gospodarza jest prywatne, więc goście nie mogą słuchać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do anfitrião é privada, então visitantes não podem ouvir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do anfitrião é privada, por isso os convidados não podem ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul gazdei este privat, deci invitații nu pot asculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт ведущего закрытый, поэтому гости не могут слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet hostiteľa je súkromný, takže hostia nemôžu počúvať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värdens konto är privat, så gäster kan inte lyssna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடத்துநரின் கணக்கு தனிப்பட்டது, எனவே விருந்தினர்கள் கேட்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోస్ట్ ఖాతా ప్రైవేట్, కాబట్టి అతిథులు వినలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของเจ้าของห้องเป็นส่วนตัว ผู้เยี่ยมชมจึงฟังไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucunun hesabı gizli, bu yüzden misafirler dinleyemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис ведучого приватний, тому гості не можуть слухати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میزبان کا اکاؤنٹ نجی ہے، اس لیے مہمان نہیں سن سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của chủ phòng là riêng tư, nên khách không thể nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人的账户是私密的，所以访客无法收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人的帳號為私人帳號，因此訪客無法收聽。"
          }
        }
      }
