    "notifications.settings.toggle.hint": {
      "comment": "VoiceOver hint for one switch. %@ is the kind's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أو يخفي %@ في قائمة إشعاراتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিজ্ঞপ্তির তালিকায় %@ দেখায় বা লুকায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o amaga %@ a la llista de notificacions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí nebo skryje v seznamu upozornění: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser eller skjuler %@ på din notifikationsliste"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt oder verbirgt %@ in deiner Mitteilungsliste"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει ή κρύβει: %@ στη λίστα ειδοποιήσεών σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows or hides %@ in your notifications list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta %@ en tu lista de notificaciones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää tai piilottaa kohteen %@ ilmoituslistallasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque %@ dans votre liste de notifications"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג או מסתיר את %@ ברשימת ההתראות שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सूचनाओं की सूची में %@ दिखाता या छिपाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje ili skriva: %@ na tvom popisu obavijesti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti vagy elrejti ezt az értesítéslistádon: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan atau menyembunyikan %@ di daftar notifikasimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nasconde %@ nell'elenco delle notifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知リストで%@を表示または非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 목록에서 %@을(를) 표시하거나 숨겨요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അറിയിപ്പ് പട്ടികയിൽ %@ കാണിക്കുകയോ മറയ്ക്കുകയോ ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan atau menyembunyikan %@ dalam senarai pemberitahuan anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser eller skjuler %@ i varsellisten din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont of verbergt %@ in je meldingenlijst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje lub ukrywa na liście powiadomień: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta %@ na sua lista de notificações"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta %@ na sua lista de notificações"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată sau ascunde %@ în lista ta de notificări"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает или скрывает в списке уведомлений: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí alebo skryje %@ v zozname upozornení"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar eller döljer %@ i din aviseringslista"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அறிவிப்புப் பட்டியலில் %@ ஐக் காட்டும் அல்லது மறைக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నోటిఫికేషన్‌ల జాబితాలో %@ను చూపుతుంది లేదా దాచుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
