        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık konuşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тепер може говорити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ اب بول سکتے ہیں۔"
