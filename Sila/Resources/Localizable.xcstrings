    "error.smsUnavailable": {
      "comment": "503 sms_unavailable (contract v28): there is no SMS provider yet, so no code can be texted. Email and password always work.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرموز عبر الرسائل النصية غير متاحة بعد. استخدم بريدك الإلكتروني وكلمة المرور بدلًا من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেক্সট মেসেজে কোড এখনও পাওয়া যায় না। বরং ইমেইল ও পাসওয়ার্ড ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els codis per missatge de text encara no estan disponibles. Fes servir el correu i la contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódy textovou zprávou zatím nejsou dostupné. Použij místo toho e-mail a heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder via sms er ikke tilgængelige endnu. Brug i stedet din e-mail og adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes per SMS sind noch nicht verfügbar. Verwende stattdessen E-Mail und Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κωδικοί με μήνυμα SMS δεν είναι ακόμα διαθέσιμοι. Χρησιμοποίησε το email και τον κωδικό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes by text message aren't available yet. Use your email and password instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos por SMS aún no están disponibles. Usa tu correo y contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstiviestikoodit eivät ole vielä käytettävissä. Käytä sen sijaan sähköpostia ja salasanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes par SMS ne sont pas encore disponibles. Utilisez plutôt votre e-mail et votre mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודים בהודעת טקסט עדיין לא זמינים. השתמש בדוא״ל ובסיסמה שלך במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट मैसेज से कोड अभी उपलब्ध नहीं हैं। इसके बजाय अपने ईमेल और पासवर्ड का इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodovi putem SMS-a još nisu dostupni. Umjesto toga koristi e-poštu i lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az SMS-ben küldött kódok még nem érhetők el. Használd inkább az e-mail-címedet és a jelszavadat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode lewat pesan teks belum tersedia. Pakai email dan kata sandimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici via SMS non sono ancora disponibili. Usa invece email e password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートメッセージによるコードはまだ利用できません。代わりにメールとパスワードを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 메시지 코드는 아직 사용할 수 없어요. 대신 이메일과 비밀번호를 사용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടെക്സ്റ്റ് സന്ദേശം വഴിയുള്ള കോഡുകൾ ഇതുവരെ ലഭ്യമല്ല. പകരം ഇമെയിലും പാസ്‌വേഡും ഉപയോഗിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod melalui mesej teks belum tersedia. Gunakan emel dan kata laluan anda sebagai ganti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder på tekstmelding er ikke tilgjengelige ennå. Bruk e-post og passord i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes per sms zijn nog niet beschikbaar. Gebruik in plaats daarvan je e-mailadres en wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kody SMS-em nie są jeszcze dostępne. Użyj e-maila i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos por mensagem de texto ainda não estão disponíveis. Use seu e-mail e senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos por SMS ainda não estão disponíveis. Use o seu email e palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codurile prin SMS nu sunt încă disponibile. Folosește e-mailul și parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коды по SMS пока недоступны. Используйте почту и пароль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódy cez textovú správu zatiaľ nie sú dostupné. Použi radšej e-mail a heslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder via sms är inte tillgängliga än. Använd e-post och lösenord i stället."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறுஞ்செய்தி மூலம் குறியீடுகள் இன்னும் கிடைக்கவில்லை. அதற்குப் பதிலாக மின்னஞ்சல், கடவுச்சொல்லைப் பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టెక్స్ట్ సందేశం ద్వారా కోడ్‌లు ఇంకా అందుబాటులో లేవు. బదులుగా మీ ఈమెయిల్, పాస్‌వర్డ్ వాడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรหัสทางข้อความ ใช้อีเมลและรหัสผ่านแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa mesajla kod gönderimi henüz kullanılamıyor. Bunun yerine e-postanızı ve şifrenizi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коди в текстових повідомленнях поки недоступні. Використайте натомість пошту й пароль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیکسٹ میسج کے ذریعے کوڈ ابھی دستیاب نہیں۔ اس کے بجائے اپنی ای میل اور پاس ورڈ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã qua tin nhắn chưa khả dụng. Hãy dùng email và mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持短信验证码。请改用邮箱和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡訊驗證碼尚未開放，請改用電子郵件和密碼。"
          }
        }
      }
