        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Raum können im Moment nur Mitglieder zuhören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προς το παρόν μόνο τα μέλη μπορούν να ακούσουν αυτή την αίθουσα."
