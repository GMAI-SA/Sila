          "stringUnit": {
            "state": "translated",
            "value": "আপনার মুখ দেখানো লাইভ ক্যামেরা, মাথা ঘোরালে ভরে ওঠা একটি বৃত্তসহ"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Càmera en directe mostrant la teva cara, amb un anell que s'omple a mesura que gires el cap"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý pohled fotoaparátu na tvůj obličej s kruhem, který se plní, jak otáčíš hlavu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Levende kamerabillede af dit ansigt med en ring, der fyldes, mens du drejer hovedet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Kamera mit deinem Gesicht und einem Ring, der sich beim Drehen des Kopfes füllt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζωντανή κάμερα που δείχνει το πρόσωπό σου, με δακτύλιο που γεμίζει καθώς γυρνάς το κεφάλι"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live camera showing your face, with a ring that fills as you turn your head"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara en vivo que muestra tu rostro, con un anillo que se llena al girar la cabeza"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-kamera, jossa kasvosi ja rengas, joka täyttyy, kun käännät päätäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil photo en direct montrant votre visage, avec un anneau qui se remplit quand vous tournez la tête"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלמה חיה שמראה את הפנים שלך, עם טבעת שמתמלאת בזמן שאתה מסובב את הראש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चेहरे का लाइव कैमरा, जिसमें सिर घुमाने पर भरती रिंग दिखती है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera uživo prikazuje tvoje lice, s prstenom koji se puni dok okrećeš glavu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élő kamerakép az arcodról, egy gyűrűvel, amely a fejfordítással telik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera langsung menampakkan wajahmu, dengan cincin yang terisi saat kamu memutar kepala"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera dal vivo che mostra il tuo volto, con un anello che si riempie mentre giri la testa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔を映すライブカメラ映像。頭を回すとリングが埋まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴을 보여 주는 라이브 카메라. 고개를 돌리면 링이 채워져요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മുഖം കാണിക്കുന്ന ലൈവ് ക്യാമറ, തല തിരിക്കുമ്പോൾ നിറയുന്ന ഒരു വളയത്തോടെ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera langsung menunjukkan wajah anda, dengan cincin yang terisi semasa anda memusingkan kepala"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktebilde av ansiktet ditt, med en ring som fylles mens du snur hodet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live camerabeeld van je gezicht, met een ring die zich vult terwijl je je hoofd draait"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz z aparatu na żywo z Twoją twarzą i okręgiem, który wypełnia się, gdy obracasz głowę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera ao vivo mostrando seu rosto, com um anel que se preenche conforme você gira a cabeça"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmara em direto a mostrar o seu rosto, com um anel que enche à medida que vira a cabeça"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră live care îți arată fața, cu un inel ce se umple pe măsură ce îți întorci capul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живое изображение с камеры с вашим лицом и кольцом, которое заполняется при повороте головы"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý pohľad fotoaparátu na tvoju tvár s prstencom, ktorý sa plní, ako otáčaš hlavu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levande kamera som visar ditt ansikte, med en ring som fylls när du vrider på huvudet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலையைத் திருப்பும்போது நிரம்பும் வளையத்துடன் உங்கள் முகத்தைக் காட்டும் நேரடிக் கேமரா"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ముఖాన్ని చూపే లైవ్ కెమెరా, మీరు తల తిప్పేకొద్దీ నిండే వలయంతో"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องสดแสดงใบหน้าของคุณ พร้อมวงแหวนที่เต็มขึ้นเมื่อคุณหันศีรษะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzünüzü gösteren canlı kamera; başınızı çevirdikçe dolan bir halka"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера наживо показує ваше обличчя, з кільцем, яке заповнюється, коли ви повертаєте голову"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے چہرے کا لائیو کیمرا منظر، ایک دائرے کے ساتھ جو سر گھمانے پر بھرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera trực tiếp hiển thị khuôn mặt của bạn, với một vòng tròn đầy dần khi bạn xoay đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你面部的实时相机画面，转动头部时圆环会逐渐填满"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你臉部的即時相機畫面，圓環會隨著你轉頭而填滿"
          }
        }
      }
    },
