    "account.export.download.hint": {
      "comment": "VoiceOver hint for the download button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلب نسخة من كل ما يحتفظ به «معروف» عنك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known আপনার সম্পর্কে যা রাখে তার একটি কপি আনে"
          }
        },
        "ca": {
