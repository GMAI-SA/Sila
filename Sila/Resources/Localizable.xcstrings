    "rooms.host.stageFull": {
      "comment": "Refusal when the stage has as many speakers as it will hold.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنصة ممتلئة. انقل أحدهم إلى المستمعين أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মঞ্চ পূর্ণ। আগে কাউকে শ্রোতাদের মধ্যে সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'escenari és ple. Passa primer algú als oients."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pódium je plné. Nejdřív někoho přesuň k posluchačům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen er fuld. Flyt først nogen til lytterne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bühne ist voll. Verschiebe zuerst jemanden zu den Zuhörern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σκηνή είναι γεμάτη. Μετακίνησε πρώτα κάποιον στους ακροατές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stage is full. Move somebody to listeners first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escenario está lleno. Pasa antes a alguien a oyentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava on täynnä. Siirrä ensin joku kuuntelijoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène est pleine. Déplacez d’abord quelqu’un vers les auditeurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבמה מלאה. העבר קודם מישהו למאזינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेज भरा है। पहले किसी को श्रोताओं में भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozornica je puna. Prvo nekoga premjesti među slušatelje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A színpad megtelt. Előbb helyezz át valakit a hallgatók közé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panggung penuh. Pindahkan seseorang ke pendengar dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il palco è pieno. Prima sposta qualcuno tra gli ascoltatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージが満員です。先に誰かを聴く側に移してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무대가 가득 찼어요. 먼저 누군가를 청취자로 옮기세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്റ്റേജ് നിറഞ്ഞു. ആദ്യം ആരെയെങ്കിലും കേൾവിക്കാരിലേക്ക് മാറ്റുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentas penuh. Pindahkan seseorang ke pendengar dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen er full. Flytt noen til lyttere først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het podium is vol. Verplaats eerst iemand naar de luisteraars."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scena jest pełna. Najpierw przenieś kogoś do słuchaczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O palco está cheio. Mova antes alguém para os ouvintes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O palco está cheio. Mova primeiro alguém para os ouvintes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scena este plină. Mută mai întâi pe cineva printre ascultători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена заполнена. Сначала переведите кого-нибудь в слушатели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pódium je plné. Najprv niekoho presuň medzi poslucháčov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen är full. Flytta först någon till lyssnarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேடை நிரம்பிவிட்டது. முதலில் ஒருவரைக் கேட்பவர்களுக்கு நகர்த்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేదిక నిండిపోయింది. ముందుగా ఒకరిని శ్రోతలకు తరలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวทีเต็มแล้ว ย้ายใครสักคนไปเป็นผู้ฟังก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahne dolu. Önce birini dinleyicilere taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена заповнена. Спершу переведіть когось до слухачів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹیج بھرا ہوا ہے۔ پہلے کسی کو سننے والوں میں منتقل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sân khấu đã đầy. Hãy chuyển ai đó về người nghe trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发言台已满。请先把某人移到听众席。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舞台已滿。請先將某人移到收聽者。"
          }
        }
      }
    },
