    "messages.empty.inbox.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المحادثات التي تقبلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার গ্রহণ করা কথোপকথন এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les converses que acceptis apareixen aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverzace, které přijmeš, se zobrazí zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtaler, du accepterer, vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen, die du annimmst, erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνομιλίες που αποδέχεσαι εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations you accept appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones que aceptes aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksymäsi keskustelut näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations que vous acceptez apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיחות שאתה מקבל מופיעות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्वीकार की हुई बातचीतें यहाँ दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razgovori koje prihvatiš pojavljuju se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elfogadott beszélgetések itt jelennek meg."
