        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon bjuder in dig till ett slutet rum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது உங்களை மூடிய அறைக்கு அழைக்கும்போது."
