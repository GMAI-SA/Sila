        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escuchar para ver si está abierta para ti"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Kuuntele nähdäksesi, onko se avoin sinulle"
