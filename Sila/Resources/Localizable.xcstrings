    "composer.error.invalidScope": {
      "comment": "Refusal when the chosen audience is not allowed for this post.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجمهور غير متاح لهذا المنشور. اختر جمهورًا آخر وأعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোস্টের জন্য ওই শ্রোতা পাওয়া যাচ্ছে না। অন্য একটি বেছে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta audiència no està disponible per a aquesta publicació. Tria'n una altra i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto publikum není pro tento příspěvek dostupné. Vyber jiné a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den målgruppe er ikke tilgængelig for dette opslag. Vælg en anden, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zielgruppe ist für diesen Beitrag nicht verfügbar. Wähle eine andere und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το κοινό δεν είναι διαθέσιμο για αυτή την ανάρτηση. Επίλεξε άλλο και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That audience isn't available for this post. Pick another and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa audiencia no está disponible para esta publicación. Elige otra e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä yleisö ei ole käytettävissä tälle julkaisulle. Valitse toinen ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette audience n’est pas disponible pour ce post. Choisissez-en une autre et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקהל הזה לא זמין לפוסט הזה. בחר קהל אחר ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पोस्ट के लिए वह ऑडियंस उपलब्ध नहीं है। कोई और चुनें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta publika nije dostupna za ovu objavu. Odaberi drugu i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a közönség nem érhető el ennél a bejegyzésnél. Válassz másikat, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiens itu tidak tersedia untuk postingan ini. Pilih yang lain lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo pubblico non è disponibile per questo post. Scegline un altro e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投稿では、その公開範囲は選べません。別の範囲を選んで、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시물에는 해당 공개 범위를 사용할 수 없어요. 다른 범위를 선택하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പോസ്റ്റിന് ആ പ്രേക്ഷകർ ലഭ്യമല്ല. മറ്റൊന്ന് തിരഞ്ഞെടുത്ത് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Khalayak itu tidak tersedia untuk siaran ini. Pilih yang lain dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne målgruppen er ikke tilgjengelig for dette innlegget. Velg en annen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat publiek is niet beschikbaar voor dit bericht. Kies een ander en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta grupa odbiorców nie jest dostępna dla tego wpisu. Wybierz inną i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse público não está disponível para este post. Escolha outro e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este público não está disponível para esta publicação. Escolha outro e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest public nu este disponibil pentru această postare. Alege altul și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта аудитория недоступна для данного поста. Выберите другую и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto publikum nie je pre tento príspevok dostupné. Vyber iné a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den målgruppen är inte tillgänglig för det här inlägget. Välj en annan och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இடுகைக்கு அந்தப் பார்வையாளர்கள் கிடைக்கவில்லை. வேறொன்றைத் தேர்ந்தெடுத்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పోస్ట్‌కు ఆ ప్రేక్షకులు అందుబాటులో లేరు. మరొకటి ఎంచుకుని మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลุ่มผู้ชมนี้ใช้กับโพสต์นี้ไม่ได้ เลือกกลุ่มอื่นแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitle bu gönderi için kullanılamıyor. Başka birini seçip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця аудиторія недоступна для цього допису. Виберіть іншу й спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ناظرین اس پوسٹ کے لیے دستیاب نہیں۔ کوئی اور چنیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối tượng này không khả dụng cho bài đăng này. Hãy chọn đối tượng khác và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此帖子无法发给该受众。请另选一个后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此貼文無法使用該對象範圍，請選擇其他範圍後再試一次。"
          }
        }
      }
    },
    "composer.error.unverified": {
      "comment": "Refusal when an unverified account tries to post. Reading is open to everyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشر متاح للموثّقين فقط. القراءة متاحة للجميع في «معروف» — أكمل توثيق هويتك لتتمكن من النشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভেরিফায়েড মানুষ পোস্ট করতে পারে। Known সবাই পড়তে পারে — কথা বলতে পরিচয় যাচাই শেষ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només les persones verificades poden publicar. Tothom pot llegir Known; acaba la verificació d'identitat per parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Psát mohou jen ověření lidé. Known je čitelná pro všechny – dokonči ověření totožnosti, abys mohl mluvit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun verificerede mennesker kan slå op. Alle kan læse Known – gør din identitetsverificering færdig for at tage ordet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verifizierte Menschen können posten. Alle können Known lesen – schließe die Identitätsprüfung ab, um mitzureden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο επαληθευμένοι άνθρωποι μπορούν να δημοσιεύουν. Όλοι μπορούν να διαβάζουν το Known — ολοκλήρωσε την επαλήθευση ταυτότητας για να μιλήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only verified humans can post. Everyone can read Known — finish identity verification to speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas verificadas pueden publicar. Todo el mundo puede leer Known; termina la verificación de identidad para hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain vahvistetut ihmiset voivat julkaista. Kaikki voivat lukea Knownia – viimeistele henkilöllisyyden vahvistus puhuaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les humains vérifiés peuvent publier. Tout le monde peut lire Known — terminez la vérification d’identité pour prendre la parole."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק בני אדם מאומתים יכולים לפרסם. כולם יכולים לקרוא את Known — השלם אימות זהות כדי לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सत्यापित इंसान पोस्ट कर सकते हैं। Known सब पढ़ सकते हैं — बोलने के लिए पहचान सत्यापन पूरा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objavljivati mogu samo potvrđeni ljudi. Svatko može čitati objave u aplikaciji Known — dovrši provjeru identiteta da bi mogao/la govoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak hitelesített emberek írhatnak. A Knownt mindenki olvashatja – az íráshoz fejezd be a személyazonosság hitelesítését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia terverifikasi yang bisa memposting. Semua orang bisa membaca Known — selesaikan verifikasi identitas untuk bersuara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone verificate possono pubblicare. Tutti possono leggere Known: completa la verifica dell'identità per parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿できるのは認証済みの人だけです。Knownは誰でも読めます。発言するには本人確認を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 사람만 게시할 수 있어요. 누구나 Known을 읽을 수 있지만, 말하려면 신원 인증을 완료하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിച്ച മനുഷ്യർക്ക് മാത്രമേ പോസ്റ്റ് ചെയ്യാനാകൂ. Known എല്ലാവർക്കും വായിക്കാം — സംസാരിക്കാൻ ഐഡന്റിറ്റി പരിശോധന പൂർത്തിയാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia yang disahkan boleh menyiar. Sesiapa boleh membaca Known — selesaikan pengesahan identiti untuk bersuara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare verifiserte mennesker kan publisere. Alle kan lese Known. Fullfør identitetsverifiseringen for å ta ordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geverifieerde mensen kunnen posten. Iedereen kan Known lezen; rond je identiteitsverificatie af om mee te praten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy mogą pisać tylko zweryfikowani ludzie. Każdy może czytać Known — dokończ weryfikację tożsamości, aby zabierać głos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem postar. Todos podem ler o Known; conclua a verificação de identidade para participar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem publicar. Todos podem ler a Known — conclua a verificação de identidade para falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar oamenii verificați pot posta. Oricine poate citi Known — finalizează verificarea identității ca să poți vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публиковать могут только проверенные люди. Читать Known может каждый — завершите проверку личности, чтобы писать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príspevky môžu písať iba overení ľudia. Known môže čítať každý — dokonči overenie totožnosti, aby si mohol hovoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara verifierade människor kan publicera. Alla kan läsa Known – slutför identitetsverifieringen för att kunna delta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்பட்ட மனிதர்கள் மட்டுமே இடலாம். Known-ஐ எல்லோரும் படிக்கலாம் — பேச அடையாளச் சரிபார்ப்பை முடியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధృవీకరించబడిన మనుషులు మాత్రమే పోస్ట్ చేయగలరు. Knownను ఎవరైనా చదవవచ్చు — మాట్లాడటానికి గుర్తింపు ధృవీకరణ పూర్తి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนจริงที่ยืนยันตัวตนแล้วเท่านั้นที่โพสต์ได้ ทุกคนอ่าน Known ได้ ยืนยันตัวตนให้เสร็จเพื่อร่วมพูดคุย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğrulanmış insanlar gönderi paylaşabilir. Known'u herkes okuyabilir; konuşmak için kimlik doğrulamasını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публікувати можуть лише верифіковані люди. Читати Known може кожен — завершіть верифікацію особи, щоб писати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تصدیق شدہ انسان پوسٹ کر سکتے ہیں۔ Known ہر کوئی پڑھ سکتا ہے — بولنے کے لیے شناخت کی تصدیق مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người thật đã xác minh mới được đăng bài. Ai cũng đọc được Known — hãy hoàn tất xác minh danh tính để lên tiếng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已验证的真人才能发帖。每个人都能阅读 Known，完成身份验证后即可发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已驗證的真人才能發文。任何人都能閱讀 Known，完成身分驗證即可發言。"
          }
        }
      }
    },
