        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megkérdezi, ki ő, majd ad egy hivatkozást, amelyet elküldhetsz neki"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menanyakan siapa mereka, lalu memberimu tautan untuk dikirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede chi è la persona, poi ti dà un link da inviarle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が誰かを尋ね、そのあと相手に送るリンクを発行します"
