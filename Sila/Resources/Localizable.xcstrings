        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kimse yok; ilk siz olun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нікого — будьте першим"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی نہیں — پہلے آپ بنیں"
