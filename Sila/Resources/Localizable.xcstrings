    "account.handle.choose.existing": {
      "comment": "Under 'Choose your @handle' for an older account still on its random handle. %@ is that handle, e.g. @user7k2m9q4x.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين انضممت أُعطيت المعرّف %@. اختر معرّفًا خاصًا بك أو أبقِ عليه حاليًا — يمكنك تغييره لاحقًا من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ দেওয়ার সময় আপনাকে %@ দেওয়া হয়েছিল। নিজের একটি হ্যান্ডেল বেছে নিন, অথবা আপাতত এটিই রাখুন — পরে সেটিংসে বদলাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan et vas unir, se't va assignar %@. Tria un identificador propi o conserva'l de moment: el pots canviar més endavant a Ajustos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při registraci ti byl přidělen %@. Vyber si vlastní handle, nebo si ho zatím ponech – později ho změníš v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da du tilmeldte dig, fik du %@. Vælg dit eget handle, eller behold det indtil videre – du kan ændre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beitritt hast du %@ erhalten. Wähle ein eigenes Handle oder behalte es vorerst – du kannst es später in den Einstellungen ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν εγγράφηκες σου δόθηκε το %@. Επίλεξε δικό σου handle ή κράτα αυτό προς το παρόν — μπορείς να το αλλάξεις αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you joined you were given %@. Choose a handle of your own, or keep it for now — you can change it later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al unirte se te asignó %@. Elige un identificador propio o conserva este por ahora: podrás cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittyessäsi sait tunnuksen %@. Valitse oma käyttäjätunnus tai pidä tämä toistaiseksi – voit vaihtaa sen myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À votre inscription, on vous a attribué %@. Choisissez votre propre identifiant, ou gardez celui-ci pour l’instant — vous pourrez le changer plus tard dans les Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהצטרפת קיבלת את %@. בחר שם משתמש משלך, או השאר אותו לעת עתה — אפשר לשנות אותו בהמשך בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप जुड़े थे तब आपको %@ मिला था। अपना खुद का हैंडल चुनें, या अभी इसे रखें — आप इसे बाद में सेटिंग्स में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad si se pridružio/la, dobio/la si %@. Odaberi vlastiti handle ili ga za sada zadrži — možeš ga promijeniti kasnije u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozáskor ezt kaptad: %@. Válassz saját @nevet, vagy egyelőre tartsd meg ezt – később a Beállításokban módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bergabung kamu diberi %@. Pilih handle sendiri, atau pakai dulu yang ini — kamu bisa mengubahnya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti sei iscritto ti è stato assegnato %@. Scegli un handle tutto tuo oppure tienilo per ora: potrai cambiarlo più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加時に%@が割り当てられました。自分のハンドルを選ぶか、今はそのままにしておけます。あとで設定から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입할 때 %@ 핸들이 부여되었어요. 나만의 핸들을 고르거나 일단 그대로 두세요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ചേർന്നപ്പോൾ %@ എന്ന ഹാൻഡിൽ ലഭിച്ചു. സ്വന്തമായൊന്ന് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ തൽക്കാലം ഇത് നിലനിർത്തുക — ക്രമീകരണങ്ങളിൽ പിന്നീട് മാറ്റാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda menyertai, anda diberi %@. Pilih nama pengendali anda sendiri, atau kekalkannya buat masa ini — anda boleh menukarnya kemudian dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Da du ble med, fikk du %@. Velg et eget brukernavn, eller behold det for nå. Du kan endre det senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toen je je aanmeldde kreeg je %@. Kies een eigen handle, of houd deze voorlopig. Je kunt hem later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dołączeniu dostałeś(-aś) uchwyt %@. Wybierz własny albo na razie zostaw ten — możesz go zmienić później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você entrou, recebeu %@. Escolha um @usuário só seu ou mantenha este por enquanto. Você pode mudar depois em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando se juntou, foi-lhe atribuído %@. Escolha um identificador seu ou mantenha este por agora — pode alterá-lo mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când te-ai alăturat ți s-a dat %@. Alege un handle propriu sau păstrează-l deocamdată — îl poți schimba mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При регистрации вам дали %@. Выберите своё имя пользователя или пока оставьте это — позже его можно изменить в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri registrácii si dostal %@. Vyber si vlastné používateľské meno alebo si toto zatiaľ ponechaj — môžeš ho neskôr zmeniť v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du gick med fick du %@. Välj ett eget användarnamn, eller behåll det tills vidare – du kan ändra det senare i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேர்ந்தபோது உங்களுக்கு %@ வழங்கப்பட்டது. சொந்த ஹேண்டிலைத் தேர்ந்தெடுங்கள், அல்லது தற்போதைக்கு அதையே வைத்திருங்கள் — பிறகு அமைப்புகளில் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చేరినప్పుడు మీకు %@ ఇవ్వబడింది. మీ స్వంత హ్యాండిల్‌ను ఎంచుకోండి, లేదా ప్రస్తుతానికి దాన్నే ఉంచుకోండి — తర్వాత సెట్టింగ్‌లలో మార్చుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนที่คุณเข้าร่วม คุณได้รับ %@ เลือกแฮนเดิลของคุณเอง หรือใช้อันนี้ไปก่อน คุณเปลี่ยนภายหลังได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katıldığınızda size %@ verildi. Kendinize ait bir kullanıcı adı seçin ya da şimdilik bunu koruyun; daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви приєдналися, вам дали %@. Виберіть власне @ім’я або поки залиште це — пізніше його можна змінити в Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شمولیت پر آپ کو %@ دیا گیا تھا۔ اپنا ہینڈل خود چنیں، یا فی الحال اسی کو رکھیں — آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tham gia, bạn được cấp %@. Hãy chọn tên người dùng của riêng bạn, hoặc tạm giữ tên này — bạn có thể đổi sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你加入时获得了 %@。请选择一个自己的用户名，或暂时保留它，之后可以在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你加入時獲得的代號是 %@。你可以選擇自己的代號，或暫時沿用，之後可在「設定」中更改。"
          }
        }
      }
    },
    "account.handle.choose.message": {
      "comment": "Under 'Choose your @handle' right after sign-up.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "به يجدك الناس ويذكرونك في «معروف». يمكنك تغييره لاحقًا من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর মাধ্যমেই মানুষ Known-এ আপনাকে খুঁজে পায় ও মেনশন করে। পরে সেটিংসে বদলাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Així et troba i et menciona la gent a Known. El pots canviar més endavant a Ajustos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle něj tě lidé v aplikaci Known najdou a zmíní. Později ho změníš v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er sådan, folk finder og nævner dig på Known. Du kan ændre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So finden und erwähnen dich andere auf Known. Du kannst es später in den Einstellungen ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτσι σε βρίσκουν και σε αναφέρουν οι άλλοι στο Known. Μπορείς να το αλλάξεις αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's how people find and mention you on Known. You can change it later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así te encuentra y te menciona la gente en Known. Puedes cambiarlo después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen avulla ihmiset löytävät ja mainitsevat sinut Knownissa. Voit vaihtaa sen myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ainsi que l’on vous trouve et vous mentionne sur Known. Vous pourrez le changer plus tard dans les Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך אנשים מוצאים ומתייגים אותך ב-Known. אפשר לשנות אותו בהמשך בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known पर लोग इसी से आपको ढूँढते और मेंशन करते हैं। आप इसे बाद में सेटिंग्स में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tako te ljudi pronalaze i spominju u aplikaciji Known. Možeš ga promijeniti kasnije u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így találnak meg és említenek az emberek a Knownon. Később a Beállításokban módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan ini orang menemukan dan menyebutmu di Known. Kamu bisa mengubahnya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È come le persone ti trovano e ti menzionano su Known. Potrai cambiarlo più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Known上で他の人があなたを見つけたりメンションしたりするときに使われます。あとで設定から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 Known에서 나를 찾고 멘션하는 방법이에요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ൽ ആളുകൾ നിങ്ങളെ കണ്ടെത്തുന്നതും പരാമർശിക്കുന്നതും ഇതിലൂടെയാണ്. ക്രമീകരണങ്ങളിൽ പിന്നീട് മാറ്റാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Inilah cara orang mencari dan menyebut anda di Known. Anda boleh menukarnya kemudian dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik finner og nevner folk deg på Known. Du kan endre det senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo vinden en vermelden mensen je op Known. Je kunt hem later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki niemu ludzie znajdują Cię i wspominają o Tobie w Known. Możesz go zmienić później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É como as pessoas encontram e mencionam você no Known. Você pode mudar depois em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que as pessoas o encontram e mencionam na Known. Pode alterá-lo mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așa te găsesc și te menționează oamenii pe Known. Îl poți schimba mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По нему вас находят и упоминают в Known. Позже его можно изменить в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podľa neho ťa ľudia nájdu a spomenú na Known. Môžeš ho neskôr zmeniť v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så hittar och nämner folk dig på Known. Du kan ändra det senare i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-இல் மக்கள் உங்களைக் கண்டுபிடிக்கவும் குறிப்பிடவும் இதுவே வழி. பிறகு அமைப்புகளில் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownలో ప్రజలు మిమ్మల్ని కనుగొనేది, ప్రస్తావించేది దీనితోనే. తర్వాత సెట్టింగ్‌లలో మార్చుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นวิธีที่คนอื่นใช้ค้นหาและกล่าวถึงคุณใน Known คุณเปลี่ยนภายหลังได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar sizi Known'da bununla bulur ve etiketler. Daha sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так люди знаходять і згадують вас у Known. Пізніше його можна змінити в Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known پر لوگ اسی سے آپ کو ڈھونڈتے اور ذکر کرتے ہیں۔ آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là cách mọi người tìm và nhắc đến bạn trên Known. Bạn có thể đổi sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别人通过它在 Known 上找到你和提及你。之后可以在“设置”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別人會透過它在 Known 上找到你、提及你。之後可在「設定」中更改。"
          }
        }
      }
    },
    "account.handle.choose.title": {
      "comment": "Heading of the step after sign-up that offers a handle of the person's own (contract v33).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معرّفك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার @হ্যান্ডেল বেছে নিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria el teu @identificador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber si @handle"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dit @handle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle dein @handle"
          }
