    "vouch.error.slotsFull": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقف الآن خلف أقصى عدد ممكن من الأشخاص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে আপনি যতজনের পাশে দাঁড়াতে পারেন, ততজনের পাশেই আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix ja avales tantes persones com pots."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď stojíš za tolika lidmi, za kolik můžeš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du går i god for så mange mennesker, som du kan lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du stehst bereits für so viele Personen ein, wie du im Moment kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στηρίζεις ήδη όσα άτομα μπορείς αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're standing behind as many people as you can right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya estás respaldando a todas las personas que puedes ahora mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaat jo niin monta ihmistä kuin voit juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous portez garant d’autant de personnes que possible pour le moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה כבר עומד מאחורי מספר האנשים המרבי כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी उतने लोगों के पीछे खड़े हैं जितनों के पीछे आप खड़े हो सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno stojiš iza onoliko ljudi koliko možeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelenleg annyi emberért kezeskedsz, amennyiért csak lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sedang menjamin orang sebanyak yang bisa saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai già garantendo per tutte le persone che puoi al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま保証できる人数の上限に達しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 보증할 수 있는 최대 인원을 보증하고 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിങ്ങൾക്ക് പിന്തുണയ്ക്കാവുന്നത്ര ആളുകളെ നിങ്ങൾ പിന്തുണയ്ക്കുന്നുണ്ട്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah menjamin seramai yang anda boleh sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du står allerede bak så mange mennesker som du kan akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je staat nu voor zoveel mensen in als je kunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręczysz już za tyle osób, za ile możesz w tej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já está respondendo por tantas pessoas quantas pode neste momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento já responde por tantas pessoas quantas pode."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantezi deja pentru cât mai multe persoane posibil acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже поручаетесь за столько людей, за сколько можете в данный момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve teraz ručíš za toľko ľudí, koľko môžeš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du står redan bakom så många personer som du kan just nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்களால் முடிந்த அளவு பேருக்கு நீங்கள் உறுதியளித்துள்ளீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం మీరు వీలైనంత మందికి హామీగా నిలుస్తున్నారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณรับรองคนได้เต็มจำนวนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda arkasında durabileceğiniz kadar insanın arkasındasınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз ви ручаєтеся за стільки людей, за скільки можете."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ابھی اتنے لوگوں کے ساتھ کھڑے ہیں جتنوں کے ساتھ ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện bạn đã đứng sau lưng nhiều người nhất có thể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前已经为尽可能多的人担保了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前已擔保了你能擔保的最多人數。"
          }
        }
      }
    },
