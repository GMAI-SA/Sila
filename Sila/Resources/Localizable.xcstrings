    "auth.error.invalidEmail": {
      "comment": "Inline validation on a malformed email address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل بريدًا إلكترونيًا صحيحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সঠিক ইমেইল ঠিকানা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
