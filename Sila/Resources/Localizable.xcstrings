        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בפורמט בינלאומי, שמתחיל בפלוס ובקידומת מדינה — לדוגמה +966501234567."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतरराष्ट्रीय फ़ॉर्मैट इस्तेमाल करें, जो प्लस और देश कोड से शुरू हो — जैसे +966501234567।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi međunarodni format, koji počinje plusom i pozivnim brojem zemlje — na primjer +966501234567."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használj nemzetközi formátumot, plusz jellel és országhívó számmal kezdve – például +966501234567."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai format internasional, diawali tanda plus dan kode negara — misalnya +966501234567."
