    "preferences.stance.muted.hint": {
      "comment": "What choosing Muted actually does — including that it works with the filter off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي المنشورات المصنّفة بهذا الموضوع من صفحتك الدولية، حتى عندما تكون التصفية موقفة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিল্টার বন্ধ থাকলেও এই বিষয়ের লেবেল দেওয়া পোস্ট আপনার আন্তর্জাতিক ফিড থেকে লুকায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaga del teu canal Internacional les publicacions etiquetades amb aquest tema, fins i tot amb el filtre desactivat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje příspěvky s tímto tématem z tvého Mezinárodního kanálu, i když je filtr vypnutý"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjuler opslag med dette emnemærke fra dit internationale feed, selv når filtret er slået fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Beiträge mit diesem Thema aus deinem internationalen Feed aus, auch wenn der Filter aus ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρύβει αναρτήσεις με αυτό το θέμα από τη Διεθνή ροή σου, ακόμα και όταν το φίλτρο είναι ανενεργό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides posts labelled with this topic from your International feed, even when the filter is off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta de tu feed Internacional las publicaciones con la etiqueta de este tema, aunque el filtro esté desactivado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilottaa tällä aiheella luokitellut julkaisut Kansainvälinen-syötteestäsi, vaikka suodatin olisi pois päältä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque de votre fil International les posts étiquetés avec ce sujet, même quand le filtre est désactivé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסתיר מהפיד הבינלאומי שלך פוסטים המתויגים בנושא הזה, גם כשהמסנן כבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टॉपिक के लेबल वाली पोस्ट आपकी अंतरराष्ट्रीय फ़ीड से छिपाता है, फ़िल्टर बंद होने पर भी"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriva objave označene ovom temom iz tvog međunarodnog feeda, čak i kad je filtar isključen"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejti az ezzel a témával címkézett bejegyzéseket a Nemzetközi hírfolyamodból, a szűrő kikapcsolt állapotában is"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan postingan berlabel topik ini dari feed Internasionalmu, bahkan saat filter nonaktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde dal tuo feed Internazionale i post etichettati con questo argomento, anche quando il filtro è disattivato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターがオフでも、このトピックのラベルが付いた投稿を国際フィードで非表示にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터가 꺼져 있어도 이 주제 라벨이 붙은 게시물을 국제 피드에서 숨겨요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫിൽട്ടർ ഓഫായിരിക്കുമ്പോഴും, ഈ വിഷയ ലേബലുള്ള പോസ്റ്റുകൾ നിങ്ങളുടെ അന്താരാഷ്ട്ര ഫീഡിൽ നിന്ന് മറയ്ക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan siaran berlabel topik ini daripada suapan Antarabangsa anda, walaupun penapis dimatikan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjuler innlegg merket med dette emnet fra den internasjonale feeden din, selv når filteret er av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt berichten met dit onderwerplabel uit je internationale feed, ook als het filter uit staat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywa wpisy z tym tematem w kanale międzynarodowym, nawet gdy filtr jest wyłączony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta do seu feed Internacional os posts com o rótulo deste tópico, mesmo com o filtro desativado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta do seu feed Internacional as publicações com este tópico, mesmo com o filtro desativado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde din fluxul Internațional postările etichetate cu acest subiect, chiar și când filtrul este oprit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает из вашей международной ленты посты с этой темой, даже когда фильтр выключен"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje z tvojho medzinárodného kanála príspevky s touto témou, aj keď je filter vypnutý"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Döljer inlägg med det här ämnet från ditt internationella flöde, även när filtret är av"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வடிகட்டி அணைந்திருந்தாலும், இந்தத் தலைப்பு லேபிளிடப்பட்ட இடுகைகளை உங்கள் சர்வதேச ஊட்டத்திலிருந்து மறைக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫిల్టర్ ఆఫ్‌లో ఉన్నా, ఈ అంశం లేబుల్ ఉన్న పోస్ట్‌లను మీ అంతర్జాతీయ ఫీడ్ నుండి దాచుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนโพสต์ที่ติดป้ายหัวข้อนี้จากฟีดนานาชาติของคุณ แม้ปิดตัวกรองอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre kapalıyken bile, bu konuyla etiketlenmiş gönderileri Uluslararası akışınızdan gizler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховує дописи з цією темою зі стрічки «Світ», навіть коли фільтр вимкнено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس موضوع کے لیبل والی پوسٹس آپ کی بین الاقوامی فیڈ سے چھپاتا ہے، فلٹر بند ہونے پر بھی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn bài đăng được gắn nhãn chủ đề này khỏi bảng tin Quốc tế của bạn, kể cả khi bộ lọc tắt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的国际信息流中隐藏带有此话题标签的帖子，即使筛选已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使篩選關閉，也會從你的「國際」動態隱藏標有此主題的貼文"
          }
        }
      }
    },
