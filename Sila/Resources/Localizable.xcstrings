              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "التظلّم لا يتجاوز %lld حرف."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "التظلّم لا يتجاوز حرفين."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "التظلّم لا يمكن أن يكون بهذا الطول."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Appeals are at most %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Appeals are at most %lld characters."
                }
              }
            }
          }
        }
      }
    },
    "safety.appeal.field.hint": {
      "comment": "VoiceOver hint for the appeal field. %lld is the character limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف، بحد أقصى %lld أحرف. يقرؤه إنسان."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف، بحد أقصى %lld حرفًا. يقرؤه إنسان."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف، بحد أقصى حرف واحد. يقرؤه إنسان."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف، بحد أقصى %lld حرف. يقرؤه إنسان."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف، بحد أقصى حرفان. يقرؤه إنسان."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تظلّم واحد لكل إيقاف. يقرؤه إنسان."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One appeal per suspension, up to %lld character. A human reads it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One appeal per suspension, up to %lld characters. A human reads it."
                }
              }
            }
          }
        }
      }
    },
    "safety.appeal.field.label": {
      "comment": "Label above the appeal text field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظلّمك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal"
          }
        }
      }
    },
    "safety.appeal.field.placeholder": {
      "comment": "Placeholder in the appeal field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تعتقد أنه حدث، ولماذا ينبغي إعادة النظر فيه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you think happened, and why it should be reconsidered"
          }
        }
      }
    },
    "safety.appeal.header": {
      "comment": "Header above the appeal form. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظلّم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APPEAL"
          }
        }
      }
    },
    "safety.appeal.prompt": {
      "comment": "The label above the appeal box. States the one-per-suspension rule.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك تظلّم واحد لكل إيقاف. اذكر ما تعتقد أنه حدث ولماذا ينبغي إعادة النظر فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get one appeal per suspension. Say what you think happened and why it should be reconsidered."
          }
        }
      }
    },
    "safety.appeal.receipt": {
      "comment": "The appeal receipt with a date. %1$@ is when it was sent, %2$@ its status, %3$@ the standing explanation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل في %1$@ — %2$@. %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent %1$@ — %2$@. %3$@"
          }
        }
      }
    },
    "safety.appeal.receipt.noDate": {
      "comment": "The appeal receipt when the server sent no date. %1$@ is the status, %2$@ the standing explanation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "safety.appeal.send": {
      "comment": "Button that files the appeal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل التظلّم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send appeal"
          }
        }
      }
    },
    "safety.appeal.send.hint": {
      "comment": "VoiceOver hint for the send-appeal button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل تظلّمك إلى مراجع من البشر. ولك تظلّم واحد لكل إيقاف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your appeal to a human reviewer. You get one per suspension."
          }
        }
      }
    },
    "safety.appeal.sent.title": {
      "comment": "Heading on the appeal receipt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل التظلّم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal sent"
          }
        }
      }
    },
    "safety.appeal.status.pending": {
      "comment": "Appeal status: not read yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار القراءة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to be read"
          }
        }
      }
    },
    "safety.appeal.status.rejected": {
      "comment": "Appeal status: refused, and the suspension stands.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض — والإيقاف قائم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected — the suspension stands"
          }
        }
      }
    },
    "safety.appeal.status.reviewing": {
      "comment": "Appeal status: with a reviewer.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيد المراجعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being reviewed"
          }
        }
      }
    },
    "safety.appeal.status.unknown": {
      "comment": "Appeal status this build does not recognise. Says only what is certain: it was sent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted"
          }
        }
      }
    },
    "safety.appeal.status.upheld": {
      "comment": "Appeal status: accepted, and the suspension is being lifted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُبل — ويجري رفع الإيقاف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upheld — the suspension is being lifted"
          }
        }
      }
    },
    "safety.appeal.submitted": {
      "comment": "Confirmation once an appeal is on file. States that a second would not be read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظلّمك لدى أحد المراجعين. ولا شيء آخر لترسله — تقبل سِلة تظلّمًا واحدًا لكل إيقاف، والثاني لن يُقرأ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is with a reviewer. There is nothing else to send — one appeal per suspension is all Sila accepts, and a second would not be read."
          }
        }
      }
    },
    "safety.appeal.toast.alreadyOnFile": {
      "comment": "Toast when an appeal was already on file. Not a failure — it is the answer to the question.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق أن قدّمت تظلّمًا. وما زال قائمًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You had already appealed. That one still stands."
          }
        }
      }
    },
    "safety.appeal.toast.sent": {
      "comment": "Toast after an appeal is filed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل تظلّمك. سيقرؤه إنسان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is in. A human will read it."
          }
        }
      }
    },
    "safety.block.confirm.fallbackTitle": {
      "comment": "Block confirmation title when the account has no name to use.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر هذا الحساب؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this account?"
          }
        }
      }
    },
    "safety.block.confirm.title": {
      "comment": "Question at the top of the block confirmation. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر %@؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block %@?"
          }
        }
      }
    },
    "safety.block.consequence.follows": {
      "comment": "Block consequence 2 of 4: the follows it severs, in both directions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقطع أي متابعة بينكما في الاتجاهين. وإن كنتما تتابعان بعضكما، تُزال المتابعتان معًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any follow between you is severed, both ways. If you follow each other, both follows are removed."
          }
        }
      }
    },
    "safety.block.consequence.notRestored": {
      "comment": "Block consequence 3 of 4: unblocking does not put the follows back. The one people do not expect, and the reason this is a dialog.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الحظر لاحقًا لا يعيدها. فلن يعود أي منكما متابعًا للآخر، وسيحتاج كل منكما إلى المتابعة من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblocking later does not put them back. Neither of you would be following the other again; you would each have to follow again from scratch."
          }
        }
      }
    },
    "safety.block.consequence.silent": {
      "comment": "Block consequence 4 of 4: the other person is not told. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُبلَّغ %@ بذلك. لا ترسل سِلة أي إشعار ولا تعرض عليه أي رسالة بهذا الشأن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not told. Sila sends no notification and shows them no message about this."
          }
        }
      }
    },
    "safety.block.consequence.visibility": {
      "comment": "Block consequence 1 of 4: what stops being visible, in both directions. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف كل منكما عن رؤية الآخر. تختفي منشورات %@ وردوده من صفحاتك ونتائج بحثك وكل سلسلة تفتحها — وتختفي منشوراتك عنه كذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stop seeing each other. %@'s posts and replies leave your feeds, your search results and every thread you open — and yours leave theirs."
          }
        }
      }
    },
    "safety.block.reversible": {
      "comment": "The line under the confirmation's buttons, saying where a block can be undone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إلغاء الحظر من الإعدادات ← الأمان في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can unblock from Settings → Safety at any time."
          }
        }
      }
    },
    "safety.block.toast": {
      "comment": "Toast after a block. Repeats what happened, including the silence. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُظر %@. اختفت منشوراته عنك، وأُزيلت أي متابعة بينكما، ولم يُبلَّغ بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked %@. Their posts are gone from your feeds, any follow between you is removed, and they were not told."
          }
        }
      }
    },
    "safety.list.blocked.caption": {
      "comment": "The explanation at the top of the blocked list. Repeats the silence and that unblocking restores no follow.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك أنت وهذه الحسابات رؤية بعضكم. ولم يُبلَّغ أي منها، وإلغاء الحظر لا يعيد أي متابعة قُطعت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and these accounts cannot see each other. None of them were told, and unblocking does not restore any follow that was severed."
          }
        }
      }
    },
    "safety.list.muted.caption": {
      "comment": "The explanation at the top of the muted list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الحسابات لا تظهر لك. ولم يُبلَّغ أي منها، ولم يتغير شيء آخر في علاقتكم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These accounts do not appear in your feeds. None of them were told, and nothing else about your relationship changed."
          }
        }
      }
    },
    "safety.list.reports.caption": {
      "comment": "The explanation at the top of the reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أبلغت عنه، وما وصل إليه كل بلاغ. ولا يُعرض على الحسابات المعنية من أبلغ عنها أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have reported, and where each one has got to. The accounts involved are never shown who reported them."
          }
        }
      }
    },
    "safety.lists.blocked.empty.subtitle": {
      "comment": "Empty blocked list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تحظر شخصًا يظهر هنا، ويمكنك التراجع من هذه القائمة في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you block someone they appear here, and you can undo it from this list at any time."
          }
        }
      }
    },
    "safety.lists.blocked.empty.title": {
      "comment": "Empty blocked list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد محظور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is blocked"
          }
        }
      }
    },
    "safety.lists.blocked.row.hint": {
      "comment": "VoiceOver hint on an unblock button. %@ is the account's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك ولـ%@ رؤية بعضكما مجددًا. ولا يعيد أي متابعة قُطعت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you and %@ see each other again. It does not restore any follow that was severed."
          }
        }
      }
    },
    "safety.lists.done.hint": {
      "comment": "VoiceOver hint for the Done button on the safety lists.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق قوائم الأمان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes your safety lists"
          }
        }
      }
    },
    "safety.lists.error.retry": {
      "comment": "Retry action on the safety lists error state.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "safety.lists.error.title": {
      "comment": "Empty state when the safety lists failed to load.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل قوائم الأمان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your safety lists"
          }
        }
      }
    },
    "safety.lists.loading.a11y": {
      "comment": "VoiceOver label while the safety lists load.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحميل قوائم الأمان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your safety lists"
          }
        }
      }
    },
    "safety.lists.muted.empty.title": {
      "comment": "Empty muted list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد مكتوم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is muted"
          }
        }
      }
    },
    "safety.lists.muted.row.hint": {
      "comment": "VoiceOver hint on an unmute button. %@ is the account's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد منشورات %@ للظهور لك. ولا يُبلَّغ في الحالتين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets %@'s posts back into your feeds. They are not told either way."
          }
        }
      }
    },
    "safety.lists.navTitle": {
      "comment": "Navigation title on the blocked / muted / reported lists.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمان"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety"
          }
        }
      }
    },
    "safety.lists.reports.empty.subtitle": {
      "comment": "Empty reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا البلاغات التي تقدّمها مع حالتها، لترى ما حدث لكل منها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports you file show up here with their status, so you can see what happened to each one."
          }
        }
      }
    },
    "safety.lists.reports.empty.title": {
      "comment": "Empty reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبلّغ عن أي شيء"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't reported anything"
          }
        }
      }
    },
    "safety.menu.block": {
      "comment": "Safety menu: block this account. The ellipsis means a confirmation comes first. %@ is the handle, with its at sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر %@…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block %@…"
          }
        }
      }
    },
    "safety.menu.block.hint": {
      "comment": "VoiceOver hint for the block item, which opens a confirmation rather than blocking.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب تأكيدك أولًا، ويوضّح ما الذي يزيله الحظر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks you to confirm first, and says what a block removes."
          }
        }
      }
    },
    "safety.menu.button.a11yHint": {
      "comment": "VoiceOver hint for the safety menu button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ عن هذا الحساب أو كتمه أو حظره"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report, mute or block this account"
          }
        }
      }
    },
    "safety.menu.button.a11yLabel": {
      "comment": "VoiceOver label for the safety menu button on a card or profile. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات إضافية لـ%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More options for %@"
          }
        }
      }
    },
    "safety.menu.mute": {
      "comment": "Safety menu: mute this account. %@ is the handle, with its at sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتم %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute %@"
          }
        }
      }
    },
    "safety.menu.report": {
      "comment": "Safety menu: open the reason picker. The ellipsis means it opens something else.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبلاغ…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report…"
          }
        }
      }
    },
    "safety.menu.report.hint": {
      "comment": "VoiceOver hint for Report. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح قائمة بالأسباب. الإبلاغ سري — ولا يُعرض على %@ أبدًا من أبلغ عنه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a list of reasons. Reporting is confidential — %@ is never shown who reported them."
          }
        }
      }
    },
    "safety.menu.silentHeader": {
      "comment": "Header on the safety menu, read before either silent action is taken. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر والكتم صامتان — لا يُبلَّغ %@ بأي منهما أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking and muting are silent — %@ is never told."
          }
        }
      }
    },
    "safety.menu.unblock": {
      "comment": "Safety menu: lift the block. %@ is the handle, with its at sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء حظر %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock %@"
          }
        }
      }
    },
    "safety.menu.unmute": {
      "comment": "Safety menu: lift the mute. %@ is the handle, with its at sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء كتم %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute %@"
          }
        }
      }
    },
    "safety.menu.unmute.hint": {
      "comment": "VoiceOver hint for unmuting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد منشوراته للظهور لك. ولا يُبلَّغ بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets their posts back into your feeds. They are not told."
          }
        }
      }
    },
    "safety.mute.effect": {
      "comment": "What muting actually does — and what it leaves alone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف منشوراته وردوده عن الظهور لك. وما زال بإمكانك فتح ملفه وقراءتها هناك، وما زال بإمكانه رؤيتك والرد عليك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their posts and replies stop appearing in your feeds. You can still open their profile and read them there, and they can still see and reply to you."
          }
        }
      }
    },
    "safety.mute.isSilent": {
      "comment": "The line that has to sit next to every mute control.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتم صامت. لا يُبلَّغ الطرف الآخر أبدًا، ولا يتغير عنده شيء، وتبقيان متابعين لبعضكما إن كنتما كذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muting is silent. The other person is never told, nothing changes for them, and you stay following each other if you did."
          }
        }
      }
    },
    "safety.mute.toast": {
      "comment": "Toast after a mute. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتم %@. لن تظهر لك منشوراته. ولم يُبلَّغ بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted %@. Their posts won't appear in your feeds. They are not told."
          }
        }
      }
    },
    "safety.reason.harassment.detail": {
      "comment": "What the harassment reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إساءة موجّهة أو تهديدات أو تكتّل جماعي ضد شخص بعينه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Targeted abuse, threats or a pile-on aimed at someone."
          }
        }
