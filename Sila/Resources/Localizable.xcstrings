    "account.password.current.hint": {
      "comment": "VoiceOver hint for the current-password field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبت أن هذا حسابك، لا مجرد هاتف مفتوح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রমাণ করে যে এটি আপনার অ্যাকাউন্ট, শুধু একটি আনলক করা ফোন নয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostra que aquest compte és teu, no només un telèfon desbloquejat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověří, že je to tvůj účet, a ne jen odemčený telefon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beviser, at det er din konto og ikke bare en oplåst telefon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt, dass es dein Konto ist und nicht nur ein entsperrtes Telefon"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδεικνύει ότι είναι ο λογαριασμός σου, όχι απλώς ένα ξεκλείδωτο τηλέφωνο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proves this is your account, not just an unlocked phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demuestra que esta es tu cuenta, no solo un teléfono desbloqueado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmistaa, että tämä on sinun tilisi eikä vain avattu puhelin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prouve que c’est bien votre compte, pas seulement un téléphone déverrouillé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוכיח שזה החשבון שלך, ולא רק טלפון פתוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साबित करता है कि यह आपका अकाउंट है, सिर्फ़ अनलॉक फ़ोन नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrđuje da je ovo tvoj račun, a ne samo otključan telefon"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Igazolja, hogy ez a te fiókod, nem csak egy feloldott telefon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuktikan ini akunmu, bukan sekadar ponsel yang tidak terkunci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimostra che questo è il tuo account, non solo un telefono sbloccato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックが解除された電話だけでなく、本人のアカウントであることを確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제된 휴대폰이 아니라 내 계정임을 확인해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അൺലോക്ക് ചെയ്ത ഫോൺ മാത്രമല്ല, ഇത് നിങ്ങളുടെ അക്കൗണ്ടാണെന്ന് തെളിയിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuktikan ini akaun anda, bukan sekadar telefon yang tidak berkunci"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekrefter at dette er kontoen din, ikke bare en opplåst telefon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewijst dat dit jouw account is, en niet alleen een ontgrendelde telefoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdza, że to Twoje konto, a nie tylko odblokowany telefon"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que esta é a sua conta, e não apenas um celular desbloqueado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que esta é a sua conta, e não apenas um telemóvel desbloqueado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovedește că acesta este contul tău, nu doar un telefon deblocat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждает, что это ваш аккаунт, а не просто разблокированный телефон"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdí, že ide o tvoj účet, nielen odomknutý telefón"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräftar att det är ditt konto, inte bara en olåst telefon"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திறக்கப்பட்ட தொலைபேசி மட்டுமல்ல, இது உங்கள் கணக்குதான் என்பதை உறுதிசெய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది అన్‌లాక్ చేసిన ఫోన్ మాత్రమే కాదు, మీ ఖాతానే అని నిరూపిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันว่าเป็นบัญชีของคุณ ไม่ใช่แค่โทรศัพท์ที่ปลดล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yalnızca kilidi açık bir telefon değil, sizin hesabınız olduğunu kanıtlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджує, що це ваш обліковий запис, а не просто розблокований телефон"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ثابت کرتا ہے کہ یہ آپ کا اکاؤنٹ ہے، صرف کھلا ہوا فون نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận đây là tài khoản của bạn, không chỉ là một chiếc điện thoại đã mở khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证明这是你的账户，而不只是一部已解锁的手机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明這是你的帳號，而不只是一支解鎖的手機"
          }
        }
      }
    },
