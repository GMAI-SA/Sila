    "feed.order.newest.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحدث أولًا دون استثناء. لا يُرفع شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কঠোরভাবে নতুনটি আগে। কিছুই এগিয়ে আনা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrictament de la més nova a la més antiga. No es destaca res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přísně od nejnovějších. Nic se nezvýhodňuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengt nyeste først. Intet løftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikt die neuesten zuerst. Nichts wird angehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυστηρά οι νεότερες πρώτα. Τίποτα δεν προωθείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strictly newest first. Nothing is lifted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrictamente las más recientes primero. No se adelanta nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiukasti uusimmat ensin. Mitään ei nosteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strictement les plus récents d’abord. Rien n’est remonté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהחלט מהחדש לישן. שום דבר לא מועלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल सबसे नई पहले। कुछ भी ऊपर नहीं उठाया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strogo od najnovijih. Ništa se ne podiže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szigorúan a legújabb elöl. Semmi nem kerül előrébb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Murni terbaru dulu. Tidak ada yang diangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigorosamente dal più recente. Nulla viene valorizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に新しい順です。上がるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철저히 최신순이에요. 위로 올라오는 것은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കർശനമായി പുതിയത് ആദ്യം. ഒന്നും ഉയർത്തുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbaharu dahulu secara ketat. Tiada apa dinaikkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengt nyeste først. Ingenting løftes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikt nieuwste eerst. Niets wordt omhoog gehaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ściśle od najnowszych. Nic nie jest podbijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estritamente do mais recente ao mais antigo. Nada é impulsionado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estritamente das mais recentes para as mais antigas. Nada é realçado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict cele mai noi primele. Nimic nu este ridicat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строго сначала новые. Ничто не поднимается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prísne od najnovších. Nič sa nezvýrazňuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikt nyast först. Inget lyfts."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்டிப்பாகப் புதியவை முதலில். எதற்கும் முன்னுரிமை இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కచ్చితంగా కొత్తవి ముందు. ఏదీ పైకి తీసుకురాబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหม่สุดก่อนอย่างเคร่งครัด ไม่มีอะไรถูกดันขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle en yeniden eskiye. Hiçbir şey öne çıkarılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Строго від найновіших. Нічого не піднімається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سختی سے نئی سب سے پہلے۔ کچھ اوپر نہیں اٹھایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới nhất trước, hoàn toàn. Không có gì được đẩy lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严格按最新优先，不做任何提前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴格依最新排序，不做任何調整。"
          }
        }
      }
    },
