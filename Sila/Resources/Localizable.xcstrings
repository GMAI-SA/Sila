    "document.capture.back.instruction": {
      "comment": "Capture step instruction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقلب البطاقة واملأ الإطار بوجهها الخلفي كاملًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডটি উল্টান এবং ফ্রেম ভরে পুরো পেছনের দিকটি দেখান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la targeta i omple el requadre amb tot el dors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otoč kartu a vyplň rámeček celou zadní stranou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vend kortet, og lad hele bagsiden fylde rammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe die Karte um und fülle den Rahmen mit der ganzen Rückseite."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γύρνα την κάρτα ανάποδα και γέμισε το πλαίσιο με ολόκληρο το πίσω μέρος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the card over and fill the frame with the whole back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da la vuelta a la tarjeta y llena el encuadre con todo el reverso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä kortti ympäri ja täytä kehys koko takapuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retournez la carte et remplissez le cadre avec tout le verso."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוך את הכרטיס ומלא את המסגרת בכל צדו האחורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड पलटें और पूरे पिछले हिस्से से फ़्रेम भरें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okreni karticu i ispuni okvir cijelom poleđinom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordítsd meg a kártyát, és töltsd ki a keretet a teljes hátoldallal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balik kartunya dan penuhi bingkai dengan seluruh bagian belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la carta e riempi l'inquadratura con tutto il retro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードを裏返し、裏面全体が枠いっぱいになるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 뒤집어 뒷면 전체가 프레임에 가득 차게 하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാർഡ് മറിച്ചിട്ട് പിൻഭാഗം മുഴുവനായും ഫ്രെയിമിൽ നിറയ്ക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbalikkan kad dan penuhkan bingkai dengan seluruh bahagian belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snu kortet og fyll rammen med hele baksiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de kaart om en vul het kader met de hele achterkant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwróć kartę i wypełnij kadr całym tyłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vire o cartão e preencha o quadro com todo o verso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vire o cartão e encha o enquadramento com todo o verso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întoarce cardul și umple cadrul cu tot verso-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переверните карту и заполните рамку всей оборотной стороной."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otoč kartu a vyplň rámček celou zadnou stranou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänd på kortet och fyll rutan med hela baksidan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அட்டையைத் திருப்பி, முழுப் பின்புறமும் சட்டத்தை நிரப்பும்படி வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కార్డును తిప్పి, వెనుక భాగం మొత్తం ఫ్రేమ్‌లో నిండేలా ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พลิกบัตรและให้ด้านหลังทั้งหมดเต็มกรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı çevirin ve arka yüzün tamamını çerçeveye sığdırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переверніть картку й заповніть кадр усім зворотним боком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کارڈ کو پلٹیں اور پورے پچھلے حصے سے فریم بھر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lật thẻ lại và để toàn bộ mặt sau vừa khung hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将证件翻面，让整个背面填满取景框。"
          }
        },
