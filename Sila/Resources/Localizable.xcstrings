          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உத்தரவாதம் அளித்த ஒருவரைப் பற்றி ஒரு மதிப்பீட்டாளர் கேட்கிறார்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు హామీ ఇచ్చిన వ్యక్తి గురించి మోడరేటర్ అడుగుతున్నారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ดูแลกำลังสอบถามเรื่องคนที่คุณยืนยันให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir moderatör kefil olduğunuz biri hakkında soruyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модератор питає про людину, за яку ви поручилися"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ماڈریٹر اس شخص کے بارے میں پوچھ رہا ہے جس کی آپ نے ضمانت دی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người kiểm duyệt đang hỏi về người bạn đã bảo chứng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版主正在询问你担保的某个人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版主正在詢問你擔保的某個人"
          }
        }
      }
    },
    "push.vouch_strike": {
      "comment": "Push notification body, shown from the loc-key alone: it names nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرار بشأن حقك في التزكية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুপারিশ করার অধিকার নিয়ে একটি সিদ্ধান্ত"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisió sobre el teu dret a avalar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhodnutí o tvém právu ručit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afgørelse om din ret til at gå i god for andre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Entscheidung zu deinem Recht zu bürgen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόφαση για το δικαίωμά σου να εγγυάσαι"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decision about your right to vouch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión sobre tu derecho a avalar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätös takaamisoikeudestasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une décision sur votre droit de vous porter garant"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלטה לגבי הזכות שלך לערוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाउच करने के आपके अधिकार पर एक फ़ैसला"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odluka o tvom pravu na jamčenje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Döntés a kezeskedési jogodról"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan tentang hakmu menjamin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisione sul tuo diritto di garantire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証する権利についての判断があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증 자격에 관한 결정"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറപ്പുനൽകാനുള്ള നിങ്ങളുടെ അവകാശത്തെക്കുറിച്ചുള്ള ഒരു തീരുമാനം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan tentang hak anda untuk menjamin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avgjørelse om retten din til å garantere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beslissing over je recht om in te staan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decyzja o Twoim prawie do poręczania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma decisão sobre seu direito de avalizar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma decisão sobre o seu direito de avalizar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O decizie privind dreptul tău de a garanta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решение о вашем праве поручаться"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhodnutie o tvojom práve ručiť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett beslut om din rätt att intyga"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உத்தரவாதம் அளிக்கும் உங்கள் உரிமை பற்றிய முடிவு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హామీ ఇచ్చే మీ హక్కు గురించి నిర్ణయం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตัดสินเรื่องสิทธิ์ในการยืนยันให้ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olma hakkınızla ilgili bir karar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рішення щодо вашого права ручатися"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ضمانت دینے کے حق کے بارے میں فیصلہ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quyết định về quyền bảo chứng của bạn"
