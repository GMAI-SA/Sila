        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает людей, ожидающих подписки на вас"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí ľudí, ktorí čakajú na sledovanie teba"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar personerna som väntar på att följa dig"
