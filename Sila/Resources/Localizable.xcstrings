        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un partage un salon que vous avez animé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו משתף חדר שארחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके होस्ट किए रूम को शेयर करे।"
