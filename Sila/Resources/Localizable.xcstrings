    "account.handle.keep": {
      "comment": "Goes on with the random handle the account was given. %@ is that handle, e.g. @user7k2m9q4x.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبقاء على %@ حاليًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপাতত %@ রাখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva %@ de moment"
          }
        },
        "cs": {
