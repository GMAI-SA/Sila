            "value": "Skryť moje overené meno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj mitt verifierade namn"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் சரிபார்க்கப்பட்ட பெயரை மறை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా ధృవీకరించబడిన పేరును దాచు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนชื่อที่ยืนยันแล้วของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış adımı gizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховати моє верифіковане ім’я"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرا تصدیق شدہ نام چھپائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn tên đã xác minh của tôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏我的验证姓名"
          }
