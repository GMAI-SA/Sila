    "verification.method.nafath.comingSoonDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفاذ قادم قريبًا. حاليًا، وثّق هويتك بجواز سفرك أو بطاقة هويتك — يستغرق ذلك بضع دقائق ويراجعه أحد أفراد الفريق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath আসছে। আপাতত পাসপোর্ট বা আইডি কার্ড দিয়ে ভেরিফাই করুন — কয়েক মিনিট লাগে এবং একজন মানুষ যাচাই করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath està en camí. De moment, verifica't amb el passaport o el document d'identitat: triga uns minuts i el revisa una persona."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath je na cestě. Zatím se ověř pasem nebo občanským průkazem – trvá to pár minut a posuzuje to člověk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath er på vej. Verificér indtil videre med dit pas eller id-kort – det tager et par minutter, og et menneske gennemgår det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath ist unterwegs. Verifiziere dich vorerst mit Reisepass oder Ausweis – das dauert ein paar Minuten, und ein Mensch prüft es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Nafath έρχεται. Προς το παρόν, επαληθεύσου με διαβατήριο ή ταυτότητα — παίρνει λίγα λεπτά και το ελέγχει άνθρωπος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath is on its way. For now, verify with your passport or ID card — it takes a few minutes and a person reviews it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath está en camino. Por ahora, verifícate con tu pasaporte o documento de identidad: lleva unos minutos y lo revisa una persona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath on tulossa. Vahvista toistaiseksi passilla tai henkilökortilla – se vie muutaman minuutin ja ihminen tarkastaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath arrive. Pour l’instant, vérifiez-vous avec votre passeport ou votre carte d’identité — cela prend quelques minutes et une personne l’examine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath בדרך. לעת עתה, אמת עם הדרכון או תעודת הזהות שלך — זה לוקח כמה דקות ואדם בודק זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath आ रहा है। फ़िलहाल अपने पासपोर्ट या ID कार्ड से सत्यापित करें — इसमें कुछ मिनट लगते हैं और एक व्यक्ति इसकी समीक्षा करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath stiže uskoro. Za sada potvrdi putovnicom ili osobnom iskaznicom — traje nekoliko minuta i pregledava je osoba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nafath úton van. Addig hitelesíts útleveleddel vagy személyi igazolványoddal – néhány perc, és egy ember bírálja el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath segera hadir. Untuk sekarang, verifikasi dengan paspor atau kartu identitasmu — hanya beberapa menit dan diperiksa oleh manusia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath sta arrivando. Per ora verificati con il passaporto o la carta d'identità: ci vogliono pochi minuti e lo esamina una persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafathは近日対応予定です。今のところは、パスポートまたはIDカードで認証してください。数分で完了し、人が審査します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath가 곧 제공돼요. 지금은 여권이나 신분증 카드로 인증하세요. 몇 분이면 되고 사람이 검토해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath വരുന്നു. തൽക്കാലം പാസ്പോർട്ട് അല്ലെങ്കിൽ ഐഡി കാർഡ് ഉപയോഗിച്ച് വെരിഫൈ ചെയ്യുക — കുറച്ച് മിനിറ്റ് മതി, ഒരാൾ പരിശോധിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath akan tiba. Buat masa ini, sahkan dengan pasport atau kad pengenalan anda — ia mengambil masa beberapa minit dan seorang manusia menyemaknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath er på vei. Foreløpig kan du verifisere deg med pass eller ID-kort. Det tar noen minutter, og et menneske vurderer det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath komt eraan. Verifieer voorlopig met je paspoort of identiteitskaart: het duurt een paar minuten en een mens beoordeelt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath już wkrótce. Na razie zweryfikuj się paszportem lub dowodem osobistym — zajmie to kilka minut, a sprawdza to człowiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath está a caminho. Por enquanto, verifique-se com passaporte ou documento de identidade: leva poucos minutos e uma pessoa analisa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nafath está a caminho. Por agora, verifique-se com o passaporte ou cartão de cidadão — demora alguns minutos e é revisto por uma pessoa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath este pe drum. Deocamdată, verifică-te cu pașaportul sau cartea de identitate — durează câteva minute și o persoană îl analizează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath скоро появится. Пока подтвердите личность по паспорту или ID-карте — это займёт несколько минут, а проверяет человек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath je na ceste. Zatiaľ sa over pasom alebo preukazom totožnosti — trvá to pár minút a posudzuje to človek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath är på väg. Verifiera dig tills vidare med pass eller id-kort – det tar några minuter och en person granskar det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath விரைவில் வருகிறது. இப்போதைக்கு கடவுச்சீட்டு அல்லது அடையாள அட்டை மூலம் சரிபார்க்கலாம் — சில நிமிடங்களே ஆகும், ஒருவர் மதிப்பாய்வு செய்வார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath త్వరలో వస్తోంది. ప్రస్తుతానికి మీ పాస్‌పోర్ట్ లేదా ID కార్డ్‌తో ధృవీకరించండి — దీనికి కొన్ని నిమిషాలు పడుతుంది, ఒక వ్యక్తి సమీక్షిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath กำลังจะมา ตอนนี้ให้ยืนยันด้วยหนังสือเดินทางหรือบัตรประจำตัว ใช้เวลาไม่กี่นาทีและมีคนตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath yolda. Şimdilik pasaportunuz veya kimlik kartınızla doğrulayın; birkaç dakika sürer ve bir insan inceler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath уже в дорозі. Поки що верифікуйтеся за паспортом або ID-карткою — це займе кілька хвилин, і перевіряє людина."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath جلد آ رہا ہے۔ فی الحال اپنے پاسپورٹ یا شناختی کارڈ سے تصدیق کریں — اس میں چند منٹ لگتے ہیں اور ایک شخص اس کا جائزہ لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath đang trên đường đến. Hiện tại, hãy xác minh bằng hộ chiếu hoặc thẻ căn cước — chỉ mất vài phút và có người xét duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 即将推出。目前请使用护照或身份证验证，只需几分钟，并由真人审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath 即將推出。目前請使用護照或身分證驗證，只需幾分鐘，並由真人審核。"
          }
        }
      }
    },
    "verification.method.nafath.detail": {
      "comment": "Option detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هوية وطنية سعودية أو إقامة. فوري — تؤكد رقمًا في تطبيق نفاذ. الطريقة لكل من في السعودية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সৌদি জাতীয় পরিচয় বা Iqama। তাৎক্ষণিক — আপনি Nafath অ্যাপে একটি নম্বর নিশ্চিত করেন। সৌদি আরবের সবার জন্য এই পথ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Document nacional d'identitat saudita o Iqama. Instantani: confirmes un número a l'app Nafath. La via per a tothom a l'Aràbia Saudita."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Saúdské National ID nebo Iqama. Okamžitě – potvrdíš číslo v aplikaci Nafath. Cesta pro všechny v Saúdské Arábii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudisk nationalt id eller Iqama. Øjeblikkeligt – du bekræfter et nummer i Nafath-appen. Vejen for alle i Saudi-Arabien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudische National ID oder Iqama. Sofort – du bestätigst eine Nummer in der Nafath-App. Der Weg für alle in Saudi-Arabien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαουδαραβικό National ID ή Iqama. Άμεσο — επιβεβαιώνεις έναν αριθμό στην εφαρμογή Nafath. Η διαδρομή για όλους στη Σαουδική Αραβία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudi National ID or Iqama. Instant — you confirm a number in the Nafath app. The route for everyone in Saudi Arabia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "National ID o Iqama saudí. Instantáneo: confirmas un número en la app de Nafath. La vía para todos en Arabia Saudí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudi-Arabian henkilökortti tai Iqama. Välitön – vahvistat numeron Nafath-sovelluksessa. Reitti kaikille Saudi-Arabiassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte nationale saoudienne ou Iqama. Instantané — vous confirmez un numéro dans l’app Nafath. La voie pour toute personne en Arabie saoudite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעודת זהות לאומית סעודית או Iqama. מיידי — אתה מאשר מספר באפליקציית Nafath. הדרך לכל מי שבערב הסעודית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सऊदी राष्ट्रीय ID या Iqama। तुरंत — आप Nafath ऐप में एक नंबर की पुष्टि करते हैं। सऊदी अरब में हर किसी के लिए यही रास्ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudijska nacionalna osobna iskaznica ili Iqama. Trenutačno — potvrđuješ broj u aplikaciji Nafath. Put za sve u Saudijskoj Arabiji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szaúdi személyi azonosító vagy Iqama. Azonnali – egy számot erősítesz meg a Nafath appban. A Szaúd-Arábiában élők útja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ID Nasional atau Iqama Saudi. Instan — kamu mengonfirmasi nomor di app Nafath. Jalur untuk semua orang di Arab Saudi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carta d'identità nazionale saudita o Iqama. Immediato: confermi un numero nell'app Nafath. La strada per chiunque si trovi in Arabia Saudita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウジの国民IDまたはIqama。即時で、Nafathアプリで番号を確認するだけです。サウジアラビアにいる人はこの方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사우디 신분증 또는 Iqama. 즉시 처리돼요. Nafath 앱에서 번호를 확인하면 돼요. 사우디아라비아의 모든 사람을 위한 방법이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗദി നാഷണൽ ഐഡി അല്ലെങ്കിൽ Iqama. തൽക്ഷണം — Nafath ആപ്പിൽ ഒരു നമ്പർ സ്ഥിരീകരിക്കുക. സൗദി അറേബ്യയിലെ എല്ലാവർക്കുമുള്ള വഴി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "National ID atau Iqama Saudi. Serta-merta — anda mengesahkan nombor dalam app Nafath. Laluan untuk semua orang di Arab Saudi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudisk nasjonalt ID-kort eller Iqama. Umiddelbart: du bekrefter et nummer i Nafath-appen. Veien for alle i Saudi-Arabia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saoedische nationale ID of Iqama. Direct: je bevestigt een nummer in de Nafath-app. De route voor iedereen in Saoedi-Arabië."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudyjski dowód osobisty lub Iqama. Natychmiast — potwierdzasz numer w aplikacji Nafath. Droga dla wszystkich w Arabii Saudyjskiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidade Nacional saudita ou Iqama. Instantâneo: você confirma um número no app Nafath. O caminho para todos na Arábia Saudita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Documento Nacional ou Iqama saudita. Instantâneo — confirma um número na app Nafath. O caminho para todos na Arábia Saudita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "National ID saudit sau Iqama. Instantaneu — confirmi un număr în aplicația Nafath. Calea pentru toți cei din Arabia Saudită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Саудовский National ID или Iqama. Мгновенно — вы подтверждаете номер в приложении Nafath. Способ для всех в Саудовской Аравии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudský národný preukaz alebo Iqama. Okamžite — číslo potvrdíš v aplikácii Nafath. Cesta pre všetkých v Saudskej Arábii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saudiskt National ID eller Iqama. Direkt – du bekräftar ett nummer i Nafath-appen. Vägen för alla i Saudiarabien."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சவூதி தேசிய அடையாள அட்டை அல்லது Iqama. உடனடி — Nafath செயலியில் ஒரு எண்ணை உறுதிப்படுத்துவீர்கள். சவூதி அரேபியாவில் உள்ள அனைவருக்கும் உரிய வழி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సౌదీ నేషనల్ ID లేదా Iqama. తక్షణం — Nafath యాప్‌లో ఒక నంబర్‌ను నిర్ధారిస్తారు. సౌదీ అరేబియాలో ఉన్న అందరికీ ఈ మార్గం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัตรประจำตัวประชาชนซาอุดีอาระเบียหรือ Iqama ทันที คุณยืนยันหมายเลขในแอป Nafath เป็นเส้นทางสำหรับทุกคนในซาอุดีอาระเบีย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suudi Ulusal Kimliği veya Iqama. Anında; Nafath uygulamasında bir numarayı onaylarsınız. Suudi Arabistan'daki herkes için yol."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Національний ID Саудівської Аравії або Iqama. Миттєво — ви підтверджуєте номер у застосунку Nafath. Шлях для всіх у Саудівській Аравії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سعودی قومی شناختی کارڈ یا Iqama۔ فوری — آپ Nafath ایپ میں ایک نمبر کی تصدیق کرتے ہیں۔ سعودی عرب میں ہر کسی کا راستہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Căn cước quốc gia hoặc Iqama của Ả Rập Xê Út. Tức thì — bạn xác nhận một số trong ứng dụng Nafath. Con đường dành cho mọi người ở Ả Rập Xê Út."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙特国民身份证或 Iqama。即时完成，你只需在 Nafath 应用中确认一个数字。这是沙特阿拉伯所有人的验证途径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙烏地國民身分證或 Iqama。即時完成，你只需在 Nafath App 中確認一個號碼。這是沙烏地阿拉伯所有人的驗證途徑。"
          }
        }
      }
    },
