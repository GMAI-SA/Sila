    "document.mismatch.birthdate.message": {
      "comment": "Mismatch body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تاريخ الميلاد في هذه الوثيقة ليس التاريخ الذي أدخلته. لم يُرسل شيء. إن أخطأت في اختيار التاريخ فغيّره؛ وإن كانت الصورة لوثيقة أخرى فأعد التقاطها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নথির জন্মতারিখ আপনার দেওয়া তারিখ নয়। কিছুই পাঠানো হয়নি। চাকা ভুল ঘুরে থাকলে তারিখ বদলান; ভুল নথির ছবি হলে আবার তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La data de naixement d'aquest document no és la que has introduït. No s'ha enviat res. Si t'has equivocat amb la ruleta, canvia la data; si la foto és d'un altre document, repeteix-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum narození na tomto dokladu není to, které jsi zadal. Nic nebylo odesláno. Pokud ses překlepl, datum změň; pokud je fotka špatného dokladu, vyfoť znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdatoen på dette dokument er ikke den, du angav. Intet er sendt. Hvis hjulet gled, så ret datoen. Hvis fotoet er af det forkerte dokument, så tag det om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geburtsdatum in diesem Dokument ist nicht das, das du eingegeben hast. Es wurde nichts gesendet. Wenn du dich vertippt hast, ändere das Datum; wenn das Foto das falsche Dokument zeigt, nimm es neu auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ημερομηνία γέννησης σε αυτό το έγγραφο δεν είναι αυτή που εισήγαγες. Δεν στάλθηκε τίποτα. Αν γλίστρησε ο επιλογέας, άλλαξε την ημερομηνία· αν η φωτογραφία είναι από λάθος έγγραφο, τράβηξέ την ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date of birth on this document isn't the one you entered. Nothing has been sent. If the wheel slipped, change the date; if the photo is of the wrong document, retake it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de nacimiento de este documento no es la que introdujiste. No se ha enviado nada. Si te equivocaste al elegir la fecha, cámbiala; si la foto es de otro documento, vuelve a hacerla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän asiakirjan syntymäaika ei ole sama kuin antamasi. Mitään ei ole lähetetty. Jos valitsin lipsahti, muuta päivämäärää; jos kuva on väärästä asiakirjasta, ota se uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de naissance de ce document n’est pas celle que vous avez saisie. Rien n’a été envoyé. Si la molette a glissé, modifiez la date ; si la photo montre le mauvais document, reprenez-la."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך הלידה במסמך הזה אינו זה שהזנת. שום דבר לא נשלח. אם הגלגל החליק, שנה את התאריך; אם התמונה היא של מסמך שגוי, צלם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दस्तावेज़ की जन्म तिथि वह नहीं है जो आपने दर्ज की थी। कुछ भी भेजा नहीं गया है। अगर तारीख़ चुनते समय चूक हुई तो तारीख़ बदलें; अगर फ़ोटो ग़लत दस्तावेज़ की है तो दोबारा लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum rođenja na ovoj ispravi nije onaj koji si unio/unijela. Ništa nije poslano. Ako je kotačić skliznuo, promijeni datum; ako je fotografija krive isprave, ponovno je snimi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányon szereplő születési dátum nem az, amelyet megadtál. Semmit nem küldtünk el. Ha elcsúszott a görgető, módosítsd a dátumot; ha rossz okmányról készült a fotó, fényképezd le újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal lahir pada dokumen ini bukan yang kamu masukkan. Belum ada yang terkirim. Jika roda pemilih tergelincir, ubah tanggalnya; jika fotonya dokumen yang salah, ambil ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di nascita su questo documento non è quella che hai inserito. Non è stato inviato nulla. Se hai sbagliato a girare la ruota, cambia la data; se la foto è del documento sbagliato, rifalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類の生年月日が、入力されたものと一致しません。何も送信されていません。選択を間違えた場合は日付を変更し、書類を間違えた場合は撮り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서의 생년월일이 입력한 생년월일과 달라요. 아무것도 전송되지 않았어요. 날짜를 잘못 맞췄다면 날짜를 바꾸고, 다른 문서를 촬영했다면 다시 촬영하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ രേഖയിലെ ജനനത്തീയതി നിങ്ങൾ നൽകിയതല്ല. ഒന്നും അയച്ചിട്ടില്ല. വീൽ തെറ്റിപ്പോയെങ്കിൽ തീയതി മാറ്റുക; തെറ്റായ രേഖയുടെ ഫോട്ടോയാണെങ്കിൽ വീണ്ടും എടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh lahir pada dokumen ini bukan yang anda masukkan. Tiada apa-apa telah dihantar. Jika roda tergelincir, tukar tarikh; jika foto itu bagi dokumen yang salah, ambil semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fødselsdatoen på dette dokumentet er ikke den du skrev inn. Ingenting er sendt. Hvis du snurret feil på hjulet, endrer du datoen. Hvis bildet er av feil dokument, tar du det på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geboortedatum op dit document is niet degene die je hebt ingevoerd. Er is niets verstuurd. Als je een verkeerde datum hebt ingesteld, wijzig die dan; als de foto van het verkeerde document is, maak hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data urodzenia na tym dokumencie nie jest tą, którą wpisałeś. Nic nie zostało wysłane. Jeśli kółko się omsknęło, zmień datę; jeśli zdjęcie dotyczy złego dokumentu, zrób je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de nascimento neste documento não é a que você informou. Nada foi enviado. Se a roda escorregou, altere a data; se a foto é do documento errado, tire-a de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de nascimento neste documento não é a que introduziu. Nada foi enviado. Se se enganou ao escolher a data, altere-a; se a foto é do documento errado, repita-a."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Data nașterii de pe acest document nu este cea introdusă de tine. Nu s-a trimis nimic. Dacă ai greșit la selector, schimbă data; dacă fotografia este a altui document, fă-o din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата рождения в этом документе не совпадает с введённой вами. Ничего не отправлено. Если вы ошиблись при выборе даты — исправьте её; если сфотографировали не тот документ — переснимите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum narodenia na tomto doklade nie je ten, ktorý si zadal. Nič sa neodoslalo. Ak sa kolieska pošmykli, zmeň dátum; ak je fotka nesprávneho dokladu, odfoť ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Födelsedatumet på det här dokumentet är inte det du angav. Inget har skickats. Om du råkade ställa fel, ändra datumet; om fotot är på fel dokument, ta om det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆவணத்தில் உள்ள பிறந்த தேதி நீங்கள் உள்ளிட்டது அல்ல. எதுவும் அனுப்பப்படவில்லை. சக்கரம் தவறியிருந்தால் தேதியை மாற்றுங்கள்; தவறான ஆவணத்தின் புகைப்படம் என்றால் மீண்டும் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పత్రంలోని పుట్టిన తేదీ మీరు నమోదు చేసినది కాదు. ఏదీ పంపబడలేదు. వీల్ జారితే తేదీని మార్చండి; ఫోటో తప్పు పత్రానిది అయితే మళ్లీ తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันเกิดบนเอกสารนี้ไม่ใช่วันที่คุณกรอก ยังไม่มีการส่งอะไร หากหมุนตัวเลือกพลาด ให้เปลี่ยนวันที่ หากรูปเป็นเอกสารผิดใบ ให้ถ่ายใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu belgedeki doğum tarihi sizin girdiğiniz tarih değil. Hiçbir şey gönderilmedi. Çark kaydıysa tarihi değiştirin; fotoğraf yanlış belgeye aitse yeniden çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата народження в цьому документі не та, яку ви ввели. Нічого не надіслано. Якщо ви помилилися з датою, змініть її; якщо фото не того документа, зробіть його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دستاویز پر تاریخ پیدائش وہ نہیں جو آپ نے درج کی۔ کچھ بھیجا نہیں گیا۔ اگر پہیہ پھسل گیا تھا تو تاریخ بدلیں؛ اگر تصویر غلط دستاویز کی ہے تو دوبارہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày sinh trên giấy tờ này không phải ngày bạn đã nhập. Chưa có gì được gửi. Nếu bạn chọn nhầm ngày, hãy đổi ngày; nếu ảnh chụp nhầm giấy tờ, hãy chụp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此证件上的出生日期与你输入的不一致。尚未发送任何内容。如果是滚轮选错了，请更改日期；如果拍错了证件，请重拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件上的出生日期與你輸入的不同，尚未送出任何內容。如果是選錯了日期，請修改；如果拍成了錯誤的證件，請重拍。"
          }
        }
      }
    },
