    "guest.room.chat.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصفتك زائرًا، ترى ما يُقال أثناء وجودك هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতিথি হিসেবে আপনি যতক্ষণ আছেন ততক্ষণ যা বলা হয় তা-ই দেখতে পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a convidat, veus el que es diu mentre ets aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako host vidíš, co se řekne, dokud tu jsi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som gæst ser du det, der bliver sagt, mens du er her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Gast siehst du, was gesagt wird, solange du hier bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ως επισκέπτης βλέπεις ό,τι λέγεται όσο είσαι εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a guest you see what's said while you're here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como invitado ves lo que se dice mientras estás aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieraana näet sen, mitä sanotaan, kun olet paikalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En tant qu’invité, vous voyez ce qui se dit pendant votre présence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאורח אתה רואה את מה שנאמר בזמן שאתה כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेहमान के रूप में आप वही देखते हैं जो आपके यहाँ रहते हुए कहा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao gost vidiš što se govori dok si ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendégként azt látod, ami elhangzik, amíg itt vagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagai tamu, kamu melihat apa yang dikatakan selama kamu di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come ospite vedi ciò che viene detto mentre sei qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストには、参加している間に話されたことが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트는 접속해 있는 동안 오가는 말만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതിഥിയായി, നിങ്ങൾ ഇവിടെയുള്ളപ്പോൾ പറയുന്നത് മാത്രമേ കാണൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagai tetamu, anda melihat apa yang dikatakan semasa anda berada di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som gjest ser du det som sies mens du er her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gast zie je wat er gezegd wordt zolang je erbij bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako gość widzisz to, co zostanie powiedziane, gdy tu jesteś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como visitante, você vê o que é dito enquanto está aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como convidado, vê o que é dito enquanto está aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca invitat vezi ce se spune cât timp ești aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как гость вы видите то, что говорят, пока вы здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako hosť vidíš, čo sa povie, kým si tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som gäst ser du det som sägs medan du är här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருந்தினராக, நீங்கள் இங்கே இருக்கும்போது சொல்லப்படுவதை மட்டுமே பார்ப்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అతిథిగా మీరు ఇక్కడ ఉన్నప్పుడు చెప్పినవి మాత్రమే చూస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในฐานะผู้เยี่ยมชม คุณเห็นสิ่งที่พูดระหว่างที่คุณอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Misafir olarak, burada olduğunuz sürede söylenenleri görürsünüz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як гість, ви бачите те, що говориться, поки ви тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بطور مہمان آپ وہی دیکھتے ہیں جو آپ کی موجودگی میں کہا جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Là khách, bạn thấy những gì được nói trong lúc bạn có mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为访客，你只能看到你在场期间的发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身為訪客，你只能看到你在場期間的發言。"
          }
        }
      }
    },
    "guest.room.listening.join": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتحدث أو رفع اليد أو التفاعل أو الدردشة، انضم إلى «معروف»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা বলতে, হাত তুলতে, রিঅ্যাক্ট করতে বা চ্যাট করতে Known-এ যোগ দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per parlar, aixecar la mà, reaccionar o xatejar, uneix-te a Known."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chceš-li mluvit, hlásit se, reagovat nebo chatovat, připoj se k aplikaci Known."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltag i Known for at tale, række hånden op, reagere eller chatte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt Known bei, um zu sprechen, die Hand zu heben, zu reagieren oder zu chatten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να μιλήσεις, να σηκώσεις χέρι, να αντιδράσεις ή να συνομιλήσεις, γράψου στο Known."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To speak, raise a hand, react or chat, join Known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hablar, levantar la mano, reaccionar o chatear, únete a Known."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liity Knowniin puhuaksesi, nostaaksesi kättä, reagoidaksesi tai keskustellaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour parler, lever la main, réagir ou discuter, rejoignez Known."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לדבר, להרים יד, להגיב או לשוחח, הצטרף ל-Known."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलने, हाथ उठाने, रिएक्ट करने या चैट करने के लिए Known से जुड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za govor, podizanje ruke, reagiranje ili čavrljanje pridruži se aplikaciji Known."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megszólaláshoz, jelentkezéshez, reagáláshoz vagy csevegéshez csatlakozz a Knownhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk berbicara, mengangkat tangan, bereaksi, atau mengobrol, gabung Known."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per parlare, alzare la mano, reagire o chattare, iscriviti a Known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発言、挙手、リアクション、チャットをするには、Knownに参加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하기, 손들기, 반응, 채팅을 하려면 Known에 가입하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംസാരിക്കാനും കൈ ഉയർത്താനും പ്രതികരിക്കാനും ചാറ്റ് ചെയ്യാനും Known-ൽ ചേരുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bercakap, mengangkat tangan, bereaksi atau berbual, sertai Known."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli med på Known for å snakke, rekke opp hånden, reagere eller chatte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan bij Known om te spreken, een hand op te steken, te reageren of te chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby mówić, podnieść rękę, reagować lub czatować, dołącz do Known."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para falar, levantar a mão, reagir ou conversar, entre no Known."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para falar, levantar a mão, reagir ou conversar, entre na Known."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vorbi, a ridica mâna, a reacționa sau a scrie în chat, alătură-te Known."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы говорить, поднимать руку, реагировать или писать в чат, присоединитесь к Known."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš hovoriť, hlásiť sa, reagovať alebo písať do četu, pripoj sa k Known."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå med i Known för att tala, räcka upp handen, reagera eller chatta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச, கை உயர்த்த, எதிர்வினையாற்ற அல்லது அரட்டையடிக்க Known-இல் சேருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాట్లాడటానికి, చేయి ఎత్తడానికి, రియాక్ట్ అవ్వడానికి లేదా చాట్ చేయడానికి Knownలో చేరండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการพูด ยกมือ แสดงรีแอกชัน หรือแชท ให้เข้าร่วม Known"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmak, el kaldırmak, tepki vermek veya sohbet etmek için Known'a katılın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб говорити, піднімати руку, реагувати чи писати в чат, приєднайтеся до Known."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولنے، ہاتھ اٹھانے، ردعمل دینے یا چیٹ کے لیے Known میں شامل ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để phát biểu, giơ tay, bày tỏ cảm xúc hoặc trò chuyện, hãy tham gia Known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要发言、举手、回应或聊天，请加入 Known。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 Known 即可發言、舉手、回應或聊天。"
          }
        }
      }
    },
    "guest.room.listening.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يراك أحد في الغرفة، ولم يطلب معروف الميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমের কেউ আপনাকে দেখতে পায় না, আর Known আপনার মাইক্রোফোন চায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú de la sala et pot veure, i Known no t'ha demanat el micròfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo v místnosti tě nevidí a Known nežádala o tvůj mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen i rummet kan se dig, og Known har ikke bedt om din mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand im Raum kann dich sehen, und Known hat nicht nach deinem Mikrofon gefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς στην αίθουσα δεν μπορεί να σε δει και το Known δεν έχει ζητήσει το μικρόφωνό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody in the room can see you, and Known hasn't asked for your microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie en la sala puede verte y Known no te ha pedido el micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan huoneessa ei näe sinua, eikä Known ole pyytänyt mikrofoniasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne dans le salon ne peut vous voir, et Known n’a pas demandé l’accès à votre micro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אחד בחדר לא יכול לראות אותך, ו-Known לא ביקשה את המיקרופון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम में कोई आपको नहीं देख सकता, और Known ने आपका माइक्रोफ़ोन नहीं माँगा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko u sobi ne može te vidjeti, a Known nije zatražila tvoj mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szobában senki nem lát téged, és a Known nem kérte a mikrofonodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang di room bisa melihatmu, dan Known tidak meminta mikrofonmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno nella stanza può vederti e Known non ha chiesto il tuo microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームの誰にもあなたは見えず、Knownがマイクを求めることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸의 누구도 나를 볼 수 없고, Known은 마이크를 요청하지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമിലെ ആർക്കും നിങ്ങളെ കാണാനാവില്ല, Known നിങ്ങളുടെ മൈക്രോഫോൺ ചോദിച്ചിട്ടുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada sesiapa dalam bilik dapat melihat anda, dan Known tidak meminta mikrofon anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen i rommet kan se deg, og Known har ikke bedt om mikrofonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand in de room kan je zien, en Known heeft niet om je microfoon gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt w pokoju Cię nie widzi, a Known nie prosiła o dostęp do Twojego mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém na sala pode ver você, e o Known não pediu acesso ao seu microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém na sala o consegue ver, e a Known não pediu o seu microfone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni din cameră nu te poate vedea, iar Known nu ți-a cerut microfonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто в комнате вас не видит, а Known не запрашивала доступ к вашему микрофону."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikto v miestnosti ťa nevidí a Known si nevyžiadala tvoj mikrofón."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen i rummet kan se dig, och Known har inte bett om din mikrofon."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறையில் யாருக்கும் நீங்கள் தெரியமாட்டீர்கள், Known உங்கள் மைக்ரோஃபோனைக் கேட்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లో ఎవరూ మిమ్మల్ని చూడలేరు, Known మీ మైక్రోఫోన్‌ను అడగలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีใครในห้องเห็นคุณ และ Known ไม่ได้ขอใช้ไมโครโฟนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odadaki kimse sizi göremez ve Known mikrofonunuzu istemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніхто в кімнаті вас не бачить, а Known не запитувала доступу до вашого мікрофона."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم میں کوئی آپ کو نہیں دیکھ سکتا، اور Known نے آپ کا مائیکروفون نہیں مانگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai trong phòng thấy bạn, và Known chưa xin dùng micro của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间里没有人能看到你，Known 也没有请求使用你的麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室裡沒有人看得到你，Known 也沒有要求使用你的麥克風。"
          }
        }
      }
    },
