    "account.delete.open.hint": {
      "comment": "VoiceOver hint for opening the deletion form.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح نموذج الحذف، وهو يشرح ما سيحدث ويطلب كلمة مرورك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে ফেলার ফর্ম খোলে, যেখানে কী হবে তা বলা আছে এবং পাসওয়ার্ড চাওয়া হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el formulari d'eliminació, que explica què passa i et demana la contrasenya"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře formulář pro smazání, který vysvětlí, co se stane, a požádá o heslo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner sletteformularen, som forklarer, hvad der sker, og beder om din adgangskode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Löschformular, das erklärt, was passiert, und nach deinem Passwort fragt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τη φόρμα διαγραφής, που εξηγεί τι συμβαίνει και ζητά τον κωδικό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the deletion form, which explains what happens and asks for your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el formulario de eliminación, que explica qué ocurre y pide tu contraseña"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa poistolomakkeen, joka kertoo mitä tapahtuu ja pyytää salasanaasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le formulaire de suppression, qui explique ce qui se passe et demande votre mot de passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את טופס המחיקה, שמסביר מה קורה ומבקש את הסיסמה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने का फ़ॉर्म खोलता है, जो बताता है कि क्या होगा और आपका पासवर्ड माँगता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara obrazac za brisanje, koji objašnjava što se događa i traži tvoju lozinku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a törlési űrlapot, amely elmagyarázza, mi fog történni, és kéri a jelszavadat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka formulir penghapusan, yang menjelaskan apa yang terjadi dan meminta kata sandimu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il modulo di eliminazione, che spiega cosa succede e chiede la password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除の内容を説明し、パスワードを求めるフォームを開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 일이 일어나는지 설명하고 비밀번호를 묻는 삭제 양식을 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്ത് സംഭവിക്കുമെന്ന് വിശദീകരിക്കുകയും പാസ്‌വേഡ് ചോദിക്കുകയും ചെയ്യുന്ന ഇല്ലാതാക്കൽ ഫോം തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka borang pemadaman yang menerangkan apa yang berlaku dan meminta kata laluan anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner slettingsskjemaet, som forklarer hva som skjer og ber om passordet ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent het verwijderformulier, dat uitlegt wat er gebeurt en om je wachtwoord vraagt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera formularz usuwania, który wyjaśnia, co się stanie, i prosi o hasło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o formulário de exclusão, que explica o que acontece e pede sua senha"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o formulário de eliminação, que explica o que acontece e pede a sua palavra-passe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide formularul de ștergere, care explică ce se întâmplă și cere parola"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает форму удаления: в ней объясняется, что произойдёт, и запрашивается пароль"
