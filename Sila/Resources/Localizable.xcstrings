    "post.reply.blocked.country": {
      "comment": "Why the viewer cannot reply to a country thread. First %@ is the flag, second the country.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الرد على هذه السلسلة إلا للحسابات الموثّقة في %@ %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই থ্রেডে শুধু %1$@ %2$@-এ ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els comptes verificats a %@ %@ poden respondre a aquest fil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na toto vlákno mohou odpovídat jen účty ověřené v zemi: %@ %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun verificerede konti fra %@ %@ kan svare i denne tråd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in %2$@ verifizierte Konten (%1$@) können auf diesen Thread antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο λογαριασμοί επαληθευμένοι σε: %@ %@ μπορούν να απαντήσουν σε αυτό το νήμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %@ %@-verified accounts can reply to this thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las cuentas verificadas en %2$@ %1$@ pueden responder a este hilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain %@ %@ -vahvistetut tilit voivat vastata tähän ketjuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les comptes vérifiés %@ %@ peuvent répondre à cette discussion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חשבונות שאומתו ב-%@ %@ יכולים להגיב לשרשור הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस थ्रेड पर केवल %@ %@ में सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovu nit mogu odgovarati samo računi potvrđeni u zemlji: %1$@ %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a szálra csak a következő országban hitelesített fiókok válaszolhatnak: %@ %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akun terverifikasi %@ %@ yang bisa membalas utas ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli account verificati %@ %@ possono rispondere a questa discussione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスレッドに返信できるのは、%@ %@で認証されたアカウントだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@에서 인증된 계정만 이 스레드에 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@-ൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ ഈ ത്രെഡിന് മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akaun %@ %@ yang disahkan boleh membalas utas ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare kontoer verifisert i %@ %@ kan svare på denne tråden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen accounts die in %@ %@ zijn geverifieerd kunnen op deze thread reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ten wątek mogą odpowiadać tylko konta zweryfikowane w kraju: %@ %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contas verificadas em %@ %@ podem responder a este fio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contas verificadas %@ %@ podem responder a esta conversa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar conturile %@ verificate în %@ pot răspunde la această conversație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечать на эту ветку могут только аккаунты, проверенные в стране: %@ %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na toto vlákno môžu odpovedať iba účty overené v krajine %@ %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara konton verifierade i %@ %@ kan svara i den här tråden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ இல் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே இந்த உரையாடலுக்குப் பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@లో ధృవీకరించబడిన ఖాతాలు మాత్రమే ఈ థ్రెడ్‌కు రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะบัญชี %@ %@ ที่ยืนยันตัวตนแล้วเท่านั้นที่ตอบกลับเธรดนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuşmaya yalnızca %@ %@ doğrulamalı hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідати на це обговорення можуть лише облікові записи, верифіковані як %@ %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تھریڈ کا جواب صرف %1$@ %2$@ کے تصدیق شدہ اکاؤنٹ دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tài khoản đã xác minh %@ %@ mới trả lời được chuỗi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 %1$@ %2$@ 已验证的账户可以回复此对话串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 %@ %@ 已驗證的帳號能回覆此串文。"
          }
        }
      }
    },
    "post.reply.blocked.countryUnknown": {
      "comment": "Why the viewer cannot reply, when the country is unnamed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الرد إلا للحسابات الموثّقة في دولة هذه السلسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই থ্রেডের দেশে ভেরিফায়েড অ্যাকাউন্টরাই শুধু উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els comptes verificats al país d'aquest fil poden respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat mohou jen účty ověřené v zemi tohoto vlákna."
          }
        },
        "da": {
          "stringUnit": {
