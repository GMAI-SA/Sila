    "account.password.outcome": {
      "comment": "What a password change did, including to this device.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت كلمة مرورك. وسُجّل الخروج من كل الأجهزة — بما فيها هذا الجهاز، الذي سيطلب كلمة مرورك الجديدة عند تحديث الجلسة القادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসওয়ার্ড বদলেছে। সাইন ইন করা প্রতিটি ডিভাইস সাইন আউট হয়েছে — এটিসহ, যা পরের বার সেশন রিফ্রেশ করার সময় নতুন পাসওয়ার্ড চাইবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva contrasenya ha canviat. S'ha tancat la sessió a tots els dispositius, també en aquest, que et demanarà la contrasenya nova la propera vegada que actualitzi la sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo bylo změněno. Všechna přihlášená zařízení byla odhlášena – včetně tohoto, které si při příštím obnovení relace vyžádá nové heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din adgangskode er ændret. Alle loggede enheder blev logget ud – også denne, som vil bede om din nye adgangskode, næste gang sessionen opdateres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort wurde geändert. Alle angemeldeten Geräte wurden abgemeldet – auch dieses, das beim nächsten Aktualisieren der Sitzung nach deinem neuen Passwort fragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός σου άλλαξε. Όλες οι συνδεδεμένες συσκευές αποσυνδέθηκαν — και αυτή, που θα ζητήσει τον νέο κωδικό την επόμενη φορά που θα ανανεώσει τη συνεδρία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is changed. Every signed-in device was signed out — including this one, which will ask for your new password the next time it refreshes the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña ha cambiado. Se cerró la sesión en todos los dispositivos, incluido este, que pedirá tu nueva contraseña la próxima vez que actualice la sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanasi on vaihdettu. Kaikki sisäänkirjautuneet laitteet kirjattiin ulos – myös tämä, joka pyytää uutta salasanaasi seuraavan kerran, kun se päivittää istunnon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe a été modifié. Tous les appareils connectés ont été déconnectés — y compris celui-ci, qui demandera votre nouveau mot de passe à la prochaine actualisation de la session."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה שלך שונתה. כל המכשירים המחוברים נותקו — כולל זה, שיבקש את הסיסמה החדשה בפעם הבאה שיחדש את ההתחברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड बदल गया। साइन इन किए हुए हर डिवाइस को साइन आउट कर दिया गया — इस डिवाइस को भी, जो अगली बार सेशन रिफ़्रेश करते समय आपका नया पासवर्ड माँगेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lozinka je promijenjena. Svi prijavljeni uređaji su odjavljeni — uključujući ovaj, koji će tražiti novu lozinku pri sljedećem osvježavanju sesije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszavad megváltozott. Minden bejelentkezett eszközről kijelentkeztettünk – erről is, amely a munkamenet következő frissítésekor az új jelszavadat fogja kérni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandimu sudah diubah. Semua perangkat yang masuk telah dikeluarkan — termasuk yang ini, yang akan meminta kata sandi baru saat sesinya diperbarui berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua password è cambiata. Tutti i dispositivi connessi sono stati disconnessi, compreso questo, che chiederà la nuova password al prossimo aggiornamento della sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを変更しました。サインイン中のすべてのデバイスがサインアウトされました。このデバイスも含まれ、次にセッションを更新するときに新しいパスワードが求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 변경되었어요. 로그인된 모든 기기에서 로그아웃되었으며, 이 기기도 다음에 세션을 새로 고칠 때 새 비밀번호를 요청해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാസ്‌വേഡ് മാറ്റി. സൈൻ ഇൻ ചെയ്ത എല്ലാ ഉപകരണങ്ങളും സൈൻ ഔട്ട് ആയി — ഇതും ഉൾപ്പെടെ; അടുത്ത തവണ സെഷൻ പുതുക്കുമ്പോൾ ഇത് പുതിയ പാസ്‌വേഡ് ചോദിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan anda telah ditukar. Setiap peranti yang log masuk telah dilog keluar — termasuk yang ini, yang akan meminta kata laluan baharu anda apabila ia menyegarkan sesi seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet ditt er endret. Alle påloggede enheter ble logget ut, også denne, som vil be om det nye passordet neste gang den fornyer økten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord is gewijzigd. Alle ingelogde apparaten zijn uitgelogd, ook dit apparaat, dat om je nieuwe wachtwoord vraagt als de sessie de volgende keer wordt vernieuwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło zostało zmienione. Wszystkie zalogowane urządzenia zostały wylogowane — również to, które poprosi o nowe hasło przy następnym odświeżeniu sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha foi alterada. Todos os dispositivos conectados foram desconectados, inclusive este, que vai pedir a nova senha na próxima vez que atualizar a sessão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua palavra-passe foi alterada. A sessão foi terminada em todos os dispositivos — incluindo este, que pedirá a nova palavra-passe da próxima vez que atualizar a sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola ta a fost schimbată. Toate dispozitivele conectate au fost deconectate — inclusiv acesta, care va cere noua parolă data viitoare când își reîmprospătează sesiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль изменён. Все устройства, где вы были авторизованы, вышли из аккаунта, включая это — оно запросит новый пароль при следующем обновлении сеанса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje heslo bolo zmenené. Všetky prihlásené zariadenia boli odhlásené — aj toto, ktoré si pri najbližšom obnovení relácie vypýta tvoje nové heslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt lösenord har ändrats. Alla inloggade enheter loggades ut – även den här, som frågar efter ditt nya lösenord nästa gång sessionen förnyas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல் மாற்றப்பட்டது. உள்நுழைந்த எல்லாச் சாதனங்களும் வெளியேற்றப்பட்டன — இதுவும் உட்பட; அமர்வைப் புதுப்பிக்கும்போது இது புதிய கடவுச்சொல்லைக் கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాస్‌వర్డ్ మారింది. సైన్ ఇన్ అయిన ప్రతి పరికరం సైన్ అవుట్ అయింది — ఇది కూడా; సెషన్‌ను రిఫ్రెష్ చేసినప్పుడు ఇది మీ కొత్త పాస్‌వర్డ్‌ను అడుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนรหัสผ่านของคุณแล้ว ทุกอุปกรณ์ที่ลงชื่อเข้าใช้ถูกออกจากระบบ รวมถึงเครื่องนี้ ซึ่งจะขอรหัสผ่านใหม่ในครั้งถัดไปที่รีเฟรชเซสชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreniz değiştirildi. Oturum açık olan tüm cihazların oturumu kapatıldı; bu cihaz da dahil, oturumu bir sonraki yenilediğinde yeni şifrenizi isteyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль змінено. Усі пристрої, на яких ви були в системі, вийшли з неї — зокрема й цей, який попросить новий пароль під час наступного оновлення сеансу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پاس ورڈ تبدیل ہو گیا۔ سائن اِن کی ہوئی ہر ڈیوائس سائن آؤٹ ہو گئی — یہ والی بھی، جو سیشن اگلی بار تازہ کرتے وقت آپ سے نیا پاس ورڈ مانگے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu của bạn đã được đổi. Mọi thiết bị đang đăng nhập đã bị đăng xuất — kể cả thiết bị này, sẽ yêu cầu mật khẩu mới vào lần làm mới phiên tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密码已更改。所有已登录的设备都已退出登录，包括这一台；它在下次刷新会话时会要求输入新密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密碼已變更。所有已登入的裝置都已登出，包括這一支，它在下次更新工作階段時會要求輸入新密碼。"
          }
        }
      }
    },
    "account.password.repeat.hint": {
      "comment": "VoiceOver hint for the repeat-password field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب مرتين حتى لا يقفل عليك خطأ مطبعي حسابك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুবার লেখা হয় যাতে ভুলে আপনি আটকে না যান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrita dues vegades perquè un error no et deixi fora"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadává se dvakrát, aby tě překlep nezamkl"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrives to gange, så en slåfejl ikke låser dig ude"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal eingegeben, damit ein Tippfehler dich nicht aussperrt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογείται δύο φορές ώστε ένα λάθος να μη σε κλειδώσει έξω"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed twice so a slip does not lock you out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribe dos veces para que un descuido no te deje fuera"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitetaan kahdesti, ettei näppäilyvirhe lukitse sinua ulos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisi deux fois pour qu’une faute de frappe ne vous bloque pas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוקלדת פעמיים כדי שטעות לא תנעל אותך בחוץ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो बार टाइप किया जाता है ताकि एक चूक से आप लॉक आउट न हो जाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upisuje se dvaput kako te greška u tipkanju ne bi zaključala"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kétszer kell beírni, hogy egy elírás ne zárjon ki"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diketik dua kali agar salah ketik tidak mengunci kamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritta due volte, così un errore non ti blocca fuori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ミスで閉め出されないよう、2回入力します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실수로 잠기지 않도록 두 번 입력해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പിഴവ് കാരണം പുറത്താകാതിരിക്കാൻ രണ്ടുതവണ ടൈപ്പ് ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditaip dua kali supaya silap taip tidak mengunci anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrives to ganger slik at en skrivefeil ikke låser deg ute"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee keer ingevoerd zodat een typefout je niet buitensluit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywane dwa razy, żeby pomyłka nie zablokowała Ci dostępu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitada duas vezes para que um deslize não bloqueie você"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrita duas vezes para que um deslize não o bloqueie"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scrie de două ori, ca o greșeală să nu te blocheze"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводится дважды, чтобы опечатка не закрыла вам доступ"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadáva sa dvakrát, aby ťa preklep nezamkol"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivs två gånger så att ett felsteg inte låser ute dig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறினால் பூட்டப்படாமல் இருக்க இருமுறை தட்டச்சு செய்யப்படுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పొరపాటు వల్ల మీరు లాక్ అవ్వకుండా రెండుసార్లు టైప్ చేయాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์สองครั้งเพื่อไม่ให้พิมพ์พลาดจนเข้าบัญชีไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yazım hatası sizi dışarıda bırakmasın diye iki kez yazılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводиться двічі, щоб помилка не заблокувала вам доступ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو بار ٹائپ کیا جاتا ہے تاکہ ایک غلطی سے آپ لاک آؤٹ نہ ہوں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hai lần để một lỗi gõ nhầm không khiến bạn bị khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入两次，以免手误导致你无法登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入兩次，以免打錯而被鎖在帳號外"
          }
        }
      }
    },
