    "rooms.live.leaveAsHost.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الغرفة مفتوحة ما لم تُنهها. وإنهاؤها يغلقها على كل من فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি শেষ না করলে রুম খোলা থাকে। শেষ করলে ভেতরে থাকা সবার জন্য এটি বন্ধ হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sala continua oberta tret que l'acabis. Acabar-la la tanca per a tothom qui hi és."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost zůstane otevřená, pokud ji neukončíš. Ukončením se zavře pro všechny v ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet forbliver åbent, medmindre du afslutter det. Hvis du afslutter det, lukkes det for alle i det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum bleibt offen, solange du ihn nicht beendest. Beenden schließt ihn für alle darin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αίθουσα μένει ανοιχτή αν δεν την τερματίσεις. Ο τερματισμός την κλείνει για όλους μέσα σε αυτήν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room stays open unless you end it. Ending it closes it for everybody in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sala sigue abierta a menos que la termines. Al terminarla se cierra para todos los que están en ella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huone pysyy auki, ellet päätä sitä. Päättäminen sulkee sen kaikilta siinä olevilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le salon reste ouvert tant que vous ne le terminez pas. Le terminer le ferme pour tous ceux qui s’y trouvent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החדר נשאר פתוח אלא אם תסיים אותו. סיום סוגר אותו לכל מי שבו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम तब तक खुला रहता है जब तक आप उसे खत्म न करें। खत्म करने पर वह उसमें मौजूद सबके लिए बंद हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soba ostaje otvorena osim ako je ne završiš. Završetkom se zatvara za sve u njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szoba nyitva marad, hacsak nem fejezed be. A befejezés mindenki számára bezárja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room tetap terbuka kecuali kamu mengakhirinya. Mengakhirinya menutupnya untuk semua orang di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stanza resta aperta a meno che tu non la termini. Terminarla la chiude per tutti quelli che ci sono dentro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了しない限り、ルームは開いたままです。終了すると、中にいる全員に対して閉じられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하지 않으면 룸은 계속 열려 있어요. 종료하면 안에 있는 모든 사람에게 닫혀요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അവസാനിപ്പിക്കാത്തിടത്തോളം റൂം തുറന്നിരിക്കും. അവസാനിപ്പിച്ചാൽ അതിലുള്ള എല്ലാവർക്കും അത് അടയും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik kekal terbuka melainkan anda menamatkannya. Menamatkannya menutupnya untuk semua orang di dalamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rommet forblir åpent med mindre du avslutter det. Når du avslutter det, stenges det for alle i det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De room blijft open tenzij je hem beëindigt. Beëindigen sluit hem voor iedereen die erin zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokój pozostaje otwarty, dopóki go nie zakończysz. Zakończenie zamyka go dla wszystkich w środku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala continua aberta, a menos que você a encerre. Encerrá-la fecha a sala para todos os que estão nela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala continua aberta, a menos que a termine. Terminá-la fecha-a para todos os que estão nela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera rămâne deschisă dacă nu o încheii. Încheierea o închide pentru toți cei din ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комната останется открытой, пока вы её не завершите. Завершение закрывает её для всех внутри."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť zostane otvorená, pokiaľ ju neukončíš. Ukončením sa zatvorí pre všetkých v nej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet förblir öppet om du inte avslutar det. Om du avslutar det stängs det för alla i det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் முடிக்காத வரை அறை திறந்தே இருக்கும். முடித்தால் உள்ளே உள்ள அனைவருக்கும் மூடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ముగించకపోతే రూమ్ తెరిచే ఉంటుంది. ముగిస్తే అందులో ఉన్న అందరికీ మూసివేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องจะยังเปิดอยู่เว้นแต่คุณจะจบห้อง การจบห้องจะปิดห้องสำหรับทุกคนในห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz bitirmedikçe oda açık kalır. Bitirmek, odayı içindeki herkes için kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімната залишається відкритою, якщо ви її не завершите. Завершення закриває її для всіх, хто в ній."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ ختم نہ کریں روم کھلا رہتا ہے۔ ختم کرنے سے یہ اس میں موجود سب کے لیے بند ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng vẫn mở trừ khi bạn kết thúc nó. Kết thúc sẽ đóng phòng cho mọi người trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你结束，否则房间会保持开启。结束会为房间里的所有人关闭它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你結束，否則聊天室會保持開啟。結束會為所有在場的人關閉它。"
          }
        }
      }
    },
