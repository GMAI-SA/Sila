    "rooms.series.followHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُذكَّر قبل كل موعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটির আগে আপনাকে মনে করিয়ে দেওয়া হবে।"
          }
        },
