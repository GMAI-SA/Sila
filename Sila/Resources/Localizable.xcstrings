    "preferences.summary.everything": {
      "comment": "Summary when nothing is filtered.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحتك الدولية تعرض كل شيء."
