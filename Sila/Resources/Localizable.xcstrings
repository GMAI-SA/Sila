    "document.upload.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا رفع صورة أو نسخة ممسوحة من وثيقتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আপনার নথির ছবি বা স্ক্যানও আপলোড করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També pots pujar una foto o un escaneig del teu document."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžeš také nahrát fotku nebo sken svého dokladu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også uploade et foto eller en scanning af dit dokument."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch ein Foto oder einen Scan deines Dokuments hochladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς επίσης να ανεβάσεις φωτογραφία ή σάρωση του εγγράφου σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also upload a photo or a scan of your document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes subir una foto o un escaneo de tu documento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös ladata asiakirjasi kuvan tai skannauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi envoyer une photo ou un scan de votre document."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גם להעלות תמונה או סריקה של המסמך שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपने दस्तावेज़ की फ़ोटो या स्कैन भी अपलोड कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš prenijeti i fotografiju ili skeniranu kopiju svoje isprave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányodról fotót vagy szkennelt képet is feltölthetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu juga bisa mengunggah foto atau pindaian dokumenmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche caricare una foto o una scansione del tuo documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の写真やスキャンをアップロードすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 사진이나 스캔본을 업로드할 수도 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖയുടെ ഫോട്ടോയോ സ്കാനോ അപ്‌ലോഡ് ചെയ്യുകയും ആകാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga boleh memuat naik foto atau imbasan dokumen anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også laste opp et bilde eller en skanning av dokumentet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook een foto of scan van je document uploaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też przesłać zdjęcie lub skan dokumentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode enviar uma foto ou um escaneamento do seu documento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode carregar uma foto ou uma digitalização do seu documento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți încărca și o fotografie sau o scanare a documentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно также загрузить фото или скан документа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžeš tiež nahrať fotku alebo sken svojho dokladu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan också ladda upp ett foto eller en skanning av ditt dokument."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்தின் புகைப்படம் அல்லது ஸ்கேனையும் பதிவேற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రం ఫోటో లేదా స్కాన్‌ను కూడా అప్‌లోడ్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอัปโหลดรูปถ่ายหรือภาพสแกนเอกสารของคุณได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenizin bir fotoğrafını veya taramasını da yükleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви також можете завантажити фото або скан документа."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنے دستاویز کی تصویر یا اسکین بھی اپ لوڈ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể tải lên ảnh hoặc bản quét giấy tờ của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以上传证件的照片或扫描件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以上傳證件的照片或掃描檔。"
          }
        }
      }
    },
    "document.upload.liveOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون التحقق من الوجه مباشرًا — هكذا نعرف أنك أنت من يحمل الوثيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুখ যাচাই লাইভ হতে হবে — এভাবেই আমরা জানি নথিটি আপনিই ধরে আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprovació facial ha de ser en directe: així sabem que ets tu qui té el document."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola obličeje musí být živá – díky ní víme, že doklad držíš ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansigtstjekket skal være live – sådan ved vi, at det er dig, der holder dokumentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesichtsprüfung muss live erfolgen – so wissen wir, dass du das Dokument hältst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο έλεγχος προσώπου πρέπει να γίνει ζωντανά — έτσι ξέρουμε ότι εσύ κρατάς το έγγραφο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The face check has to be live — it's how we know it's you holding the document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación facial tiene que ser en vivo: así sabemos que eres tú quien sostiene el documento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvotarkistuksen on oltava live – siitä tiedämme, että asiakirjaa pitelet sinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle du visage doit se faire en direct — c’est ainsi que nous savons que c’est vous qui tenez le document."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת הפנים חייבת להיות חיה — כך אנחנו יודעים שזה אתה מחזיק את המסמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेहरे की जाँच लाइव होनी चाहिए — इसी से हमें पता चलता है कि दस्तावेज़ आप ही पकड़े हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjera lica mora biti uživo — tako znamo da ti držiš ispravu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az arcellenőrzésnek élőnek kell lennie – így tudjuk, hogy te tartod az okmányt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan wajah harus langsung — begitulah kami tahu kamu yang memegang dokumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo del volto deve essere dal vivo: così sappiamo che sei tu a tenere il documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の確認はライブで行う必要があります。書類を持っているのがあなたであることを確認するためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴 확인은 실시간으로 해야 해요. 본인이 문서를 들고 있다는 것을 확인하는 방법이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഖ പരിശോധന ലൈവ് ആയിരിക്കണം — രേഖ പിടിച്ചിരിക്കുന്നത് നിങ്ങളാണെന്ന് ഞങ്ങൾ അറിയുന്നത് അങ്ങനെയാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan wajah mesti secara langsung — begitulah cara kami tahu anda yang memegang dokumen itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansiktskontrollen må være live. Slik vet vi at det er du som holder dokumentet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gezichtscontrole moet live zijn: zo weten we dat jij het document vasthoudt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola twarzy musi odbywać się na żywo — dzięki temu wiemy, że to Ty trzymasz dokument."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação do rosto precisa ser ao vivo: é assim que sabemos que é você segurando o documento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação facial tem de ser em direto — é assim que sabemos que é você a segurar o documento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificarea feței trebuie să fie live — așa știm că tu ții documentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка лица должна проходить вживую — так мы знаем, что документ держите вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola tváre musí byť naživo — tak vieme, že doklad drží tvoja ruka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansiktskontrollen måste vara live – så vet vi att det är du som håller i dokumentet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகச் சோதனை நேரலையாக இருக்க வேண்டும் — ஆவணத்தைப் பிடித்திருப்பது நீங்கள்தான் என்று இப்படித்தான் அறிகிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముఖ తనిఖీ లైవ్‌లో జరగాలి — పత్రాన్ని పట్టుకున్నది మీరేనని మాకు తెలిసేది అలాగే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจใบหน้าต้องทำสดๆ เพื่อให้เรารู้ว่าเป็นคุณที่ถือเอกสาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz kontrolü canlı olmalı; belgeyi tutanın siz olduğunuzu böyle anlarız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка обличчя має бути наживо — так ми знаємо, що документ тримаєте ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چہرے کی جانچ لائیو ہونی چاہیے — اسی سے ہمیں پتا چلتا ہے کہ دستاویز آپ نے پکڑا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước kiểm tra khuôn mặt phải thực hiện trực tiếp — đó là cách chúng tôi biết chính bạn đang cầm giấy tờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸检查必须是实时的，这样我们才能确认是你本人拿着证件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臉部檢查必須即時進行，這樣我們才能確認是你本人拿著證件。"
          }
        }
      }
    },
    "document.upload.or": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
