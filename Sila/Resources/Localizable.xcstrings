    "error.reauthRequired": {
      "comment": "403 reauth_required (contract v26): a credential change on an account with no password, which proves itself with a code texted to its phone — and texted codes are not available yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد كلمة مرور لهذا الحساب، لذا يحتاج هذا التغيير إلى رمز يُرسل إلى جوالك. هذا غير متاح بعد — أعد المحاولة لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে পাসওয়ার্ড নেই, তাই এই পরিবর্তনের জন্য আপনার ফোনে পাঠানো একটি কোড লাগবে। সেটি এখনও সম্ভব নয় — পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte no té contrasenya, així que aquest canvi necessita un codi enviat al telèfon. Encara no és possible; torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemá heslo, takže tato změna vyžaduje kód zaslaný na telefon. To zatím není možné – zkus to prosím později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto har ingen adgangskode, så denne ændring kræver en kode sendt til din telefon. Det er ikke muligt endnu – prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat kein Passwort, daher braucht diese Änderung einen Code, der an dein Telefon gesendet wird. Das ist noch nicht möglich – bitte versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός δεν έχει κωδικό, οπότε αυτή η αλλαγή απαιτεί κωδικό που στέλνεται στο τηλέφωνό σου. Αυτό δεν είναι ακόμα δυνατό — δοκίμασε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no password, so this change needs a code sent to your phone. That isn't possible yet — please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene contraseña, así que este cambio requiere un código enviado a tu teléfono. Eso aún no es posible: inténtalo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilillä ei ole salasanaa, joten tämä muutos vaatii puhelimeesi lähetettävän koodin. Se ei ole vielä mahdollista – yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’a pas de mot de passe, ce changement nécessite donc un code envoyé sur votre téléphone. Ce n’est pas encore possible — veuillez réessayer plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחשבון הזה אין סיסמה, ולכן השינוי הזה דורש קוד שנשלח לטלפון שלך. זה עדיין לא אפשרי — נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट में पासवर्ड नहीं है, इसलिए इस बदलाव के लिए आपके फ़ोन पर कोड भेजना होगा। यह अभी संभव नहीं है — कृपया बाद में कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj račun nema lozinku pa ova promjena zahtijeva kod poslan na tvoj telefon. To još nije moguće — pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a fióknak nincs jelszava, ezért ehhez a módosításhoz a telefonodra küldött kód kell. Ez még nem lehetséges – próbáld újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini tidak punya kata sandi, jadi perubahan ini butuh kode yang dikirim ke ponselmu. Itu belum memungkinkan — coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non ha una password, quindi questa modifica richiede un codice inviato al tuo telefono. Non è ancora possibile: riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにはパスワードがないため、この変更には電話に送られるコードが必要です。現在はまだ対応していません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 비밀번호가 없어서 이 변경에는 휴대폰으로 보낸 코드가 필요해요. 아직 지원되지 않으니 나중에 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിന് പാസ്‌വേഡ് ഇല്ല, അതിനാൽ ഈ മാറ്റത്തിന് നിങ്ങളുടെ ഫോണിലേക്ക് അയയ്ക്കുന്ന കോഡ് വേണം. അത് ഇപ്പോൾ സാധ്യമല്ല — പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini tiada kata laluan, jadi perubahan ini memerlukan kod yang dihantar ke telefon anda. Itu belum boleh dilakukan — sila cuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen har ikke noe passord, så denne endringen krever en kode sendt til telefonen din. Det er ikke mulig ennå. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account heeft geen wachtwoord, dus voor deze wijziging is een code per sms nodig. Dat kan nog niet. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma hasła, więc ta zmiana wymaga kodu wysłanego na Twój telefon. To jeszcze nie jest możliwe — spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem senha, então esta alteração exige um código enviado ao seu celular. Isso ainda não é possível. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem palavra-passe, por isso esta alteração precisa de um código enviado para o seu telemóvel. Isso ainda não é possível — tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont nu are parolă, deci această modificare cere un cod trimis pe telefon. Încă nu este posibil — încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого аккаунта нет пароля, поэтому для изменения нужен код, отправленный на телефон. Пока это невозможно — повторите позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemá heslo, takže táto zmena vyžaduje kód poslaný na tvoj telefón. To zatiaľ nie je možné — skús to neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot har inget lösenord, så ändringen kräver en kod som skickas till din telefon. Det går inte än – försök igen senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்குக்குக் கடவுச்சொல் இல்லை, எனவே இந்த மாற்றத்துக்கு உங்கள் தொலைபேசிக்கு அனுப்பிய குறியீடு தேவை. அது இன்னும் இயலாது — பிறகு முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతాకు పాస్‌వర్డ్ లేదు, కాబట్టి ఈ మార్పుకు మీ ఫోన్‌కు పంపిన కోడ్ అవసరం. అది ఇంకా సాధ్యం కాదు — దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ไม่มีรหัสผ่าน การเปลี่ยนแปลงนี้จึงต้องใช้รหัสที่ส่งไปยังโทรศัพท์ของคุณ ซึ่งยังทำไม่ได้ กรุณาลองอีกครั้งภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın şifresi yok, bu yüzden bu değişiklik için telefonunuza bir kod gönderilmesi gerekiyor. Bu henüz mümkün değil; lütfen daha sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис не має пароля, тому для цієї зміни потрібен код, надісланий на ваш телефон. Це поки неможливо — спробуйте пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ کا پاس ورڈ نہیں ہے، اس لیے اس تبدیلی کے لیے آپ کے فون پر بھیجا گیا کوڈ چاہیے۔ یہ ابھی ممکن نہیں — براہ کرم بعد میں کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này không có mật khẩu nên thay đổi này cần một mã gửi đến điện thoại của bạn. Hiện chưa thực hiện được — vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户没有密码，所以此更改需要发送到你手机的验证码。目前还无法做到，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號沒有密碼，因此這項變更需要傳到你手機的驗證碼，但目前尚無法使用，請稍後再試。"
          }
        }
      }
    },
    "error.reauthUnavailable": {
      "comment": "409 reauth_unavailable (contract v26): the account has neither a password nor a confirmed phone to prove a change with. “Forgot password?” is the sign-in screen's button, which sets one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد كلمة مرور لهذا الحساب لتأكيد هويتك. سجّل الخروج واختر «نسيت كلمة المرور؟» لتعيين واحدة، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে আপনি যে আপনিই তা নিশ্চিত করার মতো পাসওয়ার্ড নেই। সাইন আউট করে “পাসওয়ার্ড ভুলে গেছেন?” বেছে একটি সেট করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte no té contrasenya per confirmar que ets tu. Tanca la sessió, tria «Has oblidat la contrasenya?» per establir-ne una i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemá heslo, kterým by se potvrdilo, že jsi to ty. Odhlas se, zvol „Zapomenuté heslo?“, nastav si ho a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto har ingen adgangskode til at bekræfte, at det er dig. Log ud, vælg “Glemt adgangskode?” for at oprette en, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat kein Passwort, mit dem du dich bestätigen könntest. Melde dich ab, wähle „Passwort vergessen?“, um eines festzulegen, und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός δεν έχει κωδικό για να επιβεβαιωθεί ότι είσαι εσύ. Αποσυνδέσου, επίλεξε «Ξέχασες τον κωδικό;» για να ορίσεις έναν και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no password to confirm it's you. Sign out, choose “Forgot password?” to set one, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene contraseña para confirmar que eres tú. Cierra sesión, elige «¿Olvidaste tu contraseña?» para crear una e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilillä ei ole salasanaa, jolla vahvistaa, että se olet sinä. Kirjaudu ulos, valitse “Unohtuiko salasana?” asettaaksesi sellaisen ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n’a pas de mot de passe pour confirmer que c’est vous. Déconnectez-vous, choisissez « Mot de passe oublié ? » pour en définir un, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחשבון הזה אין סיסמה כדי לאשר שזה אתה. התנתק, בחר ״שכחת סיסמה?״ כדי לקבוע אחת, ואז נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट में पुष्टि के लिए पासवर्ड नहीं है। साइन आउट करें, पासवर्ड सेट करने के लिए \"पासवर्ड भूल गए?\" चुनें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj račun nema lozinku kojom bi se potvrdilo da si to ti. Odjavi se, odaberi „Zaboravljena lozinka?” da je postaviš, pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a fióknak nincs jelszava, amellyel igazolhatnád magad. Jelentkezz ki, válaszd az „Elfelejtetted a jelszavad?” lehetőséget egy jelszó beállításához, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini tidak punya kata sandi untuk memastikan itu kamu. Keluar, pilih “Lupa kata sandi?” untuk membuatnya, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non ha una password per confermare che sei tu. Esci, scegli “Password dimenticata?” per impostarne una, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには本人確認用のパスワードがありません。サインアウトして「パスワードをお忘れですか?」からパスワードを設定し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 본인 확인용 비밀번호가 없어요. 로그아웃하고 “비밀번호를 잊으셨나요?”를 선택해 비밀번호를 설정한 후 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളാണെന്ന് സ്ഥിരീകരിക്കാൻ ഈ അക്കൗണ്ടിന് പാസ്‌വേഡ് ഇല്ല. സൈൻ ഔട്ട് ചെയ്ത് “പാസ്‌വേഡ് മറന്നോ?” തിരഞ്ഞെടുത്ത് ഒന്ന് സജ്ജമാക്കുക, എന്നിട്ട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun ini tiada kata laluan untuk mengesahkan ini anda. Log keluar, pilih “Lupa kata laluan?” untuk menetapkannya, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen har ikke noe passord som kan bekrefte at det er deg. Logg ut, velg «Glemt passordet?» for å angi et, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account heeft geen wachtwoord om te bevestigen dat jij het bent. Log uit, kies “Wachtwoord vergeten?” om er een in te stellen en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma hasła, którym można potwierdzić, że to Ty. Wyloguj się, wybierz „Nie pamiętasz hasła?”, aby je ustawić, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem senha para confirmar que é você. Saia, escolha “Esqueceu a senha?” para definir uma e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem palavra-passe para confirmar que é você. Termine a sessão, escolha “Esqueceu-se da palavra-passe?” para definir uma e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cont nu are o parolă care să confirme că ești tu. Deconectează-te, alege „Ai uitat parola?” ca să setezi una, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого аккаунта нет пароля, чтобы подтвердить, что это вы. Выйдите, выберите «Забыли пароль?», задайте пароль и повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemá heslo na potvrdenie, že si to ty. Odhlás sa, výberom „Zabudnuté heslo?“ si ho nastav a potom to skús znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot har inget lösenord att bekräfta att det är du med. Logga ut, välj ”Glömt lösenordet?” för att ange ett och försök sedan igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள்தான் என்று உறுதிசெய்ய இந்தக் கணக்கில் கடவுச்சொல் இல்லை. வெளியேறி, “கடவுச்சொல் மறந்துவிட்டதா?” என்பதைத் தேர்ந்தெடுத்து ஒன்றை அமைத்து, மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీరేనని నిర్ధారించడానికి ఈ ఖాతాకు పాస్‌వర్డ్ లేదు. సైన్ అవుట్ చేసి, “పాస్‌వర్డ్ మర్చిపోయారా?” ఎంచుకుని ఒకటి సెట్ చేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ไม่มีรหัสผ่านสำหรับยืนยันว่าเป็นคุณ ออกจากระบบ เลือก “ลืมรหัสผ่าน?” เพื่อตั้งรหัสผ่าน แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın, sizin olduğunuzu onaylayacak bir şifresi yok. Çıkış yapın, bir şifre belirlemek için “Şifremi unuttum”u seçin, sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей обліковий запис не має пароля, щоб підтвердити, що це ви. Вийдіть, виберіть «Забули пароль?», щоб встановити його, і спробуйте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ کا کوئی پاس ورڈ نہیں جس سے تصدیق ہو کہ یہ آپ ہیں۔ سائن آؤٹ کریں، “پاس ورڈ بھول گئے؟” چن کر پاس ورڈ سیٹ کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này không có mật khẩu để xác nhận là bạn. Hãy đăng xuất, chọn “Quên mật khẩu?” để đặt mật khẩu, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户没有可用于确认你身份的密码。请退出登录，选择“忘记密码？”来设置一个，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號沒有可用來確認身分的密碼。請登出，選擇「忘記密碼？」設定一組密碼，然後再試一次。"
          }
        }
      }
    },
