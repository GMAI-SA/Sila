    "safety.suspended.noReason": {
      "comment": "Said when the server gave no reason. It does not invent one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرفق معروف سببًا بهذا الإيقاف. والتظلّم أدناه يصل إلى إنسان يمكنه الاطلاع على السجل كاملًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known এই স্থগিতাদেশের সাথে কোনো কারণ যুক্ত করেনি। নিচের আপিল একজন মানুষের কাছে পৌঁছায় যিনি পুরো রেকর্ড দেখতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known no ha adjuntat cap motiu a aquesta suspensió. L'apel·lació de sota arriba a una persona que pot veure tot l'historial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known k tomuto pozastavení nepřipojila důvod. Odvolání níže se dostane k člověku, který vidí celý záznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known har ikke knyttet en begrundelse til denne suspension. Anken nedenfor når et menneske, der kan se hele sagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known hat dieser Sperre keinen Grund beigefügt. Der Einspruch unten erreicht einen Menschen, der die vollständige Akte sehen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known δεν επισύναψε λόγο σε αυτή την αναστολή. Η ένσταση παρακάτω φτάνει σε άνθρωπο που βλέπει ολόκληρο το ιστορικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known did not attach a reason to this suspension. The appeal below reaches a human who can see the full record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known no adjuntó ningún motivo a esta suspensión. La apelación de abajo llega a una persona que puede ver el expediente completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ei liittänyt tähän jäädytykseen syytä. Alla oleva valitus menee ihmiselle, joka näkee koko tiedon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known n’a joint aucun motif à cette suspension. Le recours ci-dessous parvient à une personne qui peut voir le dossier complet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known לא צירפה סיבה להשעיה הזו. הערעור למטה מגיע לאדם שיכול לראות את התיעוד המלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ने इस निलंबन के साथ कोई कारण नहीं जोड़ा। नीचे की अपील एक ऐसे इंसान तक पहुँचती है जो पूरा रिकॉर्ड देख सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known nije priložila razlog ovoj suspenziji. Žalba ispod stiže do čovjeka koji može vidjeti cijeli zapis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known nem csatolt okot ehhez a felfüggesztéshez. Az alábbi fellebbezés egy emberhez jut, aki látja a teljes aktát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tidak mencantumkan alasan pada penangguhan ini. Banding di bawah sampai ke seorang manusia yang bisa melihat catatan lengkapnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known non ha indicato un motivo per questa sospensione. Il ricorso qui sotto arriva a una persona che può vedere la pratica completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この停止には、Knownから理由が添えられていません。下の異議申し立ては、全記録を確認できる人に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known은 이 정지에 사유를 첨부하지 않았어요. 아래 이의 신청은 전체 기록을 볼 수 있는 사람에게 전달돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ഈ സസ്പെൻഷനോടൊപ്പം കാരണമൊന്നും നൽകിയിട്ടില്ല. താഴെയുള്ള അപ്പീൽ പൂർണ്ണ രേഖ കാണാൻ കഴിയുന്ന ഒരു മനുഷ്യന്റെ അടുത്തെത്തും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tidak melampirkan sebab pada penggantungan ini. Rayuan di bawah sampai kepada seorang manusia yang boleh melihat rekod penuh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ga ingen begrunnelse for denne suspensjonen. Anken nedenfor når et menneske som kan se hele saken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known heeft geen reden aan deze schorsing gekoppeld. Het bezwaar hieronder komt bij een mens die het volledige dossier kan zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known nie podała powodu tego zawieszenia. Odwołanie poniżej trafia do człowieka, który widzi pełną historię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known não anexou um motivo a esta suspensão. A contestação abaixo chega a uma pessoa que pode ver o registro completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known não indicou um motivo para esta suspensão. A contestação abaixo chega a uma pessoa que consegue ver o registo completo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known nu a atașat un motiv acestei suspendări. Contestația de mai jos ajunge la un om care poate vedea dosarul complet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Known не указала причину этой блокировки. Апелляция ниже попадёт к человеку, который видит полную историю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known k tomuto pozastaveniu nepripojila dôvod. Odvolanie nižšie sa dostane k človeku, ktorý vidí celý záznam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known angav ingen orsak till den här avstängningen. Överklagandet nedan når en människa som kan se hela ärendet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இடைநீக்கத்துக்கு Known காரணம் எதையும் இணைக்கவில்லை. கீழே உள்ள மேல்முறையீடு முழுப் பதிவையும் பார்க்கக்கூடிய ஒருவரைச் சென்றடையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ఈ సస్పెన్షన్‌కు కారణం ఏదీ జోడించలేదు. కింద ఉన్న అప్పీల్ పూర్తి రికార్డును చూడగల ఒక వ్యక్తికి చేరుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ไม่ได้แนบเหตุผลกับการระงับนี้ การอุทธรณ์ด้านล่างจะไปถึงคนที่เห็นข้อมูลทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known bu askıya almaya bir neden eklemedi. Aşağıdaki itiraz, tam kaydı görebilen bir insana ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known не вказала причини цього призупинення. Апеляція нижче потрапляє до людини, яка бачить повний запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known نے اس معطلی کے ساتھ کوئی وجہ نہیں لگائی۔ نیچے کی اپیل ایک ایسے انسان تک پہنچتی ہے جو پورا ریکارڈ دیکھ سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known không đính kèm lý do cho việc đình chỉ này. Khiếu nại bên dưới sẽ đến một người thật có thể xem toàn bộ hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 没有为此次封禁附上原因。下方的申诉会送达能查看完整记录的真人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 沒有為這次停權附上原因。下方的申訴會交給能查看完整紀錄的真人。"
          }
        }
      }
    },
