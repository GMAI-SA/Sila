        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang berusia 18 tahun atau lebih yang bisa dijamin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può garantire solo per chi ha 18 anni o più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証を受けられるのは18歳以上の人だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만 18세 이상만 보증받을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "18 വയസ്സോ അതിൽ കൂടുതലോ ഉള്ളവർക്ക് മാത്രമേ വൗച്ച് ചെയ്യാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya seseorang yang berumur 18 tahun atau lebih boleh dijamin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan bare garanteres for noen som er 18 år eller eldre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen iemand van 18 of ouder kan een garantie krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poręczyć można tylko za osobę, która ma co najmniej 18 lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só alguém com 18 anos ou mais pode receber aval."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só alguém com 18 anos ou mais pode receber aval."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar cineva de 18 ani sau mai mult poate primi garanție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поручиться можно только за человека 18 лет или старше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručiť sa dá iba za niekoho, kto má 18 rokov alebo viac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara den som är 18 eller äldre kan få intyg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "18 வயது அல்லது அதற்கு மேற்பட்டவருக்கு மட்டுமே உறுதியளிக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "18 లేదా అంతకంటే ఎక్కువ వయస్సు ఉన్నవారికి మాత్రమే హామీ ఇవ్వగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ที่อายุ 18 ปีขึ้นไปเท่านั้นที่รับการรับรองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca 18 yaşında veya daha büyük biri için kefil olunabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поручитися можна лише за людину від 18 років."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف 18 سال یا اس سے زیادہ عمر کے شخص کی ضمانت دی جا سکتی ہے۔"
