    "auth.wall.checkStatus.hint": {
      "comment": "VoiceOver hint for the check-status button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد التحقق ممّا إذا كان المراجع قد اتخذ قرارًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিভিউয়ার সিদ্ধান্ত নিয়েছেন কি না আবার দেখে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a comprovar si un revisor ha pres una decisió"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu zkontroluje, zda posuzovatel rozhodl"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjekker igen, om en gennemgående har truffet en afgørelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft erneut, ob ein Prüfer entschieden hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχει ξανά αν ένας ελεγκτής έλαβε απόφαση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-checks whether a reviewer has made a decision"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a comprobar si un revisor ha tomado una decisión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistaa uudelleen, onko tarkastaja tehnyt päätöksen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie à nouveau si un vérificateur a pris une décision"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק שוב אם בודק קיבל החלטה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से जाँचता है कि किसी समीक्षक ने फ़ैसला लिया या नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno provjerava je li recenzent donio odluku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra megnézi, hogy az elbíráló döntött-e"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa ulang apakah peninjau sudah memutuskan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla di nuovo se un revisore ha preso una decisione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査担当者が判断したかどうかを再確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토자가 결정을 내렸는지 다시 확인해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിവ്യൂവർ തീരുമാനമെടുത്തോ എന്ന് വീണ്ടും പരിശോധിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyemak semula sama ada penyemak telah membuat keputusan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekker på nytt om noen har tatt en avgjørelse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert opnieuw of een beoordelaar een beslissing heeft genomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdza ponownie, czy weryfikator podjął decyzję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica de novo se um analista já tomou uma decisão"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica novamente se um revisor tomou uma decisão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică din nou dacă un evaluator a luat o decizie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, принял ли проверяющий решение"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova skontroluje, či posudzovateľ rozhodol"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar igen om en granskare har fattat ett beslut"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய்வாளர் முடிவு எடுத்தாரா என்று மீண்டும் சரிபார்க்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్షకుడు నిర్ణయం తీసుకున్నారేమో మళ్లీ తనిఖీ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบอีกครั้งว่าผู้ตรวจสอบตัดสินแล้วหรือยัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir inceleyicinin karar verip vermediğini yeniden kontrol eder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову перевіряє, чи перевіряльник ухвалив рішення"
