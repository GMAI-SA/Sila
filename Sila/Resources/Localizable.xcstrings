    "verification.enter.message": {
      "comment": "Body copy of the ID-entry step.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رقم الهوية الوطنية أو الإقامة. سنرسله إلى نفاذ، وستوافق على الطلب من تطبيق نفاذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জাতীয় পরিচয় বা Iqama নম্বর দিন। আমরা সেটি Nafath-এ পাঠাব, আর আপনি Nafath অ্যাপে অনুরোধটি অনুমোদন করবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el número del teu document nacional d'identitat o d'Iqama. L'enviarem a Nafath i aprovaràs la sol·licitud a l'app Nafath."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej číslo National ID nebo Iqama. Pošleme ho do Nafath a žádost schválíš v aplikaci Nafath."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast dit nationale id- eller Iqama-nummer. Vi sender det til Nafath, og du godkender anmodningen i Nafath-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine National-ID- oder Iqama-Nummer ein. Wir senden sie an Nafath, und du bestätigst die Anfrage in der Nafath-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε τον αριθμό National ID ή Iqama. Θα τον στείλουμε στο Nafath και εσύ θα εγκρίνεις το αίτημα στην εφαρμογή Nafath."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your National ID or Iqama number. We'll send it to Nafath, and you'll approve the request in the Nafath app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu número de National ID o Iqama. Lo enviaremos a Nafath y aprobarás la solicitud en la app de Nafath."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna henkilökorttisi tai Iqama-numerosi. Lähetämme sen Nafathille, ja hyväksyt pyynnön Nafath-sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre numéro de carte d’identité nationale ou d’Iqama. Nous l’enverrons à Nafath, et vous approuverez la demande dans l’app Nafath."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את מספר תעודת הזהות הלאומית או ה-Iqama שלך. נשלח אותו ל-Nafath, ואתה תאשר את הבקשה באפליקציית Nafath."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना राष्ट्रीय ID या Iqama नंबर डालें। हम इसे Nafath को भेजेंगे, और आप Nafath ऐप में अनुरोध मंज़ूर करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi svoj broj nacionalne osobne iskaznice ili Iqame. Poslat ćemo ga Nafathu, a ti ćeš odobriti zahtjev u aplikaciji Nafath."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a személyi azonosítódat vagy Iqama számodat. Elküldjük a Nafathnak, és te a Nafath appban hagyod jóvá a kérést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nomor ID Nasional atau Iqama-mu. Kami akan mengirimnya ke Nafath, dan kamu menyetujui permintaannya di app Nafath."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo numero di carta d'identità nazionale o Iqama. Lo invieremo a Nafath e approverai la richiesta nell'app Nafath."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国民IDまたはIqamaの番号を入力してください。Nafathに送信し、Nafathアプリでリクエストを承認していただきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증 번호 또는 Iqama 번호를 입력하세요. Nafath로 보내며, Nafath 앱에서 요청을 승인하면 돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നാഷണൽ ഐഡി അല്ലെങ്കിൽ Iqama നമ്പർ നൽകുക. ഞങ്ങൾ അത് Nafath-ലേക്ക് അയയ്ക്കും, Nafath ആപ്പിൽ നിങ്ങൾ അഭ്യർഥന അംഗീകരിക്കണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nombor National ID atau Iqama anda. Kami akan menghantarnya kepada Nafath, dan anda meluluskan permintaan dalam app Nafath."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn nasjonalt ID-nummer eller Iqama-nummer. Vi sender det til Nafath, og du godkjenner forespørselen i Nafath-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je nationale ID- of Iqama-nummer in. We sturen het naar Nafath en jij keurt het verzoek goed in de Nafath-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz numer dowodu osobistego lub Iqama. Wyślemy go do Nafath, a Ty zatwierdzisz prośbę w aplikacji Nafath."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu número de Identidade Nacional ou Iqama. Vamos enviá-lo ao Nafath, e você aprovará o pedido no app Nafath."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o seu número de Documento Nacional ou Iqama. Enviá-lo-emos ao Nafath e aprovará o pedido na app Nafath."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu numărul tău de National ID sau Iqama. Îl vom trimite la Nafath, iar tu vei aproba cererea în aplicația Nafath."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите номер National ID или Iqama. Мы отправим его в Nafath, а запрос вы подтвердите в приложении Nafath."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj číslo svojho národného preukazu alebo Iqama. Pošleme ho do Nafath a požiadavku schváliš v aplikácii Nafath."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ditt National ID- eller Iqama-nummer. Vi skickar det till Nafath, och du godkänner begäran i Nafath-appen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தேசிய அடையாள எண் அல்லது Iqama எண்ணை உள்ளிடுங்கள். அதை Nafath-க்கு அனுப்புவோம்; Nafath செயலியில் கோரிக்கையை ஏற்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నేషనల్ ID లేదా Iqama నంబర్ నమోదు చేయండి. మేము దాన్ని Nafath కు పంపుతాము, మీరు Nafath యాప్‌లో అభ్యర్థనను ఆమోదిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่เลขบัตรประจำตัวประชาชนหรือเลข Iqama ของคุณ เราจะส่งให้ Nafath และคุณอนุมัติคำขอในแอป Nafath"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulusal Kimlik veya Iqama numaranızı girin. Bunu Nafath'a göndereceğiz ve isteği Nafath uygulamasında onaylayacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть номер Національного ID або Iqama. Ми надішлемо його до Nafath, а ви підтвердите запит у застосунку Nafath."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا قومی شناختی نمبر یا Iqama نمبر درج کریں۔ ہم اسے Nafath کو بھیجیں گے، اور آپ Nafath ایپ میں درخواست منظور کریں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập số căn cước quốc gia hoặc Iqama của bạn. Chúng tôi sẽ gửi đến Nafath, và bạn sẽ chấp thuận yêu cầu trong ứng dụng Nafath."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入你的国民身份证或 Iqama 号码。我们会将其发送给 Nafath，你需要在 Nafath 应用中批准该请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入你的身分證或 Iqama 號碼。我們會將它傳送給 Nafath，你再到 Nafath App 中核准請求。"
          }
        }
      }
    },
    "verification.enter.privacy": {
      "comment": "Privacy note under the Start button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل رقمك إلى نفاذ بشكل آمن مرة واحدة ولا يُخزَّن على هذا الجهاز أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নম্বর নিরাপদে একবার Nafath-এ পাঠানো হয় এবং এই ডিভাইসে কখনও রাখা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu número s'envia de manera segura a Nafath una sola vegada i mai es desa en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé číslo se jednou bezpečně odešle do Nafath a nikdy se neukládá na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit nummer sendes sikkert til Nafath én gang og gemmes aldrig på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nummer wird einmal sicher an Nafath gesendet und nie auf diesem Gerät gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός σου στέλνεται με ασφάλεια στο Nafath μία φορά και δεν αποθηκεύεται ποτέ σε αυτή τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your number is sent securely to Nafath once and is never stored on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu número se envía de forma segura a Nafath una sola vez y nunca se guarda en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerosi lähetetään turvallisesti Nafathille kerran, eikä sitä koskaan tallenneta tälle laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre numéro est envoyé une seule fois, de façon sécurisée, à Nafath et n’est jamais stocké sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר שלך נשלח ל-Nafath באופן מאובטח פעם אחת ואף פעם לא נשמר במכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नंबर एक बार सुरक्षित रूप से Nafath को भेजा जाता है और इस डिवाइस पर कभी सेव नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj broj se jednom sigurno šalje Nafathu i nikada se ne sprema na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számodat biztonságosan, egyszer küldjük el a Nafathnak, és soha nem tároljuk ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomormu dikirim dengan aman ke Nafath sekali dan tidak pernah disimpan di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo numero viene inviato a Nafath in modo sicuro una sola volta e non viene mai conservato su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号は安全にNafathへ一度だけ送信され、このデバイスには保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호는 한 번만 안전하게 Nafath로 전송되며 이 기기에는 저장되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നമ്പർ സുരക്ഷിതമായി ഒരിക്കൽ മാത്രം Nafath-ലേക്ക് അയയ്ക്കുന്നു, ഈ ഉപകരണത്തിൽ ഒരിക്കലും സൂക്ഷിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor anda dihantar dengan selamat kepada Nafath sekali dan tidak pernah disimpan pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeret ditt sendes sikkert til Nafath én gang og lagres aldri på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nummer wordt eenmalig veilig naar Nafath gestuurd en nooit op dit apparaat opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój numer jest jednorazowo wysyłany bezpiecznie do Nafath i nigdy nie jest przechowywany na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu número é enviado ao Nafath uma única vez, com segurança, e nunca é guardado neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu número é enviado ao Nafath de forma segura uma única vez e nunca é guardado neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul tău este trimis securizat o singură dată la Nafath și nu este stocat niciodată pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш номер один раз безопасно отправляется в Nafath и никогда не хранится на этом устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje číslo sa raz bezpečne odošle do Nafath a nikdy sa neukladá v tomto zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt nummer skickas säkert till Nafath en gång och sparas aldrig på den här enheten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் எண் ஒருமுறை பாதுகாப்பாக Nafath-க்கு அனுப்பப்படும்; இந்தச் சாதனத்தில் சேமிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నంబర్ Nafath కు ఒక్కసారి సురక్షితంగా పంపబడుతుంది, ఈ పరికరంలో ఎప్పుడూ నిల్వ చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขของคุณถูกส่งไปยัง Nafath อย่างปลอดภัยเพียงครั้งเดียวและไม่เคยถูกเก็บบนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numaranız Nafath'a bir kez güvenli şekilde gönderilir ve bu cihazda asla saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш номер надсилається до Nafath безпечно один раз і ніколи не зберігається на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نمبر ایک بار محفوظ طریقے سے Nafath کو بھیجا جاتا ہے اور اس ڈیوائس پر کبھی محفوظ نہیں کیا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số của bạn được gửi an toàn đến Nafath một lần và không bao giờ được lưu trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的号码只会安全地发送给 Nafath 一次，绝不会存储在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的號碼只會安全地傳送給 Nafath 一次，絕不會儲存在此裝置上。"
          }
        }
      }
    },
