        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse oplysninger passer ikke med det, personen der sendte linket, indtastede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben passen nicht zu dem, was die Person, die den Link gesendet hat, eingegeben hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα στοιχεία δεν ταιριάζουν με όσα εισήγαγε το άτομο που έστειλε τον σύνδεσμο."
