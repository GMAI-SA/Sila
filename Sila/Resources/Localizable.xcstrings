    "notifications.kind.pollClosed.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يُغلق استطلاع طرحته أو صوّتّ فيه، مع نتيجته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার করা বা উত্তর দেওয়া কোনো পোলে ভোট শেষ হলে, ফলাফলসহ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan es tanca una enquesta que has fet o respost, amb el resultat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se uzavře anketa, kterou jsi založil nebo v ní hlasoval, s výsledkem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en afstemning, du har stillet eller besvaret, lukker, med resultatet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Umfrage, die du gestellt oder beantwortet hast, endet, mit ihrem Ergebnis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κλείνει μια δημοσκόπηση που έκανες ή απάντησες, με το αποτέλεσμά της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a poll you asked or answered closes, with its result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se cierra una encuesta que creaste o respondiste, con su resultado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kysymäsi tai vastaamasi kysely sulkeutuu, tuloksineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un sondage que vous avez lancé ou auquel vous avez répondu se termine, avec son résultat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשסקר ששאלת או ענית עליו נסגר, עם התוצאה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपके पूछे या जवाब दिए पोल की अवधि खत्म हो, नतीजे के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad se zatvori anketa koju si postavio/la ili na koju si odgovorio/la, s rezultatom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy általad feltett vagy megválaszolt szavazás lezárul, az eredménnyel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat jajak pendapat yang kamu buat atau jawab ditutup, beserta hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si chiude un sondaggio che hai creato o a cui hai risposto, con il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが出した、または回答した投票が終了したとき。結果付き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 올렸거나 참여한 투표가 종료되어 결과가 나왔을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ചോദിച്ചതോ ഉത്തരം നൽകിയതോ ആയ പോൾ ഫലത്തോടെ അവസാനിക്കുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila tinjauan yang anda tanya atau jawab ditutup, bersama keputusannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en avstemning du startet eller svarte på, avsluttes, med resultatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een peiling die je hebt gesteld of beantwoord sluit, met de uitslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ankieta, którą zadałeś lub w której głosowałeś, się kończy, wraz z wynikiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma enquete que você criou ou respondeu termina, com o resultado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma sondagem que fez ou respondeu termina, com o resultado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un sondaj pe care l-ai creat sau la care ai răspuns se închide, cu rezultatul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда опрос, который вы создали или в котором участвовали, закрывается, — с результатом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa ukončí anketa, ktorú si založil alebo v ktorej si hlasoval, s jej výsledkom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en omröstning du ställde eller svarade på stängs, med resultatet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கேட்ட அல்லது பதிலளித்த கருத்துக்கணிப்பு முடியும்போது, அதன் முடிவுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అడిగిన లేదా సమాధానం ఇచ్చిన పోల్ ఫలితంతో సహా ముగిసినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อโพลที่คุณถามหรือตอบปิด พร้อมผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorduğunuz veya yanıtladığınız bir anket sonuçlarıyla kapandığında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли опитування, яке ви створили або в якому відповіли, закривається, з його результатом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کا پوچھا یا جواب دیا ہوا پول بند ہو، نتیجے کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một cuộc bình chọn bạn đặt hoặc trả lời kết thúc, kèm kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发起或参与的投票结束时，附带结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你發起或參與的投票結束時，附上結果。"
          }
        }
      }
    },
