    "profile.follow.hint.follow": {
      "comment": "VoiceOver hint for the follow button. %@ is the display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض منشورات %@ في صفحة المتابَعين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর পোস্ট আপনার ফলো করছেন ফিডে দেখায়"
