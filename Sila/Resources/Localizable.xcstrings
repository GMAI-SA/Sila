    "preferences.filter.detail": {
      "comment": "Says which feed the filter applies to, and why it does not apply to the others.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«المتابَعون» لا يُضيَّق أبدًا — هؤلاء اخترتهم بالاسم، فمواضيعك ترفع منشوراتهم فقط. أما المواضيع المخفية فتغادر كل الخلاصات، بما فيها المتابَعون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলো করছেন কখনও সংকুচিত হয় না — ওরা আপনার নাম ধরে বেছে নেওয়া মানুষ, তাই আপনার বিষয়গুলো শুধু তাদের পোস্ট ওপরে তোলে। লুকানো বিষয় ফলো করছেন-সহ প্রতিটি টাইমলাইন থেকে সরে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguint mai no es limita: són persones que has triat pel nom, així que els teus temes només fan pujar les seves publicacions. Els temes amagats desapareixen de totes les cronologies, també de Seguint."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduji se nikdy nezužuje – to jsou lidé, které sis vybral jménem, takže tvá témata jen posouvají jejich příspěvky výš. Skrytá témata zmizí ze všech časových os, včetně Sleduji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger indsnævres aldrig – det er folk, du har valgt ved navn, så dine emner løfter kun deres opslag. Skjulte emner forsvinder fra alle tidslinjer, også Følger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Folge ich“ wird nie eingeschränkt – das sind Personen, die du namentlich gewählt hast, daher heben deine Themen deren Beiträge nur an. Ausgeblendete Themen verschwinden von jeder Timeline, auch von „Folge ich“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Ακολουθείς δεν περιορίζεται ποτέ — είναι άτομα που επέλεξες με το όνομά τους, οπότε τα θέματά σου απλώς ανεβάζουν τις αναρτήσεις τους. Τα κρυμμένα θέματα φεύγουν από κάθε ροή, και από το Ακολουθείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following is never narrowed — those are people you chose by name, so your subjects only move their posts up. Hidden subjects leave every timeline, including Following."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiendo nunca se restringe: son personas que elegiste por su nombre, así que tus temas solo adelantan sus publicaciones. Los temas ocultos desaparecen de todas las cronologías, incluida Siguiendo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuratut-syötettä ei koskaan rajata – ne ovat ihmisiä, jotka valitsit nimeltä, joten aiheesi vain nostavat heidän julkaisujaan. Piilotetut aiheet poistuvat kaikilta aikajanoilta, myös Seuratuista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements n’est jamais restreint — ce sont des personnes que vous avez choisies par leur nom, vos sujets ne font donc que faire remonter leurs posts. Les sujets masqués disparaissent de tous les fils, Abonnements compris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״במעקב״ אף פעם לא מצטמצם — אלה אנשים שבחרת בשמם, ולכן הנושאים שלך רק מקדמים את הפוסטים שלהם. נושאים מוסתרים יוצאים מכל ציר זמן, כולל ״במעקב״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"फ़ॉलो कर रहे हैं\" कभी सीमित नहीं होता — ये वे लोग हैं जिन्हें आपने नाम से चुना है, इसलिए आपके विषय सिर्फ़ उनकी पोस्ट ऊपर उठाते हैं। छिपाए गए विषय हर टाइमलाइन से हट जाते हैं, \"फ़ॉलो कर रहे हैं\" से भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Praćenje se nikada ne sužava — to su ljudi koje si odabrao/la po imenu, pa tvoje teme samo podižu njihove objave. Skrivene teme nestaju sa svih vremenskih traka, uključujući Praćenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Követett soha nincs leszűkítve – ott név szerint választott emberek vannak, ezért a témáid csak előrébb hozzák a bejegyzéseiket. Az elrejtett témák minden idővonalról eltűnnek, a Követettről is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengikuti tidak pernah dipersempit — itu orang yang kamu pilih dengan nama, jadi topikmu hanya menaikkan postingan mereka. Topik yang disembunyikan hilang dari setiap timeline, termasuk Mengikuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguiti non viene mai ristretto: sono persone che hai scelto per nome, quindi i tuoi argomenti fanno solo salire i loro post. Gli argomenti nascosti spariscono da ogni timeline, compresa Seguiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フォロー中」が絞り込まれることはありません。名前で選んだ人たちなので、あなたの分野は投稿を上に上げるだけです。非表示にした分野は、「フォロー中」を含むすべてのタイムラインから外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로잉은 절대 좁혀지지 않아요. 직접 이름으로 고른 사람들이므로 내 주제는 그들의 게시물을 위로 올릴 뿐이에요. 숨긴 주제는 팔로잉을 포함한 모든 타임라인에서 사라져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോളോ ചെയ്യുന്നവർ ഒരിക്കലും ചുരുക്കില്ല — അവർ നിങ്ങൾ പേരെടുത്ത് തിരഞ്ഞെടുത്തവരാണ്, അതിനാൽ നിങ്ങളുടെ വിഷയങ്ങൾ അവരുടെ പോസ്റ്റുകളെ മുകളിലേക്ക് ഉയർത്തുക മാത്രം ചെയ്യുന്നു. മറച്ച വിഷയങ്ങൾ ഫോളോ ചെയ്യുന്നവർ ഉൾപ്പെടെ എല്ലാ ടൈംലൈനിൽ നിന്നും ഒഴിവാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diikuti tidak pernah dipersempitkan — itu orang yang anda pilih dengan nama, jadi subjek anda hanya menaikkan siaran mereka. Subjek yang disembunyikan hilang daripada setiap garis masa, termasuk Diikuti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følger blir aldri innsnevret. Det er folk du valgte ved navn, så temaene dine løfter bare innleggene deres. Skjulte temaer forsvinner fra alle tidslinjer, også Følger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgend wordt nooit beperkt: dat zijn mensen die je bij naam hebt gekozen, dus je onderwerpen halen hun berichten alleen omhoog. Verborgen onderwerpen verdwijnen uit elke tijdlijn, ook Volgend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwowani nigdy nie są zawężani — to osoby wybrane przez Ciebie z imienia, więc tematy tylko podbijają ich wpisy. Ukryte tematy znikają ze wszystkich osi czasu, także z Obserwowanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguindo nunca é restringido: são pessoas que você escolheu pelo nome, então seus assuntos apenas sobem os posts delas. Assuntos ocultos saem de todas as linhas do tempo, inclusive de Seguindo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A secção A seguir nunca é restringida — são pessoas que escolheu pelo nome, por isso os seus assuntos apenas fazem as publicações subir. Os assuntos ocultos saem de todas as cronologias, incluindo A seguir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărești nu este niciodată restrâns — sunt oameni aleși de tine pe nume, deci subiectele tale doar ridică postările lor. Subiectele ascunse dispar din toate fluxurile, inclusiv din Urmărești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Подписки» никогда не сужаются — это люди, выбранные вами по имени, поэтому ваши темы лишь поднимают их посты выше. Скрытые темы исчезают из всех лент, включая «Подписки»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledované sa nikdy nezužuje — to sú ľudia, ktorých si vybral menom, takže tvoje témy len posúvajú ich príspevky vyššie. Skryté témy zmiznú z každej časovej osi, aj zo Sledovaných."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följer begränsas aldrig – det är personer du valt vid namn, så dina ämnen flyttar bara upp deras inlägg. Dolda ämnen försvinner från alla tidslinjer, även Följer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்தொடர்கிறீர்கள் ஒருபோதும் குறுக்கப்படாது — அவர்கள் நீங்கள் பெயர் சொல்லித் தேர்ந்தெடுத்தவர்கள், எனவே உங்கள் தலைப்புகள் அவர்களின் இடுகைகளை மேலே நகர்த்துவதுடன் நிற்கும். மறைக்கப்பட்ட தலைப்புகள் பின்தொடர்கிறீர்கள் உட்பட எல்லாக் காலவரிசைகளிலிருந்தும் நீங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫాలో అవుతున్నవి ఎప్పుడూ కుదించబడవు — అవి మీరు పేరుతో ఎంచుకున్న వ్యక్తులు, కాబట్టి మీ అంశాలు వారి పోస్ట్‌లను పైకి మాత్రమే తెస్తాయి. దాచిన అంశాలు ఫాలో అవుతున్నవితో సహా ప్రతి టైమ్‌లైన్ నుండి మాయమవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังติดตามจะไม่ถูกจำกัด เพราะเป็นคนที่คุณเลือกเองโดยระบุชื่อ เรื่องที่สนใจจึงเพียงดันโพสต์ขึ้น เรื่องที่ซ่อนจะหายจากทุกไทม์ไลน์ รวมถึงกำลังติดตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip akışı asla daraltılmaz; onlar adıyla seçtiğiniz kişilerdir, bu yüzden konularınız yalnızca gönderilerini öne çıkarır. Gizlenen konular, Takip dahil tüm zaman akışlarından çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Підписки» ніколи не звужуються — це люди, яких ви вибрали поіменно, тому ваші теми лише піднімають їхні дописи вище. Приховані теми зникають з усіх стрічок, зокрема й з «Підписок»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فالو کر رہے ہیں کبھی محدود نہیں ہوتا — وہ آپ کے نام لے کر چنے ہوئے لوگ ہیں، اس لیے آپ کے موضوعات صرف ان کی پوسٹس کو اوپر اٹھاتے ہیں۔ چھپائے گئے موضوعات ہر ٹائم لائن سے نکل جاتے ہیں، فالو کر رہے ہیں سمیت۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang theo dõi không bao giờ bị thu hẹp — đó là những người bạn chọn đích danh, nên chủ đề của bạn chỉ đẩy bài của họ lên. Chủ đề bị ẩn rời khỏi mọi dòng thời gian, kể cả Đang theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“关注”信息流永远不会被缩小范围，因为那些是你指名选择的人，所以你的主题只会让他们的帖子提前。被隐藏的主题会从所有时间线中消失，包括“关注”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「追蹤中」永遠不會被縮小範圍，因為那是你指名選擇的人，所以你的主題只會提高他們貼文的排序。隱藏的主題會從所有時間軸消失，包括「追蹤中」。"
          }
        }
      }
    },
    "preferences.filter.hint": {
      "comment": "VoiceOver hint for the interest filter switch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُضيّق «لك» وبلدك و«دولي» إلى المواضيع التي اخترتها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য, আপনার দেশ ও আন্তর্জাতিককে আপনার বেছে নেওয়া বিষয়ে সীমিত করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita Per a tu, el teu país i Internacional als temes que has triat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zúží Pro tebe, tvou zemi a Mezinárodní na témata, která sis vybral"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsnævrer Til dig, dit land og International til de emner, du valgte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschränkt „Für dich“, dein Land und International auf die Themen, die du gewählt hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιορίζει το Για εσένα, τη χώρα σου και το Διεθνές στα θέματα που διάλεξες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrows For You, your country and International to the subjects you picked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe Para ti, tu país e Internacional a los temas que elegiste"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajaa Sinulle-, oman maasi ja Kansainvälinen-syötteet valitsemiisi aiheisiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restreint Pour vous, votre pays et International aux sujets que vous avez choisis"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצמצם את ״בשבילך״, את המדינה שלך ואת ״בינלאומי״ לנושאים שבחרת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"आपके लिए\", आपके देश और अंतरराष्ट्रीय को आपके चुने विषयों तक सीमित करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sužava Za tebe, tvoju zemlju i Međunarodno na teme koje si odabrao/la"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Neked, az országod és a Nemzetközi hírfolyamot a választott témákra szűkíti"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempersempit Untukmu, negaramu, dan Internasional ke topik yang kamu pilih"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe Per te, il tuo paese e Internazionale agli argomenti che hai scelto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「おすすめ」、あなたの国、国際を、選んだ分野に絞り込みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천, 내 국가, 국제를 내가 고른 주제로 좁혀요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കായി, നിങ്ങളുടെ രാജ്യം, അന്താരാഷ്ട്രം എന്നിവ നിങ്ങൾ തിരഞ്ഞെടുത്ത വിഷയങ്ങളിലേക്ക് ചുരുക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempersempitkan Untuk Anda, negara anda dan Antarabangsa kepada subjek yang anda pilih"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snevrer inn For deg, landet ditt og Internasjonalt til temaene du valgte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt Voor jou, je land en Internationaal tot de onderwerpen die je hebt gekozen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawęża Dla Ciebie, Twój kraj i Międzynarodowe do wybranych tematów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe Para você, seu país e Internacional aos assuntos que você escolheu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringe Para si, o seu país e Internacional aos assuntos que escolheu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restrânge Pentru tine, țara ta și Internațional la subiectele alese de tine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сужает «Для вас», вашу страну и «Мир» до выбранных вами тем"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zúži Pre teba, tvoju krajinu a Medzinárodné na témy, ktoré si vybral"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsar För dig, ditt land och Internationellt till ämnena du valde"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்காக, உங்கள் நாடு, சர்வதேசம் ஆகியவற்றை நீங்கள் தேர்ந்தெடுத்த தலைப்புகளுக்குக் குறுக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కోసం, మీ దేశం, అంతర్జాతీయం ఫీడ్‌లను మీరు ఎంచుకున్న అంశాలకు కుదిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำกัดสำหรับคุณ ประเทศของคุณ และนานาชาติ ให้เหลือเรื่องที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin İçin, ülkenizi ve Uluslararası akışı seçtiğiniz konularla daraltır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звужує «Для вас», вашу країну та «Світ» до вибраних вами тем"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے لیے، آپ کے ملک اور بین الاقوامی کو آپ کے چنے ہوئے موضوعات تک محدود کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu hẹp Dành cho bạn, quốc gia của bạn và Quốc tế vào các chủ đề bạn chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“为你推荐”、你的国家和国际信息流缩小到你选择的主题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「為你推薦」、你的國家和「國際」縮小到你選的主題"
          }
        }
      }
    },
    "preferences.filter.title": {
      "comment": "The main switch: narrow the International feed to chosen topics.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرني ما اخترته غالبًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধানত আমার বেছে নেওয়াগুলো দেখান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra'm sobretot el que he triat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazovat hlavně to, co jsem zvolil"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis mig mest det, jeg valgte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige mir hauptsächlich, was ich gewählt habe"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείξε μου κυρίως ό,τι επέλεξα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me mostly what I chose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrarme sobre todo lo que elegí"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä pääosin valitsemani"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me montrer surtout ce que j’ai choisi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הראה לי בעיקר את מה שבחרתי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे ज़्यादातर वही दिखाएँ जो मैंने चुना"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži mi uglavnom ono što sam odabrao/la"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Főleg azt mutasd, amit választottam"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan terutama yang kupilih"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrami soprattutto ciò che ho scelto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだものを中心に表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 고른 것 위주로 보기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ തിരഞ്ഞെടുത്തത് കൂടുതലായി കാണിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan kebanyakannya yang saya pilih"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis meg mest det jeg valgte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon me vooral wat ik heb gekozen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj głównie to, co wybrałem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar principalmente o que escolhi"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar-me sobretudo o que escolhi"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată-mi în principal ce am ales"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать в основном то, что я выбрал"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuj mi hlavne to, čo som vybral"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa mest det jag har valt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் தேர்ந்தெடுத்தவற்றை முக்கியமாகக் காட்டு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను ఎంచుకున్నవి ఎక్కువగా చూపించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงส่วนใหญ่เฉพาะสิ่งที่ฉันเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana çoğunlukla seçtiklerimi göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати переважно те, що я вибрав(ла)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مجھے زیادہ تر وہی دکھائیں جو میں نے چنا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ yếu hiển thị những gì tôi chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要显示我选择的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要顯示我選擇的內容"
          }
        }
      }
    },
