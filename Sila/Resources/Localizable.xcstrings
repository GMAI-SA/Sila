        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер повільно поверніть голову по колу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب اپنا سر آہستہ آہستہ پورا گھمائیں"
