          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybráno. Dalším klepnutím zrušíš výběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt. Tryk igen for at fjerne valget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählt. Erneut tippen, um es abzuwählen."
