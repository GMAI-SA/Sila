        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender navnet, brukernavnet og biografien din til Known"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt je naam, handle en bio naar Known"
          }
        },
        "pl": {
