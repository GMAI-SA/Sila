    "account.email.code.note": {
      "comment": "Reassurance that the old address still works until the change completes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وليس إلى عنوانك الحالي. لا يتغيّر بريدك حتى يُقبل الرمز، لذلك ما زال بإمكانك تسجيل الدخول بالعنوان القديم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বর্তমান ঠিকানায় নয়। কোড গ্রহণ না হওয়া পর্যন্ত আপনার ইমেইল বদলায় না, তাই পুরোনোটি দিয়ে এখনও সাইন ইন করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No a l'adreça actual. El teu correu no canvia fins que s'accepti el codi, així que encara pots iniciar la sessió amb l'antic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne na tvou současnou adresu. E-mail se nezmění, dokud se kód nepřijme, takže se můžeš dál přihlašovat starým."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke til din nuværende adresse. Din e-mail ændres først, når koden er godkendt, så du kan stadig logge ind med den gamle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht an deine aktuelle Adresse. Deine E-Mail-Adresse ändert sich erst, wenn der Code akzeptiert wird; du kannst dich also weiterhin mit der alten anmelden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όχι στην τρέχουσα διεύθυνσή σου. Το email σου δεν αλλάζει μέχρι να γίνει δεκτός ο κωδικός, οπότε μπορείς ακόμα να συνδεθείς με το παλιό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not to your current address. Your email does not change until the code is accepted, so you can still sign in with the old one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No a tu dirección actual. Tu correo no cambia hasta que se acepte el código, así que aún puedes iniciar sesión con el anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei nykyiseen osoitteeseesi. Sähköpostisi ei vaihdu ennen kuin koodi hyväksytään, joten voit yhä kirjautua vanhalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas à votre adresse actuelle. Votre e-mail ne change qu’une fois le code accepté : vous pouvez donc toujours vous connecter avec l’ancien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא לכתובת הנוכחית שלך. הדוא״ל שלך לא משתנה עד שהקוד מתקבל, כך שעדיין אפשר להתחבר עם הישן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मौजूदा पते पर नहीं। कोड स्वीकार होने तक आपका ईमेल नहीं बदलता, इसलिए आप पुराने ईमेल से साइन इन कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne na tvoju trenutačnu adresu. E-pošta se ne mijenja dok se kod ne prihvati, pa se i dalje možeš prijaviti starom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem a jelenlegi címedre. Az e-mail-címed addig nem változik, amíg a kódot el nem fogadjuk, így továbbra is bejelentkezhetsz a réginek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan ke alamatmu saat ini. Emailmu tidak berubah sampai kode diterima, jadi kamu masih bisa masuk dengan yang lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non al tuo indirizzo attuale. La tua email non cambia finché il codice non viene accettato, quindi puoi ancora accedere con quella vecchia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアドレスには送信されません。コードが承認されるまでメールアドレスは変わらないので、古いアドレスでもサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 주소로 보내지 않아요. 코드가 확인될 때까지 이메일이 바뀌지 않으므로 기존 이메일로 계속 로그인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിലെ വിലാസത്തിലേക്കല്ല. കോഡ് സ്വീകരിക്കുന്നതുവരെ നിങ്ങളുടെ ഇമെയിൽ മാറില്ല, അതിനാൽ പഴയതുപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan ke alamat semasa anda. Emel anda tidak berubah sehingga kod diterima, jadi anda masih boleh log masuk dengan yang lama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke til din nåværende adresse. E-posten din endres ikke før koden er godtatt, så du kan fortsatt logge inn med den gamle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dus niet naar je huidige adres. Je e-mailadres verandert pas als de code is geaccepteerd, dus je kunt nog met het oude inloggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie na Twój obecny adres. Twój e-mail nie zmieni się, dopóki kod nie zostanie zaakceptowany, więc nadal możesz logować się starym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não para o seu endereço atual. Seu e-mail só muda depois que o código for aceito, então você ainda pode entrar com o antigo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não para o seu endereço atual. O seu email só muda quando o código for aceite, por isso ainda pode iniciar sessão com o antigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu la adresa actuală. E-mailul tău nu se schimbă până când codul este acceptat, deci te poți autentifica în continuare cu cel vechi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не на ваш текущий адрес. Почта не изменится, пока код не будет принят, поэтому вы по-прежнему можете входить со старой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie na tvoju súčasnú adresu. Tvoj e-mail sa nezmení, kým sa kód neprijme, takže sa môžeš stále prihlásiť pôvodným."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte till din nuvarande adress. Din e-postadress ändras inte förrän koden har godkänts, så du kan fortfarande logga in med den gamla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தற்போதைய முகவரிக்கு அல்ல. குறியீடு ஏற்கப்படும் வரை உங்கள் மின்னஞ்சல் மாறாது, எனவே பழையதைக் கொண்டே உள்நுழையலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రస్తుత చిరునామాకు కాదు. కోడ్ ఆమోదించబడే వరకు మీ ఈమెయిల్ మారదు, కాబట్టి పాత దానితో ఇంకా సైన్ ఇన్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ส่งไปที่ที่อยู่ปัจจุบันของคุณ อีเมลของคุณจะไม่เปลี่ยนจนกว่ารหัสจะได้รับการยอมรับ คุณจึงยังลงชื่อเข้าใช้ด้วยอีเมลเดิมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut adresinize değil. Kod kabul edilene kadar e-postanız değişmez; yani eskisiyle giriş yapmaya devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не на вашу поточну адресу. Ваша пошта не зміниться, доки код не буде прийнято, тож ви все ще можете входити зі старою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے موجودہ پتے پر نہیں۔ کوڈ قبول ہونے تک آپ کی ای میل نہیں بدلتی، اس لیے آپ پرانی سے سائن اِن کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gửi đến địa chỉ hiện tại của bạn. Email của bạn chỉ đổi khi mã được chấp nhận, nên bạn vẫn có thể đăng nhập bằng email cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会发送到你当前的邮箱。验证码通过之前，你的邮箱不会改变，所以仍可使用旧邮箱登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
