            "value": "كل شيء ما زال موجودًا، والإلغاء أدناه يعيده كله."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is still here, and cancelling below brings it all back."
          }
        }
      }
    },
    "account.recovery.currentState.header": {
      "comment": "Header above the facts about the current state. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوقت الحالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right now"
          }
        }
      }
    },
    "account.recovery.currentState.posts": {
      "comment": "Current state: the posts and profile are hidden.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منشوراتك مخفية من كل الصفحات ونتائج البحث والسلاسل، وملفك لا يظهر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts are hidden from every feed, search result and thread, and your profile does not resolve."
          }
        }
      }
    },
    "account.recovery.currentState.reversible": {
      "comment": "Current state: nothing has been destroyed yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُتلف شيء. والإلغاء يستعيد كل ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been destroyed. Cancelling restores all of it."
          }
        }
      }
    },
    "account.recovery.currentState.scope": {
      "comment": "Current state: this is the only reachable screen, and why.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء آخر في سِلة يعمل ما دام هذا معلقًا — ولهذا فهذه هي الشاشة الوحيدة التي يمكنك الوصول إليها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else on Sila works while this is pending — that is why this is the only screen you can reach."
          }
        }
      }
    },
    "account.recovery.signOut.hint": {
      "comment": "VoiceOver hint for signing out of a pending deletion.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغادر التطبيق. ويبقى الحذف مجدولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves the app. The deletion stays scheduled."
          }
        }
      }
    },
    "account.recovery.signOut.note": {
      "comment": "Says the deletion completes on its own if that is what was intended.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كنت تقصد المغادرة، فلا شيء آخر عليك فعله. الحذف يكتمل من تلقاء نفسه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you meant to leave, there is nothing more to do. The deletion finishes on its own."
          }
        }
      }
    },
