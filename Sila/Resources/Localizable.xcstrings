        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is limited until identity verification is complete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta está limitada hasta que se complete la verificación de identidad"
          }
        },
