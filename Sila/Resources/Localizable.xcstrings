    "vouch.claim.accept.hint": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل بياناتك لمطابقتها، ثم يؤكّد ⁦@%@⁩ أنك أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেলানোর জন্য আপনার তথ্য পাঠায়। তারপর @%@ নিশ্চিত করেন যে এটি আপনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia les teves dades perquè es comparin. Després @%@ confirma que ets tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle tvé údaje ke shodě. @%@ pak potvrdí, že jsi to ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender dine oplysninger til sammenligning. @%@ bekræfter derefter, at det er dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet deine Angaben zum Abgleich. @%@ bestätigt dann, dass du es bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει τα στοιχεία σου για αντιστοίχιση. Ο/Η @%@ επιβεβαιώνει μετά ότι είσαι εσύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your details to be matched. @%@ then confirms it's you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tus datos para compararlos. Después @%@ confirma que eres tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää tietosi täsmäytettäväksi. @%@ vahvistaa sitten, että se olet sinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie vos informations pour comparaison. @%@ confirme ensuite que c’est vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את הפרטים שלך להתאמה. @%@ מאשר אחר כך שזה אתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका विवरण मिलान के लिए भेजता है। फिर @%@ पुष्टि करते हैं कि यह आप हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje tvoje podatke na usporedbu. @%@ zatim potvrđuje da si to ti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elküldi az adataidat az egyeztetéshez. @%@ ezután megerősíti, hogy te vagy az."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim detailmu untuk dicocokkan. @%@ lalu mengonfirmasi bahwa itu kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia i tuoi dati per il confronto. Poi @%@ conferma che sei tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの詳細を送信して照合します。そのあと@%@があなた本人であることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 정보를 보내 대조해요. 그런 다음 @%@님이 본인이 맞는지 확인해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൊരുത്തപ്പെടുത്താൻ നിങ്ങളുടെ വിവരങ്ങൾ അയയ്ക്കുന്നു. തുടർന്ന് അത് നിങ്ങളാണെന്ന് @%@ സ്ഥിരീകരിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghantar butiran anda untuk dipadankan. @%@ kemudian mengesahkan itu anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender opplysningene dine for å bli sammenlignet. @%@ bekrefter deretter at det er deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt je gegevens om te worden vergeleken. @%@ bevestigt daarna dat jij het bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła Twoje dane do dopasowania. Następnie @%@ potwierdza, że to Ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia seus dados para conferência. Depois @%@ confirma que é você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia os seus dados para serem comparados. @%@ confirma depois que é você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite datele tale pentru potrivire. Apoi @%@ confirmă că ești tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет ваши данные на сверку. Затем @%@ подтверждает, что это вы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odošle tvoje údaje na porovnanie. @%@ potom potvrdí, že si to ty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar dina uppgifter för att matchas. @%@ bekräftar sedan att det är du."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்திப் பார்க்க உங்கள் விவரங்களை அனுப்பும். பிறகு அது நீங்கள்தான் என @%@ உறுதிப்படுத்துவார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిపోల్చడానికి మీ వివరాలను పంపుతుంది. ఆ తర్వాత అది మీరేనని @%@ నిర్ధారిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งรายละเอียดของคุณไปจับคู่ จากนั้น @%@ จะยืนยันว่าเป็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgilerinizi eşleştirilmek üzere gönderir. Sonra @%@ sizin olduğunuzu onaylar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає ваші дані для зіставлення. Потім @%@ підтверджує, що це ви."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تفصیلات ملانے کے لیے بھیجتا ہے۔ پھر @%@ تصدیق کرتے ہیں کہ یہ آپ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi thông tin của bạn để đối chiếu. Sau đó @%@ xác nhận đó là bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你的信息以进行匹配，然后由 @%@ 确认是你本人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送出你的資料進行比對，之後 @%@ 會確認是你本人。"
          }
        }
      }
    },
