    "rooms.host.readmittedToast": {
      "comment": "Toast.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ %@ العودة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আবার ঢুকতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pot tornar a entrar."
          }
        },
        "cs": {
          "stringUnit": {
