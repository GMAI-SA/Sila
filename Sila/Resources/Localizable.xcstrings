        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの国の認証済みアカウントの投稿を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 나라의 인증된 계정의 게시물을 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രാജ്യത്തെ പരിശോധിച്ച അക്കൗണ്ടുകളുടെ പോസ്റ്റുകൾ കാണിക്കുന്നു"
