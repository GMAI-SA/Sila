        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At fjerne nogen gælder kun dette rum. Det er ikke en blokering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen gilt nur für diesen Raum. Es ist keine Blockierung."
