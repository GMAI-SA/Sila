    "rooms.access.group.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط الأشخاص في مجموعة تحتفظ بها، إضافة إلى من تدعوه بالاسم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার রাখা কোনো গ্রুপের মানুষ, এবং আপনি নাম ধরে যাদের আমন্ত্রণ জানান তারা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només les persones d'un grup que tens, i qualsevol que convidis pel nom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen lidé ve skupině, kterou vedeš, plus kdokoli, koho pozveš jménem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun folkene i en gruppe, du har, plus alle, du inviterer ved navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Personen in einer Gruppe, die du führst, plus alle, die du namentlich einlädst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο τα άτομα μιας ομάδας που κρατάς, συν όποιον προσκαλέσεις ονομαστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the people in a group you keep, plus anyone you invite by name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas de un grupo que tengas, más cualquiera que invites por su nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ylläpitämäsi ryhmän ihmiset sekä kaikki, jotka kutsut nimeltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les personnes d’un groupe que vous gardez, plus toute personne que vous invitez nommément."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק האנשים בקבוצה ששמרת, וכל מי שתזמין בשמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपके रखे किसी ग्रुप के लोग, और वे जिन्हें आप नाम लेकर आमंत्रित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ljudi iz grupe koju čuvaš, plus svatko koga pozoveš imenom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az általad vezetett csoport tagjai, valamint bárki, akit név szerint meghívsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang di grup yang kamu simpan, ditambah siapa pun yang kamu undang dengan nama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone di un gruppo che tieni, più chiunque inviti per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが作ったグループの人と、名前を指定して招待した人だけが入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 관리하는 그룹에 속한 사람과 이름으로 초대한 사람만 입장할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സൂക്ഷിക്കുന്ന ഒരു ഗ്രൂപ്പിലെ ആളുകൾക്കും നിങ്ങൾ പേരെടുത്ത് ക്ഷണിക്കുന്നവർക്കും മാത്രം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya orang dalam kumpulan yang anda simpan, serta sesiapa yang anda jemput dengan nama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare folk i en gruppe du har, pluss alle du inviterer ved navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de mensen in een groep die je bijhoudt, plus iedereen die je bij naam uitnodigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko osoby z prowadzonej przez Ciebie grupy oraz każdy, kogo zaprosisz po imieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as pessoas de um grupo seu, mais quem você convidar pelo nome."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as pessoas de um grupo que mantém, mais quem convidar pelo nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar oamenii dintr-un grup al tău, plus oricine inviți pe nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только люди из вашей группы и все, кого вы пригласите по имени."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba ľudia zo skupiny, ktorú vedieš, a každý, koho pozveš menom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara personerna i en grupp du har, plus alla du bjuder in vid namn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் வைத்திருக்கும் ஒரு குழுவில் உள்ளவர்களும், நீங்கள் பெயர் சொல்லி அழைக்கும் எவரும் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఉంచుకున్న గ్రూప్‌లోని వ్యక్తులు, మీరు పేరుతో ఆహ్వానించిన వారెవరైనా మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนในกลุ่มที่คุณเก็บไว้ และใครก็ตามที่คุณเชิญโดยระบุชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tuttuğunuz bir gruptaki kişiler ve adıyla davet ettiğiniz herkes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише люди з групи, яку ви ведете, та всі, кого ви запросите поіменно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ کے رکھے ہوئے کسی گروپ کے لوگ، اور جسے آپ نام لے کر مدعو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những người trong một nhóm bạn giữ, cộng với bất kỳ ai bạn mời đích danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限你保存的某个群组中的人，以及你点名邀请的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你所保留群組中的人，以及你指名邀請的任何人。"
          }
        }
      }
    },
