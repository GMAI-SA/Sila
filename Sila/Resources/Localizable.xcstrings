    "rooms.create.stageSize.explanation": {
      "comment": "What the stage size governs. There is no cap on listeners.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم شخصًا يمكنه أن يكون على المايك في الوقت نفسه. ولا يوجد حد لعدد المستمعين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে কতজন মাইক্রোফোনে থাকতে পারবে। শ্রোতার সংখ্যার কোনো সীমা নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantes persones poden ser al micròfon alhora. No hi ha límit d'oients."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik lidí může být na mikrofonu najednou. Počet posluchačů není omezen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange der kan være ved mikrofonen ad gangen. Der er ingen grænse for lyttere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Personen gleichzeitig am Mikrofon sein können. Für Zuhörer gibt es keine Begrenzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσα άτομα μπορούν να είναι στο μικρόφωνο ταυτόχρονα. Δεν υπάρχει όριο στους ακροατές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many people can be on the microphone at once. There is no limit on listeners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas personas pueden tener el micrófono a la vez. No hay límite de oyentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka moni voi olla mikrofonilla kerrallaan. Kuuntelijoita ei ole rajoitettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de personnes peuvent être au micro en même temps. Il n’y a pas de limite pour les auditeurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה אנשים יכולים להיות במיקרופון בו-זמנית. אין הגבלה על מאזינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समय में कितने लोग माइक्रोफ़ोन पर हो सकते हैं। सुनने वालों की कोई सीमा नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ljudi može biti na mikrofonu istovremeno. Slušatelja može biti neograničeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány ember lehet egyszerre a mikrofonnál. A hallgatók számára nincs korlát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak orang yang bisa memakai mikrofon sekaligus. Tidak ada batas untuk pendengar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante persone possono essere al microfono contemporaneamente. Non c'è limite agli ascoltatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時にマイクを使える人数です。聴く人の人数に上限はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 마이크를 잡을 수 있는 사람 수예요. 청취자 수에는 제한이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരേസമയം എത്ര പേർക്ക് മൈക്രോഫോണിൽ ഉണ്ടാകാം. കേൾവിക്കാർക്ക് പരിധിയില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa ramai orang boleh berada pada mikrofon serentak. Tiada had untuk pendengar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange som kan være på mikrofonen samtidig. Det er ingen grense for lyttere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel mensen tegelijk op de microfoon kunnen zijn. Er is geen limiet voor luisteraars."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile osób może być jednocześnie przy mikrofonie. Liczba słuchaczy nie jest ograniczona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas pessoas podem estar no microfone ao mesmo tempo. Não há limite de ouvintes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas pessoas podem estar ao microfone em simultâneo. Não há limite de ouvintes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câți oameni pot fi la microfon deodată. Nu există limită pentru ascultători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько человек могут быть у микрофона одновременно. Число слушателей не ограничено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko ľudí môže byť naraz na mikrofóne. Počet poslucháčov nie je obmedzený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur många som kan vara vid mikrofonen samtidigt. Det finns ingen gräns för lyssnare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நேரத்தில் எத்தனை பேர் மைக்ரோஃபோனில் இருக்கலாம். கேட்பவர்களுக்கு வரம்பு இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకేసారి ఎంతమంది మైక్రోఫోన్‌పై ఉండవచ్చు. శ్రోతలకు పరిమితి లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนคนที่ใช้ไมโครโฟนพร้อมกันได้ ผู้ฟังไม่จำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda kaç kişi mikrofonda olabilir. Dinleyici sayısında sınır yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки людей може бути з мікрофоном одночасно. Кількість слухачів не обмежена."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک وقت میں کتنے لوگ مائیکروفون پر ہو سکتے ہیں۔ سننے والوں کی کوئی حد نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao nhiêu người có thể dùng micro cùng lúc. Không giới hạn số người nghe."
          }
        },
        "zh-Hans": {
