          "stringUnit": {
            "state": "translated",
            "value": "यह दस्तावेज़ समाप्त हो चुका है। Known को वैध दस्तावेज़ चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova isprava je istekla. Aplikaciji Known treba važeća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az okmány lejárt. A Knownnak érvényes okmány kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini sudah kedaluwarsa. Known butuh yang masih berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo documento è scaduto. Known ne richiede uno valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類は期限が切れています。Knownには有効な書類が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 만료되었어요. Known에는 유효한 문서가 필요해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ രേഖയുടെ കാലാവധി കഴിഞ്ഞു. Known-ന് സാധുവായ രേഖ വേണം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini telah tamat tempoh. Known memerlukan yang sah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette dokumentet er utløpt. Known trenger et gyldig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document is verlopen. Known heeft een geldig document nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dokument wygasł. Known potrzebuje ważnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento está vencido. O Known precisa de um válido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento expirou. A Known precisa de um válido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest document a expirat. Known are nevoie de unul valabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия документа истёк. Known нужен действующий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť tohto dokladu vypršala. Known potrebuje platný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här dokumentet har gått ut. Known behöver ett giltigt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆவணம் காலாவதியாகிவிட்டது. Known-க்குச் செல்லுபடியாகும் ஒன்று தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పత్రం గడువు ముగిసింది. Knownకు చెల్లుబాటు అయ్యేది కావాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารนี้หมดอายุแล้ว Known ต้องใช้เอกสารที่ยังไม่หมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu belgenin süresi dolmuş. Known'un geçerli bir belgeye ihtiyacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії цього документа закінчився. Known потрібен чинний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دستاویز کی میعاد ختم ہو چکی ہے۔ Known کو درست دستاویز چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy tờ này đã hết hạn. Known cần giấy tờ còn hiệu lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此证件已过期。Known 需要有效的证件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件已過期。Known 需要有效的證件。"
          }
        }
      }
