    "verification.identityUsed.message": {
      "comment": "Body pointing at signing in rather than retrying.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل هوية حساب واحد في «معروف». سجّل الدخول إلى الحساب المرتبط بهذه الهوية بدلًا من إنشاء حساب آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি পরিচয়ে একটি Known অ্যাকাউন্ট থাকতে পারে। আরেকটি তৈরি না করে এই পরিচয় যে অ্যাকাউন্টের, সেখানে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada identitat pot tenir un sol compte de Known. Inicia la sessió al compte al qual pertany aquesta identitat en lloc de crear-ne un altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá totožnost může mít jeden účet Known. Přihlas se k účtu, kterému tato totožnost patří, místo zakládání dalšího."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver identitet kan have én Known-konto. Log i stedet ind på den konto, denne identitet hører til, i stedet for at oprette en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Identität kann ein Known-Konto haben. Melde dich beim Konto an, zu dem diese Identität gehört, statt ein weiteres zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ταυτότητα μπορεί να έχει έναν λογαριασμό Known. Συνδέσου στον λογαριασμό στον οποίο ανήκει αυτή η ταυτότητα αντί να δημιουργήσεις άλλον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each identity can hold one Known account. Sign in to the account this identity belongs to instead of creating another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada identidad puede tener una cuenta de Known. Inicia sesión en la cuenta a la que pertenece esta identidad en lugar de crear otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella henkilöllisyydellä voi olla yksi Known-tili. Kirjaudu tiliin, jolle tämä henkilöllisyys kuuluu, uuden luomisen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque identité ne peut avoir qu’un seul compte Known. Connectez-vous au compte auquel cette identité appartient au lieu d’en créer un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל זהות יכולה להחזיק חשבון Known אחד. התחבר לחשבון שהזהות הזו שייכת לו במקום ליצור אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पहचान पर एक ही Known अकाउंट हो सकता है। दूसरा बनाने के बजाय उस अकाउंट में साइन इन करें जिसकी यह पहचान है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki identitet može imati jedan Known račun. Prijavi se na račun kojem ovaj identitet pripada umjesto izrade drugog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden személyazonossághoz egy Known-fiók tartozhat. Jelentkezz be abba a fiókba, amelyhez ez a személyazonosság tartozik, ahelyett hogy újat hoznál létre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap identitas hanya bisa memegang satu akun Known. Masuk ke akun milik identitas ini, bukan membuat yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni identità può avere un solo account Known. Accedi all'account a cui appartiene questa identità invece di crearne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの本人情報で持てるKnownアカウントは1つです。別のアカウントを作るのではなく、この本人情報のアカウントにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 신원으로 Known 계정 하나만 가질 수 있어요. 새 계정을 만들지 말고 이 신원이 속한 계정으로 로그인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഐഡന്റിറ്റിക്കും ഒരു Known അക്കൗണ്ട് മാത്രമേ ഉണ്ടാകാവൂ. മറ്റൊന്ന് സൃഷ്ടിക്കുന്നതിന് പകരം ഈ ഐഡന്റിറ്റിയുടെ അക്കൗണ്ടിൽ സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap identiti boleh mempunyai satu akaun Known. Log masuk ke akaun yang dimiliki identiti ini sebagai ganti mencipta yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver identitet kan ha én Known-konto. Logg inn på kontoen denne identiteten tilhører, i stedet for å opprette en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke identiteit kan één Known-account hebben. Log in op het account waar deze identiteit bij hoort in plaats van er nog een aan te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda tożsamość może mieć jedno konto Known. Zaloguj się na konto, do którego należy ta tożsamość, zamiast tworzyć kolejne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada identidade pode ter uma conta no Known. Entre na conta a que esta identidade pertence, em vez de criar outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada identidade pode ter uma conta Known. Inicie sessão na conta a que esta identidade pertence em vez de criar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare identitate poate avea un singur cont Known. Autentifică-te în contul căruia îi aparține această identitate, în loc să creezi altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна личность может иметь один аккаунт Known. Войдите в аккаунт, которому принадлежит эта личность, вместо создания нового."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá totožnosť môže mať jeden účet Known. Prihlás sa do účtu, ku ktorému táto totožnosť patrí, namiesto vytvárania ďalšieho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje identitet kan ha ett Known-konto. Logga in på kontot som den här identiteten tillhör i stället för att skapa ett till."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு அடையாளத்துக்கும் ஒரு Known கணக்கு மட்டுமே இருக்க முடியும். இன்னொன்றை உருவாக்காமல், இந்த அடையாளத்துக்குரிய கணக்கில் உள்நுழையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి గుర్తింపుకు ఒక Known ఖాతా మాత్రమే ఉండవచ్చు. మరొకటి సృష్టించే బదులు, ఈ గుర్తింపు చెందిన ఖాతాలో సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งตัวตนมีบัญชี Known ได้หนึ่งบัญชี ลงชื่อเข้าใช้บัญชีที่ตัวตนนี้เป็นเจ้าของแทนการสร้างอีกบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kimlik tek bir Known hesabına sahip olabilir. Başka bir hesap oluşturmak yerine bu kimliğin ait olduğu hesaba giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна особа може мати один обліковий запис Known. Увійдіть в обліковий запис, якому належить ця особа, замість створювати інший."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر شناخت ایک ہی Known اکاؤنٹ رکھ سکتی ہے۔ دوسرا بنانے کے بجائے اس اکاؤنٹ میں سائن اِن کریں جس سے یہ شناخت جڑی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi danh tính chỉ có một tài khoản Known. Hãy đăng nhập vào tài khoản mà danh tính này thuộc về thay vì tạo thêm tài khoản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个身份只能拥有一个 Known 账户。请登录此身份所属的账户，而不是再创建一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個身分只能有一個 Known 帳號。請登入此身分所屬的帳號，而不要另建帳號。"
          }
        }
      }
    },
