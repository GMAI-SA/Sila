    "safety.reason.hateSpeech.detail": {
      "comment": "What the hate-speech reason covers.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهجوم على الناس بسبب هويتهم — الجنسية أو الدين أو العِرق أو الجنس أو الإعاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানুষ যা তার জন্য আক্রমণ — জাতীয়তা, ধর্ম, বর্ণ, লিঙ্গ বা প্রতিবন্ধিতা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Atacs contra persones per allò que són: nacionalitat, religió, raça, gènere o discapacitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Útoky na lidi kvůli tomu, kým jsou – národnost, náboženství, rasa, pohlaví nebo postižení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angreb på folk for den, de er – nationalitet, religion, race, køn eller handicap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angriffe auf Menschen wegen dessen, was sie sind – Nationalität, Religion, Hautfarbe, Geschlecht oder Behinderung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιθέσεις σε άτομα για αυτό που είναι — εθνικότητα, θρησκεία, φυλή, φύλο ή αναπηρία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacks on people for who they are — nationality, religion, race, gender or disability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ataques a personas por lo que son: nacionalidad, religión, raza, género o discapacidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyökkäykset ihmisiä vastaan heidän ominaisuuksiensa vuoksi – kansalaisuus, uskonto, rotu, sukupuoli tai vamma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attaques contre des personnes pour ce qu’elles sont — nationalité, religion, origine, genre ou handicap."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקפות על אנשים בגלל מי שהם — לאום, דת, גזע, מגדר או מוגבלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगों पर उनकी पहचान के आधार पर हमले — राष्ट्रीयता, धर्म, नस्ल, लिंग या विकलांगता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napadi na ljude zbog toga tko su — nacionalnost, vjera, rasa, spol ili invaliditet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emberek támadása azért, akik – állampolgárság, vallás, faj, nem vagy fogyatékosság miatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Serangan terhadap orang karena jati dirinya — kebangsaan, agama, ras, gender, atau disabilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacchi alle persone per ciò che sono: nazionalità, religione, razza, genere o disabilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国籍、宗教、人種、性別、障害など、その人の属性を理由にした攻撃。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국적, 종교, 인종, 성별, 장애 등 사람의 정체성을 이유로 한 공격."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആളുകളെ അവരുടെ ദേശീയത, മതം, വംശം, ലിംഗം, അല്ലെങ്കിൽ വൈകല്യം എന്നിവയുടെ പേരിൽ ആക്രമിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Serangan ke atas orang kerana siapa mereka — kewarganegaraan, agama, bangsa, jantina atau kecacatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angrep på folk for den de er: nasjonalitet, religion, rase, kjønn eller funksjonsnedsettelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanvallen op mensen om wie ze zijn: nationaliteit, religie, ras, geslacht of beperking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ataki na ludzi za to, kim są — narodowość, religia, rasa, płeć lub niepełnosprawność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ataques a pessoas por quem elas são: nacionalidade, religião, raça, gênero ou deficiência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ataques a pessoas pelo que são — nacionalidade, religião, raça, género ou deficiência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atacuri asupra oamenilor pentru cine sunt — naționalitate, religie, rasă, gen sau dizabilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нападки на людей за то, кто они: национальность, религия, раса, пол или инвалидность."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Útoky na ľudí pre to, kým sú — národnosť, náboženstvo, rasa, pohlavie alebo zdravotné postihnutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Angrepp på människor för vilka de är – nationalitet, religion, ras, kön eller funktionsnedsättning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்களை அவர்கள் யார் என்பதற்காகத் தாக்குதல் — குடியுரிமை, மதம், இனம், பாலினம் அல்லது மாற்றுத்திறன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రజలు ఎవరో అనే కారణంతో వారిపై దాడులు — జాతీయత, మతం, జాతి, లింగం లేదా వైకల్యం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโจมตีผู้คนเพราะตัวตนของพวกเขา เช่น สัญชาติ ศาสนา เชื้อชาติ เพศ หรือความพิการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlara kim oldukları için saldırı: uyruk, din, ırk, cinsiyet veya engellilik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напади на людей за те, ким вони є, — національність, релігія, раса, стать чи інвалідність."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوگوں پر ان کی شناخت کی وجہ سے حملے — قومیت، مذہب، نسل، جنس یا معذوری۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tấn công người khác vì con người họ — quốc tịch, tôn giáo, chủng tộc, giới tính hoặc khuyết tật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因对方的身份（国籍、宗教、种族、性别或残障）而攻击他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因國籍、宗教、種族、性別或身心障礙而攻擊他人。"
          }
        }
      }
    },
