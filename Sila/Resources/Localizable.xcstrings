    "composer.segment.add.a11yHint": {
      "comment": "VoiceOver hint explaining how a thread publishes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشر كل منشور بالترتيب، ردًا على الذي قبله"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি পোস্ট ক্রমানুসারে প্রকাশ হয়, আগেরটির উত্তর হিসেবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicació es publica per ordre, responent a l'anterior"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý příspěvek se zveřejní v pořadí jako odpověď na předchozí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert opslag udgives i rækkefølge som svar på det foregående"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Beitrag wird der Reihe nach veröffentlicht und antwortet auf den vorherigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ανάρτηση δημοσιεύεται με τη σειρά, ως απάντηση στην προηγούμενη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each post is published in order, replying to the one before it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicación se publica en orden, como respuesta a la anterior"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen julkaisu julkaistaan järjestyksessä vastauksena edelliseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque post est publié dans l’ordre, en réponse au précédent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל פוסט מתפרסם לפי הסדר, כתגובה לקודם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पोस्ट क्रम से प्रकाशित होती है, पिछली पोस्ट के जवाब के रूप में"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka objava objavljuje se redom, kao odgovor na prethodnu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bejegyzés sorrendben jelenik meg, az előzőre válaszolva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap postingan diterbitkan berurutan, membalas yang sebelumnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni post viene pubblicato in ordine, in risposta al precedente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各投稿は順番に公開され、直前の投稿への返信になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 게시물은 순서대로 게시되며 바로 앞 게시물에 대한 답글이 돼요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ പോസ്റ്റും ക്രമമായി പ്രസിദ്ധീകരിക്കുന്നു, തൊട്ടുമുമ്പത്തേതിന് മറുപടിയായി"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap siaran diterbitkan mengikut urutan, membalas yang sebelumnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert innlegg publiseres i rekkefølge, som svar på det forrige"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bericht wordt in volgorde geplaatst, als reactie op het vorige"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wpis jest publikowany po kolei, jako odpowiedź na poprzedni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada post é publicado em ordem, respondendo ao anterior"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada publicação é publicada por ordem, em resposta à anterior"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare postare se publică în ordine, ca răspuns la cea dinainte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посты публикуются по порядку, каждый — ответом на предыдущий"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý príspevok sa zverejní v poradí a odpovedá na predchádzajúci"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje inlägg publiceras i ordning och svarar på det föregående"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு இடுகையும் வரிசையாக, முந்தையதற்குப் பதிலாக வெளியிடப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి పోస్ట్ వరుసగా ప్రచురించబడుతుంది, ముందున్నదానికి రిప్లైగా"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละโพสต์จะเผยแพร่ตามลำดับ โดยตอบกลับโพสต์ก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gönderi sırayla yayınlanır ve bir öncekine yanıt verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен допис публікується по черзі як відповідь на попередній"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر پوسٹ ترتیب سے شائع ہوتی ہے، اپنے سے پہلی کا جواب بن کر"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bài được đăng theo thứ tự, trả lời bài trước nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条帖子按顺序发布，并回复前一条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每則貼文會依序發布，並回覆前一則"
          }
        }
      }
    },
