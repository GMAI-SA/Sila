        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ने आपका वाउच स्वीकार किया — पुष्टि करें कि वही हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko je prihvatio tvoje jamstvo — potvrdi da je to ta osoba"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki elfogadta a kezességedet – erősítsd meg, hogy ő az"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang menerima jaminanmu — konfirmasi bahwa itu dia"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ha accettato la tua garanzia: conferma che è proprio lui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたの保証を受け入れました。ご本人か確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내 보증을 수락했어요. 본인이 맞는지 확인하세요"
