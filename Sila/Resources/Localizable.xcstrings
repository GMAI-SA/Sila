    "video.add.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من مكتبتك فيديو مدته 3 دقائق أو أقل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি থেকে সর্বোচ্চ ৩ মিনিটের একটি ভিডিও বেছে নিন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un vídeo de fins a 3 minuts de la teva fototeca"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber video do 3 minut ze své knihovny"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en video på op til 3 minutter fra dit bibliotek"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Video von bis zu 3 Minuten aus deiner Mediathek"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε από τη βιβλιοθήκη σου ένα βίντεο έως 3 λεπτών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video of up to 3 minutes from your library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de tu fototeca un vídeo de hasta 3 minutos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kirjastostasi enintään 3 minuutin video"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez dans votre photothèque une vidéo de 3 minutes au maximum"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר וידאו של עד 3 דקות מהספרייה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी से अधिकतम 3 मिनट का वीडियो चुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi video do 3 minute iz svoje biblioteke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz legfeljebb 3 perces videót a fotótáradból"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih video hingga 3 menit dari pustakamu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dalla libreria un video di massimo 3 minuti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリから3分までの動画を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 최대 3분 길이의 동영상을 선택하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറിയിൽ നിന്ന് 3 മിനിറ്റ് വരെയുള്ള വീഡിയോ തിരഞ്ഞെടുക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih video sehingga 3 minit daripada pustaka anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en video på opptil 3 minutter fra biblioteket ditt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een video van maximaal 3 minuten uit je bibliotheek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz z biblioteki wideo do 3 minut"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha na sua fototeca um vídeo de até 3 minutos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha na sua fototeca um vídeo com até 3 minutos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege din bibliotecă un video de până la 3 minute"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите видео длиной до 3 минут из вашей медиатеки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber z knižnice video dlhé najviac 3 minúty"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en video på upp till 3 minuter från ditt bibliotek"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்திலிருந்து 3 நிமிடம் வரையிலான வீடியோவைத் தேர்ந்தெடுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీ నుండి 3 నిమిషాల వరకు ఉన్న వీడియోను ఎంచుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวิดีโอยาวไม่เกิน 3 นาทีจากคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızdan en fazla 3 dakikalık bir video seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть відео тривалістю до 3 хвилин зі своєї медіатеки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی لائبریری سے 3 منٹ تک کی ویڈیو چنیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một video dài tối đa 3 phút từ thư viện của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的图库中选择不超过 3 分钟的视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的相簿選擇長度不超過 3 分鐘的影片"
