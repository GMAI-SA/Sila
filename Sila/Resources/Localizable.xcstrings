            "value": "ఒక కమ్యూనిటీలో గరిష్ఠంగా పది నియమాలు ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุมชนมีกฎได้สูงสุดสิบข้อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toplulukta en fazla on kural olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У спільноти може бути щонайбільше десять правил."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمیونٹی میں زیادہ سے زیادہ دس اصول ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cộng đồng có tối đa mười quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个社区最多可设十条规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個社群最多有十條規則。"
          }
        }
      }
    },
