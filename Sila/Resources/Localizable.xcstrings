    "notifications.empty.subtitle": {
      "comment": "Why an empty list is not a broken one. The second sentence is a privacy promise: reading a notification tells nobody.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلك هنا المتابعات والإعجابات وإعادات النشر والردود والإشارات. ولا يُبلَّغ أحد عندما تقرأها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows, likes, reposts, replies and mentions land here. Nobody is told when you read them."
          }
        }
      }
    },
