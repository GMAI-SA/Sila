        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlákno země. Odpovídat mohou jen ověřené účty v zemi: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Landetråd. Kun verificerede konti i %@ kan svare."
          }
        },
        "de": {
          "stringUnit": {
