            "value": "حتى دقيقتين. احكها كما تحكيها لصديق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ দুই মিনিট। বন্ধুকে যেভাবে বলেন সেভাবে বলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins a dos minuts. Explica-la com ho faries a un amic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až dvě minuty. Vyprávěj ho tak, jak bys ho vyprávěl příteli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til to minutter. Fortæl den, som du ville fortælle en ven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu zwei Minuten. Erzähl es, wie du es einer Freundin oder einem Freund erzählen würdest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως δύο λεπτά. Πες την όπως θα την έλεγες σε φίλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to two minutes. Tell it the way you'd tell a friend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dos minutos. Cuéntala como se la contarías a un amigo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään kaksi minuuttia. Kerro se niin kuin kertoisit ystävälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à deux minutes. Racontez-la comme à un ami."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד שתי דקות. ספר אותו כמו שהיית מספר לחבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम दो मिनट। इसे वैसे सुनाएँ जैसे किसी दोस्त को सुनाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do dvije minute. Ispričaj je kako bi je ispričao/la prijatelju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb két perc. Mesélj úgy, ahogy egy barátodnak mesélnéd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga dua menit. Ceritakan seperti kepada teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a due minuti. Raccontala come la racconteresti a un amico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長2分。友だちに話すように話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 2분. 친구에게 말하듯 들려주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രണ്ട് മിനിറ്റ് വരെ. ഒരു സുഹൃത്തിനോട് പറയുന്നതുപോലെ പറയൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehingga dua minit. Ceritakan seperti anda bercerita kepada kawan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil to minutter. Fortell den slik du ville fortalt en venn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal twee minuten. Vertel het zoals je het aan een vriend zou vertellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do dwóch minut. Opowiedz ją tak, jak opowiedziałbyś przyjacielowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até dois minutos. Conte do jeito que contaria a um amigo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até dois minutos. Conte-a como a contaria a um amigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Până la două minute. Spune-o așa cum i-ai spune-o unui prieten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До двух минут. Расскажите так, как рассказали бы другу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do dvoch minút. Povedz ho tak, ako by si ho rozprával priateľovi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till två minuter. Berätta som du skulle berätta för en vän."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டு நிமிடம் வரை. நண்பரிடம் சொல்வது போலச் சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు నిమిషాల వరకు. స్నేహితుడికి చెప్పినట్లు చెప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกินสองนาที เล่าแบบที่เล่าให้เพื่อนฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla iki dakika. Bir arkadaşınıza anlatır gibi anlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До двох хвилин. Розкажіть її так, як розповіли б другові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو منٹ تک۔ اسے ایسے سنائیں جیسے کسی دوست کو سناتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa hai phút. Kể như bạn kể cho một người bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长两分钟。像对朋友讲述那样说出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最長兩分鐘。像對朋友說話一樣把它說出來。"
          }
        }
      }
    },
