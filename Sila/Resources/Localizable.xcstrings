    "preferences.topics.hideHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على موضوع لترى المزيد منه. اضغط على العين لإزالته من ملفك تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও দেখতে একটি বিষয়ে ট্যাপ করুন। আপনার টাইমলাইন থেকে সম্পূর্ণ সরাতে চোখের চিহ্নে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un tema per veure'n més. Toca l'ull per treure'l completament de la teva cronologia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na téma uvidíš víc jeho příspěvků. Klepnutím na oko ho úplně odstraníš ze své časové osy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et emne for at se mere af det. Tryk på øjet for at fjerne det helt fra din tidslinje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Thema, um mehr davon zu sehen. Tippe auf das Auge, um es ganz von deiner Timeline zu nehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε ένα θέμα για να δεις περισσότερα. Πάτησε το μάτι για να το αφαιρέσεις εντελώς από τη ροή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a subject to see more of it. Tap the eye to take it off your timeline completely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un tema para ver más de él. Toca el ojo para quitarlo por completo de tu cronología."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta aihetta nähdäksesi sitä enemmän. Napauta silmää poistaaksesi sen aikajanaltasi kokonaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un sujet pour en voir davantage. Touchez l’œil pour le retirer complètement de votre fil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על נושא כדי לראות ממנו יותר. הקש על העין כדי להסיר אותו לגמרי מציר הזמן שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विषय को ज़्यादा देखने के लिए उस पर टैप करें। उसे अपनी टाइमलाइन से पूरी तरह हटाने के लिए आँख पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni temu da vidiš više nje. Dodirni oko da je potpuno skineš sa svoje vremenske trake."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy témára, hogy többet láss belőle. Koppints a szemre, hogy teljesen eltűnjön az idővonaladról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sebuah topik untuk melihat lebih banyak. Ketuk mata untuk menghapusnya sepenuhnya dari timeline-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un argomento per vederne di più. Tocca l'occhio per toglierlo del tutto dalla tua timeline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分野をタップすると、その分野がより多く表示されます。目のアイコンをタップすると、タイムラインから完全に外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제를 탭하면 더 많이 볼 수 있어요. 눈 아이콘을 탭하면 타임라인에서 완전히 숨겨요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു വിഷയം കൂടുതൽ കാണാൻ അതിൽ ടാപ്പ് ചെയ്യുക. നിങ്ങളുടെ ടൈംലൈനിൽ നിന്ന് പൂർണമായും ഒഴിവാക്കാൻ കണ്ണിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik subjek untuk melihat lebih banyak tentangnya. Ketik mata untuk mengeluarkannya sepenuhnya daripada garis masa anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et tema for å se mer av det. Trykk på øyet for å fjerne det helt fra tidslinjen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een onderwerp om er meer van te zien. Tik op het oog om het helemaal van je tijdlijn te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij temat, aby widzieć go częściej. Stuknij oko, aby całkowicie usunąć go z osi czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um assunto para ver mais dele. Toque no olho para tirá-lo por completo da sua linha do tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num assunto para ver mais sobre ele. Toque no olho para o retirar totalmente da sua cronologia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un subiect ca să vezi mai mult din el. Atinge ochiul ca să-l scoți complet din flux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь темы, чтобы видеть больше такого. Коснитесь глаза, чтобы полностью убрать её из ленты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na tému uvidíš viac z nej. Ťuknutím na oko ju úplne odstrániš zo svojej časovej osi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett ämne för att se mer av det. Tryck på ögat för att ta bort det helt från din tidslinje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தலைப்பை அதிகம் காண அதைத் தட்டுங்கள். உங்கள் காலவரிசையிலிருந்து முழுமையாக நீக்க கண் குறியைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరింత చూడటానికి ఒక అంశాన్ని ట్యాప్ చేయండి. మీ టైమ్‌లైన్ నుండి పూర్తిగా తీసివేయడానికి కన్ను గుర్తును ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเรื่องเพื่อดูเรื่องนั้นมากขึ้น แตะรูปตาเพื่อนำออกจากไทม์ไลน์ของคุณทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazlasını görmek için bir konuya dokunun. Zaman akışınızdan tamamen kaldırmak için göz simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться теми, щоб бачити її більше. Торкніться ока, щоб повністю прибрати її з вашої стрічки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی موضوع کا مزید دیکھنے کے لیے اس پر ٹیپ کریں۔ اسے اپنی ٹائم لائن سے مکمل طور پر ہٹانے کے لیے آنکھ پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một chủ đề để xem nhiều hơn. Chạm vào con mắt để gỡ hoàn toàn khỏi dòng thời gian của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点主题可查看更多相关内容。轻点眼睛图标可将其从你的时间线中完全移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點主題以查看更多。輕點眼睛圖示可將它從你的時間軸完全移除。"
          }
        }
      }
    },
