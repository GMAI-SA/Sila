    "document.upload.error.notDownloaded": {
      "comment": "A photo chosen from Photos came back empty — usually an iCloud original that would not download.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل هذه الصورة — ربما ما زالت تُنزَّل من iCloud. حاول مجددًا أو اختر غيرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটি আসেনি — এটি হয়তো এখনও iCloud থেকে ডাউনলোড হচ্ছে। আবার চেষ্টা করুন, অথবা অন্যটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta foto no ha arribat: potser encara es baixa d'iCloud. Torna-ho a provar o tria'n una altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fotka nepřišla – možná se ještě stahuje z iCloudu. Zkus to znovu, nebo vyber jinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet kom ikke igennem – det hentes måske stadig fra iCloud. Prøv igen, eller vælg et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto ist nicht angekommen – möglicherweise wird es noch aus iCloud geladen. Versuche es erneut oder wähle ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία δεν φορτώθηκε — μπορεί να κατεβαίνει ακόμα από το iCloud. Δοκίμασε ξανά ή επίλεξε άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo didn't come through — it may still be downloading from iCloud. Try again, or choose another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa foto no llegó; puede que aún se esté descargando de iCloud. Inténtalo de nuevo o elige otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva ei tullut perille – se voi vielä latautua iCloudista. Yritä uudelleen tai valitse toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n’est pas arrivée — elle est peut-être encore en cours de téléchargement depuis iCloud. Réessayez, ou choisissez-en une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה לא הגיעה — ייתכן שהיא עדיין יורדת מ-iCloud. נסה שוב, או בחר אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ोटो नहीं आई — शायद वह अभी iCloud से डाउनलोड हो रही है। फिर कोशिश करें, या दूसरी चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fotografija nije stigla — možda se još preuzima s iClouda. Pokušaj ponovno ili odaberi drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó nem érkezett meg – lehet, hogy még töltődik az iCloudból. Próbáld újra, vagy válassz másikat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu tidak masuk — mungkin masih diunduh dari iCloud. Coba lagi, atau pilih yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella foto non è arrivata: potrebbe essere ancora in download da iCloud. Riprova o scegline un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を取得できませんでした。iCloudからまだダウンロード中の可能性があります。もう一度お試しいただくか、別の写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 가져오지 못했어요. 아직 iCloud에서 다운로드 중일 수 있어요. 다시 시도하거나 다른 사진을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫോട്ടോ എത്തിയില്ല — അത് ഇപ്പോഴും iCloud-ൽ നിന്ന് ഡൗൺലോഡ് ആകുകയാകാം. വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto itu tidak sampai — ia mungkin masih dimuat turun daripada iCloud. Cuba lagi, atau pilih yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet kom ikke gjennom. Det lastes kanskje fortsatt ned fra iCloud. Prøv igjen, eller velg et annet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die foto is niet binnengekomen: hij wordt mogelijk nog gedownload van iCloud. Probeer het opnieuw of kies een andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie nie dotarło — może jeszcze się pobiera z iCloud. Spróbuj ponownie lub wybierz inne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa foto não chegou: ela pode ainda estar sendo baixada do iCloud. Tente de novo ou escolha outra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa foto não chegou — pode ainda estar a ser transferida do iCloud. Tente novamente ou escolha outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia nu a ajuns — poate se mai descarcă din iCloud. Încearcă din nou sau alege alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото не загрузилось — возможно, оно ещё скачивается из iCloud. Повторите или выберите другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto fotka sa nenačítala — možno sa ešte sťahuje z iCloud. Skús to znova alebo vyber inú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotot kom inte fram – det kanske fortfarande laddas ned från iCloud. Försök igen eller välj ett annat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தப் புகைப்படம் வரவில்லை — இன்னும் iCloud-இலிருந்து பதிவிறங்கிக்கொண்டிருக்கலாம். மீண்டும் முயலுங்கள் அல்லது வேறொன்றைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫోటో రాలేదు — అది ఇంకా iCloud నుండి డౌన్‌లోడ్ అవుతూ ఉండవచ్చు. మళ్లీ ప్రయత్నించండి, లేదా మరొకటి ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนั้นยังไม่มา อาจยังดาวน์โหลดจาก iCloud อยู่ ลองอีกครั้ง หรือเลือกรูปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf gelmedi; iCloud'dan hâlâ iniyor olabilir. Tekrar deneyin veya başka birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це фото не завантажилося — можливо, воно ще завантажується з iCloud. Спробуйте ще раз або виберіть інше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ تصویر نہیں آئی — ہو سکتا ہے وہ ابھی iCloud سے ڈاؤن لوڈ ہو رہی ہو۔ دوبارہ کوشش کریں، یا دوسری چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đó chưa tải về được — có thể vẫn đang tải từ iCloud. Hãy thử lại, hoặc chọn ảnh khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片没有加载成功，可能仍在从 iCloud 下载。请重试，或另选一张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片沒有成功取得，可能仍在從 iCloud 下載。請再試一次，或選擇其他照片。"
          }
        }
      }
    },
    "document.upload.error.unreadableFile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذا الملف كصورة أو ملف PDF — اختر غيره أو التقط صورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি ছবি বা PDF হিসেবে খোলা যায়নি — অন্যটি বেছে নিন, অথবা ছবি তুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest fitxer no s'ha pogut obrir com a imatge ni com a PDF: tria'n un altre o fes una foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor nešlo otevřít jako obrázek ani PDF – vyber jiný, nebo pořiď fotku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke åbnes som billede eller PDF – vælg en anden, eller tag et foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht als Bild oder PDF geöffnet werden – wähle eine andere oder mache ein Foto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο δεν άνοιξε ως εικόνα ή PDF — επίλεξε άλλο ή τράβηξε φωτογραφία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file couldn't be opened as a picture or a PDF — choose another, or take a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir ese archivo como imagen ni como PDF. Elige otro o haz una foto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoa ei voitu avata kuvana tai PDF-tiedostona – valitse toinen tai ota kuva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas pu être ouvert comme image ou PDF — choisissez-en un autre, ou prenez une photo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את הקובץ הזה כתמונה או כ-PDF — בחר אחר, או צלם תמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह फ़ाइल तस्वीर या PDF के रूप में खुल नहीं सकी — दूसरी चुनें, या फ़ोटो लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu datoteku nije bilo moguće otvoriti kao sliku ili PDF — odaberi drugu ili snimi fotografiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlt nem lehetett képként vagy PDF-ként megnyitni – válassz másikat, vagy készíts fotót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas itu tidak bisa dibuka sebagai gambar atau PDF — pilih yang lain, atau ambil foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire quel file come immagine o PDF: scegline un altro o scatta una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを画像またはPDFとして開けませんでした。別のファイルを選ぶか、写真を撮ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 사진이나 PDF로 열 수 없어요. 다른 파일을 선택하거나 사진을 찍으세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ഫയൽ ചിത്രമായോ PDF ആയോ തുറക്കാനായില്ല — മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ ഫോട്ടോ എടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail itu tidak dapat dibuka sebagai gambar atau PDF — pilih yang lain, atau ambil foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunne ikke åpnes som et bilde eller en PDF. Velg en annen, eller ta et bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat bestand kon niet worden geopend als afbeelding of pdf. Kies een ander bestand of maak een foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć tego pliku jako obrazu ani PDF — wybierz inny lub zrób zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esse arquivo como imagem ou PDF. Escolha outro ou tire uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esse ficheiro como imagem ou PDF — escolha outro ou tire uma foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul nu a putut fi deschis ca imagine sau PDF — alege altul sau fă o fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть файл как изображение или PDF — выберите другой или сделайте фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento súbor sa nepodarilo otvoriť ako obrázok ani PDF — vyber iný alebo urob fotku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen gick inte att öppna som en bild eller PDF – välj en annan eller ta ett foto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தக் கோப்பைப் படமாகவோ PDF ஆகவோ திறக்க முடியவில்லை — வேறொன்றைத் தேர்ந்தெடுங்கள் அல்லது புகைப்படம் எடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఫైల్‌ను చిత్రంగా లేదా PDFగా తెరవలేకపోయాం — మరొకటి ఎంచుకోండి, లేదా ఫోటో తీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟล์นั้นเป็นรูปภาพหรือ PDF ไม่ได้ เลือกไฟล์อื่น หรือถ่ายรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya resim veya PDF olarak açılamadı; başka birini seçin ya da fotoğraf çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл не вдалося відкрити як зображення чи PDF — виберіть інший або зробіть фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ فائل تصویر یا PDF کے طور پر کھولی نہیں جا سکی — دوسری چنیں، یا تصویر لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được tệp đó như một ảnh hay tệp PDF — hãy chọn tệp khác, hoặc chụp ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将该文件作为图片或 PDF 打开，请另选一个，或拍照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
