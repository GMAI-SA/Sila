    "verification.identityUsed.signIn.hint": {
      "comment": "A11y hint on Go to Sign In.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل الخروج من هذا الحساب لتتمكن من تسجيل الدخول إلى الحساب الموجود"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্ট থেকে সাইন আউট করে যাতে বিদ্যমানটিতে সাইন ইন করতে পারেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca la sessió d'aquest compte perquè puguis iniciar la del compte existent"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásí tě z tohoto účtu, abys se mohl přihlásit k existujícímu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger ud af denne konto, så du kan logge ind på den eksisterende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich von diesem Konto ab, damit du dich beim bestehenden anmelden kannst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αποσυνδέει από αυτόν τον λογαριασμό ώστε να συνδεθείς στον υπάρχοντα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out of this account so you can sign in to the existing one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión de esta cuenta para que puedas iniciar sesión en la existente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa ulos tältä tililtä, jotta voit kirjautua olemassa olevalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte de ce compte pour que vous puissiez vous connecter à celui qui existe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתנתק מהחשבון הזה כדי שתוכל להתחבר לחשבון הקיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट से साइन आउट करता है ताकि आप मौजूदा अकाउंट में साइन इन कर सकें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljuje te s ovog računa da se možeš prijaviti na postojeći"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkeztet ebből a fiókból, hogy a meglévőbe jelentkezhess be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari akun ini agar kamu bisa masuk ke akun yang sudah ada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce da questo account così puoi accedere a quello esistente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントからサインアウトし、既存のアカウントにサインインできるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 로그아웃하여 기존 계정으로 로그인할 수 있어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുന്നു, നിലവിലുള്ളതിൽ സൈൻ ഇൻ ചെയ്യാം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melog keluar daripada akaun ini supaya anda boleh log masuk ke yang sedia ada"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger ut av denne kontoen slik at du kan logge inn på den eksisterende"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt uit van dit account zodat je kunt inloggen op het bestaande"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowuje z tego konta, abyś mógł zalogować się na istniejące"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai desta conta para você entrar na conta existente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina a sessão nesta conta para poder iniciar sessão na existente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te deconectează din acest cont ca să te poți autentifica în cel existent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит из этого аккаунта, чтобы вы могли войти в существующий"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlási z tohto účtu, aby si sa mohol prihlásiť do existujúceho"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggar ut från det här kontot så att du kan logga in på det befintliga"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கிலிருந்து வெளியேறும், இதனால் ஏற்கெனவே உள்ள கணக்கில் உள்நுழையலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతా నుండి సైన్ అవుట్ చేస్తుంది, తద్వారా మీరు ఉన్న ఖాతాలో సైన్ ఇన్ చేయవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบบัญชีนี้เพื่อให้คุณลงชื่อเข้าใช้บัญชีที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut hesaba giriş yapabilmeniz için bu hesaptan çıkış yapar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виходить із цього облікового запису, щоб ви могли увійти в наявний"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ سے سائن آؤٹ کرتا ہے تاکہ آپ موجودہ اکاؤنٹ میں سائن اِن کر سکیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất khỏi tài khoản này để bạn đăng nhập vào tài khoản hiện có"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出此账户，以便登录已有的账户"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出此帳號，讓你登入現有的帳號"
          }
        }
      }
    },
    "verification.identityUsed.title": {
      "comment": "Headline of the identity-already-used outcome. Not a failure.",
