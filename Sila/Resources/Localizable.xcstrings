            "value": "هذه الهوية لديها حساب في «معروف» بالفعل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পরিচয়ে ইতিমধ্যে একটি Known অ্যাকাউন্ট আছে"
          }
        },
        "ca": {
