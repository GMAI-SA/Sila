    "document.privacy": {
      "comment": "Privacy note under the document picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُخزَّن رقم الوثيقة أبدًا — بصمة منه فقط، ليتحقق حساب واحد بوثيقة واحدة. تُحذف صورك بعد المراجعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নথির নম্বর কখনও রাখা হয় না — শুধু এর একটি ফিঙ্গারপ্রিন্ট রাখা হয়, যাতে একটি নথি দিয়ে একটি অ্যাকাউন্ট ভেরিফাই হয়। রিভিউ শেষ হলে আপনার ছবিগুলো মুছে ফেলা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El número del document no es desa mai: només una empremta digital, perquè un document només pugui verificar un compte. Les teves fotos s'eliminen un cop revisades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo dokladu se nikdy neukládá – jen jeho otisk, takže jeden doklad ověří jeden účet. Fotografie se po posouzení smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentnummeret gemmes aldrig – kun et fingeraftryk af det, så ét dokument kun kan verificere én konto. Dine fotos slettes, når de er gennemgået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumentnummer wird nie gespeichert – nur ein Fingerabdruck davon, damit ein Dokument nur ein Konto verifizieren kann. Deine Fotos werden nach der Prüfung gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός του εγγράφου δεν αποθηκεύεται ποτέ — μόνο ένα αποτύπωμά του, ώστε ένα έγγραφο να επαληθεύει έναν λογαριασμό. Οι φωτογραφίες σου διαγράφονται μόλις εξεταστούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document number is never stored — only a fingerprint of it, so one document can verify one account. Your photos are deleted once reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número del documento nunca se guarda, solo una huella suya, para que un documento verifique una sola cuenta. Tus fotos se eliminan una vez revisadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjan numeroa ei koskaan tallenneta – vain sen sormenjälki, jotta yksi asiakirja voi vahvistaa yhden tilin. Kuvasi poistetaan tarkastuksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le numéro du document n’est jamais stocké — seulement son empreinte, pour qu’un document ne puisse vérifier qu’un seul compte. Vos photos sont supprimées après examen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר המסמך אף פעם לא נשמר — רק טביעת אצבע שלו, כך שמסמך אחד יכול לאמת חשבון אחד. התמונות שלך נמחקות לאחר הבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ का नंबर कभी सेव नहीं किया जाता — सिर्फ़ उसका एक फ़िंगरप्रिंट, ताकि एक दस्तावेज़ से एक ही अकाउंट सत्यापित हो। समीक्षा के बाद आपकी फ़ोटो हटा दी जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj isprave nikada se ne sprema — samo njegov otisak, tako da jedna isprava može potvrditi jedan račun. Tvoje fotografije se brišu nakon pregleda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmány számát soha nem tároljuk – csak egy ujjlenyomatát, hogy egy okmány egy fiókot hitelesíthessen. A fotóid az elbírálás után törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor dokumen tidak pernah disimpan — hanya sidik jarinya, sehingga satu dokumen hanya bisa memverifikasi satu akun. Fotomu dihapus setelah ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero del documento non viene mai conservato: solo la sua impronta, così un documento può verificare un solo account. Le tue foto vengono eliminate dopo la revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類番号は保存されません。保存されるのはそのフィンガープリントだけで、1つの書類で認証できるアカウントは1つになります。写真は審査後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 번호는 저장되지 않고 지문 정보만 저장되어, 하나의 문서로 하나의 계정만 인증할 수 있어요. 사진은 검토가 끝나면 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖയുടെ നമ്പർ ഒരിക്കലും സൂക്ഷിക്കില്ല — അതിന്റെ ഫിംഗർപ്രിന്റ് മാത്രം, അങ്ങനെ ഒരു രേഖ കൊണ്ട് ഒരു അക്കൗണ്ട് മാത്രമേ പരിശോധിക്കാനാകൂ. പരിശോധിച്ചുകഴിഞ്ഞാൽ നിങ്ങളുടെ ഫോട്ടോകൾ ഇല്ലാതാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor dokumen tidak pernah disimpan — hanya cap jarinya, supaya satu dokumen hanya boleh mengesahkan satu akaun. Foto anda dipadam setelah disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentnummeret lagres aldri, bare et fingeravtrykk av det, slik at ett dokument bare kan verifisere én konto. Bildene dine slettes etter gjennomgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het documentnummer wordt nooit opgeslagen, alleen een vingerafdruk ervan, zodat één document één account kan verifiëren. Je foto's worden verwijderd zodra ze zijn beoordeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer dokumentu nigdy nie jest przechowywany — tylko jego odcisk, dzięki czemu jeden dokument może zweryfikować jedno konto. Twoje zdjęcia są usuwane po sprawdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número do documento nunca é guardado, apenas uma impressão digital dele, para que um documento verifique uma só conta. Suas fotos são excluídas depois da análise."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não guardamos o número do documento; apenas uma impressão digital dele, para que um documento só verifique uma conta. As suas fotos são eliminadas depois de revistas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul documentului nu este stocat niciodată — doar o amprentă a lui, ca un document să poată verifica un singur cont. Fotografiile tale sunt șterse după analiză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер документа не хранится — только его отпечаток, чтобы один документ подтверждал один аккаунт. Ваши фото удаляются после проверки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo dokladu sa nikdy neukladá — iba jeho odtlačok, aby jeden doklad mohol overiť jeden účet. Tvoje fotky sa po posúdení odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentnumret sparas aldrig – bara ett fingeravtryck av det, så att ett dokument bara kan verifiera ett konto. Dina bilder raderas när de har granskats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆவண எண் ஒருபோதும் சேமிக்கப்படாது — அதன் கைரேகை மட்டுமே, அதனால் ஓர் ஆவணம் ஒரு கணக்கை மட்டுமே சரிபார்க்கும். மதிப்பாய்வு முடிந்ததும் உங்கள் புகைப்படங்கள் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పత్రం నంబర్ ఎప్పుడూ నిల్వ చేయబడదు — దాని ఫింగర్‌ప్రింట్ మాత్రమే, తద్వారా ఒక పత్రం ఒక ఖాతాను మాత్రమే ధృవీకరించగలదు. సమీక్ష పూర్తయ్యాక మీ ఫోటోలు తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบไม่เก็บหมายเลขเอกสาร เก็บเพียงลายนิ้วมือดิจิทัลของหมายเลข เพื่อให้เอกสารหนึ่งใบยืนยันได้หนึ่งบัญชี รูปของคุณจะถูกลบเมื่อตรวจสอบแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge numarası asla saklanmaz; yalnızca parmak izi saklanır, böylece bir belge yalnızca bir hesabı doğrulayabilir. Fotoğraflarınız incelendikten sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер документа ніколи не зберігається — лише його відбиток, тож один документ може верифікувати один обліковий запис. Ваші фото видаляються після розгляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستاویز کا نمبر کبھی محفوظ نہیں کیا جاتا — صرف اس کا فنگر پرنٹ، تاکہ ایک دستاویز سے ایک ہی اکاؤنٹ کی تصدیق ہو۔ جائزے کے بعد آپ کی تصاویر حذف ہو جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số giấy tờ không bao giờ được lưu — chỉ lưu một dấu vân tay của nó, để một giấy tờ chỉ xác minh được một tài khoản. Ảnh của bạn bị xóa sau khi được xét duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证件号码绝不会被存储，只保存其指纹，使一份证件只能验证一个账户。你的照片在审核后会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件號碼絕不會被儲存，只會保存它的指紋，讓一份證件只能驗證一個帳號。你的照片在審核後即會刪除。"
          }
        }
      }
    },
    "document.privacy.offer": {
      "comment": "Contract v34 §7.5: privacy note under the document picker while the server offers to keep photos.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نخزّن رقم وثيقتك نصًّا — بصمة منه فقط، ليتحقق حساب واحد بوثيقة واحدة. تُحذف صورك (وهو ظاهر فيها) بعد المراجعة، إلا إن اخترت أدناه الاحتفاظ بها في ملف التحقق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার নথির নম্বর লেখা হিসেবে রাখি না — শুধু এর একটি ফিঙ্গারপ্রিন্ট রাখি, যাতে একটি নথি দিয়ে একটি অ্যাকাউন্ট ভেরিফাই হয়। নিচে আপনার ভেরিফিকেশন ফাইলে রাখতে না চাইলে রিভিউ শেষ হলে আপনার ছবিগুলো (যেগুলোতে নম্বর দেখা যায়) মুছে ফেলা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No desem el número del teu document com a text: només una empremta digital, perquè un document només pugui verificar un compte. Les teves fotos (que el mostren) s'eliminen un cop revisades, tret que triïs a sota conservar-les al teu fitxer de verificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo dokladu neukládáme jako text – jen jeho otisk, takže jeden doklad ověří jeden účet. Tvé fotografie (které ho zobrazují) se po posouzení smažou, pokud níže nezvolíš jejich ponechání v ověřovacím souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi gemmer ikke dit dokumentnummer som tekst – kun et fingeraftryk af det, så ét dokument kun kan verificere én konto. Dine fotos (hvor det kan ses) slettes, når de er gennemgået, medmindre du nedenfor vælger at beholde dem i din verificeringsfil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir speichern deine Dokumentnummer nicht als Text – nur einen Fingerabdruck davon, damit ein Dokument nur ein Konto verifizieren kann. Deine Fotos (auf denen sie zu sehen ist) werden nach der Prüfung gelöscht, es sei denn, du entscheidest dich unten dafür, sie in deiner Verifizierungsakte aufzubewahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αποθηκεύουμε τον αριθμό του εγγράφου σου ως κείμενο — μόνο ένα αποτύπωμά του, ώστε ένα έγγραφο να επαληθεύει έναν λογαριασμό. Οι φωτογραφίες σου (που τον δείχνουν) διαγράφονται μόλις εξεταστούν, εκτός αν επιλέξεις παρακάτω να τις κρατήσεις στον φάκελο επαλήθευσής σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't store your document number as text — only a fingerprint of it, so one document can verify one account. Your photos (which show it) are deleted once reviewed, unless you choose below to keep them in your verification file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardamos el número de tu documento como texto, solo una huella suya, para que un documento verifique una sola cuenta. Tus fotos (donde aparece) se eliminan una vez revisadas, salvo que elijas abajo conservarlas en tu expediente de verificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme tallenna asiakirjasi numeroa tekstinä – vain sen sormenjäljen, jotta yksi asiakirja voi vahvistaa yhden tilin. Kuvasi (joissa numero näkyy) poistetaan tarkastuksen jälkeen, ellet valitse alla säilyttää niitä vahvistustiedostossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne stockons pas le numéro de votre document en texte — seulement son empreinte, pour qu’un document ne puisse vérifier qu’un seul compte. Vos photos (qui le montrent) sont supprimées après examen, sauf si vous choisissez ci-dessous de les garder dans votre dossier de vérification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנחנו לא שומרים את מספר המסמך שלך כטקסט — רק טביעת אצבע שלו, כך שמסמך אחד יכול לאמת חשבון אחד. התמונות שלך (שמראות אותו) נמחקות לאחר הבדיקה, אלא אם תבחר למטה לשמור אותן בתיק האימות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपके दस्तावेज़ का नंबर टेक्स्ट के रूप में सेव नहीं करते — सिर्फ़ उसका फ़िंगरप्रिंट, ताकि एक दस्तावेज़ से एक ही अकाउंट सत्यापित हो। आपकी फ़ोटो (जिनमें वह दिखता है) समीक्षा के बाद हटा दी जाती हैं, जब तक आप नीचे उन्हें अपनी सत्यापन फ़ाइल में रखना न चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj tvoje isprave ne spremamo kao tekst — samo njegov otisak, tako da jedna isprava može potvrditi jedan račun. Tvoje fotografije (na kojima se vidi) brišu se nakon pregleda, osim ako ispod odlučiš zadržati ih u svojoj datoteci za provjeru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányod számát nem tároljuk szövegként – csak egy ujjlenyomatát, hogy egy okmány egy fiókot hitelesíthessen. A fotóid (amelyeken látszik) az elbírálás után törlődnek, kivéve ha lent úgy döntesz, hogy megőrizzük őket a hitelesítési aktádban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menyimpan nomor dokumenmu sebagai teks — hanya sidik jarinya, sehingga satu dokumen hanya bisa memverifikasi satu akun. Fotomu (yang menampakkannya) dihapus setelah ditinjau, kecuali kamu memilih di bawah untuk menyimpannya di berkas verifikasimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non conserviamo il numero del documento come testo: solo la sua impronta, così un documento può verificare un solo account. Le tue foto (che lo mostrano) vengono eliminate dopo la revisione, a meno che tu non scelga qui sotto di conservarle nel tuo fascicolo di verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類番号はテキストとして保存されません。保存されるのはそのフィンガープリントだけで、1つの書類で認証できるアカウントは1つになります。番号が写っている写真は審査後に削除されます。ただし、下で認証ファイルへの保管を選んだ場合を除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 번호는 텍스트로 저장하지 않고 지문 정보만 저장해서, 하나의 문서로 하나의 계정만 인증할 수 있어요. 문서 번호가 보이는 사진은 검토가 끝나면 삭제돼요. 단, 아래에서 인증 파일에 보관하도록 선택한 경우는 예외예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖയുടെ നമ്പർ ടെക്സ്റ്റായി ഞങ്ങൾ സൂക്ഷിക്കില്ല — അതിന്റെ ഫിംഗർപ്രിന്റ് മാത്രം, അങ്ങനെ ഒരു രേഖ കൊണ്ട് ഒരു അക്കൗണ്ട് മാത്രമേ പരിശോധിക്കാനാകൂ. നമ്പർ കാണുന്ന നിങ്ങളുടെ ഫോട്ടോകൾ, താഴെ പരിശോധനാ ഫയലിൽ സൂക്ഷിക്കാൻ തിരഞ്ഞെടുത്തില്ലെങ്കിൽ, പരിശോധിച്ചുകഴിഞ്ഞാൽ ഇല്ലാതാക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menyimpan nombor dokumen anda sebagai teks — hanya cap jarinya, supaya satu dokumen hanya boleh mengesahkan satu akaun. Foto anda (yang menunjukkannya) dipadam setelah disemak, melainkan anda memilih di bawah untuk menyimpannya dalam fail pengesahan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi lagrer ikke dokumentnummeret ditt som tekst, bare et fingeravtrykk av det, slik at ett dokument bare kan verifisere én konto. Bildene dine (som viser det) slettes etter gjennomgang, med mindre du velger nedenfor å beholde dem i verifiseringsmappen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We slaan je documentnummer niet op als tekst, alleen een vingerafdruk ervan, zodat één document één account kan verifiëren. Je foto's (waarop het nummer staat) worden verwijderd zodra ze zijn beoordeeld, tenzij je hieronder kiest om ze in je verificatiedossier te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przechowujemy numeru dokumentu jako tekstu — tylko jego odcisk, dzięki czemu jeden dokument może zweryfikować jedno konto. Twoje zdjęcia (na których widać numer) są usuwane po sprawdzeniu, chyba że poniżej zdecydujesz się zachować je w teczce weryfikacyjnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não guardamos o número do seu documento como texto, apenas uma impressão digital dele, para que um documento verifique uma só conta. Suas fotos (que o mostram) são excluídas depois da análise, a menos que você escolha abaixo mantê-las no seu arquivo de verificação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não guardamos o número do seu documento como texto; apenas uma impressão digital dele, para que um documento só verifique uma conta. As suas fotos (que o mostram) são eliminadas depois de revistas, a não ser que escolha abaixo guardá-las no seu ficheiro de verificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu stocăm numărul documentului ca text — doar o amprentă a lui, ca un document să poată verifica un singur cont. Fotografiile tale (care îl arată) sunt șterse după analiză, dacă nu alegi mai jos să le păstrezi în dosarul de verificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не храним номер документа в виде текста — только его отпечаток, чтобы один документ подтверждал один аккаунт. Ваши фото (на них он виден) удаляются после проверки, если ниже вы не решите сохранить их в файле проверки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo dokladu neukladáme ako text — iba jeho odtlačok, aby jeden doklad mohol overiť jeden účet. Tvoje fotky (na ktorých je vidieť) sa po posúdení odstránia, pokiaľ nižšie nezvolíš, že ich chceš uchovať v overovacom spise."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sparar inte ditt dokumentnummer som text – bara ett fingeravtryck av det, så att ett dokument bara kan verifiera ett konto. Dina bilder (där det syns) raderas när de har granskats, om du inte nedan väljer att behålla dem i din verifieringsfil."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவண எண்ணை உரையாகச் சேமிப்பதில்லை — அதன் கைரேகை மட்டுமே, அதனால் ஓர் ஆவணம் ஒரு கணக்கை மட்டுமே சரிபார்க்கும். கீழே உங்கள் சரிபார்ப்புக் கோப்பில் வைக்கத் தேர்ந்தெடுத்தால் தவிர, (அதைக் காட்டும்) உங்கள் புகைப்படங்கள் மதிப்பாய்வு முடிந்ததும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మేము మీ పత్రం నంబర్‌ను టెక్స్ట్‌గా నిల్వ చేయం — దాని ఫింగర్‌ప్రింట్ మాత్రమే, తద్వారా ఒక పత్రం ఒక ఖాతాను మాత్రమే ధృవీకరించగలదు. కింద మీరు వాటిని మీ ధృవీకరణ ఫైల్‌లో ఉంచుకోవాలని ఎంచుకుంటే తప్ప, సమీక్ష పూర్తయ్యాక మీ ఫోటోలు (వాటిలో నంబర్ కనిపిస్తుంది) తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราไม่เก็บหมายเลขเอกสารเป็นข้อความ เก็บเพียงลายนิ้วมือดิจิทัลของหมายเลข เพื่อให้เอกสารหนึ่งใบยืนยันได้หนึ่งบัญชี รูปของคุณ (ซึ่งเห็นหมายเลข) จะถูกลบเมื่อตรวจสอบแล้ว เว้นแต่คุณเลือกด้านล่างให้เก็บไว้ในแฟ้มยืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge numaranızı metin olarak saklamayız; yalnızca parmak izini saklarız, böylece bir belge yalnızca bir hesabı doğrulayabilir. Numarayı gösteren fotoğraflarınız, aşağıda doğrulama dosyanızda saklamayı seçmediğiniz sürece incelendikten sonra silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми не зберігаємо номер вашого документа як текст — лише його відбиток, тож один документ може верифікувати один обліковий запис. Ваші фото (на яких він видно) видаляються після розгляду, якщо ви не виберете нижче зберегти їх у файлі верифікації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کے دستاویز کا نمبر متن کی صورت میں محفوظ نہیں کرتے — صرف اس کا فنگر پرنٹ، تاکہ ایک دستاویز سے ایک ہی اکاؤنٹ کی تصدیق ہو۔ آپ کی تصاویر (جن میں وہ نظر آتا ہے) جائزے کے بعد حذف ہو جاتی ہیں، سوائے اس کے کہ آپ نیچے انہیں اپنی تصدیقی فائل میں رکھنے کا انتخاب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không lưu số giấy tờ của bạn dưới dạng văn bản — chỉ lưu một dấu vân tay của nó, để một giấy tờ chỉ xác minh được một tài khoản. Ảnh của bạn (có hiện số này) bị xóa sau khi được xét duyệt, trừ khi bạn chọn bên dưới để giữ chúng trong hồ sơ xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不会以文本形式存储你的证件号码，只保存其指纹，使一份证件只能验证一个账户。你的照片（上面有该号码）在审核后会被删除，除非你在下方选择将其保存在验证档案中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們不會以文字形式儲存你的證件號碼，只保存它的指紋，讓一份證件只能驗證一個帳號。你的照片（其中含有號碼）在審核後即會刪除，除非你在下方選擇將其保留在驗證檔案中。"
          }
        }
      }
    },
