    "safety.lists.reports.empty.subtitle": {
      "comment": "Empty reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا البلاغات التي تقدّمها مع حالتها، لترى ما حدث لكل منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার করা রিপোর্ট অবস্থাসহ এখানে দেখা যায়, যাতে প্রতিটির কী হলো তা জানতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les denúncies que facis apareixen aquí amb el seu estat, perquè puguis veure què ha passat amb cadascuna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlášení, která podáš, se zobrazí tady se svým stavem, abys viděl, co se s každým stalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelser, du indgiver, vises her med deres status, så du kan se, hvad der skete med hver enkelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen, die du einreichst, erscheinen hier mit ihrem Status, damit du siehst, was daraus wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναφορές που υποβάλλεις εμφανίζονται εδώ με την κατάστασή τους, ώστε να βλέπεις τι έγινε με καθεμία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports you file show up here with their status, so you can see what happened to each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias que presentes aparecen aquí con su estado, para que veas qué pasó con cada una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekemäsi ilmiannot näkyvät täällä tilansa kanssa, joten näet, mitä kullekin tapahtui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements que vous faites apparaissent ici avec leur statut, pour que vous voyiez ce qu’est devenu chacun."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווחים שאתה מגיש מופיעים כאן עם הסטטוס שלהם, כדי שתראה מה קרה לכל אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी दर्ज की रिपोर्टें अपनी स्थिति के साथ यहाँ दिखती हैं, ताकि आप देख सकें कि हर एक का क्या हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijave koje podneseš pojavljuju se ovdje sa svojim statusom, pa možeš vidjeti što se dogodilo sa svakom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leadott jelentéseid állapotukkal itt jelennek meg, így láthatod, mi történt mindegyikkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan yang kamu ajukan muncul di sini beserta statusnya, agar kamu bisa melihat apa yang terjadi pada masing-masing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni che invii compaiono qui con il loro stato, così puoi vedere cosa è successo a ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告した内容は、状況とともにここに表示されます。それぞれがどうなったかを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출한 신고가 상태와 함께 여기에 표시되어 각 신고가 어떻게 되었는지 확인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നൽകുന്ന റിപ്പോർട്ടുകൾ അവയുടെ നിലയോടൊപ്പം ഇവിടെ കാണും, ഓരോന്നിനും എന്ത് സംഭവിച്ചെന്ന് അറിയാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan yang anda failkan muncul di sini bersama statusnya, supaya anda dapat melihat apa yang berlaku pada setiap satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter du sender inn, vises her med status, slik at du kan se hva som skjedde med hver enkelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen die je indient verschijnen hier met hun status, zodat je kunt zien wat er met elke melding is gebeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Składane zgłoszenia pojawiają się tutaj ze swoim statusem, więc możesz zobaczyć, co się z każdym stało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias que você faz aparecem aqui com o status, para que você veja o que aconteceu com cada uma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias que fizer aparecem aqui com o respetivo estado, para ver o que aconteceu a cada uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportările pe care le depui apar aici cu starea lor, ca să vezi ce s-a întâmplat cu fiecare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поданные вами жалобы появятся здесь со статусом, чтобы вы видели, что стало с каждой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásenia, ktoré podáš, sa tu zobrazia s ich stavom, aby si videl, čo sa s každým stalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter du skickar visas här med sin status, så att du kan se vad som hände med var och en."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அளிக்கும் புகார்கள் அவற்றின் நிலையுடன் இங்கே தோன்றும், ஒவ்வொன்றுக்கும் என்ன ஆனது என்று பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు దాఖలు చేసిన రిపోర్ట్‌లు వాటి స్థితితో ఇక్కడ కనిపిస్తాయి, తద్వారా ప్రతిదానికి ఏమైందో చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานที่คุณส่งจะแสดงที่นี่พร้อมสถานะ เพื่อให้คุณเห็นว่าแต่ละเรื่องเป็นอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaptığınız şikayetler durumlarıyla burada görünür, böylece her birine ne olduğunu görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скарги, які ви подаєте, з’являються тут зі своїм статусом, щоб ви бачили, що сталося з кожною."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جمع کی ہوئی رپورٹس اپنی حیثیت کے ساتھ یہاں نظر آتی ہیں، تاکہ آپ دیکھ سکیں کہ ہر ایک کا کیا ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các báo cáo bạn gửi hiện ở đây cùng trạng thái, để bạn thấy điều gì đã xảy ra với từng báo cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你提交的举报会连同状态显示在这里，你可以看到每一项的处理结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你提出的檢舉會連同狀態顯示在這裡，讓你看到每一項的處理結果。"
          }
        }
      }
    },
    "safety.lists.reports.empty.title": {
      "comment": "Empty reports list.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبلّغ عن أي شيء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কিছুই রিপোর্ট করেননি"
          }
        },
        "ca": {
