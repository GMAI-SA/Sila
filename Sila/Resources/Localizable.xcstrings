          "stringUnit": {
            "state": "translated",
            "value": "Du skjulte dette temaet. Vis det igjen i Innstillinger for å se det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt dit onderwerp verborgen. Maak het zichtbaar in Voorkeuren om het weer te zien."
