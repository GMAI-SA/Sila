        }
      }
    },
    "safety.suspended.indefinite": {
      "comment": "What an indefinite suspension means, said plainly rather than left blank.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تاريخ انتهاء لهذا الإيقاف. ولا ينتهي من تلقاء نفسه — والتظلّم هو الشيء الوحيد الذي يغيّره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্থগিতাদেশের কোনো শেষ তারিখ নেই। এটি নিজে থেকে শেষ হয় না — শুধু আপিলই এটি বদলাতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta suspensió no té data de finalització. No caduca per si sola: una apel·lació és l'única cosa que la pot canviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto pozastavení nemá datum konce. Samo nevyprší – změnit ho může jen odvolání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne suspension har ingen slutdato. Den udløber ikke af sig selv – kun en anke kan ændre den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sperre hat kein Enddatum. Sie läuft nicht von selbst ab – nur ein Einspruch kann sie ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η αναστολή δεν έχει ημερομηνία λήξης. Δεν λήγει μόνη της — μόνο μια ένσταση μπορεί να την αλλάξει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This suspension has no end date. It does not expire on its own — an appeal is the only thing that changes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta suspensión no tiene fecha de fin. No caduca por sí sola: una apelación es lo único que la cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä jäädytyksellä ei ole päättymispäivää. Se ei raukea itsestään – valitus on ainoa asia, joka sen muuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette suspension n’a pas de date de fin. Elle n’expire pas d’elle-même — seul un recours peut la modifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להשעיה הזו אין תאריך סיום. היא לא פוקעת מעצמה — ערעור הוא הדבר היחיד ששולח אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस निलंबन की कोई समाप्ति तिथि नहीं है। यह अपने-आप खत्म नहीं होता — सिर्फ़ अपील इसे बदल सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova suspenzija nema datum završetka. Ne istječe sama od sebe — jedino je žalba može promijeniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a felfüggesztésnek nincs lejárati dátuma. Magától nem jár le – csak egy fellebbezés változtathat rajta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penangguhan ini tidak punya tanggal berakhir. Tidak berakhir dengan sendirinya — banding adalah satu-satunya yang mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sospensione non ha una data di fine. Non scade da sola: solo un ricorso può cambiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この停止には終了日がありません。自然には解除されず、変えられるのは異議申し立てだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정지에는 종료일이 없어요. 저절로 만료되지 않으며, 이의 신청만이 상황을 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സസ്പെൻഷന് അവസാന തീയതിയില്ല. ഇത് തനിയെ അവസാനിക്കില്ല — ഇത് മാറ്റാൻ കഴിയുന്നത് ഒരു അപ്പീലിന് മാത്രമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggantungan ini tiada tarikh tamat. Ia tidak tamat dengan sendirinya — rayuan ialah satu-satunya yang boleh mengubahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne suspensjonen har ingen sluttdato. Den utløper ikke av seg selv. En anke er det eneste som kan endre den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schorsing heeft geen einddatum. Ze verloopt niet vanzelf: alleen een bezwaar kan dit veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zawieszenie nie ma daty końca. Nie wygasa samo — zmienić je może tylko odwołanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta suspensão não tem data de término. Ela não expira sozinha: só uma contestação pode mudá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta suspensão não tem data de fim. Não expira por si — só uma contestação a pode alterar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această suspendare nu are dată de încheiere. Nu expiră singură — doar o contestație o poate schimba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой блокировки нет даты окончания. Сама она не закончится — изменить её может только апелляция."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto pozastavenie nemá dátum ukončenia. Samo nevyprší — zmeniť ho môže len odvolanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här avstängningen har inget slutdatum. Den går inte ut av sig själv – ett överklagande är det enda som ändrar den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இடைநீக்கத்துக்கு முடிவுத் தேதி இல்லை. இது தானாக முடியாது — மேல்முறையீடு மட்டுமே இதை மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సస్పెన్షన్‌కు ముగింపు తేదీ లేదు. ఇది దానంతట అదే ముగియదు — అప్పీల్ మాత్రమే దీన్ని మార్చగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การระงับนี้ไม่มีวันสิ้นสุด ไม่หมดอายุเอง สิ่งเดียวที่เปลี่ยนได้คือการอุทธรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu askıya almanın bitiş tarihi yok. Kendiliğinden sona ermez; onu değiştirebilecek tek şey itirazdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призупинення не має дати завершення. Воно не закінчується саме — його може змінити лише апеляція."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس معطلی کی کوئی اختتامی تاریخ نہیں۔ یہ خود ختم نہیں ہوتی — اسے صرف اپیل ہی بدل سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đình chỉ này không có ngày kết thúc. Nó không tự hết hạn — khiếu nại là cách duy nhất để thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次封禁没有结束日期，不会自行到期，只有申诉才能改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此停權沒有結束日期，不會自動到期，只有申訴能改變它。"
          }
        }
      }
    },
