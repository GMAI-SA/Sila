        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien aceptó tu aval: confirma que es esa persona"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku hyväksyi takuusi – vahvista, että se on hän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a accepté votre caution — confirmez que c’est bien lui"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו קיבל את הערבות שלך — אשר שזה הוא"
