        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "آپ ایک وقت میں %lld شخص کے ساتھ کھڑے ہو سکتے ہیں۔"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "آپ ایک وقت میں %lld لوگوں کے ساتھ کھڑے ہو سکتے ہیں۔"
