    "rooms.join.unverifiedCannotOpen": {
      "comment": "Refusal when an unverified account tries to host. Listening is open to everyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح الغرف متاح للموثّقين فقط. والاستماع متاح للجميع — أكمل توثيق هويتك لتستضيف غرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভেরিফায়েড মানুষ রুম খুলতে পারে। সবাই শুনতে পারে — হোস্ট করতে পরিচয় যাচাই শেষ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només les persones verificades poden obrir una sala. Tothom en pot escoltar una; acaba la verificació d'identitat per ser amfitrió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost mohou otevřít jen ověření lidé. Poslouchat může každý – dokonči ověření totožnosti, abys mohl vést."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun verificerede mennesker kan åbne et rum. Alle kan lytte til et – gør din identitetsverificering færdig for at være vært."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verifizierte Menschen können einen Raum öffnen. Alle können zuhören – schließe die Identitätsprüfung ab, um zu hosten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο επαληθευμένοι άνθρωποι μπορούν να ανοίξουν αίθουσα. Όλοι μπορούν να ακούσουν μία — ολοκλήρωσε την επαλήθευση ταυτότητας για να διοργανώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only verified humans can open a room. Everyone can listen to one — finish identity verification to host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las personas verificadas pueden abrir una sala. Todos pueden escuchar una; termina la verificación de identidad para ser anfitrión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain vahvistetut ihmiset voivat avata huoneen. Kaikki voivat kuunnella sellaista – viimeistele henkilöllisyyden vahvistus isännöidäksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les humains vérifiés peuvent ouvrir un salon. Tout le monde peut en écouter un — terminez la vérification d’identité pour animer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק בני אדם מאומתים יכולים לפתוח חדר. כולם יכולים להאזין לאחד — השלם אימות זהות כדי לארח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सत्यापित इंसान रूम खोल सकते हैं। रूम को कोई भी सुन सकता है — होस्ट बनने के लिए पहचान सत्यापन पूरा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobu mogu otvoriti samo potvrđeni ljudi. Svatko je može slušati — dovrši provjeru identiteta da bi bio/la domaćin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szobát csak hitelesített emberek nyithatnak. Hallgatni mindenki hallgathat – a házigazdáskodáshoz fejezd be a személyazonosság hitelesítését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia terverifikasi yang bisa membuka room. Semua orang bisa mendengarkannya — selesaikan verifikasi identitas untuk menjadi host."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le persone verificate possono aprire una stanza. Tutti possono ascoltarne una: completa la verifica dell'identità per ospitare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームを開けるのは認証済みの人だけです。聴くのは誰でもできます。ホストになるには本人確認を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 사람만 룸을 열 수 있어요. 누구나 룸을 들을 수 있으니, 호스트가 되려면 신원 인증을 완료하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വെരിഫൈ ചെയ്ത മനുഷ്യർക്ക് മാത്രമേ റൂം തുറക്കാനാകൂ. ആർക്കും കേൾക്കാം — ഹോസ്റ്റ് ചെയ്യാൻ ഐഡന്റിറ്റി വെരിഫിക്കേഷൻ പൂർത്തിയാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya manusia yang disahkan boleh membuka bilik. Sesiapa boleh mendengar satu — selesaikan pengesahan identiti untuk menjadi hos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare verifiserte mennesker kan åpne et rom. Alle kan lytte til ett. Fullfør identitetsverifiseringen for å være vert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geverifieerde mensen kunnen een room openen. Iedereen kan luisteren; rond je identiteitsverificatie af om te hosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko zweryfikowani ludzie mogą otwierać pokoje. Każdy może ich słuchać — dokończ weryfikację tożsamości, aby prowadzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem abrir uma sala. Todos podem ouvir; conclua a verificação de identidade para ser anfitrião."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pessoas verificadas podem abrir uma sala. Todos podem ouvir uma — conclua a verificação de identidade para ser anfitrião."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar oamenii verificați pot deschide o cameră. Oricine poate asculta una — finalizează verificarea identității ca să fii gazdă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать комнаты могут только проверенные люди. Слушать может каждый — завершите проверку личности, чтобы вести комнату."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosť môžu otvoriť iba overení ľudia. Počúvať môže každý — na vedenie miestnosti dokonči overenie totožnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara verifierade människor kan öppna ett rum. Alla kan lyssna på ett – slutför identitetsverifieringen för att vara värd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்பட்ட மனிதர்கள் மட்டுமே அறை திறக்கலாம். எல்லோரும் ஒன்றைக் கேட்கலாம் — நடத்த அடையாளச் சரிபார்ப்பை முடியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధృవీకరించబడిన మనుషులు మాత్రమే రూమ్ తెరవగలరు. ఎవరైనా వినవచ్చు — హోస్ట్ చేయడానికి గుర్తింపు ధృవీకరణ పూర్తి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคนจริงที่ยืนยันตัวตนแล้วเท่านั้นที่เปิดห้องได้ ทุกคนฟังห้องได้ ยืนยันตัวตนให้เสร็จเพื่อเป็นเจ้าของห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğrulanmış insanlar oda açabilir. Herkes dinleyebilir; sunucu olmak için kimlik doğrulamasını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривати кімнату можуть лише верифіковані люди. Слухати може кожен — завершіть верифікацію особи, щоб вести кімнату."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تصدیق شدہ انسان روم کھول سکتے ہیں۔ سننا سب کے لیے ہے — میزبانی کے لیے شناخت کی تصدیق مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người thật đã xác minh mới mở được phòng. Ai cũng nghe được — hãy hoàn tất xác minh danh tính để làm chủ phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已验证的真人才能开启房间。每个人都能收听，完成身份验证后即可主持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已驗證的真人才能開設聊天室。任何人都能收聽，完成身分驗證即可主持。"
          }
        }
      }
    },
    "rooms.leave.hint": {
      "comment": "VoiceOver hint for the leave button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغادر الغرفة ويقطع صوتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম ছেড়ে যায় এবং আপনার অডিও বিচ্ছিন্ন করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Surt de la sala i desconnecta l'àudio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opustí místnost a odpojí tvůj zvuk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forlader rummet og afbryder din lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlässt den Raum und trennt dein Audio."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποχωρεί από την αίθουσα και αποσυνδέει τον ήχο σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves the room and disconnects your audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de la sala y desconecta tu audio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistuu huoneesta ja katkaisee äänesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte le salon et coupe votre audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוזב את החדר ומנתק את השמע שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम छोड़ता है और आपका ऑडियो डिस्कनेक्ट करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napušta sobu i prekida tvoj zvuk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elhagyja a szobát, és bontja a hangodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari room dan memutus audiomu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce dalla stanza e scollega il tuo audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームを退出し、音声を切断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸에서 나가고 오디오 연결을 끊어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം വിടുകയും നിങ്ങളുടെ ഓഡിയോ വിച്ഛേദിക്കുകയും ചെയ്യുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari bilik dan memutuskan audio anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forlater rommet og kobler fra lyden din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaat de room en verbreekt je audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuszcza pokój i rozłącza Twój dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai da sala e desconecta seu áudio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai da sala e desliga o seu áudio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Părăsește camera și deconectează sunetul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходит из комнаты и отключает ваш звук."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opustí miestnosť a odpojí tvoj zvuk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämnar rummet och kopplar bort ditt ljud."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறையிலிருந்து வெளியேறி உங்கள் ஒலியைத் துண்டிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌ను వదిలి మీ ఆడియోను డిస్‌కనెక్ట్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากห้องและตัดการเชื่อมต่อเสียงของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odadan ayrılır ve sesinizi keser."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишає кімнату й вимикає ваш звук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم چھوڑتا ہے اور آپ کی آواز منقطع کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rời phòng và ngắt âm thanh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开房间并断开你的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開聊天室並中斷你的音訊。"
          }
        }
      }
    },
