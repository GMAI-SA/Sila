    "notifications.kind.roomLike.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يعجب أحد بغرفة استضفتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হোস্ট করা রুম কেউ লাইক করলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú dona m'agrada a una sala que has dirigit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někdo ocení místnost, kterou jsi vedl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen synes godt om et rum, du var vært for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand einen Raum liket, den du gehostet hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος δηλώνει «μου αρέσει» σε αίθουσα που διοργάνωσες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone likes a room you hosted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando a alguien le gusta una sala que organizaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku tykkää isännöimästäsi huoneesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un aime un salon que vous avez animé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו אוהב חדר שארחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके होस्ट किए रूम को पसंद करे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad netko lajka sobu koju si vodio/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor valaki kedvel egy általad vezetett szobát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat seseorang menyukai room yang kamu host."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a qualcuno piace una stanza che hai ospitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがホストしたルームに誰かがいいねしたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 내가 호스트한 룸에 좋아요를 눌렀을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഹോസ്റ്റ് ചെയ്ത റൂം ആരെങ്കിലും ലൈക്ക് ചെയ്യുമ്പോൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila seseorang menyukai bilik yang anda hoskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når noen liker et rom du var vert for."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer iemand een room liket die jij hebt gehost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś polubi pokój, który prowadziłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém curte uma sala que você apresentou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando alguém gosta de uma sala que organizou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când cineva apreciază o cameră găzduită de tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда кому-то нравится комната, которую вы вели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa niekomu páči miestnosť, ktorú si viedol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När någon gillar ett rum du var värd för."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் நடத்திய அறையை யாராவது விரும்பும்போது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు హోస్ట్ చేసిన రూమ్‌ను ఎవరైనా లైక్ చేసినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีคนกดถูกใจห้องที่คุณเป็นเจ้าของ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri sunduğunuz bir odayı beğendiğinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли комусь подобається кімната, яку ви вели."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی آپ کے میزبانی والے روم کو لائک کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó thích một phòng bạn chủ trì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人点赞了你主持的房间时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人對你主持的聊天室按讚時。"
          }
        }
      }
    },
