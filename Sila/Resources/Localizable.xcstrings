    "account.delete.effect.immediate": {
      "comment": "Consequence 1: the account is gone to everyone else at once.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعطَّل حسابك لحظة تأكيدك. وبالنسبة لبقية من في «معروف» يكون قد اختفى بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করার মুহূর্তেই আপনার অ্যাকাউন্ট নিষ্ক্রিয় হয়ে যায়। Known-এর বাকি সবার কাছে এটি এখনই নেই হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu compte es desactiva en el moment de confirmar. Per a la resta de persones a Known, ja no existeix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj účet se deaktivuje v okamžiku potvrzení. Pro všechny ostatní v aplikaci Known už neexistuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto deaktiveres i det øjeblik, du bekræfter. For alle andre på Known er den allerede væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto wird sofort bei der Bestätigung deaktiviert. Für alle anderen auf Known ist es bereits verschwunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σου απενεργοποιείται τη στιγμή που θα επιβεβαιώσεις. Για όλους τους άλλους στο Known έχει ήδη εξαφανιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is deactivated the moment you confirm. To everyone else on Known it is already gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se desactiva en el momento en que confirmas. Para el resto de Known, ya no existe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi poistetaan käytöstä heti, kun vahvistat. Muille Knownin käyttäjille se on jo kadonnut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est désactivé dès que vous confirmez. Pour tous les autres sur Known, il a déjà disparu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון שלך מושבת ברגע שתאשר. עבור כל שאר המשתמשים ב-Known הוא כבר איננו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करते ही आपका अकाउंट निष्क्रिय हो जाता है। Known पर बाकी सबके लिए वह पहले ही जा चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj račun se deaktivira čim potvrdiš. Svima ostalima u aplikaciji Known već je nestao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókod a megerősítés pillanatában deaktiválódik. A Known többi felhasználója számára már nem létezik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akunmu dinonaktifkan begitu kamu mengonfirmasi. Bagi semua orang di Known, akunmu sudah hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account viene disattivato nel momento in cui confermi. Per tutti gli altri su Known è già sparito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定した時点でアカウントは停止されます。Known上のほかの人からは、すでに存在しない状態になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하는 즉시 계정이 비활성화돼요. Known의 다른 모든 사람에게는 이미 사라진 계정이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരീകരിക്കുന്ന നിമിഷം നിങ്ങളുടെ അക്കൗണ്ട് നിർജീവമാകും. Known-ലെ മറ്റുള്ളവർക്ക് അത് ഇതിനകം ഇല്ലാതായിക്കഴിഞ്ഞു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun anda dinyahaktifkan sebaik sahaja anda mengesahkan. Bagi semua orang lain di Known, ia sudah tiada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din deaktiveres i det øyeblikket du bekrefter. For alle andre på Known er den allerede borte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account wordt gedeactiveerd zodra je bevestigt. Voor alle anderen op Known bestaat het dan al niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto zostanie dezaktywowane w chwili potwierdzenia. Dla wszystkich innych w Known już go nie ma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta é desativada assim que você confirma. Para todos os outros no Known, ela já não existe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta é desativada no momento em que confirmar. Para todos os outros na Known, já deixou de existir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul tău este dezactivat în clipa în care confirmi. Pentru ceilalți de pe Known, el a dispărut deja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт деактивируется сразу после подтверждения. Для всех остальных в Known он уже исчез."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj účet sa deaktivuje v okamihu potvrdenia. Pre všetkých ostatných na Known už neexistuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto inaktiveras i samma stund som du bekräftar. För alla andra på Known är det redan borta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிப்படுத்திய கணமே உங்கள் கணக்கு செயலிழக்கும். Known-இல் மற்ற அனைவருக்கும் அது ஏற்கெனவே மறைந்துவிட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నిర్ధారించిన క్షణమే మీ ఖాతా నిష్క్రియం అవుతుంది. Knownలో మిగతా అందరికీ అది ఇప్పటికే లేనట్లే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของคุณจะถูกปิดใช้งานทันทีที่คุณยืนยัน สำหรับคนอื่นๆ ใน Known บัญชีนี้หายไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayladığınız anda hesabınız devre dışı bırakılır. Known'daki herkes için artık yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш обліковий запис деактивується одразу після підтвердження. Для всіх інших у Known його вже немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق کرتے ہی آپ کا اکاؤنٹ غیر فعال ہو جاتا ہے۔ Known پر باقی سب کے لیے وہ پہلے ہی ختم ہو چکا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn bị vô hiệu hóa ngay khi bạn xác nhận. Với mọi người khác trên Known, nó đã biến mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认的那一刻，你的账户就会被停用。对 Known 上的其他人来说，它已经不存在了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號會在確認的那一刻停用。對 Known 上的其他人來說，它已經消失了。"
          }
        }
      }
    },
    "account.delete.effect.permanent": {
      "comment": "What happens after the grace period. Says posts are deleted, not anonymised. %lld is the number of days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
