    "guest.rooms.banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع إلى أي غرفة هنا دون حساب. التحدث والتفاعل والدردشة للأعضاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট ছাড়াই এখানে যেকোনো রুম শুনুন। কথা বলা, রিঅ্যাক্ট করা ও চ্যাট করা সদস্যদের জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolta qualsevol sala aquí sense compte. Parlar, reaccionar i xatejar és per als membres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslouchej tady jakoukoli místnost bez účtu. Mluvit, reagovat a chatovat mohou členové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyt til ethvert rum her uden en konto. At tale, reagere og chatte er for medlemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höre hier jedem Raum ohne Konto zu. Sprechen, Reagieren und Chatten sind Mitgliedern vorbehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άκου οποιαδήποτε αίθουσα εδώ χωρίς λογαριασμό. Η ομιλία, οι αντιδράσεις και η συνομιλία είναι για τα μέλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to any room here without an account. Speaking, reacting and chatting are for members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha aquí cualquier sala sin cuenta. Hablar, reaccionar y chatear es cosa de miembros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntele mitä tahansa huonetta täällä ilman tiliä. Puhuminen, reagoiminen ja keskustelu on jäsenille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez n’importe quel salon ici sans compte. Parler, réagir et discuter sont réservés aux membres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזן לכל חדר כאן בלי חשבון. דיבור, תגובות וצ׳אט שמורים לחברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना अकाउंट के यहाँ कोई भी रूम सुनें। बोलना, रिएक्ट करना और चैट करना सदस्यों के लिए है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slušaj bilo koju sobu ovdje bez računa. Govorenje, reagiranje i čavrljanje rezervirani su za članove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt bármelyik szobát hallgathatod fiók nélkül. A megszólalás, reagálás és csevegés a tagoké."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan room mana pun di sini tanpa akun. Berbicara, bereaksi, dan mengobrol khusus untuk anggota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta qui qualsiasi stanza senza un account. Parlare, reagire e chattare sono riservati ai membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしで、どのルームでも聴けます。発言、リアクション、チャットはメンバー専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 어떤 룸이든 들을 수 있어요. 말하기, 반응, 채팅은 멤버 전용이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ട് ഇല്ലാതെ ഇവിടെ ഏത് റൂമും കേൾക്കാം. സംസാരിക്കലും പ്രതികരിക്കലും ചാറ്റും അംഗങ്ങൾക്കുള്ളതാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengar mana-mana bilik di sini tanpa akaun. Bercakap, bereaksi dan berbual adalah untuk ahli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lytt til alle rom her uten konto. Å snakke, reagere og chatte er for medlemmer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luister hier zonder account naar elke room. Spreken, reageren en chatten is voor leden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchaj dowolnego pokoju tutaj bez konta. Mówienie, reagowanie i czatowanie są dla członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça qualquer sala aqui sem conta. Falar, reagir e conversar são para membros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça qualquer sala aqui sem conta. Falar, reagir e conversar é para membros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascultă aici orice cameră fără cont. Vorbitul, reacțiile și chatul sunt pentru membri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте любую комнату здесь без аккаунта. Говорить, реагировать и писать в чат могут участники."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počúvaj ktorúkoľvek miestnosť tu bez účtu. Hovoriť, reagovať a písať do četu môžu členovia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssna på vilket rum som helst här utan konto. Att tala, reagera och chatta är för medlemmar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்குள்ள எந்த அறையையும் கணக்கு இல்லாமல் கேளுங்கள். பேசுதல், எதிர்வினை, அரட்டை உறுப்பினர்களுக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా లేకుండానే ఇక్కడ ఏ రూమ్‌నైనా వినండి. మాట్లాడటం, రియాక్ట్ అవ్వడం, చాట్ చేయడం సభ్యులకు మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังห้องใดก็ได้ที่นี่โดยไม่ต้องมีบัญชี การพูด แสดงรีแอกชัน และแชทสำหรับสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap açmadan buradaki her odayı dinleyin. Konuşmak, tepki vermek ve sohbet etmek üyelere özeldir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухайте будь-яку кімнату тут без облікового запису. Говорити, реагувати й спілкуватися в чаті можуть учасники."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں اکاؤنٹ کے بغیر کوئی بھی روم سنیں۔ بولنا، ردعمل دینا اور چیٹ کرنا ارکان کے لیے ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe bất kỳ phòng nào ở đây mà không cần tài khoản. Phát biểu, bày tỏ cảm xúc và trò chuyện là dành cho thành viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户即可收听这里的任何房间。发言、回应和聊天仅限成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需帳號即可在此收聽任何聊天室。發言、回應和聊天僅限成員。"
          }
        }
      }
    },
    "guest.rooms.card.a11yHint": {
      "comment": "VoiceOver hint on a room card in a guest's Rooms tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
