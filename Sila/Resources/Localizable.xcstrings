    "vouch.list.rules": {
      "comment": "Three numbers: link hours, confirm hours, vouch days.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الروابط مرة واحدة، لمدة %1$@ ساعة. لديك %2$@ ساعة لتأكيد من قَبِل. تستمر التزكية %3$@ يومًا ولا تُجدَّد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিংক একবারই কাজ করে, %1$@ ঘণ্টার জন্য। কে গ্রহণ করেছেন তা নিশ্চিত করতে আপনার হাতে %2$@ ঘণ্টা। একটি ভাউচ %3$@ দিন চলে এবং নবায়ন করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els enllaços funcionen una sola vegada, durant %1$@ hores. Tens %2$@ hores per confirmar qui ha acceptat. Un aval dura %3$@ dies i no es pot renovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy fungují jednou, %1$@ hodin. Na potvrzení, kdo je přijal, máš %2$@ hodin. Ručení trvá %3$@ dní a nelze ho obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links virker én gang, i %1$@ timer. Du har %2$@ timer til at bekræfte, hvem der accepterede. En garanti varer %3$@ dage og kan ikke fornyes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links funktionieren einmal, für %1$@ Stunden. Du hast %2$@ Stunden, um zu bestätigen, wer angenommen hat. Eine Bürgschaft gilt %3$@ Tage und kann nicht verlängert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σύνδεσμοι λειτουργούν μία φορά, για %1$@ ώρες. Έχεις %2$@ ώρες για να επιβεβαιώσεις ποιος τον αποδέχτηκε. Μια εγγύηση διαρκεί %3$@ ημέρες και δεν ανανεώνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links work once, for %1$@ hours. You have %2$@ hours to confirm who accepted. A vouch lasts %3$@ days and can't be renewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces funcionan una vez, durante %1$@ horas. Tienes %2$@ horas para confirmar quién aceptó. Un aval dura %3$@ días y no se puede renovar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkit toimivat kerran, %1$@ tuntia. Sinulla on %2$@ tuntia aikaa vahvistaa, kuka hyväksyi. Takuu kestää %3$@ päivää eikä sitä voi uusia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens ne fonctionnent qu’une fois, pendant %1$@ heures. Vous avez %2$@ heures pour confirmer qui a accepté. Une caution dure %3$@ jours et ne peut pas être renouvelée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישורים עובדים פעם אחת, במשך %1$@ שעות. יש לך %2$@ שעות לאשר מי קיבל. ערבות נמשכת %3$@ ימים ואי אפשר לחדש אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक एक बार काम करते हैं, %1$@ घंटे के लिए। किसने स्वीकार किया यह कन्फ़र्म करने के लिए आपके पास %2$@ घंटे हैं। वाउच %3$@ दिन चलता है और नवीनीकृत नहीं हो सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveznice vrijede jednom, %1$@ sati. Imaš %2$@ sati da potvrdiš tko je prihvatio. Jamstvo traje %3$@ dana i ne može se obnoviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hivatkozások egyszer működnek, %1$@ óráig. %2$@ órád van megerősíteni, ki fogadta el. Egy kezesség %3$@ napig tart, és nem újítható meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan hanya berlaku sekali, selama %1$@ jam. Kamu punya %2$@ jam untuk mengonfirmasi siapa yang menerima. Jaminan berlangsung %3$@ hari dan tidak bisa diperpanjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link funzionano una volta, per %1$@ ore. Hai %2$@ ore per confermare chi ha accettato. Una garanzia dura %3$@ giorni e non può essere rinnovata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは1回だけ、%1$@時間有効です。受け入れた人を確認する期限は%2$@時間です。保証は%3$@日間続き、更新はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 %1$@시간 동안 한 번만 사용할 수 있어요. 누가 수락했는지 확인할 시간은 %2$@시간이에요. 보증은 %3$@일 동안 유지되며 갱신할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലിങ്കുകൾ %1$@ മണിക്കൂർ നേരത്തേക്ക് ഒരിക്കൽ മാത്രം പ്രവർത്തിക്കും. ആരാണ് സ്വീകരിച്ചതെന്ന് സ്ഥിരീകരിക്കാൻ നിങ്ങൾക്ക് %2$@ മണിക്കൂർ ഉണ്ട്. ഒരു വൗച്ച് %3$@ ദിവസം നീണ്ടുനിൽക്കും, പുതുക്കാനാകില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan berfungsi sekali, selama %1$@ jam. Anda mempunyai %2$@ jam untuk mengesahkan siapa yang menerima. Jaminan bertahan %3$@ hari dan tidak boleh diperbaharui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenker fungerer én gang, i %1$@ timer. Du har %2$@ timer på å bekrefte hvem som godtok. En garanti varer %3$@ dager og kan ikke fornyes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links werken één keer, gedurende %1$@ uur. Je hebt %2$@ uur om te bevestigen wie heeft geaccepteerd. Een garantie duurt %3$@ dagen en kan niet worden verlengd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki działają jednorazowo, przez %1$@ godz. Masz %2$@ godz. na potwierdzenie, kto przyjął. Poręczenie trwa %3$@ dni i nie można go odnowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links funcionam uma vez, por %1$@ horas. Você tem %2$@ horas para confirmar quem aceitou. Um aval dura %3$@ dias e não pode ser renovado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligações funcionam uma vez, durante %1$@ horas. Tem %2$@ horas para confirmar quem a aceitou. Um aval dura %3$@ dias e não pode ser renovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkurile funcționează o singură dată, timp de %1$@ ore. Ai %2$@ ore ca să confirmi cine a acceptat. O garanție durează %3$@ zile și nu poate fi reînnoită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки работают один раз, %1$@ ч. На подтверждение того, кто принял, у вас %2$@ ч. Поручительство длится %3$@ дней и не продлевается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy fungujú raz, %1$@ hodín. Na potvrdenie, kto ich prijal, máš %2$@ hodín. Ručenie trvá %3$@ dní a nedá sa obnoviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar fungerar en gång, i %1$@ timmar. Du har %2$@ timmar på dig att bekräfta vem som godtog. Ett intygande varar i %3$@ dagar och kan inte förnyas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்புகள் %1$@ மணி நேரத்துக்கு, ஒரு முறை மட்டுமே செயல்படும். யார் ஏற்றார் என உறுதிப்படுத்த உங்களுக்கு %2$@ மணி நேரம் உண்டு. உறுதிமொழி %3$@ நாட்கள் நீடிக்கும்; புதுப்பிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లింక్‌లు %1$@ గంటల పాటు ఒక్కసారి మాత్రమే పని చేస్తాయి. ఎవరు అంగీకరించారో నిర్ధారించడానికి మీకు %2$@ గంటలు ఉంటాయి. హామీ %3$@ రోజులు ఉంటుంది, పునరుద్ధరించలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ใช้ได้ครั้งเดียว ภายใน %1$@ ชั่วโมง คุณมี %2$@ ชั่วโมงเพื่อยืนยันว่าใครเป็นคนยอมรับ การรับรองมีผล %3$@ วันและต่ออายุไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılar bir kez, %1$@ saat boyunca çalışır. Kimin kabul ettiğini onaylamak için %2$@ saatiniz var. Bir kefillik %3$@ gün sürer ve yenilenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання працюють один раз, %1$@ годин. У вас є %2$@ годин, щоб підтвердити, хто його прийняв. Поручительство діє %3$@ днів і не поновлюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک ایک بار چلتے ہیں، %1$@ گھنٹے کے لیے۔ آپ کے پاس قبول کرنے والے کی تصدیق کے لیے %2$@ گھنٹے ہیں۔ ضمانت %3$@ دن چلتی ہے اور اس کی تجدید نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết dùng được một lần, trong %1$@ giờ. Bạn có %2$@ giờ để xác nhận ai đã chấp nhận. Một lời bảo chứng kéo dài %3$@ ngày và không thể gia hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接只能使用一次，有效期 %1$@ 小时。你有 %2$@ 小时来确认是谁接受了。担保持续 %3$@ 天，且不可续期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結只能使用一次，有效期 %1$@ 小時。你有 %2$@ 小時確認是誰接受了。擔保持續 %3$@ 天，且無法續期。"
          }
        }
      }
    },
