        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러스 기호와 국가 번호로 시작하는 국제 형식을 사용하세요. 예: +966501234567."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അന്താരാഷ്ട്ര ഫോർമാറ്റ് ഉപയോഗിക്കുക: പ്ലസ് ചിഹ്നവും രാജ്യ കോഡും ഉപയോഗിച്ച് തുടങ്ങണം — ഉദാഹരണത്തിന് +966501234567."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan format antarabangsa, bermula dengan tanda tambah dan kod negara — contohnya +966501234567."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk internasjonalt format, med pluss og landskode først, for eksempel +966501234567."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het internationale formaat, beginnend met een plusteken en een landcode, bijvoorbeeld +966501234567."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj formatu międzynarodowego, zaczynając od plusa i numeru kierunkowego kraju — na przykład +966501234567."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o formato internacional, começando com o sinal de mais e o código do país, por exemplo +966501234567."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o formato internacional, começando por um sinal de mais e o indicativo do país — por exemplo +351912345678."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește formatul internațional, începând cu plus și prefixul țării — de exemplu +966501234567."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте международный формат: плюс и код страны — например, +966501234567."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použi medzinárodný formát, ktorý začína znamienkom plus a predvoľbou krajiny — napríklad +966501234567."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd internationellt format, med plustecken och landskod först – till exempel +966501234567."
          }
        },
        "ta": {
