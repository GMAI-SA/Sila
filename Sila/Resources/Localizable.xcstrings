    "rooms.share.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف لا تُسجَّل أبدًا، فالمنشور هو الطريقة الوحيدة لتذكُّر هذه الغرفة. سيرى كل من يقرأ لك الغرفة ومن يستضيفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম কখনও রেকর্ড করা হয় না, তাই একটি পোস্টই এটি মনে রাখার একমাত্র উপায়। যে কেউ আপনার লেখা পড়তে পারে সে রুমটি এবং কে হোস্ট করছে তা দেখবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sales no s'enregistren mai, així que una publicació és l'única manera de recordar-la. Qui et pugui llegir veurà la sala i qui l'organitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnosti se nikdy nenahrávají, takže příspěvek je jediný způsob, jak se tato zapamatuje. Kdokoli, kdo čte tebe, uvidí místnost i to, kdo ji vede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum bliver aldrig optaget, så et opslag er den eneste måde, dette bliver husket på. Alle, der kan læse dig, vil se rummet og hvem der er vært."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume werden nie aufgezeichnet, daher ist ein Beitrag die einzige Möglichkeit, dass dieser in Erinnerung bleibt. Alle, die dich lesen können, sehen den Raum und wer ihn hostet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αίθουσες δεν ηχογραφούνται ποτέ, οπότε μια ανάρτηση είναι ο μόνος τρόπος να μείνει στη μνήμη αυτή. Όποιος μπορεί να σε διαβάσει θα δει την αίθουσα και ποιος τη διοργανώνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms are never recorded, so a post is the only way this one is remembered. Anyone who can read you will see the room and who is hosting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas nunca se graban, así que una publicación es la única forma de recordar esta. Cualquiera que pueda leerte verá la sala y quién la organiza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huoneita ei koskaan tallenneta, joten julkaisu on ainoa tapa, jolla tämä muistetaan. Kuka tahansa, joka voi lukea sinua, näkee huoneen ja sen isännän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les salons ne sont jamais enregistrés, un post est donc le seul moyen d’en garder le souvenir. Toute personne qui peut vous lire verra le salon et qui l’anime."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרים לעולם לא מוקלטים, ולכן פוסט הוא הדרך היחידה שבה החדר הזה ייזכר. כל מי שיכול לקרוא אותך יראה את החדר ואת מי שמארח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम कभी रिकॉर्ड नहीं होते, इसलिए पोस्ट ही एकमात्र तरीका है जिससे यह याद रखा जाएगा। जो भी आपको पढ़ सकता है वह रूम और उसका होस्ट देखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe se nikada ne snimaju pa je objava jedini način da se ova zapamti. Svatko tko može čitati tebe vidjet će sobu i tko je vodi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szobákat soha nem rögzítjük, ezért egy bejegyzés az egyetlen módja, hogy ez megmaradjon. Mindenki, aki olvashat téged, látni fogja a szobát és a házigazdáját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room tidak pernah direkam, jadi postingan adalah satu-satunya cara room ini dikenang. Siapa pun yang bisa membacamu akan melihat room dan siapa hostnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stanze non vengono mai registrate, quindi un post è l'unico modo in cui questa viene ricordata. Chiunque può leggerti vedrà la stanza e chi la ospita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームは録音されないため、このルームが記憶に残る方法は投稿だけです。あなたを読める人には、ルームとホストが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸은 녹음되지 않으므로 게시물이 이 룸을 기억하는 유일한 방법이에요. 내 글을 읽을 수 있는 사람은 누구나 룸과 호스트를 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമുകൾ ഒരിക്കലും റെക്കോർഡ് ചെയ്യില്ല, അതിനാൽ ഇത് ഓർമ്മിക്കപ്പെടാനുള്ള ഏക വഴി ഒരു പോസ്റ്റാണ്. നിങ്ങളെ വായിക്കാൻ കഴിയുന്ന എല്ലാവരും റൂമും അത് ഹോസ്റ്റ് ചെയ്യുന്നയാളെയും കാണും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik tidak pernah dirakam, jadi siaran ialah satu-satunya cara bilik ini diingati. Sesiapa yang boleh membaca anda akan melihat bilik itu dan siapa yang menghosnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rom tas aldri opp, så et innlegg er den eneste måten dette huskes på. Alle som kan lese deg, ser rommet og hvem som er vert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms worden nooit opgenomen, dus een bericht is de enige manier waarop deze wordt onthouden. Iedereen die jou kan lezen ziet de room en wie hem host."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje nigdy nie są nagrywane, więc wpis to jedyny sposób, by ten pokój został zapamiętany. Każdy, kto może Cię czytać, zobaczy pokój i jego gospodarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas, então um post é a única forma de esta ser lembrada. Quem puder ler você verá a sala e quem a apresenta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas, por isso uma publicação é a única forma de esta ser recordada. Quem o puder ler verá a sala e quem a organiza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerele nu sunt înregistrate niciodată, deci o postare este singura cale prin care aceasta este ținută minte. Oricine te poate citi va vedea camera și cine o găzduiește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комнаты никогда не записываются, поэтому пост — единственный способ сохранить память об этой. Все, кто может читать вас, увидят комнату и её ведущего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosti sa nikdy nenahrávajú, takže príspevok je jediný spôsob, ako si túto zapamätať. Každý, kto ťa môže čítať, uvidí miestnosť a jej hostiteľa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum spelas aldrig in, så ett inlägg är det enda sättet det här minns. Alla som kan läsa dig ser rummet och vem som är värd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைகள் ஒருபோதும் பதிவு செய்யப்படுவதில்லை, எனவே இடுகை மட்டுமே இது நினைவில் இருக்கும் வழி. உங்களைப் படிக்கக்கூடிய எவரும் அறையையும் அதை நடத்துபவரையும் பார்ப்பார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లు ఎప్పుడూ రికార్డ్ చేయబడవు, కాబట్టి ఇది గుర్తుండిపోయేందుకు పోస్ట్ ఒక్కటే మార్గం. మిమ్మల్ని చదవగల ఎవరైనా ఆ రూమ్‌ను, హోస్ట్ చేస్తున్నది ఎవరో చూస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องไม่เคยถูกบันทึกเสียง โพสต์จึงเป็นวิธีเดียวที่ห้องนี้จะถูกจดจำ ทุกคนที่อ่านคุณได้จะเห็นห้องและเจ้าของห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odalar asla kaydedilmez, bu yüzden bir gönderi bunun hatırlanmasının tek yoludur. Sizi okuyabilen herkes odayı ve sunucusunu görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнати ніколи не записуються, тому допис — єдиний спосіб, яким її запам’ятають. Кожен, хто може вас читати, побачить кімнату та її ведучого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رومز کبھی ریکارڈ نہیں ہوتے، اس لیے پوسٹ ہی اس روم کو یاد رکھنے کا واحد طریقہ ہے۔ جو بھی آپ کو پڑھ سکتا ہے وہ روم اور اس کا میزبان دیکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng không bao giờ được ghi âm, nên một bài đăng là cách duy nhất để phòng này được nhớ. Ai đọc được bạn sẽ thấy phòng và người chủ trì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间从不录音，所以帖子是它被记住的唯一方式。能阅读你内容的人都会看到这个房间以及主持人是谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室絕不會被錄音，所以貼文是留下這場聊天室記憶的唯一方式。能讀到你貼文的人都會看到這個聊天室以及主持人。"
          }
        }
      }
    },
    "rooms.share.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب شيئًا عنها…"
