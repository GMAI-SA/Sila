    "messages.empty.requests.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر هنا أول رسالة ممن لا تتابعهم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ফলো করেন না এমন কারও প্রথম মেসেজ এখানে অপেক্ষা করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí t'espera el primer missatge d'algú que no segueixes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První zpráva od někoho, koho nesleduješ, čeká tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En første besked fra en, du ikke følger, venter her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erste Nachricht von jemandem, dem du nicht folgst, wartet hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πρώτο μήνυμα από κάποιον που δεν ακολουθείς περιμένει εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A first message from someone you do not follow waits here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un primer mensaje de alguien a quien no sigues espera aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäinen viesti jonkulta, jota et seuraa, odottaa täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier message d’une personne que vous ne suivez pas attend ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעה ראשונה ממי שאתה לא עוקב אחריו ממתינה כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे आप फ़ॉलो नहीं करते उसका पहला संदेश यहाँ इंतज़ार करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prva poruka od nekoga koga ne pratiš čeka ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy általad nem követett személy első üzenete itt vár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan pertama dari orang yang tidak kamu ikuti menunggu di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo messaggio di qualcuno che non segui aspetta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローしていない人からの最初のメッセージは、ここで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로우하지 않는 사람의 첫 메시지가 여기서 기다려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഫോളോ ചെയ്യാത്ത ഒരാളുടെ ആദ്യ സന്ദേശം ഇവിടെ കാത്തിരിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesej pertama daripada seseorang yang tidak anda ikuti menunggu di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En første melding fra noen du ikke følger, venter her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eerste bericht van iemand die je niet volgt wacht hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza wiadomość od osoby, której nie obserwujesz, czeka tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira mensagem de alguém que você não segue fica esperando aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma primeira mensagem de alguém que não segue fica aqui à espera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prim mesaj de la cineva pe care nu îl urmărești așteaptă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое сообщение от человека, на которого вы не подписаны, ждёт здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu čaká prvá správa od niekoho, koho nesleduješ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett första meddelande från någon du inte följer väntar här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பின்தொடராத ஒருவரின் முதல் செய்தி இங்கே காத்திருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫాలో అవ్వని వారి నుండి వచ్చిన మొదటి సందేశం ఇక్కడ వేచి ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความแรกจากคนที่คุณไม่ได้ติดตามจะรออยู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip etmediğiniz birinden gelen ilk mesaj burada bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перше повідомлення від людини, на яку ви не підписані, чекає тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جسے آپ فالو نہیں کرتے اس کا پہلا پیغام یہاں انتظار کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn đầu tiên từ người bạn không theo dõi sẽ chờ ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你未关注的人的第一条消息会在这里等候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你未追蹤的人傳來的第一則訊息會等在這裡。"
          }
        }
      }
    },
