        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్ పోస్ట్‌లో చిత్రాలు, GIF లేదా పోల్ ఉండకూడదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์เสียงแนบรูปภาพ GIF หรือโพลไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli gönderide resim, GIF veya anket olamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовий допис не може містити зображень, GIF чи опитування"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائس پوسٹ کے ساتھ تصاویر، GIF یا پول نہیں ہو سکتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng giọng nói không thể kèm ảnh, GIF hay bình chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音帖子不能附带图片、GIF 或投票"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音貼文不能附帶圖片、GIF 或投票"
