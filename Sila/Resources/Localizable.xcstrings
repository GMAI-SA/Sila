        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்கள் யார் எனக் கேட்டு, அவர்களுக்கு அனுப்ப ஓர் இணைப்பைத் தரும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారెవరో అడిగి, వారికి పంపడానికి లింక్ ఇస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามว่าเขาเป็นใคร แล้วให้ลิงก์เพื่อส่งให้เขา"
