    "account.recovery.cancelDeletion.hint": {
      "comment": "VoiceOver hint for cancelling the deletion.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد حسابك ومنشوراتك وإعداداتك فورًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট, পোস্ট ও সেটিংস সাথে সাথে ফিরিয়ে আনে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura immediatament el teu compte, les publicacions i els ajustos"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžitě obnoví tvůj účet, příspěvky i nastavení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendanner straks din konto, dine opslag og dine indstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt dein Konto, deine Beiträge und Einstellungen sofort wieder her"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει αμέσως τον λογαριασμό, τις αναρτήσεις και τις ρυθμίσεις σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores your account, your posts and your settings immediately"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura al instante tu cuenta, tus publicaciones y tus ajustes"
