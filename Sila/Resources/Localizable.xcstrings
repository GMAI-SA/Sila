    "safety.report.nextSteps.header": {
      "comment": "Header above the optional follow-up actions on the receipt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كنت تفضّل ألا تراه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাদের না দেখতে চাইলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prefereixes no veure'l"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je raději nechceš vidět"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du helst ikke vil se dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du sie lieber nicht sehen möchtest"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν προτιμάς να μην τους βλέπεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you would rather not see them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prefieres no verlos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos et halua nähdä heitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous préférez ne plus les voir"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם אתה מעדיף לא לראות אותם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप उन्हें नहीं देखना चाहते"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ih radije ne želiš vidjeti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha inkább nem látnád őket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu tidak ingin melihat mereka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se preferisci non vederlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見たくない場合は"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 보고 싶지 않다면"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരെ കാണേണ്ടെന്നുണ്ടെങ്കിൽ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda lebih suka tidak melihat mereka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du heller ikke vil se dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je ze liever niet ziet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wolisz ich nie widzieć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você prefere não ver a pessoa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se preferir não os ver"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă preferi să nu-i mai vezi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы не хотите их видеть"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ich radšej nechceš vidieť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du helst inte vill se dem"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களைப் பார்க்க விரும்பவில்லை என்றால்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వారిని చూడకూడదనుకుంటే"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณไม่อยากเห็นพวกเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onları görmek istemiyorsanız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви не хочете їх бачити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ انہیں نہیں دیکھنا چاہتے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn không muốn thấy họ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你不想再看到对方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你不想再看到對方"
          }
        }
      }
    },
    "safety.report.notReady.a11y": {
      "comment": "VoiceOver reading of the reason the submit button is disabled. %@ is that reason.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير جاهز بعد. %@"
