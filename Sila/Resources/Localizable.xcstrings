    "communities.create.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة باسم ينضم إليها الناس عن قصد. أنت تقرّر من يدخل ومن ينشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম দেওয়া একটি জায়গা, যেখানে মানুষ ইচ্ছা করে যোগ দেয়। কে ঢুকবে আর কে পোস্ট করবে তা আপনি ঠিক করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espai amb nom al qual la gent s'uneix a propòsit. Tu decideixes qui hi entra i qui pot publicar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostor s názvem, ke kterému se lidé připojují záměrně. Ty rozhoduješ, kdo vstoupí a kdo smí psát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rum med et navn, som folk melder sig ind i med vilje. Du bestemmer, hvem der kommer ind, og hvem der må slå op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ort mit eigenem Namen, dem man bewusst beitritt. Du entscheidest, wer hineinkommt und wer posten darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας χώρος με όνομα, στον οποίο οι άνθρωποι μπαίνουν επίτηδες. Εσύ αποφασίζεις ποιος μπαίνει και ποιος μπορεί να δημοσιεύει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A space with a name that people join on purpose. You decide who gets in and who may post."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio con nombre al que la gente se une a propósito. Tú decides quién entra y quién puede publicar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimetty tila, johon ihmiset liittyvät tarkoituksella. Sinä päätät, ketkä pääsevät sisään ja ketkä saavat julkaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace avec un nom, que l’on rejoint volontairement. Vous décidez qui entre et qui peut publier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרחב עם שם שאנשים מצטרפים אליו במכוון. אתה מחליט מי נכנס ומי רשאי לפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नाम वाली जगह जिससे लोग जानबूझकर जुड़ते हैं। कौन अंदर आए और कौन पोस्ट करे, यह आप तय करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostor s imenom kojem se ljudi pridružuju namjerno. Ti odlučuješ tko ulazi i tko smije objavljivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Névvel rendelkező tér, amelyhez az emberek szándékosan csatlakoznak. Te döntöd el, ki léphet be, és ki írhat bejegyzést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang bernama yang dimasuki orang dengan sengaja. Kamu yang menentukan siapa yang masuk dan siapa yang boleh memposting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazio con un nome a cui le persone si uniscono di proposito. Decidi tu chi entra e chi può pubblicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前があり、人々が自分の意思で参加するスペースです。参加できる人と投稿できる人は、あなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 있고 사람들이 직접 선택해 가입하는 공간이에요. 누가 들어오고 누가 게시할 수 있는지 직접 정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പേരുള്ള, ആളുകൾ ഇഷ്ടപ്രകാരം ചേരുന്ന ഒരിടം. ആർക്ക് പ്രവേശിക്കാമെന്നും ആർക്ക് പോസ്റ്റ് ചെയ്യാമെന്നും നിങ്ങൾ തീരുമാനിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang bernama yang disertai orang dengan sengaja. Anda menentukan siapa yang masuk dan siapa yang boleh menyiar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rom med et navn som folk melder seg inn i med vilje. Du bestemmer hvem som slipper inn og hvem som kan publisere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een plek met een naam waar mensen bewust lid van worden. Jij bepaalt wie erin mag en wie mag posten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce z nazwą, do którego ludzie dołączają świadomie. Ty decydujesz, kto wchodzi i kto może pisać wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço com nome em que as pessoas entram de propósito. Você decide quem entra e quem pode postar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço com nome em que as pessoas entram de propósito. Você decide quem entra e quem pode publicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un spațiu cu nume la care oamenii se alătură intenționat. Tu decizi cine intră și cine poate posta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пространство с названием, куда люди вступают осознанно. Вы решаете, кто войдёт и кто может публиковать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priestor s názvom, do ktorého sa ľudia pripájajú úmyselne. Ty rozhoduješ, kto sa dostane dnu a kto môže písať príspevky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett rum med ett namn som folk går med i med avsikt. Du bestämmer vem som kommer in och vem som får publicera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மக்கள் விரும்பிச் சேரும் பெயர் கொண்ட ஓர் இடம். யார் உள்ளே வரலாம், யார் இடலாம் என்பதை நீங்கள் முடிவு செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రజలు ఇష్టపూర్వకంగా చేరే, పేరు గల ఒక చోటు. ఎవరు లోపలికి రావాలో, ఎవరు పోస్ట్ చేయాలో మీరే నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ที่มีชื่อ ซึ่งคนเข้าร่วมด้วยความตั้งใจ คุณเป็นผู้กำหนดว่าใครเข้าได้และใครโพสต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanların bilerek katıldığı, adı olan bir alan. Kimin gireceğine ve kimin gönderi paylaşabileceğine siz karar verirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Простір із назвою, до якого люди приєднуються свідомо. Ви вирішуєте, кого впустити і хто може публікувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نام والی جگہ جس میں لوگ اپنی مرضی سے شامل ہوتے ہیں۔ آپ طے کرتے ہیں کہ کون داخل ہو اور کون پوسٹ کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một không gian có tên mà mọi người chủ động tham gia. Bạn quyết định ai được vào và ai được đăng bài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个有名字的空间，人们有意加入。由你决定谁能进入、谁可以发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個有名稱的空間，大家是自願加入的。由你決定誰能進入、誰能發文。"
          }
        }
      }
    },
