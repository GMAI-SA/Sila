        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledana — odluka ostaje na snazi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átvizsgálva – a döntés marad"
          }
        },
        "id": {
