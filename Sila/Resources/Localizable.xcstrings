        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 48 hours to confirm have passed — send a new link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaron las 48 horas para confirmar: envía un enlace nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "48 tuntia vahvistamiseen on kulunut – lähetä uusi linkki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 48 heures pour confirmer sont écoulées — envoyez un nouveau lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "48 השעות לאישור עברו — שלח קישור חדש."
