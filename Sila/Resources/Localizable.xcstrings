          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukernavn er på %1$@–%2$@ tegn med bokstaver, tall og understreker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles bestaan uit %1$@–%2$@ tekens: letters, cijfers en underscores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchwyt ma %1$@–%2$@ znaków: liter, cyfr i podkreślników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O @usuário deve ter de %1$@ a %2$@ caracteres, entre letras, números e sublinhados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os identificadores têm entre %1$@ e %2$@ carateres, entre letras, números e sublinhados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle-urile au între %1$@ și %2$@ caractere: litere, cifre și liniuțe de subliniere."
