    "notifications.kind.roomInvite.detail": {
      "comment": "Settings row detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يدعوك أحد إلى غرفة مغلقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনাকে কোনো বন্ধ রুমে ডাকলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan algú et convida a una sala tancada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tě někdo zve do uzavřené místnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når nogen inviterer dig ind i et lukket rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dich jemand in einen geschlossenen Raum einlädt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποιος σε προσκαλεί σε κλειστή αίθουσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When somebody asks you into a closed room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien te invita a una sala cerrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun joku kutsuu sinut suljettuun huoneeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un vous invite dans un salon fermé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמישהו מזמין אותך לחדר סגור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपको बंद रूम में बुलाए।"
          }
        },
