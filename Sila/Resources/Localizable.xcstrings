          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva garantien din lar deg gjøre, og hvordan du verifiserer deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je garantie je laat doen, en hoe je verifieert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co daje Ci poręczenie i jak się zweryfikować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que seu aval permite fazer e como se verificar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o seu aval lhe permite fazer e como se verificar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce îți permite garanția ta și cum să te verifici"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вам позволяет поручительство и как пройти проверку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo ti ručenie umožňuje a ako sa overiť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad ditt intygande låter dig göra, och hur du verifierar dig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உறுதிமொழி எதை அனுமதிக்கிறது, எப்படிச் சரிபார்ப்பது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హామీ మీకు ఏమి చేయనిస్తుంది, ఎలా ధృవీకరించుకోవాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่การรับรองของคุณทำได้ และวิธียืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefilliğinizin neler yapmanıza izin verdiği ve nasıl doğrulanacağı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що дозволяє ваше поручительство і як пройти верифікацію"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ضمانت آپ کو کیا کرنے دیتی ہے، اور تصدیق کیسے کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bảo chứng cho phép bạn làm gì, và cách xác minh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的担保让你可以做什么，以及如何验证"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的擔保讓你能做什麼，以及如何驗證"
          }
        }
      }
    },
