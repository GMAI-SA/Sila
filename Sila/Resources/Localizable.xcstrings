    "composer.scope.region.noCountryReason": {
      "comment": "Why regions are unavailable before verification.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلاسل الإقليمية تحتاج إلى دولة موثّقة. وتظهر دولتك بعد توثيق هويتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আঞ্চলিক থ্রেডের জন্য ভেরিফায়েড দেশ লাগে। আইডি ভেরিফাই হলে আপনারটি দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fils regionals necessiten un país verificat. El teu apareixerà quan el teu document estigui verificat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionální vlákna vyžadují ověřenou zemi. Tvoje se objeví po ověření dokladu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale tråde kræver et verificeret land. Dit vises, når dit id er verificeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale Threads brauchen ein verifiziertes Land. Deines erscheint, sobald dein Ausweis verifiziert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα περιφερειακά νήματα απαιτούν επαληθευμένη χώρα. Η δική σου εμφανίζεται μόλις επαληθευτεί η ταυτότητά σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional threads need a verified country. Yours appears once your ID is verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hilos regionales necesitan un país verificado. El tuyo aparecerá cuando tu documento esté verificado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluekohtaiset ketjut vaativat vahvistetun maan. Omasi näkyy, kun henkilöllisyystodistuksesi on vahvistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions régionales nécessitent un pays vérifié. Le vôtre apparaîtra une fois votre pièce d’identité vérifiée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרשורים אזוריים דורשים מדינה מאומתת. שלך תופיע אחרי שתעודת הזהות שלך תאומת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्रीय थ्रेड के लिए सत्यापित देश ज़रूरी है। आपकी ID सत्यापित होने पर आपका देश दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionalne niti zahtijevaju potvrđenu zemlju. Tvoja će se pojaviti kad ti se isprava potvrdi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A regionális szálakhoz hitelesített ország kell. Az öné az azonosítód hitelesítése után jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas regional membutuhkan negara terverifikasi. Negaramu muncul setelah identitasmu terverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le discussioni regionali richiedono un paese verificato. Il tuo comparirà quando il tuo documento sarà verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域スレッドには認証済みの国が必要です。IDが認証されると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 스레드에는 인증된 국가가 필요해요. 신분증이 인증되면 내 국가가 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മേഖലാ ത്രെഡുകൾക്ക് പരിശോധിച്ച രാജ്യം വേണം. ഐഡി പരിശോധിച്ചാൽ നിങ്ങളുടേത് ദൃശ്യമാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Utas serantau memerlukan negara yang disahkan. Negara anda muncul setelah ID anda disahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale tråder krever et verifisert land. Ditt vises når ID-en din er verifisert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionale threads hebben een geverifieerd land nodig. Het jouwe verschijnt zodra je identiteitsbewijs is geverifieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątki regionalne wymagają zweryfikowanego kraju. Pojawi się on po weryfikacji Twojego dokumentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fios regionais exigem um país verificado. O seu aparecerá depois que seu documento for verificado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas regionais exigem um país verificado. O seu aparece depois de o seu documento ser verificado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversațiile regionale cer o țară verificată. A ta apare după verificarea actului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для региональных обсуждений нужна проверенная страна. Ваша появится после проверки документа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionálne vlákna vyžadujú overenú krajinu. Tá sa u teba objaví po overení dokladu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regionala trådar kräver ett verifierat land. Ditt visas när ditt id är verifierat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிராந்திய உரையாடல்களுக்குச் சரிபார்க்கப்பட்ட நாடு தேவை. உங்கள் அடையாளம் சரிபார்க்கப்பட்டதும் உங்கள் நாடு தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంతీయ థ్రెడ్‌లకు ధృవీకరించబడిన దేశం అవసరం. మీ ID ధృవీకరించబడిన తర్వాత మీది కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เธรดระดับภูมิภาคต้องมีประเทศที่ยืนยันแล้ว ของคุณจะปรากฏเมื่อบัตรของคุณได้รับการยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgesel konuşmalar için doğrulanmış bir ülke gerekir. Sizinki, kimliğiniz doğrulanınca görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для регіональних обговорень потрібна верифікована країна. Ваша з’явиться після верифікації документа."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "علاقائی تھریڈز کے لیے تصدیق شدہ ملک ضروری ہے۔ آپ کا شناختی کارڈ تصدیق ہونے پر آپ کا ملک ظاہر ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi theo khu vực cần một quốc gia đã xác minh. Quốc gia của bạn sẽ hiện khi giấy tờ được xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区对话串需要已验证的国家。证件通过验证后，你的国家就会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地區串文需要已驗證的國家。證件通過驗證後，你的國家就會出現。"
          }
        }
      }
    },
    "composer.scope.region.outsideReason": {
      "comment": "Why a region is unavailable to somebody verified outside it. %1$@ is their country; %2$@ and %3$@ are the region's short label.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ليست ضمن %2$@، وسلسلة %3$@ لا يمكن الرد عليها إلا من داخل المنطقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-এর মধ্যে নয়, আর %3$@ থ্রেডে শুধু অঞ্চলের ভেতর থেকে উত্তর দেওয়া যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no és a %2$@, i a un fil de %3$@ només s'hi pot respondre des de dins de la regió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Země %1$@ není v oblasti %2$@ a na vlákno %3$@ lze odpovídat jen z oblasti samotné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ligger ikke i %2$@, og en %3$@-tråd kan kun besvares inde fra regionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gehört nicht zu %2$@, und auf einen Thread für %3$@ kann nur aus der Region geantwortet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χώρα %1$@ δεν ανήκει στην περιοχή %2$@ και σε ένα νήμα %3$@ μπορούν να απαντήσουν μόνο από μέσα από την περιοχή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't in %2$@, and a %3$@ thread can only be replied to from inside the region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no está en %2$@, y a un hilo de %3$@ solo se puede responder desde dentro de la región."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ei ole alueella %2$@, ja ketjuun %3$@ voi vastata vain alueen sisältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’est pas dans la zone %2$@, et on ne peut répondre à une discussion %3$@ que depuis l’intérieur de la région."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ אינה ב-%2$@, ואפשר להגיב לשרשור של %3$@ רק מתוך האזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ में नहीं है, और %3$@ थ्रेड पर जवाब केवल इसी क्षेत्र के अंदर से दिया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nije u regiji %2$@, a na nit regije %3$@ može se odgovarati samo iz same regije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nem tartozik ide: %2$@, a(z) %3$@ szálra pedig csak a régión belülről lehet válaszolni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak termasuk di %2$@, dan utas %3$@ hanya bisa dibalas dari dalam kawasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è in %2$@, e a una discussione %3$@ si può rispondere solo dall'interno della regione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@に含まれません。%3$@のスレッドには、その地域内からのみ返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에 속하지 않으며, %3$@ 스레드에는 해당 지역 안에서만 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ൽ ഉൾപ്പെടുന്നില്ല, %3$@ ത്രെഡിന് മേഖലയ്ക്കുള്ളിൽ നിന്ന് മാത്രമേ മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiada dalam %2$@, dan utas %3$@ hanya boleh dibalas dari dalam rantau itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er ikke i %2$@, og en %3$@-tråd kan bare besvares fra innenfor regionen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ligt niet in %2$@, en op een %3$@-thread kan alleen vanuit de regio worden gereageerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj %1$@ nie należy do: %2$@, a na wątek „%3$@” można odpowiadać tylko z terenu tego regionu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não está em %2$@, e um fio de %3$@ só pode ser respondido de dentro da região."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não está em %2$@, e só se pode responder a uma conversa de %3$@ a partir da região."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu face parte din %2$@, iar la o conversație %3$@ se poate răspunde doar din interiorul regiunii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страна %1$@ не входит в регион %2$@, а отвечать на обсуждение «%3$@» можно только изнутри региона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nepatrí do regiónu %2$@ a na vlákno %3$@ možno odpovedať iba z vnútra regiónu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ligger inte i %2$@, och en %3$@-tråd kan bara besvaras inifrån regionen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ என்பது %2$@ இல் இல்லை; %3$@ உரையாடலுக்குப் பிராந்தியத்துக்குள் இருந்து மட்டுமே பதிலளிக்க முடியும்."
