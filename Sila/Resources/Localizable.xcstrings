    "auth.welcome.tagline": {
      "comment": "Welcome screen headline.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة الاجتماعية الوحيدة التي كل إنسان فيها حقيقي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একমাত্র সোশ্যাল নেটওয়ার্ক যেখানে প্রতিটি মানুষ আসল।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'única xarxa social on cada persona és real."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediná sociální síť, kde je každý člověk skutečný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det eneste sociale netværk, hvor ethvert menneske er ægte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das einzige soziale Netzwerk, in dem jeder Mensch echt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοναδικό κοινωνικό δίκτυο όπου κάθε άνθρωπος είναι αληθινός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only social network where every human is real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La única red social donde cada persona es real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainoa sosiaalinen verkosto, jossa jokainen ihminen on aito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le seul réseau social où chaque humain est réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשת החברתית היחידה שבה כל אדם הוא אמיתי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एकमात्र सोशल नेटवर्क जहाँ हर इंसान असली है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedina društvena mreža na kojoj je svaki čovjek stvaran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyetlen közösségi hálózat, ahol minden ember valódi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya jejaring sosial tempat setiap orang nyata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unico social network in cui ogni persona è reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての人が本物の、唯一のソーシャルネットワーク。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람이 실제 사람인 유일한 소셜 네트워크."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ മനുഷ്യനും യഥാർഥമായ ഏക സോഷ്യൽ നെറ്റ്‌വർക്ക്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya rangkaian sosial yang setiap insannya nyata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det eneste sosiale nettverket der alle er ekte mennesker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het enige sociale netwerk waar elk mens echt is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedyna sieć społecznościowa, w której każdy człowiek jest prawdziwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A única rede social em que toda pessoa é real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A única rede social onde todas as pessoas são reais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Singura rețea socială în care fiecare om este real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственная соцсеть, где все — настоящие люди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediná sociálna sieť, kde je každý človek skutočný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det enda sociala nätverket där varje människa är äkta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொருவரும் உண்மையான மனிதராக இருக்கும் ஒரே சமூக வலைப்பின்னல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి మనిషి నిజమైనవారైన ఏకైక సోషల్ నెట్‌వర్క్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซเชียลเน็ตเวิร์กเดียวที่ทุกคนคือคนจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her insanın gerçek olduğu tek sosyal ağ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Єдина соціальна мережа, де кожна людина — справжня."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "واحد سوشل نیٹ ورک جہاں ہر انسان حقیقی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng xã hội duy nhất nơi ai cũng là người thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一每个人都是真实的社交网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一每個人都是真人的社群網路。"
          }
        }
      }
