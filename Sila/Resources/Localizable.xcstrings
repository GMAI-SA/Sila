    "verification.expired.message": {
      "comment": "Body when the request lapsed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الطلب قبل الموافقة عليه في نفاذ. ابدأ من جديد للحصول على رقم جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath-এ অনুমোদনের আগেই অনুরোধের মেয়াদ শেষ হয়ে গেছে। নতুন নম্বর পেতে আবার শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sol·licitud ha caducat abans que s'aprovés a Nafath. Torna a començar per obtenir un número nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost žádosti vypršela dřív, než byla schválena v Nafath. Začni znovu a dostaneš nové číslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodningen udløb, før den blev godkendt i Nafath. Start forfra for at få et nyt nummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage ist abgelaufen, bevor sie in Nafath bestätigt wurde. Beginne neu, um eine neue Nummer zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αίτημα έληξε πριν εγκριθεί στο Nafath. Ξεκίνα ξανά για να πάρεις νέο αριθμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request expired before it was approved in Nafath. Start again to get a new number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud caducó antes de aprobarse en Nafath. Empieza de nuevo para obtener un número nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyntö vanheni, ennen kuin se hyväksyttiin Nafathissa. Aloita alusta saadaksesi uuden numeron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a expiré avant d’être approuvée dans Nafath. Recommencez pour obtenir un nouveau numéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה פגה לפני שאושרה ב-Nafath. התחל שוב כדי לקבל מספר חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath में मंज़ूर होने से पहले ही अनुरोध समाप्त हो गया। नया नंबर पाने के लिए फिर शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjev je istekao prije odobrenja u Nafathu. Počni ponovno da dobiješ novi broj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés lejárt, mielőtt jóváhagyták volna a Nafathban. Indítsd újra egy új számért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan kedaluwarsa sebelum disetujui di Nafath. Mulai lagi untuk mendapat nomor baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è scaduta prima di essere approvata in Nafath. Ricomincia per ottenere un nuovo numero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafathで承認される前にリクエストの有効期限が切れました。最初からやり直して、新しい番号を取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath에서 승인되기 전에 요청이 만료되었어요. 처음부터 다시 시작해 새 번호를 받으세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath-ൽ അംഗീകരിക്കുന്നതിന് മുമ്പ് അഭ്യർഥനയുടെ കാലാവധി കഴിഞ്ഞു. പുതിയ നമ്പർ ലഭിക്കാൻ വീണ്ടും തുടങ്ങുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan tamat tempoh sebelum diluluskan dalam Nafath. Mulakan semula untuk mendapat nombor baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forespørselen utløp før den ble godkjent i Nafath. Start på nytt for å få et nytt nummer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzoek is verlopen voordat het in Nafath werd goedgekeurd. Begin opnieuw voor een nieuw nummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba wygasła, zanim została zatwierdzona w Nafath. Zacznij od nowa, aby dostać nowy numer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido expirou antes de ser aprovado no Nafath. Comece de novo para receber um novo número."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido expirou antes de ser aprovado no Nafath. Recomece para obter um novo número."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cererea a expirat înainte să fie aprobată în Nafath. Începe din nou pentru a primi un număr nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок запроса истёк до подтверждения в Nafath. Начните заново, чтобы получить новый номер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadavka vypršala skôr, než bola schválená v Nafath. Začni znova, aby si dostal nové číslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begäran gick ut innan den godkändes i Nafath. Börja om för att få ett nytt nummer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath-இல் ஏற்கப்படுவதற்குள் கோரிக்கை காலாவதியானது. புதிய எண் பெற மீண்டும் தொடங்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafath లో ఆమోదించకముందే అభ్యర్థన గడువు ముగిసింది. కొత్త నంబర్ కోసం మళ్లీ ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอหมดอายุก่อนจะได้รับการอนุมัติใน Nafath เริ่มใหม่เพื่อรับหมายเลขใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek, Nafath'ta onaylanmadan süresi doldu. Yeni bir numara almak için yeniden başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит закінчився, перш ніж його підтвердили в Nafath. Почніть знову, щоб отримати новий номер."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست Nafath میں منظور ہونے سے پہلے ختم ہو گئی۔ نیا نمبر لینے کے لیے دوبارہ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã hết hạn trước khi được chấp thuận trong Nafath. Hãy bắt đầu lại để nhận một số mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求在 Nafath 中获批之前已过期。请重新开始以获取新的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求在 Nafath 核准前已過期。請重新開始以取得新的號碼。"
          }
        }
      }
    },
