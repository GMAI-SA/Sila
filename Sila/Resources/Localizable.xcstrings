    "account.phone.unverifiedCaption": {
      "comment": "States exactly what the stored number is and is not — there is no SMS confirmation, so it is not part of the verified identity.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات تواصل فقط. لم يتحقق معروف من أن هذا الرقم لك — لا يوجد تأكيد برسالة نصية، لذلك فهو ليس جزءًا من هويتك الموثّقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু যোগাযোগের তথ্য। নম্বরটি যে আপনার তা Known যাচাই করেনি — কোনো SMS নিশ্চিতকরণ নেই, তাই এটি আপনার ভেরিফায়েড পরিচয়ের অংশ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només és una dada de contacte. Known no ha comprovat que aquest número sigui teu: no hi ha confirmació per SMS, així que no forma part de la teva identitat verificada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze kontaktní údaj. Known neověřila, že je to tvé číslo – neprobíhá žádné potvrzení SMS, takže není součástí tvé ověřené identity."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en kontaktoplysning. Known har ikke tjekket, at nummeret er dit – der er ingen sms-bekræftelse, så det er ikke en del af din verificerede identitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Kontaktangabe. Known hat nicht geprüft, ob die Nummer dir gehört – es gibt keine SMS-Bestätigung, daher ist sie kein Teil deiner verifizierten Identität."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο στοιχείο επικοινωνίας. Το Known δεν έχει ελέγξει ότι αυτός ο αριθμός είναι δικός σου — δεν υπάρχει επιβεβαίωση με SMS, οπότε δεν αποτελεί μέρος της επαληθευμένης ταυτότητάς σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact detail only. Known has not checked that this number is yours — there is no SMS confirmation, so it is not part of your verified identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es un dato de contacto. Known no ha comprobado que este número sea tuyo: no hay confirmación por SMS, así que no forma parte de tu identidad verificada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain yhteystieto. Known ei ole tarkistanut, että numero on sinun – tekstiviestivahvistusta ei ole, joten se ei kuulu vahvistettuun henkilöllisyyteesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Information de contact uniquement. Known n’a pas vérifié que ce numéro est le vôtre — il n’y a pas de confirmation par SMS, il ne fait donc pas partie de votre identité vérifiée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרט קשר בלבד. Known לא בדקה שהמספר הזה שלך — אין אישור ב-SMS, ולכן הוא אינו חלק מהזהות המאומתת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल संपर्क जानकारी। Known ने जाँचा नहीं है कि यह नंबर आपका है — SMS से कोई पुष्टि नहीं होती, इसलिए यह आपकी सत्यापित पहचान का हिस्सा नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo kontakt podatak. Known nije provjerila da je ovaj broj tvoj — nema SMS potvrde, pa nije dio tvog potvrđenog identiteta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak kapcsolattartási adat. A Known nem ellenőrizte, hogy ez a szám a tiéd – nincs SMS-es megerősítés, ezért nem része a hitelesített személyazonosságodnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya detail kontak. Known belum memeriksa bahwa nomor ini milikmu — tidak ada konfirmasi SMS, jadi nomor ini bukan bagian dari identitas terverifikasimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dato di contatto. Known non ha verificato che questo numero sia tuo: non c'è conferma via SMS, quindi non fa parte della tua identità verificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先情報のみです。Knownはこの番号があなたのものか確認していません。SMSでの確認はなく、本人確認の一部にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처 정보일 뿐이에요. Known은 이 번호가 내 것인지 확인하지 않았어요. SMS 확인이 없으므로 인증된 신원에 포함되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോൺടാക്റ്റ് വിവരം മാത്രം. ഈ നമ്പർ നിങ്ങളുടേതാണെന്ന് Known പരിശോധിച്ചിട്ടില്ല — SMS സ്ഥിരീകരണം ഇല്ല, അതിനാൽ ഇത് നിങ്ങളുടെ പരിശോധിച്ച ഐഡന്റിറ്റിയുടെ ഭാഗമല്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran hubungan sahaja. Known tidak menyemak bahawa nombor ini milik anda — tiada pengesahan SMS, jadi ia bukan sebahagian daripada identiti anda yang disahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en kontaktopplysning. Known har ikke sjekket at nummeret er ditt. Det finnes ingen SMS-bekreftelse, så det er ikke en del av den verifiserte identiteten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een contactgegeven. Known heeft niet gecontroleerd of dit nummer van jou is. Er is geen sms-bevestiging, dus het maakt geen deel uit van je geverifieerde identiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dane kontaktowe. Known nie sprawdziła, czy ten numer należy do Ciebie — nie ma potwierdzenia SMS-em, więc nie jest częścią Twojej zweryfikowanej tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas dado de contato. O Known não confirmou que este número é seu: não há confirmação por SMS, então ele não faz parte da sua identidade verificada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas dado de contacto. A Known não confirmou que este número é seu — não há confirmação por SMS, por isso não faz parte da sua identidade verificada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar detaliu de contact. Known nu a verificat că numărul este al tău — nu există confirmare prin SMS, deci nu face parte din identitatea ta verificată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только контактные данные. Known не проверяла, что этот номер ваш — подтверждения по SMS нет, поэтому он не входит в вашу проверенную личность."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba kontaktný údaj. Known nekontrolovala, že toto číslo je tvoje — neprebieha potvrdenie cez SMS, takže nie je súčasťou tvojej overenej identity."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast kontaktuppgift. Known har inte kontrollerat att numret är ditt – det finns ingen SMS-bekräftelse, så det ingår inte i din verifierade identitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்பு விவரம் மட்டுமே. இந்த எண் உங்களுடையது என்பதை Known சரிபார்க்கவில்லை — SMS உறுதிப்படுத்தல் இல்லை, எனவே இது உங்கள் சரிபார்க்கப்பட்ட அடையாளத்தின் பகுதி அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంప్రదింపు వివరం మాత్రమే. ఈ నంబర్ మీదేనని Known తనిఖీ చేయలేదు — SMS నిర్ధారణ లేదు, కాబట్టి ఇది మీ ధృవీకరించబడిన గుర్తింపులో భాగం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นรายละเอียดติดต่อเท่านั้น Known ไม่ได้ตรวจสอบว่าหมายเลขนี้เป็นของคุณ เพราะไม่มีการยืนยันทาง SMS จึงไม่เป็นส่วนหนึ่งของตัวตนที่ยืนยันแล้วของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca iletişim bilgisi. Known bu numaranın size ait olduğunu kontrol etmedi; SMS onayı yoktur, bu yüzden doğrulanmış kimliğinizin parçası değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише контактні дані. Known не перевіряла, що цей номер ваш — підтвердження через SMS немає, тому він не є частиною вашої верифікованої особи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف رابطے کی تفصیل۔ Known نے جانچا نہیں کہ یہ نمبر آپ کا ہے — SMS تصدیق نہیں ہوتی، اس لیے یہ آپ کی تصدیق شدہ شناخت کا حصہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là thông tin liên hệ. Known chưa kiểm tra số này có phải của bạn không — không có xác nhận qua SMS, nên nó không thuộc danh tính đã xác minh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅作联系方式。Known 并未核实这个号码是否属于你，没有短信确认，因此它不属于你已验证的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為聯絡資訊。Known 並未確認此號碼是否屬於你，沒有簡訊確認，因此它不屬於你已驗證的身分。"
          }
        }
      }
    },
