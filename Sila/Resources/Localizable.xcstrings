    "account.password.row.detail": {
      "comment": "What changing the password does to sessions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييرها يسجّل الخروج من كل الأجهزة، بما فيها هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলালে এটিসহ প্রতিটি ডিভাইস সাইন আউট হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar-la tanca la sessió a tots els dispositius, també en aquest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna odhlásí všechna zařízení, včetně tohoto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skifter den, logges alle enheder ud, også denne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern werden alle Geräte abgemeldet, auch dieses."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή αποσυνδέει κάθε συσκευή, και αυτή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing it signs every device out, including this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiarla se cierra la sesión en todos los dispositivos, incluido este."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaminen kirjaa kaikki laitteet ulos, myös tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifier déconnecte tous les appareils, celui-ci compris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי הסיסמה מנתק את כל המכשירים, כולל זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बदलने पर हर डिवाइस साइन आउट हो जाता है, इस वाला भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena odjavljuje sve uređaje, uključujući ovaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítás minden eszközről kijelentkeztet, erről is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubahnya mengeluarkan semua perangkat, termasuk yang ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiarla disconnette tutti i dispositivi, compreso questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更すると、このデバイスを含むすべてのデバイスがサインアウトされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경하면 이 기기를 포함한 모든 기기에서 로그아웃돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറ്റിയാൽ ഇത് ഉൾപ്പെടെ എല്ലാ ഉപകരണങ്ങളും സൈൻ ഔട്ട് ആകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukarnya akan melog keluar semua peranti, termasuk yang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du endrer det, logges alle enheter ut, også denne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigen logt alle apparaten uit, ook dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana wylogowuje wszystkie urządzenia, również to."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao alterá-la, todos os dispositivos são desconectados, inclusive este."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterá-la termina a sessão em todos os dispositivos, incluindo este."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea ei deconectează toate dispozitivele, inclusiv pe acesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене вы выйдете на всех устройствах, включая это."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenou sa odhlásia všetky zariadenia, aj toto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ändrar det loggas alla enheter ut, även den här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்றினால் இது உட்பட எல்லாச் சாதனங்களும் வெளியேற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్చితే ప్రతి పరికరం సైన్ అవుట్ అవుతుంది, ఇది కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนจะออกจากระบบทุกอุปกรณ์ รวมถึงเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek, bu cihaz dahil tüm cihazlardaki oturumları kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна виводить із системи всі пристрої, зокрема й цей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے بدلنے سے ہر ڈیوائس سائن آؤٹ ہو جاتی ہے، یہ والی بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi mật khẩu sẽ đăng xuất mọi thiết bị, kể cả thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改后所有设备都会退出登录，包括这一台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更後所有裝置都會登出，包括這一支。"
          }
        }
      }
    },
