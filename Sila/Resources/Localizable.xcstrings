        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Lyt for at se, om det er åbent for dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Zuhören, um zu sehen, ob er für dich offen ist"
