    "notifications.quiet.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر الإشعارات حتى الصباح؛ لا يضيع شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুশ সকাল পর্যন্ত অপেক্ষা করে; কিছুই হারায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions push esperen fins al matí; no es perd res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Push zprávy počkají do rána; nic se neztratí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushnotifikationer venter til morgenen; intet går tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes warten bis zum Morgen; nichts geht verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις push περιμένουν μέχρι το πρωί· δεν χάνεται τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes wait until the morning; nothing is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones push esperan hasta la mañana; no se pierde nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-ilmoitukset odottavat aamuun; mitään ei katoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push attendent le matin ; rien n’est perdu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות דחיפה ממתינות עד הבוקר; שום דבר לא אובד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुश सुबह तक रुकते हैं; कुछ भी खोता नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push obavijesti čekaju do jutra; ništa se ne gubi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pushok reggelig várnak; semmi nem vész el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Push menunggu sampai pagi; tidak ada yang hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche push aspettano fino al mattino; non si perde nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ通知は朝まで待機します。失われるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸시는 아침까지 대기하며 사라지는 것은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുഷ് അറിയിപ്പുകൾ രാവിലെ വരെ കാത്തിരിക്കും; ഒന്നും നഷ്ടപ്പെടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan tolak menunggu sehingga pagi; tiada apa yang hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-varsler venter til morgenen. Ingenting går tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushmeldingen wachten tot de ochtend; er gaat niets verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia push czekają do rana; nic nie ginie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações push esperam até de manhã; nada se perde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações esperam pela manhã; nada se perde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările push așteaptă până dimineață; nu se pierde nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуши дождутся утра; ничего не потеряется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push upozornenia počkajú do rána; nič sa nestratí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushaviseringar väntar till morgonen; inget går förlorat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புஷ் அறிவிப்புகள் காலை வரை காத்திருக்கும்; எதுவும் இழக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పుష్‌లు ఉదయం వరకు వేచి ఉంటాయి; ఏదీ కోల్పోరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนแบบพุชจะรอจนถึงตอนเช้า ไม่มีอะไรหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık bildirimler sabaha kadar bekler; hiçbir şey kaybolmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-сповіщення чекають до ранку; нічого не втрачається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پش اطلاعات صبح تک رکی رہتی ہیں؛ کچھ ضائع نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đẩy chờ đến sáng; không có gì bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送会等到早上再发送，不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推播會等到早上才送出，不會遺漏。"
          }
        }
      }
    },
    "notifications.quiet.error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات الهدوء تحتاج بداية ونهاية مختلفتين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নীরব সময়ের শুরু ও শেষ আলাদা হতে হবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hores de silenci necessiten un inici i un final diferents"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiché hodiny potřebují různý začátek a konec"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille timer skal have forskellige start- og sluttidspunkter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezeiten brauchen einen Beginn und ein Ende, die sich unterscheiden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ώρες ησυχίας χρειάζονται διαφορετική έναρξη και λήξη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hours need a start and an end that differ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de silencio necesitan un inicio y un final distintos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljaisten tuntien alun ja lopun on oltava eri"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures calmes ont besoin d’un début et d’une fin différents"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשעות שקט נדרשות שעת התחלה ושעת סיום שונות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत घंटों के लिए शुरू और अंत अलग-अलग होने चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tihi sati trebaju različit početak i kraj"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csendes órákhoz különböző kezdés és befejezés kell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tenang butuh waktu mulai dan akhir yang berbeda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di silenzio richiedono un inizio e una fine diversi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみ時間は、開始と終了を異なる時刻にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 시간은 시작과 종료가 달라야 해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശാന്ത സമയത്തിന് വ്യത്യസ്തമായ തുടക്കവും അവസാനവും വേണം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu senyap memerlukan permulaan dan penamat yang berbeza"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille timer trenger ulikt start- og sluttidspunkt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille uren hebben een begin- en eindtijd nodig die verschillen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny ciszy wymagają różnego początku i końca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de silêncio precisa de um início e um fim diferentes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de silêncio precisam de um início e um fim diferentes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orele de liniște au nevoie de un început și un sfârșit diferite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для тихих часов нужны разные время начала и окончания"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiché hodiny potrebujú rôzny začiatok a koniec"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tysta timmar behöver en start och ett slut som skiljer sig åt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதி நேரங்களுக்கு வேறுபட்ட தொடக்கமும் முடிவும் தேவை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిశ్శబ్ద గంటలకు వేర్వేరు ప్రారంభ, ముగింపు సమయాలు కావాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาเงียบต้องมีเวลาเริ่มและสิ้นสุดที่ต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz saatlerin başlangıcı ve bitişi farklı olmalı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початок і кінець тихих годин мають відрізнятися"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش اوقات کے لیے آغاز اور اختتام مختلف ہونے چاہئیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ yên tĩnh cần giờ bắt đầu và giờ kết thúc khác nhau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免打扰时段的开始和结束时间必须不同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勿擾時段的開始與結束時間必須不同"
          }
        }
      }
    },
