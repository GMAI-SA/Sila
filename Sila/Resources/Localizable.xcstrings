    "rooms.link.join.hint": {
      "comment": "VoiceOver hint for Join on a linked room's card.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينضمك إلى الغرفة. سيراك المضيف ومن فيها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুমে যোগ দেয়। হোস্ট ও রুমের মানুষজন আপনাকে দেখতে পাবেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'uneix a la sala. L'amfitrió i les persones que hi són et veuran"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojí tě k místnosti. Hostitel a lidé v ní tě uvidí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltager i rummet. Værten og de, der er i det, kan se dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tritt dem Raum bei. Der Host und die Personen darin sehen dich"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπαίνεις στην αίθουσα. Ο οικοδεσπότης και τα άτομα μέσα θα σε βλέπουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins the room. The host and the people in it will see you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra en la sala. El anfitrión y las personas que están en ella te verán"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittyy huoneeseen. Isäntä ja siellä olevat ihmiset näkevät sinut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoint le salon. L’animateur et les personnes présentes vous verront"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצטרף לחדר. המארח והאנשים שבו יראו אותך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम में जुड़ता है। होस्ट और उसमें मौजूद लोग आपको देखेंगे"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridružuje te sobi. Domaćin i ljudi u njoj vidjet će te"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozik a szobához. A házigazda és a bent lévők látni fogják"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergabung ke room. Host dan orang-orang di dalamnya akan melihatmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra nella stanza. L'host e le persone presenti ti vedranno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームに参加します。ホストと中にいる人にあなたが見えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸에 참여해요. 호스트와 룸 안의 사람들에게 내가 보여요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമിൽ ചേരുന്നു. ഹോസ്റ്റും അതിലുള്ളവരും നിങ്ങളെ കാണും"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyertai bilik. Hos dan orang di dalamnya akan melihat anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir med i rommet. Verten og de som er der, ser deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt deel aan de room. De host en de mensen erin zien je"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącza do pokoju. Gospodarz i osoby w środku będą Cię widzieć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra na sala. O anfitrião e as pessoas nela verão você"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra na sala. O anfitrião e as pessoas nela vão vê-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intri în cameră. Gazda și oamenii din ea te vor vedea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в комнату. Ведущий и находящиеся в ней люди увидят вас"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojí ťa do miestnosti. Hostiteľ a ľudia v nej ťa uvidia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går med i rummet. Värden och de som är där ser dig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறையில் சேரும். நடத்துபவரும் அறையில் உள்ளவர்களும் உங்களைப் பார்ப்பார்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లో చేరుతుంది. హోస్ట్ మరియు అందులో ఉన్నవారికి మీరు కనిపిస్తారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าร่วมห้อง เจ้าของห้องและคนในห้องจะเห็นคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaya katılır. Sunucu ve içindekiler sizi görecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднує до кімнати. Ведучий і люди в ній вас побачать"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روم میں شامل ہوتا ہے۔ میزبان اور اس میں موجود لوگ آپ کو دیکھیں گے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia phòng. Chủ phòng và những người trong đó sẽ thấy bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入房间。主持人和房间里的人会看到你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入聊天室。主持人和其中的人都會看到你"
          }
        }
      }
    },
    "rooms.link.join.note": {
      "comment": "Under a linked room's card, signed in: why nothing has happened yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تنضم بعد. لن يراك المضيف إلا بعد أن تضغط «انضم»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যোগ দেননি। যোগ দিন-এ ট্যাপ করার পরই হোস্ট আপনাকে দেখতে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No t'hi has unit. L'amfitrió et veu només després que toquis Uneix-t'hi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřipojil ses. Hostitel tě uvidí, až klepneš na Připojit se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ikke med endnu. Værten ser dig først, når du trykker på Deltag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht beigetreten. Der Host sieht dich erst, nachdem du auf Beitreten getippt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχεις μπει. Ο οικοδεσπότης σε βλέπει μόνο αφού πατήσεις Συμμετοχή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't joined. The host sees you only after you tap Join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te has unido. El anfitrión solo te ve después de que toques Unirme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole liittynyt. Isäntä näkee sinut vasta, kun napautat Liity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas rejoint. L’animateur ne vous voit qu’après avoir touché Rejoindre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא הצטרפת. המארח רואה אותך רק אחרי שתקיש על הצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जुड़े नहीं हैं। \"जुड़ें\" टैप करने के बाद ही होस्ट आपको देखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisi se pridružio/la. Domaćin te vidi tek nakon što dodirneš Pridruži se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem csatlakoztál. A házigazda csak a Csatlakozás koppintása után lát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum bergabung. Host baru melihatmu setelah kamu mengetuk Gabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei ancora entrato. L'host ti vede solo dopo che tocchi Entra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ参加していません。「参加」をタップして初めて、ホストにあなたが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 참여하지 않았어요. 참여를 탭한 후에야 호스트에게 내가 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ചേർന്നിട്ടില്ല. ചേരുക ടാപ്പ് ചെയ്ത ശേഷം മാത്രമേ ഹോസ്റ്റ് നിങ്ങളെ കാണൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda belum menyertai. Hos melihat anda hanya selepas anda mengetik Sertai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke blitt med. Verten ser deg først etter at du trykker på Bli med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent niet toegetreden. De host ziet je pas nadat je op Deelnemen tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie dołączyłeś. Gospodarz zobaczy Cię dopiero po stuknięciu Dołącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não entrou. O anfitrião só vê você depois que você tocar em Entrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não entrou. O anfitrião só o vê depois de tocar em Entrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu te-ai alăturat. Gazda te vede doar după ce atingi Alătură-te."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не вошли. Ведущий увидит вас только после нажатия «Войти»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepripojil si sa. Hostiteľ ťa uvidí až po ťuknutí na Pripojiť sa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte gått med. Värden ser dig först när du trycker på Gå med."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இன்னும் சேரவில்லை. சேர் என்பதைத் தட்டிய பிறகே நடத்துபவர் உங்களைப் பார்ப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా చేరలేదు. మీరు చేరు నొక్కిన తర్వాతే హోస్ట్‌కు మీరు కనిపిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้เข้าร่วม เจ้าของห้องจะเห็นคุณหลังจากแตะเข้าร่วมเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmadınız. Sunucu sizi yalnızca Katıl'a dokunduktan sonra görür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не приєдналися. Ведучий побачить вас лише після того, як ви торкнетеся «Приєднатися»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ شامل نہیں ہوئے۔ میزبان آپ کو شامل ہوں پر ٹیپ کرنے کے بعد ہی دیکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa tham gia. Chủ phòng chỉ thấy bạn sau khi bạn chạm Tham gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有加入。轻点“加入”后，主持人才会看到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未加入。主持人在你點「加入」後才會看到你。"
          }
        }
      }
    },
