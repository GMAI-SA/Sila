            "state": "translated",
            "value": "హామీ ఇచ్చే ముందు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefil olmadan önce"
          }
        },
        "uk": {
