    "notifications.kind.mention.detail": {
      "comment": "What the mention switch governs.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكر شخص لمعرّفك في منشور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ কোনো পোস্টে আপনার হ্যান্ডেল দিলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú que posa el teu identificador en una publicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo uvedl tvůj handle v příspěvku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogen, der sætter dit handle ind i et opslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand nennt dein Handle in einem Beitrag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάποιος βάζει το handle σου σε μια ανάρτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone putting your handle in a post."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien que pone tu identificador en una publicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joku laittaa käyttäjätunnuksesi julkaisuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un qui met votre identifiant dans un post."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו ששם את שם המשתמש שלך בפוסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अपनी पोस्ट में आपका हैंडल डाल रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko stavi tvoj handle u objavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki beírta az @nevedet egy bejegyzésbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang menaruh handle-mu di sebuah postingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno che inserisce il tuo handle in un post."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが投稿にあなたのハンドルを入れたとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 게시물에 내 핸들을 넣을 때."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരെങ്കിലും നിങ്ങളുടെ ഹാൻഡിൽ ഒരു പോസ്റ്റിൽ ചേർക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang meletakkan nama pengendali anda dalam siaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen som skriver brukernavnet ditt i et innlegg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die je handle in een bericht zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś umieszcza Twój uchwyt we wpisie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém colocando seu @usuário em um post."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém a pôr o seu identificador numa publicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva îți pune handle-ul într-o postare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то указывает ваше имя в посте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto uviedol tvoje používateľské meno v príspevku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon som sätter ditt användarnamn i ett inlägg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யாராவது இடுகையில் உங்கள் ஹேண்டிலைக் குறிப்பிடுகிறார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా మీ హ్యాండిల్‌ను పోస్ట్‌లో పెట్టినప్పుడు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนใส่แฮนเดิลของคุณในโพสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri kullanıcı adınızı bir gönderiye yazdığında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось указав ваше @ім’я в дописі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی آپ کا ہینڈل پوسٹ میں ڈالے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đó đặt tên người dùng của bạn trong một bài đăng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在帖子中提到了你的用户名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在貼文中提到你的代號。"
          }
        }
      }
    },
