    "vouch.warning.voucher.two": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن تبيّن أنه مزيّف، تفقد حق التزكية نهائيًا، وقد يُعلَّق حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিনি ভুয়া প্রমাণিত হলে আপনি চিরতরে ভাউচ করার অধিকার হারাবেন, এবং আপনার অ্যাকাউন্ট স্থগিত হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si resulta que és fals, perds el dret d'avalar per sempre, i el teu compte pot ser suspès."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se ukáže, že je falešný, ztratíš právo ručit navždy a tvůj účet může být pozastaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser det sig, at de er falske, mister du for altid retten til at gå i god for andre, og din konto kan blive suspenderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt sich heraus, dass die Person gefälscht ist, verlierst du das Recht zu bürgen dauerhaft, und dein Konto kann gesperrt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αποδειχθεί ότι είναι πλαστός, χάνεις οριστικά το δικαίωμα να εγγυάσαι και ο λογαριασμός σου μπορεί να τεθεί σε αναστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If they turn out to be fake, you lose the right to vouch for good, and your account can be suspended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si resulta ser falso, pierdes para siempre el derecho a avalar y tu cuenta puede ser suspendida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos he osoittautuvat vääriksi, menetät takaamisoikeuden pysyvästi, ja tilisi voidaan jäädyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il s’avère être un faux compte, vous perdez définitivement le droit de vous porter garant, et votre compte peut être suspendu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יתברר שהוא מזויף, תאבד את הזכות לערוב לצמיתות, והחשבון שלך עלול להיות מושעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर वे नकली निकले, तो आप हमेशा के लिए वाउच करने का अधिकार खो देते हैं, और आपका अकाउंट निलंबित हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se pokaže da je lažan/lažna, trajno gubiš pravo na jamčenje, a tvoj račun može biti suspendiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha kiderül, hogy hamis, véglegesen elveszíted a kezeskedés jogát, és a fiókodat fel lehet függeszteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ternyata mereka palsu, kamu kehilangan hak menjamin selamanya, dan akunmu bisa ditangguhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se risulta falso, perdi per sempre il diritto di garantire e il tuo account può essere sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が偽物だと判明した場合、保証する権利を永久に失い、アカウントが停止されることもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방이 가짜로 밝혀지면 보증 자격을 영구히 잃고 계정이 정지될 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവർ വ്യാജമാണെന്ന് തെളിഞ്ഞാൽ, വൗച്ച് ചെയ്യാനുള്ള അവകാശം നിങ്ങൾക്ക് എന്നെന്നേക്കുമായി നഷ്ടമാകും, നിങ്ങളുടെ അക്കൗണ്ടും സസ്പെൻഡ് ചെയ്യപ്പെടാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ternyata dia palsu, anda kehilangan hak untuk menjamin selama-lamanya, dan akaun anda boleh digantung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det viser seg at de er falske, mister du retten til å garantere for godt, og kontoen din kan bli suspendert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als blijkt dat diegene nep is, verlies je het recht om in te staan voorgoed, en kan je account worden geschorst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli okaże się, że to fałszywa osoba, tracisz prawo do poręczania na stałe, a Twoje konto może zostać zawieszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a pessoa for falsa, você perde o direito de avalizar para sempre, e sua conta pode ser suspensa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se se vier a verificar que é falsa, perde para sempre o direito de dar aval, e a sua conta pode ser suspensa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă se dovedește că este fals, pierzi definitiv dreptul de a garanta, iar contul tău poate fi suspendat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если окажется, что человек поддельный, вы навсегда потеряете право поручаться, а ваш аккаунт могут заблокировать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa ukáže, že je falošný, natrvalo stratíš právo ručiť a tvoj účet môže byť pozastavený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det visar sig att de är falska förlorar du rätten att intyga för gott, och ditt konto kan stängas av."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்கள் போலியானவர்கள் எனத் தெரிந்தால், உறுதியளிக்கும் உரிமையை நிரந்தரமாக இழப்பீர்கள்; உங்கள் கணக்கும் இடைநிறுத்தப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారు నకిలీ అని తేలితే, మీరు హామీ ఇచ్చే హక్కును శాశ్వతంగా కోల్పోతారు, మీ ఖాతా సస్పెండ్ కూడా కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเขาเป็นตัวปลอม คุณจะเสียสิทธิ์ในการรับรองถาวร และบัญชีของคุณอาจถูกระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahte olduğu anlaşılırsa kefil olma hakkını kalıcı olarak kaybedersiniz ve hesabınız askıya alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо виявиться, що вони фальшиві, ви назавжди втратите право ручатися, а ваш обліковий запис можуть призупинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر وہ جعلی نکلے تو آپ ہمیشہ کے لیے ضمانت دینے کا حق کھو دیتے ہیں، اور آپ کا اکاؤنٹ معطل ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu họ hóa ra là giả, bạn mất quyền bảo chứng vĩnh viễn, và tài khoản của bạn có thể bị đình chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果对方是假的，你将永久失去担保资格，你的账户也可能被封禁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果對方是假的，你會永久失去擔保資格，你的帳號也可能被停權。"
          }
        }
      }
    },
