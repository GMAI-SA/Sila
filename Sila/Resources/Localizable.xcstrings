    "error.identityHold": {
      "comment": "A write refused while an identity challenge against this account is being reviewed. States what is paused and what is not; never repeats the claim.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشر متوقف مؤقتًا بينما نتحقق من سؤال حول هوية هذا الحساب. لا يزال بإمكانك القراءة، ومنشوراتك لا تزال ظاهرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টের পরিচয় নিয়ে একটি প্রশ্ন যাচাই করার সময় পোস্ট করা বন্ধ আছে। আপনি এখনও পড়তে পারবেন, এবং আপনার পোস্ট আগের মতোই দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicació està en pausa mentre comprovem una qüestió sobre la identitat d'aquest compte. Encara pots llegir i les teves publicacions continuen visibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zveřejňování je pozastaveno, dokud ověřujeme otázku k totožnosti tohoto účtu. Stále můžeš číst a tvé příspěvky zůstávají viditelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag er sat på pause, mens vi undersøger et spørgsmål om denne kontos identitet. Du kan stadig læse, og dine opslag er stadig synlige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Posten ist pausiert, während wir eine Frage zur Identität dieses Kontos klären. Du kannst weiterhin lesen, und deine Beiträge bleiben sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναρτήσεις έχουν παγώσει όσο ελέγχουμε μια απορία για την ταυτότητα αυτού του λογαριασμού. Μπορείς ακόμα να διαβάζεις και οι αναρτήσεις σου παραμένουν ορατές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posting is paused while we check a question about this account's identity. You can still read, and your posts are still visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones están en pausa mientras comprobamos una duda sobre la identidad de esta cuenta. Aún puedes leer y tus publicaciones siguen visibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaiseminen on keskeytetty, kunnes selvitämme kysymyksen tämän tilin henkilöllisyydestä. Voit yhä lukea, ja julkaisusi ovat yhä näkyvissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication est suspendue pendant que nous vérifions une question sur l’identité de ce compte. Vous pouvez toujours lire, et vos posts restent visibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרסום מושהה בזמן שאנחנו בודקים שאלה לגבי זהות החשבון הזה. אפשר עדיין לקרוא, והפוסטים שלך עדיין גלויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट की पहचान के बारे में एक सवाल की जाँच के दौरान पोस्ट करना रुका हुआ है। आप पढ़ सकते हैं, और आपकी पोस्ट अब भी दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objavljivanje je pauzirano dok provjeravamo pitanje o identitetu ovog računa. I dalje možeš čitati, a tvoje objave i dalje su vidljive."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzések írása szünetel, amíg egy kérdést ellenőrzünk a fiók személyazonosságával kapcsolatban. Olvasni továbbra is tudsz, és a bejegyzéseid továbbra is láthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memposting dijeda selagi kami memeriksa pertanyaan tentang identitas akun ini. Kamu masih bisa membaca, dan postinganmu tetap terlihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pubblicazione è sospesa mentre verifichiamo una questione sull'identità di questo account. Puoi ancora leggere e i tuoi post restano visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの本人情報について確認中のため、投稿を一時停止しています。閲覧はできますし、投稿も引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 신원에 관한 문의를 확인하는 동안 게시가 일시 중지되었어요. 읽기는 계속 가능하고 게시물도 그대로 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിന്റെ ഐഡന്റിറ്റിയെക്കുറിച്ചുള്ള ഒരു ചോദ്യം പരിശോധിക്കുന്നതിനാൽ പോസ്റ്റിംഗ് താൽക്കാലികമായി നിർത്തിവച്ചിരിക്കുന്നു. നിങ്ങൾക്ക് ഇപ്പോഴും വായിക്കാം, നിങ്ങളുടെ പോസ്റ്റുകൾ ഇപ്പോഴും ദൃശ്യമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyiaran dijeda sementara kami menyemak persoalan tentang identiti akaun ini. Anda masih boleh membaca, dan siaran anda masih kelihatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Publisering er satt på pause mens vi sjekker et spørsmål om identiteten til denne kontoen. Du kan fortsatt lese, og innleggene dine er fortsatt synlige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posten is gepauzeerd terwijl we een vraag over de identiteit van dit account onderzoeken. Je kunt nog steeds lezen en je berichten blijven zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Publikowanie jest wstrzymane, dopóki sprawdzamy pytanie dotyczące tożsamości tego konta. Nadal możesz czytać, a Twoje wpisy są widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações estão pausadas enquanto verificamos uma dúvida sobre a identidade desta conta. Você ainda pode ler, e seus posts continuam visíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações estão em pausa enquanto verificamos uma questão sobre a identidade desta conta. Pode continuar a ler, e as suas publicações continuam visíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postarea este oprită cât timp verificăm o întrebare despre identitatea acestui cont. Poți citi în continuare, iar postările tale rămân vizibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация приостановлена, пока мы проверяем вопрос о личности владельца этого аккаунта. Вы по-прежнему можете читать, а ваши посты остаются видимыми."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Písanie príspevkov je pozastavené, kým preverujeme otázku k totožnosti tohto účtu. Stále môžeš čítať a tvoje príspevky sú stále viditeľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicering är pausad medan vi kontrollerar en fråga om det här kontots identitet. Du kan fortfarande läsa, och dina inlägg är fortfarande synliga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கின் அடையாளம் பற்றிய கேள்வியை நாங்கள் சரிபார்க்கும் வரை இடுவது நிறுத்தப்பட்டுள்ளது. நீங்கள் இன்னும் படிக்கலாம், உங்கள் இடுகைகள் இன்னும் தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతా గుర్తింపు గురించి ఒక ప్రశ్నను తనిఖీ చేస్తున్నందున పోస్ట్ చేయడం నిలిపివేయబడింది. మీరు ఇంకా చదవవచ్చు, మీ పోస్ట్‌లు ఇంకా కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโพสต์ถูกหยุดชั่วคราวระหว่างที่เราตรวจสอบข้อสงสัยเกี่ยวกับตัวตนของบัญชีนี้ คุณยังอ่านได้ และโพสต์ของคุณยังมองเห็นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın kimliğiyle ilgili bir soruyu kontrol ederken gönderi paylaşımı duraklatıldı. Yine de okuyabilirsiniz ve gönderileriniz görünür kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публікацію призупинено, поки ми розглядаємо питання щодо особи власника цього облікового запису. Ви все ще можете читати, а ваші дописи залишаються видимими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ کی شناخت کے بارے میں ایک سوال کی جانچ تک پوسٹنگ رکی ہوئی ہے۔ آپ اب بھی پڑھ سکتے ہیں، اور آپ کی پوسٹس اب بھی نظر آتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đăng bài tạm dừng trong khi chúng tôi kiểm tra một câu hỏi về danh tính của tài khoản này. Bạn vẫn đọc được, và bài đăng của bạn vẫn hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们正在核查有关此账户身份的一个疑问，发帖暂时停用。你仍可阅读，你的帖子也仍然可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我們確認關於此帳號身分的問題期間，發文功能暫停。你仍可閱讀，你的貼文也仍然可見。"
          }
        }
      }
    },
