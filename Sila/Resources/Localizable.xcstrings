    "vouch.list.decline.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يحصل على الوسم. الرفض لا يُحتسب عليك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিনি ট্যাগটি পাবেন না। প্রত্যাখ্যান করলে আপনার বিরুদ্ধে কিছু ধরা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No rebrà l'etiqueta. Rebutjar mai no es té en compte en contra teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek nedostanou. Odmítnutí se ti nikdy nepočítá k tíži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De får ikke mærket. At afvise bliver aldrig holdt imod dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person bekommt das Tag nicht. Ablehnen wird dir nie angelastet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν θα λάβουν την ετικέτα. Η απόρριψη δεν μετράει ποτέ εις βάρος σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They won't get the tag. Declining is never held against you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recibirá la etiqueta. Rechazar nunca se te tiene en cuenta en contra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "He eivät saa merkkiä. Hylkääminen ei koskaan lasketa sinua vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n’aura pas l’étiquette. Refuser ne vous est jamais reproché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם לא יקבלו את התג. דחייה אף פעם לא נזקפת לחובתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें टैग नहीं मिलेगा। अस्वीकार करना कभी आपके ख़िलाफ़ नहीं गिना जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neće dobiti oznaku. Odbijanje se nikada ne uzima protiv tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kapja meg a címkét. Az elutasítás soha nem róható fel neked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak mendapat tag. Menolak tidak pernah dianggap merugikanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverà l'etichetta. Rifiutare non conta mai contro di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にタグは付きません。却下したことで不利になることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방은 태그를 받지 못해요. 거절은 절대 불이익이 되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവർക്ക് ടാഗ് ലഭിക്കില്ല. നിരസിക്കുന്നത് ഒരിക്കലും നിങ്ങൾക്കെതിരെ ഉപയോഗിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak akan mendapat teg itu. Menolak tidak pernah dipersalahkan kepada anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De får ikke merket. Å avslå holdes aldri mot deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze krijgen de tag niet. Weigeren wordt je nooit aangerekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dostanie oznaczenia. Odrzucenie nigdy nie jest stawiane Ci za zarzut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa não receberá a etiqueta. Recusar nunca é usado contra você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não receberá a etiqueta. Recusar nunca conta contra si."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu va primi eticheta. Refuzul nu este niciodată ținut împotriva ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки у них не будет. Отклонение никогда не ставится вам в вину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Značku nedostane. Zamietnutie sa ti nikdy nezráta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De får inte etiketten. Att avböja läggs aldrig dig till last."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களுக்கு அந்தக் குறி கிடைக்காது. நிராகரிப்பது உங்களுக்கு எதிராக ஒருபோதும் கணக்கில் கொள்ளப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారికి ట్యాగ్ రాదు. తిరస్కరించడం మీపై ఎప్పుడూ ప్రభావం చూపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขาจะไม่ได้รับป้ายนี้ การปฏิเสธจะไม่ส่งผลเสียต่อคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketi almazlar. Reddetmek asla aleyhinize kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони не отримають позначку. Відхилення ніколи не ставиться вам у провину."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انہیں ٹیگ نہیں ملے گا۔ رد کرنا کبھی آپ کے خلاف نہیں گنا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ sẽ không nhận được thẻ. Từ chối không bao giờ bị tính lỗi với bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方不会获得标签。拒绝绝不会对你产生不利影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方不會獲得標籤。拒絕絕不會對你不利。"
          }
        }
      }
    },
