            "state": "translated",
            "value": "Du wirst vor jedem erinnert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα λαμβάνεις υπενθύμιση πριν από κάθε μία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be reminded before every one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recordaremos antes de cada una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat muistutuksen ennen jokaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez un rappel avant chaque séance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקבל תזכורת לפני כל אחד מהם."
