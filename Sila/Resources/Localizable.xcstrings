    "account.handle.change.message": {
      "comment": "Under the field in the settings sheet that changes the handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح معرّفك القديم متاحًا للجميع فور الحفظ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করার সাথে সাথেই আপনার পুরোনো হ্যান্ডেল যে কেউ নিতে পারবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu identificador antic quedarà lliure per a qualsevol persona tan bon punt desis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj starý handle se po uložení uvolní pro kohokoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gamle handle bliver ledigt for alle, så snart du gemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein altes Handle ist für alle frei, sobald du speicherst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το παλιό σου handle ελευθερώνεται για οποιονδήποτε μόλις αποθηκεύσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old handle becomes free for anyone as soon as you save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identificador anterior queda libre para cualquiera en cuanto guardes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanha käyttäjätunnuksesi vapautuu kenen tahansa käyttöön heti, kun tallennat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ancien identifiant devient disponible pour tout le monde dès que vous enregistrez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם המשתמש הישן שלך יתפנה לכולם ברגע שתשמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करते ही आपका पुराना हैंडल किसी के भी लिए उपलब्ध हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj stari handle postaje slobodan za sve čim spremiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régi @neved a mentés pillanatától bárki számára szabaddá válik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle lamamu bebas dipakai siapa saja begitu kamu menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo vecchio handle torna disponibile per chiunque non appena salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するとすぐに、古いハンドルは誰でも使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하는 즉시 이전 핸들은 누구나 사용할 수 있게 돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സേവ് ചെയ്യുന്ന ഉടൻ പഴയ ഹാൻഡിൽ ആർക്കും എടുക്കാവുന്നതാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama pengendali lama anda tersedia untuk sesiapa sahaja sebaik sahaja anda menyimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gamle brukernavnet ditt blir ledig for alle så snart du lagrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je oude handle komt voor iedereen vrij zodra je opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój stary uchwyt stanie się wolny dla wszystkich zaraz po zapisaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu @usuário antigo fica livre para qualquer pessoa assim que você salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu identificador antigo fica livre para qualquer pessoa assim que guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vechiul tău handle devine liber pentru oricine imediat ce salvezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше старое имя станет доступно всем сразу после сохранения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje staré používateľské meno bude voľné pre každého hneď po uložení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt gamla användarnamn blir ledigt för vem som helst så fort du sparar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேமித்ததும் உங்கள் பழைய ஹேண்டில் அனைவருக்கும் கிடைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సేవ్ చేసిన వెంటనే మీ పాత హ్యాండిల్ ఎవరైనా తీసుకునేలా ఖాళీ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แฮนเดิลเดิมของคุณจะว่างให้ทุกคนใช้ได้ทันทีที่คุณบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz anda eski kullanıcı adınız herkese açık hale gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше старе @ім’я стане вільним для всіх, щойно ви збережете."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرتے ہی آپ کا پرانا ہینڈل ہر کسی کے لیے دستیاب ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người dùng cũ của bạn sẽ được giải phóng cho bất kỳ ai ngay khi bạn lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你一保存，旧用户名就会释放给任何人使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後，你原本的帳號代號會立即開放給任何人使用。"
          }
        }
      }
    },
