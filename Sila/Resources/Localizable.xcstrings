    "profile.editProfile.hint": {
      "comment": "VoiceOver hint for the edit-profile button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح اسمك ومعرّفك ونبذتك وصورتك في إعدادات الحساب"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট সেটিংসে আপনার নাম, হ্যান্ডেল, বায়ো ও ছবি খোলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el teu nom, identificador, biografia i foto als ajustos del compte"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře tvé jméno, handle, bio a obrázek v nastavení účtu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner dit navn, handle, bio og billede i kontoindstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Name, Handle, Bio und Bild in den Kontoeinstellungen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει το όνομα, το handle, το βιογραφικό και την εικόνα σου στις ρυθμίσεις λογαριασμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your name, handle, bio and picture in account settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tu nombre, identificador, biografía y foto en los ajustes de la cuenta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa nimesi, käyttäjätunnuksesi, esittelysi ja kuvasi tilin asetuksissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre votre nom, identifiant, bio et photo dans les réglages du compte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את השם, שם המשתמש, התיאור והתמונה שלך בהגדרות החשבון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकाउंट सेटिंग्स में आपका नाम, हैंडल, बायो और फ़ोटो खोलता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara tvoje ime, handle, bio i sliku u postavkama računa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a neved, @neved, bemutatkozásod és képed beállításait a fiókbeállításokban"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka nama, handle, bio, dan fotomu di pengaturan akun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre nome, handle, bio e immagine nelle impostazioni dell'account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント設定で名前、ハンドル、自己紹介、写真を開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 설정에서 이름, 핸들, 소개, 사진을 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ട് ക്രമീകരണങ്ങളിൽ നിങ്ങളുടെ പേര്, ഹാൻഡിൽ, ബയോ, ചിത്രം എന്നിവ തുറക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka nama, nama pengendali, bio dan gambar anda dalam tetapan akaun"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner navnet, brukernavnet, biografien og bildet ditt i kontoinnstillingene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent je naam, handle, bio en foto in de accountinstellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera imię, uchwyt, opis i zdjęcie w ustawieniach konta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre seu nome, @usuário, bio e foto nos ajustes da conta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o seu nome, identificador, bio e foto nas definições da conta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide numele, handle-ul, bio și poza în setările contului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает имя, @имя, описание и фото в настройках аккаунта"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí tvoje meno, používateľské meno, opis a obrázok v nastaveniach účtu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ditt namn, användarnamn, din presentation och bild i kontoinställningarna"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு அமைப்புகளில் உங்கள் பெயர், ஹேண்டில், அறிமுகம், படத்தைத் திறக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా సెట్టింగ్‌లలో మీ పేరు, హ్యాండిల్, బయో, చిత్రాన్ని తెరుస్తుంది"
