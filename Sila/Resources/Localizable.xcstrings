        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les posts de %@ dans votre fil Abonnements"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את הפוסטים של %@ בפיד ״במעקב״ שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की पोस्ट आपकी \"फ़ॉलो कर रहे हैं\" फ़ीड में दिखाता है"
