    "safety.appeal.field.placeholder": {
      "comment": "Placeholder in the appeal field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تعتقد أنه حدث، ولماذا ينبغي إعادة النظر فيه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মতে কী ঘটেছে, এবং কেন তা পুনর্বিবেচনা করা উচিত"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Què creus que ha passat i per què s'hauria de reconsiderar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se podle tebe stalo a proč by se to mělo přehodnotit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad du mener, der skete, og hvorfor det bør genovervejes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was deiner Meinung nach passiert ist und warum es neu geprüft werden sollte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι πιστεύεις ότι συνέβη και γιατί πρέπει να επανεξεταστεί"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you think happened, and why it should be reconsidered"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué crees que pasó y por qué debería reconsiderarse"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä mielestäsi tapahtui ja miksi asia pitäisi käsitellä uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous pensez qu’il s’est passé, et pourquoi cela devrait être réexaminé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה לדעתך קרה, ולמה צריך לשקול מחדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको क्या हुआ लगता है, और इस पर दोबारा विचार क्यों होना चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što misliš da se dogodilo i zašto bi trebalo preispitati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerinted mi történt, és miért kellene újragondolni"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang menurutmu terjadi, dan mengapa harus ditinjau ulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa pensi sia successo e perché andrebbe riconsiderato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何があったと思うか、なぜ再検討されるべきか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무슨 일이 있었다고 생각하는지, 왜 다시 검토해야 하는지"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് സംഭവിച്ചതെന്ന് നിങ്ങൾ കരുതുന്നു, എന്തുകൊണ്ട് പുനഃപരിശോധിക്കണം"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang anda rasa berlaku, dan mengapa ia patut dipertimbangkan semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva du tror skjedde, og hvorfor det bør vurderes på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je denkt dat er gebeurd is, en waarom het opnieuw bekeken moet worden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Twoim zdaniem się stało i dlaczego sprawę należy rozważyć ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você acha que aconteceu e por que deve ser reconsiderado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que acha que aconteceu e porque deve ser reconsiderado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce crezi că s-a întâmplat și de ce ar trebui reconsiderat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что, по-вашему, произошло и почему это стоит пересмотреть"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo sa podľa teba stalo a prečo by sa to malo prehodnotiť"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad du tror hände och varför det bör omprövas"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன நடந்தது என்று நினைக்கிறீர்கள், ஏன் மறுபரிசீலிக்க வேண்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏం జరిగిందని మీరు అనుకుంటున్నారో, దాన్ని ఎందుకు పునఃపరిశీలించాలో"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณคิดว่าเกิดขึ้น และเหตุใดจึงควรพิจารณาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olduğunu düşündüğünüz ve neden yeniden değerlendirilmesi gerektiği"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що, на вашу думку, сталося і чому це варто переглянути"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے خیال میں کیا ہوا، اور اس پر دوبارہ غور کیوں ہونا چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn nghĩ điều gì đã xảy ra, và vì sao cần xem xét lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你认为发生了什么，以及为什么应该重新考虑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你認為發生了什麼事，以及為什麼應該重新考慮"
          }
        }
      }
    },
