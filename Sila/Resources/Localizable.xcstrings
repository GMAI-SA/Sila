    "communities.create.blocked.address": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عنوانًا: من ٣ إلى ٣٠ حرفًا أو رقمًا أو شرطة سفلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ঠিকানা বেছে নিন: ৩–৩০টি অক্ষর, সংখ্যা বা আন্ডারস্কোর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una adreça: de 3 a 30 lletres, números o guions baixos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber adresu: 3–30 písmen, číslic nebo podtržítek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en adresse: 3–30 bogstaver, tal eller understregninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Adresse: 3–30 Buchstaben, Ziffern oder Unterstriche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε διεύθυνση: 3–30 γράμματα, αριθμοί ή κάτω παύλες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an address: 3–30 letters, numbers or underscores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una dirección: de 3 a 30 letras, números o guiones bajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse osoite: 3–30 kirjainta, numeroa tai alaviivaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une adresse : 3 à 30 lettres, chiffres ou tirets bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר כתובת: 3–30 אותיות, ספרות או קווים תחתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पता चुनें: 3–30 अक्षर, संख्याएँ या अंडरस्कोर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi adresu: 3–30 slova, brojeva ili podcrta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz címet: 3–30 betű, szám vagy aláhúzás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih alamat: 3–30 huruf, angka, atau garis bawah."
