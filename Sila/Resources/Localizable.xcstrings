    "vouch.new.who.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كما في هويته. على من يفتح الرابط أن يُدخل البيانات الثلاث نفسها، فيتوقف الرابط المُمرَّر عندها. لن يرى ما كتبته أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাঁর আইডিতে যেমন আছে। যিনি লিংক খুলবেন তাঁকে এই তিনটি একই দিতে হবে, তাই ফরওয়ার্ড করা লিংক সেখানেই থেমে যায়। আপনি যা লিখেছেন তা তিনি কখনও দেখেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal com és al seu document. Qui obri l'enllaç n'ha d'indicar les mateixes tres dades, així que un enllaç reenviat s'atura aquí. Mai no veu el que has escrit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako na dokladu. Kdokoli odkaz otevře, musí uvést stejné tři údaje, takže přeposlaný odkaz tím končí. Nikdy nevidí, co jsi napsal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som på deres id. Den, der åbner linket, skal angive de samme tre, så et videresendt link stopper dér. De ser aldrig, hvad du skrev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie im Ausweis. Wer den Link öffnet, muss dieselben drei Angaben machen, sodass ein weitergeleiteter Link dort endet. Die Person sieht nie, was du geschrieben hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όπως στην ταυτότητά του. Όποιος ανοίξει τον σύνδεσμο πρέπει να δώσει τα ίδια τρία στοιχεία, οπότε ένας προωθημένος σύνδεσμος σταματά εκεί. Δεν βλέπουν ποτέ τι έγραψες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As on their ID. Whoever opens the link has to give the same three, so a forwarded link stops there. They never see what you wrote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como en su documento. Quien abra el enlace tiene que dar los mismos tres datos, así que un enlace reenviado no pasa de ahí. Nunca ve lo que escribiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten henkilöllisyystodistuksessa. Linkin avaajan on annettava samat kolme, joten eteenpäin lähetetty linkki pysähtyy siihen. He eivät koskaan näe, mitä kirjoitit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme sur sa pièce d’identité. La personne qui ouvre le lien doit donner les trois mêmes informations, un lien transféré s’arrête donc là. Elle ne voit jamais ce que vous avez écrit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כפי שמופיע בתעודת הזהות שלהם. מי שפותח את הקישור חייב למסור את אותם שלושה פרטים, ולכן קישור שהועבר הלאה נעצר שם. הם אף פעם לא רואים מה כתבת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा उनकी ID पर है। जो भी लिंक खोले उसे यही तीनों देने होंगे, इसलिए आगे भेजा गया लिंक वहीं रुक जाता है। आपने जो लिखा वह उन्हें कभी नहीं दिखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao na njihovoj ispravi. Tko god otvori poveznicu mora navesti ista tri podatka pa proslijeđena poveznica tu staje. Nikada ne vide što si napisao/la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azonosítóján szereplő módon. Aki megnyitja a hivatkozást, ugyanazt a hármat kell, hogy megadja, így egy továbbított hivatkozás itt elakad. Soha nem látja, amit te írtál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti di ID mereka. Siapa pun yang membuka tautan harus memberikan ketiganya yang sama, jadi tautan yang diteruskan berhenti di situ. Mereka tidak pernah melihat yang kamu tulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sul suo documento. Chi apre il link deve indicare gli stessi tre dati, così un link inoltrato si ferma lì. Non vede mai ciò che hai scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDに記載のとおりに入力してください。リンクを開く人も同じ3つを入力する必要があるため、転送されたリンクはそこで止まります。あなたが書いた内容は相手には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신분증에 적힌 대로 입력하세요. 링크를 여는 사람도 같은 세 가지를 입력해야 하므로 전달된 링크는 거기서 막혀요. 내가 쓴 내용은 상대방에게 보이지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവരുടെ ഐഡിയിലുള്ളതുപോലെ. ലിങ്ക് തുറക്കുന്നയാൾ ഇതേ മൂന്ന് കാര്യങ്ങൾ നൽകണം, അതിനാൽ കൈമാറിയ ലിങ്ക് അവിടെ നിലയ്ക്കും. നിങ്ങൾ എഴുതിയത് അവർ ഒരിക്കലും കാണില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti pada ID mereka. Sesiapa yang membuka pautan mesti memberikan ketiga-tiganya yang sama, jadi pautan yang dipanjangkan berhenti di situ. Mereka tidak pernah melihat apa yang anda tulis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som på ID-en deres. Den som åpner lenken, må oppgi de samme tre, så en videresendt lenke stopper der. De ser aldri hva du skrev."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals op het identiteitsbewijs. Wie de link opent moet dezelfde drie gegevens opgeven, dus een doorgestuurde link houdt daar op. Ze zien nooit wat jij hebt geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak w jej dokumencie. Osoba, która otworzy link, musi podać te same trzy dane, więc przesłany dalej link kończy się na tym. Nigdy nie widzi, co wpisałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como no documento. Quem abrir o link precisa informar os mesmos três dados, então um link encaminhado para por aí. A pessoa nunca vê o que você escreveu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como no documento. Quem abrir a ligação tem de indicar os mesmos três dados, por isso uma ligação reencaminhada fica por aí. A pessoa nunca vê o que escreveu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca pe act. Cine deschide linkul trebuie să dea aceleași trei date, așa că un link redirecționat se oprește aici. Nu văd niciodată ce ai scris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в его документе. Тот, кто откроет ссылку, должен указать те же три данные, так что пересланная ссылка не сработает. Он никогда не увидит, что вы написали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako na jej preukaze. Kto otvorí odkaz, musí uviesť rovnaké tri údaje, takže preposlaný odkaz tam skončí. Nikdy nevidí, čo si napísal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som på deras id. Den som öppnar länken måste ange samma tre uppgifter, så en vidarebefordrad länk tar slut där. De ser aldrig vad du skrev."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் அடையாள அட்டையில் உள்ளபடி. இணைப்பைத் திறப்பவர் இதே மூன்றையும் கொடுக்க வேண்டும், எனவே முன்னனுப்பப்பட்ட இணைப்பு அங்கேயே நின்றுவிடும். நீங்கள் எழுதியதை அவர்கள் ஒருபோதும் பார்க்க மாட்டார்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారి ID లో ఉన్నట్లే. లింక్ తెరిచే వ్యక్తి ఈ మూడూ అవే ఇవ్వాలి, కాబట్టి ఫార్వర్డ్ చేసిన లింక్ ఇక్కడే ఆగిపోతుంది. మీరు రాసినది వారికి ఎప్పుడూ కనిపించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตามบัตรประจำตัวของเขา คนที่เปิดลิงก์ต้องระบุสามอย่างนี้ให้ตรงกัน ลิงก์ที่ส่งต่อจึงใช้ไม่ได้ เขาจะไม่เห็นสิ่งที่คุณเขียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinde yazdığı gibi. Bağlantıyı açan kişi aynı üçünü vermelidir, bu yüzden iletilen bir bağlantı orada durur. Yazdıklarınızı asla görmezler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у документі. Той, хто відкриє посилання, має вказати ті самі три дані, тож переслане посилання на цьому зупиняється. Вони ніколи не бачать, що ви написали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جیسا ان کے شناختی کارڈ پر ہے۔ جو بھی لنک کھولے اسے یہی تینوں دینی ہوں گی، اس لیے آگے بھیجا گیا لنک وہیں رک جاتا ہے۔ آپ نے جو لکھا وہ انہیں کبھی نظر نہیں آتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như trên giấy tờ của họ. Ai mở liên kết phải khai đúng cả ba mục này, nên một liên kết bị chuyển tiếp sẽ dừng ở đó. Họ không bao giờ thấy bạn đã viết gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与对方证件上的一致。打开链接的人必须填写相同的三项，因此被转发的链接会就此失效。对方永远看不到你写的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依對方證件上的資料。開啟連結的人必須填寫相同的三項，所以轉傳的連結到此就失效。對方永遠看不到你寫了什麼。"
          }
        }
      }
    },
