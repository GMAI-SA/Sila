    "rooms.host.invitedToast": {
      "comment": "Toast after inviting somebody to speak. %@ is their name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ%@ التحدث الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এখন কথা বলতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ja pot parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatel %@ může mluvit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan tale nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann jetzt sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ μπορεί να μιλήσει τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can speak now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya puede hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voi nyt puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut parler maintenant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ יכול לדבר עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अब बोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sada može govoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ most megszólalhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sekarang bisa berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora può parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が発言できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 이제 말할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഇപ്പോൾ സംസാരിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boleh bercakap sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan snakke nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan nu spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ może teraz mówić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já pode falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já pode falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poate vorbi acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь может говорить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ môže teraz hovoriť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan tala nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இப்போது பேசலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఇప్పుడు మాట్లాడవచ్చు."
