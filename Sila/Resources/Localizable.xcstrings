          "stringUnit": {
            "state": "translated",
            "value": "Was deine Bürgschaft dir erlaubt und wie du dich verifizierst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι σου επιτρέπει η εγγύησή σου και πώς να επαληθευτείς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your vouch lets you do, and how to verify"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te permite tu aval y cómo verificarte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä takuusi sallii ja miten vahvistat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que votre caution vous permet de faire, et comment vous vérifier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה הערבות שלך מאפשרת לך, ואיך לאמת"
