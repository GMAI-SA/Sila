    "rooms.host.handDismissedToast": {
      "comment": "Toast.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خُفضت يد %@. يمكنهم رفعها مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর হাত নামানো হয়েছে। তিনি আবার তুলতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha abaixat la mà de %@. La pot tornar a aixecar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruka uživatele %@ je spuštěna. Může ji zvednout znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@s hånd er sænket. Vedkommende kan række den op igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hand von %@ ist gesenkt. Sie kann sie wieder heben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χέρι του/της %@ κατέβηκε. Μπορεί να το σηκώσει ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s hand is lowered. They can raise it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano de %@ está bajada. Puede volver a levantarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjän %@ käsi on laskettu. Hän voi nostaa sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La main de %@ est baissée. Il peut la lever à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היד של %@ הורדה. הוא יכול להרים אותה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का हाथ नीचे कर दिया गया। वे इसे फिर उठा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruka korisnika %@ je spuštena. Može je ponovno podići."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keze leengedve. Újra jelentkezhet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan %@ diturunkan. Mereka bisa mengangkatnya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mano di %@ è abbassata. Può rialzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の手を下げました。もう一度挙げることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님의 손을 내렸어요. 다시 들 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളുടെ കൈ താഴ്ത്തി. അവർക്ക് വീണ്ടും ഉയർത്താം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan %@ diturunkan. Mereka boleh mengangkatnya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hånden til %@ er senket. Vedkommende kan rekke den opp igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hand van %@ is omlaag. Diegene kan hem weer opsteken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręka: %@ została opuszczona. Można ją podnieść ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão de %@ foi baixada. A pessoa pode levantá-la de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mão de %@ foi baixada. Pode voltar a levantá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mâna lui %@ a fost coborâtă. O poate ridica din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рука %@ опущена. Можно поднять снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruka používateľa %@ je spustená. Môže ju zdvihnúť znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@s hand är sänkt. De kan räcka upp den igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன் கை கீழிறக்கப்பட்டது. மீண்டும் உயர்த்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ చేయి దించబడింది. వారు మళ్లీ ఎత్తవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดมือของ %@ แล้ว พวกเขายกอีกครั้งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin eli indirildi. Yeniden kaldırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Руку %@ опущено. Вона може підняти її знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کا ہاتھ نیچے کر دیا گیا۔ وہ اسے دوبارہ اٹھا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay của %@ đã hạ. Họ có thể giơ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的手已放下，对方可以再次举手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的手已放下。對方可以再次舉手。"
          }
        }
      }
    },
