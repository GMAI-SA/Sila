        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pyynnön. Käyttäjälle %@ ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la demande. %@ n’en est pas informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר את הבקשה. %@ לא מקבל הודעה."
          }
        },
        "hi": {
