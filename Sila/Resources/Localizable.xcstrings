    "auth.forgotPassword.subtitle": {
      "comment": "Password reset screen subheading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنرسل رمزًا من ستة أرقام إلى البريد المسجّل في حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্টের ঠিকানায় আমরা ছয় সংখ্যার একটি কোড ইমেইল করব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T'enviarem per correu un codi de sis dígits a l'adreça del teu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleme šestimístný kód na adresu tvého účtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en sekscifret kode til adressen på din konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden einen sechsstelligen Code an die Adresse deines Kontos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα στείλουμε έναν εξαψήφιο κωδικό στη διεύθυνση του λογαριασμού σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll email a six-digit code to the address on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos un código de seis dígitos a la dirección de tu cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetämme kuusinumeroisen koodin tilisi sähköpostiosoitteeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un code à six chiffres à l’adresse de votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח קוד בן שש ספרות בדוא״ל לכתובת שבחשבון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपके अकाउंट के पते पर छह अंकों का कोड ईमेल करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslat ćemo šesteroznamenkasti kod na adresu tvog računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatjegyű kódot küldünk a fiókodhoz tartozó címre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengirim kode enam digit lewat email ke alamat di akunmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invieremo un codice di sei cifre all'indirizzo del tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのアドレスに6桁のコードをメールで送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 등록된 주소로 6자리 코드를 이메일로 보내드려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അക്കൗണ്ടിലെ വിലാസത്തിലേക്ക് ഞങ്ങൾ ആറക്ക കോഡ് ഇമെയിൽ ചെയ്യും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengemel kod enam digit ke alamat pada akaun anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender en sekssifret kode på e-post til adressen på kontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We mailen een zescijferige code naar het adres van je account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy sześciocyfrowy kod na adres powiązany z Twoim kontem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código de seis dígitos por e-mail para o endereço da sua conta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos por email um código de seis dígitos para o endereço da sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți trimitem un cod din șase cifre la adresa contului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправим шестизначный код на адрес вашего аккаунта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleme šesťmiestny kód na adresu tvojho účtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skickar en sexsiffrig kod till adressen på ditt konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கில் உள்ள முகவரிக்கு ஆறு இலக்கக் குறியீட்டை மின்னஞ்சல் செய்வோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతాలోని చిరునామాకు ఆరు అంకెల కోడ్‌ను ఈమెయిల్ చేస్తాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะส่งรหัสหกหลักทางอีเมลไปยังที่อยู่ในบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızdaki adrese altı haneli bir kod e-postayla göndereceğiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надішлемо шестизначний код на адресу вашого облікового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کے اکاؤنٹ کے پتے پر چھ ہندسوں کا کوڈ ای میل کریں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi mã sáu chữ số đến địa chỉ email của tài khoản bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会向你账户所用的邮箱发送一个六位验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會將六位數驗證碼寄到你帳號的電子郵件地址。"
          }
        }
      }
    },
