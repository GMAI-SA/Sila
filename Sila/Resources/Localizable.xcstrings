    "composer.scope.everyoneCanRead": {
      "comment": "The line under the audience header. Scope governs replying, never reading.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجميع يمكنهم قراءته"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবাই এটি পড়তে পারে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom la pot llegir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Může to číst každý"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan læse det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle können es lesen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλοι μπορούν να τη διαβάσουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone can read it"
