    "feed.hashtag.sort.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد ترتيب المنشورات ويحفظ اختيارك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্টগুলো নতুন করে সাজায় এবং আপনার পছন্দ মনে রাখে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena les publicacions i recorda la teva elecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní pořadí příspěvků a zapamatuje si tvou volbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterer opslagene om og husker dit valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet die Beiträge neu und merkt sich deine Wahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναδιατάσσει τις αναρτήσεις και θυμάται την επιλογή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorders the posts and remembers your choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena las publicaciones y recuerda tu elección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestää julkaisut uudelleen ja muistaa valintasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réordonne les posts et mémorise votre choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסדר מחדש את הפוסטים וזוכר את הבחירה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट का क्रम बदलता है और आपकी पसंद याद रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preslaguje objave i pamti tvoj izbor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átrendezi a bejegyzéseket, és megjegyzi a választásodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengurutkan ulang postingan dan mengingat pilihanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina i post e ricorda la tua scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿の並び順を変更し、選択を記憶します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시물 순서를 바꾸고 선택을 기억해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പോസ്റ്റുകളുടെ ക്രമം മാറ്റുകയും നിങ്ങളുടെ തിരഞ്ഞെടുപ്പ് ഓർമിക്കുകയും ചെയ്യുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyusun semula siaran dan mengingati pilihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrer rekkefølgen på innleggene og husker valget ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteert de berichten opnieuw en onthoudt je keuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia kolejność wpisów i zapamiętuje Twój wybór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena os posts e lembra da sua escolha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena as publicações e memoriza a sua escolha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordonează postările și îți reține alegerea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет порядок постов и запоминает ваш выбор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmení poradie príspevkov a zapamätá si tvoj výber."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrar ordningen på inläggen och kommer ihåg ditt val."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகைகளை மறுவரிசைப்படுத்தி உங்கள் தேர்வை நினைவில் வைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్‌లను తిరిగి క్రమబద్ధీకరించి, మీ ఎంపికను గుర్తుంచుకుంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเรียงโพสต์ใหม่และจำตัวเลือกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderileri yeniden sıralar ve seçiminizi hatırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює порядок дописів і запам’ятовує ваш вибір."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسٹس کی ترتیب بدلتا ہے اور آپ کا انتخاب یاد رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp lại các bài đăng và ghi nhớ lựa chọn của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新排列帖子并记住你的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新排序貼文並記住你的選擇。"
          }
        }
      }
    },
