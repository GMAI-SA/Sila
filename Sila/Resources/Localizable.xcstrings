    "document.review.message": {
      "comment": "Review step body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُرئت من وثيقتك. إن كان شيء خاطئًا فأعد التقاط الصورة — لا يمكن كتابة أي شيء هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নথি থেকে পড়া হয়েছে। কিছু ভুল থাকলে আবার ছবি তুলুন — এখানে কিছু টাইপ করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegit del teu document. Si alguna cosa no és correcta, repeteix la foto: aquí no es pot escriure res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přečteno z tvého dokladu. Pokud je něco špatně, vyfoť znovu – nic zde nelze ručně napsat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læst fra dit dokument. Hvis noget er forkert, så tag fotoet om – intet her kan skrives ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinem Dokument gelesen. Wenn etwas nicht stimmt, nimm das Foto neu auf – hier kann nichts eingetippt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστηκε από το έγγραφό σου. Αν κάτι είναι λάθος, τράβηξε ξανά τη φωτογραφία — τίποτα εδώ δεν πληκτρολογείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from your document. If anything is wrong, retake the photo — nothing here can be typed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído de tu documento. Si algo es incorrecto, repite la foto: aquí no se puede escribir nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettu asiakirjastasi. Jos jokin on väärin, ota kuva uudelleen – täällä mitään ei voi kirjoittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu depuis votre document. Si quelque chose est faux, reprenez la photo — rien ici ne peut être saisi à la main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקרא מהמסמך שלך. אם משהו שגוי, צלם שוב — אי אפשר להקליד כאן דבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दस्तावेज़ से पढ़ा गया। कुछ भी ग़लत हो तो फ़ोटो दोबारा लें — यहाँ कुछ भी टाइप नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pročitano s tvoje isprave. Ako nešto nije točno, ponovno snimi fotografiju — ovdje se ništa ne može upisati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okmányodból beolvasva. Ha valami nem stimmel, fényképezd le újra – itt semmit nem lehet begépelni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibaca dari dokumenmu. Jika ada yang salah, ambil ulang fotonya — tidak ada yang bisa diketik di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dal tuo documento. Se qualcosa non va, rifai la foto: qui nulla si può digitare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類から読み取った内容です。誤りがある場合は写真を撮り直してください。ここでは入力による修正はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에서 읽은 정보예요. 잘못된 부분이 있으면 사진을 다시 찍으세요. 여기서는 직접 입력할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രേഖയിൽ നിന്ന് വായിച്ചത്. എന്തെങ്കിലും തെറ്റുണ്ടെങ്കിൽ ഫോട്ടോ വീണ്ടും എടുക്കുക — ഇവിടെ ഒന്നും ടൈപ്പ് ചെയ്യാനാവില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibaca daripada dokumen anda. Jika ada yang salah, ambil semula foto — tiada apa di sini boleh ditaip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lest fra dokumentet ditt. Hvis noe er feil, tar du bildet på nytt. Ingenting her kan skrives inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen van je document. Als er iets niet klopt, maak de foto dan opnieuw: hier kan niets worden getypt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano z Twojego dokumentu. Jeśli coś się nie zgadza, zrób zdjęcie ponownie — niczego tu nie można wpisać ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do seu documento. Se algo estiver errado, tire a foto de novo: nada aqui pode ser digitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido a partir do seu documento. Se algo estiver errado, repita a foto — nada aqui pode ser escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citit din documentul tău. Dacă ceva nu e corect, refă fotografia — nimic de aici nu poate fi scris de mână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считано с вашего документа. Если что-то неверно, переснимите фото — здесь ничего нельзя ввести вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečítané z tvojho dokladu. Ak je niečo nesprávne, odfoť ho znova — nič tu sa nedá písať ručne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avläst från ditt dokument. Om något är fel, ta om fotot – inget här kan skrivas in."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆவணத்திலிருந்து படிக்கப்பட்டது. ஏதேனும் தவறாக இருந்தால் புகைப்படத்தை மீண்டும் எடுங்கள் — இங்கே எதையும் தட்டச்சு செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పత్రం నుండి చదివినవి. ఏదైనా తప్పుగా ఉంటే ఫోటోను మళ్లీ తీయండి — ఇక్కడ ఏదీ టైప్ చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านจากเอกสารของคุณ หากมีอะไรผิด ให้ถ่ายรูปใหม่ ข้อมูลตรงนี้พิมพ์แก้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenizden okundu. Bir şey yanlışsa fotoğrafı yeniden çekin; buradaki hiçbir şey elle yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зчитано з вашого документа. Якщо щось не так, зробіть фото знову — тут нічого не можна ввести вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے دستاویز سے پڑھا گیا۔ اگر کچھ غلط ہے تو تصویر دوبارہ لیں — یہاں کچھ ٹائپ نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc từ giấy tờ của bạn. Nếu có gì sai, hãy chụp lại ảnh — ở đây không thể gõ gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下内容读取自你的证件。如有错误，请重拍照片，这里的内容无法手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是從你的證件讀取的內容。如有錯誤請重拍，這裡的內容無法手動輸入。"
          }
        }
      }
    },
