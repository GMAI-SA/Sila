    "safety.report.outcome": {
      "comment": "What Sila will and will not promise. Both halves matter: every report is reviewed, and not every report leads to a removal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراجع معروف كل بلاغ. ولا يؤدي كل بلاغ إلى إزالة شيء، ولن تُبلَّغ دائمًا بما حدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known প্রতিটি রিপোর্ট পর্যালোচনা করে। প্রতিটি রিপোর্টে কিছু সরানো হয় না, আর কী হলো তা আপনাকে সবসময় জানানো হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known revisa cada denúncia. No totes les denúncies porten a eliminar alguna cosa, i no sempre se't dirà què ha passat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known posuzuje každé nahlášení. Ne každé vede k odstranění a ne vždy se dozvíš, co se stalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known gennemgår hver anmeldelse. Ikke alle anmeldelser fører til, at noget fjernes, og du får ikke altid at vide, hvad der skete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known prüft jede Meldung. Nicht jede Meldung führt dazu, dass etwas entfernt wird, und du erfährst nicht immer, was passiert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known εξετάζει κάθε αναφορά. Δεν οδηγεί κάθε αναφορά στην αφαίρεση κάποιου περιεχομένου και δεν θα ενημερώνεσαι πάντα για το τι έγινε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known reviews every report. Not every report leads to something being removed, and you will not always be told what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known revisa cada denuncia. No toda denuncia lleva a que se elimine algo, y no siempre se te dirá qué pasó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known tarkastaa jokaisen ilmiannon. Kaikki ilmiannot eivät johda poistoon, etkä aina saa tietää, mitä tapahtui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known examine chaque signalement. Tous ne mènent pas à un retrait, et vous ne saurez pas toujours ce qui s’est passé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known בודקת כל דיווח. לא כל דיווח מוביל להסרת משהו, ולא תמיד תקבל הודעה על מה שקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known हर रिपोर्ट की समीक्षा करता है। हर रिपोर्ट पर कुछ हटाया नहीं जाता, और आपको हमेशा नहीं बताया जाएगा कि क्या हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known pregledava svaku prijavu. Ne vodi svaka prijava do uklanjanja, a ne obavijestimo te uvijek o ishodu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known minden jelentést áttekint. Nem minden jelentés vezet eltávolításhoz, és nem mindig tudjuk meg, mi történt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known meninjau setiap laporan. Tidak setiap laporan berujung pada sesuatu dihapus, dan kamu tidak akan selalu diberi tahu apa yang terjadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known esamina ogni segnalazione. Non ogni segnalazione porta alla rimozione di qualcosa, e non sempre ti verrà detto cosa è successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownはすべての報告を審査します。すべての報告で何かが削除されるわけではなく、結果が必ず知らされるとも限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known은 모든 신고를 검토해요. 모든 신고가 삭제로 이어지는 것은 아니며, 어떤 일이 있었는지 항상 알려드리지는 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ഓരോ റിപ്പോർട്ടും പരിശോധിക്കും. എല്ലാ റിപ്പോർട്ടും എന്തെങ്കിലും നീക്കം ചെയ്യുന്നതിലേക്ക് നയിക്കില്ല, എന്ത് സംഭവിച്ചെന്ന് എപ്പോഴും നിങ്ങളെ അറിയിക്കണമെന്നുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known menyemak setiap laporan. Tidak setiap laporan membawa kepada sesuatu dialih keluar, dan anda tidak akan sentiasa diberitahu apa yang berlaku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known vurderer hver rapport. Ikke alle rapporter fører til at noe fjernes, og du får ikke alltid vite hva som skjedde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known beoordeelt elke melding. Niet elke melding leidt ertoe dat iets wordt verwijderd, en je hoort niet altijd wat er is gebeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known sprawdza każde zgłoszenie. Nie każde zgłoszenie prowadzi do usunięcia czegokolwiek i nie zawsze zostaniesz poinformowany, co się stało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known analisa todas as denúncias. Nem toda denúncia leva à remoção de algo, e nem sempre você será avisado do que aconteceu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known revê todas as denúncias. Nem todas as denúncias levam a que algo seja removido, e nem sempre será informado do que aconteceu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known analizează fiecare raportare. Nu orice raportare duce la eliminarea a ceva și nu vei fi mereu anunțat ce s-a întâmplat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Known рассматривает каждую жалобу. Не каждая жалоба приводит к удалению, и вам не всегда сообщат, что было сделано."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known posudzuje každé nahlásenie. Nie každé vedie k odstráneniu niečoho a nie vždy sa dozvieš, čo sa stalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known granskar varje rapport. Inte varje rapport leder till att något tas bort, och du får inte alltid veta vad som hände."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ஒவ்வொரு புகாரையும் மதிப்பாய்வு செய்கிறது. ஒவ்வொரு புகாரும் எதையாவது நீக்க வழிவகுக்காது, என்ன நடந்தது என்று எப்போதும் உங்களுக்குச் சொல்லப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ప్రతి రిపోర్ట్‌ను సమీక్షిస్తుంది. ప్రతి రిపోర్ట్ ఏదో తొలగింపునకు దారితీయదు, ఏం జరిగిందో మీకు ఎల్లప్పుడూ చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ตรวจสอบทุกรายงาน ไม่ใช่ทุกรายงานที่นำไปสู่การลบ และคุณอาจไม่ได้รับแจ้งเสมอไปว่าเกิดอะไรขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known her şikayeti inceler. Her şikayet bir şeyin kaldırılmasıyla sonuçlanmaz ve ne olduğu size her zaman söylenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known розглядає кожну скаргу. Не кожна скарга призводить до видалення чогось, і вам не завжди повідомлять, що сталося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ہر رپورٹ کا جائزہ لیتا ہے۔ ہر رپورٹ پر کچھ ہٹایا نہیں جاتا، اور آپ کو ہمیشہ نہیں بتایا جائے گا کہ کیا ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known xem xét mọi báo cáo. Không phải báo cáo nào cũng dẫn đến việc gỡ bỏ nội dung, và bạn sẽ không phải lúc nào cũng được báo điều gì đã xảy ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 会审核每一份举报。并非每份举报都会导致内容被移除，你也不一定会被告知结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 會審核每項檢舉。並非每項檢舉都會導致內容被移除，你也不一定會得知結果。"
          }
        }
      }
    },
