        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută postări și oameni. Scrie cel puțin două caractere"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет посты и людей. Введите не менее двух символов"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadá príspevky a ľudí. Napíš aspoň dva znaky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker bland inlägg och personer. Skriv minst två tecken"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடுகைகளையும் நபர்களையும் தேடும். குறைந்தது இரண்டு எழுத்துகளை உள்ளிடுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్ట్‌లు మరియు వ్యక్తుల కోసం వెతుకుతుంది. కనీసం రెండు అక్షరాలు టైప్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาโพสต์และผู้คน พิมพ์อย่างน้อยสองตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilerde ve kişilerde arar. En az iki karakter yazın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає дописи й людей. Введіть щонайменше два символи"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسٹس اور لوگوں کو تلاش کرتا ہے۔ کم از کم دو حروف ٹائپ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm bài đăng và mọi người. Gõ ít nhất hai ký tự"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索帖子和用户。请至少输入两个字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋貼文和用戶。請至少輸入兩個字元"
          }
        }
      }
    },
