    "vouch.ended.reason.unconfirmed": {
      "comment": "Why the vouch ended: the 48 hours ran out. %@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكّد ⁦@%@⁩ في الوقت المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ সময়মতো নিশ্চিত করেননি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ no ha confirmat a temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nepotvrdil včas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bekræftede ikke i tide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ hat nicht rechtzeitig bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η @%@ δεν επιβεβαίωσε εγκαίρως."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ didn't confirm in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ no confirmó a tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ei vahvistanut ajoissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ n’a pas confirmé à temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ לא אישר בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ ने समय पर पुष्टि नहीं की।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nije potvrdio/la na vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ nem erősítette meg időben."
          }
        },
        "id": {
          "stringUnit": {
