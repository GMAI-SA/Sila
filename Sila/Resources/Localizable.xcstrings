    "preferences.summary.narrowed.taggedOnly": {
      "comment": "Summary when the topic filter is on and unlabelled posts are hidden. %lld is how many topics were chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld مواضيع اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوعًا اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوع الذي اخترته فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوع اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوعين اللذين اخترتهما فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية لا تعرض شيئًا، إذ لم تختر أي موضوع والمنشورات غير المصنّفة مخفية."
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আপনার আন্তর্জাতিক ফিড আপনার বেছে নেওয়া %lld টি বিষয়ের পোস্ট দেখায়; এখনও লেবেল দেওয়া হয়নি এমন পোস্ট লুকানো থাকে।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আপনার আন্তর্জাতিক ফিড আপনার বেছে নেওয়া %lld টি বিষয়ের পোস্ট দেখায়; এখনও লেবেল দেওয়া হয়নি এমন পোস্ট লুকানো থাকে।"
                }
              }
            }
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El teu canal Internacional mostra només publicacions sobre %lld tema que has triat; les publicacions que encara no s'han etiquetat s'amaguen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El teu canal Internacional mostra només publicacions sobre %lld temes que has triat; les publicacions que encara no s'han etiquetat s'amaguen."
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tvůj Mezinárodní kanál zobrazuje jen příspěvky o %lld tebou vybraném tématu; dosud neoznačené příspěvky jsou skryté."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tvůj Mezinárodní kanál zobrazuje jen příspěvky o %lld tebou vybraných tématech; dosud neoznačené příspěvky jsou skryté."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tvůj Mezinárodní kanál zobrazuje jen příspěvky o %lld tebou vybraných tématech; dosud neoznačené příspěvky jsou skryté."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tvůj Mezinárodní kanál zobrazuje jen příspěvky o %lld tebou vybraných tématech; dosud neoznačené příspěvky jsou skryté."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dit internationale feed viser kun opslag om %lld emne, du valgte; opslag, der endnu ikke er mærket, er skjult."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dit internationale feed viser kun opslag om %lld emner, du valgte; opslag, der endnu ikke er mærket, er skjult."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dein internationaler Feed zeigt nur Beiträge zu %lld Thema, das du gewählt hast; noch nicht gelabelte Beiträge sind ausgeblendet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dein internationaler Feed zeigt nur Beiträge zu %lld Themen, die du gewählt hast; noch nicht gelabelte Beiträge sind ausgeblendet."
