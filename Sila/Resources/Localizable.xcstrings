    "feed.tab.notifications.hint": {
      "comment": "VoiceOver hint for the notifications tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتابعات والإعجابات وإعادات النشر والردود والإشارات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলো, লাইক, রিপোস্ট, উত্তর ও মেনশন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguiments, m'agrada, republicacions, respostes i mencions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování, lajky, sdílení, odpovědi a zmínky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye følgere, likes, delinger, svar og omtaler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows, Likes, Reposts, Antworten und Erwähnungen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθήσεις, «μου αρέσει», αναδημοσιεύσεις, απαντήσεις και αναφορές"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows, likes, reposts, replies and mentions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguidores, me gusta, reposts, respuestas y menciones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraajat, tykkäykset, uudelleenjaot, vastaukset ja maininnat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements, mentions J’aime, republications, réponses et mentions"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוקבים, לייקים, שיתופים, תגובות ותיוגים"
