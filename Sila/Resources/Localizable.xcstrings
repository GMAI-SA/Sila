    "account.profile.error.handleInvalid": {
      "comment": "Validation on a malformed handle. %1$@ is the minimum length, %2$@ the maximum. The en dash between them is deliberate.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعرّف من %1$@ إلى %2$@ حرفًا من الحروف والأرقام والشرطة السفلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যান্ডেল হবে %1$@–%2$@টি অক্ষর, সংখ্যা ও আন্ডারস্কোর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els identificadors tenen entre %1$@ i %2$@ caràcters, entre lletres, números i guions baixos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle má %1$@–%2$@ znaků: písmena, číslice a podtržítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles er %1$@–%2$@ tegn med bogstaver, tal og understregninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles bestehen aus %1$@–%2$@ Zeichen: Buchstaben, Ziffern und Unterstriche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα handle έχουν %1$@–%2$@ χαρακτήρες από γράμματα, αριθμούς και κάτω παύλες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles are %1$@–%2$@ characters of letters, numbers and underscores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los identificadores tienen de %1$@ a %2$@ caracteres, entre letras, números y guiones bajos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjätunnuksessa on %1$@–%2$@ merkkiä: kirjaimia, numeroita ja alaviivoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants font %1$@ à %2$@ caractères : lettres, chiffres et tirets bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם משתמש הוא %1$@–%2$@ תווים של אותיות, ספרות וקווים תחתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हैंडल में %1$@–%2$@ अक्षर होते हैं: अक्षर, संख्याएँ और अंडरस्कोर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle ima %1$@–%2$@ znakova: slova, brojeva i podcrta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az @név %1$@–%2$@ karakter lehet: betűk, számok és aláhúzás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle terdiri dari %1$@–%2$@ karakter berupa huruf, angka, dan garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli handle sono lunghi da %1$@ a %2$@ caratteri tra lettere, numeri e trattini bassi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルは英字、数字、アンダースコアで%1$@〜%2$@文字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들은 영문자, 숫자, 밑줄로 이루어진 %1$@–%2$@자예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹാൻഡിലുകൾ %1$@–%2$@ അക്ഷരങ്ങൾ, അക്കങ്ങൾ, അണ്ടർസ്കോറുകൾ ചേർന്നതാണ്."
