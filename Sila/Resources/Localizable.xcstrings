            "value": "La comprovació facial no s'ha fet bé. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola obličeje neproběhla čistě. Zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansigtstjekket kom ikke rent igennem. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesichtsprüfung war nicht sauber. Versuche es noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο έλεγχος προσώπου δεν ολοκληρώθηκε καθαρά. Δοκίμασέ τον ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The face check didn't come through cleanly. Try it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación facial no salió bien. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvotarkistus ei mennyt puhtaasti läpi. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle du visage ne s’est pas bien passé. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת הפנים לא עברה כראוי. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेहरे की जाँच साफ़ तरीके से नहीं हो पाई। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjera lica nije čisto prošla. Pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az arcellenőrzés nem sikerült tisztán. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan wajah tidak terbaca dengan jelas. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo del volto non è arrivato in modo pulito. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の確認がうまく完了しませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴 확인이 제대로 처리되지 않았어요. 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഖ പരിശോധന വൃത്തിയായി നടന്നില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan wajah tidak sampai dengan bersih. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansiktskontrollen kom ikke ordentlig gjennom. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gezichtscontrole is niet goed doorgekomen. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola twarzy nie powiodła się poprawnie. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação do rosto não saiu limpa. Tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação facial não correu bem. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificarea feței nu a ieșit curat. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка лица прошла не чисто. Попробуйте ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola tváre neprebehla čisto. Skús ju znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansiktskontrollen gick inte igenom rent. Försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகச் சோதனை தெளிவாக வரவில்லை. மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముఖ తనిఖీ స్పష్టంగా రాలేదు. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจใบหน้าไม่ชัดเจน ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz kontrolü düzgün tamamlanmadı. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка обличчя пройшла не чисто. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چہرے کی جانچ صاف طور پر نہیں آئی۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước kiểm tra khuôn mặt chưa rõ ràng. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸检查没有顺利完成，请重试。"
          }
        },
        "zh-Hant": {
