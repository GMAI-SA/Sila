    },
    "safety.report.intro": {
      "comment": "The line at the top of the reason picker. Says a human reads every report and that the choice decides who reads it first.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأقرب. كل بلاغ يراجعه إنسان، وما تختاره يحدد من يقرؤه أولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the closest match. A human reviews every report, and what you choose decides who reads it first."
          }
        }
      }
    },
    "safety.report.isSilent": {
      "comment": "Said next to the submit button, every time.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإبلاغ سري. ولا يُعرض على الحساب الذي تبلّغ عنه من أبلغ عنه أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporting is confidential. The account you report is never shown who reported them."
          }
        }
      }
    },
    "safety.report.nav.report": {
      "comment": "Navigation title on the report sheet.",
      "extractionState": "manual",
      "localizations": {
