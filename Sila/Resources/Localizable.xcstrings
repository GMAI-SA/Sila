        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit tehetsz a kezességeddel, és hogyan hitelesíts"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang bisa kamu lakukan dengan jaminanmu, dan cara memverifikasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti permette la tua garanzia e come verificarti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証でできること、認証の方法"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증으로 할 수 있는 일과 인증 방법"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വൗച്ച് ഉപയോഗിച്ച് എന്തെല്ലാം ചെയ്യാം, എങ്ങനെ വെരിഫൈ ചെയ്യാം"
