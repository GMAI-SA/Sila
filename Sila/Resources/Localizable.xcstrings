      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض «بلدي» منشورات مواطنيك الموثّقين. علم بلدك يأتي من هويتك الموثّقة — لا من عنوان الإنترنت الخاص بك أبدًا — لذلك يظهر بعد اكتمال التوثيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Country shows posts from your verified compatriots. Your country flag comes from your verified identity — never from your IP address — so it appears once verification completes."
