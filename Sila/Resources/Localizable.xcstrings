        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐഡന്റിറ്റി വെരിഫൈ ചെയ്തിട്ടില്ല · %2$@ മുതൽ @%1$@ വൗച്ച് ചെയ്യുന്നു"
