        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع کرائی گئی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交"
          }
        }
      }
    },
    "safety.appeal.status.upheld": {
      "comment": "Appeal status: accepted, and the suspension is being lifted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُبل — ويجري رفع الإيقاف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গৃহীত — স্থগিতাদেশ তোলা হচ্ছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptada: s'aixeca la suspensió"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uznáno – pozastavení se ruší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Imødekommet – suspensionen ophæves"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattgegeben – die Sperre wird aufgehoben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έγινε δεκτή — η αναστολή αίρεται"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upheld — the suspension is being lifted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptada: se levanta la suspensión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksytty – jäädytys puretaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepté — la suspension est levée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקבל — ההשעיה מוסרת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूर — निलंबन हटाया जा रहा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihvaćena — suspenzija se ukida"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogadva – a felfüggesztés megszűnik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterima — penangguhan sedang dicabut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accolto: la sospensione viene revocata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認められました。停止を解除しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아들여짐 — 정지가 해제되는 중이에요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അംഗീകരിച്ചു — സസ്പെൻഷൻ നീക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterima — penggantungan sedang ditarik balik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatt til følge. Suspensjonen oppheves"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegrond: de schorsing wordt opgeheven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględnione — zawieszenie jest znoszone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceita: a suspensão está sendo retirada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceite — a suspensão vai ser levantada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Admisă — suspendarea este ridicată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удовлетворена — блокировка снимается"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uznané — pozastavenie sa ruší"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifallet – avstängningen hävs"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கப்பட்டது — இடைநிறுத்தம் நீக்கப்படுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆమోదించబడింది — సస్పెన్షన్ ఎత్తివేయబడుతోంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้รับการยอมรับ กำลังยกเลิกการระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul edildi; askıya alma kaldırılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задоволено — призупинення знімається"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منظور — معطلی ہٹائی جا رہی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được chấp nhận — việc đình chỉ đang được gỡ bỏ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持，封禁正在解除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "申訴成立，正在解除停權"
          }
        }
      }
    },
    "safety.appeal.submitted": {
      "comment": "Confirmation once an appeal is on file. States that a second would not be read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظلّمك لدى أحد المراجعين. ولا شيء آخر لترسله — يقبل معروف تظلّمًا واحدًا لكل إيقاف، والثاني لن يُقرأ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আপিল একজন রিভিউয়ারের কাছে আছে। আর কিছু পাঠানোর নেই — Known প্রতি স্থগিতাদেশে একটিই আপিল নেয়, আর দ্বিতীয়টি পড়া হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva apel·lació és amb un revisor. No cal enviar res més: Known només accepta una apel·lació per suspensió, i una segona no es llegiria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé odvolání je u posuzovatele. Nic dalšího odesílat nemusíš – Known přijímá jedno odvolání na pozastavení a druhé by se nečetlo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din anke ligger hos en gennemgående. Der er intet andet at sende – Known accepterer kun én anke pr. suspension, og en anden ville ikke blive læst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Einspruch liegt bei einem Prüfer. Du musst nichts weiter senden – Known akzeptiert nur einen Einspruch pro Sperre, und ein zweiter würde nicht gelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ένστασή σου βρίσκεται σε ελεγκτή. Δεν χρειάζεται να στείλεις κάτι άλλο — το Known δέχεται μία ένσταση ανά αναστολή και μια δεύτερη δεν θα διαβαστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is with a reviewer. There is nothing else to send — one appeal per suspension is all Known accepts, and a second would not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apelación está con un revisor. No hay nada más que enviar: Known solo acepta una apelación por suspensión y una segunda no se leería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valituksesi on tarkastajalla. Muuta lähetettävää ei ole – Known hyväksyy vain yhden valituksen jäädytystä kohden, eikä toista luettaisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre recours est chez un vérificateur. Il n’y a rien d’autre à envoyer — Known n’accepte qu’un recours par suspension, et un second ne serait pas lu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערעור שלך אצל בודק. אין מה לשלוח עוד — ערעור אחד לכל השעיה הוא כל מה ש-Known מקבלת, והשני לא ייקרא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपील एक समीक्षक के पास है। और कुछ भेजने की ज़रूरत नहीं — Known हर निलंबन पर सिर्फ़ एक अपील स्वीकार करता है, और दूसरी पढ़ी नहीं जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja žalba je kod recenzenta. Nema što više slati — Known prihvaća jednu žalbu po suspenziji, a druga ne bi bila pročitana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fellebbezésed egy elbírálónál van. Más küldenivalód nincs – a Known felfüggesztésenként egy fellebbezést fogad el, a másodikat nem olvassuk el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingmu ada di tangan peninjau. Tidak ada lagi yang perlu dikirim — Known hanya menerima satu banding per penangguhan, dan yang kedua tidak akan dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ricorso è da un revisore. Non c'è altro da inviare: Known accetta un solo ricorso per sospensione, e un secondo non verrebbe letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異議申し立ては審査担当者に届いています。ほかに送るものはありません。Knownが受け付ける異議は停止1回につき1回で、2回目は読まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이의 신청이 검토자에게 전달되었어요. 더 보낼 것은 없어요. Known은 정지 1건당 이의 신청을 한 번만 받으며, 두 번째는 읽지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അപ്പീൽ ഒരു പരിശോധകന്റെ പക്കലുണ്ട്. ഇനി അയയ്ക്കാൻ ഒന്നുമില്ല — ഒരു സസ്പെൻഷന് ഒരു അപ്പീൽ മാത്രമേ Known സ്വീകരിക്കൂ, രണ്ടാമത്തേത് വായിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rayuan anda berada bersama penyemak. Tiada apa-apa lagi untuk dihantar — satu rayuan bagi setiap penggantungan sahaja yang diterima Known, dan yang kedua tidak akan dibaca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anken din er hos en vurderer. Det er ikke noe mer å sende. Known godtar bare én anke per suspensjon, og en andre ville ikke blitt lest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bezwaar ligt bij een beoordelaar. Er is niets meer te versturen: Known accepteert één bezwaar per schorsing, en een tweede zou niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odwołanie jest u recenzenta. Nie ma nic więcej do wysłania — Known przyjmuje jedno odwołanie na zawieszenie, a drugie nie zostałoby przeczytane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contestação está com um analista. Não há mais nada a enviar: o Known aceita uma contestação por suspensão, e uma segunda não seria lida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua contestação está com um revisor. Não há mais nada a enviar — a Known só aceita uma contestação por suspensão, e uma segunda não seria lida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contestația ta este la un evaluator. Nu mai ai nimic de trimis — Known acceptă o singură contestație per suspendare, iar a doua nu ar fi citită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша апелляция у проверяющего. Больше ничего отправлять не нужно — Known принимает одну апелляцию на блокировку, а вторую не прочтут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje odvolanie má posudzovateľ. Nie je čo ďalej posielať — Known prijíma jedno odvolanie na pozastavenie a druhé by sa neprečítalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt överklagande ligger hos en granskare. Det finns inget mer att skicka – ett överklagande per avstängning är allt Known tar emot, och ett andra skulle inte läsas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மேல்முறையீடு மதிப்பாய்வாளரிடம் உள்ளது. அனுப்ப வேறு எதுவும் இல்லை — ஒரு இடைநிறுத்தத்துக்கு ஒரு மேல்முறையீட்டை மட்டுமே Known ஏற்கும், இரண்டாவது படிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అప్పీల్ సమీక్షకుడి వద్ద ఉంది. పంపడానికి ఇంకేమీ లేదు — Known ప్రతి సస్పెన్షన్‌కు ఒక అప్పీల్‌ను మాత్రమే అంగీకరిస్తుంది, రెండోది చదవబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอุทธรณ์ของคุณอยู่กับผู้ตรวจสอบ ไม่ต้องส่งอะไรเพิ่ม Known รับอุทธรณ์ได้เพียงหนึ่งครั้งต่อการระงับ และครั้งที่สองจะไม่ถูกอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtirazınız bir inceleyicide. Gönderilecek başka bir şey yok; Known askıya alma başına yalnızca bir itirazı kabul eder ve ikincisi okunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша апеляція в перевіряльника. Більше нічого надсилати не потрібно — Known приймає одну апеляцію на призупинення, а другу не буде прочитано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپیل جائزہ لینے والے کے پاس ہے۔ مزید بھیجنے کو کچھ نہیں — Known ہر معطلی پر صرف ایک اپیل قبول کرتا ہے، اور دوسری پڑھی نہیں جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khiếu nại của bạn đang ở chỗ người xét duyệt. Không cần gửi thêm gì — Known chỉ chấp nhận một khiếu nại cho mỗi lần đình chỉ, và khiếu nại thứ hai sẽ không được đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的申诉已交给审核员。无需再发送任何内容，Known 每次封禁只接受一次申诉，第二次不会被阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的申訴已交給審核人員。沒有其他需要送出的了，Known 每次停權只接受一次申訴，第二次不會被閱讀。"
          }
        }
      }
    },
    "safety.appeal.toast.alreadyOnFile": {
      "comment": "Toast when an appeal was already on file. Not a failure — it is the answer to the question.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبق أن قدّمت تظلّمًا. وما زال قائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে আপিল করেছিলেন। সেটিই বহাল আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja havies apel·lat. Aquella continua vigent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už ses odvolal. To odvolání stále platí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du havde allerede anket. Den gælder stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hattest bereits Einspruch eingelegt. Dieser gilt weiterhin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είχες ήδη υποβάλει ένσταση. Εκείνη ισχύει ακόμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You had already appealed. That one still stands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya habías apelado. Esa sigue vigente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olit jo valittanut. Se valitus on yhä voimassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous aviez déjà fait un recours. Celui-ci reste valable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר ערערת. הערעור ההוא עומד בעינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले ही अपील कर चुके थे। वही कायम है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već si se žalio/la. Ta žalba još stoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már fellebbeztél. Az marad érvényben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah pernah mengajukan banding. Yang itu masih berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avevi già fatto ricorso. Quello resta valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに異議を申し立てています。そちらが有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이의를 신청했어요. 그 신청이 그대로 유지돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം അപ്പീൽ നൽകിയിട്ടുണ്ട്. ആ അപ്പീൽ നിലനിൽക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah merayu. Rayuan itu masih terpakai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hadde allerede anket. Den gjelder fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je had al bezwaar gemaakt. Dat bezwaar blijft staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już się odwołałeś. To odwołanie nadal obowiązuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tinha contestado. Aquela continua valendo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já tinha contestado. Essa continua válida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai contestat deja. Aceea rămâne în vigoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже подавали апелляцию. Она остаётся в силе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už si sa odvolal. To odvolanie stále platí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hade redan överklagat. Det gäller fortfarande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கெனவே மேல்முறையீடு செய்துவிட்டீர்கள். அதுவே நிலைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే అప్పీల్ చేశారు. అదే చెల్లుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอุทธรณ์ไปแล้ว คำอุทธรณ์นั้นยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten itiraz etmiştiniz. O itiraz geçerli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже подавали апеляцію. Та апеляція залишається в силі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ پہلے ہی اپیل کر چکے تھے۔ وہی برقرار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã khiếu nại rồi. Khiếu nại đó vẫn còn hiệu lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经申诉过了，那一次仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經申訴過了，之前那次仍然有效。"
          }
        }
      }
    },
    "safety.appeal.toast.sent": {
      "comment": "Toast after an appeal is filed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل تظلّمك. سيقرؤه إنسان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আপিল জমা হয়েছে। একজন মানুষ এটি পড়বেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva apel·lació s'ha enviat. Una persona la llegirà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé odvolání je odesláno. Přečte si ho člověk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din anke er indsendt. Et menneske læser den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Einspruch ist eingegangen. Ein Mensch wird ihn lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ένστασή σου καταχωρίστηκε. Θα τη διαβάσει άνθρωπος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is in. A human will read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apelación está enviada. La leerá una persona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valituksesi on perillä. Ihminen lukee sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre recours est enregistré. Une personne le lira."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערעור שלך התקבל. אדם יקרא אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपील आ गई है। एक इंसान उसे पढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja žalba je poslana. Čitat će je čovjek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fellebbezésed beérkezett. Ember fogja elolvasni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingmu masuk. Seorang manusia akan membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ricorso è arrivato. Lo leggerà una persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異議申し立てを受け付けました。人が読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이의 신청이 접수되었어요. 사람이 읽을 거예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അപ്പീൽ ലഭിച്ചു. ഒരു മനുഷ്യൻ വായിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rayuan anda telah dihantar. Seorang manusia akan membacanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anken din er inne. Et menneske leser den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bezwaar is binnen. Een mens leest het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odwołanie wpłynęło. Przeczyta je człowiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contestação foi enviada. Uma pessoa vai lê-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua contestação foi recebida. Uma pessoa vai lê-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contestația ta a fost trimisă. O va citi un om."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Апелляция принята. Её прочтёт человек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje odvolanie je doručené. Prečíta ho človek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt överklagande är inskickat. En människa läser det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மேல்முறையீடு வந்துவிட்டது. ஒரு மனிதர் அதைப் படிப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అప్పీల్ అందింది. మనిషి దాన్ని చదువుతారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำอุทธรณ์ของคุณแล้ว จะมีคนอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtirazınız alındı. Bir insan okuyacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу апеляцію подано. Її прочитає людина."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپیل پہنچ گئی۔ ایک انسان اسے پڑھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khiếu nại của bạn đã được gửi. Một người thật sẽ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的申诉已提交，会有真人阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的申訴已送出，會有真人閱讀。"
          }
        }
      }
    },
