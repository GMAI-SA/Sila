        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir saniye kaydedin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть щонайменше секунду"
