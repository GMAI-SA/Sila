    "video.status.waiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار الاتصال. سيُستأنف الرفع تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগের অপেক্ষা। আপলোড নিজে থেকেই চলবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperant connexió. La pujada continuarà per si sola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká se na připojení. Nahrávání bude pokračovat samo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på forbindelse. Uploadet fortsætter af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf eine Verbindung. Der Upload geht von selbst weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή για σύνδεση. Η μεταφόρτωση θα συνεχιστεί μόνη της."
