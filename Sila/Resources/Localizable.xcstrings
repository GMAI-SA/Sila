            "value": "Показывает только непрочитанные уведомления"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí iba upozornenia, ktoré si neprečítal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar bara aviseringar du inte har läst"
