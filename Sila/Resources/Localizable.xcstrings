        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരോ നിങ്ങളുടെ ഉറപ്പ് സ്വീകരിച്ചു — അത് അവർ തന്നെയാണെന്ന് സ്ഥിരീകരിക്കുക"
