      }
    },
    "rooms.youCanSpeakNow": {
      "comment": "Shown to somebody invited onto the stage.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك التحدث الآن. افتح المايك متى ما كنت جاهزًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন আপনি কথা বলতে পারেন। প্রস্তুত হলে আনমিউট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja pots parlar. Activa el micròfon quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď můžeš mluvit. Zapni zvuk, až budeš připraven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tale nu. Slå lyden til, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jetzt sprechen. Hebe die Stummschaltung auf, wenn du bereit bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να μιλήσεις τώρα. Κάνε άρση σίγασης όταν είσαι έτοιμος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can speak now. Unmute when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes hablar. Activa el micrófono cuando estés listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt puhua. Poista mykistys, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez parler maintenant. Activez votre micro quand vous êtes prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה יכול לדבר עכשיו. בטל השתקה כשתהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप बोल सकते हैं। तैयार होने पर अनम्यूट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada možeš govoriti. Uključi zvuk kad budeš spreman/na."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most megszólalhatsz. Oldd fel a némítást, amikor készen állsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa berbicara sekarang. Bunyikan mikrofon saat siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi parlare. Riattiva l'audio quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発言できます。準備ができたらミュートを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 말할 수 있어요. 준비되면 음소거를 해제하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനി നിങ്ങൾക്ക് സംസാരിക്കാം. തയ്യാറാകുമ്പോൾ അൺമ്യൂട്ട് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh bercakap sekarang. Nyahsenyap apabila anda sudah bersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan snakke nå. Opphev demping når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu spreken. Hef het dempen op als je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz już mówić. Włącz dźwięk, gdy będziesz gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já pode falar. Ative o som quando quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já pode falar. Ative o som quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți vorbi acum. Activează microfonul când ești gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы можете говорить. Включите микрофон, когда будете готовы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz môžeš hovoriť. Zapni mikrofón, keď budeš pripravený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tala nu. Slå på ljudet när du är redo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது நீங்கள் பேசலாம். தயாரானதும் ஒலியை இயக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పుడు మాట్లాడవచ్చు. సిద్ధమైనప్పుడు అన్‌మ్యూట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณพูดได้แล้ว เปิดเสียงเมื่อพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık konuşabilirsiniz. Hazır olunca sesi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер ви можете говорити. Увімкніть мікрофон, коли будете готові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اب بول سکتے ہیں۔ تیار ہوں تو ان میوٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể phát biểu bây giờ. Hãy bật tiếng khi sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在可以发言了。准备好后取消静音即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在可以發言了。準備好時請取消靜音。"
          }
        }
      }
    },
    "rooms.youWereDemoted": {
      "comment": "Shown to somebody moved off the stage. Says they are still in the room.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدت إلى الاستماع. ما زلت في الغرفة، ولم تُخرج منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আবার শুনছেন। আপনি এখনও রুমে আছেন, আপনাকে সরানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornes a escoltar. Encara ets a la sala i no t'han expulsat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zase posloucháš. Stále jsi v místnosti a nebyl jsi odebrán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter igen. Du er stadig i rummet og blev ikke fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst wieder zu. Du bist weiterhin im Raum und wurdest nicht entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούς ξανά. Είσαι ακόμα στην αίθουσα και δεν αφαιρέθηκες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're listening again. You're still in the room, and you weren't removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelves a escuchar. Sigues en la sala y no te expulsaron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelet taas. Olet yhä huoneessa, eikä sinua poistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes de nouveau à l’écoute. Vous êtes toujours dans le salon, vous n’avez pas été retiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מאזין שוב. אתה עדיין בחדר, ולא הוסרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप फिर से सुन रहे हैं। आप अब भी रूम में हैं, आपको हटाया नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno slušaš. I dalje si u sobi i nisi uklonjen/a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra hallgatsz. Még a szobában vagy, és nem távolítottak el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mendengarkan lagi. Kamu masih di room, dan tidak dikeluarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei di nuovo in ascolto. Sei ancora nella stanza e non sei stato rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再び聴く側になりました。ルームには引き続きいます。削除されたわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 듣는 상태가 되었어요. 룸에는 그대로 있으며 내보내지지 않았어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ വീണ്ടും കേൾക്കുന്നവരിലാണ്. നിങ്ങൾ ഇപ്പോഴും റൂമിലുണ്ട്, നീക്കം ചെയ്തിട്ടില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mendengar semula. Anda masih dalam bilik, dan anda tidak dialih keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lytter igjen. Du er fortsatt i rommet og ble ikke fjernet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je luistert weer. Je zit nog in de room en bent niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znów słuchasz. Nadal jesteś w pokoju i nie zostałeś usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você voltou a ouvir. Continua na sala e não foi removido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltou a ouvir. Continua na sala e não foi removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asculți din nou. Ești încă în cameră și nu ai fost scos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы снова слушаете. Вы по-прежнему в комнате, вас не удаляли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opäť počúvaš. Stále si v miestnosti a nebol si odstránený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lyssnar igen. Du är kvar i rummet och blev inte borttagen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் மீண்டும் கேட்கிறீர்கள். நீங்கள் இன்னும் அறையில் உள்ளீர்கள், நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మళ్లీ వింటున్నారు. మీరు ఇంకా రూమ్‌లోనే ఉన్నారు, మిమ్మల్ని తొలగించలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกลับมาฟังอีกครั้ง คุณยังอยู่ในห้อง และไม่ได้ถูกนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden dinliyorsunuz. Hâlâ odadasınız ve çıkarılmadınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви знову слухаєте. Ви все ще в кімнаті, вас не вилучали."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ پھر سن رہے ہیں۔ آپ اب بھی روم میں ہیں، اور آپ کو ہٹایا نہیں گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn lại đang nghe. Bạn vẫn ở trong phòng và không bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你重新回到收听状态。你仍在房间里，并未被移出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你回到收聽狀態。你仍在聊天室中，沒有被移除。"
          }
        }
      }
    },
    "rooms.youWereMuted": {
      "comment": "Toast to a muted speaker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتم المضيف ميكروفونك. ما زلت على المنصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোস্ট আপনার মাইক্রোফোন মিউট করেছেন। আপনি এখনও মঞ্চে আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'amfitrió ha silenciat el teu micròfon. Encara ets a l'escenari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostitel ztlumil tvůj mikrofon. Stále jsi na pódiu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værten gjorde din mikrofon lydløs. Du er stadig på scenen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host hat dein Mikrofon stummgeschaltet. Du bist weiterhin auf der Bühne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο οικοδεσπότης έβαλε το μικρόφωνό σου σε σίγαση. Είσαι ακόμα στη σκηνή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host muted your microphone. You're still on the stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anfitrión silenció tu micrófono. Sigues en el escenario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Isäntä mykisti mikrofonisi. Olet yhä lavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’animateur a coupé votre micro. Vous êtes toujours sur la scène."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המארח השתיק את המיקרופון שלך. אתה עדיין על הבמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्ट ने आपका माइक्रोफ़ोन म्यूट कर दिया। आप अब भी स्टेज पर हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Domaćin ti je utišao mikrofon. I dalje si na pozornici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A házigazda elnémította a mikrofonodat. Még a színpadon vagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host membisukan mikrofonmu. Kamu masih di panggung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'host ha silenziato il tuo microfono. Sei ancora sul palco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストがあなたのマイクをミュートしました。ステージにはそのままいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트가 내 마이크를 음소거했어요. 아직 무대에 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹോസ്റ്റ് നിങ്ങളുടെ മൈക്രോഫോൺ മ്യൂട്ട് ചെയ്തു. നിങ്ങൾ ഇപ്പോഴും സ്റ്റേജിലാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hos menyenyapkan mikrofon anda. Anda masih di pentas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verten dempet mikrofonen din. Du er fortsatt på scenen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De host heeft je microfoon gedempt. Je staat nog op het podium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gospodarz wyciszył Twój mikrofon. Nadal jesteś na scenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anfitrião silenciou seu microfone. Você continua no palco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anfitrião silenciou o seu microfone. Continua no palco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gazda ți-a dezactivat microfonul. Ești încă pe scenă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведущий выключил ваш микрофон. Вы по-прежнему на сцене."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostiteľ ti stlmil mikrofón. Stále si na pódiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värden tystade din mikrofon. Du är kvar på scenen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடத்துநர் உங்கள் மைக்ரோஃபோனை ஒலியடக்கினார். நீங்கள் இன்னும் மேடையில் உள்ளீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోస్ట్ మీ మైక్రోఫోన్‌ను మ్యూట్ చేశారు. మీరు ఇంకా వేదికపైనే ఉన్నారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจ้าของห้องปิดไมโครโฟนของคุณ คุณยังอยู่บนเวที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu mikrofonunuzun sesini kapattı. Hâlâ sahnedesiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведучий вимкнув ваш мікрофон. Ви все ще на сцені."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میزبان نے آپ کا مائیکروفون میوٹ کر دیا۔ آپ اب بھی اسٹیج پر ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ phòng đã tắt micro của bạn. Bạn vẫn ở trên sân khấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人将你的麦克风静音了。你仍在台上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主持人已將你的麥克風靜音。你仍在台上。"
          }
        }
      }
    },
