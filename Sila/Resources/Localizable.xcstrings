    "profile.unavailable.subtitle": {
      "comment": "The 404 dead end. %@ is the handle with its at sign, or the fallback phrase.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا يعود إلى حساب نشط في «معروف». ربما حُذف الحساب أو تغيّر المعرّف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ কোনো সক্রিয় Known অ্যাকাউন্টের নয়। এটি মুছে যেতে পারে, অথবা হ্যান্ডেল বদলে থাকতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no pertany a cap compte actiu de Known. Pot haver-se eliminat, o l'identificador pot haver canviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nepatří aktivnímu účtu Known. Mohl být smazán, nebo se handle změnil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hører ikke til en aktiv Known-konto. Den er måske blevet slettet, eller handlet kan være ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört zu keinem aktiven Known-Konto. Es wurde möglicherweise gelöscht, oder das Handle hat sich geändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν ανήκει σε ενεργό λογαριασμό Known. Μπορεί να έχει διαγραφεί ή να έχει αλλάξει το handle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't belong to an active Known account. It may have been deleted, or the handle may have changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no pertenece a una cuenta activa de Known. Puede que se haya eliminado o que el identificador haya cambiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei kuulu aktiiviselle Known-tilille. Se on voitu poistaa, tai käyttäjätunnus on voinut vaihtua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’appartient à aucun compte Known actif. Il a peut-être été supprimé, ou l’identifiant a peut-être changé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא שייך לחשבון Known פעיל. ייתכן שנמחק, או ששם המשתמש השתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ किसी सक्रिय Known अकाउंट का नहीं है। हो सकता है वह हटा दिया गया हो, या हैंडल बदल गया हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne pripada aktivnom Known računu. Možda je izbrisan ili je handle promijenjen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem tartozik aktív Known-fiókhoz. Lehet, hogy törölték, vagy az @név megváltozott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bukan milik akun Known yang aktif. Mungkin sudah dihapus, atau handle-nya sudah berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non appartiene a un account Known attivo. Potrebbe essere stato eliminato, o l'handle potrebbe essere cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は有効なKnownアカウントではありません。削除されたか、ハンドルが変更された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 활성 Known 계정에 속해 있지 않아요. 삭제되었거나 핸들이 변경되었을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഒരു സജീവ Known അക്കൗണ്ടിന്റേതല്ല. അത് ഇല്ലാതാക്കിയിരിക്കാം, അല്ലെങ്കിൽ ഹാൻഡിൽ മാറിയിരിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bukan milik akaun Known yang aktif. Ia mungkin telah dipadam, atau nama pengendalinya mungkin telah berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tilhører ikke en aktiv Known-konto. Den kan ha blitt slettet, eller brukernavnet kan ha endret seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hoort niet bij een actief Known-account. Het is mogelijk verwijderd, of de handle is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie należy do aktywnego konta Known. Mogło zostać usunięte albo uchwyt mógł się zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pertence a uma conta ativa do Known. Ela pode ter sido excluída, ou o @usuário pode ter mudado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pertence a uma conta Known ativa. Pode ter sido eliminada, ou o identificador pode ter mudado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu aparține unui cont Known activ. Poate a fost șters sau handle-ul s-a schimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не принадлежит активному аккаунту Known. Возможно, аккаунт удалён или имя изменилось."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nepatrí aktívnemu účtu Known. Možno bol odstránený alebo sa zmenilo používateľské meno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillhör inget aktivt Known-konto. Det kan ha raderats, eller så kan användarnamnet ha ändrats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ செயலில் உள்ள Known கணக்குக்குச் சொந்தமானது அல்ல. அது நீக்கப்பட்டிருக்கலாம் அல்லது ஹேண்டில் மாறியிருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ క్రియాశీల Known ఖాతాకు చెందినది కాదు. అది తొలగించబడి ఉండవచ్చు, లేదా హ్యాండిల్ మారి ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ใช่บัญชี Known ที่ใช้งานอยู่ อาจถูกลบแล้ว หรือแฮนเดิลอาจเปลี่ยนไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ etkin bir Known hesabına ait değil. Silinmiş olabilir veya kullanıcı adı değişmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не належить активному обліковому запису Known. Його могли видалити, або @ім’я могло змінитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کسی فعال Known اکاؤنٹ کا نہیں ہے۔ ہو سکتا ہے اسے حذف کر دیا گیا ہو، یا ہینڈل بدل گیا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không thuộc về tài khoản Known nào đang hoạt động. Có thể nó đã bị xóa, hoặc tên người dùng đã thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不属于任何活跃的 Known 账户。它可能已被删除，或者用户名已更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不屬於任何使用中的 Known 帳號。可能已被刪除，或代號已變更。"
          }
        }
      }
    },
