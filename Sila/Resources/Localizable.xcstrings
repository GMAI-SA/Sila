    "profile.requests.accept.hint": {
      "comment": "VoiceOver hint on Accept. %@ is the name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لـ %@ بمتابعتك ورؤية منشوراتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে আপনাকে ফলো করতে ও আপনার পোস্ট দেখতে দেয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que %@ et segueixi i vegi les teves publicacions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolí uživateli %@ tě sledovat a vidět tvé příspěvky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader %@ følge dig og se dine opslag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt %@, dir zu folgen und deine Beiträge zu sehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στον/στην %@ να σε ακολουθεί και να βλέπει τις αναρτήσεις σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets %@ follow you and see your posts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %@ te siga y vea tus publicaciones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa käyttäjän %@ seurata sinua ja nähdä julkaisusi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à %@ de vous suivre et de voir vos posts"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר ל-%@ לעקוב אחריך ולראות את הפוסטים שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को आपको फ़ॉलो करने और आपकी पोस्ट देखने देता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopušta korisniku %@ da te prati i vidi tvoje objave"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedi, hogy %@ kövessen, és lássa a bejegyzéseidet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan %@ mengikutimu dan melihat postinganmu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette a %@ di seguirti e vedere i tuoi post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@があなたをフォローし、投稿を見られるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 나를 팔로우하고 내 게시물을 볼 수 있게 해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നയാളെ നിങ്ങളെ ഫോളോ ചെയ്യാനും നിങ്ങളുടെ പോസ്റ്റുകൾ കാണാനും അനുവദിക്കുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan %@ mengikut anda dan melihat siaran anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar %@ følge deg og se innleggene dine"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat %@ je volgen en je berichten zien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala: %@ obserwować Cię i widzieć Twoje wpisy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %@ siga você e veja seus posts"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %@ o siga e veja as suas publicações"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îl lasă pe %@ să te urmărească și să-ți vadă postările"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет %@ подписаться на вас и видеть ваши посты"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní používateľovi %@ sledovať ťa a vidieť tvoje príspevky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter %@ följa dig och se dina inlägg"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உங்களைப் பின்தொடரவும் உங்கள் இடுகைகளைப் பார்க்கவும் அனுமதிக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మిమ్మల్ని ఫాలో అవ్వడానికి, మీ పోస్ట్‌లను చూడటానికి అనుమతిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ %@ ติดตามคุณและเห็นโพสต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin sizi takip etmesine ve gönderilerinizi görmesine izin verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє %@ підписатися на вас і бачити ваші дописи"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو آپ کو فالو کرنے اور آپ کی پوسٹس دیکھنے دیتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép %@ theo dõi bạn và xem bài đăng của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %@ 关注你并查看你的帖子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 %@ 追蹤你並看到你的貼文"
          }
        }
      }
    },
