    "error.phoneIsSignIn": {
      "comment": "409 phone_is_sign_in (contract v26): the number is how this account signs in, so it cannot be replaced or cleared while the account has no other way in.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو الرقم الذي تسجّل الدخول به، فلا يمكن تغييره أو حذفه حتى يكون لحسابك بريد إلكتروني وكلمة مرور أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নম্বর দিয়ে আপনি সাইন ইন করেন, তাই আপনার অ্যাকাউন্টে ইমেইল ঠিকানা ও পাসওয়ার্ডও না থাকা পর্যন্ত এটি বদলানো বা সরানো যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest és el número amb el qual inicies la sessió, així que no es pot canviar ni eliminar fins que el teu compte també tingui una adreça electrònica i una contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je číslo, kterým se přihlašuješ, takže ho nelze změnit ani odebrat, dokud tvůj účet nemá také e-mailovou adresu a heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er det nummer, du logger ind med, så det kan ikke ændres eller fjernes, før din konto også har en e-mailadresse og en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Nummer, mit der du dich anmeldest, daher lässt sie sich nicht ändern oder entfernen, bis dein Konto auch eine E-Mail-Adresse und ein Passwort hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός είναι ο αριθμός με τον οποίο συνδέεσαι, οπότε δεν μπορεί να αλλάξει ή να αφαιρεθεί μέχρι ο λογαριασμός σου να έχει και διεύθυνση email και κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the number you sign in with, so it can't be changed or removed until your account also has an email address and a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el número con el que inicias sesión, así que no se puede cambiar ni quitar hasta que tu cuenta tenga también un correo y una contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on numero, jolla kirjaudut, joten sitä ei voi vaihtaa tai poistaa, ennen kuin tililläsi on myös sähköpostiosoite ja salasana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le numéro avec lequel vous vous connectez : il ne peut être ni modifié ni supprimé tant que votre compte n’a pas aussi une adresse e-mail et un mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה המספר שאיתו אתה מתחבר, ולכן אי אפשר לשנות או להסיר אותו עד שלחשבון שלך יהיו גם כתובת דוא״ל וסיסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही वह नंबर है जिससे आप साइन इन करते हैं, इसलिए इसे तब तक बदला या हटाया नहीं जा सकता जब तक आपके अकाउंट में ईमेल पता और पासवर्ड भी न हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je broj kojim se prijavljuješ pa se ne može promijeniti ni ukloniti dok tvoj račun nema i adresu e-pošte i lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel a számmal jelentkezel be, ezért nem módosítható és nem törölhető, amíg a fiókodhoz nem tartozik e-mail-cím és jelszó is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini nomor yang kamu pakai untuk masuk, jadi tidak bisa diubah atau dihapus sampai akunmu juga punya alamat email dan kata sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il numero con cui accedi, quindi non può essere cambiato o rimosso finché il tuo account non ha anche un indirizzo email e una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号はサインインに使われているため、アカウントにメールアドレスとパスワードが設定されるまで、変更も削除もできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에 사용하는 번호라서 계정에 이메일 주소와 비밀번호가 생길 때까지 변경하거나 삭제할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങൾ സൈൻ ഇൻ ചെയ്യാൻ ഉപയോഗിക്കുന്ന നമ്പറാണ്, അതിനാൽ നിങ്ങളുടെ അക്കൗണ്ടിന് ഒരു ഇമെയിൽ വിലാസവും പാസ്‌വേഡും കൂടി ഉണ്ടാകുന്നതുവരെ ഇത് മാറ്റാനോ നീക്കം ചെയ്യാനോ കഴിയില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini nombor yang anda gunakan untuk log masuk, jadi ia tidak boleh ditukar atau dialih keluar sehingga akaun anda turut mempunyai alamat emel dan kata laluan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er nummeret du logger inn med, så det kan ikke endres eller fjernes før kontoen din også har en e-postadresse og et passord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het nummer waarmee je inlogt, dus het kan niet worden gewijzigd of verwijderd totdat je account ook een e-mailadres en wachtwoord heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To numer, którym się logujesz, więc nie można go zmienić ani usunąć, dopóki konto nie będzie mieć także adresu e-mail i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o número com que você entra, então ele não pode ser alterado nem removido até que sua conta tenha também um e-mail e uma senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o número com que inicia sessão, por isso não pode ser alterado nem removido até a sua conta ter também um endereço de email e uma palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este numărul cu care te autentifici, deci nu poate fi schimbat sau șters până când contul nu are și o adresă de e-mail și o parolă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этим номером вы входите в аккаунт, поэтому его нельзя изменить или удалить, пока у аккаунта нет также адреса почты и пароля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je číslo, ktorým sa prihlasuješ, takže sa nedá zmeniť ani odstrániť, kým tvoj účet nemá aj e-mailovú adresu a heslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är numret du loggar in med, så det kan inte ändras eller tas bort förrän ditt konto också har en e-postadress och ett lösenord."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நீங்கள் உள்நுழையும் எண், எனவே உங்கள் கணக்கில் மின்னஞ்சல் முகவரியும் கடவுச்சொல்லும் வரும் வரை இதை மாற்றவோ அகற்றவோ முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సైన్ ఇన్ చేసే నంబర్ ఇది, కాబట్టి మీ ఖాతాకు ఈమెయిల్ చిరునామా, పాస్‌వర్డ్ కూడా వచ్చే వరకు దీన్ని మార్చలేరు లేదా తొలగించలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือหมายเลขที่คุณใช้ลงชื่อเข้าใช้ จึงเปลี่ยนหรือลบไม่ได้จนกว่าบัญชีของคุณจะมีที่อยู่อีเมลและรหัสผ่านด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, giriş yaptığınız numara; hesabınıza bir e-posta adresi ve şifre de eklenene kadar değiştirilemez veya kaldırılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це номер, за яким ви входите, тому його не можна змінити чи видалити, доки до вашого облікового запису не буде додано адресу пошти та пароль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ وہ نمبر ہے جس سے آپ سائن اِن کرتے ہیں، اس لیے جب تک آپ کے اکاؤنٹ میں ای میل پتا اور پاس ورڈ بھی نہ ہوں اسے بدلا یا ہٹایا نہیں جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là số bạn dùng để đăng nhập, nên không thể đổi hoặc xóa cho đến khi tài khoản của bạn cũng có địa chỉ email và mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你用来登录的号码，在你的账户同时有邮箱和密码之前，无法更改或移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你登入用的號碼，在你的帳號同時有電子郵件和密碼之前，無法變更或移除。"
          }
        }
      }
    },
