              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Required for this reason. Up to %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Required for this reason. Up to %lld characters."
                }
              }
            }
          }
        }
      }
    },
