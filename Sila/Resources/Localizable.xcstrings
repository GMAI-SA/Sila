    "account.phone.save.hint": {
      "comment": "VoiceOver hint for saving the number. Repeats that it is not verified.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ هذا الرقم كوسيلة تواصل. وهو غير موثّق."
