    "communities.requested.toast": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طُلب الانضمام. سيقرّر أحد المشرفين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ দেওয়ার অনুরোধ করা হয়েছে। একজন অ্যাডমিন সিদ্ধান্ত নেবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has demanat unir-t'hi. Un administrador decidirà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádost o připojení odeslána. Správce rozhodne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodning sendt. En admin afgør det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitritt angefragt. Ein Admin entscheidet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζήτησες να συμμετάσχεις. Ένας διαχειριστής θα αποφασίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked to join. An admin will decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud enviada. Un administrador decidirá."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittymispyyntö lähetetty. Ylläpitäjä päättää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande envoyée. Un admin décidera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה להצטרף נשלחה. מנהל יחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जुड़ने का अनुरोध भेजा गया। एडमिन तय करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatražio/la si pridruživanje. Administrator će odlučiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozási kérés elküldve. Egy adminisztrátor dönt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan bergabung dikirim. Admin akan memutuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta inviata. Deciderà un admin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加を申請しました。管理者が判断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입을 요청했어요. 관리자가 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചേരാൻ അഭ്യർഥിച്ചു. ഒരു അഡ്മിൻ തീരുമാനിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permohonan menyertai dihantar. Admin akan memutuskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har bedt om å bli med. En admin avgjør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang gevraagd. Een beheerder beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano prośbę o dołączenie. Zdecyduje administrator."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido enviado. Um administrador vai decidir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido de adesão enviado. Um administrador vai decidir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cerut să te alături. Un administrator va decide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявка отправлена. Решение примет администратор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosť o pripojenie odoslaná. Správca rozhodne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfrågan skickad. En admin avgör."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேரக் கேட்டுள்ளீர்கள். நிர்வாகி முடிவு செய்வார்."
