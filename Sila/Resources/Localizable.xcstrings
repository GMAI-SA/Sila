    "guest.join.post.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صوت هنا شخص حقيقي — موثّق، أو مُزكّى من موثّق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানকার প্রতিটি কণ্ঠ একজন আসল মানুষের — ভেরিফায়েড, বা কোনো ভেরিফায়েড মানুষের সুপারিশে আসা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada veu d'aquí és una persona real: verificada, o avalada per una que ho és."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý hlas tu patří skutečnému člověku – ověřenému, nebo takovému, za kterého někdo ručí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver stemme her er et rigtigt menneske – verificeret eller indestået for af et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stimme hier ist ein echter Mensch – verifiziert oder von einem verifizierten Menschen bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε φωνή εδώ είναι πραγματικός άνθρωπος — επαληθευμένος ή εγγυημένος από κάποιον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every voice here is a real person — verified, or vouched for by one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada voz de aquí es una persona real: verificada o avalada por una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen ääni täällä on oikea ihminen – vahvistettu tai vahvistetun takaama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque voix ici est une vraie personne — vérifiée, ou garantie par l’une d’elles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קול כאן הוא אדם אמיתי — מאומת, או כזה שאדם מאומת ערב לו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ हर आवाज़ एक असली व्यक्ति की है — खुद सत्यापित, या किसी सत्यापित व्यक्ति द्वारा गारंटीशुदा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki glas ovdje je stvarna osoba — potvrđena ili ona za koju je netko jamčio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt minden hang valódi emberé – hitelesítetté, vagy olyané, akiért egy hitelesített ember kezeskedett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap suara di sini adalah orang sungguhan — terverifikasi, atau dijamin oleh orang yang terverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni voce qui è una persona reale: verificata, o garantita da una persona verificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにいる声はすべて実在の人のものです。本人が認証したか、認証済みの人が保証しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 모든 목소리는 실제 사람이에요. 직접 인증했거나, 인증된 사람이 보증했어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടത്തെ ഓരോ ശബ്ദവും ഒരു യഥാർഥ വ്യക്തിയുടേതാണ് — പരിശോധിച്ചതോ, ഒരാൾ ഉറപ്പുനൽകിയതോ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap suara di sini ialah orang sebenar — yang disahkan, atau dijamin oleh seseorang yang disahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver stemme her er et ekte menneske, verifisert eller garantert for av et."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke stem hier is een echt persoon: geverifieerd, of gegarandeerd door iemand die dat is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym głosem stoi tu prawdziwa osoba — zweryfikowana lub poręczona przez taką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada voz aqui é uma pessoa real, verificada ou avalizada por alguém verificado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada voz aqui é uma pessoa real — verificada, ou avalizada por uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare voce de aici este o persoană reală — verificată sau garantată de una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За каждым голосом здесь стоит реальный человек — проверенный или тот, за кого поручился проверенный."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za každým hlasom tu je skutočný človek — overený alebo s ručiteľom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje röst här är en verklig person – verifierad, eller intygad av en sådan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்குள்ள ஒவ்வொரு குரலும் உண்மையான ஒருவருடையது — சரிபார்க்கப்பட்டவர் அல்லது அவரால் உத்தரவாதம் அளிக்கப்பட்டவர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడి ప్రతి స్వరం నిజమైన వ్యక్తిదే — ధృవీకరించబడినవారు, లేదా వారిలో ఒకరు హామీ ఇచ్చినవారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเสียงที่นี่เป็นคนจริง ที่ยืนยันตัวตนแล้วหรือมีคนยืนยันให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki her ses gerçek bir kişiye ait; ya doğrulanmış ya da doğrulanmış biri ona kefil olmuş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За кожним голосом тут — реальна людина, верифікована або така, за яку поручилася верифікована людина."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں ہر آواز ایک حقیقی شخص کی ہے — تصدیق شدہ، یا کسی تصدیق شدہ شخص کا ضمانت یافتہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tiếng nói ở đây là một người thật — đã xác minh, hoặc được một người như vậy bảo chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的每个声音都来自真人，他们或已通过验证，或由已验证的人担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的每個聲音都是真人，不是經過驗證，就是由真人擔保。"
          }
        }
      }
    },
