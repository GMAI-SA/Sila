      "comment": "%1$@ is the name the voucher wrote, %2$@ a number of hours.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسله إلى %1$@ فقط. يعمل مرة واحدة، لمدة %2$@ ساعة، وهذه المرة الوحيدة التي يعرضه فيها معروف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শুধু %1$@-কে পাঠান। এটি একবারই কাজ করে, %2$@ ঘণ্টার জন্য, আর Known এটি শুধু এই একবারই দেখায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia'l només a %1$@. Funciona una sola vegada, durant %2$@ hores, i aquesta és l'única vegada que Known el mostra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošli ho jen uživateli %1$@. Funguje jednou, %2$@ hodin, a tohle je jediný okamžik, kdy ho Known zobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send det kun til %1$@. Det virker én gang, i %2$@ timer, og det er den eneste gang, Known viser det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende ihn nur an %1$@. Er funktioniert einmal, für %2$@ Stunden, und Known zeigt ihn nur dieses eine Mal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλ' τον μόνο στον/στην %1$@. Λειτουργεί μία φορά, για %2$@ ώρες, και αυτή είναι η μόνη φορά που το Known τον εμφανίζει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send it only to %1$@. It works once, for %2$@ hours, and this is the only time Known shows it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíalo solo a %1$@. Funciona una vez, durante %2$@ horas, y esta es la única vez que Known lo muestra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä se vain käyttäjälle %1$@. Se toimii kerran, %2$@ tuntia, ja Known näyttää sen vain tämän yhden kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-le uniquement à %1$@. Il ne fonctionne qu’une fois, pendant %2$@ heures, et c’est la seule fois que Known l’affiche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח אותו רק אל %1$@. הוא עובד פעם אחת, במשך %2$@ שעות, וזו הפעם היחידה ש-Known מציגה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे सिर्फ़ %1$@ को भेजें। यह एक बार काम करता है, %2$@ घंटे के लिए, और Known इसे सिर्फ़ इसी बार दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošalji je samo osobi: %1$@. Vrijedi jednom, %2$@ sati, i Known je ovo jedini put prikazuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak neki küldd el: %1$@. Egyszer működik, %2$@ óráig, és a Known csak most mutatja meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim hanya kepada %1$@. Hanya berlaku sekali, selama %2$@ jam, dan ini satu-satunya saat Known menampilkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invialo solo a %1$@. Funziona una volta, per %2$@ ore, e questa è l'unica volta che Known lo mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@だけに送ってください。1回だけ、%2$@時間有効で、Knownがこれを表示するのは今回だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에게만 보내세요. %2$@시간 동안 한 번만 사용할 수 있고, Known이 이 링크를 보여주는 것은 이번이 유일해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ന് മാത്രം അയയ്ക്കുക. ഇത് %2$@ മണിക്കൂർ ഒരിക്കൽ മാത്രം പ്രവർത്തിക്കും, Known ഇത് കാണിക്കുന്നത് ഈ ഒരു തവണ മാത്രമാണ്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar hanya kepada %1$@. Ia berfungsi sekali, selama %2$@ jam, dan ini satu-satunya masa Known memaparkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send den bare til %1$@. Den fungerer én gang, i %2$@ timer, og dette er den eneste gangen Known viser den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur hem alleen naar %1$@. Hij werkt één keer, gedurende %2$@ uur, en dit is de enige keer dat Known hem toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij go tylko do: %1$@. Działa jednorazowo, przez %2$@ godz., a Known pokazuje go tylko ten jeden raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie-o apenas a %1$@. Ele funciona uma vez, por %2$@ horas, e esta é a única vez que o Known o mostra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie-a apenas a %1$@. Funciona uma vez, durante %2$@ horas, e esta é a única vez que a Known a mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite-l doar lui %1$@. Funcționează o singură dată, timp de %2$@ ore, și aceasta este singura dată când Known îl afișează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте её только %1$@. Она работает один раз, %2$@ ч, и это единственный раз, когда Known её показывает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošli ho iba osobe %1$@. Funguje raz, %2$@ hodín, a Known ho zobrazí len teraz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka den bara till %1$@. Den fungerar en gång, i %2$@ timmar, och det här är enda gången Known visar den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை %1$@ க்கு மட்டுமே அனுப்புங்கள். இது %2$@ மணி நேரத்துக்கு, ஒரு முறை மட்டுமே செயல்படும்; Known இதைக் காட்டுவது இந்த ஒரு முறைதான்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని %1$@ కు మాత్రమే పంపండి. ఇది %2$@ గంటల పాటు ఒక్కసారి మాత్రమే పని చేస్తుంది, Known దీన్ని చూపేది ఈ ఒక్కసారే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งให้ %1$@ เท่านั้น ใช้ได้ครั้งเดียว ภายใน %2$@ ชั่วโมง และนี่เป็นครั้งเดียวที่ Known แสดงลิงก์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca %1$@ kişisine gönderin. Bir kez, %2$@ saat boyunca çalışır ve Known bunu yalnızca bu seferde gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть його лише людині: %1$@. Воно працює один раз, %2$@ годин, і Known показує його лише цього разу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے صرف %1$@ کو بھیجیں۔ یہ ایک بار چلتا ہے، %2$@ گھنٹے کے لیے، اور Known اسے صرف اسی بار دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi cho %1$@. Nó dùng được một lần, trong %2$@ giờ, và đây là lần duy nhất Known hiển thị nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只发给 %1$@。它只能使用一次，有效期 %2$@ 小时，而这是 Known 唯一一次显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只傳送給 %1$@。連結只能使用一次，有效期 %2$@ 小時，且這是 Known 唯一一次顯示它。"
          }
        }
      }
    },
