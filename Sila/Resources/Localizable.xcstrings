    "safety.menu.report.hint": {
      "comment": "VoiceOver hint for Report. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح قائمة بالأسباب. الإبلاغ سري — ولا يُعرض على %@ أبدًا من أبلغ عنه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কারণের তালিকা খোলে। রিপোর্ট গোপনীয় — %@-কে কখনও দেখানো হয় না কে রিপোর্ট করেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre una llista de motius. Denunciar és confidencial: a %@ mai se li mostra qui l'ha denunciat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře seznam důvodů. Nahlášení je důvěrné – uživateli %@ se nikdy neukáže, kdo ho nahlásil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner en liste over årsager. Anmeldelser er fortrolige – %@ får aldrig vist, hvem der anmeldte vedkommende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine Liste mit Gründen. Meldungen sind vertraulich – %@ wird nie gezeigt, wer gemeldet hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει μια λίστα λόγων. Η αναφορά είναι εμπιστευτική — στον/στην %@ δεν εμφανίζεται ποτέ ποιος τον/την ανέφερε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a list of reasons. Reporting is confidential — %@ is never shown who reported them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una lista de motivos. La denuncia es confidencial: a %@ nunca se le muestra quién lo denunció."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa luettelon syistä. Ilmiantaminen on luottamuksellista – käyttäjälle %@ ei koskaan näytetä, kuka ilmiantoi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une liste de motifs. Le signalement est confidentiel — %@ ne voit jamais qui l’a signalé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח רשימת סיבות. דיווח הוא חסוי — %@ אף פעם לא רואה מי דיווח עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कारणों की सूची खोलता है। रिपोर्टिंग गोपनीय है — %@ को कभी नहीं दिखाया जाता कि किसने रिपोर्ट किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara popis razloga. Prijava je povjerljiva — korisniku %@ nikada se ne prikazuje tko ga je prijavio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyit egy okokat tartalmazó listát. A jelentés bizalmas – %@ soha nem látja, ki jelentette."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka daftar alasan. Pelaporan bersifat rahasia — %@ tidak pernah diperlihatkan siapa yang melaporkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un elenco di motivi. La segnalazione è riservata: a %@ non viene mai mostrato chi l'ha segnalato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由の一覧を開きます。報告は非公開です。%@に、誰が報告したかが表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사유 목록을 열어요. 신고는 비밀이 보장되며 %@님에게는 누가 신고했는지 절대 표시되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാരണങ്ങളുടെ പട്ടിക തുറക്കുന്നു. റിപ്പോർട്ടിംഗ് രഹസ്യമാണ് — ആരാണ് റിപ്പോർട്ട് ചെയ്തതെന്ന് %@ എന്നയാളെ ഒരിക്കലും കാണിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka senarai sebab. Pelaporan adalah sulit — %@ tidak pernah ditunjukkan siapa yang melaporkan mereka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner en liste over årsaker. Rapportering er konfidensiell: %@ får aldri se hvem som rapporterte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een lijst met redenen. Melden is vertrouwelijk: %@ krijgt nooit te zien wie hen heeft gemeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera listę powodów. Zgłoszenia są poufne — %@ nigdy nie widzi, kto go zgłosił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma lista de motivos. A denúncia é confidencial: %@ nunca vê quem a denunciou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma lista de motivos. A denúncia é confidencial — %@ nunca vê quem a denunciou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide o listă de motive. Raportarea este confidențială — lui %@ nu i se arată niciodată cine l-a raportat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает список причин. Жалоба конфиденциальна — %@ никогда не узнает, кто пожаловался."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí zoznam dôvodov. Nahlásenie je dôverné — %@ sa nikdy nezobrazí, kto ho nahlásil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar en lista med orsaker. Rapportering är konfidentiell – %@ får aldrig se vem som rapporterade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காரணங்களின் பட்டியலைத் திறக்கும். புகார் ரகசியமானது — யார் புகாரளித்தார் என்று %@ க்கு ஒருபோதும் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కారణాల జాబితాను తెరుస్తుంది. రిపోర్టింగ్ గోప్యమైనది — ఎవరు రిపోర్ట్ చేశారో %@కు ఎప్పుడూ చూపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดรายการเหตุผล การรายงานเป็นความลับ %@ จะไม่เห็นว่าใครรายงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedenlerin listesini açar. Şikayet gizlidir; %@ kişisine kimin şikayet ettiği asla gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває список причин. Скарга конфіденційна — %@ ніколи не бачить, хто поскаржився."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وجوہات کی فہرست کھولتا ہے۔ رپورٹ رازدارانہ ہے — %@ کو کبھی نہیں دکھایا جاتا کہ کس نے رپورٹ کی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở danh sách lý do. Báo cáo là bí mật — %@ không bao giờ được cho biết ai đã báo cáo họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开原因列表。举报是保密的，%@ 永远不会看到是谁举报了他们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟原因清單。檢舉是保密的，%@ 絕不會得知是誰檢舉的。"
          }
        }
      }
    },
    "safety.menu.silentHeader": {
      "comment": "Header on the safety menu, read before either silent action is taken. %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحظر والكتم صامتان — لا يُبلَّغ %@ بأي منهما أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্লক ও মিউট নীরবে হয় — %@-কে কখনও জানানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquejar i silenciar són accions silencioses: %@ no n'és informat mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování a ztlumení jsou tichá – uživatel %@ se to nikdy nedozví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokering og lydløs sker i stilhed – %@ får aldrig besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockieren und Stummschalten geschehen lautlos – %@ wird nie benachrichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός και η σίγαση είναι αθόρυβα — ο/η %@ δεν ενημερώνεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking and muting are silent — %@ is never told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear y silenciar son acciones silenciosas: nunca se avisa a %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estäminen ja mykistäminen ovat äänettömiä – käyttäjälle %@ ei kerrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer et mettre en sourdine sont silencieux — %@ n’en est jamais informé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימה והשתקה הן שקטות — %@ אף פעם לא מקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक और म्यूट करना चुपचाप होता है — %@ को कभी नहीं बताया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje i utišavanje su tiha — %@ nikada nije obaviješten/a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letiltás és a némítás csendes – %@ nem kap értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memblokir dan membisukan berjalan diam-diam — %@ tidak pernah diberi tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccare e silenziare sono azioni silenziose: %@ non viene mai avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックとミュートは通知されません。%@に知らされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단과 뮤트는 조용히 처리돼요. %@님에게는 알려지지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്ലോക്കും മ്യൂട്ടും നിശ്ശബ്ദമാണ് — %@ എന്നയാളെ ഒരിക്കലും അറിയിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyekat dan menyenyapkan dilakukan secara senyap — %@ tidak pernah diberitahu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkering og demping skjer i det stille. %@ får aldri vite det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeren en dempen gebeurt stil: %@ krijgt hier geen bericht van."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie i wyciszanie są ciche — %@ nigdy nie jest o nich informowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear e silenciar são ações silenciosas: %@ nunca é avisado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear e silenciar são silenciosos — %@ nunca é avisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea și dezactivarea sunt discrete — %@ nu este niciodată anunțat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка и заглушение происходят тихо — %@ не узнает об этом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokovanie a stlmenie sú tiché — %@ sa o nich nedozvie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att blockera och tysta sker i tysthet – %@ får aldrig veta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தடுப்பதும் ஒலியடக்குவதும் அமைதியானவை — %@ க்கு ஒருபோதும் தெரிவிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్లాక్ చేయడం, మ్యూట్ చేయడం నిశ్శబ్దంగా జరుగుతాయి — %@కు ఎప్పుడూ చెప్పబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกและปิดเสียงเป็นไปอย่างเงียบๆ %@ ไม่ได้รับแจ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelleme ve sessize alma sessizdir; %@ kişisine haber verilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування й заглушення тихі — %@ ніколи не повідомляють."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلاک اور میوٹ خاموش ہیں — %@ کو کبھی نہیں بتایا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn và ẩn đều âm thầm — %@ không bao giờ được thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽和静音都是静默的，不会通知 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖和靜音都是無聲的，%@ 絕不會得知。"
          }
        }
      }
    },
