    "composer.scope.country.a11yLabel": {
      "comment": "VoiceOver label for a country audience row. Both placeholders are the country name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ فقط. لا يمكن الرد إلا للحسابات الموثّقة في %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু %1$@। শুধু %2$@-এ ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només %1$@. Només hi poden respondre els comptes verificats a %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen %1$@. Odpovídat mohou jen účty ověřené v zemi %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %1$@. Kun konti verificeret i %2$@ kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %1$@. Nur in %2$@ verifizierte Konten können antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο %1$@. Μόνο λογαριασμοί επαληθευμένοι στη χώρα %2$@ μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ only. Only accounts verified in %2$@ can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %1$@. Solo las cuentas verificadas en %2$@ pueden responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain %1$@. Vain maassa %2$@ vahvistetut tilit voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uniquement. Seuls les comptes vérifiés en %2$@ peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ בלבד. רק חשבונות שאומתו ב-%2$@ יכולים להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल %1$@। सिर्फ़ %2$@ में सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo: %1$@. Odgovarati mogu samo računi potvrđeni u: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak %1$@. Csak a(z) %2$@ országban hitelesített fiókok válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya %1$@. Hanya akun yang terverifikasi di %2$@ yang bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %1$@. Solo gli account verificati in %2$@ possono rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のみ。%2$@で認証されたアカウントだけが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 전용. %2$@에서 인증된 계정만 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ മാത്രം. %2$@-ൽ പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sahaja. Hanya akaun yang disahkan di %2$@ boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare %1$@. Bare kontoer verifisert i %2$@ kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen %1$@. Alleen accounts die in %2$@ zijn geverifieerd kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko: %1$@. Odpowiadać mogą tylko konta zweryfikowane w kraju: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente %1$@. Só contas verificadas em %2$@ podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %1$@. Só contas verificadas em %2$@ podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar %1$@. Doar conturile verificate în %2$@ pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только %1$@. Отвечать могут только аккаунты, проверенные в %2$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba %1$@. Odpovedať môžu iba účty overené v krajine %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast %1$@. Bara konton verifierade i %2$@ kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ மட்டும். %2$@ இல் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ మాత్రమే. %2$@లో ధృవీకరించబడిన ఖాతాలు మాత్రమే రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะ %1$@ เฉพาะบัญชีที่ยืนยันตัวตนใน %2$@ เท่านั้นที่ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca %1$@. Yalnızca %2$@ ülkesinde doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише %1$@. Відповідати можуть лише облікові записи, верифіковані в країні %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف %1$@۔ صرف %2$@ میں تصدیق شدہ اکاؤنٹ جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ %1$@. Chỉ tài khoản được xác minh ở %2$@ mới trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 %1$@。只有在 %2$@ 验证的账户可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限 %1$@。只有在 %2$@ 通過驗證的帳號能回覆。"
          }
        }
      }
    },
