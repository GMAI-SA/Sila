    "preferences.summary.narrowed.taggedOnly": {
      "comment": "Summary when the topic filter is on and unlabelled posts are hidden. %lld is how many topics were chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld مواضيع اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوعًا اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوع الذي اخترته فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوع اخترتها فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوعين اللذين اخترتهما فقط، والمنشورات غير المصنّفة بعد مخفية."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية لا تعرض شيئًا، إذ لم تختر أي موضوع والمنشورات غير المصنّفة مخفية."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your International feed shows only posts about %lld topic you chose; posts that haven't been labelled yet are hidden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your International feed shows only posts about %lld topics you chose; posts that haven't been labelled yet are hidden."
                }
              }
            }
          }
        }
      }
    },
    "preferences.summary.narrowed.withUntagged": {
      "comment": "Summary when the topic filter is on and unlabelled posts are kept. %lld is how many topics were chosen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld مواضيع اخترتها، إضافةً إلى المنشورات غير المصنّفة بعد."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوعًا اخترتها، إضافةً إلى المنشورات غير المصنّفة بعد."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوع الذي اخترته، إضافةً إلى المنشورات غير المصنّفة بعد."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات %lld موضوع اخترتها، إضافةً إلى المنشورات غير المصنّفة بعد."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض منشورات الموضوعين اللذين اخترتهما، إضافةً إلى المنشورات غير المصنّفة بعد."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "صفحتك الدولية تعرض المنشورات غير المصنّفة فقط."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your International feed shows posts about %lld topic you chose, plus posts that haven't been labelled yet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your International feed shows posts about %lld topics you chose, plus posts that haven't been labelled yet."
                }
              }
            }
          }
        }
      }
    },
    "preferences.summary.notSaved": {
      "comment": "Badge above the summary when it describes unsaved edits. Upper case in English by design.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
