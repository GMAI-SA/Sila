    "safety.appeal.prompt": {
      "comment": "The label above the appeal box. States the one-per-suspension rule.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك تظلّم واحد لكل إيقاف. اذكر ما تعتقد أنه حدث ولماذا ينبغي إعادة النظر فيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি স্থগিতাদেশে আপনি একটি আপিল পান। আপনার মতে কী ঘটেছে এবং কেন তা পুনর্বিবেচনা করা উচিত তা বলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens una apel·lació per suspensió. Explica què creus que ha passat i per què s'hauria de reconsiderar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na každé pozastavení máš jedno odvolání. Napiš, co se podle tebe stalo a proč by se to mělo přehodnotit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får én anke pr. suspension. Skriv, hvad du mener, der skete, og hvorfor det bør genovervejes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Sperre hast du einen Einspruch. Schreibe, was deiner Meinung nach passiert ist und warum es neu geprüft werden sollte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις μία ένσταση ανά αναστολή. Πες τι πιστεύεις ότι συνέβη και γιατί πρέπει να επανεξεταστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get one appeal per suspension. Say what you think happened and why it should be reconsidered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una apelación por suspensión. Cuenta qué crees que pasó y por qué debería reconsiderarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat yhden valituksen jäädytystä kohden. Kerro, mitä mielestäsi tapahtui ja miksi asia pitäisi käsitellä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez droit à un recours par suspension. Dites ce que vous pensez qu’il s’est passé et pourquoi cela devrait être réexaminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לך ערעור אחד לכל השעיה. כתוב מה לדעתך קרה ולמה צריך לשקול מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर निलंबन पर आपको एक अपील मिलती है। बताएँ कि आपको क्या हुआ लगता है और इस पर दोबारा विचार क्यों होना चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaš jednu žalbu po suspenziji. Reci što misliš da se dogodilo i zašto bi trebalo preispitati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felfüggesztésenként egy fellebbezésed van. Írd meg, szerinted mi történt, és miért kellene újragondolni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mendapat satu banding per penangguhan. Ceritakan apa yang menurutmu terjadi dan mengapa harus ditinjau ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un ricorso per sospensione. Di' cosa pensi sia successo e perché andrebbe riconsiderato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異議申し立ては停止1回につき1回です。何があったと思うか、なぜ再検討されるべきかを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정지 1건당 이의 신청은 한 번만 할 수 있어요. 무슨 일이 있었다고 생각하는지, 왜 다시 검토해야 하는지 적어 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു സസ്പെൻഷന് ഒരു അപ്പീൽ മാത്രം. എന്താണ് സംഭവിച്ചതെന്ന് നിങ്ങൾ കരുതുന്നുവെന്നും എന്തുകൊണ്ട് പുനഃപരിശോധിക്കണമെന്നും പറയുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mendapat satu rayuan bagi setiap penggantungan. Nyatakan apa yang anda rasa berlaku dan mengapa ia patut dipertimbangkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får én anke per suspensjon. Skriv hva du tror skjedde og hvorfor det bør vurderes på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt één bezwaar per schorsing. Zeg wat je denkt dat er gebeurd is en waarom het opnieuw bekeken moet worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz jedno odwołanie na zawieszenie. Napisz, co Twoim zdaniem się stało i dlaczego sprawę należy rozważyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem uma contestação por suspensão. Diga o que você acha que aconteceu e por que deve ser reconsiderado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem direito a uma contestação por suspensão. Diga o que acha que aconteceu e porque deve ser reconsiderado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai o singură contestație per suspendare. Spune ce crezi că s-a întâmplat și de ce ar trebui reconsiderat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На одну блокировку даётся одна апелляция. Расскажите, что, по-вашему, произошло и почему это стоит пересмотреть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na jedno pozastavenie máš jedno odvolanie. Napíš, čo sa podľa teba stalo a prečo by sa to malo prehodnotiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får ett överklagande per avstängning. Berätta vad du tror hände och varför det bör omprövas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு இடைநிறுத்தத்துக்கு ஒரு மேல்முறையீடு மட்டுமே. என்ன நடந்தது என்று நினைக்கிறீர்கள், ஏன் மறுபரிசீலிக்க வேண்டும் என்று சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి సస్పెన్షన్‌కు మీకు ఒక అప్పీల్ ఉంటుంది. ఏం జరిగిందని మీరు అనుకుంటున్నారో, దాన్ని ఎందుకు పునఃపరిశీలించాలో చెప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอุทธรณ์ได้หนึ่งครั้งต่อการระงับหนึ่งครั้ง บอกว่าคุณคิดว่าเกิดอะไรขึ้นและเหตุใดจึงควรพิจารณาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Askıya alma başına bir itiraz hakkınız var. Ne olduğunu düşündüğünüzü ve neden yeniden değerlendirilmesi gerektiğini yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожне призупинення можна подати одну апеляцію. Напишіть, що, на вашу думку, сталося і чому це варто переглянути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر معطلی پر آپ کو ایک اپیل ملتی ہے۔ بتائیں کہ آپ کے خیال میں کیا ہوا اور اس پر دوبارہ غور کیوں ہونا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có một khiếu nại cho mỗi lần đình chỉ. Hãy nói bạn nghĩ điều gì đã xảy ra và vì sao cần xem xét lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次封禁你只有一次申诉机会。请说明你认为发生了什么，以及为什么应该重新考虑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次停權你只有一次申訴機會。請說明你認為發生了什麼事，以及為什麼應該重新考慮。"
          }
        }
      }
    },
