    "vouch.claim.closed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتطابق البيانات ثلاث مرات، فأُغلق الرابط نهائيًا. اطلب من مرسله رابطًا جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তথ্য তিনবার মেলেনি, তাই লিংকটি চিরতরে বন্ধ হয়েছে। যিনি পাঠিয়েছেন তাঁর কাছে নতুন একটি চান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dades no han coincidit tres vegades, així que l'enllaç s'ha tancat per sempre. Demana'n un de nou a qui te'l va enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje se třikrát neshodovaly, takže je odkaz navždy uzavřen. Požádej osobu, která ti ho poslala, o nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplysningerne passede ikke tre gange, så linket er lukket for altid. Bed den, der sendte det, om et nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angaben haben dreimal nicht gepasst, daher ist der Link endgültig geschlossen. Bitte die Person, die ihn gesendet hat, um einen neuen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία δεν ταίριαξαν τρεις φορές, οπότε ο σύνδεσμος έκλεισε οριστικά. Ζήτησε νέο από το άτομο που τον έστειλε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The details didn't match three times, so the link is closed for good. Ask the person who sent it for a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos no coincidieron tres veces, así que el enlace queda cerrado para siempre. Pide uno nuevo a quien te lo envió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedot eivät täsmänneet kolme kertaa, joten linkki on suljettu lopullisesti. Pyydä sen lähettäneeltä uusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations ne correspondaient pas trois fois, le lien est donc définitivement fermé. Demandez-en un nouveau à la personne qui l’a envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרטים לא התאימו שלוש פעמים, ולכן הקישור נסגר לצמיתות. בקש קישור חדש ממי ששלח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण तीन बार मेल नहीं खाया, इसलिए लिंक हमेशा के लिए बंद हो गया। इसे भेजने वाले से नया माँगें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci se tri puta nisu podudarali pa je poveznica trajno zatvorena. Zatraži novu od osobe koja ti ju je poslala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok háromszor nem egyeztek, ezért a hivatkozás véglegesen lezárult. Kérj újat attól, aki küldte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detailnya tidak cocok tiga kali, jadi tautan ditutup selamanya. Minta tautan baru kepada orang yang mengirimnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati non corrispondevano per tre volte, quindi il link è chiuso per sempre. Chiedine uno nuovo a chi te l'ha inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細が3回一致しなかったため、このリンクは完全に閉じられました。送ってくれた人に新しいリンクを頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보가 세 번 일치하지 않아 링크가 영구적으로 닫혔어요. 링크를 보낸 사람에게 새 링크를 요청하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിവരങ്ങൾ മൂന്ന് തവണ ഒത്തുപോയില്ല, അതിനാൽ ലിങ്ക് എന്നെന്നേക്കുമായി അടച്ചു. അയച്ചയാളോട് പുതിയത് ചോദിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran tidak sepadan tiga kali, jadi pautan ditutup selama-lamanya. Minta pautan baharu daripada orang yang menghantarnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplysningene stemte ikke tre ganger, så lenken er lukket for godt. Be personen som sendte den, om en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens kwamen drie keer niet overeen, dus de link is definitief gesloten. Vraag de persoon die hem stuurde om een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nie zgodziły się trzy razy, więc link został zamknięty na stałe. Poproś osobę, która go wysłała, o nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não coincidiram três vezes, então o link foi fechado em definitivo. Peça um novo a quem o enviou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados não coincidiram três vezes, por isso a ligação ficou fechada de vez. Peça uma nova a quem a enviou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele nu au coincis de trei ori, așa că linkul este închis definitiv. Cere un link nou persoanei care ți l-a trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не совпали три раза, поэтому ссылка закрыта навсегда. Попросите отправившего прислать новую."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje sa trikrát nezhodovali, takže odkaz je natrvalo zatvorený. Požiadaj osobu, ktorá ho poslala, o nový."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifterna stämde inte tre gånger, så länken är stängd för gott. Be personen som skickade den om en ny."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விவரங்கள் மூன்று முறை பொருந்தவில்லை, எனவே இந்த இணைப்பு நிரந்தரமாக மூடப்பட்டது. அனுப்பியவரிடம் புதிய இணைப்பைக் கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వివరాలు మూడుసార్లు సరిపోలలేదు, కాబట్టి ఈ లింక్ శాశ్వతంగా మూసివేయబడింది. దీన్ని పంపిన వ్యక్తిని కొత్తది అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดไม่ตรงกันสามครั้ง ลิงก์จึงถูกปิดถาวร ขอลิงก์ใหม่จากคนที่ส่งให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgiler üç kez eşleşmedi, bu yüzden bağlantı kalıcı olarak kapandı. Bağlantıyı gönderen kişiden yenisini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані тричі не збіглися, тому посилання закрито остаточно. Попросіть того, хто його надіслав, надіслати нове."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تفصیلات تین بار نہیں ملیں، اس لیے لنک ہمیشہ کے لیے بند ہو گیا۔ بھیجنے والے سے نیا مانگیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin không khớp ba lần, nên liên kết đã bị đóng vĩnh viễn. Hãy xin người đã gửi một liên kết mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息已三次不匹配，因此该链接已永久关闭。请向发送者索要新的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料三次都不相符，因此此連結已永久關閉。請向傳送者索取新的連結。"
          }
        }
      }
    },
