    "rooms.end.warning": {
      "comment": "The confirmation in front of ending a room.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُقطع الاتصال عن الجميع فورًا ولا يمكن إعادة فتح الغرفة. ولم يُسجَّل شيء، فلا يوجد ما يمكن الاحتفاظ به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবাইকে সঙ্গে সঙ্গে বিচ্ছিন্ন করা হয় এবং রুম আর খোলা যায় না। কিছু রেকর্ড করা হয়নি, তাই রাখার মতো কিছু নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom es desconnecta a l'instant i la sala no es pot tornar a obrir. No s'ha enregistrat res, així que no hi ha res per conservar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni jsou okamžitě odpojeni a místnost nelze znovu otevřít. Nic se nenahrávalo, takže není co uchovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bliver afbrudt med det samme, og rummet kan ikke genåbnes. Intet blev optaget, så der er intet at gemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle werden sofort getrennt, und der Raum lässt sich nicht wieder öffnen. Es wurde nichts aufgezeichnet, also gibt es nichts zu behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλοι αποσυνδέονται αμέσως και η αίθουσα δεν μπορεί να ανοίξει ξανά. Δεν ηχογραφήθηκε τίποτα, οπότε δεν υπάρχει τίποτα να κρατηθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everybody is disconnected straight away and the room can't be reopened. Nothing was recorded, so there is nothing to keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos se desconectan al instante y la sala no se puede reabrir. No se grabó nada, así que no hay nada que conservar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki katkaistaan heti, eikä huonetta voi avata uudelleen. Mitään ei tallennettu, joten säilytettävää ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde est déconnecté immédiatement et le salon ne peut pas être rouvert. Rien n’a été enregistré, il n’y a donc rien à conserver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כולם מנותקים מיד ואי אפשר לפתוח את החדר מחדש. שום דבר לא הוקלט, ולכן אין מה לשמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब लोग तुरंत डिस्कनेक्ट हो जाते हैं और रूम दोबारा नहीं खोला जा सकता। कुछ भी रिकॉर्ड नहीं हुआ, इसलिए रखने को कुछ नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi se odmah odspajaju i soba se ne može ponovno otvoriti. Ništa nije snimljeno pa nema što zadržati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindenkit azonnal lekapcsolunk, és a szoba nem nyitható újra. Semmit nem rögzítettünk, így nincs mit megőrizni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang langsung terputus dan room tidak bisa dibuka kembali. Tidak ada yang direkam, jadi tidak ada yang bisa disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti vengono disconnessi subito e la stanza non può essere riaperta. Non è stato registrato nulla, quindi non c'è nulla da conservare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員がただちに切断され、ルームを再び開くことはできません。録音されていないため、残るものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람의 연결이 즉시 끊어지고 룸을 다시 열 수 없어요. 아무것도 녹음되지 않았으므로 보관할 것도 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാവരെയും ഉടൻ വിച്ഛേദിക്കും, റൂം വീണ്ടും തുറക്കാനാവില്ല. ഒന്നും റെക്കോർഡ് ചെയ്തിട്ടില്ല, അതിനാൽ സൂക്ഷിക്കാൻ ഒന്നുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang diputuskan serta-merta dan bilik tidak boleh dibuka semula. Tiada apa dirakam, jadi tiada apa untuk disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kobles fra med en gang, og rommet kan ikke åpnes igjen. Ingenting ble tatt opp, så det er ingenting å beholde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen wordt meteen losgekoppeld en de room kan niet opnieuw worden geopend. Er is niets opgenomen, dus er is niets om te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy zostaną natychmiast rozłączeni, a pokoju nie można ponownie otworzyć. Nic nie nagrano, więc nie ma czego zachować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos são desconectados na hora e a sala não pode ser reaberta. Nada foi gravado, então não há nada para guardar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos são desligados de imediato e a sala não pode ser reaberta. Nada foi gravado, por isso não há nada a guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toți sunt deconectați imediat, iar camera nu mai poate fi redeschisă. Nu s-a înregistrat nimic, deci nu e nimic de păstrat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все будут сразу отключены, а комнату нельзя будет открыть снова. Ничего не записано, поэтому сохранять нечего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetci sa okamžite odpoja a miestnosť sa nedá znova otvoriť. Nič sa nenahrávalo, takže nie je čo uchovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kopplas bort direkt och rummet kan inte öppnas igen. Inget spelades in, så det finns inget att spara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைவரும் உடனே துண்டிக்கப்படுவார்கள், அறையை மீண்டும் திறக்க முடியாது. எதுவும் பதிவு செய்யப்படவில்லை, எனவே வைத்துக்கொள்ள எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అందరూ వెంటనే డిస్‌కనెక్ట్ అవుతారు, రూమ్‌ను మళ్లీ తెరవలేరు. ఏదీ రికార్డ్ చేయబడలేదు, కాబట్టి ఉంచుకోవడానికి ఏదీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนจะถูกตัดการเชื่อมต่อทันทีและเปิดห้องใหม่ไม่ได้ ไม่มีการบันทึก จึงไม่มีอะไรให้เก็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesin bağlantısı hemen kesilir ve oda yeniden açılamaz. Hiçbir şey kaydedilmedi, bu yüzden saklanacak bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усіх одразу буде від’єднано, і кімнату не можна буде відкрити знову. Нічого не записувалося, тож і зберігати нічого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب فوراً منقطع ہو جاتے ہیں اور روم دوبارہ نہیں کھل سکتا۔ کچھ ریکارڈ نہیں ہوا، اس لیے رکھنے کو کچھ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người bị ngắt kết nối ngay lập tức và phòng không thể mở lại. Không có gì được ghi âm, nên không có gì để giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人会立即断开连接，房间无法重新开启。没有任何内容被录音，所以没有什么可保留的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人會立即中斷連線，且聊天室無法重新開啟。沒有任何內容被錄音，所以沒有東西可保留。"
          }
        }
      }
    },
    "rooms.ended.body": {
      "comment": "A room that is over. Repeats that nothing was recorded, so there is nothing to catch up on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت هذه الغرفة. لم يُسجَّل شيء، فلا يوجد ما يمكن الرجوع إليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুম শেষ হয়ে গেছে। কিছু রেকর্ড করা হয়নি, তাই ধরে নেওয়ার মতো কিছু নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta sala ha acabat. No s'ha enregistrat res, així que no hi ha res per posar-se al dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato místnost skončila. Nic se nenahrávalo, takže není co dohánět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rum er slut. Intet blev optaget, så der er ikke noget at indhente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Raum ist beendet. Es wurde nichts aufgezeichnet, also gibt es nichts nachzuholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η αίθουσα έχει τελειώσει. Δεν ηχογραφήθηκε τίποτα, οπότε δεν υπάρχει τίποτα να παρακολουθήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This room has ended. Nothing was recorded, so there's nothing to catch up on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sala ha terminado. No se grabó nada, así que no hay nada que recuperar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä huone on päättynyt. Mitään ei tallennettu, joten kiinni otettavaa ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce salon est terminé. Rien n’a été enregistré, il n’y a donc rien à rattraper."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החדר הזה הסתיים. שום דבר לא הוקלט, ולכן אין מה להשלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रूम खत्म हो चुका है। कुछ भी रिकॉर्ड नहीं हुआ, इसलिए पकड़ने को कुछ नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova soba je završila. Ništa nije snimljeno pa nema što nadoknaditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szoba véget ért. Semmit nem rögzítettünk, így nincs mit pótolni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room ini sudah berakhir. Tidak ada yang direkam, jadi tidak ada yang bisa dikejar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa stanza è finita. Non è stato registrato nulla, quindi non c'è niente da recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルームは終了しました。録音されていないため、あとから追える内容はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 룸은 끝났어요. 아무것도 녹음되지 않았으므로 따라잡을 내용이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റൂം അവസാനിച്ചു. ഒന്നും റെക്കോർഡ് ചെയ്തിട്ടില്ല, അതിനാൽ കേട്ടെത്താൻ ഒന്നുമില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik ini telah tamat. Tiada apa dirakam, jadi tiada apa untuk dikejar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette rommet er avsluttet. Ingenting ble tatt opp, så det er ingenting å ta igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze room is afgelopen. Er is niets opgenomen, dus er valt niets in te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten pokój się zakończył. Nic nie nagrano, więc nie ma czego nadrabiać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sala terminou. Nada foi gravado, então não há o que recuperar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sala terminou. Nada foi gravado, por isso não há nada para recuperar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această cameră s-a încheiat. Nu s-a înregistrat nimic, deci nu ai ce recupera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта комната завершилась. Ничего не записано, так что наверстать нечего."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto miestnosť skončila. Nič sa nenahrávalo, takže nie je čo dobehnúť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här rummet har avslutats. Inget spelades in, så det finns inget att ta igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அறை முடிந்துவிட்டது. எதுவும் பதிவு செய்யப்படவில்லை, எனவே பின்தொடர்ந்து பார்க்க எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రూమ్ ముగిసింది. ఏదీ రికార్డ్ చేయబడలేదు, కాబట్టి తెలుసుకోవడానికి ఏదీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนี้จบแล้ว ไม่มีการบันทึก จึงไม่มีอะไรให้ตามฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oda sona erdi. Hiçbir şey kaydedilmedi, bu yüzden yetişilecek bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця кімната завершилася. Нічого не записувалося, тож і надолужувати нічого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ روم ختم ہو چکا ہے۔ کچھ ریکارڈ نہیں ہوا، اس لیے پکڑنے کو کچھ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng này đã kết thúc. Không có gì được ghi âm, nên không có gì để xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此房间已结束。没有任何内容被录音，所以没有可追看的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天室已結束。沒有任何內容被錄音，所以沒有可補聽的內容。"
          }
        }
      }
    },
