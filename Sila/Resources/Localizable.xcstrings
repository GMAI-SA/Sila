        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i post il cui testo corrisponde alla ricerca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文が検索に一致する投稿を表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 검색어와 일치하는 게시물을 보여줘요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടെക്സ്റ്റ് നിങ്ങളുടെ തിരയലുമായി ഒത്തുപോകുന്ന പോസ്റ്റുകൾ കാണിക്കുന്നു"
