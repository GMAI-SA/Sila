    "feed.empty.forYou.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا أحدث المنشورات أولًا، مع رفع المواضيع التي تختارها. اختر بعضها من الشريط أعلاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন পোস্ট এখানে আগে দেখা যায়, আপনার বেছে নেওয়া বিষয়গুলোর জন্য এগিয়ে আনা হয়। উপরের সারি থেকে কয়েকটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicacions més noves es mostren primer aquí, amb prioritat per als temes que triïs. Tria'n alguns a la fila de dalt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější příspěvky se zobrazí první, posílené podle témat, která zvolíš. Vyber některá z řady výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De nyeste opslag vises her først, løftet for de emner, du vælger. Vælg nogle i rækken ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuesten Beiträge erscheinen hier zuerst, angehoben für die Themen, die du wählst. Wähle einige in der Zeile oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι νεότερες αναρτήσεις εμφανίζονται πρώτες, με προβολή για τα θέματα που επιλέγεις. Διάλεξε μερικά από τη γραμμή παραπάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newest posts show here first, lifted for the subjects you choose. Pick some from the row above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones más recientes aparecen primero, realzadas según los temas que elijas. Elige algunos en la fila de arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusimmat julkaisut näkyvät täällä ensin, valitsemiesi aiheiden mukaan nostettuina. Valitse joitain yllä olevalta riviltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les posts les plus récents s’affichent d’abord, remontés pour les sujets que vous choisissez. Choisissez-en dans la rangée ci-dessus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוסטים החדשים ביותר מוצגים כאן ראשונים, מועלים לפי הנושאים שבחרת. בחר כמה מהשורה שלמעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई पोस्ट सबसे पहले यहाँ दिखती हैं, आपके चुने विषयों के लिए ऊपर उठी हुई। ऊपर की पंक्ति से कुछ चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovije objave prvo se prikazuju ovdje, istaknute prema temama koje odabereš. Odaberi neke iz retka iznad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legújabb bejegyzések jelennek meg elöl, a választott témáid szerint előrébb hozva. Válassz néhányat a fenti sorból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Postingan terbaru tampil di sini lebih dulu, diangkat sesuai topik yang kamu pilih. Pilih beberapa dari deretan di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post più recenti compaiono qui per primi, valorizzando gli argomenti che scegli. Scegline alcuni dalla riga sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい投稿が先に表示され、選んだ分野の投稿が上に上がります。上の列からいくつか選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 게시물이 먼저 표시되며, 선택한 주제는 더 위로 올라와요. 위 줄에서 주제를 골라 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ പോസ്റ്റുകൾ ഇവിടെ ആദ്യം കാണിക്കും, നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന വിഷയങ്ങൾക്ക് മുൻഗണന നൽകി. മുകളിലെ വരിയിൽ നിന്ന് ചിലത് തിരഞ്ഞെടുക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran terbaharu dipaparkan di sini dahulu, dinaikkan untuk subjek yang anda pilih. Pilih beberapa daripada baris di atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De nyeste innleggene vises her først, løftet for temaene du velger. Velg noen fra raden ovenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwste berichten staan hier eerst, omhoog gehaald voor de onderwerpen die je kiest. Kies er een paar uit de rij hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsze wpisy pojawiają się tu najpierw, z wyróżnieniem tematów, które wybierzesz. Wybierz kilka z rzędu powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os posts mais recentes aparecem primeiro, com destaque para os assuntos que você escolher. Escolha alguns na linha acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações mais recentes aparecem primeiro, realçadas pelos assuntos que escolher. Escolha alguns na linha acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele mai noi postări apar aici primele, ridicate pentru subiectele alese de tine. Alege câteva din rândul de mai sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала показываются новейшие посты, с приоритетом для выбранных вами тем. Выберите их в ряду выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovšie príspevky sa zobrazia ako prvé, zvýraznené podľa tém, ktoré si vyberieš. Vyber si nejaké v riadku vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De nyaste inläggen visas här först, lyfta för de ämnen du väljer. Välj några i raden ovan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய இடுகைகள் முதலில் இங்கே தெரியும், நீங்கள் தேர்ந்தெடுக்கும் தலைப்புகளுக்கு முன்னுரிமையுடன். மேலே உள்ள வரிசையிலிருந்து சிலவற்றைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త పోస్ట్‌లు ఇక్కడ ముందుగా కనిపిస్తాయి, మీరు ఎంచుకున్న అంశాలకు పైకి తీసుకురాబడతాయి. పై వరుసలో కొన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพสต์ใหม่สุดจะแสดงก่อน โดยดันเรื่องที่คุณเลือกขึ้นมา เลือกบางเรื่องจากแถวด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeni gönderiler burada önce görünür, seçtiğiniz konulara göre öne çıkarılır. Yukarıdaki sıradan birkaçını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут спершу показуються найновіші дописи, підняті за темами, які ви вибрали. Виберіть кілька в рядку вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی پوسٹس یہاں پہلے دکھائی دیتی ہیں، آپ کے چنے ہوئے موضوعات کے لیے اوپر اٹھائی ہوئی۔ اوپر کی قطار سے کچھ چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đăng mới nhất hiện ở đây trước, được đẩy lên theo các chủ đề bạn chọn. Hãy chọn vài chủ đề ở hàng phía trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新的帖子会先显示在这里，并根据你选择的主题提前。请从上方一行中选几个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新的貼文會先顯示在這裡，並依你選擇的主題提高排序。請從上方列選幾個主題。"
          }
        }
      }
    },
