    "safety.reason.other.detail": {
      "comment": "What the catch-all reason asks for.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مما سبق. أخبر فريق «معروف» بالمشكلة بكلماتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরের কোনোটিই নয়। কী ঠিক নেই তা Known-কে নিজের ভাষায় বলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap de les anteriors. Explica a Known què passa amb les teves paraules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic z uvedeného. Řekni týmu Known vlastními slovy, co je špatně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet af ovenstående. Fortæl Known med dine egne ord, hvad der er galt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon. Sag Known in deinen eigenen Worten, was nicht stimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα από τα παραπάνω. Πες στο Known τι δεν πάει καλά με δικά σου λόγια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the above. Tell Known what is wrong in your own words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo anterior. Cuéntale a Known qué ocurre con tus propias palabras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään yllä olevista. Kerro Knownille omin sanoin, mikä on vialla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce qui précède. Dites à Known ce qui ne va pas avec vos propres mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר מהנ״ל. ספר ל-Known מה לא בסדר במילים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर में से कुछ नहीं। Known को अपने शब्दों में बताएँ कि क्या ग़लत है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa od navedenog. Reci timu aplikacije Known što nije u redu svojim riječima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fentiek egyike sem. Told el a Knownnak a saját szavaiddal, mi a baj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan salah satu di atas. Beri tahu Known apa yang salah dengan kata-katamu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno dei precedenti. Dì a Known cosa non va con parole tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記のいずれでもない場合。何が問題か、ご自身の言葉でKnownに伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 항목에 해당하지 않아요. 무엇이 문제인지 직접 Known에 알려 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിൽ പറഞ്ഞതൊന്നുമല്ല. എന്താണ് പ്രശ്നമെന്ന് സ്വന്തം വാക്കുകളിൽ Known-നോട് പറയുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada satu pun di atas. Beritahu Known apa yang tidak kena dalam kata-kata anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av de ovenfor. Fortell Known hva som er galt, med egne ord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets van het bovenstaande. Vertel Known in je eigen woorden wat er mis is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic z powyższych. Napisz Known własnymi słowami, co jest nie tak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma das anteriores. Conte ao Known o que há de errado com suas palavras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma das anteriores. Diga à Known o que está errado por palavras suas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic din cele de mai sus. Spune-i Known ce este greșit, cu cuvintele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из перечисленного. Расскажите Known своими словами, что не так."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič z uvedeného. Povedz Known vlastnými slovami, čo je zlé."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget av ovanstående. Berätta för Known vad som är fel med dina egna ord."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேற்கூறியவற்றில் எதுவும் இல்லை. என்ன தவறு என்பதை உங்கள் சொந்த வார்த்தைகளில் Known-க்குச் சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైవేవీ కాదు. ఏది తప్పో మీ స్వంత మాటల్లో Knownకు చెప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ตรงกับข้างต้น บอก Known ว่าผิดปกติอย่างไรด้วยคำของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdakilerin hiçbiri. Known'a neyin yanlış olduğunu kendi sözlerinizle anlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого з переліченого. Розкажіть Known, що не так, своїми словами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان میں سے کوئی نہیں۔ Known کو اپنے الفاظ میں بتائیں کہ کیا غلط ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mục nào ở trên. Hãy nói với Known điều gì sai bằng lời của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上都不是。请用你自己的话告诉 Known 哪里不对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上皆非。請用你自己的話告訴 Known 哪裡有問題。"
          }
        }
      }
    },
