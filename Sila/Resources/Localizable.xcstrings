    "vouch.warning.person.two": {
      "comment": "%@ is the voucher's handle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات غير الصحيحة تُنهي وصولك، ويفقد ⁦@%@⁩ حق التزكية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল তথ্য দিলে আপনার প্রবেশাধিকার শেষ হয়ে যাবে, আর @%@ ভাউচ করার অধিকার হারাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dades falses acaben amb el teu accés, i @%@ perd el dret d'avalar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravdivé údaje ukončí tvůj přístup a @%@ ztratí právo ručit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Falske oplysninger afslutter din adgang, og @%@ mister retten til at gå i god for andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsche Angaben beenden deinen Zugang, und @%@ verliert das Recht zu bürgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ψευδή στοιχεία τερματίζουν την πρόσβασή σου και ο/η @%@ χάνει το δικαίωμα να εγγυάται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False details end your access, and @%@ loses the right to vouch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos falsos terminan con tu acceso, y @%@ pierde el derecho a avalar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vääriin tietoihin perustuva pääsy päättyy, ja @%@ menettää takaamisoikeutensa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De fausses informations mettent fin à votre accès, et @%@ perd le droit de se porter garant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטים כוזבים מסיימים את הגישה שלך, ו-@%@ מאבד את הזכות לערוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग़लत विवरण से आपकी पहुँच खत्म हो जाती है, और @%@ वाउच करने का अधिकार खो देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lažni podaci završavaju tvoj pristup, a @%@ gubi pravo na jamčenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hamis adatok véget vetnek a hozzáférésednek, és @%@ elveszíti a kezeskedés jogát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail palsu mengakhiri aksesmu, dan @%@ kehilangan hak menjamin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati falsi pongono fine al tuo accesso, e @%@ perde il diritto di garantire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "虚偽の詳細を入力すると、利用できなくなり、@%@は保証する権利を失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허위 정보는 이용 권한을 잃게 하고, @%@님은 보증 자격을 잃어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തെറ്റായ വിവരങ്ങൾ നിങ്ങളുടെ ആക്സസ് അവസാനിപ്പിക്കും, @%@ ന് വൗച്ച് ചെയ്യാനുള്ള അവകാശം നഷ്ടമാകും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiran palsu menamatkan akses anda, dan @%@ kehilangan hak untuk menjamin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Falske opplysninger avslutter tilgangen din, og @%@ mister retten til å garantere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valse gegevens beëindigen je toegang, en @%@ verliest het recht om in te staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fałszywe dane kończą Twój dostęp, a @%@ traci prawo do poręczania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados falsos encerram seu acesso, e @%@ perde o direito de avalizar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados falsos terminam o seu acesso, e @%@ perde o direito de dar aval."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele false îți încheie accesul, iar @%@ pierde dreptul de a garanta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложные данные закроют вам доступ, а @%@ потеряет право поручаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravdivé údaje ukončia tvoj prístup a @%@ stratí právo ručiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Falska uppgifter avslutar din åtkomst, och @%@ förlorar rätten att intyga."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான விவரங்கள் உங்கள் அணுகலை முடித்துவிடும்; @%@ உறுதியளிக்கும் உரிமையை இழப்பார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పుడు వివరాలు మీ యాక్సెస్‌ను ముగిస్తాయి, @%@ హామీ ఇచ్చే హక్కును కోల్పోతారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลเท็จจะทำให้คุณใช้งานต่อไม่ได้ และ @%@ จะเสียสิทธิ์ในการรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış bilgiler erişiminizi sonlandırır ve @%@ kefil olma hakkını kaybeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неправдиві дані припиняють ваш доступ, а @%@ втрачає право ручатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غلط تفصیلات آپ کی رسائی ختم کر دیتی ہیں، اور @%@ ضمانت دینے کا حق کھو دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin sai sẽ chấm dứt quyền truy cập của bạn, và @%@ mất quyền bảo chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚假信息会终止你的访问权限，@%@ 也会失去担保资格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提供不實資料將終止你的使用權限，@%@ 也會失去擔保資格。"
          }
        }
      }
    },
    "vouch.warning.voucher.one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زكِّ فقط شخصًا تعرفه شخصيًا. سيظهر اسمك بجانب اسمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু যাঁকে সরাসরি চেনেন তাঁর জন্য ভাউচ করুন। আপনার নাম তাঁর নামের পাশে দেখানো হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avala només algú que coneguis en persona. El teu nom es mostrarà al costat del seu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruč jen za někoho, koho osobně znáš. Tvé jméno se zobrazí vedle jeho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå kun i god for en, du kender personligt. Dit navn vises ved siden af deres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bürge nur für jemanden, den du persönlich kennst. Dein Name erscheint neben dem der Person."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγυήσου μόνο για κάποιον που γνωρίζεις αυτοπροσώπως. Το όνομά σου θα εμφανίζεται δίπλα στο δικό του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only vouch for someone you know in person. Your name will show next to theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avala solo a alguien que conozcas en persona. Tu nombre aparecerá junto al suyo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takaa vain joku, jonka tunnet henkilökohtaisesti. Nimesi näkyy heidän nimensä vieressä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous portez garant que de quelqu’un que vous connaissez en personne. Votre nom apparaîtra à côté du sien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערוב רק למי שאתה מכיר באופן אישי. השם שלך יוצג לצד שמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उसके लिए वाउच करें जिसे आप व्यक्तिगत रूप से जानते हों। आपका नाम उनके नाम के बगल में दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamči samo za nekoga koga osobno poznaješ. Tvoje ime prikazivat će se uz njihovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak olyanért kezeskedj, akit személyesen ismersz. A neved az övé mellett fog látszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jamin orang yang kamu kenal secara langsung. Namamu akan tampil di samping nama mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantisci solo per qualcuno che conosci di persona. Il tuo nome comparirà accanto al suo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接知っている人だけを保証してください。あなたの名前が相手の名前の横に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 아는 사람만 보증하세요. 내 이름이 상대방 이름 옆에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നേരിട്ട് അറിയാവുന്ന ഒരാൾക്ക് മാത്രം വൗച്ച് ചെയ്യുക. നിങ്ങളുടെ പേര് അവരുടേതിനൊപ്പം കാണിക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamin hanya seseorang yang anda kenal secara peribadi. Nama anda akan dipaparkan di sebelah namanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanter bare for noen du kjenner personlig. Navnet ditt vises ved siden av deres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta alleen in voor iemand die je persoonlijk kent. Je naam wordt naast die van de ander getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poręczaj tylko za kogoś, kogo znasz osobiście. Twoje imię będzie widoczne obok jego imienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalize apenas alguém que você conhece pessoalmente. Seu nome aparecerá ao lado do dela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê aval apenas a quem conhece pessoalmente. O seu nome aparecerá junto ao dessa pessoa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantează doar pentru cineva pe care îl cunoști personal. Numele tău va apărea lângă al lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручайтесь только за тех, кого знаете лично. Ваше имя будет показано рядом с их именем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruč iba za niekoho, koho poznáš osobne. Tvoje meno sa zobrazí vedľa jeho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intyga bara för någon du känner personligen. Ditt namn visas bredvid deras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு நேரில் தெரிந்தவருக்கு மட்டுமே உறுதியளியுங்கள். உங்கள் பெயர் அவர்கள் பெயருக்கு அருகில் தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు వ్యక్తిగతంగా తెలిసిన వారికి మాత్రమే హామీ ఇవ్వండి. మీ పేరు వారి పేరు పక్కన కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับรองเฉพาะคนที่คุณรู้จักตัวต่อตัว ชื่อของคุณจะแสดงถัดจากชื่อเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca şahsen tanıdığınız birine kefil olun. Adınız onunkinin yanında görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручайтеся лише за того, кого знаєте особисто. Ваше ім’я показуватиметься поруч із їхнім."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اسی کی ضمانت دیں جسے آپ ذاتی طور پر جانتے ہیں۔ آپ کا نام ان کے نام کے ساتھ نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bảo chứng cho người bạn quen ngoài đời. Tên của bạn sẽ hiện cạnh tên họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只为你当面认识的人担保。你的名字会显示在对方名字旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只為你親自認識的人擔保。你的名字會顯示在對方的名字旁。"
          }
        }
      }
    },
    "vouch.warning.voucher.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل أن تزكّي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাউচ করার আগে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Abans d'avalar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než zaručíš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du går i god for nogen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du bürgst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν εγγυηθείς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you vouch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de avalar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennen kuin takaat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de vous porter garant"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני שאתה ערב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाउच करने से पहले"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije nego jamčiš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezeskedés előtt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum kamu menjamin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di garantire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証する前に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증하기 전에"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൗച്ച് ചെയ്യുന്നതിന് മുമ്പ്"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum anda menjamin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du garanterer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je instaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim poręczysz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de avalizar"
          }
        },
        "pt-PT": {
