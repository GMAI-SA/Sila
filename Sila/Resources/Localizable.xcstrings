    "groups.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف المفتوحة لها تبقى مغلقة على من دُعوا بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর জন্য খোলা রুমগুলো, ইতিমধ্যে আমন্ত্রিতদের জন্যও, বন্ধই থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sales obertes per a ell continuen tancades per a les persones ja convidades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnosti pro ni otevřené zůstanou uzavřené pro již pozvané lidi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum, der er åbnet for den, forbliver lukkede for de folk, der allerede er inviteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür geöffnete Räume bleiben für die bereits eingeladenen Personen geschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αίθουσες που ανοίχτηκαν για αυτήν παραμένουν κλειστές για τα άτομα που έχουν ήδη προσκληθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms opened for it stay closed, to the people already invited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas abiertas para él siguen cerradas para las personas ya invitadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitä varten avatut huoneet pysyvät suljettuina jo kutsutuille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les salons ouverts pour lui restent fermés pour les personnes déjà invitées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרים שנפתחו עבורה נשארים סגורים, לאנשים שכבר הוזמנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए खोले गए रूम बंद रहते हैं, उन लोगों के लिए जिन्हें पहले ही आमंत्रित किया जा चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe otvorene za nju ostaju zatvorene za ljude koji su već pozvani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzá megnyitott szobák zárva maradnak a már meghívott emberek számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room yang dibuka untuknya tetap tertutup, bagi orang yang sudah diundang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stanze aperte per il gruppo restano chiuse, per le persone già invitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループ向けに開いたルームは、すでに招待された人に対しても閉じたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹으로 열린 룸은 이미 초대된 사람들에게도 닫힌 상태로 유지돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിനായി തുറന്ന റൂമുകൾ, ഇതിനകം ക്ഷണിച്ചവർക്ക് അടഞ്ഞുതന്നെ തുടരും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik yang dibuka untuknya kekal tertutup, kepada orang yang sudah dijemput."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rom som er åpnet for den, forblir stengt for dem som allerede er invitert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms die ervoor zijn geopend blijven gesloten voor de mensen die al zijn uitgenodigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje otwarte dla tej grupy pozostaną zamknięte dla osób, które już zaproszono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas abertas para ele continuam fechadas para as pessoas já convidadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas abertas para ele continuam fechadas, para as pessoas já convidadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerele deschise pentru el rămân închise, pentru persoanele deja invitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые для неё комнаты останутся закрытыми для уже приглашённых людей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosti otvorené pre ňu zostanú zatvorené pre ľudí, ktorí už boli pozvaní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum som öppnats för den förblir stängda för dem som redan är inbjudna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்காகத் திறக்கப்பட்ட அறைகள், ஏற்கெனவே அழைக்கப்பட்டவர்களுக்கு மூடியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని కోసం తెరిచిన రూమ్‌లు, ఇప్పటికే ఆహ్వానించబడిన వారికి మూసివేసి ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องที่เปิดไว้สำหรับกลุ่มนี้จะยังปิดอยู่สำหรับคนที่ได้รับเชิญแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu grup için açılan odalar kapalı kalır; yalnızca zaten davet edilmiş kişilere açıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнати, відкриті для неї, залишаються закритими для вже запрошених людей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے لیے کھولے گئے رومز ان لوگوں کے لیے بند رہتے ہیں جنہیں پہلے مدعو کیا جا چکا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phòng đã mở cho nhóm vẫn đóng với những người đã được mời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为它开启的房间对已受邀的人仍保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為它開設的聊天室對已受邀的人仍維持關閉。"
          }
        }
      }
    },
