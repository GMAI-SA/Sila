    "guest.banner.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القراءة متاحة للجميع. الانضمام هو ما يتيح لك الرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়া সবার জন্য খোলা। উত্তর দিতে হলে যোগ দিতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegir és obert a tothom. Unir-te és el que et permet respondre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číst může každý. Až po připojení můžeš odpovídat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan læse med. Først når du deltager, kan du svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen steht allen offen. Erst mit dem Beitritt kannst du antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάγνωση είναι ανοιχτή σε όλους. Η εγγραφή σου επιτρέπει να απαντάς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading is open to everyone. Joining is what lets you answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer está abierto a todos. Unirte es lo que te permite responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukeminen on avointa kaikille. Liittyminen antaa sinun vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture est ouverte à tous. Rejoindre Known vous permet de répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקריאה פתוחה לכולם. הצטרפות היא מה שמאפשר לך להשיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ना सबके लिए खुला है। जुड़ने से ही आप जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitanje je otvoreno svima. Pridruživanje ti omogućuje da odgovaraš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvasni mindenki olvashat. A csatlakozással válaszolhatsz is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca terbuka untuk semua. Bergabung memungkinkanmu menjawab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere è aperto a tutti. Iscriversi è ciò che ti permette di rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧は誰でもできます。参加すると返信もできるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기는 누구에게나 열려 있어요. 가입해야 답할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വായന എല്ലാവർക്കും തുറന്നതാണ്. ചേർന്നാൽ മാത്രമേ മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca terbuka kepada semua orang. Menyertai membolehkan anda menjawab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan lese. Å bli med er det som lar deg svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezen staat open voor iedereen. Door je aan te melden kun je antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytać może każdy. Dołączenie pozwala odpowiadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler é aberto a todos. Entrar é o que permite que você responda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler está aberto a todos. Entrar é o que lhe permite responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirea este deschisă tuturor. Alăturarea îți permite să răspunzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать может каждый. Чтобы отвечать, нужно присоединиться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítať môže každý. Odpovedať môžeš až po pripojení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att läsa är öppet för alla. Att gå med är det som låter dig svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படிப்பது அனைவருக்கும் திறந்தது. பதிலளிக்க சேர வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చదవడం అందరికీ తెరిచి ఉంది. సమాధానం ఇవ్వాలంటే చేరాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนอ่านได้ การเข้าร่วมคือสิ่งที่ทำให้คุณตอบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okumak herkese açık. Yanıt verebilmeniz için katılmanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читати можна всім. Щоб відповідати, потрібно приєднатися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پڑھنا سب کے لیے کھلا ہے۔ جواب دینے کے لیے شامل ہونا ضروری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng đọc được. Tham gia mới cho phép bạn trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读对所有人开放，加入后才能回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能閱讀，加入後才能回應。"
          }
        }
      }
    },
    "guest.banner.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تتصفح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ঘুরে দেখছেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estàs mirant"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen se rozhlížíš"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kigger dig omkring"
          }
        },
        "de": {
          "stringUnit": {
