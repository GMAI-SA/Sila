        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga kommande evenemang. Starta ett."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரவிருக்கும் நிகழ்வுகள் இல்லை. ஒன்றைத் தொடங்குங்கள்."
