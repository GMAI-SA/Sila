    "feed.tab.profile.hint": {
      "comment": "VoiceOver hint for the profile tab.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفك ومنشوراتك وإعدادات حسابك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইল, পোস্ট ও অ্যাকাউন্ট সেটিংস"
