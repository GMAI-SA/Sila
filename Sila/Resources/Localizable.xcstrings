    "notifications.sentence.vouchExpiring": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تزكيتك قريبًا — وثّق هويتك لتواصل النشر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সুপারিশ শিগগিরই শেষ হবে — পোস্ট করা চালিয়ে যেতে পরিচয় যাচাই করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu aval s'acaba aviat: verifica la teva identitat per continuar publicant"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvé ručení brzy skončí – ověř svou totožnost, abys mohl dál psát"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din garanti ophører snart – verificér din identitet for at kunne blive ved med at slå op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bürgschaft endet bald – verifiziere deine Identität, um weiter zu posten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγύησή σου λήγει σύντομα — επαλήθευσε την ταυτότητά σου για να συνεχίσεις να δημοσιεύεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vouch ends soon — verify your identity to keep posting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu aval termina pronto: verifica tu identidad para seguir publicando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Takuusi päättyy pian – vahvista henkilöllisyytesi jatkaaksesi julkaisemista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre caution se termine bientôt — vérifiez votre identité pour continuer à publier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערבות שלך מסתיימת בקרוב — אמת את זהותך כדי להמשיך לפרסם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वाउच जल्द खत्म होगा — पोस्ट करते रहने के लिए अपनी पहचान सत्यापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje jamstvo uskoro završava — potvrdi svoj identitet da nastaviš objavljivati"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezességed hamarosan véget ér – hitelesítsd a személyazonosságodat, hogy továbbra is írhass"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminanmu segera berakhir — verifikasi identitasmu agar tetap bisa memposting"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua garanzia termina presto: verifica la tua identità per continuare a pubblicare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保証がまもなく終了します。投稿を続けるには本人確認をしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보증이 곧 종료돼요. 계속 게시하려면 신원을 인증하세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഉറപ്പ് ഉടൻ അവസാനിക്കും — പോസ്റ്റ് ചെയ്യുന്നത് തുടരാൻ ഐഡന്റിറ്റി പരിശോധിക്കുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaminan anda akan berakhir tidak lama lagi — sahkan identiti anda untuk terus menyiar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantien din avsluttes snart. Verifiser identiteten din for å fortsette å publisere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je garantie loopt binnenkort af: verifieer je identiteit om te kunnen blijven posten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje poręczenie wkrótce się kończy — zweryfikuj tożsamość, aby dalej publikować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu aval termina em breve: verifique sua identidade para continuar postando"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu aval termina em breve — verifique a sua identidade para continuar a publicar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanția ta se încheie curând — verifică-ți identitatea ca să poți posta în continuare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство скоро закончится — пройдите проверку личности, чтобы продолжать писать"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ručenie sa čoskoro končí — over svoju identitu, aby si mohol ďalej písať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt intygande upphör snart – verifiera din identitet för att fortsätta publicera"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உத்தரவாதம் விரைவில் முடிகிறது — தொடர்ந்து இட உங்கள் அடையாளத்தைச் சரிபாருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హామీ త్వరలో ముగుస్తుంది — పోస్ట్ చేస్తూ ఉండటానికి మీ గుర్తింపును ధృవీకరించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันให้ของคุณจะสิ้นสุดเร็วๆ นี้ ยืนยันตัวตนของคุณเพื่อโพสต์ต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kefilliğiniz yakında sona eriyor; gönderi paylaşmaya devam etmek için kimliğinizi doğrulayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше поручительство скоро закінчиться — верифікуйте особу, щоб і далі публікувати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ضمانت جلد ختم ہو رہی ہے — پوسٹ کرتے رہنے کے لیے اپنی شناخت کی تصدیق کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bảo chứng của bạn sắp kết thúc — hãy xác minh danh tính để tiếp tục đăng bài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的担保即将结束，请验证身份以继续发帖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的擔保即將結束，請驗證身分以繼續發文"
          }
        }
      }
    },
    "notifications.sentence.vouchGraduated": {
      "comment": "%@ is the other person's display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وثّق %@ هويته — لم تعد مسؤولًا عنه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ নিজের পরিচয় যাচাই করেছেন — আপনি আর তাঁর জন্য দায়ী নন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha verificat la seva identitat: ja no en ets responsable"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ověřil(a) svou totožnost – už za tuto osobu neneseš odpovědnost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verificerede sin identitet – du hæfter ikke længere for vedkommende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Identität verifiziert – du bist nicht mehr für die Person verantwortlich"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο/Η %@ επαληθεύτηκε — δεν είσαι πια υπεύθυνος για αυτόν/ή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verified their identity — you're no longer answerable for them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verificó su identidad: ya no respondes por esa persona"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vahvisti henkilöllisyytensä – et ole enää vastuussa hänestä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a vérifié son identité — vous n’en êtes plus responsable"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ אימת את זהותו — אתה כבר לא אחראי לו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने अपनी पहचान सत्यापित कर ली — अब आप उनके लिए जवाबदेह नहीं हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je potvrdio/la svoj identitet — više ne odgovaraš za tu osobu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hitelesítette a személyazonosságát – már nem felelsz érte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memverifikasi identitasnya — kamu tidak lagi bertanggung jawab atasnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha verificato la propria identità: non sei più responsabile per lui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が本人確認を完了しました。あなたはもう責任を負いません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 신원을 인증했어요. 이제 그 사람에 대한 책임이 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവരുടെ ഐഡന്റിറ്റി പരിശോധിച്ചു — ഇനി നിങ്ങൾ അവർക്ക് ഉത്തരവാദിയല്ല"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mengesahkan identitinya — anda tidak lagi bertanggungjawab ke atasnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verifiserte identiteten sin. Du er ikke lenger ansvarlig for vedkommende"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft zijn of haar identiteit geverifieerd: je staat niet meer voor die persoon in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zweryfikował(a) tożsamość — nie odpowiadasz już za tę osobę"
          }
        },
        "pt-BR": {
          "stringUnit": {
