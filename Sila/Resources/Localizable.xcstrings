        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls l’animateur et les co-animateurs peuvent modifier cela."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק המארח והמארחים השותפים יכולים לשנות זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे केवल होस्ट और सह-होस्ट बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo mogu promijeniti samo domaćin i sudomaćini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt csak a házigazda és a társházigazdák módosíthatják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya host dan co-host yang bisa mengubah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo l'host e i co-host possono cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更できるのはホストと共同ホストだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트와 공동 호스트만 변경할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹോസ്റ്റിനും സഹ-ഹോസ്റ്റുകൾക്കും മാത്രമേ ഇത് മാറ്റാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya hos dan hos bersama boleh mengubah ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare verten og medvertene kan endre dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de host en co-hosts kunnen dit wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gospodarz i współgospodarze mogą to zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o anfitrião e os coanfitriões podem alterar isto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o anfitrião e os co-anfitriões podem alterar isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar gazda și coorganizatorii pot schimba asta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить это могут только ведущий и соведущие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môže to zmeniť iba hostiteľ a spoluhostitelia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara värden och medvärdarna kan ändra detta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடத்துநரும் இணை நடத்துநர்களும் மட்டுமே இதை மாற்ற முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోస్ట్, సహ-హోస్ట్‌లు మాత్రమే దీన్ని మార్చగలరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเจ้าของห้องและผู้จัดร่วมเท่านั้นที่เปลี่ยนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu yalnızca sunucu ve ortak sunucular değiştirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити це можуть лише ведучий і співведучі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے صرف میزبان اور شریک میزبان بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chủ phòng và đồng chủ trì mới đổi được mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主持人和共同主持人可以更改此项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主持人和共同主持人能變更此設定。"
          }
        }
      }
    },
    "rooms.guests.allow.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستماع إلى هذه الغرفة للأعضاء فقط الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন শুধু সদস্যরা এই রুম শুনতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix només els membres poden escoltar aquesta sala."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto místnost teď mohou poslouchat jen členové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan kun medlemmer lytte til dette rum."
