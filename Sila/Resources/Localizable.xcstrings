            "state": "translated",
            "value": "Obnoví tvůj účet a vezme tě do aplikace Known"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdaterer din konto og tager dig ind i Known"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert dein Konto und bringt dich zu Known"
          }
        },
