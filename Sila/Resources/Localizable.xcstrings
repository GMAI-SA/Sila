        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدخلها سواك ومن تدعوهم، ولن تظهر في قائمة أي شخص آخر. أما من يتحدث فيحدده الجمهور أعلاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনি এবং আপনার আমন্ত্রিতরা ঢুকতে পারে। রুমটি আর কারও তালিকায় দেখা যাবে না। কে কথা বলতে পারবে তা এখনও উপরের শ্রোতা ঠিক করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només tu i les persones que convidis hi podeu entrar. La sala no apareixerà a la llista de ningú més. Qui pot parlar ho continua decidint l'audiència de dalt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstoupit můžeš jen ty a lidé, které pozveš. Místnost se nezobrazí v seznamu nikomu jinému. O tom, kdo smí mluvit, rozhoduje stále publikum výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du og de folk, du inviterer, kan komme ind. Rummet vises ikke på nogen andres liste. Hvem der må tale, afgøres stadig af målgruppen ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du und die von dir eingeladenen Personen können hinein. Der Raum erscheint in keiner anderen Liste. Wer sprechen darf, entscheidet weiterhin die Zielgruppe oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο εσύ και τα άτομα που προσκαλείς μπορείτε να μπείτε. Η αίθουσα δεν θα εμφανίζεται στη λίστα κανενός άλλου. Το ποιος μπορεί να μιλήσει εξακολουθεί να καθορίζεται από το κοινό παραπάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you and the people you invite can enter. The room will not appear in anyone else's list. Who may speak is still decided by the audience above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú y las personas que invites podéis entrar. La sala no aparecerá en la lista de nadie más. Quién puede hablar lo sigue decidiendo la audiencia de arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sinä ja kutsumasi ihmiset pääsevät sisään. Huone ei näy kenenkään muun luettelossa. Kuka saa puhua, päätetään yhä yllä olevalla yleisöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls vous et les personnes que vous invitez peuvent entrer. Le salon n’apparaîtra dans la liste de personne d’autre. Qui peut parler reste décidé par l’audience ci-dessus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק אתה והאנשים שאתה מזמין יכולים להיכנס. החדר לא יופיע ברשימה של אף אחד אחר. מי רשאי לדבר עדיין נקבע לפי הקהל שלמעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आप और आपके आमंत्रित लोग अंदर आ सकते हैं। रूम किसी और की सूची में नहीं दिखेगा। कौन बोल सकता है, यह ऊपर की ऑडियंस ही तय करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ti i ljudi koje pozoveš možete ući. Soba se neće pojaviti ničijem drugom popisu. Tko smije govoriti i dalje određuje publika iznad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak te és a meghívottaid léphetnek be. A szoba senki más listáján nem jelenik meg. Hogy ki szólalhat meg, azt továbbra is a fenti közönség dönti el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kamu dan orang yang kamu undang yang bisa masuk. Room tidak akan muncul di daftar siapa pun. Siapa yang boleh berbicara tetap ditentukan oleh audiens di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possono entrare solo tu e le persone che inviti. La stanza non comparirà nell'elenco di nessun altro. Chi può parlare lo decide comunque il pubblico qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入れるのは、あなたと招待した人だけです。ルームはほかの人のリストには表示されません。発言できる人は、上の範囲で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나와 내가 초대한 사람만 입장할 수 있어요. 이 룸은 다른 사람의 목록에 나타나지 않아요. 말할 수 있는 사람은 위의 대상이 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കും നിങ്ങൾ ക്ഷണിക്കുന്നവർക്കും മാത്രമേ പ്രവേശിക്കാനാകൂ. ഈ റൂം മറ്റാരുടെയും പട്ടികയിൽ വരില്ല. ആർക്ക് സംസാരിക്കാമെന്നത് ഇപ്പോഴും മുകളിലെ പ്രേക്ഷകരാണ് തീരുമാനിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anda dan orang yang anda jemput boleh masuk. Bilik tidak akan muncul dalam senarai orang lain. Siapa yang boleh bercakap masih ditentukan oleh khalayak di atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du og de du inviterer, kan komme inn. Rommet vises ikke i noen andres liste. Hvem som kan snakke, avgjøres fortsatt av målgruppen ovenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen jij en de mensen die je uitnodigt kunnen binnenkomen. De room verschijnt niet in andermans lijst. Wie mag spreken wordt nog steeds bepaald door het publiek hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wejść możesz tylko Ty i osoby, które zaprosisz. Pokój nie pojawi się na niczyjej liście. O tym, kto może mówić, nadal decyduje powyższa grupa odbiorców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você e as pessoas que você convidar podem entrar. A sala não aparecerá na lista de mais ninguém. Quem pode falar continua sendo definido pelo público acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você e as pessoas que convidar podem entrar. A sala não aparecerá na lista de mais ninguém. Quem pode falar continua a ser decidido pelo público acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar tu și oamenii pe care îi inviți puteți intra. Camera nu va apărea în lista nimănui altcuiva. Cine poate vorbi este decis tot de publicul de mai sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти можете только вы и приглашённые вами люди. Комната не появится в чужих списках. Кто может говорить, по-прежнему решает аудитория выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstúpiť môžeš len ty a ľudia, ktorých pozveš. Miestnosť sa nezobrazí v zozname nikomu inému. O tom, kto môže hovoriť, stále rozhoduje publikum vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara du och de du bjuder in kan gå in. Rummet visas inte i någon annans lista. Vem som får tala avgörs fortfarande av målgruppen ovan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்களும் நீங்கள் அழைப்பவர்களும் மட்டுமே நுழையலாம். இந்த அறை வேறு யாருடைய பட்டியலிலும் தோன்றாது. யார் பேசலாம் என்பதை மேலுள்ள பார்வையாளர்களே இன்னும் தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు, మీరు ఆహ్వానించిన వారు మాత్రమే ప్రవేశించగలరు. ఈ రూమ్ మరెవరి జాబితాలోనూ కనిపించదు. ఎవరు మాట్లాడవచ్చో పై ప్రేక్షకులే నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะคุณและคนที่คุณเชิญเท่านั้นที่เข้าได้ ห้องจะไม่ปรากฏในรายการของคนอื่น ใครพูดได้ยังกำหนดโดยกลุ่มผู้ชมด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca siz ve davet ettiğiniz kişiler girebilir. Oda kimsenin listesinde görünmez. Kimin konuşabileceğine yine yukarıdaki kitle karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійти можете лише ви і запрошені вами люди. Кімната не з’явиться в чиємусь списку. Хто може говорити, як і раніше, визначає аудиторія вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ اور آپ کے مدعو لوگ داخل ہو سکتے ہیں۔ روم کسی اور کی فہرست میں نظر نہیں آئے گا۔ کون بول سکتا ہے یہ اب بھی اوپر کے ناظرین طے کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn và những người bạn mời mới vào được. Phòng sẽ không xuất hiện trong danh sách của ai khác. Ai được phát biểu vẫn do đối tượng ở trên quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你和你邀请的人可以进入。该房间不会出现在其他人的列表中。谁可以发言仍由上方的受众决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你和你邀請的人能進入。聊天室不會出現在其他人的列表中。誰能發言仍由上方的對象範圍決定。"
          }
        }
      }
    },
    "rooms.create.open.explanation": {
      "comment": "Explanation under the toggle when it is off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص الاستماع. والجمهور أعلاه يحدد من يمكنه التحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ শুনতে পারে। কে কথা বলতে পারবে তা উপরের শ্রোতা ঠিক করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tothom pot escoltar. L'audiència de dalt decideix qui pot parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslouchat může každý. Publikum výše určuje, kdo smí mluvit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan lytte. Målgruppen ovenfor afgør, hvem der må tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann zuhören. Die Zielgruppe oben entscheidet, wer sprechen darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο καθένας μπορεί να ακούσει. Το κοινό παραπάνω καθορίζει ποιος μπορεί να μιλήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can listen. The audience above decides who may speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede escuchar. La audiencia de arriba decide quién puede hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuka tahansa voi kuunnella. Yllä oleva yleisö päättää, kuka saa puhua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut écouter. L’audience ci-dessus décide qui peut parler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול להאזין. הקהל שלמעלה קובע מי רשאי לדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी सुन सकता है। कौन बोल सकता है, यह ऊपर की ऑडियंस तय करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svatko može slušati. Publika iznad određuje tko smije govoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bárki hallgathat. A fenti közönség dönti el, ki szólalhat meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun bisa mendengarkan. Audiens di atas menentukan siapa yang boleh berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può ascoltare. Il pubblico qui sopra decide chi può parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰でも聴けます。発言できる人は、上の範囲で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 들을 수 있어요. 위의 대상이 말할 수 있는 사람을 결정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആർക്കും കേൾക്കാം. ആർക്ക് സംസാരിക്കാമെന്ന് മുകളിലെ പ്രേക്ഷകർ തീരുമാനിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa boleh mendengar. Khalayak di atas menentukan siapa boleh bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kan lytte. Målgruppen ovenfor avgjør hvem som kan snakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan luisteren. Het publiek hierboven bepaalt wie mag spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może słuchać. Powyższa grupa odbiorców decyduje, kto może mówić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode ouvir. O público acima define quem pode falar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode ouvir. O público acima decide quem pode falar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate asculta. Publicul de mai sus decide cine poate vorbi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушать может любой. Кто может говорить, решает аудитория выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počúvať môže ktokoľvek. O tom, kto môže hovoriť, rozhoduje publikum vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kan lyssna. Målgruppen ovan avgör vem som får tala."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "யார் வேண்டுமானாலும் கேட்கலாம். யார் பேசலாம் என்பதை மேலுள்ள பார்வையாளர்கள் தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా వినవచ్చు. ఎవరు మాట్లాడవచ్చో పై ప్రేక్షకులు నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็ฟังได้ กลุ่มผู้ชมด้านบนกำหนดว่าใครพูดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes dinleyebilir. Kimin konuşabileceğine yukarıdaki kitle karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухати може кожен. Хто може говорити, визначає аудиторія вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی سن سکتا ہے۔ اوپر کے ناظرین طے کرتے ہیں کہ کون بول سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể nghe. Đối tượng ở trên quyết định ai được phát biểu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以收听。谁可以发言由上方的受众决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都能收聽。上方的對象範圍決定誰能發言。"
          }
        }
      }
    },
    "rooms.create.repeatWeekly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّرها كل أسبوع"
          }
        },
        "bn": {
