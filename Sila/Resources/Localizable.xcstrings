    "guest.join.room.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرف لا تُسجَّل أبدًا. الحضور هو الطريقة الوحيدة لسماعها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম কখনও রেকর্ড করা হয় না। শোনার একমাত্র উপায় হলো তাতে থাকা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sales no s'enregistren mai. Ser-hi és l'única manera d'escoltar-les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnosti se nikdy nenahrávají. Poslechnout si je lze jen přímo v nich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum bliver aldrig optaget. Den eneste måde at høre et på er at være med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume werden nie aufgezeichnet. Dabeisein ist die einzige Möglichkeit, sie zu hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αίθουσες δεν ηχογραφούνται ποτέ. Το να είσαι μέσα είναι ο μόνος τρόπος να την ακούσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms are never recorded. Being in one is the only way to hear it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las salas nunca se graban. Estar dentro es la única forma de oírlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huoneita ei koskaan tallenneta. Mukana oleminen on ainoa tapa kuulla se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les salons ne sont jamais enregistrés. Y être est le seul moyen de l’entendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדרים לעולם לא מוקלטים. להיות בחדר זו הדרך היחידה לשמוע אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम कभी रिकॉर्ड नहीं होते। उन्हें सुनने का एकमात्र तरीका उसमें होना है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe se nikada ne snimaju. Biti u jednoj jedini je način da je čuješ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szobákat soha nem rögzítjük. Csak bent lehet hallani őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Room tidak pernah direkam. Berada di dalamnya adalah satu-satunya cara mendengarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stanze non vengono mai registrate. Esserci dentro è l'unico modo per ascoltarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルームは録音されません。聴く方法は、その場にいることだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸은 절대 녹음되지 않아요. 직접 참여하는 것이 들을 수 있는 유일한 방법이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂമുകൾ ഒരിക്കലും റെക്കോർഡ് ചെയ്യില്ല. അതിൽ ഉണ്ടായിരിക്കുക എന്നതാണ് കേൾക്കാനുള്ള ഏക വഴി."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik tidak pernah dirakam. Berada di dalamnya ialah satu-satunya cara untuk mendengarnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rom tas aldri opp. Å være med er den eneste måten å høre det på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooms worden nooit opgenomen. Erbij zijn is de enige manier om het te horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoje nigdy nie są nagrywane. Jedyny sposób, by je usłyszeć, to w nich być."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas. Estar em uma é a única forma de ouvi-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As salas nunca são gravadas. Estar numa é a única forma de a ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerele nu sunt înregistrate niciodată. Să fii într-una este singura cale de a o auzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комнаты никогда не записываются. Услышать их можно, только находясь внутри."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Miestnosti sa nikdy nenahrávajú. Počuť ich môžeš, len keď v nich si."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rum spelas aldrig in. Att vara med i ett är enda sättet att höra det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைகள் ஒருபோதும் பதிவு செய்யப்படுவதில்லை. அதில் இருப்பதே கேட்பதற்கான ஒரே வழி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్‌లు ఎప్పుడూ రికార్డ్ చేయబడవు. అందులో ఉండటమే వినడానికి ఏకైక మార్గం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องไม่เคยถูกบันทึกเสียง การอยู่ในห้องคือวิธีเดียวที่จะได้ยิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odalar asla kaydedilmez. İçinde olmak, duymanın tek yolu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кімнати ніколи не записуються. Бути в кімнаті — єдиний спосіб її почути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رومز کبھی ریکارڈ نہیں ہوتے۔ اسے سننے کا واحد طریقہ اس میں موجود ہونا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng không bao giờ được ghi âm. Có mặt trong phòng là cách duy nhất để nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间从不录音。身处其中是听到内容的唯一方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天室絕不會被錄音，進入聊天室是聽到內容的唯一方式。"
          }
        }
      }
    },
