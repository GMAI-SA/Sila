          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjätunnuksessa on 3–20 merkkiä: kirjaimia, numeroita ja alaviivoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants font 3 à 20 caractères : lettres, chiffres et tirets bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם משתמש הוא 3–20 תווים של אותיות, ספרות וקווים תחתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हैंडल में 3–20 अक्षर होते हैं: अक्षर, संख्याएँ और अंडरस्कोर।"
