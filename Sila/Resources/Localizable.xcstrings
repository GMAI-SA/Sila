    "auth.wall.verified.message": {
      "comment": "Wall body once verified.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا بك في «معروف». كل حساب تراه هنا يعود إلى شخص حقيقي — موثّق، أو مُزكّى من موثّق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-এ স্বাগতম। এখানে আপনি যত অ্যাকাউন্ট দেখবেন সবই একজন আসল মানুষের — ভেরিফায়েড, বা কোনো ভেরিফায়েড মানুষের সুপারিশে আসা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et donem la benvinguda a Known. Cada compte que hi veuràs pertany a una persona real: verificada, o avalada per una que ho és."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítej v aplikaci Known. Každý účet, který tu uvidíš, patří skutečné osobě – ověřené, nebo takové, za kterou někdo ručí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Known. Hver eneste konto, du ser her, tilhører et rigtigt menneske – verificeret eller indestået for af et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Known. Jedes Konto, das du hier siehst, gehört einem echten Menschen – verifiziert oder von einem verifizierten Menschen bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλώς ήρθες στο Known. Κάθε λογαριασμός που θα δεις εδώ ανήκει σε πραγματικό άνθρωπο — επαληθευμένο ή εγγυημένο από κάποιον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Known. Every account you'll see here belongs to a real person — verified, or vouched for by one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a Known. Cada cuenta que verás aquí pertenece a una persona real: verificada o avalada por una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervetuloa Knowniin. Jokainen täällä näkemäsi tili kuuluu oikealle ihmiselle – joko vahvistetulle tai vahvistetun takaamalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue sur Known. Chaque compte que vous verrez ici appartient à une vraie personne — vérifiée, ou garantie par l’une d’elles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוך בואך ל-Known. כל חשבון שתראה כאן שייך לאדם אמיתי — מאומת, או כזה שאדם מאומת ערב לו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known में स्वागत है। यहाँ दिखने वाला हर अकाउंट एक असली व्यक्ति का है — खुद सत्यापित, या किसी सत्यापित व्यक्ति द्वारा गारंटीशुदा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro došao/došla u aplikaciju Known. Svaki račun koji ovdje vidiš pripada stvarnoj osobi — potvrđenoj ili onoj za koju je netko jamčio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv a Knownban. Itt minden fiók egy valódi emberé – hitelesítetté, vagy olyané, akiért egy hitelesített ember kezeskedett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di Known. Setiap akun yang kamu lihat di sini milik orang sungguhan — terverifikasi, atau dijamin oleh orang yang terverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto su Known. Ogni account che vedrai qui appartiene a una persona reale: verificata, o garantita da una persona verificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownへようこそ。ここで見かけるアカウントはすべて実在の人のものです。本人が認証したか、認証済みの人が保証しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known에 오신 것을 환영해요. 여기서 보게 될 모든 계정은 실제 사람의 것이에요. 직접 인증했거나, 인증된 사람이 보증한 계정이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-ലേക്ക് സ്വാഗതം. ഇവിടെ കാണുന്ന ഓരോ അക്കൗണ്ടും ഒരു യഥാർഥ വ്യക്തിയുടേതാണ് — പരിശോധിച്ചതോ, ഒരാൾ ഉറപ്പുനൽകിയതോ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang ke Known. Setiap akaun yang anda lihat di sini milik orang sebenar — yang disahkan, atau yang dijamin oleh seseorang yang disahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Known. Hver konto du ser her, tilhører et ekte menneske, verifisert eller garantert for av et."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij Known. Elk account dat je hier ziet is van een echt persoon: geverifieerd, of gegarandeerd door iemand die dat is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj w Known. Każde konto, które tu zobaczysz, należy do prawdziwej osoby — zweryfikowanej lub poręczonej przez taką osobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao Known. Toda conta que você verá aqui pertence a uma pessoa real, verificada ou avalizada por alguém verificado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo à Known. Todas as contas que vai ver aqui pertencem a uma pessoa real — verificada, ou avalizada por uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bun venit pe Known. Fiecare cont pe care îl vezi aici aparține unei persoane reale — verificate sau garantate de una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Known. Каждый аккаунт здесь принадлежит реальному человеку — проверенному или тому, за кого поручился проверенный."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitaj v Known. Každý účet, ktorý tu uvidíš, patrí skutočnému človeku — overenému alebo takému, za ktorého sa niekto zaručil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen till Known. Varje konto du ser här tillhör en verklig person – verifierad, eller intygad av en sådan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Known-க்கு வரவேற்கிறோம். இங்கே நீங்கள் காணும் ஒவ்வொரு கணக்கும் உண்மையான ஒருவருடையது — சரிபார்க்கப்பட்டவர் அல்லது அவரால் உறுதிசெய்யப்பட்டவர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownకు స్వాగతం. ఇక్కడ మీరు చూసే ప్రతి ఖాతా నిజమైన వ్యక్తిదే — ధృవీకరించబడినవారు, లేదా వారిలో ఒకరు హామీ ఇచ్చినవారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับสู่ Known ทุกบัญชีที่คุณเห็นที่นี่เป็นของคนจริง ที่ยืนยันตัวตนแล้ว หรือมีคนยืนยันให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known'a hoş geldiniz. Burada göreceğiniz her hesap gerçek bir kişiye ait; ya doğrulanmış ya da doğrulanmış biri ona kefil olmuş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ласкаво просимо до Known. Кожен обліковий запис, який ви тут побачите, належить реальній людині — верифікованій або такій, за яку поручилася верифікована людина."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known میں خوش آمدید۔ یہاں آپ جو بھی اکاؤنٹ دیکھیں گے وہ کسی حقیقی شخص کا ہے — تصدیق شدہ، یا کسی تصدیق شدہ شخص کا ضمانت یافتہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với Known. Mọi tài khoản bạn thấy ở đây đều thuộc về một người thật — đã xác minh, hoặc được một người như vậy bảo chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎来到 Known。你在这里看到的每个账户都属于真实的人，他们或已通过验证，或由已验证的人担保。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎來到 Known。你在這裡看到的每個帳號都屬於真人，不是經過驗證，就是由真人擔保。"
          }
        }
      }
    },
