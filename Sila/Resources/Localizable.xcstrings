        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing someone applies to this room only. It isn't a block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar a alguien solo vale para esta sala. No es un bloqueo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaminen koskee vain tätä huonetta. Se ei ole esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer quelqu’un ne vaut que pour ce salon. Ce n’est pas un blocage."
