    "profile.badge.muted": {
      "comment": "Badge on a muted account's profile.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted"
          }
        }
      }
    },
    "profile.badge.muted.accessibilityLabel": {
      "comment": "VoiceOver reading of the muted badge. Muting is silent and the other person is never told.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد كتمت هذا الحساب. منشوراته مخفية عنك. ولم يُبلَّغ بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have muted this account. Their posts are hidden from your feeds. They were not told."
          }
        }
      }
    },
    "profile.blocked.subtitle": {
      "comment": "What the block did. Names the severed follow and the silence, both of which the user consented to.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأي منكما رؤية منشورات الآخر، وأُزيلت أي متابعة بينكما. ولم يُبلَّغ بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither of you can see the other's posts, and any follow between you was removed. They were not told."
          }
        }
      }
    },
    "profile.blocked.title": {
      "comment": "Shown instead of a blocked account's profile. %@ is their display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد حظرت %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You blocked %@"
          }
        }
      }
    },
