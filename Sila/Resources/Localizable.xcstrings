        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto údaje sa nezhodujú s tým, čo zadala osoba, ktorá poslala odkaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgifterna stämmer inte med vad personen som skickade länken angav."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பை அனுப்பியவர் உள்ளிட்டவற்றுடன் இந்த விவரங்கள் பொருந்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వివరాలు లింక్ పంపిన వ్యక్తి నమోదు చేసిన వాటికి సరిపోలడం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลเหล่านี้ไม่ตรงกับที่ผู้ส่งลิงก์กรอกไว้"
