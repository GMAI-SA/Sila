    "rooms.create.guests.a11yHint": {
      "comment": "Accessibility hint on the guest field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب المعرّفات مفصولة بفواصل. يمكنك دعوة آخرين لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমা দিয়ে আলাদা করে হ্যান্ডেল লিখুন। পরে আরও মানুষকে আমন্ত্রণ জানাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu identificadors separats per comes. Més endavant podràs convidar més persones."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Piš handly oddělené čárkami. Další lidi můžeš pozvat později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv handles adskilt af kommaer. Du kan invitere flere senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Handles durch Kommas getrennt ein. Du kannst später weitere Personen einladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολόγησε handle χωρισμένα με κόμματα. Μπορείς να προσκαλέσεις περισσότερα άτομα αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type handles separated by commas. You can invite more people later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe identificadores separados por comas. Puedes invitar a más personas después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita käyttäjätunnukset pilkuilla erotettuina. Voit kutsua lisää ihmisiä myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des identifiants séparés par des virgules. Vous pourrez inviter d’autres personnes plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד שמות משתמש מופרדים בפסיקים. אפשר להזמין עוד אנשים מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हैंडल कॉमा से अलग करके टाइप करें। आप बाद में और लोगों को आमंत्रित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši handle odvojene zarezima. Više ljudi možeš pozvati kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd be az @neveket vesszővel elválasztva. Később több embert is meghívhatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik handle dipisahkan koma. Kamu bisa mengundang lebih banyak orang nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi gli handle separati da virgole. Potrai invitare altre persone più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをカンマで区切って入力します。あとから招待を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분해 핸들을 입력하세요. 나중에 더 초대할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹാൻഡിലുകൾ കോമ ഉപയോഗിച്ച് വേർതിരിച്ച് ടൈപ്പ് ചെയ്യുക. കൂടുതൽ ആളുകളെ പിന്നീട് ക്ഷണിക്കാം."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip nama pengendali dipisahkan dengan koma. Anda boleh menjemput lebih ramai orang kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv brukernavn atskilt med komma. Du kan invitere flere senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ handles gescheiden door komma's. Je kunt later meer mensen uitnodigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz uchwyty oddzielone przecinkami. Później możesz zaprosić więcej osób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite @usuários separados por vírgulas. Você pode convidar mais pessoas depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva identificadores separados por vírgulas. Pode convidar mais pessoas depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie handle-uri separate prin virgule. Poți invita mai mulți oameni mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имена пользователей через запятую. Позже можно пригласить ещё людей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš používateľské mená oddelené čiarkami. Ďalších ľudí môžeš pozvať neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv användarnamn åtskilda med kommatecken. Du kan bjuda in fler senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காற்புள்ளியால் பிரித்து ஹேண்டில்களைத் தட்டச்சு செய்யுங்கள். மேலும் மக்களைப் பிறகு அழைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హ్యాండిల్‌లను కామాలతో వేరు చేసి టైప్ చేయండి. తర్వాత మరింత మందిని ఆహ్వానించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์แฮนเดิลคั่นด้วยเครื่องหมายจุลภาค คุณเชิญเพิ่มได้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adlarını virgülle ayırarak yazın. Daha sonra daha fazla kişi davet edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть @імена, розділені комами. Більше людей можна запросити пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہینڈلز کوما سے الگ کر کے ٹائپ کریں۔ آپ بعد میں مزید لوگوں کو مدعو کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ các tên người dùng cách nhau bằng dấu phẩy. Bạn có thể mời thêm người sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入用户名，以逗号分隔。之后还可以邀请更多人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入以逗號分隔的代號。之後可以邀請更多人。"
          }
        }
      }
    },
