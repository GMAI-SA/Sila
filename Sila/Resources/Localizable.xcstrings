    "rooms.live.hostMenu.a11yHint": {
      "comment": "VoiceOver hint for the host menu.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوة للتحدث، أو نقل إلى المستمعين، أو إخراج من هذه الغرفة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা বলতে আমন্ত্রণ জানান, শ্রোতাদের মধ্যে সরান, বা এই রুম থেকে সরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Convida a parlar, passa als oients o expulsa d'aquesta sala"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvat mluvit, přesunout k posluchačům nebo odebrat z této místnosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitér til at tale, flyt til lyttere eller fjern fra dette rum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sprechen einladen, zu Zuhörern verschieben oder aus diesem Raum entfernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσκληση να μιλήσει, μετακίνηση στους ακροατές ή αφαίρεση από αυτή την αίθουσα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite to speak, move to listeners, or remove from this room"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitar a hablar, pasar a oyentes o expulsar de esta sala"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsu puhumaan, siirrä kuuntelijoihin tai poista tästä huoneesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter à parler, déplacer vers les auditeurs, ou retirer de ce salon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן לדבר, העבר למאזינים, או הסר מהחדר הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलने के लिए आमंत्रित करें, श्रोताओं में भेजें, या इस रूम से हटाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozovi da govori, premjesti među slušatelje ili ukloni iz ove sobe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meghívás beszélgetésre, áthelyezés a hallgatók közé, vagy eltávolítás a szobából"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undang berbicara, pindahkan ke pendengar, atau keluarkan dari room ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a parlare, sposta tra gli ascoltatori o rimuovi da questa stanza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発言に招待、聴く側に移す、またはこのルームから削除します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발언 초대, 청취자로 이동 또는 이 룸에서 내보내기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംസാരിക്കാൻ ക്ഷണിക്കുക, ശ്രോതാക്കളിലേക്ക് മാറ്റുക, അല്ലെങ്കിൽ ഈ റൂമിൽ നിന്ന് നീക്കം ചെയ്യുക"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemput bercakap, pindah ke pendengar, atau alih keluar daripada bilik ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter til å snakke, flytt til lyttere eller fjern fra dette rommet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigen om te spreken, naar luisteraars verplaatsen of uit deze room verwijderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproś do mówienia, przenieś do słuchaczy lub usuń z tego pokoju"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convidar para falar, mover para os ouvintes ou remover desta sala"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Convidar a falar, mover para os ouvintes ou remover desta sala"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invită să vorbească, mută printre ascultători sau scoate din această cameră"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пригласить говорить, перевести в слушатели или удалить из этой комнаты"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvať k reči, presunúť medzi poslucháčov alebo odstrániť z tejto miestnosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjud in att tala, flytta till lyssnare eller ta bort från det här rummet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச அழை, கேட்பவர்களுக்கு நகர்த்து அல்லது இந்த அறையிலிருந்து நீக்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాట్లాడటానికి ఆహ్వానించండి, శ్రోతలకు తరలించండి, లేదా ఈ రూమ్ నుండి తొలగించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชิญให้พูด ย้ายไปเป็นผู้ฟัง หรือนำออกจากห้องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmaya davet et, dinleyicilere taşı veya bu odadan çıkar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросити говорити, перевести до слухачів або вилучити з цієї кімнати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولنے کی دعوت دیں، سننے والوں میں منتقل کریں، یا اس روم سے ہٹائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mời phát biểu, chuyển về người nghe, hoặc xóa khỏi phòng này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请发言、移到听众席，或移出此房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請發言、移到收聽者，或從此聊天室移除"
          }
        }
      }
    },
