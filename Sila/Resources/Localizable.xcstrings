        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge numărul tău de contact. Cere și parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ваш контактный номер. Тоже требует пароль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni tvoje kontaktné číslo. Vyžaduje aj tvoje heslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar ditt kontaktnummer. Kräver också ditt lösenord."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொடர்பு எண்ணை நீக்கும். உங்கள் கடவுச்சொல்லும் தேவை."
