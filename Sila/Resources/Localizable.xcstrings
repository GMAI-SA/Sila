    "profile.timeline.scope": {
      "comment": "Says the timeline is top-level posts only — replies are neither listed nor counted. Shown even when the list is empty, because the exclusion is a fact about the list, not about today's rows.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشورات الأصلية فقط. تبقى الردود في السلاسل التي تنتمي إليها، فلا تُعرض هنا ولا تُحتسب في العدد أعلاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সর্বোচ্চ স্তরের পোস্ট। উত্তর যে থ্রেডের, সেখানেই থাকে, তাই এখানে তালিকাভুক্ত হয় না এবং উপরের গণনায়ও ধরা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només publicacions de primer nivell. Les respostes es queden als fils als quals pertanyen, així que no es llisten aquí ni es compten a dalt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen příspěvky nejvyšší úrovně. Odpovědi zůstávají ve vláknech, do kterých patří, takže se zde nevypisují a nepočítají se výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun opslag på øverste niveau. Svar bliver i de tråde, de hører til, så de er ikke listet her og tælles ikke med ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Beiträge der obersten Ebene. Antworten bleiben in den Threads, zu denen sie gehören, daher werden sie hier nicht aufgelistet und oben nicht mitgezählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αναρτήσεις πρώτου επιπέδου. Οι απαντήσεις μένουν στα νήματα στα οποία ανήκουν, γι' αυτό δεν αναγράφονται εδώ και δεν μετρούν παραπάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top-level posts only. Replies stay in the threads they belong to, so they are not listed here and are not counted above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo publicaciones de nivel superior. Las respuestas permanecen en los hilos a los que pertenecen, así que no se listan aquí ni se cuentan arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ylätason julkaisut. Vastaukset pysyvät ketjuissaan, joten niitä ei luetella täällä eikä lasketa yllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts de premier niveau uniquement. Les réponses restent dans les discussions auxquelles elles appartiennent ; elles ne sont donc ni listées ici ni comptées ci-dessus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פוסטים ברמה העליונה בלבד. תגובות נשארות בשרשורים שלהן, ולכן הן לא מופיעות כאן ולא נספרות למעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल मुख्य स्तर की पोस्ट। जवाब अपने थ्रेड में ही रहते हैं, इसलिए वे यहाँ सूचीबद्ध नहीं हैं और ऊपर गिने नहीं गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo objave najviše razine. Odgovori ostaju u nitima kojima pripadaju pa nisu navedeni ovdje i ne broje se iznad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a legfelső szintű bejegyzések. A válaszok a saját szálukban maradnak, ezért itt nincsenek felsorolva, és a fenti számokban sem szerepelnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya postingan tingkat atas. Balasan tetap di utas asalnya, jadi tidak tercantum di sini dan tidak dihitung di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo post di primo livello. Le risposte restano nelle discussioni a cui appartengono, quindi non sono elencate qui e non sono contate sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最上位の投稿のみです。返信は元のスレッドに残るため、ここには表示されず、上の件数にも含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최상위 게시물만 표시돼요. 답글은 해당 스레드에 남으므로 여기에 나열되지 않고 위의 숫자에도 포함되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകൾത്തട്ട് പോസ്റ്റുകൾ മാത്രം. മറുപടികൾ അവ ഉൾപ്പെടുന്ന ത്രെഡുകളിൽ തന്നെ നിൽക്കും, അതിനാൽ ഇവിടെ പട്ടികപ്പെടുത്തുകയോ മുകളിൽ എണ്ണുകയോ ചെയ്യുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran peringkat atas sahaja. Balasan kekal dalam utas yang menjadi miliknya, jadi ia tidak disenaraikan di sini dan tidak dikira di atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare innlegg på øverste nivå. Svar blir i trådene de hører til, så de listes ikke her og telles ikke ovenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen berichten op het hoogste niveau. Reacties blijven in de threads waar ze bij horen, dus ze staan hier niet en worden hierboven niet meegeteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko wpisy główne. Odpowiedzi zostają w swoich wątkach, więc nie są tu wymienione ani liczone powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente posts principais. As respostas ficam nos fios a que pertencem, então não são listadas aqui nem contadas acima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas publicações de topo. As respostas ficam nas conversas a que pertencem, por isso não estão aqui listadas nem contadas acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar postările de nivel superior. Răspunsurile rămân în conversațiile lor, deci nu sunt listate aici și nu sunt numărate mai sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только посты верхнего уровня. Ответы остаются в своих ветках, поэтому они не перечислены здесь и не учтены выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba príspevky najvyššej úrovne. Odpovede zostávajú vo vláknach, do ktorých patria, preto sa tu nezobrazujú a nezapočítavajú sa vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara inlägg på toppnivå. Svar stannar i de trådar de hör till, så de listas inte här och räknas inte ovan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேல்நிலை இடுகைகள் மட்டும். பதில்கள் அவை சேர்ந்த உரையாடல்களிலேயே இருக்கும், எனவே இங்கே பட்டியலிடப்படாது, மேலே எண்ணப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రధాన స్థాయి పోస్ట్‌లు మాత్రమే. రిప్లైలు వాటి థ్రెడ్‌లలోనే ఉంటాయి, కాబట్టి అవి ఇక్కడ జాబితా చేయబడవు, పైన లెక్కించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะโพสต์ระดับบนสุด คำตอบอยู่ในเธรดที่เป็นเจ้าของ จึงไม่ถูกแสดงที่นี่และไม่นับรวมด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ana gönderiler. Yanıtlar ait oldukları konuşmalarda kalır, bu yüzden burada listelenmez ve yukarıda sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише дописи верхнього рівня. Відповіді залишаються в обговореннях, до яких належать, тож їх тут немає і вони не враховані вище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اعلیٰ سطح کی پوسٹس۔ جوابات اپنے تھریڈز میں ہی رہتے ہیں، اس لیے وہ یہاں درج نہیں ہوتے اور اوپر شمار بھی نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bài đăng gốc. Trả lời nằm trong các chuỗi của chúng, nên không được liệt kê ở đây và không được tính ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示顶层帖子。回复保留在它们所属的对话串中，因此不在这里列出，也不计入上方的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示頂層貼文。回覆留在其所屬的串文中，所以不會列在這裡，也不會計入上方的數字。"
          }
        }
      }
    },
