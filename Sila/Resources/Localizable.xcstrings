    "voice.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف التسجيل — ما سجّلته محفوظ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং থেমে গেছে — আপনার যা রেকর্ড হয়েছে তা রাখা আছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrament s'ha aturat: es conserva el que has gravat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání se zastavilo – co jsi nahrál, zůstává"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen stoppede – det, du har optaget, er gemt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme gestoppt – das Aufgenommene bleibt erhalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ηχογράφηση σταμάτησε — ό,τι ηχογράφησες διατηρείται"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped — what you recorded is kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo: lo que grabaste se conserva"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitus pysähtyi – nauhoittamasi säilyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement arrêté — ce que vous avez enregistré est conservé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה נעצרה — מה שהקלטת נשמר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग रुक गई — जो आपने रिकॉर्ड किया वह रखा गया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje je prekinuto — što si snimio/la je sačuvano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel leállt – a már rögzített rész megmaradt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman berhenti — yang sudah kamu rekam tersimpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione interrotta: ciò che hai registrato è stato conservato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が停止しました。録音した分は保存されています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 중단되었어요. 녹음된 부분은 보관돼요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റെക്കോർഡിംഗ് നിലച്ചു — റെക്കോർഡ് ചെയ്തത് സൂക്ഷിച്ചിട്ടുണ്ട്"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman berhenti — apa yang anda rakam disimpan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket stoppet. Det du tok opp, er lagret"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname gestopt: wat je hebt opgenomen blijft bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zatrzymane — to, co nagrałeś, zostało zachowane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou: o que você gravou foi guardado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação interrompida — o que gravou foi guardado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea s-a oprit — ce ai înregistrat este păstrat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остановлена — записанное сохранено"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávanie sa zastavilo — to, čo si nahral, sa zachovalo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen stoppades – det du spelat in är sparat"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு நின்றுவிட்டது — நீங்கள் பதிவு செய்தது சேமிக்கப்பட்டுள்ளது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్ ఆగింది — మీరు రికార్డ్ చేసినది అలాగే ఉంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัดเสียงหยุด สิ่งที่อัดไว้ยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durdu; kaydettiğiniz saklandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис зупинено — записане збережено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ رک گئی — جو آپ نے ریکارڈ کیا وہ محفوظ ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm đã dừng — phần bạn đã ghi được giữ lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已停止，已录下的内容会保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已停止，已錄製的內容會保留"
          }
        }
      }
    },
