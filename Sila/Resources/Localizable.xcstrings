    "composer.segment.remove.a11yHint": {
      "comment": "VoiceOver hint for removing one post from a thread.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا المنشور من السلسلة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থ্রেড থেকে এই পোস্ট মুছে দেয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina aquesta publicació del fil"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže tento příspěvek z vlákna"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dette opslag fra tråden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht diesen Beitrag aus dem Thread"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει αυτή την ανάρτηση από το νήμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this post from the thread"
          }
        },
        "es": {
