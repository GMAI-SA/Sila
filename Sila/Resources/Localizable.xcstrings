    "preferences.topics.explanation": {
      "comment": "What Interested and Muted each do.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«مهتم» يحتسب الموضوع ضمن التصفية أعلاه. و«مكتوم» يخفي المنشورات المتعلقة به من الصفحة الدولية سواء كانت التصفية مفعّلة أم لا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগ্রহী মানে বিষয়টি উপরের ফিল্টারের জন্য গণ্য হয়। মিউট করলে ফিল্টার চালু থাকুক বা না থাকুক, সেই বিষয়ের পোস্ট আন্তর্জাতিক থেকে লুকায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "M'interessa compta un tema per al filtre de dalt. Silenciat n'amaga les publicacions d'Internacional tant si aquest filtre està activat com si no."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajímá mě započítá téma do filtru výše. Ztlumeno skryje příspěvky o něm z Mezinárodního kanálu, ať je tento filtr zapnutý, či nikoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Interesseret tæller et emne med i filtret ovenfor. Skjult fjerner opslag om det fra International, uanset om filtret er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Interessiert“ zählt ein Thema für den Filter oben. „Stummgeschaltet“ blendet Beiträge dazu aus International aus, egal ob der Filter an ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Με ενδιαφέρει» προσμετράται στο παραπάνω φίλτρο. Το «Σε σίγαση» κρύβει αναρτήσεις για αυτό από το Διεθνές είτε το φίλτρο είναι ενεργό είτε όχι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interested counts a topic towards the filter above. Muted hides posts about it from International whether or not that filter is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me interesa cuenta un tema para el filtro de arriba. Silenciado oculta de Internacional las publicaciones sobre él, esté o no activado ese filtro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnostunut laskee aiheen mukaan yllä olevaan suodattimeen. Mykistetty piilottaa aiheen julkaisut Kansainvälinen-syötteestä riippumatta siitä, onko suodatin päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intéressé prend un sujet en compte pour le filtre ci-dessus. Masqué retire les posts sur ce sujet du fil International, que ce filtre soit activé ou non."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״מעוניין״ סופר נושא לטובת המסנן שלמעלה. ״מושתק״ מסתיר פוסטים עליו מהפיד הבינלאומי בין אם המסנן פעיל ובין אם לא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"रुचि है\" किसी टॉपिक को ऊपर के फ़िल्टर में गिनता है। \"म्यूट\" उसकी पोस्ट अंतरराष्ट्रीय से छिपाता है, चाहे वह फ़िल्टर चालू हो या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanima me ubraja temu u filtar iznad. Utišano skriva objave o njoj iz Međunarodnog bez obzira je li taj filtar uključen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Érdekel beleszámít egy témát a fenti szűrőbe. A Némítva elrejti a róla szóló bejegyzéseket a Nemzetközi hírfolyamból, a szűrő állapotától függetlenül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tertarik menghitung sebuah topik untuk filter di atas. Dibisukan menyembunyikan postingan tentangnya dari Internasional baik filter itu aktif maupun tidak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessato conta un argomento per il filtro qui sopra. Silenziato nasconde da Internazionale i post che lo riguardano, che quel filtro sia attivo o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「興味あり」にすると、そのトピックが上のフィルターの対象になります。「ミュート」にすると、フィルターのオン・オフにかかわらず、そのトピックの投稿が国際フィードで非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심 있음은 위 필터에 이 주제를 반영해요. 뮤트는 필터가 켜져 있든 아니든 국제에서 이 주제의 게시물을 숨겨요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിലെ ഫിൽട്ടറിനായി വിഷയത്തെ കണക്കാക്കുന്നതാണ് താൽപര്യം. ആ ഫിൽട്ടർ ഓണായാലും അല്ലെങ്കിലും മ്യൂട്ട് ചെയ്താൽ അതിനെക്കുറിച്ചുള്ള പോസ്റ്റുകൾ അന്താരാഷ്ട്ര ഫീഡിൽ നിന്ന് മറയ്ക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berminat mengira topik untuk penapis di atas. Disenyapkan menyembunyikan siaran tentangnya daripada Antarabangsa sama ada penapis itu dihidupkan atau tidak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessert teller et emne med i filteret ovenfor. Dempet skjuler innlegg om det fra Internasjonalt, uansett om filteret er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnteresseerd telt een onderwerp mee voor het filter hierboven. Gedempt verbergt berichten erover uit Internationaal, ongeacht of dat filter aan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Interesuje mnie” wlicza temat do filtra powyżej. „Wyciszony” ukrywa wpisy o nim w kanale międzynarodowym niezależnie od tego, czy filtr jest włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessado conta um tópico para o filtro acima. Silenciado oculta de Internacional os posts sobre ele, com ou sem esse filtro ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessado conta um tópico para o filtro acima. Silenciado oculta as publicações sobre ele no Internacional, com ou sem esse filtro ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mă interesează numără un subiect pentru filtrul de mai sus. Dezactivat ascunde postările despre el din Internațional, indiferent dacă filtrul este activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Интересно» учитывает тему в фильтре выше. «Скрыто» убирает посты о ней из международной ленты независимо от того, включён ли фильтр."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaujíma ma započíta tému do filtra vyššie. Stlmené skryje príspevky o nej z Medzinárodných, bez ohľadu na to, či je tento filter zapnutý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intresserad räknar ett ämne till filtret ovan. Tystat döljer inlägg om det från Internationellt oavsett om filtret är på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆர்வம் என்பது ஒரு தலைப்பை மேலுள்ள வடிகட்டியில் சேர்க்கும். ஒலியடக்கப்பட்டது, அந்த வடிகட்டி இயக்கத்தில் இருந்தாலும் இல்லாவிட்டாலும் அதைப் பற்றிய இடுகைகளைச் சர்வதேசத்திலிருந்து மறைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆసక్తి ఉంది అనేది పై ఫిల్టర్ కోసం అంశాన్ని లెక్కిస్తుంది. మ్యూట్ చేశారు అనేది ఆ ఫిల్టర్ ఆన్‌లో ఉన్నా లేకపోయినా దాని గురించిన పోస్ట్‌లను అంతర్జాతీయం నుండి దాచుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สนใจ นับหัวข้อเข้าตัวกรองด้านบน ปิดเสียง ซ่อนโพสต์เกี่ยวกับหัวข้อนั้นจากนานาชาติ ไม่ว่าตัวกรองนั้นจะเปิดอยู่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgileniyorum, bir konuyu yukarıdaki filtre için sayar. Sessizde, filtre açık olsun olmasın, o konudaki gönderileri Uluslararası akıştan gizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Цікавить» зараховує тему до фільтра вище. «Заглушено» приховує дописи про неї зі стрічки «Світ» незалежно від того, чи ввімкнено цей фільтр."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"دلچسپی ہے\" موضوع کو اوپر کے فلٹر میں شمار کرتا ہے۔ \"میوٹ\" اس کی پوسٹس بین الاقوامی سے چھپا دیتا ہے چاہے وہ فلٹر آن ہو یا نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan tâm tính một chủ đề vào bộ lọc ở trên. Đã ẩn sẽ ẩn bài đăng về nó khỏi Quốc tế dù bộ lọc đó bật hay tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“感兴趣”会把话题计入上方的筛选。“已静音”会在国际信息流中隐藏关于它的帖子，无论该筛选是否开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「感興趣」會將主題納入上方的篩選。「已靜音」會從「國際」隱藏相關貼文，無論該篩選是否開啟。"
          }
        }
      }
    },
    "preferences.topics.hide.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواضيع المخفية تُزال من كل الخلاصات، لا من هذه وحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকানো বিষয় শুধু এই ফিড নয়, প্রতিটি ফিড থেকে সরে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els temes amagats s'eliminen de tots els canals, no només d'aquest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytá témata se odstraní ze všech kanálů, ne jen z tohoto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte emner fjernes fra alle feeds, ikke kun dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Themen werden aus jedem Feed entfernt, nicht nur aus diesem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κρυμμένα θέματα αφαιρούνται από κάθε ροή, όχι μόνο από αυτήν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden subjects are removed from every feed, not only this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas ocultos se quitan de todos los feeds, no solo de este."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotetut aiheet poistetaan kaikista syötteistä, ei vain tästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets masqués sont retirés de tous les fils, pas seulement celui-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נושאים מוסתרים מוסרים מכל פיד, לא רק מזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपाए गए विषय हर फ़ीड से हटा दिए जाते हैं, सिर्फ़ इससे नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivene teme uklanjaju se iz svakog feeda, ne samo ovog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elrejtett témák minden hírfolyamból eltűnnek, nem csak ebből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik yang disembunyikan dihapus dari setiap feed, bukan hanya yang ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti nascosti vengono rimossi da ogni feed, non solo da questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした分野は、このフィードだけでなく、すべてのフィードから外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 주제는 이 피드뿐 아니라 모든 피드에서 사라져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറച്ച വിഷയങ്ങൾ ഈ ഫീഡിൽ നിന്ന് മാത്രമല്ല, എല്ലാ ഫീഡുകളിൽ നിന്നും നീക്കം ചെയ്യുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Subjek yang disembunyikan dialih keluar daripada setiap suapan, bukan hanya yang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte temaer fjernes fra alle feeder, ikke bare denne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen onderwerpen verdwijnen uit elke feed, niet alleen uit deze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte tematy są usuwane ze wszystkich kanałów, nie tylko z tego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os assuntos ocultos são removidos de todos os feeds, não só deste."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os assuntos ocultos são removidos de todos os feeds, não apenas deste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subiectele ascunse sunt eliminate din toate fluxurile, nu doar din acesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые темы убираются из всех лент, а не только из этой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté témy sa odstránia zo všetkých kanálov, nielen z tohto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda ämnen tas bort från alla flöden, inte bara det här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறைக்கப்பட்ட தலைப்புகள் இதிலிருந்து மட்டுமல்ல, எல்லா ஊட்டங்களிலிருந்தும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దాచిన అంశాలు ఈ ఫీడ్ నుండే కాదు, ప్రతి ఫీడ్ నుండి తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรื่องที่ซ่อนจะถูกนำออกจากทุกฟีด ไม่ใช่แค่ฟีดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlenen konular yalnızca bu akıştan değil, tüm akışlardan kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховані теми прибираються з кожної стрічки, а не лише з цієї."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چھپائے گئے موضوعات ہر فیڈ سے ہٹا دیے جاتے ہیں، صرف اس سے نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề bị ẩn sẽ bị gỡ khỏi mọi bảng tin, không chỉ bảng tin này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被隐藏的主题会从所有信息流中移除，而不只是这一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏的主題會從所有動態移除，而不只是這一個。"
          }
        }
      }
    },
