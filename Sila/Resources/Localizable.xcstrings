    "auth.resetPassword.submit.a11yHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيّن كلمة المرور الجديدة ويسجّل خروجك من الأجهزة الأخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নতুন পাসওয়ার্ড সেট করে এবং অন্য ডিভাইস থেকে সাইন আউট করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableix la contrasenya nova i tanca la sessió als altres dispositius"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví nové heslo a odhlásí tě na ostatních zařízeních"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver din nye adgangskode og logger dig ud af andre enheder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt dein neues Passwort fest und meldet dich auf anderen Geräten ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζει τον νέο κωδικό σου και σε αποσυνδέει από τις άλλες συσκευές"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets your new password and signs you out of other devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece tu nueva contraseña y cierra tu sesión en los demás dispositivos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa uuden salasanasi ja kirjaa sinut ulos muilta laitteilta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit votre nouveau mot de passe et vous déconnecte des autres appareils"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע את הסיסמה החדשה שלך ומנתק אותך ממכשירים אחרים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नया पासवर्ड सेट करता है और दूसरे डिवाइस से साइन आउट कर देता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavlja tvoju novu lozinku i odjavljuje te s drugih uređaja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja az új jelszavadat, és kijelentkeztet a többi eszközről"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur kata sandi barumu dan mengeluarkanmu dari perangkat lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la nuova password e ti disconnette dagli altri dispositivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいパスワードを設定し、他のデバイスからサインアウトします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 비밀번호를 설정하고 다른 기기에서 로그아웃해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ പാസ്‌വേഡ് സജ്ജമാക്കി മറ്റ് ഉപകരണങ്ങളിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുന്നു"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan kata laluan baharu anda dan melog keluar anda daripada peranti lain"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir det nye passordet ditt og logger deg ut av andre enheter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt je nieuwe wachtwoord in en logt je uit op andere apparaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia nowe hasło i wylogowuje z innych urządzeń"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define sua nova senha e desconecta você dos outros dispositivos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a sua nova palavra-passe e termina a sessão nos outros dispositivos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează noua parolă și te deconectează de pe celelalte dispozitive"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает новый пароль и завершает сеансы на других устройствах"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví tvoje nové heslo a odhlási ťa z ostatných zariadení"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger ditt nya lösenord och loggar ut dig från andra enheter"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புதிய கடவுச்சொல்லை அமைத்து மற்றச் சாதனங்களிலிருந்து வெளியேற்றும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొత్త పాస్‌వర్డ్‌ను సెట్ చేసి, ఇతర పరికరాల నుండి సైన్ అవుట్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งรหัสผ่านใหม่ของคุณและออกจากระบบอุปกรณ์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni şifrenizi belirler ve diğer cihazlardaki oturumlarınızı kapatır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює новий пароль і виводить вас із системи на інших пристроях"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نیا پاس ورڈ سیٹ کرتا ہے اور دوسری ڈیوائسز سے سائن آؤٹ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mật khẩu mới và đăng xuất bạn khỏi các thiết bị khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置新密码，并让其他设备退出登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定你的新密碼，並讓你在其他裝置登出"
          }
        }
      }
    },
    "auth.resetPassword.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الذي أرسلناه إلى %@، ثم كلمة المرور التي تريدها من الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ পাঠানো কোডটি দিন, তারপর এখন থেকে যে পাসওয়ার্ড চান তা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el codi que hem enviat a %@ i, després, la contrasenya que vols a partir d'ara."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej kód, který jsme poslali na %@, a pak heslo, které chceš používat od teď."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast koden, vi sendte til %@, og derefter den adgangskode, du vil bruge fremover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code ein, den wir an %@ gesendet haben, und dann das Passwort, das du ab jetzt verwenden willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισήγαγε τον κωδικό που στείλαμε στο %@ και μετά τον κωδικό πρόσβασης που θέλεις από εδώ και πέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code we sent to %@, then the password you want from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código que enviamos a %@ y, después, la contraseña que quieres usar de ahora en adelante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna osoitteeseen %@ lähettämämme koodi ja sen jälkeen salasana, jota haluat käyttää jatkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code envoyé à %@, puis le mot de passe que vous voulez utiliser désormais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את הקוד ששלחנו אל %@, ואז את הסיסמה שאתה רוצה מעכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को भेजा गया कोड डालें, फिर वह पासवर्ड जो आप अब से चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi kod koji smo poslali na %@, a zatim lozinku koju želiš od sada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a(z) %@ címre küldött kódot, majd azt a jelszót, amelyet ezentúl használni szeretnél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kode yang kami kirim ke %@, lalu kata sandi yang kamu inginkan mulai sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice che abbiamo inviato a %@, poi la password che vuoi usare da ora in poi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に送信したコードと、今後使いたいパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 보낸 코드를 입력한 다음, 앞으로 사용할 비밀번호를 입력하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്നതിലേക്ക് ഞങ്ങൾ അയച്ച കോഡും, ഇനിമുതൽ നിങ്ങൾക്ക് വേണ്ട പാസ്‌വേഡും നൽകുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kod yang kami hantar ke %@, kemudian kata laluan yang anda mahu mulai sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn koden vi sendte til %@, og deretter passordet du vil bruke fra nå av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de code in die we naar %@ hebben gestuurd, en daarna het wachtwoord dat je vanaf nu wilt gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod wysłany na adres %@, a potem hasło, którego chcesz używać od teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código que enviamos para %@ e depois a senha que você quer usar a partir de agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o código que enviámos para %@ e depois a palavra-passe que quer usar a partir de agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu codul trimis la %@, apoi parola pe care o vrei de acum încolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите код, отправленный на %@, а затем пароль, который хотите использовать дальше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj kód, ktorý sme poslali na %@, a potom heslo, ktoré chceš odteraz používať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange koden vi skickade till %@ och sedan lösenordet du vill ha från och med nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முகவரிக்கு அனுப்பிய குறியீட்டை உள்ளிட்டு, இனி நீங்கள் விரும்பும் கடவுச்சொல்லை உள்ளிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@కు మేము పంపిన కోడ్‌ను, ఆ తర్వాత ఇకపై మీరు కోరుకునే పాస్‌వర్డ్‌ను నమోదు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่รหัสที่เราส่งไปที่ %@ แล้วใส่รหัสผ่านที่คุณต้องการใช้จากนี้ไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adresine gönderdiğimiz kodu, ardından bundan sonra kullanmak istediğiniz şifreyi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть код, який ми надіслали на %@, а потім пароль, який ви хочете використовувати відтепер."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو بھیجا گیا کوڈ درج کریں، پھر وہ پاس ورڈ جو آپ اب سے چاہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã chúng tôi đã gửi đến %@, rồi nhập mật khẩu bạn muốn dùng từ bây giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入我们发送到 %@ 的验证码，然后输入你今后想使用的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入我們寄到 %@ 的驗證碼，然後輸入你之後想使用的密碼。"
          }
        }
      },
      "comment": "%@ is the email address the reset code was sent to."
    },
