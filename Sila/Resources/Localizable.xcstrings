    },
    "composer.scope.myCountry.a11yLabel": {
      "comment": "VoiceOver label for the unavailable my-country row.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلدي، غير متاح. علم بلدك يأتي من توثيق الهوية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার দেশ, পাওয়া যাচ্ছে না। আপনার দেশের পতাকা পরিচয় যাচাই থেকে আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu país, no disponible. La bandera del teu país prové de la verificació d'identitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Má země, nedostupné. Vlajka tvé země pochází z ověření totožnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit land, ikke tilgængeligt. Dit landeflag kommer fra identitetsverificeringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Land, nicht verfügbar. Deine Landesflagge stammt aus der Identitätsprüfung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χώρα μου, μη διαθέσιμο. Η σημαία της χώρας σου προέρχεται από την επαλήθευση ταυτότητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Country, unavailable. Your country flag comes from identity verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi país, no disponible. La bandera de tu país procede de la verificación de identidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma maa, ei käytettävissä. Maasi lippu tulee henkilöllisyyden vahvistuksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon pays, indisponible. Le drapeau de votre pays provient de la vérification d’identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדינה שלי, לא זמין. דגל המדינה שלך מגיע מאימות הזהות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा देश, अनुपलब्ध। आपके देश का झंडा पहचान सत्यापन से आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moja zemlja, nedostupno. Zastava tvoje zemlje dolazi iz provjere identiteta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saját ország, nem elérhető. Az országzászlód a személyazonosság-hitelesítésből származik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Negaraku, tidak tersedia. Bendera negaramu berasal dari verifikasi identitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio paese, non disponibile. La bandiera del tuo paese deriva dalla verifica d'identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の国、利用できません。国旗は本人確認によって決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 국가, 사용할 수 없음. 국가 깃발은 신원 인증에서 가져와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്റെ രാജ്യം, ലഭ്യമല്ല. നിങ്ങളുടെ രാജ്യത്തിന്റെ പതാക ഐഡന്റിറ്റി പരിശോധനയിൽ നിന്നാണ് ലഭിക്കുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Negara Saya, tidak tersedia. Bendera negara anda datang daripada pengesahan identiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitt land, utilgjengelig. Landsflagget ditt kommer fra identitetsverifiseringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn land, niet beschikbaar. Je landvlag komt van de identiteitsverificatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mój kraj, niedostępne. Flaga Twojego kraju pochodzi z weryfikacji tożsamości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu país, indisponível. A bandeira do seu país vem da verificação de identidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O meu país, indisponível. A bandeira do seu país vem da verificação de identidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țara mea, indisponibilă. Steagul țării tale provine din verificarea identității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Моя страна, недоступно. Флаг вашей страны берётся из проверки личности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Moja krajina, nedostupné. Vlajka tvojej krajiny pochádza z overenia totožnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitt land, inte tillgängligt. Flaggan för ditt land kommer från identitetsverifieringen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் நாடு, கிடைக்கவில்லை. உங்கள் நாட்டுக் கொடி அடையாளச் சரிபார்ப்பிலிருந்து வருகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా దేశం, అందుబాటులో లేదు. మీ దేశ జెండా గుర్తింపు ధృవీకరణ నుండి వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเทศของฉัน ใช้ไม่ได้ ธงประเทศของคุณมาจากการยืนยันตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülkem, kullanılamıyor. Ülke bayrağınız kimlik doğrulamasından gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моя країна, недоступно. Прапор вашої країни походить із верифікації особи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میرا ملک، دستیاب نہیں۔ آپ کے ملک کا جھنڈا شناخت کی تصدیق سے آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quốc gia của tôi, không khả dụng. Cờ quốc gia của bạn đến từ xác minh danh tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的国家，不可用。你的国家旗帜来自身份验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的國家，無法使用。你的國家旗幟來自身分驗證。"
          }
        }
      }
    },
    "composer.scope.myCountry.subtitle": {
      "comment": "What the my-country audience means.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الرد إلا للحسابات الموثّقة في بلدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার দেশে ভেরিফায়েড অ্যাকাউন্টরা উত্তর দিতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només hi poden respondre els comptes verificats al teu país."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat mohou jen účty ověřené ve tvé zemi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun konti verificeret i dit land kan svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in deinem Land verifizierte Konten können antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο λογαριασμοί επαληθευμένοι στη χώρα σου μπορούν να απαντήσουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accounts verified in your country can reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las cuentas verificadas en tu país pueden responder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain maassasi vahvistetut tilit voivat vastata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les comptes vérifiés dans votre pays peuvent répondre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חשבונות שאומתו במדינה שלך יכולים להגיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपके देश में सत्यापित अकाउंट जवाब दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarati mogu samo računi potvrđeni u tvojoj zemlji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a te országodban hitelesített fiókok válaszolhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akun yang terverifikasi di negaramu yang bisa membalas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli account verificati nel tuo paese possono rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの国で認証されたアカウントだけが返信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 나라에서 인증된 계정만 답글을 달 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ രാജ്യത്ത് പരിശോധിച്ച അക്കൗണ്ടുകൾക്ക് മാത്രമേ മറുപടി നൽകാനാകൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akaun yang disahkan di negara anda boleh membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare kontoer verifisert i landet ditt kan svare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen accounts die in jouw land zijn geverifieerd kunnen reageren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadać mogą tylko konta zweryfikowane w Twoim kraju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contas verificadas no seu país podem responder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contas verificadas no seu país podem responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar conturile verificate în țara ta pot răspunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечать могут только аккаунты, проверенные в вашей стране."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať môžu iba účty overené v tvojej krajine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara konton verifierade i ditt land kan svara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்டில் சரிபார்க்கப்பட்ட கணக்குகள் மட்டுமே பதிலளிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ దేశంలో ధృవీకరించబడిన ఖాతాలు మాత్రమే రిప్లై ఇవ్వగలవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะบัญชีที่ยืนยันตัวตนในประเทศของคุณเท่านั้นที่ตอบกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ülkenizde doğrulanmış hesaplar yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідати можуть лише облікові записи, верифіковані у вашій країні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ کے ملک میں تصدیق شدہ اکاؤنٹ جواب دے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tài khoản được xác minh ở quốc gia của bạn mới trả lời được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你所在国家验证的账户可以回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你的國家通過驗證的帳號能回覆。"
          }
        }
      }
    },
