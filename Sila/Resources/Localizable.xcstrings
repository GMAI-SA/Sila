            "value": "Demana qui és la persona i després et dona un enllaç per enviar-li"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptá se, kdo to je, a pak ti dá odkaz k odeslání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørger, hvem de er, og giver dig så et link at sende dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt, wer die Person ist, und gibt dir dann einen Link zum Senden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρωτά ποιος είναι και μετά σου δίνει σύνδεσμο να του στείλεις"
