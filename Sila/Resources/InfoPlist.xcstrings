{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "System camera prompt, shown when the document verification flow opens the camera.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم صلة الكاميرا فقط لتصوير وثيقة هويتك والتقاط صورة سيلفي قصيرة أثناء التحقق. لا يُسجَّل أي شيء خارج هذه الخطوة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila uses the camera only to photograph your identity document and take a short selfie during verification. Nothing is recorded outside that step."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "System Face ID prompt, shown the first time biometric sign-in is offered.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول بـ Face ID"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Face ID"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "System microphone prompt, shown the first time somebody speaks in a room or records a voice post.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم صلة الميكروفون عندما تتحدث في غرفة أو تسجّل منشورًا صوتيًا. الغرف لا تُسجَّل أبدًا؛ المنشور الصوتي يُسجَّل فقط عندما تضغط زر التسجيل، وأنت وحدك من يقرر نشره."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila uses the microphone when you speak in a room or record a voice post. Rooms are never recorded; a voice post is recorded only when you press record, and only you decide to post it."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
