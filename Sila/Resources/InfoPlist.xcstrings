{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معروف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "comment": "System calendar prompt, shown when somebody adds a room to their calendar.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف معروف الغرفة التي تختارها إلى تقويمك لتعرف متى تبدأ. ومعروف لا يقرأ تقويمك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া রুম কখন শুরু হবে তা জানাতে Known সেটি আপনার ক্যালেন্ডারে যোগ করে। Known কখনও আপনার ক্যালেন্ডার পড়ে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Known afegeix al calendari la sala que triïs, perquè sàpigues quan comença. Known mai no llegeix el teu calendari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Known přidá místnost, kterou vybereš, do tvého kalendáře, abys věděl, kdy začíná. Known tvůj kalendář nikdy nečte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Known føjer et rum, du vælger, til din kalender, så du ved, hvornår det starter. Known læser aldrig din kalender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Known fügt einen von dir gewählten Raum zu deinem Kalender hinzu, damit du weißt, wann er beginnt. Known liest deinen Kalender nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Known προσθέτει στο ημερολόγιό σου μια αίθουσα που επιλέγεις, ώστε να ξέρεις πότε ξεκινά. Το Known δεν διαβάζει ποτέ το ημερολόγιό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known adds a room you choose to your calendar, so you know when it starts. Known never reads your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Known añade a tu calendario la sala que elijas, para que sepas cuándo empieza. Known nunca lee tu calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known lisää valitsemasi huoneen kalenteriisi, jotta tiedät milloin se alkaa. Known ei koskaan lue kalenteriasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known ajoute à votre calendrier un salon que vous choisissez, pour que vous sachiez quand il commence. Known ne lit jamais votre calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Known מוסיפה ליומן שלך חדר שבחרת, כדי שתדע מתי הוא מתחיל. Known אף פעם לא קוראת את היומן שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known आपके चुने हुए रूम को आपके कैलेंडर में जोड़ता है, ताकि आपको पता रहे कि वह कब शुरू होगा। Known आपका कैलेंडर कभी नहीं पढ़ता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known dodaje sobu koju odabereš u tvoj kalendar kako bi znao/la kada počinje. Known nikada ne čita tvoj kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known a naptáradba teszi az általad választott szobát, hogy tudd, mikor kezdődik. A Known soha nem olvassa a naptáradat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Known menambahkan room pilihanmu ke kalender agar kamu tahu kapan dimulai. Known tidak pernah membaca kalendermu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Known aggiunge al tuo calendario una stanza che scegli tu, così sai quando inizia. Known non legge mai il tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knownは、選択したルームをカレンダーに追加して、開始時刻をお知らせします。Knownがカレンダーを読み取ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Known은 선택한 룸을 캘린더에 추가해 시작 시간을 알려드려요. Known은 캘린더를 읽지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന റൂം എപ്പോൾ തുടങ്ങുമെന്ന് അറിയാൻ Known അത് നിങ്ങളുടെ കലണ്ടറിൽ ചേർക്കുന്നു. Known ഒരിക്കലും നിങ്ങളുടെ കലണ്ടർ വായിക്കില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Known menambah bilik pilihan anda ke kalendar supaya anda tahu bila ia bermula. Known tidak pernah membaca kalendar anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Known legger til et rom du velger i kalenderen din, slik at du vet når det starter. Known leser aldri kalenderen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known zet een room die je kiest in je agenda, zodat je weet wanneer die begint. Known leest je agenda nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Known dodaje wybrany przez Ciebie pokój do kalendarza, żebyś wiedział(a), kiedy się zaczyna. Known nigdy nie czyta Twojego kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Known adiciona ao seu calendário a sala que você escolher, para você saber quando ela começa. O Known nunca lê o seu calendário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Known adiciona ao seu calendário uma sala que escolher, para saber quando começa. A Known nunca lê o seu calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Known adaugă în calendar o cameră aleasă de tine, ca să știi când începe. Known nu îți citește niciodată calendarul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Known добавляет выбранную вами комнату в календарь, чтобы вы знали, когда она начнётся. Known никогда не читает ваш календарь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known pridá miestnosť, ktorú si vyberieš, do tvojho kalendára, aby si vedel, kedy začína. Known nikdy nečíta tvoj kalendár."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Known lägger till ett rum som du väljer i din kalender så att du vet när det startar. Known läser aldrig din kalender."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்வு செய்யும் அறையை Known உங்கள் நாட்காட்டியில் சேர்க்கும், அதனால் அது எப்போது தொடங்கும் என்பது உங்களுக்குத் தெரியும். Known உங்கள் நாட்காட்டியை ஒருபோதும் படிக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న రూమ్‌ను Known మీ క్యాలెండర్‌లో చేరుస్తుంది, తద్వారా అది ఎప్పుడు మొదలవుతుందో మీకు తెలుస్తుంది. Known మీ క్యాలెండర్‌ను ఎప్పుడూ చదవదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Known จะเพิ่มห้องที่คุณเลือกลงในปฏิทินของคุณ เพื่อให้คุณรู้ว่าห้องเริ่มเมื่อไหร่ Known ไม่อ่านปฏิทินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Known, seçtiğiniz bir odayı takviminize ekler; böylece ne zaman başlayacağını bilirsiniz. Known takviminizi asla okumaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Known додає вибрану вами кімнату до вашого календаря, щоб ви знали, коли вона почнеться. Known ніколи не читає ваш календар."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Known آپ کے منتخب کردہ روم کو آپ کے کیلنڈر میں شامل کرتا ہے تاکہ آپ کو پتا رہے کہ وہ کب شروع ہوگا۔ Known آپ کا کیلنڈر کبھی نہیں پڑھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Known thêm phòng bạn chọn vào lịch để bạn biết khi nào phòng bắt đầu. Known không bao giờ đọc lịch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 会把你选择的房间添加到日历，方便你知道开始时间。Known 绝不会读取你的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Known 會把你選擇的聊天室加入行事曆，讓你知道開始時間。Known 絕不會讀取你的行事曆。"
          }
        }
      }
    },
