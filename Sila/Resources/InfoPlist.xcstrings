    "NSMicrophoneUsageDescription" : {
      "comment" : "System microphone prompt, shown the first time the user takes the microphone in a voice room.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم سِلة المايك فقط عندما تأخذ المايك في غرفة صوتية. الاستماع لا يحتاج إليه أبدًا، ولا تُسجَّل الغرف إطلاقًا، ولا يُخزَّن أي شيء تقوله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila uses your microphone only when you take the microphone in a voice room. Listening never needs it, rooms are never recorded, and nothing you say is stored."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
